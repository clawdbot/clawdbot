#!/usr/bin/env node

import path from "node:path";
import { fileURLToPath } from "node:url";
import { build } from "esbuild";
import { writeGeneratedTextAsset } from "./lib/generated-text-asset.mts";

type GenerateParams = {
  build?: (
    options: Parameters<typeof build>[0],
  ) => Promise<{ outputFiles?: Array<{ text: string }> }>;
  outputPath?: string;
  check?: boolean;
};

const modulePath = fileURLToPath(import.meta.url);
const repoRoot = path.resolve(path.dirname(modulePath), "..");
const defaultOutputPath = path.join(
  repoRoot,
  "apps/macos/Sources/OpenClaw/ExecArgPatternSafetyJS.generated.swift",
);

function renderSwiftSource(js: string): string {
  if (js.includes('"""')) {
    throw new Error("bundled exec-arg-pattern JS contains a Swift raw-string terminator");
  }
  return [
    "// Code generated by pnpm gen:exec-arg-pattern:swift. DO NOT EDIT.",
    "",
    "enum ExecArgPatternSafetyJS {",
    '    static let source = #"""',
    js.trimEnd(),
    '"""#',
    "}",
    "",
  ].join("\n");
}

/** Bundles compileExecArgPattern for the macOS JSContext matcher. */
export async function generateMacosExecArgPatternSafety(params: GenerateParams = {}) {
  const buildImpl = params.build ?? build;
  const targetPath = params.outputPath ?? defaultOutputPath;
  const result = await buildImpl({
    absWorkingDir: repoRoot,
    entryPoints: ["src/infra/exec-arg-pattern.ts"],
    bundle: true,
    platform: "neutral",
    target: "es2020",
    format: "iife",
    globalName: "OpenClawExecArgPattern",
    legalComments: "none",
    write: false,
  });
  const outputFile = result.outputFiles?.[0];
  if (!outputFile) {
    throw new Error("esbuild did not produce the exec-arg-pattern safety bundle");
  }
  const contents = renderSwiftSource(outputFile.text);
  if (params.check) {
    const fs = await import("node:fs/promises");
    const current = await fs.readFile(targetPath, "utf8");
    if (current !== contents) {
      throw new Error(`${targetPath} is stale; run pnpm gen:exec-arg-pattern:swift`);
    }
    return false;
  }
  return writeGeneratedTextAsset(targetPath, contents);
}

const args = process.argv.slice(2);
if (process.argv[1] === modulePath) {
  await generateMacosExecArgPatternSafety({ check: args.includes("--check") });
}
