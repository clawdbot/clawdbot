    "Chat, talk, and approve actions from anywhere": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Chat, talk, and approve actions from anywhere"}},"zh-CN":{"stringUnit":{"state":"translated","value":"随时随地聊天、交谈和批准操作"}},"zh-TW":{"stringUnit":{"state":"translated","value":"隨時隨地聊天、交談及核准動作"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Converse por texto ou voz e aprove ações de qualquer lugar"}},"de":{"stringUnit":{"state":"translated","value":"Von überall aus chatten, sprechen und Aktionen genehmigen"}},"es":{"stringUnit":{"state":"translated","value":"Chatea, habla y aprueba acciones desde cualquier lugar"}},"ja-JP":{"stringUnit":{"state":"translated","value":"どこからでもチャット、音声会話、アクションの承認が可能"}},"ko":{"stringUnit":{"state":"translated","value":"어디서나 채팅하고, 음성으로 대화하고, 작업을 승인하세요"}},"fr":{"stringUnit":{"state":"translated","value":"Discutez, parlez et approuvez des actions où que vous soyez"}},"hi":{"stringUnit":{"state":"translated","value":"कहीं से भी चैट करें, बात करें और कार्रवाइयों को मंज़ूरी दें"}},"ar":{"stringUnit":{"state":"translated","value":"دردش وتحدث ووافق على الإجراءات من أي مكان"}},"it":{"stringUnit":{"state":"translated","value":"Chatta, parla e approva azioni ovunque ti trovi"}},"tr":{"stringUnit":{"state":"translated","value":"Her yerden sohbet edin, konuşun ve işlemleri onaylayın"}},"uk":{"stringUnit":{"state":"translated","value":"Спілкуйтеся в чаті, розмовляйте та схвалюйте дії звідусіль"}},"id":{"stringUnit":{"state":"translated","value":"Mengobrol, berbicara, dan menyetujui tindakan dari mana saja"}},"pl":{"stringUnit":{"state":"translated","value":"Czatuj, rozmawiaj i zatwierdzaj działania z dowolnego miejsca"}},"th":{"stringUnit":{"state":"translated","value":"แชท พูดคุย และอนุมัติการดำเนินการได้จากทุกที่"}},"vi":{"stringUnit":{"state":"translated","value":"Trò chuyện, nói chuyện và phê duyệt hành động từ bất cứ đâu"}},"nl":{"stringUnit":{"state":"translated","value":"Chat, praat en keur acties goed, waar je ook bent"}}