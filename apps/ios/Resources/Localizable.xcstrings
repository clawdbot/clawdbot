    "Gateway changed before the thread operation started.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Gateway changed before the thread operation started."}},"zh-CN":{"stringUnit":{"state":"translated","value":"对话操作开始前 Gateway 已更改。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 已在對話串操作開始前變更。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Gateway foi alterado antes do início da operação na conversa."}},"de":{"stringUnit":{"state":"translated","value":"Das Gateway wurde vor dem Start des Thread-Vorgangs geändert."}},"es":{"stringUnit":{"state":"translated","value":"Gateway cambió antes de que se iniciara la operación del hilo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"スレッド操作の開始前に Gateway が変更されました。"}},"ko":{"stringUnit":{"state":"translated","value":"스레드 작업이 시작되기 전에 Gateway가 변경되었습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le Gateway a changé avant le début de l’opération sur la conversation."}},"hi":{"stringUnit":{"state":"translated","value":"थ्रेड कार्रवाई शुरू होने से पहले Gateway बदल गया।"}},"ar":{"stringUnit":{"state":"translated","value":"تغيّر Gateway قبل بدء العملية على سلسلة المحادثة."}},"it":{"stringUnit":{"state":"translated","value":"Il Gateway è cambiato prima dell'avvio dell'operazione sulla conversazione."}},"tr":{"stringUnit":{"state":"translated","value":"Konu işlemi başlamadan önce Gateway değişti."}},"uk":{"stringUnit":{"state":"translated","value":"Gateway змінився до початку операції з гілкою."}},"id":{"stringUnit":{"state":"translated","value":"Gateway berubah sebelum operasi utas dimulai."}},"pl":{"stringUnit":{"state":"translated","value":"Gateway zmienił się przed rozpoczęciem operacji na wątku."}},"th":{"stringUnit":{"state":"translated","value":"Gateway เปลี่ยนแปลงก่อนเริ่มดำเนินการกับเธรด."}},"vi":{"stringUnit":{"state":"translated","value":"Gateway đã thay đổi trước khi thao tác với luồng bắt đầu."}},"nl":{"stringUnit":{"state":"translated","value":"De Gateway is gewijzigd voordat de threadbewerking begon."}},"fa":{"stringUnit":{"state":"translated","value":"Gateway پیش از شروع عملیات رشتهٔ گفتگو تغییر کرد."}},"ru":{"stringUnit":{"state":"translated","value":"Gateway изменился до начала операции с веткой обсуждения."}},"sv":{"stringUnit":{"state":"translated","value":"Gateway ändrades innan trådåtgärden startade."}}}},
    "Gateway changed. Close and reopen Groups to continue.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Gateway changed. Close and reopen Groups to continue."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Gateway 已更改。 请关闭并重新打开群组以继续。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 已變更。 請關閉並重新開啟群組以繼續。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Gateway mudou. Feche e reabra Grupos para continuar."}},"de":{"stringUnit":{"state":"translated","value":"Das Gateway wurde geändert. Schließen Sie „Gruppen“ und öffnen Sie es erneut, um fortzufahren."}},"es":{"stringUnit":{"state":"translated","value":"Gateway cambió. Cierra y vuelve a abrir Grupos para continuar."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gateway が変更されました。 続行するにはグループを閉じて開き直してください。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway가 변경되었습니다. 계속하려면 그룹을 닫았다가 다시 여세요."}},"fr":{"stringUnit":{"state":"translated","value":"Gateway a changé. Fermez et rouvrez Groupes pour continuer."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway बदल गया। जारी रखने के लिए समूह बंद करके फिर से खोलें।"}},"ar":{"stringUnit":{"state":"translated","value":"تغيّر Gateway. أغلق المجموعات وأعد فتحها للمتابعة."}},"it":{"stringUnit":{"state":"translated","value":"Gateway è cambiato. Chiudi e riapri Gruppi per continuare."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway değişti. Devam etmek için Gruplar'ı kapatıp yeniden açın."}},"uk":{"stringUnit":{"state":"translated","value":"Gateway змінився. Закрийте й знову відкрийте Групи, щоб продовжити."}},"id":{"stringUnit":{"state":"translated","value":"Gateway berubah. Tutup dan buka kembali Grup untuk melanjutkan."}},"pl":{"stringUnit":{"state":"translated","value":"Gateway zmienił się. Zamknij i ponownie otwórz Grupy, aby kontynuować."}},"th":{"stringUnit":{"state":"translated","value":"Gateway เปลี่ยนแปลง. ปิดแล้วเปิดกลุ่มอีกครั้งเพื่อดำเนินการต่อ."}},"vi":{"stringUnit":{"state":"transla