    "Secure connection is required for this host.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Secure connection is required for this host."}},"zh-CN":{"stringUnit":{"state":"translated","value":"此主机需要安全连接。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此主機需要安全連線。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Uma conexão segura é necessária para este host."}},"de":{"stringUnit":{"state":"translated","value":"Für diesen Host ist eine sichere Verbindung erforderlich."}},"es":{"stringUnit":{"state":"translated","value":"Se requiere una conexión segura para este host."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このホストにはセキュアな接続が必要です。"}},"ko":{"stringUnit":{"state":"translated","value":"이 호스트에는 보안 연결이 필요합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Une connexion sécurisée est requise pour cet hôte."}},"hi":{"stringUnit":{"state":"translated","value":"इस होस्ट के लिए सुरक्षित कनेक्शन आवश्यक है."}},"ar":{"stringUnit":{"state":"translated","value":"يلزم اتصال آمن بهذا المضيف."}},"it":{"stringUnit":{"state":"translated","value":"Per questo host è richiesta una connessione sicura."}},"tr":{"stringUnit":{"state":"translated","value":"Bu ana makine için güvenli bağlantı gereklidir."}},"uk":{"stringUnit":{"state":"translated","value":"Для цього хоста потрібне захищене з’єднання."}},"id":{"stringUnit":{"state":"translated","value":"Koneksi aman diperlukan untuk host ini."}},"pl":{"stringUnit":{"state":"translated","value":"Ten host wymaga bezpiecznego połączenia."}},"th":{"stringUnit":{"state":"translated","value":"โฮสต์นี้ต้องใช้การเชื่อมต่อที่ปลอดภัย."}},"vi":{"stringUnit":{"state":"translated","value":"Máy chủ này yêu cầu kết nối bảo mật."}},"nl":{"stringUnit":{"state":"translated","value":"Voor deze host is een beveiligde verbinding vereist."}},"fa":{"stringUnit":{"state":"translated","value":"اتصال امن برای این میزبان الزامی است."}},"ru":{"stringUnit":{"state":"translated","value":"Для этого хоста требуется защищённое соединение."}},"sv":{"stringUnit":{"state":"translated","value":"En säker anslutning krävs för den här värden."}}}},
    "Secure handshake failed. Check Tailscale, then connect again.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Secure handshake failed. Check Tailscale, then connect again."}},"zh-CN":{"stringUnit":{"state":"translated","value":"安全握手失败。 请检查 Tailscale，然后重新连接。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"安全交握失敗。 請檢查 Tailscale, 然後重新連線。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Falha na negociação segura. Verifique o Tailscale e conecte-se novamente."}},"de":{"stringUnit":{"state":"translated","value":"Sicherer Handshake fehlgeschlagen. Prüfen Sie Tailscale und stellen Sie die Verbindung erneut her."}},"es":{"stringUnit":{"state":"translated","value":"Error en la negociación segura. Comprueba Tailscale y vuelve a conectarte."}},"ja-JP":{"stringUnit":{"state":"translated","value":"セキュアハンドシェイクに失敗しました。 Tailscaleを確認してから、再度接続してください。"}},"ko":{"stringUnit":{"state":"translated","value":"보안 핸드셰이크에 실패했습니다. Tailscale을 확인한 후 다시 연결하세요."}},"fr":{"stringUnit":{"state":"translated","value":"La négociation sécurisée a échoué. Vérifiez Tailscale, puis reconnectez-vous."}},"hi":{"stringUnit":{"state":"translated","value":"सुरक्षित हैंडशेक विफल हुआ. Tailscale की जाँच करें, फिर दोबारा कनेक्ट करें."}},"ar":{"stringUnit":{"state":"translated","value":"فشلت المصافحة الآمنة. تحقق من Tailscale، ثم اتصل مرة أخرى."}},"it":{"stringUnit":{"state":"translated","value":"Handshake sicuro non riuscito. Controlla Tailscale, quindi connettiti di nuovo."}},"tr":{"stringUnit":{"state":"translated","value":"Güvenli el sıkışma başarısız oldu. Tailscale'i kontrol edin, ardından yeniden bağlanın."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося встановити захищене з’єднання. Перевірте Tailscale, а потім підключіться знову."}},"id":{"stringUnit":{"state":"translated","value":"Negosiasi koneksi aman gagal. Periksa Tailscale, lalu hubungkan kembali."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się uzgodnić bezpiecznego połączenia. Sprawdź Tailscale, a następnie połącz się ponownie."}},"th":{"stringUnit":{"state":"translated","value":"การจับมือเพื่อสร้างการเชื่อมต่อที่ปลอดภัยล้มเหลว. ตรวจสอบ Tailscale แล้วเชื่อมต่ออีกครั้ง."}},"vi":{"stringUnit":{"state":"translated","value":"Bắt tay bảo mật thất bại. Kiểm tra Tailscale, rồi kết nối lại."}},"nl":{"stringUnit":{"state":"translated","value":"Beveiligde handshake mislukt. Controleer Tailscale en maak opnieuw verbinding."}},"fa":{"stringUnit":{"state":"translated","value":"دست‌دهی امن ناموفق بود. Tailscale را بررسی کنید، سپس دوباره متصل شوید."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось установить защищённое соединение. Проверьте Tailscale, затем подключитесь снова."}},"sv":{"stringUnit":{"state":"translated","value":"Säker handskakning misslyckades. Kontrollera Tailscale och anslut sedan igen."}}}},
