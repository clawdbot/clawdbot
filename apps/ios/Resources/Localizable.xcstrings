    "Location permission is restricted on this device.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Location permission is restricted on this device."}},"zh-CN":{"stringUnit":{"state":"translated","value":"此设备上的位置权限受限。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此裝置的位置權限受到限制。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A permissão de localização está restrita neste dispositivo."}},"de":{"stringUnit":{"state":"translated","value":"Der Standortzugriff ist auf diesem Gerät eingeschränkt."}},"es":{"stringUnit":{"state":"translated","value":"El permiso de ubicación está restringido en este dispositivo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このデバイスでは位置情報へのアクセスが制限されています。"}},"ko":{"stringUnit":{"state":"translated","value":"이 기기에서는 위치 접근 권한이 제한되어 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’accès à la localisation est restreint sur cet appareil."}},"hi":{"stringUnit":{"state":"translated","value":"इस डिवाइस पर स्थान की अनुमति प्रतिबंधित है."}},"ar":{"stringUnit":{"state":"translated","value":"إذن الوصول إلى الموقع مقيّد على هذا الجهاز."}},"it":{"stringUnit":{"state":"translated","value":"L'accesso alla posizione è limitato su questo dispositivo."}},"tr":{"stringUnit":{"state":"translated","value":"Bu cihazda konum izni kısıtlanmış."}},"uk":{"stringUnit":{"state":"translated","value":"Доступ до місцеположення обмежено на цьому пристрої."}},"id":{"stringUnit":{"state":"translated","value":"Izin lokasi dibatasi di perangkat ini."}},"pl":{"stringUnit":{"state":"translated","value":"Dostęp do lokalizacji jest ograniczony na tym urządzeniu."}},"th":{"stringUnit":{"state":"translated","value":"สิทธิ์เข้าถึงตำแหน่งที่ตั้งถูกจำกัดบนอุปกรณ์นี้"}},"vi":{"stringUnit":{"state":"translated","value":"Quyền truy cập vị trí bị hạn chế trên thiết bị này."}},"nl":{"stringUnit":{"state":"translated","value":"Locatietoegang is beperkt op dit apparaat."}},"fa":{"stringUnit":{"state":"translated","value":"مجوز دسترس