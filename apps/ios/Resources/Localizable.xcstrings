    "Pair this Watch with read and Talk access in iPhone Settings.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Pair this Watch with read and Talk access in iPhone Settings."}},"zh-CN":{"stringUnit":{"state":"translated","value":"在 iPhone 的设置中配对此手表，并授予读取和对话权限。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"請在 iPhone 的設定中配對此手錶，並授予讀取和對話權限。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Emparelhe este Watch com acesso de leitura e de conversa nos Ajustes do iPhone."}},"de":{"stringUnit":{"state":"translated","value":"Koppeln Sie diese Watch in den iPhone-Einstellungen mit Lese- und Sprechzugriff."}},"es":{"stringUnit":{"state":"translated","value":"Enlaza este Apple Watch con permisos de lectura y conversación en los ajustes del iPhone."}},"ja-JP":{"stringUnit":{"state":"translated","value":"iPhoneの設定で、読み取りとトークのアクセス権を付与してこのApple Watchをペアリングしてください。"}},"ko":{"stringUnit":{"state":"translated","value":"iPhone 설정에서 읽기 및 대화 권한을 부여하여 이 Watch를 페어링하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Jumelez cette Apple Watch avec les autorisations de lecture et de conversation dans les réglages de l’iPhone."}},"hi":{"stringUnit":{"state":"translated","value":"iPhone की Settings में पढ़ने और बातचीत करने की अनुमति के साथ इस Watch को पेयर करें।"}},"ar":{"stringUnit":{"state":"translated","value":"أقرن هذه الساعة مع منح صلاحيتَي القراءة والتحدث في إعدادات iPhone."}},"it":{"stringUnit":{"state":"translated","value":"Abbina questo Watch con autorizzazioni di lettura e accesso a Talk nelle impostazioni su iPhone."}},"tr":{"stringUnit":{"state":"translated","value":"iPhone Ayarları'nda bu Watch'u okuma ve konuşma erişimiyle eşleştirin."}},"uk":{"stringUnit":{"state":"translated","value":"Створіть пару з цим годинником у налаштуваннях на iPhone, надавши доступ до читання та розмов."}},"id":{"stringUnit":{"state":"translated","value":"Pasangkan Watch ini dengan akses baca dan Bicara di Pengaturan iPhone."}},"pl":{"stringUnit":{"state":"tra