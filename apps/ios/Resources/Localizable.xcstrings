    "Pair this iPhone by scanning a setup code": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Pair this iPhone by scanning a setup code"}},"zh-CN":{"stringUnit":{"state":"translated","value":"扫描设置码以配对此 iPhone"}},"zh-TW":{"stringUnit":{"state":"translated","value":"掃描設定碼以配對此 iPhone"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Pareie este iPhone escaneando um código de configuração"}},"de":{"stringUnit":{"state":"translated","value":"Dieses iPhone durch Scannen eines Einrichtungscodes koppeln"}},"es":{"stringUnit":{"state":"translated","value":"Vincula este iPhone escaneando un código de configuración"}},"ja-JP":{"stringUnit":{"state":"translated","value":"セットアップコードをスキャンしてこのiPhoneをペアリング"}},"ko":{"stringUnit":{"state":"translated","value":"설정 코드를 스캔하여 이 iPhone 페어링"}},"fr":{"stringUnit":{"state":"translated","value":"Associez cet iPhone en scannant un code de configuration"}},"hi":{"stringUnit":{"state":"translated","value":"सेटअप कोड स्कैन करके इस iPhone को पेयर करें"}},"ar":{"stringUnit":{"state":"translated","value":"أقرن جهاز iPhone هذا بمسح رمز الإعداد"}},"it":{"stringUnit":{"state":"translated","value":"Associa questo iPhone scansionando un codice di configurazione"}},"tr":{"stringUnit":{"state":"translated","value":"Bir kurulum kodunu tarayarak bu iPhone'u eşleştirin"}},"uk":{"stringUnit":{"state":"translated","value":"Створіть пару з цим iPhone, відсканувавши код налаштування"}},"id":{"stringUnit":{"state":"translated","value":"Pasangkan iPhone ini dengan memindai kode penyiapan"}},"pl":{"stringUnit":{"state":"translated","value":"Sparuj ten iPhone, skanując kod konfiguracji"}},"th":{"stringUnit":{"state":"translated","value":"จับคู่ iPhone เครื่องนี้โดยสแกนรหัสตั้งค่า"}},"vi":{"stringUnit":{"state":"translated","value":"Ghép đôi iPhone này bằng cách quét mã thiết lập"}},"nl":{"stringUnit":{"state":"translated","value":"Koppel deze iPhone door een configuratiecode te scannen"}},"fa":{"stringUnit":{"state":"translated","value":"این iPhone را با اسکن کد راه‌اندازی جفت‌سازی کنید"}},"ru":{"stringUnit":{"state":"translated","value":"Создайте пару с этим iPhone, отсканировав код настройки"}},"sv":{"stringUnit":{"state":"translated","value":"Parkoppla denna iPhone genom att skanna en konfigurationskod"}}}},
    "Paired Gateways": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Paired Gateways"}},"zh-CN":{"stringUnit":{"state":"translated","value":"已配对的 Gateway"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已配對的 Gateway"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Gateways pareados"}},"de":{"stringUnit":{"state":"translated","value":"Gekoppelte Gateways"}},"es":{"stringUnit":{"state":"translated","value":"Gateways vinculados"}},"ja-JP":{"stringUnit":{"state":"translated","value":"ペアリング済みのGateway"}},"ko":{"stringUnit":{"state":"translated","value":"페어링된 Gateway"}},"fr":{"stringUnit":{"state":"translated","value":"Gateway associés"}},"hi":{"stringUnit":{"state":"translated","value":"पेयर किए गए Gateway"}},"ar":{"stringUnit":{"state":"translated","value":"أجهزة Gateway المقترنة"}},"it":{"stringUnit":{"state":"translated","value":"Gateway associati"}},"tr":{"stringUnit":{"state":"translated","value":"Eşleştirilmiş Gateway'ler"}},"uk":{"stringUnit":{"state":"translated","value":"Спарені Gateway"}},"id":{"stringUnit":{"state":"translated","value":"Gateway Terpasang"}},"pl":{"stringUnit":{"state":"translated","value":"Sparowane Gateway"}},"th":{"stringUnit":{"state":"translated","value":"Gateway ที่จับคู่แล้ว"}},"vi":{"stringUnit":{"state":"translated","value":"Các Gateway đã ghép đôi"}},"nl":{"stringUnit":{"state":"translated","value":"Gekoppelde Gateways"}},"fa":{"stringUnit":{"state":"translated","value":"Gatewayهای جفت‌شده"}},"ru":{"stringUnit":{"state":"translated","value":"Сопряжённые Gateway"}},"sv":{"stringUnit":{"state":"translated","value":"Parkopplade Gateways"}}}},
    "Paired, but could not finish secure setup": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Paired, but could not finish secure setup"}},"zh-CN":{"stringUnit":{"state":"translated","value":"已配对, 但无法完成安全设置"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已配對, 但無法完成安全設定"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Pareado, mas não foi possível concluir a configuração segura"}},"de":{"stringUnit":{"state":"translated","value":"Gekoppelt, aber die sichere Einrichtung konnte nicht abgeschlossen werden"}},"es":{"stringUnit":{"state":"translated","value":"Vinculado, pero no se pudo completar la configuración segura"}},"ja-JP":{"stringUnit":{"state":"translated","value":"ペアリング済みですが、安全なセットアップを完了できませんでした"}},"ko":{"stringUnit":{"state":"translated","value":"페어링되었지만 보안 설정을 완료하지 못했습니다"}},"fr":{"stringUnit":{"state":"translated","value":"Associé, mais impossible de terminer la configuration sécurisée"}},"hi":{"stringUnit":{"state":"translated","value":"पेयर हो गया, लेकिन सुरक्षित सेटअप पूरा नहीं हो सका"}},"ar":{"stringUnit":{"state":"translated","value":"تم الإقران, لكن تعذّر إكمال الإعداد الآمن"}},"it":{"stringUnit":{"state":"translated","value":"Associato, ma non è stato possibile completare la configurazione sicura"}},"tr":{"stringUnit":{"state":"translated","value":"Eşleştirildi, ancak güvenli kurulum tamamlanamadı"}},"uk":{"stringUnit":{"state":"translated","value":"Пару створено, але не вдалося завершити безпечне налаштування"}},"id":{"stringUnit":{"state":"translated","value":"Terpasang, tetapi tidak dapat menyelesaikan penyiapan aman"}},"pl":{"stringUnit":{"state":"translated","value":"Sparowano, ale nie udało się ukończyć bezpiecznej konfiguracji"}},"th":{"stringUnit":{"state":"translated","value":"จับคู่แล้ว แต่ไม่สามารถตั้งค่าความปลอดภัยให้เสร็จสมบูรณ์ได้"}},"vi":{"stringUnit":{"state":"translated","value":"Đã ghép đôi, nhưng không thể hoàn tất thiết lập bảo mật"}},"nl":{"stringUnit":{"state":"translated","value":"Gekoppeld, maar de beveiligde configuratie kon niet worden voltooid"}},"fa":{"stringUnit":{"state":"translated","value":"جفت‌سازی انجام شد، اما راه‌اندازی امن تکمیل نشد"}},"ru":{"stringUnit":{"state":"translated","value":"Пара создана, но не удалось завершить безопасную настройку"}},"sv":{"stringUnit":{"state":"translated","value":"Parkopplad, men den säkra konfigurationen kunde inte slutföras"}}}},
