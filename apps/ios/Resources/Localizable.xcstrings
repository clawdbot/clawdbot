    "Voice has no ready network address.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Voice has no ready network address."}},"zh-CN":{"stringUnit":{"state":"translated","value":"语音没有就绪的网络地址。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語音沒有可用的網路位址。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O recurso de voz não tem um endereço de rede disponível."}},"de":{"stringUnit":{"state":"translated","value":"Für die Sprachfunktion ist keine Netzwerkadresse verfügbar."}},"es":{"stringUnit":{"state":"translated","value":"La función de voz no tiene una dirección de red disponible."}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声で使用できるネットワークアドレスがありません。"}},"ko":{"stringUnit":{"state":"translated","value":"음성 연결에 사용할 준비가 된 네트워크 주소가 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le mode vocal ne dispose d’aucune adresse réseau prête à l’emploi."}},"hi":{"stringUnit":{"state":"translated","value":"वॉइस के लिए कोई नेटवर्क पता तैयार नहीं है।"}},"ar":{"stringUnit":{"state":"translated","value":"لا يتوفر عنوان شبكة جاهز للاتصال الصوتي."}},"it":{"stringUnit":{"state":"translated","value":"La modalità vocale non dispone di un indirizzo di rete pronto."}},"tr":{"stringUnit":{"state":"translated","value":"Ses için hazır bir ağ adresi yok."}},"uk":{"stringUnit":{"state":"translated","value":"Для голосового зв’язку немає готової мережевої адреси."}},"id":{"stringUnit":{"state":"translated","value":"Suara tidak memiliki alamat jaringan yang siap digunakan."}},"pl":{"stringUnit":{"state":"translated","value":"Połączenie głosowe nie ma gotowego adresu sieciowego."}},"th":{"stringUnit":{"state":"translated","value":"ระบบเสียงไม่มีที่อยู่เครือข่ายที่พร้อมใช้งาน"}},"vi":{"stringUnit":{"state":"translated","value":"Tính năng thoại chưa có địa chỉ mạng sẵn sàng."}},"nl":{"stringUnit":{"state":"translated","value":"Er is geen netwerkadres beschikbaar voor spraak."}},"fa":{"stringUnit":{"state":"translated","value":"قابلیت صوتی نشانی شبکهٔ آماده‌ای ندارد."}},"ru":{"stringUnit":{"state":"translated","value":"Нет готового сетевого адреса для голосовой связи."}},"sv":{"stringUnit":{"state":"translated","value":"Röstfunktionen har ingen nätverksadress redo."}}}},
    "Voice has no supported remote network address.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Voice has no supported remote network address."}},"zh-CN":{"stringUnit":{"state":"translated","value":"语音没有受支持的远程网络地址。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語音沒有支援的遠端網路位址。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O recurso de voz não tem um endereço de rede remoto compatível."}},"de":{"stringUnit":{"state":"translated","value":"Für die Sprachfunktion ist keine unterstützte entfernte Netzwerkadresse verfügbar."}},"es":{"stringUnit":{"state":"translated","value":"La función de voz no tiene una dirección de red remota compatible."}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声に対応したリモートネットワークアドレスがありません。"}},"ko":{"stringUnit":{"state":"translated","value":"음성 연결에 지원되는 원격 네트워크 주소가 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le mode vocal ne dispose d’aucune adresse réseau distante prise en charge."}},"hi":{"stringUnit":{"state":"translated","value":"वॉइस के लिए कोई समर्थित रिमोट नेटवर्क पता नहीं है।"}},"ar":{"stringUnit":{"state":"translated","value":"لا يتوفر عنوان شبكة بعيد مدعوم للاتصال الصوتي."}},"it":{"stringUnit":{"state":"translated","value":"La modalità vocale non dispone di un indirizzo di rete remoto supportato."}},"tr":{"stringUnit":{"state":"translated","value":"Ses için desteklenen bir uzak ağ adresi yok."}},"uk":{"stringUnit":{"state":"translated","value":"Для голосового зв’язку немає підтримуваної віддаленої мережевої адреси."}},"id":{"stringUnit":{"state":"translated","value":"Suara tidak memiliki alamat jaringan jarak jauh yang didukung."}},"pl":{"stringUnit":{"state":"translated","value":"Połączenie głosowe nie ma obsługiwanego zdalnego adresu sieciowego."}},"th":{"stringUnit":{"state":"translated","value":"ระบบเสียงไม่มีที่อยู่เครือข่ายระยะไกลที่รองรับ"}},"vi":{"stringUnit":{"state":"translated","value":"Tính năng thoại không có địa chỉ mạng từ xa được hỗ trợ."}},"nl":{"strin