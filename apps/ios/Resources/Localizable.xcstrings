    "Tasks for this agent will appear here.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Tasks for this agent will appear here."}},"zh-CN":{"stringUnit":{"state":"translated","value":"此智能体的任务将显示在这里。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此代理的任務將顯示於此。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"As tarefas deste agente aparecerão aqui."}},"de":{"stringUnit":{"state":"translated","value":"Aufgaben für diesen Agenten werden hier angezeigt."}},"es":{"stringUnit":{"state":"translated","value":"Las tareas de este agente aparecerán aquí."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このエージェントのタスクがここに表示されます。"}},"ko":{"stringUnit":{"state":"translated","value":"이 에이전트의 작업이 여기에 표시됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les tâches de cet agent apparaîtront ici."}},"hi":{"stringUnit":{"state":"translated","value":"इस एजेंट के कार्य यहाँ दिखाई देंगे."}},"ar":{"stringUnit":{"state":"translated","value":"ستظهر مهام هذا الوكيل هنا."}},"it":{"stringUnit":{"state":"translated","value":"Le attività di questo agente appariranno qui."}},"tr":{"stringUnit":{"state":"translated","value":"Bu ajanın görevleri burada görünecek."}},"uk":{"stringUnit":{"state":"translated","value":"Тут з’являтимуться завдання для цього агента."}},"id":{"stringUnit":{"state":"translated","value":"Tugas untuk agen ini akan muncul di sini."}},"pl":{"stringUnit":{"state":"translated","value":"Tutaj pojawią się zadania tego agenta."}},"th":{"stringUnit":{"state":"translated","value":"งานสำหรับเอเจนต์นี้จะปรากฏที่นี่."}},"vi":{"stringUnit":{"state":"translated","value":"Các tác vụ của tác nhân này sẽ xuất hiện ở đây."}},"nl":{"stringUnit":{"state":"translated","value":"Taken voor deze agent verschijnen hier."}},"fa":{"stringUnit":{"state":"translated","value":"وظایف این عامل در اینجا نمایش داده می‌شوند."}},"ru":{"stringUnit":{"state":"translated","value":"Здесь появятся задачи этого агента."}},"sv":{"stringUnit":{"state":"translated","va