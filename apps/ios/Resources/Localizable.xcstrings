    "Voice is already connecting.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Voice is already connecting."}},"zh-CN":{"stringUnit":{"state":"translated","value":"语音正在连接中。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語音已在連線中。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O recurso de voz já está se conectando."}},"de":{"stringUnit":{"state":"translated","value":"Die Sprachfunktion stellt bereits eine Verbindung her."}},"es":{"stringUnit":{"state":"translated","value":"La función de voz ya se está conectando."}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声はすでに接続中です。"}},"ko":{"stringUnit":{"state":"translated","value":"이미 음성 연결 중입니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le mode vocal est déjà en cours de connexion."}},"hi":{"stringUnit":{"state":"translated","value":"वॉइस पहले से कनेक्ट हो रहा है।"}},"ar":{"stringUnit":{"state":"translated","value":"جارٍ بالفعل إنشاء الاتصال الصوتي."}},"it":{"stringUnit":{"state":"translated","value":"La connessione della modalità vocale è già in corso."}},"tr":{"stringUnit":{"state":"translated","value":"Ses bağlantısı zaten kuruluyor."}},"uk":{"stringUnit":{"state":"translated","value":"Голосовий зв’язок уже підключається."}},"id":{"stringUnit":{"state":"translated","value":"Suara sedang menghubungkan."}},"pl":{"stringUnit":{"state":"translated","value":"Trwa już nawiązywanie połączenia głosowego."}},"th":{"stringUnit":{"state":"translated","value":"ระบบเสียงกำลังเชื่อมต่ออยู่แล้ว"}},"vi":{"stringUnit":{"state":"translated","value":"Tính năng thoại đang kết nối."}},"nl":{"stringUnit":{"state":"translated","value":"De spraakverbinding wordt al tot stand gebracht."}},"fa":{"stringUnit":{"state":"translated","value":"قابلیت صوتی از قبل در حال اتصال است."}},"ru":{"stringUnit":{"state":"translated","value":"Голосовая связь уже подключается."}},"sv":{"stringUnit":{"state":"translated","value":"Röstfunktionen håller redan på att ansluta."}}}},
    "Voice lost its media route.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Voice lost its media route."}},"zh-CN":{"stringUnit":{"state":"translated","value":"语音的媒体路由已丢失。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語音的媒體路由已中斷。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O recurso de voz perdeu a rota de mídia."}},"de":{"stringUnit":{"state":"translated","value":"Die Sprachfunktion hat ihren Medienpfad verloren."}},"es":{"stringUnit":{"state":"translated","value":"La función de voz perdió su ruta multimedia."}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声のメディアルートが失われました。"}},"ko":{"stringUnit":{"state":"translated","value":"음성 미디어 경로가 끊어졌습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le mode vocal a perdu son canal multimédia."}},"hi":{"stringUnit":{"state":"translated","value":"वॉइस का मीडिया रूट खो गया।"}},"ar":{"stringUnit":{"state":"translated","value":"فقد الاتصال الصوتي مسار الوسائط."}},"it":{"stringUnit":{"state":"translated","value":"La modalità vocale ha perso il percorso multimediale."}},"tr":{"stringUnit":{"state":"translated","value":"Ses, medya yolunu kaybetti."}},"uk":{"stringUnit":{"state":"translated","value":"Голосовий зв’язок втратив маршрут передавання медіаданих."}},"id":{"stringUnit":{"state":"translated","value":"Suara kehilangan rute medianya."}},"pl":{"stringUnit":{"state":"translated","value":"Połączenie głosowe utraciło ścieżkę przesyłania multimediów."}},"th":{"stringUnit":{"state":"translated","value":"ระบบเสียงสูญเสียเส้นทางรับส่งสื่อ"}},"vi":{"stringUnit":{"state":"translated","value":"Tính năng thoại đã mất đường truyền đa phương tiện."}},"nl":{"stringUnit":{"state":"translated","value":"De mediaroute voor spraak is verloren gegaan."}},"fa":{"stringUnit":{"state":"translated","value":"قابلیت صوتی مسیر رسانهٔ خود را از دست داد."}},"ru":{"stringUnit":{"state":"translated","value":"Голосовая связь потеряла маршрут передачи медиаданных."}},"sv":{"stringUnit":{"state":"