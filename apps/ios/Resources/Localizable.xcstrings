    "Update OpenClaw on iPhone and Apple Watch before sending Watch messages.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Update OpenClaw on iPhone and Apple Watch before sending Watch messages."}},"zh-CN":{"stringUnit":{"state":"translated","value":"发送 Watch 消息前，请更新 iPhone 和 Apple Watch 上的 OpenClaw."}},"zh-TW":{"stringUnit":{"state":"translated","value":"傳送 Watch 訊息前，請先更新 iPhone 和 Apple Watch 上的 OpenClaw."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Atualize o OpenClaw no iPhone e no Apple Watch antes de enviar mensagens do Watch."}},"de":{"stringUnit":{"state":"translated","value":"Aktualisieren Sie OpenClaw auf dem iPhone und der Apple Watch, bevor Sie Watch-Nachrichten senden."}},"es":{"stringUnit":{"state":"translated","value":"Actualiza OpenClaw en el iPhone y el Apple Watch antes de enviar mensajes desde el Watch."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Watchのメッセージを送信する前に、iPhoneとApple WatchのOpenClawを更新してください。"}},"ko":{"stringUnit":{"state":"translated","value":"Watch 메시지를 보내기 전에 iPhone과 Apple Watch에서 OpenClaw를 업데이트하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Mettez à jour OpenClaw sur iPhone et Apple Watch avant d’envoyer des messages depuis la Watch."}},"hi":{"stringUnit":{"state":"translated","value":"Watch संदेश भेजने से पहले iPhone और Apple Watch पर OpenClaw अपडेट करें."}},"ar":{"stringUnit":{"state":"translated","value":"حدّث OpenClaw على iPhone وApple Watch قبل إرسال رسائل Watch."}},"it":{"stringUnit":{"state":"translated","value":"Aggiorna OpenClaw su iPhone e Apple Watch prima di inviare messaggi da Watch."}},"tr":{"stringUnit":{"state":"translated","value":"Watch mesajlarını göndermeden önce iPhone ve Apple Watch üzerindeki OpenClaw uygulamasını güncelleyin."}},"uk":{"stringUnit":{"state":"translated","value":"Оновіть OpenClaw на iPhone та Apple Watch, перш ніж надсилати повідомлення з Watch."}},"id":{"stringUnit":{"state":"translated","value":"Perbarui OpenClaw di iPhone dan Apple Watch sebelum mengirim pesan Watch."}},"pl":{"stringUnit":{"state":"translated","value":"Zaktualizuj OpenClaw na iPhonie i Apple Watch przed wysłaniem wiadomości z zegarka."}},"th":{"stringUnit":{"state":"translated","value":"อัปเดต OpenClaw บน iPhone และ Apple Watch ก่อนส่งข้อความจาก Watch"}},"vi":{"stringUnit":{"state":"translated","value":"Cập nhật OpenClaw trên iPhone và Apple Watch trước khi gửi tin nhắn từ Watch."}},"nl":{"stringUnit":{"state":"translated","value":"Werk OpenClaw bij op iPhone en Apple Watch voordat je Watch-berichten verstuurt."}},"fa":{"stringUnit":{"state":"translated","value":"پیش از ارسال پیام‌های Watch، OpenClaw را در iPhone و Apple Watch به‌روزرسانی کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Обновите OpenClaw на iPhone и Apple Watch перед отправкой сообщений с Watch."}},"sv":{"stringUnit":{"state":"translated","value":"Uppdatera OpenClaw på iPhone och Apple Watch innan du skickar Watch-meddelanden."}}}},
    "Update OpenClaw on iPhone and Apple Watch, then request a new prompt.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Update OpenClaw on iPhone and Apple Watch, then request a new prompt."}},"zh-CN":{"stringUnit":{"state":"translated","value":"请更新 iPhone 和 Apple Watch 上的 OpenClaw，然后请求新的提示。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"請更新 iPhone 和 Apple Watch 上的 OpenClaw，然後要求新的提示。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Atualize o OpenClaw no iPhone e no Apple Watch e solicite um novo prompt."}},"de":{"stringUnit":{"state":"translated","value":"Aktualisieren Sie OpenClaw auf dem iPhone und der Apple Watch und fordern Sie dann eine neue Eingabeaufforderung an."}},"es":{"stringUnit":{"state":"translated","value":"Actualiza OpenClaw en el iPhone y el Apple Watch y luego solicita una nueva indicación."}},"ja-JP":{"stringUnit":{"state":"translated","value":"iPhoneとApple WatchのOpenClawを更新してから、新しいプロンプトをリクエストしてください。"}},"ko":{"stringUnit":{"state":"translated","value":"iPhone과 Apple Watch에서 OpenClaw를 업데이트한 다음 새 프롬프트를 요청하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Mettez à jour OpenClaw sur iPhone et Apple Watch, puis demandez une nouvelle invite."}},"hi":{"stringUnit":{"state":"translated","value":"iPhone और Apple Watch पर OpenClaw अपडेट करें, फिर नए प्रॉम्प्ट का अनुरोध करें."}},"ar":{"stringUnit":{"state":"translated","value":"حدّث OpenClaw على iPhone وApple Watch، ثم اطلب مطالبة جديدة."}},"it":{"stringUnit":{"state":"translated","value":"Aggiorna OpenClaw su iPhone e Apple Watch, poi richiedi un nuovo prompt."}},"tr":{"stringUnit":{"state":"translated","value":"iPhone ve Apple Watch üzerindeki OpenClaw uygulamasını güncelleyin, ardından yeni bir istem isteyin."}},"uk":{"stringUnit":{"state":"translated","value":"Оновіть OpenClaw на iPhone та Apple Watch, а потім надішліть новий запит."}},"id":{"stringUnit":{"state":"translated","value":"Perbarui OpenClaw di iPhone dan Apple Watch, lalu minta prompt baru."}},"pl":{"stringUnit":{"state":"translated","value":"Zaktualizuj OpenClaw na iPhonie i Apple Watch, a następnie poproś o nowy monit."}},"th":{"stringUnit":{"state":"translated","value":"อัปเดต OpenClaw บน iPhone และ Apple Watch แล้วขอพรอมต์ใหม่"}},"vi":{"stringUnit":{"state":"translated","value":"Cập nhật OpenClaw trên iPhone và Apple Watch, rồi yêu cầu lời nhắc mới."}},"nl":{"stringUnit":{"state":"translated","value":"Werk OpenClaw bij op iPhone en Apple Watch en vraag vervolgens een nieuwe prompt aan."}},"fa":{"stringUnit":{"state":"translated","value":"OpenClaw را در iPhone و Apple Watch به‌روزرسانی کنید، سپس درخواست یک اعلان جدید کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Обновите OpenClaw на iPhone и Apple Watch, затем запросите новое приглашение."}},"sv":{"stringUnit":{"state":"translated","value":"Uppdatera OpenClaw på iPhone och Apple Watch och begär sedan en ny prompt."}}}},
    "Update OpenClaw on iPhone and Watch.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Update OpenClaw on iPhone and Watch."}},"zh-CN":{"stringUnit":{"state":"translated","value":"请更新 iPhone 和 Watch 上的 OpenClaw."}},"zh-TW":{"stringUnit":{"state":"translated","value":"請更新 iPhone 和 Watch 上的 OpenClaw."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Atualize o OpenClaw no iPhone e no Watch."}},"de":{"stringUnit":{"state":"translated","value":"Aktualisieren Sie OpenClaw auf dem iPhone und der Watch."}},"es":{"stringUnit":{"state":"translated","value":"Actualiza OpenClaw en el iPhone y el Watch."}},"ja-JP":{"stringUnit":{"state":"translated","value":"iPhoneとWatchのOpenClawを更新してください。"}},"ko":{"stringUnit":{"state":"translated","value":"iPhone과 Watch에서 OpenClaw를 업데이트하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Mettez à jour OpenClaw sur iPhone et Watch."}},"hi":{"stringUnit":{"state":"translated","value":"iPhone और Watch पर OpenClaw अपडेट करें."}},"ar":{"stringUnit":{"state":"translated","value":"حدّث OpenClaw على iPhone وWatch."}},"it":{"stringUnit":{"state":"translated","value":"Aggiorna OpenClaw su iPhone e Watch."}},"tr":{"stringUnit":{"state":"translated","value":"iPhone ve Watch üzerindeki OpenClaw uygulamasını güncelleyin."}},"uk":{"stringUnit":{"state":"translated","value":"Оновіть OpenClaw на iPhone та Watch."}},"id":{"stringUnit":{"state":"translated","value":"Perbarui OpenClaw di iPhone dan Watch."}},"pl":{"stringUnit":{"state":"translated","value":"Zaktualizuj OpenClaw na iPhonie i Apple Watch."}},"th":{"stringUnit":{"state":"translated","value":"อัปเดต OpenClaw บน iPhone และ Watch"}},"vi":{"stringUnit":{"state":"translated","value":"Cập nhật OpenClaw trên iPhone và Watch."}},"nl":{"stringUnit":{"state":"translated","value":"Werk OpenClaw bij op iPhone en Watch."}},"fa":{"stringUnit":{"state":"translated","value":"OpenClaw را در iPhone و Watch به‌روزرسانی کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Обновите OpenClaw на iPhone и Watch."}},"sv":{"stringUnit":{"state":"translated","value":"Uppdatera OpenClaw på iPhone och Watch."}}}},
    "Update gateway token": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Update gateway token"}},"zh-CN":{"stringUnit":{"state":"translated","value":"更新 Gateway 令牌"}},"zh-TW":{"stringUnit":{"state":"translated","value":"更新 Gateway 權杖"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Atualizar token do Gateway"}},"de":{"stringUnit":{"state":"translated","value":"Gateway-Token aktualisieren"}},"es":{"stringUnit":{"state":"translated","value":"Actualizar el token del Gateway"}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayトークンを更新"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway 토큰 업데이트"}},"fr":{"stringUnit":{"state":"translated","value":"Mettre à jour le jeton du Gateway"}},"hi":{"stringUnit":{"state":"translated","value":"Gateway टोकन अपडेट करें"}},"ar":{"stringUnit":{"state":"translated","value":"تحديث رمز Gateway"}},"it":{"stringUnit":{"state":"translated","value":"Aggiorna il token del gateway"}},"tr":{"stringUnit":{"state":"translated","value":"Gateway belirtecini güncelle"}},"uk":{"stringUnit":{"state":"translated","value":"Оновити токен Gateway"}},"id":{"stringUnit":{"state":"translated","value":"Perbarui token gateway"}},"pl":{"stringUnit":{"state":"translated","value":"Zaktualizuj token Gateway"}},"th":{"stringUnit":{"state":"translated","value":"อัปเดตโทเค็น Gateway"}},"vi":{"stringUnit":{"state":"translated","value":"Cập nhật token Gateway"}},"nl":{"stringUnit":{"state":"translated","value":"Gateway-token bijwerken"}},"fa":{"stringUnit":{"state":"translated","value":"به‌روزرسانی توکن Gateway"}},"ru":{"stringUnit":{"state":"translated","value":"Обновить токен Gateway"}},"sv":{"stringUnit":{"state":"translated","value":"Uppdatera Gateway-token"}}}},
    "Update the gateway before sending queued messages with session settings.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Update the gateway before sending queued messages with session settings."}},"zh-CN":{"stringUnit":{"state":"translated","value":"使用会话设置发送排队消息前，请更新 Gateway."}},"zh-TW":{"stringUnit":{"state":"translated","value":"使用工作階段設定傳送佇列中的訊息前，請先更新 Gateway."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Atualize o Gateway antes de enviar mensagens na fila com as configurações da sessão."}},"de":{"stringUnit":{"state":"translated","value":"Aktualisieren Sie das Gateway, bevor Sie Nachrichten aus der Warteschlange mit Sitzungseinstellungen senden."}},"es":{"stringUnit":{"state":"translated","value":"Actualiza el Gateway antes de enviar mensajes en cola con la configuración de la sesión."}},"ja-JP":{"stringUnit":{"state":"translated","value":"セッション設定を使用してキュー内のメッセージを送信する前に、Gatewayを更新してください。"}},"ko":{"stringUnit":{"state":"translated","value":"세션 설정을 적용하여 대기 중인 메시지를 보내기 전에 Gateway를 업데이트하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Mettez à jour le Gateway avant d’envoyer les messages en attente avec les paramètres de session."}},"hi":{"stringUnit":{"state":"translated","value":"सत्र सेटिंग्स के साथ कतार में लगे संदेश भेजने से पहले Gateway अपडेट करें."}},"ar":{"stringUnit":{"state":"translated","value":"حدّث Gateway قبل إرسال الرسائل الموجودة في قائمة الانتظار باستخدام إعدادات الجلسة."}},"it":{"stringUnit":{"state":"translated","value":"Aggiorna il gateway prima di inviare i messaggi in coda con le impostazioni della sessione."}},"tr":{"stringUnit":{"state":"translated","value":"Kuyruktaki mesajları oturum ayarlarıyla göndermeden önce Gateway'i güncelleyin."}},"uk":{"stringUnit":{"state":"translated","value":"Оновіть Gateway, перш ніж надсилати повідомлення з черги з налаштуваннями сеансу."}},"id":{"stringUnit":{"state":"translated","value":"Perbarui gateway sebelum mengirim pesan dalam antrean dengan pengaturan sesi."}},"pl":{"stringUnit":{"state":"translated","value":"Zaktualizuj Gateway przed wysłaniem zakolejkowanych wiadomości z ustawieniami sesji."}},"th":{"stringUnit":{"state":"translated","value":"อัปเดต Gateway ก่อนส่งข้อความในคิวพร้อมการตั้งค่าเซสชัน"}},"vi":{"stringUnit":{"state":"translated","value":"Cập nhật Gateway trước khi gửi các tin nhắn trong hàng đợi với cài đặt phiên."}},"nl":{"stringUnit":{"state":"translated","value":"Werk de gateway bij voordat je berichten in de wachtrij met sessie-instellingen verstuurt."}},"fa":{"stringUnit":{"state":"translated","value":"پیش از ارسال پیام‌های در صف با تنظیمات نشست، Gateway را به‌روزرسانی کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Обновите Gateway перед отправкой сообщений из очереди с настройками сеанса."}},"sv":{"stringUnit":{"state":"translated","value":"Uppdatera Gateway innan du skickar köade meddelanden med sessionsinställningar."}}}},
    "Update the gateway before sending queued messages. This version requires safe delivery routing.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Update the gateway before sending queued messages. This version requires safe delivery routing."}},"zh-CN":{"stringUnit":{"state":"translated","value":"请先更新 Gateway，再发送排队中的消息。此版本需要安全的消息投递路由。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"請先更新 Gateway，再傳送佇列中的訊息。此版本需要安全傳送路由。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Atualize o Gateway antes de enviar mensagens na fila. Esta versão exige roteamento seguro de entrega."}},"de":{"stringUnit":{"state":"translated","value":"Aktualisieren Sie das Gateway, bevor Sie Nachrichten aus der Warteschlange senden. Diese Version erfordert sicheres Zustellungsrouting."}},"es":{"stringUnit":{"state":"translated","value":"Actualiza el Gateway antes de enviar los mensajes en cola. Esta versión requiere un enrutamiento de entrega seguro."}},"ja-JP":{"stringUnit":{"state":"translated","value":"キュー内のメッセージを送信する前に、Gatewayを更新してください。このバージョンには安全な配信ルーティングが必要です。"}},"ko":{"stringUnit":{"state":"translated","value":"대기 중인 메시지를 보내기 전에 Gateway를 업데이트하세요. 이 버전에는 안전한 전송 라우팅이 필요합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Mettez à jour le Gateway avant d’envoyer les messages en attente. Cette version nécessite un routage sécurisé pour la livraison."}},"hi":{"stringUnit":{"state":"translated","value":"कतार में मौजूद संदेश भेजने से पहले Gateway अपडेट करें। इस संस्करण के लिए सुरक्षित डिलीवरी रूटिंग आवश्यक है।"}},"ar":{"stringUnit":{"state":"translated","value":"حدّث Gateway قبل إرسال الرسائل في قائمة الانتظار. يتطلب هذا الإصدار توجيهًا آمنًا للتسليم."}},"it":{"stringUnit":{"state":"translated","value":"Aggiorna il Gateway prima di inviare i messaggi in coda. Questa versione richiede un instradamento sicuro per la consegna."}},"tr":{"stringUnit":{"state":"translated","value":"Kuyruktaki mesajları göndermeden önce Gateway'i güncelleyin. Bu sürüm güvenli teslimat yönlendirmesi gerektirir."}},"uk":{"stringUnit":{"state":"translated","value":"Оновіть Gateway, перш ніж надсилати повідомлення з черги. Ця версія потребує безпечної маршрутизації доставки."}},"id":{"stringUnit":{"state":"translated","value":"Perbarui Gateway sebelum mengirim pesan dalam antrean. Versi ini memerlukan perutean pengiriman yang aman."}},"pl":{"stringUnit":{"state":"translated","value":"Zaktualizuj Gateway przed wysłaniem wiadomości z kolejki. Ta wersja wymaga bezpiecznego routingu dostarczania."}},"th":{"stringUnit":{"state":"translated","value":"อัปเดต Gateway ก่อนส่งข้อความที่อยู่ในคิว เวอร์ชันนี้ต้องใช้การกำหนดเส้นทางการส่งที่ปลอดภัย"}},"vi":{"stringUnit":{"state":"translated","value":"Cập nhật Gateway trước khi gửi tin nhắn trong hàng đợi. Phiên bản này yêu cầu định tuyến gửi an toàn."}},"nl":{"stringUnit":{"state":"translated","value":"Werk de Gateway bij voordat je berichten uit de wachtrij verzendt. Deze versie vereist veilige routering voor de bezorging."}},"fa":{"stringUnit":{"state":"translated","value":"پیش از ارسال پیام‌های در صف، Gateway را به‌روزرسانی کنید. این نسخه به مسیریابی امن برای تحویل پیام نیاز دارد."}},"ru":{"stringUnit":{"state":"translated","value":"Обновите Gateway перед отправкой сообщений из очереди. Для этой версии требуется безопасная маршрутизация доставки."}},"sv":{"stringUnit":{"state":"translated","value":"Uppdatera Gateway innan du skickar köade meddelanden. Den här versionen kräver säker leveransroutning."}}}},
    "Update the gateway to load progress cards for this agent.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Update the gateway to load progress cards for this agent."}},"zh-CN":{"stringUnit":{"state":"translated","value":"请更新 Gateway，以加载此智能体的进度卡片。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"請更新 Gateway，以載入此代理的進度卡片。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Atualize o Gateway para carregar os cartões de progresso deste agente."}},"de":{"stringUnit":{"state":"translated","value":"Aktualisieren Sie das Gateway, um Fortschrittskarten für diesen Agenten zu laden."}},"es":{"stringUnit":{"state":"translated","value":"Actualiza el Gateway para cargar las tarjetas de progreso de este agente."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このエージェントの進捗カードを読み込むには、Gatewayを更新してください。"}},"ko":{"stringUnit":{"state":"translated","value":"이 에이전트의 진행 상황 카드를 불러오려면 Gateway를 업데이트하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Mettez à jour le Gateway pour charger les cartes de progression de cet agent."}},"hi":{"stringUnit":{"state":"translated","value":"इस एजेंट के प्रगति कार्ड लोड करने के लिए Gateway अपडेट करें।"}},"ar":{"stringUnit":{"state":"translated","value":"حدّث Gateway لتحميل بطاقات التقدم لهذا الوكيل."}},"it":{"stringUnit":{"state":"translated","value":"Aggiorna il Gateway per caricare le schede di avanzamento di questo agente."}},"tr":{"stringUnit":{"state":"translated","value":"Bu ajanın ilerleme kartlarını yüklemek için Gateway'i güncelleyin."}},"uk":{"stringUnit":{"state":"translated","value":"Оновіть Gateway, щоб завантажити картки перебігу виконання для цього агента."}},"id":{"stringUnit":{"state":"translated","value":"Perbarui Gateway untuk memuat kartu progres agen ini."}},"pl":{"stringUnit":{"state":"translated","value":"Zaktualizuj Gateway, aby wczytać karty postępu dla tego agenta."}},"th":{"stringUnit":{"state":"translated","value":"อัปเดต Gateway เพื่อโหลดการ์ดความคืบหน้าของเอเจนต์นี้"}},"vi":{"stringUnit":{"state":"translated","value":"Cập nhật Gateway để tải các thẻ tiến độ cho tác nhân này."}},"nl":{"stringUnit":{"state":"translated","value":"Werk de Gateway bij om voortgangskaarten voor deze agent te laden."}},"fa":{"stringUnit":{"state":"translated","value":"برای بارگذاری کارت‌های پیشرفت این عامل، Gateway را به‌روزرسانی کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Обновите Gateway, чтобы загрузить карточки прогресса для этого агента."}},"sv":{"stringUnit":{"state":"translated","value":"Uppdatera Gateway för att läsa in förloppskort för den här agenten."}}}},
