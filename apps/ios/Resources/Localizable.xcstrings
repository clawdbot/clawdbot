    "Pairing Approval": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Pairing Approval"}},"zh-CN":{"stringUnit":{"state":"translated","value":"配对批准"}},"zh-TW":{"stringUnit":{"state":"translated","value":"配對核准"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Aprovação de Pareamento"}},"de":{"stringUnit":{"state":"translated","value":"Kopplungsgenehmigung"}},"es":{"stringUnit":{"state":"translated","value":"Aprobación de vinculación"}},"ja-JP":{"stringUnit":{"state":"translated","value":"ペアリングの承認"}},"ko":{"stringUnit":{"state":"translated","value":"페어링 승인"}},"fr":{"stringUnit":{"state":"translated","value":"Approbation du jumelage"}},"hi":{"stringUnit":{"state":"translated","value":"पेयरिंग की स्वीकृति"}},"ar":{"stringUnit":{"state":"translated","value":"الموافقة على الاقتران"}},"it":{"stringUnit":{"state":"translated","value":"Approvazione dell'abbinamento"}},"tr":{"stringUnit":{"state":"translated","value":"Eşleştirme Onayı"}},"uk":{"stringUnit":{"state":"translated","value":"Схвалення сполучення"}},"id":{"stringUnit":{"state":"translated","value":"Persetujuan Pemasangan"}},"pl":{"stringUnit":{"state":"translated","value":"Zatwierdzenie parowania"}},"th":{"stringUnit":{"state":"translated","value":"การอนุมัติการจับคู่"}},"vi":{"stringUnit":{"state":"translated","value":"Phê duyệt ghép nối"}},"nl":{"stringUnit":{"state":"translated","value":"Goedkeuring van koppeling"}},"fa":{"stringUnit":{"state":"translated","value":"تأیید جفت‌سازی"}},"ru":{"stringUnit":{"state":"translated","value":"Подтверждение сопряжения"}},"sv":{"stringUnit":{"state":"translated","value":"Godkännande av parkoppling"}}}},
    "Pairing required. Run /pair approve in your OpenClaw chat, then connect again.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Pairing required. Run /pair approve in your OpenClaw chat, then connect again."}},"zh-CN":{"stringUnit":{"state":"translated","value":"需要配对。在 OpenClaw 聊天中运行 /pair approve，然后重新连接。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"需要配對。 請在 OpenClaw 聊天中執行 /pair approve, 然後重新連線。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Pareamento necessário. Execute /pair approve no seu chat do OpenClaw e conecte-se novamente."}},"de":{"stringUnit":{"state":"translated","value":"Kopplung erforderlich. Führen Sie /pair approve in Ihrem OpenClaw-Chat aus und stellen Sie dann die Verbindung erneut her."}},"es":{"stringUnit":{"state":"translated","value":"Se requiere vinculación. Ejecuta /pair approve en tu chat de OpenClaw y vuelve a conectarte."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ペアリングが必要です。 OpenClawのチャットで /pair approve を実行してから、再接続してください。"}},"ko":{"stringUnit":{"state":"translated","value":"페어링이 필요합니다. OpenClaw 채팅에서 /pair approve를 실행한 다음 다시 연결하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Jumelage requis. Exécutez /pair approve dans votre conversation OpenClaw, puis reconnectez-vous."}},"hi":{"stringUnit":{"state":"translated","value":"पेयरिंग आवश्यक है. अपनी OpenClaw चैट में /pair approve चलाएँ, फिर दोबारा कनेक्ट करें."}},"ar":{"stringUnit":{"state":"translated","value":"الاقتران مطلوب. شغّل /pair approve في محادثة OpenClaw، ثم اتصل مجددًا."}},"it":{"stringUnit":{"state":"translated","value":"Abbinamento richiesto. Esegui /pair approve nella tua chat OpenClaw, quindi connettiti di nuovo."}},"tr":{"stringUnit":{"state":"translated","value":"Eşleştirme gerekli. OpenClaw sohbetinizde /pair approve komutunu çalıştırın, ardından tekrar bağlanın."}},"uk":{"stringUnit":{"state":"translated","value":"Потрібне сполучення. Виконайте /pair approve у чаті OpenClaw, а потім підключіться знову."}},"id":{"stringUnit":{"state":"translated","value":"Pemasangan diperlukan. Jalankan /pair approve di obrolan OpenClaw Anda, lalu hubungkan lagi."}},"pl":{"stringUnit":{"state":"translated","value":"Wymagane parowanie. Uruchom /pair approve na czacie OpenClaw, a następnie połącz się ponownie."}},"th":{"stringUnit":{"state":"translated","value":"ต้องจับคู่ก่อน. เรียกใช้ /pair approve ในแชท OpenClaw ของคุณ จากนั้นเชื่อมต่ออีกครั้ง."}},"vi":{"stringUnit":{"state":"translated","value":"Cần ghép nối. Chạy /pair approve trong cuộc trò chuyện OpenClaw của bạn, rồi kết nối lại."}},"nl":{"stringUnit":{"state":"translated","value":"Koppeling vereist. Voer /pair approve uit in je OpenClaw-chat en maak opnieuw verbinding."}},"fa":{"stringUnit":{"state":"translated","value":"جفت‌سازی لازم است. در گفتگوی OpenClaw خود /pair approve را اجرا کنید، سپس دوباره متصل شوید."}},"ru":{"stringUnit":{"state":"translated","value":"Требуется сопряжение. Выполните /pair approve в чате OpenClaw, затем подключитесь снова."}},"sv":{"stringUnit":{"state":"translated","value":"Parkoppling krävs. Kör /pair approve i din OpenClaw-chatt och anslut sedan igen."}}}},
    "Paste a setup code to continue.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Paste a setup code to continue."}},"zh-CN":{"stringUnit":{"state":"translated","value":"请粘贴设置代码以继续。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"貼上設定碼以繼續。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Cole um código de configuração para continuar."}},"de":{"stringUnit":{"state":"translated","value":"Fügen Sie einen Einrichtungscode ein, um fortzufahren."}},"es":{"stringUnit":{"state":"translated","value":"Pega un código de configuración para continuar."}},"ja-JP":{"stringUnit":{"state":"translated","value":"続行するにはセットアップコードを貼り付けてください。"}},"ko":{"stringUnit":{"state":"translated","value":"계속하려면 설정 코드를 붙여넣으세요."}},"fr":{"stringUnit":{"state":"translated","value":"Collez un code de configuration pour continuer."}},"hi":{"stringUnit":{"state":"translated","value":"जारी रखने के लिए सेटअप कोड पेस्ट करें."}},"ar":{"stringUnit":{"state":"translated","value":"الصق رمز إعداد للمتابعة."}},"it":{"stringUnit":{"state":"translated","value":"Incolla un codice di configurazione per continuare."}},"tr":{"stringUnit":{"state":"translated","value":"Devam etmek için bir kurulum kodu yapıştırın."}},"uk":{"stringUnit":{"state":"translated","value":"Вставте код налаштування, щоб продовжити."}},"id":{"stringUnit":{"state":"translated","value":"Tempel kode penyiapan untuk melanjutkan."}},"pl":{"stringUnit":{"state":"translated","value":"Wklej kod konfiguracji, aby kontynuować."}},"th":{"stringUnit":{"state":"translated","value":"วางรหัสตั้งค่าเพื่อดำเนินการต่อ."}},"vi":{"stringUnit":{"state":"translated","value":"Dán mã thiết lập để tiếp tục."}},"nl":{"stringUnit":{"state":"translated","value":"Plak een installatiecode om door te gaan."}},"fa":{"stringUnit":{"state":"translated","value":"برای ادامه، یک کد راه‌اندازی جای‌گذاری کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Вставьте код настройки, чтобы продолжить."}},"sv":{"stringUnit":{"state":"translated"