    "Waiting for iPhone": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Waiting for iPhone"}},"zh-CN":{"stringUnit":{"state":"translated","value":"正在等待 iPhone"}},"zh-TW":{"stringUnit":{"state":"translated","value":"正在等待 iPhone"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Aguardando o iPhone"}},"de":{"stringUnit":{"state":"translated","value":"Warten auf iPhone"}},"es":{"stringUnit":{"state":"translated","value":"Esperando al iPhone"}},"ja-JP":{"stringUnit":{"state":"translated","value":"iPhone を待機中"}},"ko":{"stringUnit":{"state":"translated","value":"iPhone 대기 중"}},"fr":{"stringUnit":{"state":"translated","value":"En attente de l’iPhone"}},"hi":{"stringUnit":{"state":"translated","value":"iPhone की प्रतीक्षा में"}},"ar":{"stringUnit":{"state":"translated","value":"بانتظار iPhone"}},"it":{"stringUnit":{"state":"translated","value":"In attesa di iPhone"}},"tr":{"stringUnit":{"state":"translated","value":"iPhone bekleniyor"}},"uk":{"stringUnit":{"state":"translated","value":"Очікування iPhone"}},"id":{"stringUnit":{"state":"translated","value":"Menunggu iPhone"}},"pl":{"stringUnit":{"state":"translated","value":"Oczekiwanie na iPhone"}},"th":{"stringUnit":{"state":"translated","value":"กำลังรอ iPhone"}},"vi":{"stringUnit":{"state":"translated","value":"Đang chờ iPhone"}},"nl":{"stringUnit":{"state":"translated","value":"Wachten op iPhone"}},"fa":{"stringUnit":{"state":"translated","value":"در انتظار iPhone"}},"ru":{"stringUnit":{"state":"translated","value":"Ожидание iPhone"}},"sv":{"stringUnit":{"state":"translated","value":"Väntar på iPhone"}}}},
    "Waiting for iPhone sync": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Waiting for iPhone sync"}},"zh-CN":{"stringUnit":{"state":"translated","value":"正在等待 iPhone 同步"}},"zh-TW":{"stringUnit":{"state":"translated","value":"正在等待 iPhone 同步"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Aguardando a sincronização do iPhone"}},"de":{"stringUnit":{"state":"translated","value":"Warten auf iPhone-Synchronisierung"}},"es":{"stringUnit":{"state":"translated","value":"Esperando la sincronización con el iPhone"}},"ja-JP":{"stringUnit":{"state":"translated","value":"iPhone の同期を待機中"}},"ko":{"stringUnit":{"state":"translated","value":"iPhone 동기화 대기 중"}},"fr":{"stringUnit":{"state":"translated","value":"En attente de la synchronisation avec l’iPhone"}},"hi":{"stringUnit":{"state":"translated","value":"iPhone सिंक की प्रतीक्षा में"}},"ar":{"stringUnit":{"state":"translated","value":"بانتظار مزامنة iPhone"}},"it":{"stringUnit":{"state":"translated","value":"In attesa della sincronizzazione di iPhone"}},"tr":{"stringUnit":{"state":"translated","value":"iPhone eşzamanlaması bekleniyor"}},"uk":{"stringUnit":{"state":"translated","value":"Очікування синхронізації з iPhone"}},"id":{"stringUnit":{"state":"translated","value":"Menunggu sinkronisasi iPhone"}},"pl":{"stringUnit":{"state":"translated","value":"Oczekiwanie na synchronizację z iPhone"}},"th":{"stringUnit":{"state":"translated","value":"กำลังรอการซิงค์กับ iPhone"}},"vi":{"stringUnit":{"state":"translated","value":"Đang chờ đồng bộ với iPhone"}},"nl":{"stringUnit":{"state":"translated","value":"Wachten op synchronisatie met iPhone"}},"fa":{"stringUnit":{"state":"translated","value":"در انتظار همگام‌سازی iPhone"}},"ru":{"stringUnit":{"state":"translated","value":"Ожидание синхронизации с iPhone"}},"sv":{"stringUnit":{"state":"translated","value":"Väntar på iPhone-synkronisering"}}}},
    "Waiting for realtime…": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Waiting for realtime…"}},"zh-CN":{"stringUnit":{"state":"translated","value":"正在等待实时连接…"}},"zh-TW":{"stringUnit":{"state":"translated","value":"正在等待即時連線…"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Aguardando conexão em tempo real…"}},"de":{"stringUnit":{"state":"translated","value":"Warten auf Echtzeitverbindung…"}},"es":{"stringUnit":{"state":"translated","value":"Esperando la conexión en tiempo real…"}},"ja-JP":{"stringUnit":{"state":"translated","value":"リアルタイム接続を待機中…"}},"ko":{"stringUnit":{"state":"translated","value":"실시간 연결 대기 중…"}},"fr":{"stringUnit":{"state":"translated","value":"En attente du temps réel…"}},"hi":{"stringUnit":{"state":"translated","value":"रीयलटाइम की प्रतीक्षा में…"}},"ar":{"stringUnit":{"state":"translated","value":"بانتظار الاتصال في الوقت الفعلي…"}},"it":{"stringUnit":{"state":"translated","value":"In attesa della connessione in tempo reale…"}},"tr":{"stringUnit":{"state":"translated","value":"Gerçek zamanlı bağlantı bekleniyor…"}},"uk":{"stringUnit":{"state":"translated","value":"Очікування з’єднання в реальному часі…"}},"id":{"stringUnit":{"state":"translated","value":"Menunggu waktu nyata…"}},"pl":{"stringUnit":{"state":"translated","value":"Oczekiwanie na połączenie w czasie rzeczywistym…"}},"th":{"stringUnit":{"state":"translated","value":"กำลังรอการเชื่อมต่อแบบเรียลไทม์…"}},"vi":{"stringUnit":{"state":"translated","value":"Đang chờ kết nối thời gian thực…"}},"nl":{"stringUnit":{"state":"translated","value":"Wachten op realtime…"}},"fa":{"stringUnit":{"state":"translated","value":"در انتظار ارتباط بلادرنگ…"}},"ru":{"stringUnit":{"state":"translated","value":"Ожидание соединения в реальном времени…"}},"sv":{"stringUnit":{"state":"translated","value":"Väntar på realtid…"}}}},
    "Waiting for spoken reply…": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Waiting for spoken reply…"}},"zh-CN":{"stringUnit":{"state":"translated","value":"正在等待语音回复…"}},"zh-TW":{"stringUnit":{"state":"translated","value":"正在等待語音回覆…"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Aguardando resposta por voz…"}},"de":{"stringUnit":{"state":"translated","value":"Warten auf gesprochene Antwort…"}},"es":{"stringUnit":{"state":"translated","value":"Esperando respuesta hablada…"}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声での返信を待っています…"}},"ko":{"stringUnit":{"state":"translated","value":"음성 응답을 기다리는 중…"}},"fr":{"stringUnit":{"state":"translated","value":"En attente d’une réponse vocale…"}},"hi":{"stringUnit":{"state":"translated","value":"बोले गए जवाब की प्रतीक्षा है…"}},"ar":{"stringUnit":{"state":"translated","value":"في انتظار الرد الصوتي…"}},"it":{"stringUnit":{"state":"translated","value":"In attesa della risposta vocale…"}},"tr":{"stringUnit":{"state":"translated","value":"Sesli yanıt bekleniyor…"}},"uk":{"stringUnit":{"state":"translated","value":"Очікування голосової відповіді…"}},"id":{"stringUnit":{"state":"translated","value":"Menunggu balasan suara…"}},"pl":{"stringUnit":{"state":"translated","value":"Oczekiwanie na odpowiedź głosową…"}},"th":{"stringUnit":{"state":"translated","value":"กำลังรอคำตอบด้วยเสียง…"}},"vi":{"stringUnit":{"state":"translated","value":"Đang chờ phản hồi bằng giọng nói…"}},"nl":{"stringUnit":{"state":"translated","value":"Wachten op gesproken antwoord…"}},"fa":{"stringUnit":{"state":"translated","value":"در انتظار پاسخ صوتی…"}},"ru":{"stringUnit":{"state":"translated","value":"Ожидание голосового ответа…"}},"sv":{"stringUnit":{"state":"translated","value":"Väntar på talat svar…"}}}},
    "Waiting for your iPhone": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Waiting for your iPhone"}},"zh-CN":{"stringUnit":{"state":"translated","value":"正在等待你的 iPhone"}},"zh-TW":{"stringUnit":{"state":"translated","value":"正在等待你的 iPhone"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Aguardando seu iPhone"}},"de":{"stringUnit":{"state":"translated","value":"Warten auf Ihr iPhone"}},"es":{"stringUnit":{"state":"translated","value":"Esperando tu iPhone"}},"ja-JP":{"stringUnit":{"state":"translated","value":"iPhoneを待っています"}},"ko":{"stringUnit":{"state":"translated","value":"iPhone을 기다리는 중"}},"fr":{"stringUnit":{"state":"translated","value":"En attente de votre iPhone"}},"hi":{"stringUnit":{"state":"translated","value":"आपके iPhone की प्रतीक्षा है"}},"ar":{"stringUnit":{"state":"translated","value":"في انتظار جهاز iPhone الخاص بك"}},"it":{"stringUnit":{"state":"translated","value":"In attesa del tuo iPhone"}},"tr":{"stringUnit":{"state":"translated","value":"iPhone'unuz bekleniyor"}},"uk":{"stringUnit":{"state":"translated","value":"Очікування вашого iPhone"}},"id":{"stringUnit":{"state":"translated","value":"Menunggu iPhone Anda"}},"pl":{"stringUnit":{"state":"translated","value":"Oczekiwanie na Twojego iPhone’a"}},"th":{"stringUnit":{"state":"translated","value":"กำลังรอ iPhone ของคุณ"}},"vi":{"stringUnit":{"state":"translated","value":"Đang chờ iPhone của bạn"}},"nl":{"stringUnit":{"state":"translated","value":"Wachten op je iPhone"}},"fa":{"stringUnit":{"state":"translated","value":"در انتظار iPhone شما"}},"ru":{"stringUnit":{"state":"translated","value":"Ожидание вашего iPhone"}},"sv":{"stringUnit":{"state":"translated","value":"Väntar på din iPhone"}}}},
    "Warning: %@ percent of context used": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Warning: %@ percent of context used"}},"zh-CN":{"stringUnit":{"state":"translated","value":"警告：已使用 %@% 的上下文"}},"zh-TW":{"stringUnit":{"state":"translated","value":"警告: 已使用百分之 %@ 的上下文"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Aviso: %@ por cento do contexto utilizado"}},"de":{"stringUnit":{"state":"translated","value":"Warnung: %@ Prozent des Kontexts verwendet"}},"es":{"stringUnit":{"state":"translated","value":"Advertencia: se ha usado el %@ por ciento del contexto"}},"ja-JP":{"stringUnit":{"state":"translated","value":"警告: コンテキストの%@パーセントを使用中"}},"ko":{"stringUnit":{"state":"translated","value":"경고: 컨텍스트의 %@ 퍼센트 사용됨"}},"fr":{"stringUnit":{"state":"translated","value":"Avertissement: %@ pour cent du contexte utilisé"}},"hi":{"stringUnit":{"state":"translated","value":"चेतावनी: संदर्भ का %@ प्रतिशत उपयोग हो चुका है"}},"ar":{"stringUnit":{"state":"translated","value":"تحذير: تم استخدام %@ بالمئة من السياق"}},"it":{"stringUnit":{"state":"translated","value":"Avviso: utilizzato il %@ percento del contesto"}},"tr":{"stringUnit":{"state":"translated","value":"Uyarı: Bağlamın yüzde %@ kadarı kullanıldı"}},"uk":{"stringUnit":{"state":"translated","value":"Попередження: використано %@ відсотків контексту"}},"id":{"stringUnit":{"state":"translated","value":"Peringatan: %@ persen konteks terpakai"}},"pl":{"stringUnit":{"state":"translated","value":"Ostrzeżenie: wykorzystano %@ procent kontekstu"}},"th":{"stringUnit":{"state":"translated","value":"คำเตือน: ใช้บริบทไปแล้ว %@ เปอร์เซ็นต์"}},"vi":{"stringUnit":{"state":"translated","value":"Cảnh báo: Đã sử dụng %@ phần trăm ngữ cảnh"}},"nl":{"stringUnit":{"state":"translated","value":"Waarschuwing: %@ procent van de context gebruikt"}},"fa":{"stringUnit":{"state":"translated","value":"هشدار: %@ درصد از ظرفیت زمینه استفاده شده است"}},"ru":{"stringUnit":{"state":"translated","value":"Предупреждение: использовано %@ процентов контекста"}},"sv":{"stringUnit":{"state":"translated","value":"Varning: %@ procent av kontexten har använts"}}}},
    "Watch delivery could not be saved. Open Apple Watch settings to review it.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Watch delivery could not be saved. Open Apple Watch settings to review it."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法保存 Apple Watch 消息投递设置。请打开 Apple Watch 设置进行检查。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法儲存手錶傳送設定。 請開啟 Apple Watch 設定以檢查。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível salvar a entrega no Apple Watch. Abra os ajustes do Apple Watch para revisá-la."}},"de":{"stringUnit":{"state":"translated","value":"Die Zustellung an die Watch konnte nicht gespeichert werden. Öffnen Sie die Apple Watch-Einstellungen, um sie zu überprüfen."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo guardar la entrega al Apple Watch. Abre los ajustes del Apple Watch para revisarla."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Apple Watchへの配信を保存できませんでした。 Apple Watchの設定を開いて確認してください。"}},"ko":{"stringUnit":{"state":"translated","value":"Watch 전달 내역을 저장하지 못했습니다. Apple Watch 설정을 열어 확인하세요."}},"fr":{"stringUnit":{"state":"translated","value":"La transmission à la montre n’a pas pu être enregistrée. Ouvrez les réglages de l’Apple Watch pour la vérifier."}},"hi":{"stringUnit":{"state":"translated","value":"Apple Watch पर डिलीवरी सहेजी नहीं जा सकी. इसकी समीक्षा करने के लिए Apple Watch की सेटिंग खोलें."}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر حفظ إعداد التسليم إلى الساعة. افتح إعدادات Apple Watch لمراجعته."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile salvare la consegna su Apple Watch. Apri le impostazioni di Apple Watch per verificarla."}},"tr":{"stringUnit":{"state":"translated","value":"Saate iletim kaydedilemedi. Gözden geçirmek için Apple Watch ayarlarını açın."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося зберегти налаштування доставки на годинник. Відкрийте налаштування Apple Watch, щоб перевірити їх."}},"id":{"stringUnit":{"state":"translated","value":"Pengiriman Watch tidak dapat disimpan. Buka pengaturan Apple Watch untuk meninjaunya."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się zapisać dostarczania na zegarek. Otwórz ustawienia Apple Watch, aby je sprawdzić."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถบันทึกการส่งไปยัง Apple Watch ได้. เปิดการตั้งค่า Apple Watch เพื่อตรวจสอบ."}},"vi":{"stringUnit":{"state":"translated","value":"Không thể lưu việc gửi đến đồng hồ. Mở cài đặt Apple Watch để xem lại."}},"nl":{"stringUnit":{"state":"translated","value":"De bezorging op de Watch kon niet worden opgeslagen. Open de Apple Watch-instellingen om deze te controleren."}},"fa":{"stringUnit":{"state":"translated","value":"تحویل به ساعت ذخیره نشد. برای بررسی آن، تنظیمات Apple Watch را باز کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось сохранить настройки доставки на часы. Откройте настройки Apple Watch для проверки."}},"sv":{"stringUnit":{"state":"translated","value":"Leveransen till klockan kunde inte sparas. Öppna inställningarna för Apple Watch för att granska den."}}}},
    "Watch delivery storage is unavailable. Try again on iPhone.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Watch delivery storage is unavailable. Try again on iPhone."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Apple Watch 消息投递存储不可用。请在 iPhone 上重试。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"手錶傳送儲存空間無法使用。 請在 iPhone 上再試一次。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O armazenamento de entregas no Apple Watch está indisponível. Tente novamente no iPhone."}},"de":{"stringUnit":{"state":"translated","value":"Der Speicher für die Zustellung an die Watch ist nicht verfügbar. Versuchen Sie es erneut auf dem iPhone."}},"es":{"stringUnit":{"state":"translated","value":"El almacenamiento de entregas al Apple Watch no está disponible. Inténtalo de nuevo en el iPhone."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Apple Watchへの配信用ストレージを利用できません。 iPhoneでもう一度お試しください。"}},"ko":{"stringUnit":{"state":"translated","value":"Watch 전달 내역 저장소를 사용할 수 없습니다. iPhone에서 다시 시도하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Le stockage des transmissions à la montre est indisponible. Réessayez sur l’iPhone."}},"hi":{"stringUnit":{"state":"translated","value":"Apple Watch पर डिलीवरी का स्टोरेज उपलब्ध नहीं है. iPhone पर फिर से कोशिश करें."}},"ar":{"stringUnit":{"state":"translated","value":"تخزين التسليم إلى الساعة غير متاح. حاول مجددًا على iPhone."}},"it":{"stringUnit":{"state":"translated","value":"L'archiviazione delle consegne su Apple Watch non è disponibile. Riprova su iPhone."}},"tr":{"stringUnit":{"state":"translated","value":"Saate iletim için depolama kullanılamıyor. iPhone'da tekrar deneyin."}},"uk":{"stringUnit":{"state":"translated","value":"Сховище доставки на годинник недоступне. Спробуйте ще раз на iPhone."}},"id":{"stringUnit":{"state":"translated","value":"Penyimpanan pengiriman Watch tidak tersedia. Coba lagi di iPhone."}},"pl":{"stringUnit":{"state":"translated","value":"Pamięć dostarczania na zegarek jest niedostępna. Spróbuj ponownie na iPhonie."}},"th":{"stringUnit":{"state":"translated","value":"พื้นที่จัดเก็บสำหรับการส่งไปยัง Apple Watch ไม่พร้อมใช้งาน. ลองอีกครั้งบน iPhone."}},"vi":{"stringUnit":{"state":"translated","value":"Bộ nhớ lưu việc gửi đến đồng hồ không khả dụng. Hãy thử lại trên iPhone."}},"nl":{"stringUnit":{"state":"translated","value":"Opslag voor bezorging op de Watch is niet beschikbaar. Probeer het opnieuw op de iPhone."}},"fa":{"stringUnit":{"state":"translated","value":"فضای ذخیره‌سازی تحویل به ساعت در دسترس نیست. دوباره در iPhone تلاش کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Хранилище доставки на часы недоступно. Повторите попытку на iPhone."}},"sv":{"stringUnit":{"state":"translated","value":"Lagring för leveranser till klockan är inte tillgänglig. Försök igen på iPhone."}}}},
    "Watch messages need recovery. Contact support; Reset Onboarding erases all local data.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Watch messages need recovery. Contact support; Reset Onboarding erases all local data."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Apple Watch 消息需要恢复。请联系支持人员；重置初始设置将清除所有本地数据。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"手錶訊息需要復原。 請聯絡支援人員; 重設初始設定會清除所有本機資料。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"As mensagens do Apple Watch precisam ser recuperadas. Entre em contato com o suporte; Redefinir Configuração Inicial apaga todos os dados locais."}},"de":{"stringUnit":{"state":"translated","value":"Watch-Nachrichten müssen wiederhergestellt werden. Wenden Sie sich an den Support; das Zurücksetzen der Ersteinrichtung löscht alle lokalen Daten."}},"es":{"stringUnit":{"state":"translated","value":"Es necesario recuperar los mensajes del Apple Watch. Contacta con soporte; Restablecer configuración inicial borra todos los datos locales."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Apple Watchのメッセージを復旧する必要があります。 サポートにお問い合わせください; オンボーディングをリセットすると、すべてのローカルデータが消去されます。"}},"ko":{"stringUnit":{"state":"translated","value":"Watch 메시지를 복구해야 합니다. 지원팀에 문의하세요; 온보딩 초기화는 모든 로컬 데이터를 삭제합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les messages de la montre doivent être récupérés. Contactez l’assistance; Réinitialiser la configuration initiale efface toutes les données locales."}},"hi":{"stringUnit":{"state":"translated","value":"Apple Watch के संदेशों को पुनर्प्राप्त करना ज़रूरी है. सहायता से संपर्क करें; ऑनबोर्डिंग रीसेट करने से सभी स्थानीय डेटा मिट जाता है."}},"ar":{"stringUnit":{"state":"translated","value":"تحتاج رسائل الساعة إلى الاسترداد. تواصل مع الدعم؛ تؤدي إعادة تعيين الإعداد الأولي إلى مسح جميع البيانات المحلية."}},"it":{"stringUnit":{"state":"translated","value":"I messaggi di Apple Watch devono essere recuperati. Contatta l'assistenza; Reimposta configurazione iniziale cancella tutti i dati locali."}},"tr":{"stringUnit":{"state":"translated","value":"Saat mesajlarının kurtarılması gerekiyor. Destek ekibiyle iletişime geçin; İlk Kurulumu Sıfırla tüm yerel verileri siler."}},"uk":{"stringUnit":{"state":"translated","value":"Повідомлення на годиннику потребують відновлення. Зверніться до служби підтримки; скидання початкового налаштування видаляє всі локальні дані."}},"id":{"stringUnit":{"state":"translated","value":"Pesan Watch perlu dipulihkan. Hubungi dukungan; Atur Ulang Penyiapan Awal menghapus semua data lokal."}},"pl":{"stringUnit":{"state":"translated","value":"Wiadomości na zegarku wymagają odzyskania. Skontaktuj się z pomocą techniczną; zresetowanie konfiguracji początkowej usuwa wszystkie dane lokalne."}},"th":{"stringUnit":{"state":"translated","value":"จำเป็นต้องกู้คืนข้อความบน Apple Watch. ติดต่อฝ่ายสนับสนุน; การรีเซ็ตการตั้งค่าเริ่มต้นจะลบข้อมูลทั้งหมดในเครื่อง."}},"vi":{"stringUnit":{"state":"translated","value":"Tin nhắn trên đồng hồ cần được khôi phục. Liên hệ bộ phận hỗ trợ; Đặt lại thiết lập ban đầu sẽ xóa toàn bộ dữ liệu cục bộ."}},"nl":{"stringUnit":{"state":"translated","value":"Watch-berichten moeten worden hersteld. Neem contact op met de ondersteuning; met Introductie resetten worden alle lokale gegevens gewist."}},"fa":{"stringUnit":{"state":"translated","value":"پیام‌های ساعت نیاز به بازیابی دارند. با پشتیبانی تماس بگیرید؛ بازنشانی راه‌اندازی اولیه، تمام داده‌های محلی را پاک می‌کند."}},"ru":{"stringUnit":{"state":"translated","value":"Сообщения на часах требуют восстановления. Обратитесь в службу поддержки; сброс первоначальной настройки удаляет все локальные данные."}},"sv":{"stringUnit":{"state":"translated","value":"Meddelanden på klockan behöver återställas. Kontakta supporten; Återställ introduktionen raderar alla lokala data."}}}},
    "Watch node online": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Watch node online"}},"zh-CN":{"stringUnit":{"state":"translated","value":"Apple Watch 节点在线"}},"zh-TW":{"stringUnit":{"state":"translated","value":"手錶節點已上線"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Nó do Apple Watch online"}},"de":{"stringUnit":{"state":"translated","value":"Watch-Knoten online"}},"es":{"stringUnit":{"state":"translated","value":"Nodo del Apple Watch en línea"}},"ja-JP":{"stringUnit":{"state":"translated","value":"Apple Watchノードはオンラインです"}},"ko":{"stringUnit":{"state":"translated","value":"Watch 노드 온라인"}},"fr":{"stringUnit":{"state":"translated","value":"Nœud de la montre en ligne"}},"hi":{"stringUnit":{"state":"translated","value":"Apple Watch नोड ऑनलाइन है"}},"ar":{"stringUnit":{"state":"translated","value":"عقدة الساعة متصلة"}},"it":{"stringUnit":{"state":"translated","value":"Nodo Apple Watch online"}},"tr":{"stringUnit":{"state":"translated","value":"Saat düğümü çevrimiçi"}},"uk":{"stringUnit":{"state":"translated","value":"Вузол годинника в мережі"}},"id":{"stringUnit":{"state":"translated","value":"Node Watch online"}},"pl":{"stringUnit":{"state":"translated","value":"Węzeł zegarka jest online"}},"th":{"stringUnit":{"state":"translated","value":"โหนด Apple Watch ออนไลน์"}},"vi":{"stringUnit":{"state":"translated","value":"Nút đồng hồ đang trực tuyến"}},"nl":{"stringUnit":{"state":"translated","value":"Watch-knooppunt online"}},"fa":{"stringUnit":{"state":"translated","value":"گره ساعت آنلاین است"}},"ru":{"stringUnit":{"state":"translated","value":"Узел часов в сети"}},"sv":{"stringUnit":{"state":"translated","value":"Klocknoden är online"}}}},
    "Watch reply was not saved": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Watch reply was not saved"}},"zh-CN":{"stringUnit":{"state":"translated","value":"Apple Watch 回复未保存"}},"zh-TW":{"stringUnit":{"state":"translated","value":"手錶回覆未儲存"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A resposta do Apple Watch não foi salva"}},"de":{"stringUnit":{"state":"translated","value":"Watch-Antwort wurde nicht gespeichert"}},"es":{"stringUnit":{"state":"translated","value":"No se guardó la respuesta del Apple Watch"}},"ja-JP":{"stringUnit":{"state":"translated","value":"Apple Watchからの返信は保存されませんでした"}},"ko":{"stringUnit":{"state":"translated","value":"Watch 응답이 저장되지 않았습니다"}},"fr":{"stringUnit":{"state":"translated","value":"La réponse de la montre n’a pas été enregistrée"}},"hi":{"stringUnit":{"state":"translated","value":"Apple Watch का जवाब सहेजा नहीं गया"}},"ar":{"stringUnit":{"state":"translated","value":"لم يتم حفظ رد الساعة"}},"it":{"stringUnit":{"state":"translated","value":"La risposta di Apple Watch non è stata salvata"}},"tr":{"stringUnit":{"state":"translated","value":"Saat yanıtı kaydedilmedi"}},"uk":{"stringUnit":{"state":"translated","value":"Відповідь із годинника не збережено"}},"id":{"stringUnit":{"state":"translated","value":"Balasan Watch tidak tersimpan"}},"pl":{"stringUnit":{"state":"translated","value":"Odpowiedź z zegarka nie została zapisana"}},"th":{"stringUnit":{"state":"translated","value":"ไม่ได้บันทึกคำตอบจาก Apple Watch"}},"vi":{"stringUnit":{"state":"translated","value":"Phản hồi từ đồng hồ chưa được lưu"}},"nl":{"stringUnit":{"state":"translated","value":"Watch-antwoord is niet opgeslagen"}},"fa":{"stringUnit":{"state":"translated","value":"پاسخ ساعت ذخیره نشد"}},"ru":{"stringUnit":{"state":"translated","value":"Ответ с часов не сохранён"}},"sv":{"stringUnit":{"state":"translated","value":"Svaret från klockan sparades inte"}}}},
    "Watch reply was not saved. Open iPhone and try again.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Watch reply was not saved. Open iPhone and try again."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Watch 回复未保存。 请打开 iPhone 并重试。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"手錶上的回覆未儲存。 請開啟 iPhone 並重試。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A resposta do Watch não foi salva. Abra o iPhone e tente novamente."}},"de":{"stringUnit":{"state":"translated","value":"Die Antwort auf der Watch wurde nicht gespeichert. Öffne die App auf dem iPhone und versuche es erneut."}},"es":{"stringUnit":{"state":"translated","value":"La respuesta del Watch no se guardó. Abre la app en el iPhone e inténtalo de nuevo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Watchからの返信が保存されませんでした。 iPhoneを開いてもう一度お試しください。"}},"ko":{"stringUnit":{"state":"translated","value":"Watch 답장이 저장되지 않았습니다. iPhone을 열고 다시 시도하세요."}},"fr":{"stringUnit":{"state":"translated","value":"La réponse depuis la Watch n’a pas été enregistrée. Ouvrez l’app sur l’iPhone et réessayez."}},"hi":{"stringUnit":{"state":"translated","value":"Watch का जवाब सहेजा नहीं गया. iPhone खोलें और फिर से कोशिश करें."}},"ar":{"stringUnit":{"state":"translated","value":"لم يتم حفظ رد الساعة. افتح iPhone وحاول مرة أخرى."}},"it":{"stringUnit":{"state":"translated","value":"La risposta da Watch non è stata salvata. Apri l'app su iPhone e riprova."}},"tr":{"stringUnit":{"state":"translated","value":"Saatten gönderilen yanıt kaydedilmedi. iPhone'u açıp tekrar deneyin."}},"uk":{"stringUnit":{"state":"translated","value":"Відповідь із годинника не збережено. Відкрийте застосунок на iPhone і спробуйте ще раз."}},"id":{"stringUnit":{"state":"translated","value":"Balasan dari Watch tidak tersimpan. Buka iPhone dan coba lagi."}},"pl":{"stringUnit":{"state":"translated","value":"Odpowiedź z zegarka nie została zapisana. Otwórz aplikację na iPhone i spróbuj ponownie."}},"th":{"stringUnit":{"state":"translated","value":"ไม่ได้บันทึกการตอบกลับจาก Watch เปิด iPhone แล้วลองอีกครั้ง."}},"vi":{"stringUnit":{"state":"translated","value":"Câu trả lời trên Watch chưa được lưu. Mở iPhone và thử lại."}},"nl":{"stringUnit":{"state":"translated","value":"Het antwoord op de Watch is niet opgeslagen. Open de app op je iPhone en probeer het opnieuw."}},"fa":{"stringUnit":{"state":"translated","value":"پاسخ ساعت ذخیره نشد. iPhone را باز کنید و دوباره تلاش کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Ответ с часов не сохранён. Откройте приложение на iPhone и попробуйте снова."}},"sv":{"stringUnit":{"state":"translated","value":"Svaret från klockan sparades inte. Öppna iPhone och försök igen."}}}},
