    "Chat changed on iPhone. Your message was not sent.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Chat changed on iPhone. Your message was not sent."}},"zh-CN":{"stringUnit":{"state":"translated","value":"iPhone 上的聊天已更改。 您的消息未发送。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"iPhone 上的聊天已變更。 您的訊息未送出。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A conversa foi alterada no iPhone. Sua mensagem não foi enviada."}},"de":{"stringUnit":{"state":"translated","value":"Der Chat wurde auf dem iPhone gewechselt. Ihre Nachricht wurde nicht gesendet."}},"es":{"stringUnit":{"state":"translated","value":"El chat cambió en el iPhone. Tu mensaje no se envió."}},"ja-JP":{"stringUnit":{"state":"translated","value":"iPhone でチャットが変更されました。メッセージは送信されませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"iPhone에서 채팅이 변경되었습니다. 메시지가 전송되지 않았습니다."}},"fr":{"stringUnit":{"state":"translated","value":"La discussion a changé sur l’iPhone. Votre message n’a pas été envoyé."}},"hi":{"stringUnit":{"state":"translated","value":"iPhone पर चैट बदल गई. आपका संदेश नहीं भेजा गया."}},"ar":{"stringUnit":{"state":"translated","value":"تغيّرت الدردشة على iPhone. لم تُرسل رسالتك."}},"it":{"stringUnit":{"state":"translated","value":"La chat è cambiata su iPhone. Il tuo messaggio non è stato inviato."}},"tr":{"stringUnit":{"state":"translated","value":"iPhone üzerinde sohbet değişti. Mesajınız gönderilmedi."}},"uk":{"stringUnit":{"state":"translated","value":"Чат змінено на iPhone. Ваше повідомлення не надіслано."}},"id":{"stringUnit":{"state":"translated","value":"Obrolan berubah di iPhone. Pesan Anda tidak terkirim."}},"pl":{"stringUnit":{"state":"translated","value":"Czat zmienił się na iPhonie. Twoja wiadomość nie została wysłana."}},"th":{"stringUnit":{"state":"translated","value":"แชทเปลี่ยนไปบน iPhone. ไม่ได้ส่งข้อความของคุณ."}},"vi":{"stringUnit":{"state":"translated","value":"Cuộc trò chuyện đã thay đổi trên iPhone. Tin nhắn của bạn chưa được gửi."}},