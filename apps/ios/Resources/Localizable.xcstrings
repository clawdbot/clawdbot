    "Prepare a detailed project review.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Prepare a detailed project review."}},"zh-CN":{"stringUnit":{"state":"translated","value":"准备一份详细的项目评审报告。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"準備一份詳細的專案審查報告。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Prepare uma revisão detalhada do projeto."}},"de":{"stringUnit":{"state":"translated","value":"Erstelle eine detaillierte Projektbewertung."}},"es":{"stringUnit":{"state":"translated","value":"Prepara una revisión detallada del proyecto."}},"ja-JP":{"stringUnit":{"state":"translated","value":"プロジェクトの詳細なレビューを作成してください。"}},"ko":{"stringUnit":{"state":"translated","value":"상세한 프로젝트 검토를 준비하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Préparez une revue détaillée du projet."}},"hi":{"stringUnit":{"state":"translated","value":"परियोजना की विस्तृत समीक्षा तैयार करें."}},"ar":{"stringUnit":{"state":"translated","value":"أعدّ مراجعة تفصيلية للمشروع."}},"it":{"stringUnit":{"state":"translated","value":"Prepara una revisione dettagliata del progetto."}},"tr":{"stringUnit":{"state":"translated","value":"Ayrıntılı bir proje incelemesi hazırlayın."}},"uk":{"stringUnit":{"state":"translated","value":"Підготуйте докладний огляд проєкту."}},"id":{"stringUnit":{"state":"translated","value":"Siapkan tinjauan proyek yang terperinci."}},"pl":{"stringUnit":{"state":"translated","value":"Przygotuj szczegółowy przegląd projektu."}},"th":{"stringUnit":{"state":"translated","value":"จัดทำรายงานทบทวนโครงการอย่างละเอียด."}},"vi":{"stringUnit":{"state":"translated","value":"Chuẩn bị bản đánh giá chi tiết về dự án."}},"nl":{"stringUnit":{"state":"translated","value":"Stel een gedetailleerde projectbeoordeling op."}},"fa":{"stringUnit":{"state":"translated","value":"یک بررسی تفصیلی از پروژه تهیه کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Подготовьте подробный обзор проекта."}},"sv":{"stringUnit":{"state":"translated","value":"Förbered en detaljerad projektgranskning."}}}},
    "Preparing audio, tap to cancel": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Preparing audio, tap to cancel"}},"zh-CN":{"stringUnit":{"state":"translated","value":"正在准备音频, 轻点以取消"}},"zh-TW":{"stringUnit":{"state":"translated","value":"正在準備音訊, 點一下即可取消"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Preparando áudio, toque para cancelar"}},"de":{"stringUnit":{"state":"translated","value":"Audio wird vorbereitet, zum Abbrechen tippen"}},"es":{"stringUnit":{"state":"translated","value":"Preparando audio, toca para cancelar"}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声を準備中, タップしてキャンセル"}},"ko":{"stringUnit":{"state":"translated","value":"오디오 준비 중, 탭하여 취소"}},"fr":{"stringUnit":{"state":"translated","value":"Préparation de l’audio, touchez pour annuler"}},"hi":{"stringUnit":{"state":"translated","value":"ऑडियो तैयार हो रहा है, रद्द करने के लिए टैप करें"}},"ar":{"stringUnit":{"state":"translated","value":"جارٍ تحضير الصوت، انقر للإلغاء"}},"it":{"stringUnit":{"state":"translated","value":"Preparazione dell'audio, tocca per annullare"}},"tr":{"stringUnit":{"state":"translated","value":"Ses hazırlanıyor, iptal etmek için dokunun"}},"uk":{"stringUnit":{"state":"translated","value":"Підготовка аудіо, торкніться, щоб скасувати"}},"id":{"stringUnit":{"state":"translated","value":"Menyiapkan audio, ketuk untuk membatalkan"}},"pl":{"stringUnit":{"state":"translated","value":"Przygotowywanie dźwięku, stuknij, aby anulować"}},"th":{"stringUnit":{"state":"translated","value":"กำลังเตรียมเสียง, แตะเพื่อยกเลิก"}},"vi":{"stringUnit":{"state":"translated","value":"Đang chuẩn bị âm thanh, chạm để hủy"}},"nl":{"stringUnit":{"state":"translated","value":"Audio wordt voorbereid, tik om te annuleren"}},"fa":{"stringUnit":{"state":"translated","value":"در حال آماده‌سازی صدا، برای لغو ضربه بزنید"}},"ru":{"stringUnit":{"state":"translated","value":"Подготовка аудио, нажмите для отмены"}},"sv":{"stringUnit":{"state":"translated","value":"Förbereder ljud, tryck för att avbryta"}}}},
