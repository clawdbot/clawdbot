    "Gateway credential handoff persistence failed.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Gateway credential handoff persistence failed."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Gateway 凭据交接的持久化失败。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 憑證交接資料持久化失敗。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Falha ao persistir a transferência de credenciais do Gateway."}},"de":{"stringUnit":{"state":"translated","value":"Das dauerhafte Speichern der Gateway-Zugangsdatenübergabe ist fehlgeschlagen."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo guardar la transferencia de credenciales de Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gateway の認証情報の引き継ぎデータを永続化できませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway 자격 증명 전달 정보 저장에 실패했습니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’enregistrement persistant des identifiants transférés de Gateway a échoué."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway क्रेडेंशियल हस्तांतरण को स्थायी रूप से सहेजना विफल रहा।"}},"ar":{"stringUnit":{"state":"translated","value":"فشل الحفظ الدائم لبيانات اعتماد Gateway المنقولة."}},"it":{"stringUnit":{"state":"translated","value":"Salvataggio persistente delle credenziali trasferite di Gateway non riuscito."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway kimlik bilgisi aktarımı kalıcı olarak kaydedilemedi."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося зберегти передані облікові дані Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Penyimpanan permanen kredensial Gateway yang diserahkan gagal."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się trwale zapisać przekazanych danych uwierzytelniających Gateway."}},"th":{"stringUnit":{"state":"translated","value":"การบันทึกข้อมูลรับรองที่ส่งต่อของ Gateway แบบถาวรล้มเหลว."}},"vi":{"stringUnit":{"state":"translated","value":"Không thể lưu thông tin x