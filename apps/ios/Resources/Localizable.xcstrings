    "Voice received too many network candidates.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Voice received too many network candidates."}},"zh-CN":{"stringUnit":{"state":"translated","value":"语音收到了过多的网络候选项。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語音收到過多網路候選項目。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O recurso de voz recebeu candidatos de rede em excesso."}},"de":{"stringUnit":{"state":"translated","value":"Die Sprachfunktion hat zu viele Netzwerkkandidaten empfangen."}},"es":{"stringUnit":{"state":"translated","value":"La función de voz recibió demasiados candidatos de red."}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声で受信したネットワーク候補が多すぎます。"}},"ko":{"stringUnit":{"state":"translated","value":"음성 연결에서 너무 많은 네트워크 후보를 수신했습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le mode vocal a reçu trop de candidats réseau."}},"hi":{"stringUnit":{"state":"translated","value":"वॉइस को बहुत अधिक संभावित नेटवर्क पते मिले।"}},"ar":{"stringUnit":{"state":"translated","value":"تلقى الاتصال الصوتي عددًا زائدًا من خيارات الاتصال بالشبكة."}},"it":{"stringUnit":{"state":"translated","value":"La modalità vocale ha ricevuto troppi candidati di rete."}},"tr":{"stringUnit":{"state":"translated","value":"Ses için çok fazla ağ adayı alındı."}},"uk":{"stringUnit":{"state":"translated","value":"Голосовий зв’язок отримав забагато кандидатів для мережевого з’єднання."}},"id":{"stringUnit":{"state":"translated","value":"Suara menerima terlalu banyak kandidat jaringan."}},"pl":{"stringUnit":{"state":"translated","value":"Połączenie głosowe otrzymało zbyt wiele kandydujących adresów sieciowych."}},"th":{"stringUnit":{"state":"translated","value":"ระบบเสียงได้รับตัวเลือกการเชื่อมต่อเครือข่ายมากเกินไป"}},"vi":{"stringUnit":{"state":"translated","value":"Tính năng thoại đã nhận được quá nhiều ứng viên kết nối mạng."}},"nl":{"stringUnit":{"state":"translated","value":"Er zijn te veel netwerkkandidaten ontvangen voor spraak."}}