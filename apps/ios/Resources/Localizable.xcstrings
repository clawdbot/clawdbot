    "Scan a setup QR code, paste a setup code, or choose a discovered gateway.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Scan a setup QR code, paste a setup code, or choose a discovered gateway."}},"zh-CN":{"stringUnit":{"state":"translated","value":"扫描设置二维码, 粘贴设置码, 或选择已发现的 Gateway."}},"zh-TW":{"stringUnit":{"state":"translated","value":"掃描設定 QR 碼、貼上設定碼，或選擇已探索到的 Gateway."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escaneie um código QR de configuração, cole um código de configuração ou escolha um Gateway encontrado."}},"de":{"stringUnit":{"state":"translated","value":"Scannen Sie einen QR-Code zur Einrichtung, fügen Sie einen Einrichtungscode ein oder wählen Sie ein gefundenes Gateway aus."}},"es":{"stringUnit":{"state":"translated","value":"Escanea un código QR de configuración, pega un código de configuración o elige un Gateway detectado."}},"ja-JP":{"stringUnit":{"state":"translated","value":"セットアップ用の QR コードをスキャンするか、セットアップコードを貼り付けるか、検出された Gateway を選択してください。"}},"ko":{"stringUnit":{"state":"translated","value":"설정 QR 코드를 스캔하거나, 설정 코드를 붙여넣거나, 검색된 Gateway를 선택하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Scannez un code QR de configuration, collez un code de configuration ou choisissez un Gateway détecté."}},"hi":{"stringUnit":{"state":"translated","value":"सेटअप QR कोड स्कैन करें, सेटअप कोड पेस्ट करें, या खोजे गए Gateway को चुनें."}},"ar":{"stringUnit":{"state":"translated","value":"امسح رمز QR للإعداد، أو الصق رمز إعداد، أو اختر بوابة مكتشفة."}},"it":{"stringUnit":{"state":"translated","value":"Scansiona un codice QR di configurazione, incolla un codice di configurazione o scegli un Gateway rilevato."}},"tr":{"stringUnit":{"state":"translated","value":"Bir kurulum QR kodunu tarayın, kurulum kodunu yapıştırın veya keşfedilen bir Gateway seçin."}},"uk":{"stringUnit":{"state":"translated","value":"Скануйте QR-код налаштування, вставте код налаштування або виберіть виявлений Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Pindai kode QR penyiapan, tempel kode penyiapan, atau pilih Gateway yang ditemukan."}},"pl":{"stringUnit":{"state":"translated","value":"Zeskanuj kod QR konfiguracji, wklej kod konfiguracji lub wybierz wykrytą bramę."}},"th":{"stringUnit":{"state":"translated","value":"สแกนรหัส QR สำหรับตั้งค่า วางรหัสตั้งค่า หรือเลือก Gateway ที่ค้นพบ."}},"vi":{"stringUnit":{"state":"translated","value":"Quét mã QR thiết lập, dán mã thiết lập hoặc chọn một Gateway đã được phát hiện."}},"nl":{"stringUnit":{"state":"translated","value":"Scan een QR-code voor configuratie, plak een configuratiecode of kies een gevonden Gateway."}},"fa":{"stringUnit":{"state":"translated","value":"یک کد QR راه‌اندازی را اسکن کنید، یک کد راه‌اندازی را جای‌گذاری کنید، یا یک Gateway شناسایی‌شده را انتخاب کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Отсканируйте QR-код настройки, вставьте код настройки или выберите обнаруженный Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Skanna en QR-kod för konfiguration, klistra in en konfigurationskod eller välj en upptäckt Gateway."}}}},
