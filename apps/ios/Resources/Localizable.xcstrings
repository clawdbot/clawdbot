    "Gateway connection lost during startup.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Gateway connection lost during startup."}},"zh-CN":{"stringUnit":{"state":"translated","value":"启动期间与 Gateway 的连接已断开。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"啟動期間與 Gateway 的連線中斷。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Conexão com o Gateway perdida durante a inicialização."}},"de":{"stringUnit":{"state":"translated","value":"Verbindung zum Gateway während des Starts verloren."}},"es":{"stringUnit":{"state":"translated","value":"Se perdió la conexión con el Gateway durante el inicio."}},"ja-JP":{"stringUnit":{"state":"translated","value":"起動中にGatewayとの接続が切れました。"}},"ko":{"stringUnit":{"state":"translated","value":"시작 중 Gateway 연결이 끊어졌습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Connexion au Gateway perdue au démarrage."}},"hi":{"stringUnit":{"state":"translated","value":"शुरू होते समय Gateway से कनेक्शन टूट गया।"}},"ar":{"stringUnit":{"state":"translated","value":"انقطع الاتصال بـ Gateway أثناء بدء التشغيل."}},"it":{"stringUnit":{"state":"translated","value":"Connessione al Gateway persa durante l'avvio."}},"tr":{"stringUnit":{"state":"translated","value":"Başlatma sırasında Gateway bağlantısı kesildi."}},"uk":{"stringUnit":{"state":"translated","value":"З’єднання з Gateway втрачено під час запуску."}},"id":{"stringUnit":{"state":"translated","value":"Koneksi Gateway terputus saat memulai."}},"pl":{"stringUnit":{"state":"translated","value":"Utracono połączenie z Gateway podczas uruchamiania."}},"th":{"stringUnit":{"state":"translated","value":"การเชื่อมต่อ Gateway หลุดระหว่างเริ่มต้นระบบ"}},"vi":{"stringUnit":{"state":"translated","value":"Mất kết nối với Gateway trong khi khởi động."}},"nl":{"stringUnit":{"state":"translated","value":"Verbinding met Gateway verbroken tijdens het opstarten."}},"fa":{"stringUnit":{"state":"translated","value":"اتصال به Gateway هنگام راه‌اندازی قطع شد."}},"ru":{"stringUnit":{"state":"translated","value":"Соединение с Gateway потеряно при запуске."}},"sv":{"stringUnit":{"state":"translated","value":"Anslutningen till Gateway förlorades under uppstarten."}}}},
    "Gateway connection lost.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Gateway connection lost."}},"zh-CN":{"stringUnit":{"state":"translated","value":"与 Gateway 的连接已断开。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"與 Gateway 的連線中斷。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Conexão com o Gateway perdida."}},"de":{"stringUnit":{"state":"translated","value":"Verbindung zum Gateway verloren."}},"es":{"stringUnit":{"state":"translated","value":"Se perdió la conexión con el Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayとの接続が切れました。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway 연결이 끊어졌습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Connexion au Gateway perdue."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway से कनेक्शन टूट गया।"}},"ar":{"stringUnit":{"state":"translated","value":"انقطع الاتصال بـ Gateway."}},"it":{"stringUnit":{"state":"translated","value":"Connessione al Gateway persa."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway bağlantısı kesildi."}},"uk":{"stringUnit":{"state":"translated","value":"З’єднання з Gateway втрачено."}},"id":{"stringUnit":{"state":"translated","value":"Koneksi Gateway terputus."}},"pl":{"stringUnit":{"state":"translated","value":"Utracono połączenie z Gateway."}},"th":{"stringUnit":{"state":"translated","value":"การเชื่อมต่อ Gateway หลุด"}},"vi":{"stringUnit":{"state":"translated","value":"Mất kết nối với Gateway."}},"nl":{"stringUnit":{"state":"translated","value":"Verbinding met Gateway verbroken."}},"fa":{"stringUnit":{"state":"translated","value":"اتصال به Gateway قطع شد."}},"ru":{"stringUnit":{"state":"translated","value":"Соединение с Gateway потеряно."}},"sv":{"stringUnit":{"state":"translated","value":"Anslutningen till Gateway förlorades."}}}},
    "Gateway connection was replaced before realtime startup finished": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Gateway connection was replaced before realtime startup finished"}},"zh-CN":{"stringUnit":{"state":"translated","value":"Gateway 连接在实时功能启动完成前已被替换"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 連線在即時功能啟動完成前已被替換"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A conexão com o Gateway foi substituída antes da conclusão da inicialização em tempo real"}},"de":{"stringUnit":{"state":"translated","value":"Die Gateway-Verbindung wurde ersetzt, bevor der Echtzeitstart abgeschlossen war"}},"es":{"stringUnit":{"state":"translated","value":"La conexión con Gateway se reemplazó antes de que finalizara el inicio en tiempo real"}},"ja-JP":{"stringUnit":{"state":"translated","value":"リアルタイム起動が完了する前に Gateway 接続が置き換えられました"}},"ko":{"stringUnit":{"state":"translated","value":"실시간 기능 시작이 완료되기 전에 Gateway 연결이 교체되었습니다"}},"fr":{"stringUnit":{"state":"translated","value":"La connexion à Gateway a été remplacée avant la fin du démarrage en temps réel"}},"hi":{"stringUnit":{"state":"translated","value":"रीयलटाइम स्टार्टअप पूरा होने से पहले Gateway कनेक्शन बदल दिया गया"}},"ar":{"stringUnit":{"state":"translated","value":"تم استبدال اتصال Gateway قبل اكتمال بدء التشغيل في الوقت الفعلي"}},"it":{"stringUnit":{"state":"translated","value":"La connessione a Gateway è stata sostituita prima del completamento dell'avvio in tempo reale"}},"tr":{"stringUnit":{"state":"translated","value":"Gerçek zamanlı başlatma tamamlanmadan önce Gateway bağlantısı değiştirildi"}},"uk":{"stringUnit":{"state":"translated","value":"З’єднання з Gateway було замінено до завершення запуску режиму реального часу"}},"id":{"stringUnit":{"state":"translated","value":"Koneksi Gateway diganti sebelum proses mulai waktu nyata selesai"}},"pl":{"stringUnit":{"state":"translated","value":"Połączenie z Gateway zostało zastąpione przed zakończeniem uruchamiania trybu czasu r