    "Setup code applied. Connecting...": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Setup code applied. Connecting..."}},"zh-CN":{"stringUnit":{"state":"translated","value":"设置代码已应用。 正在连接..."}},"zh-TW":{"stringUnit":{"state":"translated","value":"已套用設定碼。 正在連線..."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Código de configuração aplicado. Conectando..."}},"de":{"stringUnit":{"state":"translated","value":"Einrichtungscode übernommen. Verbindung wird hergestellt..."}},"es":{"stringUnit":{"state":"translated","value":"Código de configuración aplicado. Conectando..."}},"ja-JP":{"stringUnit":{"state":"translated","value":"セットアップコードを適用しました。 接続中..."}},"ko":{"stringUnit":{"state":"translated","value":"설정 코드가 적용되었습니다. 연결 중..."}},"fr":{"stringUnit":{"state":"translated","value":"Code de configuration appliqué. Connexion en cours..."}},"hi":{"stringUnit":{"state":"translated","value":"सेटअप कोड लागू किया गया. कनेक्ट हो रहा है..."}},"ar":{"stringUnit":{"state":"translated","value":"تم تطبيق رمز الإعداد. جارٍ الاتصال..."}},"it":{"stringUnit":{"state":"translated","value":"Codice di configurazione applicato. Connessione in corso..."}},"tr":{"stringUnit":{"state":"translated","value":"Kurulum kodu uygulandı. Bağlanılıyor..."}},"uk":{"stringUnit":{"state":"translated","value":"Код налаштування застосовано. Підключення..."}},"id":{"stringUnit":{"state":"translated","value":"Kode penyiapan diterapkan. Menghubungkan..."}},"pl":{"stringUnit":{"state":"translated","value":"Zastosowano kod konfiguracji. Łączenie..."}},"th":{"stringUnit":{"state":"translated","value":"ใช้รหัสตั้งค่าแล้ว. กำลังเชื่อมต่อ..."}},"vi":{"stringUnit":{"state":"translated","value":"Đã áp dụng mã thiết lập. Đang kết nối..."}},"nl":{"stringUnit":{"state":"translated","value":"Configuratiecode toegepast. Verbinding maken..."}},"fa":{"stringUnit":{"state":"translated","value":"کد راه‌اندازی اعمال شد. در حال اتصال..."}},"ru":{"stringUnit":{"state":"translated","value":"Код настройки применён. Подключение..."}},"sv":{"stringUnit":{"state":"translated","value":"Konfigurationskoden har tillämpats. Ansluter..."}}}},
    "Setup code not recognized or uses an insecure ws:// gateway URL.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Setup code not recognized or uses an insecure ws:// gateway URL."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法识别设置码, 或设置码使用了不安全的 ws:// 网关 URL."}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法辨識設定碼，或設定碼使用了不安全的 ws:// 閘道 URL。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Código de configuração não reconhecido ou que usa uma URL ws:// insegura para o gateway."}},"de":{"stringUnit":{"state":"translated","value":"Einrichtungscode nicht erkannt oder verwendet eine unsichere ws://-Gateway-URL."}},"es":{"stringUnit":{"state":"translated","value":"El código de configuración no se reconoce o utiliza una URL de Gateway ws:// no segura."}},"ja-JP":{"stringUnit":{"state":"translated","value":"セットアップコードが認識されないか、安全でない ws:// ゲートウェイ URL が使用されています。"}},"ko":{"stringUnit":{"state":"translated","value":"설정 코드를 인식할 수 없거나 안전하지 않은 ws:// Gateway URL을 사용합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Code de configuration non reconnu ou utilisant une URL de passerelle ws:// non sécurisée."}},"hi":{"stringUnit":{"state":"translated","value":"सेटअप कोड पहचाना नहीं गया या यह असुरक्षित ws:// गेटवे URL का उपयोग करता है."}},"ar":{"stringUnit":{"state":"translated","value":"رمز الإعداد غير معروف أو يستخدم عنوان URL غير آمن لـ Gateway يبدأ بـ ws://."}},"it":{"stringUnit":{"state":"translated","value":"Codice di configurazione non riconosciuto o contenente un URL del gateway ws:// non sicuro."}},"tr":{"stringUnit":{"state":"translated","value":"Kurulum kodu tanınmıyor veya güvenli olmayan bir ws:// Gateway URL'si kullanıyor."}},"uk":{"stringUnit":{"state":"translated","value":"Код налаштування не розпізнано або він використовує незахищену URL-адресу Gateway із ws://."}},"id":{"stringUnit":{"state":"translated","value":"Kode penyiapan tidak dikenali atau menggunakan URL gateway ws:// yang tidak aman."}},"pl":{"stringUnit":{"state":"translated","value":"Kod konfiguracji jest nierozpoznany lub używa niezabezpieczonego adresu URL ws:// bramy."}},"th":{"stringUnit":{"state":"translated","value":"ไม่รู้จักรหัสตั้งค่านี้ หรือรหัสใช้ URL ของ Gateway แบบ ws:// ที่ไม่ปลอดภัย"}},"vi":{"stringUnit":{"state":"translated","value":"Không nhận dạng được mã thiết lập hoặc mã này sử dụng URL Gateway ws:// không an toàn."}},"nl":{"stringUnit":{"state":"translated","value":"Configuratiecode niet herkend of gebruikt een onveilige ws://-gateway-URL."}},"fa":{"stringUnit":{"state":"translated","value":"کد راه‌اندازی شناسایی نشد یا از نشانی ناامن ws:// برای Gateway استفاده می‌کند."}},"ru":{"stringUnit":{"state":"translated","value":"Код настройки не распознан или использует небезопасный URL Gateway с протоколом ws://."}},"sv":{"stringUnit":{"state":"translated","value":"Konfigurationskoden känns inte igen eller använder en osäker ws://-URL för gateway."}}}},
    "Setup link loaded for %@:%@ (%@). Tap Connect to apply.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Setup link loaded for %@:%@ (%@). Tap Connect to apply."}},"zh-CN":{"stringUnit":{"state":"translated","value":"已加载 %@:%@ (%@) 的设置链接。 轻点连接以应用。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已載入 %@:%@ (%@) 的設定連結。點一下「連線」以套用。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Link de configuração carregado para %@:%@ (%@). Toque em Conectar para aplicar."}},"de":{"stringUnit":{"state":"translated","value":"Einrichtungslink für %@:%@ (%@) geladen. Tippe zum Anwenden auf Verbinden."}},"es":{"stringUnit":{"state":"translated","value":"Enlace de configuración cargado para %@:%@ (%@). Toca Conectar para aplicar."}},"ja-JP":{"stringUnit":{"state":"translated","value":"%@:%@ (%@) のセットアップリンクを読み込みました。 「接続」をタップして適用してください。"}},"ko":{"stringUnit":{"state":"translated","value":"%@:%@ (%@)의 설정 링크를 불러왔습니다. 적용하려면 연결을 탭하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Lien de configuration chargé pour %@:%@ (%@). Appuyez sur Se connecter pour appliquer."}},"hi":{"stringUnit":{"state":"translated","value":"%@:%@ (%@) के लिए सेटअप लिंक लोड किया गया. लागू करने के लिए कनेक्ट करें पर टैप करें."}},"ar":{"stringUnit":{"state":"translated","value":"تم تحميل رابط الإعداد لـ %@:%@ (%@). اضغط على اتصال للتطبيق."}},"it":{"stringUnit":{"state":"translated","value":"Link di configurazione caricato per %@:%@ (%@). Tocca Connetti per applicare."}},"tr":{"stringUnit":{"state":"translated","value":"%@:%@ (%@) için kurulum bağlantısı yüklendi. Uygulamak için Bağlan'a dokunun."}},"uk":{"stringUnit":{"state":"translated","value":"Посилання для налаштування завантажено для %@:%@ (%@). Натисніть «Підключити», щоб застосувати."}},"id":{"stringUnit":{"state":"translated","value":"Tautan penyiapan dimuat untuk %@:%@ (%@). Ketuk Hubungkan untuk menerapkan."}},"pl":{"stringUnit":{"state":"translated","value":"Wczytano link konfiguracji dla %@:%@ (%@). Stuknij Połącz, aby zastosować."}},"th":{"stringUnit":{"state":"translated","value":"โหลดลิงก์ตั้งค่าสำหรับ %@:%@ (%@) แล้ว แตะเชื่อมต่อเพื่อนำไปใช้"}},"vi":{"stringUnit":{"state":"translated","value":"Đã tải liên kết thiết lập cho %@:%@ (%@). Nhấn Kết nối để áp dụng."}},"nl":{"stringUnit":{"state":"translated","value":"Configuratielink geladen voor %@:%@ (%@). Tik op Verbinden om toe te passen."}},"fa":{"stringUnit":{"state":"translated","value":"پیوند راه‌اندازی برای %@:%@ (%@) بارگیری شد. برای اعمال، روی اتصال بزنید."}},"ru":{"stringUnit":{"state":"translated","value":"Ссылка настройки загружена для %@:%@ (%@). Нажмите «Подключиться», чтобы применить."}},"sv":{"stringUnit":{"state":"translated","value":"Konfigurationslänk inläst för %@:%@ (%@). Tryck på Anslut för att tillämpa."}}}},
    "Setup queued for the watch. Open OpenClaw before the code expires.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Setup queued for the watch. Open OpenClaw before the code expires."}},"zh-CN":{"stringUnit":{"state":"translated","value":"设置已加入手表的队列。 请在设置码过期前打开 OpenClaw."}},"zh-TW":{"stringUnit":{"state":"translated","value":"設定已排入手錶的佇列。請在設定碼過期前開啟 OpenClaw。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Configuração na fila para o relógio. Abra o OpenClaw antes que o código expire."}},"de":{"stringUnit":{"state":"translated","value":"Einrichtung für die Uhr vorgemerkt. Öffne OpenClaw, bevor der Code abläuft."}},"es":{"stringUnit":{"state":"translated","value":"Configuración en cola para el reloj. Abre OpenClaw antes de que caduque el código."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ウォッチのセットアップが待機中です。 コードの有効期限が切れる前に OpenClaw を開いてください。"}},"ko":{"stringUnit":{"state":"translated","value":"워치 설정이 대기 중입니다. 코드가 만료되기 전에 OpenClaw를 여세요."}},"fr":{"stringUnit":{"state":"translated","value":"Configuration en attente pour la montre. Ouvrez OpenClaw avant l’expiration du code."}},"hi":{"stringUnit":{"state":"translated","value":"घड़ी के लिए सेटअप कतार में है. कोड की समय-सीमा समाप्त होने से पहले OpenClaw खोलें."}},"ar":{"stringUnit":{"state":"translated","value":"الإعداد في قائمة الانتظار للساعة. افتح OpenClaw قبل انتهاء صلاحية الرمز."}},"it":{"stringUnit":{"state":"translated","value":"Configurazione in coda per l'orologio. Apri OpenClaw prima che il codice scada."}},"tr":{"stringUnit":{"state":"translated","value":"Kurulum saat için sıraya alındı. Kodun süresi dolmadan OpenClaw'u açın."}},"uk":{"stringUnit":{"state":"translated","value":"Налаштування додано до черги для годинника. Відкрийте OpenClaw до завершення терміну дії коду."}},"id":{"stringUnit":{"state":"translated","value":"Penyiapan diantrekan untuk jam tangan. Buka OpenClaw sebelum kode kedaluwarsa."}},"pl":{"stringUnit":{"state":"translated","value":"Konfiguracja oczekuje w kolejce na zegarek. Otwórz OpenClaw, zanim kod wygaśnie."}},"th":{"stringUnit":{"state":"translated","value":"เพิ่มการตั้งค่าในคิวสำหรับนาฬิกาแล้ว เปิด OpenClaw ก่อนรหัสหมดอายุ"}},"vi":{"stringUnit":{"state":"translated","value":"Thiết lập đã được đưa vào hàng đợi cho đồng hồ. Mở OpenClaw trước khi mã hết hạn."}},"nl":{"stringUnit":{"state":"translated","value":"Configuratie staat klaar voor het horloge. Open OpenClaw voordat de code verloopt."}},"fa":{"stringUnit":{"state":"translated","value":"راه‌اندازی برای ساعت در صف قرار گرفت. پیش از انقضای کد، OpenClaw را باز کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Настройка поставлена в очередь для часов. Откройте OpenClaw до истечения срока действия кода."}},"sv":{"stringUnit":{"state":"translated","value":"Konfigurationen har köats för klockan. Öppna OpenClaw innan koden går ut."}}}},
    "Setup received. Connecting…": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Setup received. Connecting…"}},"zh-CN":{"stringUnit":{"state":"translated","value":"已收到设置。 正在连接…"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已收到設定。正在連線…"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Configuração recebida. Conectando…"}},"de":{"stringUnit":{"state":"translated","value":"Einrichtungsdaten empfangen. Verbindung wird hergestellt…"}},"es":{"stringUnit":{"state":"translated","value":"Configuración recibida. Conectando…"}},"ja-JP":{"stringUnit":{"state":"translated","value":"セットアップを受信しました。 接続中…"}},"ko":{"stringUnit":{"state":"translated","value":"설정을 받았습니다. 연결 중…"}},"fr":{"stringUnit":{"state":"translated","value":"Configuration reçue. Connexion…"}},"hi":{"stringUnit":{"state":"translated","value":"सेटअप प्राप्त हुआ. कनेक्ट हो रहा है…"}},"ar":{"stringUnit":{"state":"translated","value":"تم استلام الإعداد. جارٍ الاتصال…"}},"it":{"stringUnit":{"state":"translated","value":"Configurazione ricevuta. Connessione in corso…"}},"tr":{"stringUnit":{"state":"translated","value":"Kurulum alındı. Bağlanıyor…"}},"uk":{"stringUnit":{"state":"translated","value":"Налаштування отримано. Підключення…"}},"id":{"stringUnit":{"state":"translated","value":"Penyiapan diterima. Menghubungkan…"}},"pl":{"stringUnit":{"state":"translated","value":"Odebrano konfigurację. Łączenie…"}},"th":{"stringUnit":{"state":"translated","value":"ได้รับการตั้งค่าแล้ว กำลังเชื่อมต่อ…"}},"vi":{"stringUnit":{"state":"translated","value":"Đã nhận thiết lập. Đang kết nối…"}},"nl":{"stringUnit":{"state":"translated","value":"Configuratie ontvangen. Verbinden…"}},"fa":{"stringUnit":{"state":"translated","value":"اطلاعات راه‌اندازی دریافت شد. در حال اتصال…"}},"ru":{"stringUnit":{"state":"translated","value":"Настройки получены. Подключение…"}},"sv":{"stringUnit":{"state":"translated","value":"Konfiguration mottagen. Ansluter…"}}}},
    "Setup sent. Open OpenClaw on the watch to connect.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Setup sent. Open OpenClaw on the watch to connect."}},"zh-CN":{"stringUnit":{"state":"translated","value":"设置已发送。 请在手表上打开 OpenClaw 以连接。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已傳送設定。請在手錶上開啟 OpenClaw 以連線。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Configuração enviada. Abra o OpenClaw no relógio para conectar."}},"de":{"stringUnit":{"state":"translated","value":"Einrichtungsdaten gesendet. Öffne OpenClaw auf der Uhr, um eine Verbindung herzustellen."}},"es":{"stringUnit":{"state":"translated","value":"Configuración enviada. Abre OpenClaw en el reloj para conectarte."}},"ja-JP":{"stringUnit":{"state":"translated","value":"セットアップを送信しました。 ウォッチで OpenClaw を開いて接続してください。"}},"ko":{"stringUnit":{"state":"translated","value":"설정을 보냈습니다. 연결하려면 워치에서 OpenClaw를 여세요."}},"fr":{"stringUnit":{"state":"translated","value":"Configuration envoyée. Ouvrez OpenClaw sur la montre pour vous connecter."}},"hi":{"stringUnit":{"state":"translated","value":"सेटअप भेजा गया. कनेक्ट करने के लिए घड़ी पर OpenClaw खोलें."}},"ar":{"stringUnit":{"state":"translated","value":"تم إرسال الإعداد. افتح OpenClaw على الساعة للاتصال."}},"it":{"stringUnit":{"state":"translated","value":"Configurazione inviata. Apri OpenClaw sull'orologio per connetterti."}},"tr":{"stringUnit":{"state":"translated","value":"Kurulum gönderildi. Bağlanmak için saatte OpenClaw'u açın."}},"uk":{"stringUnit":{"state":"translated","value":"Налаштування надіслано. Відкрийте OpenClaw на годиннику, щоб підключитися."}},"id":{"stringUnit":{"state":"translated","value":"Penyiapan dikirim. Buka OpenClaw di jam tangan untuk terhubung."}},"pl":{"stringUnit":{"state":"translated","value":"Wysłano konfigurację. Otwórz OpenClaw na zegarku, aby się połączyć."}},"th":{"stringUnit":{"state":"translated","value":"ส่งการตั้งค่าแล้ว เปิด OpenClaw บนนาฬิกาเพื่อเชื่อมต่อ"}},"vi":{"stringUnit":{"state":