    "Your agent runs on your own computer": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your agent runs on your own computer"}},"zh-CN":{"stringUnit":{"state":"translated","value":"你的智能体在你自己的电脑上运行"}},"zh-TW":{"stringUnit":{"state":"translated","value":"你的代理在你自己的電腦上執行"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Seu agente é executado no seu próprio computador"}},"de":{"stringUnit":{"state":"translated","value":"Dein Agent läuft auf deinem eigenen Computer"}},"es":{"stringUnit":{"state":"translated","value":"Tu agente se ejecuta en tu propio ordenador"}},"ja-JP":{"stringUnit":{"state":"translated","value":"エージェントはご自身のコンピュータ上で動作します"}},"ko":{"stringUnit":{"state":"translated","value":"에이전트는 내 컴퓨터에서 실행됩니다"}},"fr":{"stringUnit":{"state":"translated","value":"Votre agent s’exécute sur votre propre ordinateur"}},"hi":{"stringUnit":{"state":"translated","value":"आपका एजेंट आपके अपने कंप्यूटर पर चलता है"}},"ar":{"stringUnit":{"state":"translated","value":"يعمل وكيلك على حاسوبك الخاص"}},"it":{"stringUnit":{"state":"translated","value":"Il tuo agente viene eseguito sul tuo computer"}},"tr":{"stringUnit":{"state":"translated","value":"Ajanınız kendi bilgisayarınızda çalışır"}},"uk":{"stringUnit":{"state":"translated","value":"Ваш агент працює на вашому власному комп’ютері"}},"id":{"stringUnit":{"state":"translated","value":"Agen Anda berjalan di komputer Anda sendiri"}},"pl":{"stringUnit":{"state":"translated","value":"Twój agent działa na Twoim własnym komputerze"}},"th":{"stringUnit":{"state":"translated","value":"เอเจนต์ของคุณทำงานบนคอมพิวเตอร์ของคุณเอง"}},"vi":{"stringUnit":{"state":"translated","value":"Tác nhân của bạn chạy trên máy tính của chính bạn"}},"nl":{"stringUnit":{"state":"translated","value":"Je agent draait op je eigen computer"}},"fa":{"stringUnit":{"state":"translated","value":"عامل شما روی رایانه خودتان اجرا می‌شود"}},"ru":{"stringUnit":{"state":"translated","value":"Ваш агент работает на вашем компьютере"}},"sv":{"stringU