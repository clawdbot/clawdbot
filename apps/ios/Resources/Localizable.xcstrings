    "Open Settings if you need a manual host.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open Settings if you need a manual host."}},"zh-CN":{"stringUnit":{"state":"translated","value":"如需手动指定主机，请打开设置。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"如需手動設定主機，請開啟設定。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Abra os Ajustes se precisar configurar um host manualmente."}},"de":{"stringUnit":{"state":"translated","value":"Öffnen Sie die Einstellungen, wenn Sie einen Host manuell angeben müssen."}},"es":{"stringUnit":{"state":"translated","value":"Abre Ajustes si necesitas configurar un host manualmente."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ホストを手動で指定する必要がある場合は、設定を開いてください。"}},"ko":{"stringUnit":{"state":"translated","value":"호스트를 수동으로 지정해야 하는 경우 설정을 여세요."}},"fr":{"stringUnit":{"state":"translated","value":"Ouvrez les réglages si vous devez configurer un hôte manuellement."}},"hi":{"stringUnit":{"state":"translated","value":"यदि आपको मैन्युअल होस्ट की आवश्यकता है, तो सेटिंग्स खोलें."}},"ar":{"stringUnit":{"state":"translated","value":"افتح الإعدادات إذا كنت بحاجة إلى تحديد مضيف يدويًا."}},"it":{"stringUnit":{"state":"translated","value":"Apri le impostazioni se devi specificare un host manualmente."}},"tr":{"stringUnit":{"state":"translated","value":"Manuel olarak bir sunucu belirtmeniz gerekiyorsa Ayarları açın."}},"uk":{"stringUnit":{"state":"translated","value":"Відкрийте налаштування, якщо потрібно вказати хост вручну."}},"id":{"stringUnit":{"state":"translated","value":"Buka Pengaturan jika Anda perlu menentukan host secara manual."}},"pl":{"stringUnit":{"state":"translated","value":"Otwórz ustawienia, jeśli chcesz ręcznie podać hosta."}},"th":{"stringUnit":{"state":"translated","value":"เปิดการตั้งค่าหากคุณต้องการระบุโฮสต์ด้วยตนเอง."}},"vi":{"stringUnit":{"state":"translated","value":"Mở Cài đặt nếu bạn cần chỉ định máy chủ thủ công."}},"nl":{"stringUnit":{"state":"translated","value":"Open Instelling