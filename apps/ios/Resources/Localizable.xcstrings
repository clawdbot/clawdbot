    "The widget image could not be saved.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The widget image could not be saved."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法保存小组件图像。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法儲存小工具圖片。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível salvar a imagem do widget."}},"de":{"stringUnit":{"state":"translated","value":"Das Widget-Bild konnte nicht gespeichert werden."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo guardar la imagen del widget."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ウィジェットの画像を保存できませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"위젯 이미지를 저장할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’image du widget n’a pas pu être enregistrée."}},"hi":{"stringUnit":{"state":"translated","value":"विजेट की छवि सहेजी नहीं जा सकी।"}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر حفظ صورة الأداة."}},"it":{"stringUnit":{"state":"translated","value":"Non è stato possibile salvare l'immagine del widget."}},"tr":{"stringUnit":{"state":"translated","value":"Araç takımı görüntüsü kaydedilemedi."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося зберегти зображення віджета."}},"id":{"stringUnit":{"state":"translated","value":"Gambar widget tidak dapat disimpan."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się zapisać obrazu widżetu."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถบันทึกภาพวิดเจ็ตได้"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể lưu ảnh tiện ích."}},"nl":{"stringUnit":{"state":"translated","value":"De widgetafbeelding kon niet worden opgeslagen."}},"fa":{"stringUnit":{"state":"translated","value":"تصویر ویجت ذخیره نشد."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось сохранить изображение виджета."}},"sv":{"stringUnit":{"state":"translated","value":"Widgetbilden kunde inte sparas."}}}},
