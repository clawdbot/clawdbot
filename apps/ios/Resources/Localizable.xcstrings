    "Just received your iOS share + request, working on it.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Just received your iOS share + request, working on it."}},"zh-CN":{"stringUnit":{"state":"translated","value":"刚收到你的 iOS 分享内容 + 请求，正在处理。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"剛收到你從 iOS 分享的內容 + 請求，正在處理中。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Acabei de receber seu compartilhamento do iOS + solicitação, estou trabalhando nisso."}},"de":{"stringUnit":{"state":"translated","value":"Deinen über iOS geteilten Inhalt + deine Anfrage gerade erhalten, ich arbeite daran."}},"es":{"stringUnit":{"state":"translated","value":"Acabo de recibir lo que compartiste desde iOS + tu solicitud, estoy trabajando en ello."}},"ja-JP":{"stringUnit":{"state":"translated","value":"iOSからの共有 + リクエストを受信し、処理しています。"}},"ko":{"stringUnit":{"state":"translated","value":"iOS 공유와 요청을 방금 받았습니다. 처리 중입니다."}},"fr":{"stringUnit":{"state":"translated","value":"Votre partage iOS + votre demande viennent d’être reçus, traitement en cours."}},"hi":{"stringUnit":{"state":"translated","value":"आपका iOS शेयर + अनुरोध अभी मिला, उस पर काम कर रहे हैं."}},"ar":{"stringUnit":{"state":"translated","value":"وصلتني للتو مشاركتك من iOS + طلبك، وأعمل عليهما."}},"it":{"stringUnit":{"state":"translated","value":"Ho appena ricevuto la tua condivisione iOS + richiesta, ci sto lavorando."}},"tr":{"stringUnit":{"state":"translated","value":"iOS paylaşımınızı + isteğinizi az önce aldım, üzerinde çalışıyorum."}},"uk":{"stringUnit":{"state":"translated","value":"Щойно отримано ваші матеріали з iOS + запит, працюємо над цим."}},"id":{"stringUnit":{"state":"translated","value":"Baru saja menerima konten yang Anda bagikan dari iOS + permintaan Anda, sedang diproses."}},"pl":{"stringUnit":{"state":"translated","value":"Właśnie dotarły udostępnione treści z iOS + prośba, pracuję nad tym."}},"th":{"stringUnit":{"state":"translated","value":"เพิ่งได้รับสิ่งที่คุณแชร์จาก iOS + คำขอ กำลังดำเนินการอยู่"}},"vi":{"stringUnit":{"state":"translated","value":"Vừa nhận được nội dung chia sẻ từ iOS + yêu cầu của bạn, đang xử lý."}},"nl":{"stringUnit":{"state":"translated","value":"Je gedeelde iOS-inhoud + verzoek zojuist ontvangen, ik werk eraan."}},"fa":{"stringUnit":{"state":"translated","value":"محتوای اشتراک‌گذاری‌شده از iOS + درخواست شما همین حالا دریافت شد، در حال رسیدگی به آن هستم."}},"ru":{"stringUnit":{"state":"translated","value":"Только что получены материалы из меню «Поделиться» в iOS + запрос, уже в работе."}},"sv":{"stringUnit":{"state":"translated","value":"Tog precis emot din delning från iOS + begäran, arbetar på det."}}}},
    "Keep Gateway Connected": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Keep Gateway Connected"}},"zh-CN":{"stringUnit":{"state":"translated","value":"保持 Gateway 连接"}},"zh-TW":{"stringUnit":{"state":"translated","value":"保持 Gateway 連線"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Manter Gateway Conectado"}},"de":{"stringUnit":{"state":"translated","value":"Gateway verbunden halten"}},"es":{"stringUnit":{"state":"translated","value":"Mantener Gateway conectado"}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayの接続を維持"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway 연결 유지"}},"fr":{"stringUnit":{"state":"translated","value":"Maintenir Gateway connecté"}},"hi":{"stringUnit":{"state":"translated","value":"Gateway को कनेक्टेड रखें"}},"ar":{"stringUnit":{"state":"translated","value":"إبقاء Gateway متصلًا"}},"it":{"stringUnit":{"state":"translated","value":"Mantieni Gateway connesso"}},"tr":{"stringUnit":{"state":"translated","value":"Gateway Bağlantısını Koru"}},"uk":{"stringUnit":{"state":"translated","value":"Підтримувати з’єднання з Gateway"}},"id":{"stringUnit":{"state":"translated","value":"Jaga Gateway Tetap Terhubung"}},"pl":{"stringUnit":{"state":"translated","value":"Utrzymuj połączenie z Gateway"}},"th":{"stringUnit":{"state":"translated","value":"คงการเชื่อมต่อ Gateway ไว้"}},"vi":{"stringUnit":{"state":"translated","value":"Duy trì kết nối Gateway"}},"nl":{"stringUnit":{"state":"translated","value":"Gateway Verbonden Houden"}},"fa":{"stringUnit":{"state":"translated","value":"متصل نگه داشتن Gateway"}},"ru":{"stringUnit":{"state":"translated","value":"Поддерживать подключение к Gateway"}},"sv":{"stringUnit":{"state":"translated","value":"Håll Gateway ansluten"}}}},
    "Keep OpenClaw on screen until connected. Tap End to finish.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Keep OpenClaw on screen until connected. Tap End to finish."}},"zh-CN":{"stringUnit":{"state":"translated","value":"请保持 OpenClaw 显示在屏幕上，直到连接成功。轻点“结束”以完成。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"請讓 OpenClaw 保持顯示在螢幕上，直到連線完成。點一下「結束」即可完成。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Mantenha o OpenClaw na tela até conectar. Toque em Encerrar para finalizar."}},"de":{"stringUnit":{"state":"translated","value":"Lassen Sie OpenClaw auf dem Bildschirm geöffnet, bis die Verbindung hergestellt ist. Tippen Sie zum Beenden auf „Beenden“."}},"es":{"stringUnit":{"state":"translated","value":"Mantén OpenClaw en pantalla hasta que se conecte. Toca Finalizar para terminar."}},"ja-JP":{"stringUnit":{"state":"translated","value":"接続されるまでOpenClawを画面に表示したままにしてください。終了するには「終了」をタップしてください。"}},"ko":{"stringUnit":{"state":"translated","value":"연결될 때까지 OpenClaw 화면을 유지하세요. 마치려면 종료를 탭하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Gardez OpenClaw à l’écran jusqu’à la connexion. Touchez Terminer pour finir."}},"hi":{"stringUnit":{"state":"translated","value":"कनेक्ट होने तक OpenClaw को स्क्रीन पर खुला रखें। समाप्त करने के लिए समाप्त करें पर टैप करें।"}},"ar":{"stringUnit":{"state":"translated","value":"أبقِ OpenClaw على الشاشة حتى يتم الاتصال. اضغط على إنهاء للانتهاء."}},"it":{"stringUnit":{"state":"translated","value":"Mantieni OpenClaw sullo schermo fino alla connessione. Tocca Termina per concludere."}},"tr":{"stringUnit":{"state":"translated","value":"Bağlantı kurulana kadar OpenClaw uygulamasını ekranda tutun. Bitirmek için Sonlandır'a dokunun."}},"uk":{"stringUnit":{"state":"translated","value":"Не закривайте OpenClaw, доки не буде встановлено з’єднання. Натисніть «Завершити», щоб закінчити."}},"id":{"stringUnit":{"state":"translated","value":"Biarkan OpenClaw tetap tampil di layar hingga terhubung. Ketuk Akhiri untuk menyelesaikan."}},"pl":{"stringUnit":{"state":"translated","value":"Pozostaw OpenClaw na ekranie do czasu nawiązania połączenia. Stuknij Zakończ, aby zakończyć."}},"th":{"stringUnit":{"state":"translated","value":"เปิด OpenClaw ค้างไว้บนหน้าจอจนกว่าจะเชื่อมต่อสำเร็จ แตะสิ้นสุดเพื่อจบการสนทนา"}},"vi":{"stringUnit":{"state":"translated","value":"Giữ OpenClaw trên màn hình cho đến khi kết nối thành công. Nhấn Kết thúc để hoàn tất."}},"nl":{"stringUnit":{"state":"translated","value":"Houd OpenClaw op het scherm totdat de verbinding tot stand is gebracht. Tik op Beëindigen om af te sluiten."}},"fa":{"stringUnit":{"state":"translated","value":"تا زمان برقراری اتصال، OpenClaw را روی صفحه نگه دارید. برای پایان دادن، روی پایان بزنید."}},"ru":{"stringUnit":{"state":"translated","value":"Не закрывайте OpenClaw до подключения. Нажмите «Завершить», чтобы закончить."}},"sv":{"stringUnit":{"state":"translated","value":"Låt OpenClaw vara öppet på skärmen tills anslutningen är klar. Tryck på Avsluta för att avsluta."}}}},
    "Keep multiple gateways connected and switch which one is in focus.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Keep multiple gateways connected and switch which one is in focus."}},"zh-CN":{"stringUnit":{"state":"translated","value":"保持多个网关连接，并切换当前使用的网关。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"保持多個 Gateway 連線，並切換目前使用的 Gateway。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Mantenha vários gateways conectados e alterne qual deles está em foco."}},"de":{"stringUnit":{"state":"translated","value":"Halte mehrere Gateways verbunden und wechsle zwischen ihnen."}},"es":{"stringUnit":{"state":"translated","value":"Mantén varios gateways conectados y cambia cuál está seleccionado."}},"ja-JP":{"stringUnit":{"state":"translated","value":"複数のGatewayの接続を維持し、操作対象を切り替えます。"}},"ko":{"stringUnit":{"state":"translated","value":"여러 게이트웨이의 연결을 유지하고 사용할 게이트웨이를 전환합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Maintenez plusieurs passerelles connectées et choisissez celle qui est active."}},"hi":{"stringUnit":{"state":"translated","value":"एक से ज़्यादा गेटवे कनेक्टेड रखें और फ़ोकस में रहने वाला गेटवे बदलें."}},"ar":{"stringUnit":{"state":"translated","value":"أبقِ عدة بوابات متصلة وبدّل البوابة النشطة."}},"it":{"stringUnit":{"state":"translated","value":"Mantieni connessi più gateway e scegli quale mettere in primo piano."}},"tr":{"stringUnit":{"state":"translated","value":"Birden fazla Gateway bağlantısını koruyun ve hangisinin odakta olduğunu değiştirin."}},"uk":{"stringUnit":{"state":"translated","value":"Підтримуйте з’єднання з кількома шлюзами та перемикайтеся між ними."}},"id":{"stringUnit":{"state":"translated","value":"Jaga beberapa gateway tetap terhubung dan beralih di antara gateway yang menjadi fokus."}},"pl":{"stringUnit":{"state":"translated","value":"Utrzymuj połączenie z wieloma bramami i przełączaj aktywną bramę."}},"th":{"stringUnit":{"state":"translated","value":"เชื่อมต่อเกตเวย์หลายตัวไว้และสลับตัวที่ใช้งานอยู่"}},"vi":{"stringUnit":{"state":"translated","value":"Duy trì kết nối với nhiều gateway và chuyển đổi gateway đang được chọn."}},"nl":{"stringUnit":{"state":"translated","value":"Houd meerdere gateways verbonden en wissel welke actief is."}},"fa":{"stringUnit":{"state":"translated","value":"چندین درگاه را متصل نگه دارید و انتخاب کنید کدام‌یک در کانون توجه باشد."}},"ru":{"stringUnit":{"state":"translated","value":"Поддерживайте подключение к нескольким шлюзам и переключайтесь между ними."}},"sv":{"stringUnit":{"state":"translated","value":"Håll flera gateways anslutna och växla vilken som är i fokus."}}}},
    "Keep your iPhone on the same LAN or tailnet, then start the Gateway on your host machine.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Keep your iPhone on the same LAN or tailnet, then start the Gateway on your host machine."}},"zh-CN":{"stringUnit":{"state":"translated","value":"让你的 iPhone 保持连接到同一局域网或 tailnet，然后在主机上启动 Gateway。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"請讓 iPhone 保持連線至同一個區域網路或 tailnet，然後在主機上啟動 Gateway。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Mantenha seu iPhone na mesma LAN ou tailnet e inicie o Gateway na sua máquina host."}},"de":{"stringUnit":{"state":"translated","value":"Lass dein iPhone im selben LAN oder Tailnet und starte dann den Gateway auf deinem Host-Rechner."}},"es":{"stringUnit":{"state":"translated","value":"Mantén tu iPhone en la misma LAN o tailnet y luego inicia Gateway en tu equipo anfitrión."}},"ja-JP":{"stringUnit":{"state":"translated","value":"iPhoneを同じLANまたはtailnetに接続したまま、ホストマシンでGatewayを起動してください。"}},"ko":{"stringUnit":{"state":"translated","value":"iPhone을 동일한 LAN 또는 tailnet에 연결한 상태에서 호스트 컴퓨터의 Gateway를 시작하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Gardez votre iPhone sur le même réseau local ou tailnet, puis démarrez Gateway sur votre machine hôte."}},"hi":{"stringUnit":{"state":"translated","value":"अपने iPhone को उसी LAN या tailnet पर रखें, फिर अपनी होस्ट मशीन पर Gateway शुरू करें."}},"ar":{"stringUnit":{"state":"translated","value":"أبقِ iPhone على شبكة LAN أو tailnet نفسها، ثم شغّل Gateway على الجهاز المضيف."}},"it":{"stringUnit":{"state":"translated","value":"Mantieni il tuo iPhone sulla stessa LAN o tailnet, quindi avvia Gateway sul computer host."}},"tr":{"stringUnit":{"state":"translated","value":"iPhone'unuzu aynı LAN veya tailnet üzerinde tutun, ardından ana makinenizde Gateway'i başlatın."}},"uk":{"stringUnit":{"state":"translated","value":"Залиште iPhone у тій самій локальній мережі або tailnet, а потім запустіть Gateway на хост-комп’ютері."}},"id":{"stringUnit":{"state":"translated","value":"Pastikan iPhone Anda tetap berada di LAN atau tailnet yang sama, lalu jalankan Gateway di mesin host Anda."}},"pl":{"stringUnit":{"state":"translated","value":"Pozostaw iPhone'a w tej samej sieci LAN lub tailnet, a następnie uruchom Gateway na komputerze hosta."}},"th":{"stringUnit":{"state":"translated","value":"ให้ iPhone ของคุณอยู่บน LAN หรือ tailnet เดียวกัน แล้วเริ่ม Gateway บนเครื่องโฮสต์ของคุณ"}},"vi":{"stringUnit":{"state":"translated","value":"Giữ iPhone của bạn trên cùng mạng LAN hoặc tailnet, sau đó khởi động Gateway trên máy chủ của bạn."}},"nl":{"stringUnit":{"state":"translated","value":"Houd je iPhone op hetzelfde LAN of tailnet en start vervolgens de Gateway op je hostcomputer."}},"fa":{"stringUnit":{"state":"translated","value":"iPhone خود را در همان شبکهٔ محلی یا tailnet نگه دارید، سپس Gateway را روی دستگاه میزبان خود راه‌اندازی کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Оставьте iPhone в той же локальной сети или сети tailnet, затем запустите Gateway на хост-компьютере."}},"sv":{"stringUnit":{"state":"translated","value":"Håll din iPhone på samma LAN eller tailnet och starta sedan Gateway på din värddator."}}}},
