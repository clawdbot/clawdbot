    "Voice requires a resolved network address.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Voice requires a resolved network address."}},"zh-CN":{"stringUnit":{"state":"translated","value":"语音需要已解析的网络地址。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語音需要已解析的網路位址。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O recurso de voz requer um endereço de rede resolvido."}},"de":{"stringUnit":{"state":"translated","value":"Die Sprachfunktion benötigt eine aufgelöste Netzwerkadresse."}},"es":{"stringUnit":{"state":"translated","value":"La función de voz requiere una dirección de red resuelta."}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声には名前解決済みのネットワークアドレスが必要です。"}},"ko":{"stringUnit":{"state":"translated","value":"음성 연결에는 확인된 네트워크 주소가 필요합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le mode vocal nécessite une adresse réseau résolue."}},"hi":{"stringUnit":{"state":"translated","value":"वॉइस के लिए एक रिज़ॉल्व किया हुआ नेटवर्क पता आवश्यक है।"}},"ar":{"stringUnit":{"state":"translated","value":"يتطلب الاتصال الصوتي عنوان شبكة تم حله."}},"it":{"stringUnit":{"state":"translated","value":"La modalità vocale richiede un indirizzo di rete risolto."}},"tr":{"stringUnit":{"state":"translated","value":"Ses için çözümlenmiş bir ağ adresi gerekiyor."}},"uk":{"stringUnit":{"state":"translated","value":"Для голосового зв’язку потрібна визначена мережева адреса."}},"id":{"stringUnit":{"state":"translated","value":"Suara memerlukan alamat jaringan yang telah diresolusikan."}},"pl":{"stringUnit":{"state":"translated","value":"Połączenie głosowe wymaga rozpoznanego adresu sieciowego."}},"th":{"stringUnit":{"state":"translated","value":"ระบบเสียงต้องใช้ที่อยู่เครือข่ายที่แปลงเป็นที่อยู่ IP แล้ว"}},"vi":{"stringUnit":{"state":"translated","value":"Tính năng thoại yêu cầu địa chỉ mạng đã được phân giải."}},"nl":{"stringUnit":{"state":"translated","value":"Spraak vereist een netwerkadres dat naar een IP-adres is omgezet."}},"fa":{"stringUnit":{"state":"translated","value":"قابلیت صوتی به یک نشانی شبکهٔ حل‌شده نیاز دارد."}},"ru":{"stringUnit":{"state":"translated","value":"Для голосовой связи требуется разрешённый сетевой адрес."}},"sv":{"stringUnit":{"state":"translated","value":"Röstfunktionen kräver en nätverksadress som har slagits upp."}}}},
    "Voice setup was incomplete. Send voice setup again from iPhone.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Voice setup was incomplete. Send voice setup again from iPhone."}},"zh-CN":{"stringUnit":{"state":"translated","value":"语音设置未完成。请从 iPhone 重新发送语音设置。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語音設定未完成。請從 iPhone 重新傳送語音設定。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A configuração de voz estava incompleta. Envie a configuração de voz novamente pelo iPhone."}},"de":{"stringUnit":{"state":"translated","value":"Die Einrichtung der Sprachfunktion war unvollständig. Senden Sie die Einrichtung erneut vom iPhone."}},"es":{"stringUnit":{"state":"translated","value":"La configuración de voz quedó incompleta. Vuelve a enviar la configuración de voz desde el iPhone."}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声の設定が完了していません。iPhoneから音声の設定を再送信してください。"}},"ko":{"stringUnit":{"state":"translated","value":"음성 설정이 완료되지 않았습니다. iPhone에서 음성 설정을 다시 보내세요."}},"fr":{"stringUnit":{"state":"translated","value":"La configuration du mode vocal était incomplète. Renvoyez la configuration depuis l’iPhone."}},"hi":{"stringUnit":{"state":"translated","value":"वॉइस सेटअप अधूरा था। iPhone से वॉइस सेटअप फिर से भेजें।"}},"ar":{"stringUnit":{"state":"translated","value":"لم يكتمل إعداد الاتصال الصوتي. أرسل إعداد الاتصال الصوتي مجددًا من iPhone."}},"it":{"stringUnit":{"state":"translated","value":"La configurazione della modalità vocale era incompleta. Inviala di nuovo da iPhone."}},"tr":{"stringUnit":{"state":"translated","value":"Ses kurulumu tamamlanmadı. Ses kurulumunu iPhone'dan tekrar gönderin."}},"uk":{"stringUnit":{"state":"translated","value":"Налаштування голосового зв’язку не завершено. Надішліть налаштування голосового зв’язку з iPhone ще раз."}},"id":{"stringUnit":{"state":"translated","value":"Penyiapan suara belum lengkap. Kirim ulang penyiapan suara dari iPhone."}},"pl":{"stringUnit":{"state":"translated","value":"Konfiguracja połączenia głosowego była niekompletna. Wyślij ją ponownie z iPhone’a."}},"th":{"stringUnit":{"state":"translated","value":"การตั้งค่าเสียงไม่สมบูรณ์ โปรดส่งการตั้งค่าเสียงจาก iPhone อีกครั้ง"}},"vi":{"stringUnit":{"state":"translated","value":"Thiết lập thoại chưa hoàn tất. Hãy gửi lại thiết lập thoại từ iPhone."}},"nl":{"stringUnit":{"state":"translated","value":"De spraakconfiguratie was onvolledig. Verstuur de spraakconfiguratie opnieuw vanaf de iPhone."}},"fa":{"stringUnit":{"state":"translated","value":"راه‌اندازی قابلیت صوتی ناقص بود. اطلاعات راه‌اندازی صوتی را دوباره از iPhone ارسال کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Настройка голосовой связи не завершена. Отправьте настройки голосовой связи с iPhone ещё раз."}},"sv":{"stringUnit":{"state":"translated","value":"Röstkonfigurationen var ofullständig. Skicka röstkonfigurationen igen från iPhone."}}}},
    "Voice was interrupted. Start voice again to continue.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Voice was interrupted. Start voice again to continue."}},"zh-CN":{"stringUnit":{"state":"translated","value":"语音已中断。请重新启动语音以继续。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語音已中斷。請重新啟動語音以繼續。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O recurso de voz foi interrompido. Inicie-o novamente para continuar."}},"de":{"stringUnit":{"state":"translated","value":"Die Sprachfunktion wurde unterbrochen. Starten Sie die Sprachfunktion erneut, um fortzufahren."}},"es":{"stringUnit":{"state":"translated","value":"La función de voz se interrumpió. Vuelve a iniciarla para continuar."}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声が中断されました。続行するには音声を再開してください。"}},"ko":{"stringUnit":{"state":"translated","value":"음성이 중단되었습니다. 계속하려면 음성을 다시 시작하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Le mode vocal a été interrompu. Relancez-le pour continuer."}},"hi":{"stringUnit":{"state":"translated","value":"वॉइस बाधित हो गया था। जारी रखने के लिए वॉइस फिर से शुरू करें।"}},"ar":{"stringUnit":{"state":"translated","value":"انقطع الاتصال الصوتي. ابدأ الاتصال الصوتي مجددًا للمتابعة."}},"it":{"stringUnit":{"state":"translated","value":"La modalità vocale è stata interrotta. Riavviala per continuare."}},"tr":{"stringUnit":{"state":"translated","value":"Ses kesintiye uğradı. Devam etmek için sesi yeniden başlatın."}},"uk":{"stringUnit":{"state":"translated","value":"Голосовий зв’язок перервано. Щоб продовжити, запустіть його знову."}},"id":{"stringUnit":{"state":"translated","value":"Suara terputus. Mulai suara lagi untuk melanjutkan."}},"pl":{"stringUnit":{"state":"translated","value":"Połączenie głosowe zostało przerwane. Uruchom je ponownie, aby kontynuować."}},"th":{"stringUnit":{"state":"translated","value":"ระบบเสียงถูกขัดจังหวะ โปรดเริ่มใช้งานเสียงอีกครั้งเพื่อดำเนินการต่อ"}},"vi":{"stringUnit":{"state":"translated","value":"Tính năng thoại đã bị gián đoạn. Hãy khởi động lại tính năng thoại để tiếp tục."}},"nl":{"stringUnit":{"state":"translated","value":"Spraak is onderbroken. Start spraak opnieuw om door te gaan."}},"fa":{"stringUnit":{"state":"translated","value":"قابلیت صوتی قطع شد. برای ادامه، آن را دوباره شروع کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Голосовая связь прервана. Запустите голосовую связь снова, чтобы продолжить."}},"sv":{"stringUnit":{"state":"translated","value":"Röstfunktionen avbröts. Starta röstfunktionen igen för att fortsätta."}}}},
