    "Connection stopped in the background. Keep OpenClaw on screen until connected.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connection stopped in the background. Keep OpenClaw on screen until connected."}},"zh-CN":{"stringUnit":{"state":"translated","value":"连接在后台已停止。请保持 OpenClaw 在前台显示，直到连接成功。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"連線已在背景停止。請讓 OpenClaw 保持顯示在螢幕上，直到連線完成。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A conexão foi interrompida em segundo plano. Mantenha o OpenClaw na tela até conectar."}},"de":{"stringUnit":{"state":"translated","value":"Verbindungsaufbau im Hintergrund gestoppt. Lass OpenClaw auf dem Bildschirm geöffnet, bis die Verbindung hergestellt ist."}},"es":{"stringUnit":{"state":"translated","value":"La conexión se detuvo en segundo plano. Mantén OpenClaw en pantalla hasta que se conecte."}},"ja-JP":{"stringUnit":{"state":"translated","value":"バックグラウンドで接続が停止しました。接続が完了するまでOpenClawを画面に表示したままにしてください。"}},"ko":{"stringUnit":{"state":"translated","value":"백그라운드에서 연결이 중단되었습니다. 연결될 때까지 OpenClaw를 화면에 띄워 두세요."}},"fr":{"stringUnit":{"state":"translated","value":"La connexion s’est interrompue en arrière-plan. Gardez OpenClaw à l’écran jusqu’à ce que la connexion soit établie."}},"hi":{"stringUnit":{"state":"translated","value":"बैकग्राउंड में कनेक्शन रुक गया। कनेक्ट होने तक OpenClaw को स्क्रीन पर खुला रखें।"}},"ar":{"stringUnit":{"state":"translated","value":"توقف الاتصال في الخلفية. أبقِ OpenClaw ظاهرًا على الشاشة حتى يتم الاتصال."}},"it":{"stringUnit":{"state":"translated","value":"Connessione interrotta in background. Mantieni OpenClaw sullo schermo fino a quando la connessione non è stabilita."}},"tr":{"stringUnit":{"state":"translated","value":"Bağlantı arka planda durduruldu. Bağlanana kadar OpenClaw'u ekranda tutun."}},"uk":{"stringUnit":{"state":"translated","value":"Підключення зупинено у фоновому режимі. Залиште OpenClaw на екрані до завершення підключення."}},"id":{"stringUnit":{"state":"translated","value":"Koneksi terhenti di latar belakang. Biarkan OpenClaw tetap terbuka di layar hingga terhubung."}},"pl":{"stringUnit":{"state":"translated","value":"Łączenie zostało przerwane w tle. Pozostaw OpenClaw na ekranie do czasu nawiązania połączenia."}},"th":{"stringUnit":{"state":"translated","value":"การเชื่อมต่อหยุดลงขณะทำงานเบื้องหลัง โปรดเปิด OpenClaw ค้างไว้บนหน้าจอจนกว่าจะเชื่อมต่อสำเร็จ"}},"vi":{"stringUnit":{"state":"translated","value":"Kết nối đã dừng khi chạy nền. Giữ OpenClaw trên màn hình cho đến khi kết nối xong."}},"nl":{"stringUnit":{"state":"translated","value":"Verbinding maken is op de achtergrond gestopt. Houd OpenClaw op het scherm totdat de verbinding tot stand is gebracht."}},"fa":{"stringUnit":{"state":"translated","value":"اتصال در پس‌زمینه متوقف شد. تا برقراری اتصال، OpenClaw را روی صفحه باز نگه دارید."}},"ru":{"stringUnit":{"state":"translated","value":"Подключение остановлено в фоновом режиме. Оставьте OpenClaw на экране до завершения подключения."}},"sv":{"stringUnit":{"state":"translated","value":"Anslutningen avbröts i bakgrunden. Ha OpenClaw öppet på skärmen tills anslutningen är klar."}}}},
    "Connection timed out. Make sure Tailscale is connected, then try again.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connection timed out. Make sure Tailscale is connected, then try again."}},"zh-CN":{"stringUnit":{"state":"translated","value":"连接超时。 请确保 Tailscale 已连接, 然后重试。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"連線逾時。 請確認 Tailscale 已連線, 然後再試一次。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O tempo limite da conexão foi excedido. Verifique se o Tailscale está conectado e tente novamente."}},"de":{"stringUnit":{"state":"translated","value":"Zeitüberschreitung bei der Verbindung. Stellen Sie sicher, dass Tailscale verbunden ist, und versuchen Sie es erneut."}},"es":{"stringUnit":{"state":"translated","value":"Se agotó el tiempo de espera de la conexión. Asegúrate de que Tailscale esté conectado y vuelve a intentarlo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"接続がタイムアウトしました。 Tailscaleが接続されていることを確認してから、もう一度お試しください。"}},"ko":{"stringUnit":{"state":"translated","value":"연결 시간이 초과되었습니다. Tailscale이 연결되어 있는지 확인한 후 다시 시도하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Le délai de connexion a expiré. Assurez-vous que Tailscale est connecté, puis réessayez."}},"hi":{"stringUnit":{"state":"translated","value":"कनेक्शन का समय समाप्त हो गया. सुनिश्चित करें कि Tailscale कनेक्टेड है, फिर दोबारा कोशिश करें."}},"ar":{"stringUnit":{"state":"translated","value":"انتهت مهلة الاتصال. تأكد من اتصال Tailscale، ثم حاول مرة أخرى."}},"it":{"stringUnit":{"state":"translated","value":"Tempo di connessione scaduto. Assicurati che Tailscale sia connesso, quindi riprova."}},"tr":{"stringUnit":{"state":"translated","value":"Bağlantı zaman aşımına uğradı. Tailscale'in bağlı olduğundan emin olun, ardından tekrar deneyin."}},"uk":{"stringUnit":{"state":"translated","value":"Час очікування з’єднання минув. Переконайтеся, що Tailscale підключено, і спробуйте ще раз."}},"id":{"stringUnit":{"state":"translated","value":"Waktu koneksi habis. Pastikan Tailscale terhubung, lalu coba lagi."}},"pl":{"stringUnit":{"state":"translated","value":"Upłynął limit czasu połączenia. Upewnij się, że Tailscale jest połączony, a następnie spróbuj ponownie."}},"th":{"stringUnit":{"state":"translated","value":"การเชื่อมต่อหมดเวลา. ตรวจสอบว่า Tailscale เชื่อมต่ออยู่ แล้วลองอีกครั้ง."}},"vi":{"stringUnit":{"state":"translated","value":"Kết nối đã hết thời gian chờ. Hãy đảm bảo Tailscale đã được kết nối, rồi thử lại."}},"nl":{"stringUnit":{"state":"translated","value":"Time-out bij het verbinden. Zorg dat Tailscale verbonden is en probeer het opnieuw."}},"fa":{"stringUnit":{"state":"translated","value":"مهلت اتصال به پایان رسید. مطمئن شوید Tailscale متصل است، سپس دوباره تلاش کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Время ожидания подключения истекло. Убедитесь, что Tailscale подключён, и повторите попытку."}},"sv":{"stringUnit":{"state":"translated","value":"Anslutningens tidsgräns överskreds. Kontrollera att Tailscale är anslutet och försök sedan igen."}}}},
    "Connection, auth, and diagnostics.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connection, auth, and diagnostics."}},"zh-CN":{"stringUnit":{"state":"translated","value":"连接、身份验证和诊断。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"連線, 驗證與診斷。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Conexão, autenticação e diagnósticos."}},"de":{"stringUnit":{"state":"translated","value":"Verbindung, Authentifizierung und Diagnose."}},"es":{"stringUnit":{"state":"translated","value":"Conexión, autenticación y diagnóstico."}},"ja-JP":{"stringUnit":{"state":"translated","value":"接続、認証、診断。"}},"ko":{"stringUnit":{"state":"translated","value":"연결, 인증 및 진단."}},"fr":{"stringUnit":{"state":"translated","value":"Connexion, authentification et diagnostics."}},"hi":{"stringUnit":{"state":"translated","value":"कनेक्शन, प्रमाणीकरण, और निदान."}},"ar":{"stringUnit":{"state":"translated","value":"الاتصال والمصادقة والتشخيصات."}},"it":{"stringUnit":{"state":"translated","value":"Connessione, autenticazione e diagnostica."}},"tr":{"stringUnit":{"state":"translated","value":"Bağlantı, kimlik doğrulama ve tanılama."}},"uk":{"stringUnit":{"state":"translated","value":"З’єднання, автентифікація та діагностика."}},"id":{"stringUnit":{"state":"translated","value":"Koneksi, autentikasi, dan diagnostik."}},"pl":{"stringUnit":{"state":"translated","value":"Połączenie, uwierzytelnianie i diagnostyka."}},"th":{"stringUnit":{"state":"translated","value":"การเชื่อมต่อ, การยืนยันตัวตน, และการวินิจฉัย."}},"vi":{"stringUnit":{"state":"translated","value":"Kết nối, xác thực và chẩn đoán."}},"nl":{"stringUnit":{"state":"translated","value":"Verbinding, authenticatie en diagnostiek."}},"fa":{"stringUnit":{"state":"translated","value":"اتصال، احراز هویت و عیب‌یابی."}},"ru":{"stringUnit":{"state":"translated","value":"Подключение, аутентификация и диагностика."}},"sv":{"stringUnit":{"state":"translated","value":"Anslutning, autentisering och diagnostik."}}}},
