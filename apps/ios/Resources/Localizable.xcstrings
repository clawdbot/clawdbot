    "Direct connection failed: %@": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Direct connection failed: %@"}},"zh-CN":{"stringUnit":{"state":"translated","value":"直接连接失败: %@"}},"zh-TW":{"stringUnit":{"state":"translated","value":"直接連線失敗: %@"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Falha na conexão direta: %@"}},"de":{"stringUnit":{"state":"translated","value":"Direkte Verbindung fehlgeschlagen: %@"}},"es":{"stringUnit":{"state":"translated","value":"Error de conexión directa: %@"}},"ja-JP":{"stringUnit":{"state":"translated","value":"直接接続に失敗しました: %@"}},"ko":{"stringUnit":{"state":"translated","value":"직접 연결 실패: %@"}},"fr":{"stringUnit":{"state":"translated","value":"Échec de la connexion directe: %@"}},"hi":{"stringUnit":{"state":"translated","value":"सीधा कनेक्शन विफल हुआ: %@"}},"ar":{"stringUnit":{"state":"translated","value":"فشل الاتصال المباشر: %@"}},"it":{"stringUnit":{"state":"translated","value":"Connessione diretta non riuscita: %@"}},"tr":{"stringUnit":{"state":"translated","value":"Doğrudan bağlantı başarısız oldu: %@"}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося встановити пряме з’єднання: %@"}},"id":{"stringUnit":{"state":"translated","value":"Koneksi langsung gagal: %@"}},"pl":{"stringUnit":{"state":"translated","value":"Połączenie bezpośrednie nie powiodło się: %@"}},"th":{"stringUnit":{"state":"translated","value":"การเชื่อมต่อโดยตรงล้มเหลว: %@"}},"vi":{"stringUnit":{"state":"translated","value":"Kết nối trực tiếp thất bại: %@"}},"nl":{"stringUnit":{"state":"translated","value":"Directe verbinding mislukt: %@"}},"fa":{"stringUnit":{"state":"translated","value":"اتصال مستقیم ناموفق بود: %@"}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось установить прямое подключение: %@"}},"sv":{"stringUnit":{"state":"translated","value":"Direktanslutningen misslyckades: %@"}}}},
    "Direct connection is off": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Direct connection is off"}},"zh-CN":{"stringUnit":{"state":"translated","value":"直接连接已关闭"}},"zh-TW":{"stringUnit":{"state":"translated","value":"直接連線已關閉"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A conexão direta está desativada"}},"de":{"stringUnit":{"state":"translated","value":"Direkte Verbindung ist deaktiviert"}},"es":{"stringUnit":{"state":"translated","value":"La conexión directa está desactivada"}},"ja-JP":{"stringUnit":{"state":"translated","value":"直接接続はオフです"}},"ko":{"stringUnit":{"state":"translated","value":"직접 연결이 꺼져 있음"}},"fr":{"stringUnit":{"state":"translated","value":"La connexion directe est désactivée"}},"hi":{"stringUnit":{"state":"translated","value":"सीधा कनेक्शन बंद है"}},"ar":{"stringUnit":{"state":"translated","value":"الاتصال المباشر معطّل"}},"it":{"stringUnit":{"state":"translated","value":"La connessione diretta è disattivata"}},"tr":{"stringUnit":{"state":"translated","value":"Doğrudan bağlantı kapalı"}},"uk":{"stringUnit":{"state":"translated","value":"Пряме з’єднання вимкнено"}},"id":{"stringUnit":{"state":"translated","value":"Koneksi langsung nonaktif"}},"pl":{"stringUnit":{"state":"translated","value":"Połączenie bezpośrednie jest wyłączone"}},"th":{"stringUnit":{"state":"translated","value":"การเชื่อมต่อโดยตรงปิดอยู่"}},"vi":{"stringUnit":{"state":"translated","value":"Kết nối trực tiếp đang tắt"}},"nl":{"stringUnit":{"state":"translated","value":"Directe verbinding is uitgeschakeld"}},"fa":{"stringUnit":{"state":"translated","value":"اتصال مستقیم غیرفعال است"}},"ru":{"stringUnit":{"state":"translated","value":"Прямое подключение отключено"}},"sv":{"stringUnit":{"state":"translated","value":"Direktanslutning är avstängd"}}}},
    "Direct mode requires a trusted HTTPS Gateway endpoint.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Direct mode requires a trusted HTTPS Gateway endpoint."}},"zh-CN":{"stringUnit":{"state":"translated","value":"直连模式需要受信任的 HTTPS Gateway 端点。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"直接模式需要受信任的 HTTPS Gateway 端點。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O modo direto exige um endpoint HTTPS confiável do Gateway."}},"de":{"stringUnit":{"state":"translated","value":"Der Direktmodus erfordert einen vertrauenswürdigen HTTPS-Endpunkt des Gateway."}},"es":{"stringUnit":{"state":"translated","value":"El modo directo requiere un endpoint HTTPS de Gateway de confianza."}},"ja-JP":{"stringUnit":{"state":"translated","value":"直接モードには、信頼できるHTTPS Gatewayエンドポイントが必要です。"}},"ko":{"stringUnit":{"state":"translated","value":"직접 모드에는 신뢰할 수 있는 HTTPS Gateway 엔드포인트가 필요합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le mode direct nécessite un point de terminaison HTTPS de confiance pour le Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"सीधे मोड के लिए एक विश्वसनीय HTTPS Gateway एंडपॉइंट आवश्यक है."}},"ar":{"stringUnit":{"state":"translated","value":"يتطلب الوضع المباشر نقطة نهاية موثوقة لـ Gateway عبر HTTPS."}},"it":{"stringUnit":{"state":"translated","value":"La modalità diretta richiede un endpoint HTTPS attendibile del Gateway."}},"tr":{"stringUnit":{"state":"translated","value":"Doğrudan mod, güvenilir bir HTTPS Gateway uç noktası gerektirir."}},"uk":{"stringUnit":{"state":"translated","value":"Для прямого режиму потрібна довірена кінцева точка Gateway з HTTPS."}},"id":{"stringUnit":{"state":"translated","value":"Mode langsung memerlukan endpoint Gateway HTTPS tepercaya."}},"pl":{"stringUnit":{"state":"translated","value":"Tryb bezpośredni wymaga zaufanego punktu końcowego HTTPS Gateway."}},"th":{"stringUnit":{"state":"translated","value":"โหมดโดยตรงต้องใช้ปลายทาง Gateway แบบ HTTPS ที่เชื่อถือได้."}},"vi":{"stringUnit":{"state":"translated","value":"Chế độ trực tiếp yêu cầu điểm cuối Gateway HTTPS đáng tin cậy."}},"nl":{"stringUnit":{"state":"translated","value":"Directe modus vereist een vertrouwd HTTPS-eindpunt voor de Gateway."}},"fa":{"stringUnit":{"state":"translated","value":"حالت مستقیم به یک نقطه پایانی HTTPS مورد اعتماد برای Gateway نیاز دارد."}},"ru":{"stringUnit":{"state":"translated","value":"Для прямого режима требуется доверенная конечная точка Gateway с HTTPS."}},"sv":{"stringUnit":{"state":"translated","value":"Direktläge kräver en betrodd HTTPS-slutpunkt för Gateway."}}}},
    "Direct mode supports device info, status, and notifications. Voice is included when you connect from iPhone Settings → Apple Watch. Chat and approvals still use the iPhone.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Direct mode supports device info, status, and notifications. Voice is included when you connect from iPhone Settings → Apple Watch. Chat and approvals still use the iPhone."}},"zh-CN":{"stringUnit":{"state":"translated","value":"直连模式支持设备信息、状态和通知。从 iPhone 的设置 → Apple Watch 连接时，即可使用语音功能。聊天和审批仍需通过 iPhone 进行。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"直接模式支援裝置資訊、狀態和通知。從 iPhone 的設定 → Apple Watch 連線時，即可使用語音功能。聊天和核准仍需透過 iPhone 進行。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O modo direto oferece suporte a informações do dispositivo, status e notificações. A voz é incluída quando você se conecta em Ajustes → Apple Watch no iPhone. O chat e as aprovações continuam usando o iPhone."}},"de":{"stringUnit":{"state":"translated","value":"Der Direktmodus unterstützt Geräteinformationen, Status und Mitteilungen. Die Sprachfunktion ist enthalten, wenn du die Verbindung auf dem iPhone unter Einstellungen → Apple Watch herstellst. Chat und Genehmigungen laufen weiterhin über das iPhone."}},"es":{"stringUnit":{"state":"translated","value":"El modo directo permite consultar la información y el estado del dispositivo y recibir notificaciones. La voz se incluye al conectarte desde Ajustes → Apple Watch en el iPhone. El chat y las aprobaciones siguen usando el iPhone."}},"ja-JP":{"stringUnit":{"state":"translated","value":"直接接続モードでは、デバイス情報、ステータス、通知を利用できます。iPhoneの設定 → Apple Watchから接続すると、音声機能も利用できます。チャットと承認には引き続きiPhoneを使用します。"}},"ko":{"stringUnit":{"state":"translated","value":"직접 연결 모드는 기기 정보, 상태, 알림을 지원합니다. iPhone의 설정 → Apple Watch에서 연결하면 음성 기능이 포함됩니다. 채팅과 승인은 계속 iPhone을 사용합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le mode direct prend en charge les informations sur l’appareil, son état et les notifications. La voix est incluse lorsque vous vous connectez depuis Réglages → Apple Watch sur l’iPhone. Le chat et les approbations passent toujours par l’iPhone."}},"hi":{"stringUnit":{"state":"translated","value":"डायरेक्ट मोड में डिवाइस की जानकारी, स्थिति और सूचनाएँ उपलब्ध हैं। iPhone की सेटिंग्स → Apple Watch से कनेक्ट करने पर वॉइस भी शामिल होती है। चैट और स्वीकृतियों के लिए अब भी iPhone का उपयोग होता है।"}},"ar":{"stringUnit":{"state":"translated","value":"يدعم الوضع المباشر معلومات الجهاز والحالة والإشعارات. يتوفر الصوت عند الاتصال من الإعدادات على iPhone → Apple Watch. ولا تزال الدردشة والموافقات تتم عبر iPhone."}},"it":{"stringUnit":{"state":"translated","value":"La modalità diretta supporta informazioni sul dispositivo, stato e notifiche. La voce è inclusa quando ti connetti da Impostazioni → Apple Watch su iPhone. La chat e le approvazioni continuano a utilizzare l’iPhone."}},"tr":{"stringUnit":{"state":"translated","value":"Doğrudan bağlantı modu; cihaz bilgilerini, durumu ve bildirimleri destekler. iPhone'da Ayarlar → Apple Watch üzerinden bağlandığınızda ses özelliği de dahil edilir. Sohbet ve onaylar hâlâ iPhone'u kullanır."}},"uk":{"stringUnit":{"state":"translated","value":"Прямий режим підтримує інформацію про пристрій, стан і сповіщення. Голосові функції доступні, коли ви підключаєтеся з iPhone через Налаштування → Apple Watch. Чат і підтвердження й надалі використовують iPhone."}},"id":{"stringUnit":{"state":"translated","value":"Mode langsung mendukung info perangkat, status, dan notifikasi. Fitur suara disertakan saat Anda menghubungkan dari Pengaturan iPhone → Apple Watch. Chat dan persetujuan tetap menggunakan iPhone."}},"pl":{"stringUnit":{"state":"translated","value":"Tryb bezpośredni obsługuje informacje o urządzeniu, status i powiadomienia. Obsługa głosu jest dostępna po połączeniu z iPhone’a: Ustawienia → Apple Watch. Czat i zatwierdzanie nadal wymagają iPhone’a."}},"th":{"stringUnit":{"state":"translated","value":"โหมดโดยตรงรองรับข้อมูลอุปกรณ์ สถานะ และการแจ้งเตือน การใช้งานเสียงจะพร้อมใช้งานเมื่อคุณเชื่อมต่อจากการตั้งค่าบน iPhone → Apple Watch การแชทและการอนุมัติยังคงใช้ iPhone"}},"vi":{"stringUnit":{"state":"translated","value":"Chế độ trực tiếp hỗ trợ thông tin thiết bị, trạng thái và thông báo. Tính năng giọng nói được tích hợp khi bạn kết nối từ Cài đặt trên iPhone → Apple Watch. Trò chuyện và phê duyệt vẫn sử dụng iPhone."}},"nl":{"stringUnit":{"state":"translated","value":"De directe modus ondersteunt apparaatinformatie, status en meldingen. Spraak is inbegrepen wanneer je verbinding maakt via Instellingen → Apple Watch op de iPhone. Chat en goedkeuringen verlopen nog steeds via de iPhone."}},"fa":{"stringUnit":{"state":"translated","value":"حالت مستقیم از اطلاعات دستگاه، وضعیت و اعلان‌ها پشتیبانی می‌کند. هنگام اتصال از مسیر Settings → Apple Watch در iPhone، قابلیت صوتی نیز در دسترس قرار می‌گیرد. گفت‌وگو و تأییدها همچنان از iPhone استفاده می‌کنند."}},"ru":{"stringUnit":{"state":"translated","value":"Прямое подключение поддерживает сведения об устройстве, статус и уведомления. Голосовые функции доступны при подключении на iPhone через Настройки → Apple Watch. Для чата и подтверждений по-прежнему используется iPhone."}},"sv":{"stringUnit":{"state":"translated","value":"Direktläget stöder enhetsinformation, status och aviseringar. Röstfunktioner ingår när du ansluter via Inställningar → Apple Watch på iPhone. Chatt och godkännanden hanteras fortfarande via iPhone."}}}},
    "Direct node features": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Direct node features"}},"zh-CN":{"stringUnit":{"state":"translated","value":"直连节点功能"}},"zh-TW":{"stringUnit":{"state":"translated","value":"直接節點功能"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Recursos do nó direto"}},"de":{"stringUnit":{"state":"translated","value":"Direkte Knotenfunktionen"}},"es":{"stringUnit":{"state":"translated","value":"Funciones del nodo directo"}},"ja-JP":{"stringUnit":{"state":"translated","value":"ダイレクトノード機能"}},"ko":{"stringUnit":{"state":"translated","value":"직접 노드 기능"}},"fr":{"stringUnit":{"state":"translated","value":"Fonctionnalités du nœud direct"}},"hi":{"stringUnit":{"state":"translated","value":"डायरेक्ट नोड की सुविधाएँ"}},"ar":{"stringUnit":{"state":"translated","value":"ميزات العقدة المباشرة"}},"it":{"stringUnit":{"state":"translated","value":"Funzionalità del nodo diretto"}},"tr":{"stringUnit":{"state":"translated","value":"Doğrudan düğüm özellikleri"}},"uk":{"stringUnit":{"state":"translated","value":"Функції прямого підключення вузла"}},"id":{"stringUnit":{"state":"translated","value":"Fitur node langsung"}},"pl":{"stringUnit":{"state":"translated","value":"Funkcje węzła w trybie bezpośrednim"}},"th":{"stringUnit":{"state":"translated","value":"ฟีเจอร์โหนดโดยตรง"}},"vi":{"stringUnit":{"state":"translated","value":"Tính năng nút trực tiếp"}},"nl":{"stringUnit":{"state":"translated","value":"Directe nodefuncties"}},"fa":{"stringUnit":{"state":"translated","value":"قابلیت‌های گره مستقیم"}},"ru":{"stringUnit":{"state":"translated","value":"Функции узла в прямом режиме"}},"sv":{"stringUnit":{"state":"translated","value":"Direkta nodfunktioner"}}}},
    "Disabled in the Gateway configuration.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Disabled in the Gateway configuration."}},"zh-CN":{"stringUnit":{"state":"translated","value":"已在 Gateway 配置中禁用。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已在 Gateway 設定中停用。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Desativado na configuração do Gateway."}},"de":{"stringUnit":{"state":"translated","value":"In der Gateway-Konfiguration deaktiviert."}},"es":{"stringUnit":{"state":"translated","value":"Desactivado en la configuración del Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayの設定で無効になっています。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway 구성에서 비활성화되었습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Désactivé dans la configuration du Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway कॉन्फ़िगरेशन में अक्षम है."}},"ar":{"stringUnit":{"state":"translated","value":"معطّل في إعدادات Gateway."}},"it":{"stringUnit":{"state":"translated","value":"Disattivato nella configurazione del Gateway."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway yapılandırmasında devre dışı bırakıldı."}},"uk":{"stringUnit":{"state":"translated","value":"Вимкнено в конфігурації Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Dinonaktifkan dalam konfigurasi Gateway."}},"pl":{"stringUnit":{"state":"translated","value":"Wyłączone w konfiguracji Gateway."}},"th":{"stringUnit":{"state":"translated","value":"ปิดใช้งานในการกำหนดค่า Gateway."}},"vi":{"stringUnit":{"state":"translated","value":"Đã tắt trong cấu hình Gateway."}},"nl":{"stringUnit":{"state":"translated","value":"Uitgeschakeld in de Gateway-configuratie."}},"fa":{"stringUnit":{"state":"translated","value":"در پیکربندی Gateway غیرفعال شده است."}},"ru":{"stringUnit":{"state":"translated","value":"Отключено в конфигурации Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Inaktiverad i Gateway-konfigurationen."}}}},
