    "Sending %@…": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Sending %@…"}},"zh-CN":{"stringUnit":{"state":"translated","value":"正在发送 %@…"}},"zh-TW":{"stringUnit":{"state":"translated","value":"正在傳送 %@…"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Enviando %@…"}},"de":{"stringUnit":{"state":"translated","value":"%@ wird gesendet…"}},"es":{"stringUnit":{"state":"translated","value":"Enviando %@…"}},"ja-JP":{"stringUnit":{"state":"translated","value":"%@を送信中…"}},"ko":{"stringUnit":{"state":"translated","value":"%@ 전송 중…"}},"fr":{"stringUnit":{"state":"translated","value":"Envoi de %@…"}},"hi":{"stringUnit":{"state":"translated","value":"%@ भेजा जा रहा है…"}},"ar":{"stringUnit":{"state":"translated","value":"جارٍ إرسال %@…"}},"it":{"stringUnit":{"state":"translated","value":"Invio di %@…"}},"tr":{"stringUnit":{"state":"translated","value":"%@ gönderiliyor…"}},"uk":{"stringUnit":{"state":"translated","value":"Надсилання %@…"}},"id":{"stringUnit":{"state":"translated","value":"Mengirim %@…"}},"pl":{"stringUnit":{"state":"translated","value":"Wysyłanie %@…"}},"th":{"stringUnit":{"state":"translated","value":"กำลังส่ง %@…"}},"vi":{"stringUnit":{"state":"translated","value":"Đang gửi %@…"}},"nl":{"stringUnit":{"state":"translated","value":"%@ verzenden…"}},"fa":{"stringUnit":{"state":"translated","value":"در حال ارسال %@…"}},"ru":{"stringUnit":{"state":"translated","value":"Отправка %@…"}},"sv":{"stringUnit":{"state":"translated","value":"Skickar %@…"}}}},
    "Sending decision...": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Sending decision..."}},"zh-CN":{"stringUnit":{"state":"translated","value":"正在发送决定..."}},"zh-TW":{"stringUnit":{"state":"translated","value":"正在傳送決定..."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Enviando decisão..."}},"de":{"stringUnit":{"state":"translated","value":"Entscheidung wird gesendet..."}},"es":{"stringUnit":{"state":"translated","value":"Enviando decisión..."}},"ja-JP":{"stringUnit":{"state":"translated","value":"決定を送信中..."}},"ko":{"stringUnit":{"state":"translated","value":"결정 전송 중..."}},"fr":{"stringUnit":{"state":"translated","value":"Envoi de la décision..."}},"hi":{"stringUnit":{"state":"translated","value":"निर्णय भेजा जा रहा है..."}},"ar":{"stringUnit":{"state":"translated","value":"جارٍ إرسال القرار..."}},"it":{"stringUnit":{"state":"translated","value":"Invio della decisione..."}},"tr":{"stringUnit":{"state":"translated","value":"Karar gönderiliyor..."}},"uk":{"stringUnit":{"state":"translated","value":"Надсилання рішення..."}},"id":{"stringUnit":{"state":"translated","value":"Mengirim keputusan..."}},"pl":{"stringUnit":{"state":"translated","value":"Wysyłanie decyzji..."}},"th":{"stringUnit":{"state":"translated","value":"กำลังส่งผลการตัดสินใจ..."}},"vi":{"stringUnit":{"state":"translated","value":"Đang gửi quyết định..."}},"nl":{"stringUnit":{"state":"translated","value":"Beslissing verzenden..."}},"fa":{"stringUnit":{"state":"translated","value":"در حال ارسال تصمیم..."}},"ru":{"stringUnit":{"state":"translated","value":"Отправка решения..."}},"sv":{"stringUnit":{"state":"translated","value":"Skickar beslut..."}}}},
    "Sent with foreground app connections to this gateway. Changes apply on the next reconnect; Share extension delivery is not yet supported.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Sent with foreground app connections to this gateway. Changes apply on the next reconnect; Share extension delivery is not yet supported."}},"zh-CN":{"stringUnit":{"state":"translated","value":"通过前台应用与此 Gateway 的连接发送。更改将在下次重新连接时生效; 尚不支持通过共享扩展发送。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"透過前景 App 與此 Gateway 的連線傳送。變更將在下次重新連線時套用; 目前尚不支援透過分享延伸功能傳送。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Enviado com as conexões do app em primeiro plano a este gateway. As alterações serão aplicadas na próxima reconexão; a entrega pela extensão de compartilhamento ainda não é compatível."}},"de":{"stringUnit":{"state":"translated","value":"Wird über Verbindungen der App im Vordergrund zu diesem Gateway gesendet. Änderungen werden bei der nächsten Verbindung wirksam; die Zustellung über die Teilen-Erweiterung wird noch nicht unterstützt."}},"es":{"stringUnit":{"state":"translated","value":"Se envía mediante las conexiones de la aplicación en primer plano a este Gateway. Los cambios se aplican en la próxima reconexión; el envío mediante la extensión para compartir aún no es compatible."}},"ja-JP":{"stringUnit":{"state":"translated","value":"フォアグラウンドのアプリからこのGatewayへの接続時に送信されます。 変更は次回の再接続時に適用されます; 共有拡張機能による配信にはまだ対応していません。"}},"ko":{"stringUnit":{"state":"translated","value":"이 Gateway에 대한 포그라운드 앱 연결을 통해 전송됩니다. 변경 사항은 다음 재연결 시 적용됩니다; 공유 확장을 통한 전송은 아직 지원되지 않습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Envoyé via les connexions de l’application au premier plan à ce Gateway. Les modifications s’appliqueront à la prochaine reconnexion ; l’envoi via l’extension de partage n’est pas encore pris en charge."}},"hi":{"stringUnit":{"state":"translated","value":"इस Gateway के फ़ोरग्राउंड ऐप कनेक्शन के साथ भेजा जाता है. बदलाव अगले पुनः कनेक्शन पर लागू होंगे; Share एक्सटेंशन के ज़रिए भेजना अभी समर्थित नहीं है."}},"ar":{"stringUnit":{"state":"translated","value":"يُرسل عبر اتصالات التطبيق بهذا Gateway أثناء تشغيله في المقدمة. تُطبَّق التغييرات عند إعادة الاتصال التالية؛ الإرسال عبر ملحق المشاركة غير مدعوم بعد."}},"it":{"stringUnit":{"state":"translated","value":"Inviato tramite le connessioni dell’app in primo piano a questo gateway. Le modifiche si applicano alla prossima riconnessione; l’invio tramite l’estensione di condivisione non è ancora supportato."}},"tr":{"stringUnit":{"state":"translated","value":"Bu Gateway'e ön plandaki uygulama bağlantıları üzerinden gönderilir. Değişiklikler bir sonraki yeniden bağlantıda uygulanır; Paylaş uzantısı üzerinden iletim henüz desteklenmiyor."}},"uk":{"stringUnit":{"state":"translated","value":"Надсилається через з’єднання застосунку на передньому плані з цим Gateway. Зміни набудуть чинності після наступного повторного підключення; доставлення через розширення «Поділитися» ще не підтримується."}},"id":{"stringUnit":{"state":"translated","value":"Dikirim melalui koneksi aplikasi di latar depan ke gateway ini. Perubahan berlaku saat tersambung kembali berikutnya; pengiriman melalui ekstensi Berbagi belum didukung."}},"pl":{"stringUnit":{"state":"translated","value":"Wysyłane przy połączeniach aplikacji działającej na pierwszym planie z tą bramą. Zmiany zostaną zastosowane przy następnym ponownym połączeniu; dostarczanie przez rozszerzenie udostępniania nie jest jeszcze obsługiwane."}},"th":{"stringUnit":{"state":"translated","value":"ส่งผ่านการเชื่อมต่อของแอปที่ทำงานอยู่เบื้องหน้าไปยัง Gateway นี้ การเปลี่ยนแปลงจะมีผลเมื่อเชื่อมต่อใหม่ครั้งถัดไป; ยังไม่รองรับการส่งผ่านส่วนขยายการแชร์"}},"vi":{"stringUnit":{"state":"translated","value":"Được gửi qua các kết nối của ứng dụng ở tiền cảnh tới gateway này. Các thay đổi sẽ áp dụng vào lần kết nối lại tiếp theo; chưa hỗ trợ gửi qua tiện ích Chia sẻ."}},"nl":{"stringUnit":{"state":"translated","value":"Wordt verzonden via appverbindingen op de voorgrond met deze gateway. Wijzigingen worden toegepast bij de volgende verbinding; verzending via de deelextensie wordt nog niet ondersteund."}},"fa":{"stringUnit":{"state":"translated","value":"از طریق اتصال‌های برنامه در پیش‌زمینه به این Gateway ارسال می‌شود. تغییرات در اتصال مجدد بعدی اعمال می‌شوند; ارسال از طریق افزونهٔ اشتراک‌گذاری هنوز پشتیبانی نمی‌شود."}},"ru":{"stringUnit":{"state":"translated","value":"Отправляется при подключении приложения на переднем плане к этому Gateway. Изменения вступят в силу при следующем подключении; доставка через расширение «Поделиться» пока не поддерживается."}},"sv":{"stringUnit":{"state":"translated","value":"Skickas via appanslutningar i förgrunden till denna gateway. Ändringar gäller vid nästa återanslutning; leverans via delningstillägget stöds ännu inte."}}}},
    "Server": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Server"}},"zh-CN":{"stringUnit":{"state":"translated","value":"服务器"}},"zh-TW":{"stringUnit":{"state":"translated","value":"伺服器"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Servidor"}},"de":{"stringUnit":{"state":"new","value":"Server"}},"es":{"stringUnit":{"state":"translated","value":"Servidor"}},"ja-JP":{"stringUnit":{"state":"translated","value":"サーバー"}},"ko":{"stringUnit":{"state":"translated","value":"서버"}},"fr":{"stringUnit":{"state":"translated","value":"Serveur"}},"hi":{"stringUnit":{"state":"translated","value":"सर्वर"}},"ar":{"stringUnit":{"state":"translated","value":"الخادم"}},"it":{"stringUnit":{"state":"new","value":"Server"}},"tr":{"stringUnit":{"state":"translated","value":"Sunucu"}},"uk":{"stringUnit":{"state":"translated","value":"Сервер"}},"id":{"stringUnit":{"state":"new","value":"Server"}},"pl":{"stringUnit":{"state":"translated","value":"Serwer"}},"th":{"stringUnit":{"state":"translated","value":"เซิร์ฟเวอร์"}},"vi":{"stringUnit":{"state":"translated","value":"Máy chủ"}},"nl":{"stringUnit":{"state":"new","value":"Server"}},"fa":{"stringUnit":{"state":"translated","value":"سرور"}},"ru":{"stringUnit":{"state":"translated","value":"Сервер"}},"sv":{"stringUnit":{"state":"new","value":"Server"}}}},
    "Session capability controls require a newer Gateway.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Session capability controls require a newer Gateway."}},"zh-CN":{"stringUnit":{"state":"translated","value":"会话能力控制需要更新版本的 Gateway。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"工作階段能力控制需要較新版本的 Gateway。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Os controles de recursos da sessão exigem um Gateway mais recente."}},"de":{"stringUnit":{"state":"translated","value":"Die Steuerung der Sitzungsfunktionen erfordert einen neueren Gateway."}},"es":{"stringUnit":{"state":"translated","value":"Los controles de capacidades de la sesión requieren una versión más reciente de Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"セッションの機能を制御するには、より新しいGatewayが必要です。"}},"ko":{"stringUnit":{"state":"translated","value":"세션 기능 제어에는 최신 버전의 Gateway가 필요합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les contrôles des capacités de la session nécessitent une version plus récente de Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"सत्र की क्षमता संबंधी नियंत्रणों के लिए Gateway का नया संस्करण आवश्यक है."}},"ar":{"stringUnit":{"state":"translated","value":"تتطلب عناصر التحكم في إمكانات الجلسة إصدارًا أحدث من Gateway."}},"it":{"stringUnit":{"state":"translated","value":"I controlli delle funzionalità della sessione richiedono un Gateway più recente."}},"tr":{"stringUnit":{"state":"translated","value":"Oturum yetenek denetimleri için daha yeni bir Gateway gerekir."}},"uk":{"stringUnit":{"state":"translated","value":"Для керування можливостями сеансу потрібна новіша версія Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Kontrol kapabilitas sesi memerlukan Gateway yang lebih baru."}},"pl":{"stringUnit":{"state":"translated","value":"Zarządzanie możliwościami sesji wymaga nowszej wersji Gateway."}},"th":{"stringUnit":{"state":"translated","value":"การควบคุมความสามารถของเซสชันต้องใช้ Gateway เวอร์ชันใหม่กว่า"}},"vi":{"stringUnit":{"state":"translated","value":"Các tùy chọn kiểm soát khả năng của phiên yêu cầu Gateway mới hơn."}},"nl":{"stringUnit":{"state":"translated","value":"Instellingen voor sessiemogelijkheden vereisen een nieuwere Gateway."}},"fa":{"stringUnit":{"state":"translated","value":"کنترل‌های قابلیت نشست به نسخهٔ جدیدتری از Gateway نیاز دارند."}},"ru":{"stringUnit":{"state":"translated","value":"Для управления возможностями сеанса требуется более новая версия Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Kontroller för sessionsfunktioner kräver en nyare Gateway."}}}},
    "Session color": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Session color"}},"zh-CN":{"stringUnit":{"state":"translated","value":"会话颜色"}},"zh-TW":{"stringUnit":{"state":"translated","value":"工作階段顏色"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Cor da sessão"}},"de":{"stringUnit":{"state":"translated","value":"Sitzungsfarbe"}},"es":{"stringUnit":{"state":"translated","value":"Color de la sesión"}},"ja-JP":{"stringUnit":{"state":"translated","value":"セッションの色"}},"ko":{"stringUnit":{"state":"translated","value":"세션 색상"}},"fr":{"stringUnit":{"state":"translated","value":"Couleur de la session"}},"hi":{"stringUnit":{"state":"translated","value":"सत्र का रंग"}},"ar":{"stringUnit":{"state":"translated","value":"لون الجلسة"}},"it":{"stringUnit":{"state":"translated","value":"Colore della sessione"}},"tr":{"stringUnit":{"state":"translated","value":"Oturum rengi"}},"uk":{"stringUnit":{"state":"translated","value":"Колір сеансу"}},"id":{"stringUnit":{"state":"translated","value":"Warna sesi"}},"pl":{"stringUnit":{"state":"translated","value":"Kolor sesji"}},"th":{"stringUnit":{"state":"translated","value":"สีเซสชัน"}},"vi":{"stringUnit":{"state":"translated","value":"Màu phiên"}},"nl":{"stringUnit":{"state":"translated","value":"Sessiekleur"}},"fa":{"stringUnit":{"state":"translated","value":"رنگ نشست"}},"ru":{"stringUnit":{"state":"translated","value":"Цвет сеанса"}},"sv":{"stringUnit":{"state":"translated","value":"Sessionsfärg"}}}},
    "Session name": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Session name"}},"zh-CN":{"stringUnit":{"state":"translated","value":"会话名称"}},"zh-TW":{"stringUnit":{"state":"translated","value":"工作階段名稱"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Nome da sessão"}},"de":{"stringUnit":{"state":"translated","value":"Sitzungsname"}},"es":{"stringUnit":{"state":"translated","value":"Nombre de la sesión"}},"ja-JP":{"stringUnit":{"state":"translated","value":"セッション名"}},"ko":{"stringUnit":{"state":"translated","value":"세션 이름"}},"fr":{"stringUnit":{"state":"translated","value":"Nom de la session"}},"hi":{"stringUnit":{"state":"translated","value":"सत्र का नाम"}},"ar":{"stringUnit":{"state":"translated","value":"اسم الجلسة"}},"it":{"stringUnit":{"state":"translated","value":"Nome della sessione"}},"tr":{"stringUnit":{"state":"translated","value":"Oturum adı"}},"uk":{"stringUnit":{"state":"translated","value":"Назва сеансу"}},"id":{"stringUnit":{"state":"translated","value":"Nama sesi"}},"pl":{"stringUnit":{"state":"translated","value":"Nazwa sesji"}},"th":{"stringUnit":{"state":"translated","value":"ชื่อเซสชัน"}},"vi":{"stringUnit":{"state":"translated","value":"Tên phiên"}},"nl":{"stringUnit":{"state":"translated","value":"Sessienaam"}},"fa":{"stringUnit":{"state":"translated","value":"نام نشست"}},"ru":{"stringUnit":{"state":"translated","value":"Название сеанса"}},"sv":{"stringUnit":{"state":"translated","value":"Sessionsnamn"}}}},
    "Session permission controls require a newer Gateway.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Session permission controls require a newer Gateway."}},"zh-CN":{"stringUnit":{"state":"translated","value":"会话权限控制需要更新版本的 Gateway。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"工作階段權限控制需要較新版本的 Gateway。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Os controles de permissões da sessão exigem um Gateway mais recente."}},"de":{"stringUnit":{"state":"translated","value":"Die Steuerung der Sitzungsberechtigungen erfordert einen neueren Gateway."}},"es":{"stringUnit":{"state":"translated","value":"Los controles de permisos de la sesión requieren una versión más reciente de Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"セッションの権限を制御するには、より新しいGatewayが必要です。"}},"ko":{"stringUnit":{"state":"translated","value":"세션 권한 제어에는 최신 버전의 Gateway가 필요합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les contrôles des autorisations de la session nécessitent une version plus récente de Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"सत्र की अनुमति संबंधी नियंत्रणों के लिए Gateway का नया संस्करण आवश्यक है."}},"ar":{"stringUnit":{"state":"translated","value":"تتطلب عناصر التحكم في أذونات الجلسة إصدارًا أحدث من Gateway."}},"it":{"stringUnit":{"state":"translated","value":"I controlli delle autorizzazioni della sessione richiedono un Gateway più recente."}},"tr":{"stringUnit":{"state":"translated","value":"Oturum izin denetimleri için daha yeni bir Gateway gerekir."}},"uk":{"stringUnit":{"state":"translated","value":"Для керування дозволами сеансу потрібна новіша версія Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Kontrol izin sesi memerlukan Gateway yang lebih baru."}},"pl":{"stringUnit":{"state":"translated","value":"Zarządzanie uprawnieniami sesji wymaga nowszej wersji Gateway."}},"th":{"stringUnit":{"state":"translated","value":"การควบคุมสิทธิ์ของเซสชันต้องใช้ Gateway เวอร์ชันใหม่กว่า"}},"vi":{"stringUnit":{"state":"translated","value":"Các tùy chọn kiểm soát quyền của phiên yêu cầu Gateway mới hơn."}},"nl":{"stringUnit":{"state":"translated","value":"Instellingen voor sessiemachtigingen vereisen een nieuwere Gateway."}},"fa":{"stringUnit":{"state":"translated","value":"کنترل‌های مجوز نشست به نسخهٔ جدیدتری از Gateway نیاز دارند."}},"ru":{"stringUnit":{"state":"translated","value":"Для управления разрешениями сеанса требуется более новая версия Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Kontroller för sessionsbehörigheter kräver en nyare Gateway."}}}},
