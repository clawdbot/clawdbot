    "Your agent, in your pocket. Pair this iPhone with your gateway to get started.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your agent, in your pocket. Pair this iPhone with your gateway to get started."}},"zh-CN":{"stringUnit":{"state":"translated","value":"你的随身智能体。将这台 iPhone 与你的 Gateway 配对即可开始使用。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"你的代理，隨身相伴。將這部 iPhone 與你的閘道配對，即可開始使用。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Seu agente, no seu bolso. Emparelhe este iPhone com seu gateway para começar."}},"de":{"stringUnit":{"state":"translated","value":"Dein Agent, in deiner Tasche. Kopple dieses iPhone mit deinem Gateway, um loszulegen."}},"es":{"stringUnit":{"state":"translated","value":"Tu agente, en tu bolsillo. Vincula este iPhone con tu Gateway para empezar."}},"ja-JP":{"stringUnit":{"state":"translated","value":"あなたのエージェントをポケットに。この iPhone をゲートウェイとペアリングして始めましょう。"}},"ko":{"stringUnit":{"state":"translated","value":"주머니 속 나만의 에이전트. 시작하려면 이 iPhone을 Gateway와 페어링하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Votre agent, dans votre poche. Associez cet iPhone à votre passerelle pour commencer."}},"hi":{"stringUnit":{"state":"translated","value":"आपका एजेंट, आपकी जेब में. शुरू करने के लिए इस iPhone को अपने Gateway से पेयर करें."}},"ar":{"stringUnit":{"state":"translated","value":"وكيلك، في جيبك. أقرن جهاز iPhone هذا مع Gateway الخاص بك للبدء."}},"it":{"stringUnit":{"state":"translated","value":"Il tuo agente, in tasca. Abbina questo iPhone al tuo gateway per iniziare."}},"tr":{"stringUnit":{"state":"translated","value":"Ajanınız cebinizde. Başlamak için bu iPhone'u ağ geçidinizle eşleştirin."}},"uk":{"stringUnit":{"state":"translated","value":"Ваш агент у вашій кишені. Щоб почати, створіть пару між цим iPhone і вашим Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Agen Anda, di saku Anda. Pasangkan iPhone ini dengan gateway Anda untuk memulai."}},"pl":{"stringUnit":{"state":"translated","value":"Twój agent, w Twojej kieszeni. Aby rozpocząć, sparuj tego iPhone'a ze swoim Gateway."}},"th":{"stringUnit":{"state":"translated","value":"เอเจนต์ของคุณในกระเป๋า จับคู่ iPhone เครื่องนี้กับเกตเวย์ของคุณเพื่อเริ่มต้นใช้งาน."}},"vi":{"stringUnit":{"state":"translated","value":"Tác nhân của bạn, ngay trong túi bạn. Ghép đôi iPhone này với gateway của bạn để bắt đầu."}},"nl":{"stringUnit":{"state":"translated","value":"Je agent, in je broekzak. Koppel deze iPhone aan je gateway om aan de slag te gaan."}},"fa":{"stringUnit":{"state":"translated","value":"عامل شما، در جیب شما. برای شروع، این iPhone را با Gateway خود جفت کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Ваш агент у вас в кармане. Чтобы начать, свяжите этот iPhone с вашим Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Din agent, i fickan. Parkoppla denna iPhone med din gateway för att komma igång."}}}},
