    "Choose a location mode to request iOS permission.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose a location mode to request iOS permission."}},"zh-CN":{"stringUnit":{"state":"translated","value":"选择定位模式以请求 iOS 权限。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"選擇定位模式以要求 iOS 權限。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolha um modo de localização para solicitar a permissão do iOS."}},"de":{"stringUnit":{"state":"translated","value":"Wählen Sie einen Standortmodus, um die iOS-Berechtigung anzufordern."}},"es":{"stringUnit":{"state":"translated","value":"Elige un modo de ubicación para solicitar permiso a iOS."}},"ja-JP":{"stringUnit":{"state":"translated","value":"iOSの権限をリクエストするには、位置情報モードを選択してください。"}},"ko":{"stringUnit":{"state":"translated","value":"iOS 권한을 요청하려면 위치 모드를 선택하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez un mode de localisation pour demander l’autorisation iOS."}},"hi":{"stringUnit":{"state":"translated","value":"iOS की अनुमति का अनुरोध करने के लिए लोकेशन मोड चुनें."}},"ar":{"stringUnit":{"state":"translated","value":"اختر وضعًا للموقع لطلب الإذن من iOS."}},"it":{"stringUnit":{"state":"translated","value":"Scegli una modalità di localizzazione per richiedere l'autorizzazione di iOS."}},"tr":{"stringUnit":{"state":"translated","value":"iOS izni istemek için bir konum modu seçin."}},"uk":{"stringUnit":{"state":"translated","value":"Виберіть режим геолокації, щоб надіслати запит на дозвіл в iOS."}},"id":{"stringUnit":{"state":"translated","value":"Pilih mode lokasi untuk meminta izin iOS."}},"pl":{"stringUnit":{"state":"translated","value":"Wybierz tryb lokalizacji, aby poprosić o uprawnienia w iOS."}},"th":{"stringUnit":{"state":"translated","value":"เลือกโหมดตำแหน่งที่ตั้งเพื่อขอสิทธิ์จาก iOS."}},"vi":{"stringUnit":{"state":"translated","value":"Chọn chế độ vị trí để yêu cầu quyền trên iOS."}},"nl":{"stringUnit":{"state":"translated","value":"Kies een locatiemodus om iOS-