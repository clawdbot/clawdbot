    "Default Agent": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Default Agent"}},"zh-CN":{"stringUnit":{"state":"translated","value":"默认智能体"}},"zh-TW":{"stringUnit":{"state":"translated","value":"預設代理程式"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Agente Padrão"}},"de":{"stringUnit":{"state":"translated","value":"Standardagent"}},"es":{"stringUnit":{"state":"translated","value":"Agente Predeterminado"}},"ja-JP":{"stringUnit":{"state":"translated","value":"デフォルトのエージェント"}},"ko":{"stringUnit":{"state":"translated","value":"기본 에이전트"}},"fr":{"stringUnit":{"state":"translated","value":"Agent par défaut"}},"hi":{"stringUnit":{"state":"translated","value":"डिफ़ॉल्ट एजेंट"}},"ar":{"stringUnit":{"state":"translated","value":"الوكيل الافتراضي"}},"it":{"stringUnit":{"state":"translated","value":"Agente predefinito"}},"tr":{"stringUnit":{"state":"translated","value":"Varsayılan Ajan"}},"uk":{"stringUnit":{"state":"translated","value":"Агент за замовчуванням"}},"id":{"stringUnit":{"state":"translated","value":"Agen Bawaan"}},"pl":{"stringUnit":{"state":"translated","value":"Domyślny Agent"}},"th":{"stringUnit":{"state":"translated","value":"เอเจนต์เริ่มต้น"}},"vi":{"stringUnit":{"state":"translated","value":"Tác nhân mặc định"}},"nl":{"stringUnit":{"state":"translated","value":"Standaardagent"}},"fa":{"stringUnit":{"state":"translated","value":"عامل پیش‌فرض"}},"ru":{"stringUnit":{"state":"translated","value":"Агент по умолчанию"}},"sv":{"stringUnit":{"state":"translated","value":"Standardagent"}}}},
    "Default host is localhost. Use your Mac LAN IP if simulator networking requires it.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Default host is localhost. Use your Mac LAN IP if simulator networking requires it."}},"zh-CN":{"stringUnit":{"state":"translated","value":"默认主机为 localhost。如果模拟器网络需要，请使用 Mac 的局域网 IP。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"預設主機為 localhost。若模擬器網路需要，請使用 Mac 的區域網路 IP。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O host padrão é localhost. Use o IP do seu Mac na rede local se a configuração de rede do simulador exigir."}},"de":{"stringUnit":{"state":"translated","value":"Der Standardhost ist localhost. Verwenden Sie die LAN-IP Ihres Mac, wenn die Netzwerkanbindung des Simulators dies erfordert."}},"es":{"stringUnit":{"state":"translated","value":"El host predeterminado es localhost. Usa la IP de tu Mac en la LAN si la conexión de red del simulador lo requiere."}},"ja-JP":{"stringUnit":{"state":"translated","value":"デフォルトのホストはlocalhostです。 シミュレータのネットワーク接続で必要な場合は、MacのLAN IPを使用してください。"}},"ko":{"stringUnit":{"state":"translated","value":"기본 호스트는 localhost입니다. 시뮬레이터 네트워킹에 필요한 경우 Mac의 LAN IP를 사용하세요."}},"fr":{"stringUnit":{"state":"translated","value":"L’hôte par défaut est localhost. Utilisez l’adresse IP de votre Mac sur le réseau local si la configuration réseau du simulateur l’exige."}},"hi":{"stringUnit":{"state":"translated","value":"डिफ़ॉल्ट होस्ट localhost है। यदि सिम्युलेटर नेटवर्किंग के लिए आवश्यक हो, तो अपने Mac का LAN IP इस्तेमाल करें।"}},"ar":{"stringUnit":{"state":"translated","value":"المضيف الافتراضي هو localhost. استخدم عنوان IP لجهاز Mac على الشبكة المحلية إذا تطلبت شبكة المحاكي ذلك."}},"it":{"stringUnit":{"state":"translated","value":"L'host predefinito è localhost. Usa l'indirizzo IP LAN del tuo Mac se la rete del simulatore lo richiede."}},"tr":{"stringUnit":{"state":"translated","value":"Varsayılan ana makine localhost'tur. Simülatör ağı gerektiriyorsa Mac'inizin LAN IP adresini kullanın."}},"uk":{"stringUnit":{"state":"translated","value":"Хост за замовчуванням — localhost. Використовуйте IP-адресу вашого Mac у локальній мережі, якщо цього потребує мережеве підключення симулятора."}},"id":{"stringUnit":{"state":"translated","value":"Host bawaan adalah localhost. Gunakan IP LAN Mac Anda jika jaringan simulator memerlukannya."}},"pl":{"stringUnit":{"state":"translated","value":"Domyślny host to localhost. Użyj adresu IP Maca w sieci LAN, jeśli wymaga tego sieć symulatora."}},"th":{"stringUnit":{"state":"translated","value":"โฮสต์เริ่มต้นคือ localhost. ใช้ IP บนเครือข่าย LAN ของ Mac หากเครือข่ายของโปรแกรมจำลองต้องใช้."}},"vi":{"stringUnit":{"state":"translated","value":"Máy chủ mặc định là localhost. Sử dụng IP LAN của máy Mac nếu kết nối mạng của trình mô phỏng yêu cầu."}},"nl":{"stringUnit":{"state":"translated","value":"De standaardhost is localhost. Gebruik het LAN-IP-adres van je Mac als de netwerkinstellingen van de simulator dit vereisen."}},"fa":{"stringUnit":{"state":"translated","value":"میزبان پیش‌فرض localhost است. اگر شبکهٔ شبیه‌ساز به آن نیاز دارد، از نشانی IP شبکهٔ محلی Mac خود استفاده کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Хост по умолчанию — localhost. Используйте IP-адрес вашего Mac в локальной сети, если этого требуют сетевые настройки симулятора."}},"sv":{"stringUnit":{"state":"translated","value":"Standardvärden är localhost. Använd din Macs IP-adress i det lokala nätverket om simulatorns nätverksanslutning kräver det."}}}},
