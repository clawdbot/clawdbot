    "Usage": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Usage"}},"zh-CN":{"stringUnit":{"state":"translated","value":"用量"}},"zh-TW":{"stringUnit":{"state":"translated","value":"用量"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Uso"}},"de":{"stringUnit":{"state":"translated","value":"Nutzung"}},"es":{"stringUnit":{"state":"translated","value":"Uso"}},"ja-JP":{"stringUnit":{"state":"translated","value":"使用状況"}},"ko":{"stringUnit":{"state":"translated","value":"사용량"}},"fr":{"stringUnit":{"state":"translated","value":"Utilisation"}},"hi":{"stringUnit":{"state":"translated","value":"उपयोग"}},"ar":{"stringUnit":{"state":"translated","value":"الاستخدام"}},"it":{"stringUnit":{"state":"translated","value":"Utilizzo"}},"tr":{"stringUnit":{"state":"translated","value":"Kullanım"}},"uk":{"stringUnit":{"state":"translated","value":"Використання"}},"id":{"stringUnit":{"state":"translated","value":"Penggunaan"}},"pl":{"stringUnit":{"state":"translated","value":"Użycie"}},"th":{"stringUnit":{"state":"translated","value":"การใช้งาน"}},"vi":{"stringUnit":{"state":"translated","value":"Mức sử dụng"}},"nl":{"stringUnit":{"state":"translated","value":"Gebruik"}},"fa":{"stringUnit":{"state":"translated","value":"میزان مصرف"}},"ru":{"stringUnit":{"state":"translated","value":"Использование"}},"sv":{"stringUnit":{"state":"translated","value":"Användning"}}}},
    "Use Manual Gateway": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use Manual Gateway"}},"zh-CN":{"stringUnit":{"state":"translated","value":"使用手动配置的 Gateway"}},"zh-TW":{"stringUnit":{"state":"translated","value":"使用手動設定的 Gateway"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Usar Gateway Manual"}},"de":{"stringUnit":{"state":"translated","value":"Manuellen Gateway verwenden"}},"es":{"stringUnit":{"state":"translated","value":"Usar Gateway manual"}},"ja-JP":{"stringUnit":{"state":"translated","value":"手動設定の Gateway を使用"}},"ko":{"stringUnit":{"state":"translated","value":"수동 Gateway 사용"}},"fr":{"stringUnit":{"state":"translated","value":"Utiliser un Gateway manuel"}},"hi":{"stringUnit":{"state":"translated","value":"मैन्युअल Gateway का उपयोग करें"}},"ar":{"stringUnit":{"state":"translated","value":"استخدام Gateway يدوي"}},"it":{"stringUnit":{"state":"translated","value":"Usa un Gateway manuale"}},"tr":{"stringUnit":{"state":"translated","value":"Manuel Gateway Kullan"}},"uk":{"stringUnit":{"state":"translated","value":"Використовувати Gateway із ручним налаштуванням"}},"id":{"stringUnit":{"state":"translated","value":"Gunakan Gateway Manual"}},"pl":{"stringUnit":{"state":"translated","value":"Użyj ręcznie skonfigurowanego Gateway"}},"th":{"stringUnit":{"state":"translated","value":"ใช้ Gateway ที่กำหนดเอง"}},"vi":{"stringUnit":{"state":"translated","value":"Sử dụng Gateway thủ công"}},"nl":{"stringUnit":{"state":"translated","value":"Handmatige Gateway gebruiken"}},"fa":{"stringUnit":{"state":"translated","value":"استفاده از Gateway دستی"}},"ru":{"stringUnit":{"state":"translated","value":"Использовать Gateway, указанный вручную"}},"sv":{"stringUnit":{"state":"translated","value":"Använd manuell Gateway"}}}},
    "Use Manual Setup": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use Manual Setup"}},"zh-CN":{"stringUnit":{"state":"translated","value":"使用手动设置"}},"zh-TW":{"stringUnit":{"state":"translated","value":"使用手動設定"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Usar configuração manual"}},"de":{"stringUnit":{"state":"translated","value":"Manuelle Einrichtung verwenden"}},"es":{"stringUnit":{"state":"translated","value":"Usar configuración manual"}},"ja-JP":{"stringUnit":{"state":"translated","value":"手動セットアップを使用"}},"ko":{"stringUnit":{"state":"translated","value":"수동 설정 사용"}},"fr":{"stringUnit":{"state":"translated","value":"Utiliser la configuration manuelle"}},"hi":{"stringUnit":{"state":"translated","value":"मैन्युअल सेटअप का उपयोग करें"}},"ar":{"stringUnit":{"state":"translated","value":"استخدام الإعداد اليدوي"}},"it":{"stringUnit":{"state":"translated","value":"Usa configurazione manuale"}},"tr":{"stringUnit":{"state":"translated","value":"Manuel Kurulum Kullan"}},"uk":{"stringUnit":{"state":"translated","value":"Використовувати ручне налаштування"}},"id":{"stringUnit":{"state":"translated","value":"Gunakan Pengaturan Manual"}},"pl":{"stringUnit":{"state":"translated","value":"Użyj konfiguracji ręcznej"}},"th":{"stringUnit":{"state":"translated","value":"ใช้การตั้งค่าด้วยตนเอง"}},"vi":{"stringUnit":{"state":"translated","value":"Sử dụng thiết lập thủ công"}},"nl":{"stringUnit":{"state":"translated","value":"Handmatige configuratie gebruiken"}},"fa":{"stringUnit":{"state":"translated","value":"استفاده از راه‌اندازی دستی"}},"ru":{"stringUnit":{"state":"translated","value":"Использовать ручную настройку"}},"sv":{"stringUnit":{"state":"translated","value":"Använd manuell konfiguration"}}}},
    "Use a secure wss:// or Tailscale Serve Gateway, then scan a full-access setup code from the Control UI or openclaw qr and reconnect to enable settings and upgrades.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use a secure wss:// or Tailscale Serve Gateway, then scan a full-access setup code from the Control UI or openclaw qr and reconnect to enable settings and upgrades."}},"zh-CN":{"stringUnit":{"state":"translated","value":"使用安全的 wss:// 或 Tailscale Serve Gateway，然后扫描来自 Control UI 或 openclaw qr 的完整访问权限设置码，并重新连接以启用设置和升级。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"使用安全的 wss:// 或 Tailscale Serve Gateway，然後掃描來自 Control UI 或 openclaw qr 的完整存取權設定碼，並重新連線以啟用設定與升級功能。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Use um Gateway seguro com wss:// ou Tailscale Serve, depois escaneie um código de configuração com acesso total da Control UI ou de openclaw qr e reconecte para habilitar configurações e atualizações."}},"de":{"stringUnit":{"state":"translated","value":"Verwenden Sie einen sicheren wss://- oder Tailscale Serve-Gateway, scannen Sie dann einen Einrichtungscode mit Vollzugriff aus der Control UI oder von openclaw qr und verbinden Sie sich erneut, um Einstellungen und Upgrades zu aktivieren."}},"es":{"stringUnit":{"state":"translated","value":"Usa un Gateway seguro con wss:// o Tailscale Serve, luego escanea un código de configuración con acceso completo desde Control UI u openclaw qr y vuelve a conectarte para habilitar los ajustes y las actualizaciones."}},"ja-JP":{"stringUnit":{"state":"translated","value":"安全な wss:// または Tailscale Serve の Gateway を使用し、Control UI または openclaw qr からフルアクセスのセットアップコードをスキャンして再接続すると、設定とアップグレードが有効になります。"}},"ko":{"stringUnit":{"state":"translated","value":"보안 wss:// 또는 Tailscale Serve Gateway를 사용한 다음, Control UI 또는 openclaw qr에서 전체 접근 권한 설정 코드를 스캔하고 다시 연결하여 설정 및 업그레이드를 활성화하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Utilisez un Gateway sécurisé via wss:// ou Tailscale Serve, puis scannez un code de configuration avec accès complet depuis Control UI ou openclaw qr et reconnectez-vous pour activer les paramètres et les mises à niveau."}},"hi":{"stringUnit":{"state":"translated","value":"सुरक्षित wss:// या Tailscale Serve Gateway का उपयोग करें, फिर Control UI या openclaw qr से पूर्ण पहुँच वाला सेटअप कोड स्कैन करें और सेटिंग्स व अपग्रेड सक्षम करने के लिए दोबारा कनेक्ट करें।"}},"ar":{"stringUnit":{"state":"translated","value":"استخدم Gateway آمنًا عبر wss:// أو Tailscale Serve، ثم امسح رمز إعداد يمنح وصولًا كاملًا من Control UI أو openclaw qr وأعد الاتصال لتمكين الإعدادات والترقيات."}},"it":{"stringUnit":{"state":"translated","value":"Usa un Gateway sicuro tramite wss:// o Tailscale Serve, quindi scansiona un codice di configurazione con accesso completo dalla Control UI o da openclaw qr e riconnettiti per abilitare le impostazioni e gli aggiornamenti."}},"tr":{"stringUnit":{"state":"translated","value":"Güvenli bir wss:// veya Tailscale Serve Gateway kullanın, ardından ayarları ve yükseltmeleri etkinleştirmek için Control UI veya openclaw qr üzerinden tam erişimli bir kurulum kodu tarayın ve yeniden bağlanın."}},"uk":{"stringUnit":{"state":"translated","value":"Використовуйте захищений Gateway через wss:// або Tailscale Serve, потім відскануйте код налаштування з повним доступом із Control UI або openclaw qr і підключіться знову, щоб увімкнути налаштування та оновлення."}},"id":{"stringUnit":{"state":"translated","value":"Gunakan Gateway wss:// yang aman atau Tailscale Serve, lalu pindai kode pengaturan akses penuh dari Control UI atau openclaw qr dan sambungkan kembali untuk mengaktifkan pengaturan dan peningkatan."}},"pl":{"stringUnit":{"state":"translated","value":"Użyj bezpiecznego Gateway przez wss:// lub Tailscale Serve, a następnie zeskanuj kod konfiguracji pełnego dostępu z Control UI lub openclaw qr i połącz się ponownie, aby włączyć ustawienia i aktualizacje."}},"th":{"stringUnit":{"state":"translated","value":"ใช้ Gateway ที่ปลอดภัยผ่าน wss:// หรือ Tailscale Serve แล้วสแกนรหัสตั้งค่าที่มีสิทธิ์เข้าถึงเต็มรูปแบบจาก Control UI หรือ openclaw qr และเชื่อมต่อใหม่เพื่อเปิดใช้งานการตั้งค่าและการอัปเกรด"}},"vi":{"stringUnit":{"state":"translated","value":"Sử dụng Gateway bảo mật qua wss:// hoặc Tailscale Serve, sau đó quét mã thiết lập có toàn quyền truy cập từ Control UI hoặc openclaw qr và kết nối lại để bật cài đặt và nâng cấp."}},"nl":{"stringUnit":{"state":"translated","value":"Gebruik een beveiligde wss://- of Tailscale Serve Gateway, scan vervolgens een configuratiecode voor volledige toegang vanuit de Control UI of openclaw qr en maak opnieuw verbinding om instellingen en upgrades in te schakelen."}},"fa":{"stringUnit":{"state":"translated","value":"از یک Gateway امن با wss:// یا Tailscale Serve استفاده کنید، سپس یک کد راه‌اندازی با دسترسی کامل را از Control UI یا openclaw qr اسکن کنید و دوباره متصل شوید تا تنظیمات و ارتقاها فعال شوند."}},"ru":{"stringUnit":{"state":"translated","value":"Используйте защищённый Gateway через wss:// или Tailscale Serve, затем отсканируйте код настройки с полным доступом из Control UI или openclaw qr и подключитесь заново, чтобы включить настройки и обновления."}},"sv":{"stringUnit":{"state":"translated","value":"Använd en säker Gateway via wss:// eller Tailscale Serve, skanna sedan en konfigurationskod för full åtkomst från Control UI eller openclaw qr och anslut igen för att aktivera inställningar och uppgraderingar."}}}},
    "Use default": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use default"}},"zh-CN":{"stringUnit":{"state":"translated","value":"使用默认值"}},"zh-TW":{"stringUnit":{"state":"translated","value":"使用預設值"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Usar padrão"}},"de":{"stringUnit":{"state":"translated","value":"Standard verwenden"}},"es":{"stringUnit":{"state":"translated","value":"Usar valor predeterminado"}},"ja-JP":{"stringUnit":{"state":"translated","value":"デフォルトを使用"}},"ko":{"stringUnit":{"state":"translated","value":"기본값 사용"}},"fr":{"stringUnit":{"state":"translated","value":"Utiliser la valeur par défaut"}},"hi":{"stringUnit":{"state":"translated","value":"डिफ़ॉल्ट का उपयोग करें"}},"ar":{"stringUnit":{"state":"translated","value":"استخدام الإعداد الافتراضي"}},"it":{"stringUnit":{"state":"translated","value":"Usa il valore predefinito"}},"tr":{"stringUnit":{"state":"translated","value":"Varsayılanı kullan"}},"uk":{"stringUnit":{"state":"translated","value":"Використовувати типове значення"}},"id":{"stringUnit":{"state":"translated","value":"Gunakan default"}},"pl":{"stringUnit":{"state":"translated","value":"Użyj domyślnej"}},"th":{"stringUnit":{"state":"translated","value":"ใช้ค่าเริ่มต้น"}},"vi":{"stringUnit":{"state":"translated","value":"Sử dụng mặc định"}},"nl":{"stringUnit":{"state":"translated","value":"Standaard gebruiken"}},"fa":{"stringUnit":{"state":"translated","value":"استفاده از پیش‌فرض"}},"ru":{"stringUnit":{"state":"translated","value":"Использовать значение по умолчанию"}},"sv":{"stringUnit":{"state":"translated","value":"Använd standard"}}}},
    "Use iPhone Settings to enable direct connection.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use iPhone Settings to enable direct connection."}},"zh-CN":{"stringUnit":{"state":"translated","value":"在 iPhone 设置中启用直接连接。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"使用 iPhone 設定來啟用直接連線。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Use os Ajustes do iPhone para habilitar a conexão direta."}},"de":{"stringUnit":{"state":"translated","value":"Aktivieren Sie die direkte Verbindung in den iPhone-Einstellungen."}},"es":{"stringUnit":{"state":"translated","value":"Usa Ajustes del iPhone para habilitar la conexión directa."}},"ja-JP":{"stringUnit":{"state":"translated","value":"直接接続を有効にするには、iPhone の設定を使用してください。"}},"ko":{"stringUnit":{"state":"translated","value":"iPhone 설정에서 직접 연결을 활성화하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Utilisez les réglages de l’iPhone pour activer la connexion directe."}},"hi":{"stringUnit":{"state":"translated","value":"सीधा कनेक्शन सक्षम करने के लिए iPhone की सेटिंग्स का उपयोग करें।"}},"ar":{"stringUnit":{"state":"translated","value":"استخدم إعدادات iPhone لتمكين الاتصال المباشر."}},"it":{"stringUnit":{"state":"translated","value":"Usa le Impostazioni di iPhone per abilitare la connessione diretta."}},"tr":{"stringUnit":{"state":"translated","value":"Doğrudan bağlantıyı etkinleştirmek için iPhone Ayarlar uygulamasını kullanın."}},"uk":{"stringUnit":{"state":"translated","value":"Увімкніть пряме підключення в Параметрах iPhone."}},"id":{"stringUnit":{"state":"translated","value":"Gunakan Pengaturan iPhone untuk mengaktifkan koneksi langsung."}},"pl":{"stringUnit":{"state":"translated","value":"Użyj Ustawień iPhone’a, aby włączyć połączenie bezpośrednie."}},"th":{"stringUnit":{"state":"translated","value":"ใช้การตั้งค่า iPhone เพื่อเปิดใช้งานการเชื่อมต่อโดยตรง"}},"vi":{"stringUnit":{"state":"translated","value":"Sử dụng Cài đặt trên iPhone để bật kết nối trực tiếp."}},"nl":{"stringUnit":{"state":"translated","value":"Gebruik de instellingen van je iPhone om directe verbinding in te schakelen."}},"fa":{"stringUnit":{"state":"translated","value":"برای فعال‌کردن اتصال مستقیم، از تنظیمات iPhone استفاده کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Включите прямое подключение в настройках iPhone."}},"sv":{"stringUnit":{"state":"translated","value":"Använd Inställningar på iPhone för att aktivera direktanslutning."}}}},
    "Use only on a trusted private network.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use only on a trusted private network."}},"zh-CN":{"stringUnit":{"state":"translated","value":"仅在受信任的私有网络上使用。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"僅在受信任的私人網路上使用。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Use apenas em uma rede privada confiável."}},"de":{"stringUnit":{"state":"translated","value":"Nur in einem vertrauenswürdigen privaten Netzwerk verwenden."}},"es":{"stringUnit":{"state":"translated","value":"Usar solo en una red privada de confianza."}},"ja-JP":{"stringUnit":{"state":"translated","value":"信頼できるプライベートネットワークでのみ使用してください。"}},"ko":{"stringUnit":{"state":"translated","value":"신뢰할 수 있는 사설 네트워크에서만 사용하세요."}},"fr":{"stringUnit":{"state":"translated","value":"À utiliser uniquement sur un réseau privé de confiance."}},"hi":{"stringUnit":{"state":"translated","value":"केवल विश्वसनीय निजी नेटवर्क पर उपयोग करें।"}},"ar":{"stringUnit":{"state":"translated","value":"استخدمه على شبكة خاصة موثوقة فقط."}},"it":{"stringUnit":{"state":"translated","value":"Usa solo su una rete privata attendibile."}},"tr":{"stringUnit":{"state":"translated","value":"Yalnızca güvenilir bir özel ağda kullanın."}},"uk":{"stringUnit":{"state":"translated","value":"Використовуйте лише в довіреній приватній мережі."}},"id":{"stringUnit":{"state":"translated","value":"Gunakan hanya di jaringan privat tepercaya."}},"pl":{"stringUnit":{"state":"translated","value":"Używaj tylko w zaufanej sieci prywatnej."}},"th":{"stringUnit":{"state":"translated","value":"ใช้เฉพาะบนเครือข่ายส่วนตัวที่เชื่อถือได้เท่านั้น"}},"vi":{"stringUnit":{"state":"translated","value":"Chỉ sử dụng trên mạng riêng đáng tin cậy."}},"nl":{"stringUnit":{"state":"translated","value":"Gebruik dit alleen op een vertrouwd privénetwerk."}},"fa":{"stringUnit":{"state":"translated","value":"فقط در یک شبکهٔ خصوصی قابل‌اعتماد استفاده کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Используйте только в доверенной частной сети."}},"sv":{"stringUnit":{"state":"translated","value":"Använd endast i ett betrott privat nätverk."}}}},
    "Use this if you have a setup code instead of scanning.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use this if you have a setup code instead of scanning."}},"zh-CN":{"stringUnit":{"state":"translated","value":"如果你有设置代码而不打算扫码，请使用此选项。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"如果您有設定代碼而不需掃描，請使用此選項。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Use esta opção se você tiver um código de configuração em vez de escanear."}},"de":{"stringUnit":{"state":"translated","value":"Diese Option verwenden, wenn Sie einen Einrichtungscode haben, statt einen Code zu scannen."}},"es":{"stringUnit":{"state":"translated","value":"Usa esta opción si tienes un código de configuración en lugar de escanear."}},"ja-JP":{"stringUnit":{"state":"translated","value":"スキャンする代わりにセットアップコードを使用する場合はこちらを選択します。"}},"ko":{"stringUnit":{"state":"translated","value":"스캔하는 대신 설정 코드를 입력하려면 이 옵션을 사용하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Utilisez cette option si vous disposez d’un code de configuration au lieu de scanner."}},"hi":{"stringUnit":{"state":"translated","value":"यदि स्कैन करने के बजाय आपके पास सेटअप कोड है, तो इसका उपयोग करें."}},"ar":{"stringUnit":{"state":"translated","value":"استخدم هذا الخيار إذا كان لديك رمز إعداد بدلاً من المسح."}},"it":{"stringUnit":{"state":"translated","value":"Usa questa opzione se hai un codice di configurazione anziché effettuare la scansione."}},"tr":{"stringUnit":{"state":"translated","value":"Tarama yapmak yerine bir kurulum kodunuz varsa bunu kullanın."}},"uk":{"stringUnit":{"state":"translated","value":"Скористайтеся цим, якщо у вас є код налаштування замість сканування."}},"id":{"stringUnit":{"state":"translated","value":"Gunakan ini jika Anda memiliki kode penyiapan sebagai pengganti pemindaian."}},"pl":{"stringUnit":{"state":"translated","value":"Użyj tej opcji, jeśli masz kod konfiguracji zamiast skanowania."}},"th":{"stringUnit":{"state":"translated","value":"ใช้ตัวเลือกนี้หากคุณมีรหัสตั้งค่าแทนการสแกน."}},"vi":{"stringUnit":{"state":"translated","value":"Sử dụng tùy chọn này nếu bạn có mã thiết lập thay vì quét mã."}},"nl":{"stringUnit":{"state":"translated","value":"Gebruik dit als je een instelcode hebt in plaats van te scannen."}},"fa":{"stringUnit":{"state":"translated","value":"اگر به‌جای اسکن کردن، کد راه‌اندازی دارید، از این گزینه استفاده کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Используйте этот вариант, если у вас есть код настройки вместо сканирования."}},"sv":{"stringUnit":{"state":"translated","value":"Använd detta om du har en konfigurationskod i stället för att skanna."}}}},
