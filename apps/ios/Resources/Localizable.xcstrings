    "Realtime closed before it became ready.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Realtime closed before it became ready."}},"zh-CN":{"stringUnit":{"state":"translated","value":"实时连接在就绪前已关闭。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"即時功能尚未就緒便已關閉。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A sessão em tempo real foi encerrada antes de ficar pronta."}},"de":{"stringUnit":{"state":"translated","value":"Echtzeitverbindung wurde geschlossen, bevor sie bereit war."}},"es":{"stringUnit":{"state":"translated","value":"La conexión en tiempo real se cerró antes de estar lista."}},"ja-JP":{"stringUnit":{"state":"translated","value":"準備が完了する前にリアルタイム接続が閉じられました。"}},"ko":{"stringUnit":{"state":"translated","value":"실시간 연결이 준비되기 전에 닫혔습니다."}},"fr":{"stringUnit":{"state":"translated","value":"La session en temps réel s’est fermée avant d’être prête."}},"hi":{"stringUnit":{"state":"translated","value":"रीयलटाइम तैयार होने से पहले ही बंद हो गया।"}},"ar":{"stringUnit":{"state":"translated","value":"أُغلق الاتصال في الوقت الفعلي قبل أن يصبح جاهزًا."}},"it":{"stringUnit":{"state":"translated","value":"La sessione in tempo reale si è chiusa prima di essere pronta."}},"tr":{"stringUnit":{"state":"translated","value":"Gerçek zamanlı bağlantı hazır olmadan kapandı."}},"uk":{"stringUnit":{"state":"translated","value":"Сеанс у реальному часі закрився до завершення підготовки."}},"id":{"stringUnit":{"state":"translated","value":"Koneksi waktu nyata ditutup sebelum siap."}},"pl":{"stringUnit":{"state":"translated","value":"Połączenie w czasie rzeczywistym zostało zamknięte przed osiągnięciem gotowości."}},"th":{"stringUnit":{"state":"translated","value":"การเชื่อมต่อแบบเรียลไทม์ปิดลงก่อนที่จะพร้อมใช้งาน."}},"vi":{"stringUnit":{"state":"translated","value":"Phiên thời gian thực đã đóng trước khi sẵn sàng."}},"nl":{"stringUnit":{"state":"translated","value":"Realtime is afgesloten voordat het gereed was."}},"fa":{"stringUnit":{"state":"tra