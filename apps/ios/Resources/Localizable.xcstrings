    "Voice cannot read the active network addresses.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Voice cannot read the active network addresses."}},"zh-CN":{"stringUnit":{"state":"translated","value":"语音功能无法读取当前使用的网络地址。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語音功能無法讀取目前使用中的網路位址。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O recurso de voz não consegue ler os endereços de rede ativos."}},"de":{"stringUnit":{"state":"translated","value":"Die Sprachfunktion kann die aktiven Netzwerkadressen nicht lesen."}},"es":{"stringUnit":{"state":"translated","value":"La función de voz no puede leer las direcciones de red activas."}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声機能が有効なネットワークアドレスを読み取れません。"}},"ko":{"stringUnit":{"state":"translated","value":"음성 기능이 활성 네트워크 주소를 읽을 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le mode vocal ne peut pas lire les adresses réseau actives."}},"hi":{"stringUnit":{"state":"translated","value":"वॉइस सक्रिय नेटवर्क पते नहीं पढ़ सकता।"}},"ar":{"stringUnit":{"state":"translated","value":"يتعذّر على الميزة الصوتية قراءة عناوين الشبكة النشطة."}},"it":{"stringUnit":{"state":"translated","value":"La modalità vocale non riesce a leggere gli indirizzi di rete attivi."}},"tr":{"stringUnit":{"state":"translated","value":"Sesli iletişim, etkin ağ adreslerini okuyamıyor."}},"uk":{"stringUnit":{"state":"translated","value":"Голосовий режим не може зчитати активні мережеві адреси."}},"id":{"stringUnit":{"state":"translated","value":"Fitur suara tidak dapat membaca alamat jaringan yang aktif."}},"pl":{"stringUnit":{"state":"translated","value":"Tryb głosowy nie może odczytać aktywnych adresów sieciowych."}},"th":{"stringUnit":{"state":"translated","value":"ฟีเจอร์เสียงไม่สามารถอ่านที่อยู่เครือข่ายที่ใช้งานอยู่ได้"}},"vi":{"stringUnit":{"state":"translated","value":"Tính năng giọng nói không thể đọc các địa chỉ mạng đang hoạt động."}},"nl":{"stringUnit":{"state":"translated","value"