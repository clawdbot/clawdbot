    "Showing %lld sessions; %lld total. Refresh to load the rest.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Showing %lld sessions; %lld total. Refresh to load the rest."}},"zh-CN":{"stringUnit":{"state":"translated","value":"当前显示 %lld 个会话，共 %lld 个。刷新以加载其余会话。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"目前顯示 %lld 個工作階段；總計 %lld 個。請重新整理以載入其餘項目。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Exibindo %lld sessões; %lld no total. Atualize para carregar as demais."}},"de":{"stringUnit":{"state":"translated","value":"%lld Sitzungen werden angezeigt; insgesamt sind es %lld. Aktualisieren Sie, um die übrigen zu laden."}},"es":{"stringUnit":{"state":"translated","value":"Se muestran %lld sesiones; %lld en total. Actualiza para cargar el resto."}},"ja-JP":{"stringUnit":{"state":"translated","value":"%lld件のセッションを表示中（全%lld件）。残りを読み込むには更新してください。"}},"ko":{"stringUnit":{"state":"translated","value":"%lld개 세션을 표시 중이며, 전체 세션은 %lld개입니다. 나머지를 불러오려면 새로 고침하세요."}},"fr":{"stringUnit":{"state":"translated","value":"%lld sessions affichées sur %lld au total. Actualisez pour charger les autres."}},"hi":{"stringUnit":{"state":"translated","value":"%lld सत्र दिखाए जा रहे हैं; कुल %lld हैं। शेष को लोड करने के लिए रीफ़्रेश करें।"}},"ar":{"stringUnit":{"state":"translated","value":"يتم عرض %lld جلسة؛ والإجمالي %lld. حدّث لتحميل الباقي."}},"it":{"stringUnit":{"state":"translated","value":"Visualizzate %lld sessioni; %lld in totale. Aggiorna per caricare le altre."}},"tr":{"stringUnit":{"state":"translated","value":"%lld oturum gösteriliyor; toplam %lld oturum var. Kalanını yüklemek için yenileyin."}},"uk":{"stringUnit":{"state":"translated","value":"Показано сеансів: %lld; усього: %lld. Оновіть, щоб завантажити решту."}},"id":{"stringUnit":{"state":"translated","value":"Menampilkan %lld sesi; total %lld. Segarkan untuk memuat sisanya."}},"pl":{"stringUnit":{"state":"translated","value":"Wyświetlono %lld sesji; łącznie: %lld. Odśwież, aby wczytać pozostałe."}},"th":{"stringUnit":{"state":"translated","value":"กำลังแสดง %lld เซสชัน จากทั้งหมด %lld เซสชัน รีเฟรชเพื่อโหลดเซสชันที่เหลือ"}},"vi":{"stringUnit":{"state":"translated","value":"Đang hiển thị %lld phiên; tổng cộng %lld phiên. Hãy làm mới để tải phần còn lại."}},"nl":{"stringUnit":{"state":"translated","value":"%lld sessies weergegeven; %lld in totaal. Vernieuw om de rest te laden."}},"fa":{"stringUnit":{"state":"translated","value":"در حال نمایش %lld نشست از مجموع %lld نشست. برای بارگیری بقیه، تازه‌سازی کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Показано сеансов: %lld; всего: %lld. Обновите, чтобы загрузить остальные."}},"sv":{"stringUnit":{"state":"translated","value":"Visar %lld sessioner; totalt %lld. Uppdatera för att läsa in resten."}}}},
