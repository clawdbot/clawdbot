    "Continue only if you trust the gateway and agent you connect to.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Continue only if you trust the gateway and agent you connect to."}},"zh-CN":{"stringUnit":{"state":"translated","value":"仅在信任所连接的网关和智能体时继续。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"請僅在信任所連線的 Gateway 和代理程式時繼續。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Continue apenas se confiar no gateway e no agente aos quais você se conecta."}},"de":{"stringUnit":{"state":"translated","value":"Fahren Sie nur fort, wenn Sie dem Gateway und dem Agenten vertrauen, mit denen Sie sich verbinden."}},"es":{"stringUnit":{"state":"translated","value":"Continúa solo si confías en el gateway y en el agente al que te conectas."}},"ja-JP":{"stringUnit":{"state":"translated","value":"接続先のGatewayとエージェントを信頼できる場合にのみ続行してください。"}},"ko":{"stringUnit":{"state":"translated","value":"연결할 Gateway와 에이전트를 신뢰하는 경우에만 계속하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Continuez uniquement si vous faites confiance à la passerelle et à l’agent auxquels vous vous connectez."}},"hi":{"stringUnit":{"state":"translated","value":"केवल तभी जारी रखें जब आपको उस Gateway और एजेंट पर भरोसा हो जिससे आप कनेक्ट हो रहे हैं."}},"ar":{"stringUnit":{"state":"translated","value":"تابع فقط إذا كنت تثق بالبوابة والوكيل اللذين تتصل بهما."}},"it":{"stringUnit":{"state":"translated","value":"Continua solo se ti fidi del gateway e dell'agente a cui ti connetti."}},"tr":{"stringUnit":{"state":"translated","value":"Yalnızca bağlandığınız ağ geçidine ve ajana güveniyorsanız devam edin."}},"uk":{"stringUnit":{"state":"translated","value":"Продовжуйте, лише якщо довіряєте шлюзу й агенту, до яких підключаєтеся."}},"id":{"stringUnit":{"state":"translated","value":"Lanjutkan hanya jika Anda memercayai gateway dan agen yang Anda hubungi."}},"pl":{"stringUnit":{"state":"translated","value":"Kontynuuj tylko wtedy, gdy ufasz bramie i agentowi, z którymi się łączysz."}},"th":{"stringUnit":{"state":"translated","value":"ดำเนินการต่อเฉพาะเมื่อคุณเชื่อถือ Gateway และเอเจนต์ที่คุณเชื่อมต่อด้วยเท่านั้น."}},"vi":{"stringUnit":{"state":"translated","value":"Chỉ tiếp tục nếu bạn tin tưởng gateway và tác nhân mà bạn kết nối."}},"nl":{"stringUnit":{"state":"translated","value":"Ga alleen door als je de gateway en agent waarmee je verbinding maakt vertrouwt."}},"fa":{"stringUnit":{"state":"translated","value":"فقط در صورتی ادامه دهید که به Gateway و عاملی که به آن‌ها متصل می‌شوید اعتماد دارید."}},"ru":{"stringUnit":{"state":"translated","value":"Продолжайте, только если доверяете шлюзу и агенту, к которым подключаетесь."}},"sv":{"stringUnit":{"state":"translated","value":"Fortsätt endast om du litar på den gateway och agent som du ansluter till."}}}},
