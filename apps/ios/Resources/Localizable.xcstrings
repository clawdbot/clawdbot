    "Background Tasks": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Background Tasks"}},"zh-CN":{"stringUnit":{"state":"translated","value":"后台任务"}},"zh-TW":{"stringUnit":{"state":"translated","value":"背景工作"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Tarefas em Segundo Plano"}},"de":{"stringUnit":{"state":"translated","value":"Hintergrundaufgaben"}},"es":{"stringUnit":{"state":"translated","value":"Tareas en segundo plano"}},"ja-JP":{"stringUnit":{"state":"translated","value":"バックグラウンドタスク"}},"ko":{"stringUnit":{"state":"translated","value":"백그라운드 작업"}},"fr":{"stringUnit":{"state":"translated","value":"Tâches en arrière-plan"}},"hi":{"stringUnit":{"state":"translated","value":"बैकग्राउंड कार्य"}},"ar":{"stringUnit":{"state":"translated","value":"مهام الخلفية"}},"it":{"stringUnit":{"state":"translated","value":"Attività in background"}},"tr":{"stringUnit":{"state":"translated","value":"Arka Plan Görevleri"}},"uk":{"stringUnit":{"state":"translated","value":"Фонові завдання"}},"id":{"stringUnit":{"state":"translated","value":"Tugas Latar Belakang"}},"pl":{"stringUnit":{"state":"translated","value":"Zadania w tle"}},"th":{"stringUnit":{"state":"translated","value":"งานเบื้องหลัง"}},"vi":{"stringUnit":{"state":"translated","value":"Tác vụ nền"}},"nl":{"stringUnit":{"state":"translated","value":"Achtergrondtaken"}},"fa":{"stringUnit":{"state":"translated","value":"وظایف پس‌زمینه"}},"ru":{"stringUnit":{"state":"translated","value":"Фоновые задачи"}},"sv":{"stringUnit":{"state":"translated","value":"Bakgrundsuppgifter"}}}},
    "Background location requests and significant-change updates are allowed.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Background location requests and significant-change updates are allowed."}},"zh-CN":{"stringUnit":{"state":"translated","value":"已允许后台位置请求和位置显著变化更新。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已允許背景位置請求及重大位置變更更新。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Solicitações de localização em segundo plano e atualizações de mudanças significativas são permitidas."}},"de":{"stringUnit":{"state":"translated","value":"Standortabfragen im Hintergrund und Aktualisierungen bei wesentlichen Standortänderungen sind erlaubt."}},"es":{"stringUnit":{"state":"translated","value":"Se permiten las solicitudes de ubicación en segundo plano y las actualizaciones por cambios significativos."}},"ja-JP":{"stringUnit":{"state":"translated","value":"バックグラウンドでの位置情報の要求と大幅な位置変更時の更新が許可されています。"}},"ko":{"stringUnit":{"state":"translated","value":"백그라운드 위치 요청 및 주요 위치 변경 업데이트가 허용됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les demandes de localisation en arrière-plan et les mises à jour lors de changements significatifs sont autorisées."}},"hi":{"stringUnit":{"state":"translated","value":"बैकग्राउंड में स्थान के अनुरोधों और महत्वपूर्ण बदलावों के अपडेट की अनुमति है."}},"ar":{"stringUnit":{"state":"translated","value":"يُسمح بطلبات الموقع في الخلفية وتحديثات التغييرات الكبيرة في الموقع."}},"it":{"stringUnit":{"state":"translated","value":"Le richieste di posizione in background e gli aggiornamenti per variazioni significative sono consentiti."}},"tr":{"stringUnit":{"state":"translated","value":"Arka planda konum isteklerine ve önemli konum değişikliği güncellemelerine izin veriliyor."}},"uk":{"stringUnit":{"state":"translated","value":"Фонові запити геопозиції та оновлення за значних змін геопозиції дозволено."}},"id":{"stringUnit":{"state":"translated","value":"Permintaan lokasi di latar belakang dan pembaruan perubahan signifikan diizinkan."}},"pl":{"stringUnit":{"state":"translated","value":"Żądania lokalizacji w tle i aktualizacje przy znacznych zmianach lokalizacji są dozwolone."}},"th":{"stringUnit":{"state":"translated","value":"อนุญาตให้ขอตำแหน่งที่ตั้งในเบื้องหลังและรับการอัปเดตเมื่อมีการเปลี่ยนแปลงที่สำคัญ."}},"vi":{"stringUnit":{"state":"translated","value":"Cho phép yêu cầu vị trí trong nền và cập nhật khi vị trí thay đổi đáng kể."}},"nl":{"stringUnit":{"state":"translated","value":"Locatieverzoeken op de achtergrond en updates bij aanzienlijke locatieveranderingen zijn toegestaan."}},"fa":{"stringUnit":{"state":"translated","value":"درخواست‌های موقعیت مکانی در پس‌زمینه و به‌روزرسانی‌های تغییرات قابل‌توجه مجاز هستند."}},"ru":{"stringUnit":{"state":"translated","value":"Разрешены фоновые запросы геопозиции и обновления при значительных изменениях местоположения."}},"sv":{"stringUnit":{"state":"translated","value":"Platsförfrågningar i bakgrunden och uppdateringar vid betydande platsändringar är tillåtna."}}}},
    "Background location requests and significant-change updates are allowed. Precise Location is off.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Background location requests and significant-change updates are allowed. Precise Location is off."}},"zh-CN":{"stringUnit":{"state":"translated","value":"已允许后台位置请求和位置显著变化更新。 精确位置已关闭。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已允許背景位置請求及重大位置變更更新。 精確位置已關閉。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Solicitações de localização em segundo plano e atualizações de mudanças significativas são permitidas. A Localização Precisa está desativada."}},"de":{"stringUnit":{"state":"translated","value":"Standortabfragen im Hintergrund und Aktualisierungen bei wesentlichen Standortänderungen sind erlaubt. Genauer Standort ist deaktiviert."}},"es":{"stringUnit":{"state":"translated","value":"Se permiten las solicitudes de ubicación en segundo plano y las actualizaciones por cambios significativos. La ubicación precisa está desactivada."}},"ja-JP":{"stringUnit":{"state":"translated","value":"バックグラウンドでの位置情報の要求と大幅な位置変更時の更新が許可されています。 正確な位置情報はオフです。"}},"ko":{"stringUnit":{"state":"translated","value":"백그라운드 위치 요청 및 주요 위치 변경 업데이트가 허용됩니다. 정확한 위치가 꺼져 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les demandes de localisation en arrière-plan et les mises à jour lors de changements significatifs sont autorisées. La localisation précise est désactivée."}},"hi":{"stringUnit":{"state":"translated","value":"बैकग्राउंड में स्थान के अनुरोधों और महत्वपूर्ण बदलावों के अपडेट की अनुमति है. सटीक स्थान बंद है."}},"ar":{"stringUnit":{"state":"translated","value":"يُسمح بطلبات الموقع في الخلفية وتحديثات التغييرات الكبيرة في الموقع. الموقع الدقيق معطّل."}},"it":{"stringUnit":{"state":"translated","value":"Le richieste di posizione in background e gli aggiornamenti per variazioni significative sono consentiti. Posizione precisa è disattivata."}},"tr":{"stringUnit":{"state":"translated","value":"Arka planda konum isteklerine ve önemli konum değişikliği güncellemelerine izin veriliyor. Tam Konum kapalı."}},"uk":{"stringUnit":{"state":"translated","value":"Фонові запити геопозиції та оновлення за значних змін геопозиції дозволено. Точну геопозицію вимкнено."}},"id":{"stringUnit":{"state":"translated","value":"Permintaan lokasi di latar belakang dan pembaruan perubahan signifikan diizinkan. Lokasi Presisi nonaktif."}},"pl":{"stringUnit":{"state":"translated","value":"Żądania lokalizacji w tle i aktualizacje przy znacznych zmianach lokalizacji są dozwolone. Dokładna lokalizacja jest wyłączona."}},"th":{"stringUnit":{"state":"translated","value":"อนุญาตให้ขอตำแหน่งที่ตั้งในเบื้องหลังและรับการอัปเดตเมื่อมีการเปลี่ยนแปลงที่สำคัญ. ปิดตำแหน่งที่ตั้งแบบแม่นยำอยู่."}},"vi":{"stringUnit":{"state":"translated","value":"Cho phép yêu cầu vị trí trong nền và cập nhật khi vị trí thay đổi đáng kể. Vị trí chính xác đang tắt."}},"nl":{"stringUnit":{"state":"translated","value":"Locatieverzoeken op de achtergrond en updates bij aanzienlijke locatieveranderingen zijn toegestaan. Exacte Locatie is uitgeschakeld."}},"fa":{"stringUnit":{"state":"translated","value":"درخواست‌های موقعیت مکانی در پس‌زمینه و به‌روزرسانی‌های تغییرات قابل‌توجه مجاز هستند. موقعیت مکانی دقیق خاموش است."}},"ru":{"stringUnit":{"state":"translated","value":"Разрешены фоновые запросы геопозиции и обновления при значительных изменениях местоположения. Точная геопозиция отключена."}},"sv":{"stringUnit":{"state":"translated","value":"Platsförfrågningar i bakgrunden och uppdateringar vid betydande platsändringar är tillåtna. Exakt platsinformation är avstängd."}}}},
    "Background location requests and significant-change updates are allowed. Precise Location is on.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Background location requests and significant-change updates are allowed. Precise Location is on."}},"zh-CN":{"stringUnit":{"state":"translated","value":"已允许后台位置请求和位置显著变化更新。 精确位置已开启。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已允許背景位置請求及重大位置變更更新。 精確位置已開啟。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Solicitações de localização em segundo plano e atualizações de mudanças significativas são permitidas. A Localização Precisa está ativada."}},"de":{"stringUnit":{"state":"translated","value":"Standortabfragen im Hintergrund und Aktualisierungen bei wesentlichen Standortänderungen sind erlaubt. Genauer Standort ist aktiviert."}},"es":{"stringUnit":{"state":"translated","value":"Se permiten las solicitudes de ubicación en segundo plano y las actualizaciones por cambios significativos. La ubicación precisa está activada."}},"ja-JP":{"stringUnit":{"state":"translated","value":"バックグラウンドでの位置情報の要求と大幅な位置変更時の更新が許可されています。 正確な位置情報はオンです。"}},"ko":{"stringUnit":{"state":"translated","value":"백그라운드 위치 요청 및 주요 위치 변경 업데이트가 허용됩니다. 정확한 위치가 켜져 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les demandes de localisation en arrière-plan et les mises à jour lors de changements significatifs sont autorisées. La localisation précise est activée."}},"hi":{"stringUnit":{"state":"translated","value":"बैकग्राउंड में स्थान के अनुरोधों और महत्वपूर्ण बदलावों के अपडेट की अनुमति है. सटीक स्थान चालू है."}},"ar":{"stringUnit":{"state":"translated","value":"يُسمح بطلبات الموقع في الخلفية وتحديثات التغييرات الكبيرة في الموقع. الموقع الدقيق مفعّل."}},"it":{"stringUnit":{"state":"translated","value":"Le richieste di posizione in background e gli aggiornamenti per variazioni significative sono consentiti. Posizione precisa è attivata."}},"tr":{"stringUnit":{"state":"translated","value":"Arka planda konum isteklerine ve önemli konum değişikliği güncellemelerine izin veriliyor. Tam Konum açık."}},"uk":{"stringUnit":{"state":"translated","value":"Фонові запити геопозиції та оновлення за значних змін геопозиції дозволено. Точну геопозицію ввімкнено."}},"id":{"stringUnit":{"state":"translated","value":"Permintaan lokasi di latar belakang dan pembaruan perubahan signifikan diizinkan. Lokasi Presisi aktif."}},"pl":{"stringUnit":{"state":"translated","value":"Żądania lokalizacji w tle i aktualizacje przy znacznych zmianach lokalizacji są dozwolone. Dokładna lokalizacja jest włączona."}},"th":{"stringUnit":{"state":"translated","value":"อนุญาตให้ขอตำแหน่งที่ตั้งในเบื้องหลังและรับการอัปเดตเมื่อมีการเปลี่ยนแปลงที่สำคัญ. เปิดตำแหน่งที่ตั้งแบบแม่นยำอยู่."}},"vi":{"stringUnit":{"state":"translated","value":"Cho phép yêu cầu vị trí trong nền và cập nhật khi vị trí thay đổi đáng kể. Vị trí chính xác đang bật."}},"nl":{"stringUnit":{"state":"translated","value":"Locatieverzoeken op de achtergrond en updates bij aanzienlijke locatieveranderingen zijn toegestaan. Exacte Locatie is ingeschakeld."}},"fa":{"stringUnit":{"state":"translated","value":"درخواست‌های موقعیت مکانی در پس‌زمینه و به‌روزرسانی‌های تغییرات قابل‌توجه مجاز هستند. موقعیت مکانی دقیق روشن است."}},"ru":{"stringUnit":{"state":"translated","value":"Разрешены фоновые запросы геопозиции и обновления при значительных изменениях местоположения. Точная геопозиция включена."}},"sv":{"stringUnit":{"state":"translated","value":"Platsförfrågningar i bakgrunden och uppdateringar vid betydande platsändringar är tillåtna. Exakt platsinformation är påslagen."}}}},
