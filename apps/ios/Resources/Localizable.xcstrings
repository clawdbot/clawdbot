    "Voice cannot use this network candidate set.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Voice cannot use this network candidate set."}},"zh-CN":{"stringUnit":{"state":"translated","value":"语音功能无法使用此网络候选地址集。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語音功能無法使用這組網路候選項目。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O recurso de voz não consegue usar este conjunto de candidatos de rede."}},"de":{"stringUnit":{"state":"translated","value":"Die Sprachfunktion kann diese Gruppe von Netzwerkkandidaten nicht verwenden."}},"es":{"stringUnit":{"state":"translated","value":"La función de voz no puede usar este conjunto de candidatos de red."}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声機能でこのネットワーク候補セットを使用できません。"}},"ko":{"stringUnit":{"state":"translated","value":"음성 기능이 이 네트워크 후보 집합을 사용할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le mode vocal ne peut pas utiliser cet ensemble de candidats réseau."}},"hi":{"stringUnit":{"state":"translated","value":"वॉइस इस नेटवर्क कैंडिडेट सेट का उपयोग नहीं कर सकता।"}},"ar":{"stringUnit":{"state":"translated","value":"يتعذّر على الميزة الصوتية استخدام هذه المجموعة من خيارات الاتصال بالشبكة."}},"it":{"stringUnit":{"state":"translated","value":"La modalità vocale non può utilizzare questo insieme di candidati di rete."}},"tr":{"stringUnit":{"state":"translated","value":"Sesli iletişim, bu ağ adayı kümesini kullanamıyor."}},"uk":{"stringUnit":{"state":"translated","value":"Голосовий режим не може використати цей набір кандидатів мережевого з’єднання."}},"id":{"stringUnit":{"state":"translated","value":"Fitur suara tidak dapat menggunakan kumpulan kandidat jaringan ini."}},"pl":{"stringUnit":{"state":"translated","value":"Tryb głosowy nie może użyć tego zestawu kandydatów sieciowych."}},"th":{"stringUnit":{"state":"translated","value":"ฟีเจอร์เสียงไม่สามารถใช้ชุดตัวเลือกการเชื่อมต่อเครือข่ายนี้ได้"}},"vi":{"stringUnit":{"state":"translated","value":"Tính năng giọng nói không thể sử dụng tập hợp ứng viên mạng này."}},"nl":{"stringUnit":{"state":"translated","value":"De spraakfunctie kan deze set netwerkkandidaten niet gebruiken."}},"fa":{"stringUnit":{"state":"translated","value":"حالت صوتی نمی‌تواند از این مجموعه گزینه‌های اتصال شبکه استفاده کند."}},"ru":{"stringUnit":{"state":"translated","value":"Невозможно использовать этот набор сетевых кандидатов для голосового режима."}},"sv":{"stringUnit":{"state":"translated","value":"Röstfunktionen kan inte använda den här uppsättningen nätverkskandidater."}}}},
    "Voice capture returned an unexpected audio format.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Voice capture returned an unexpected audio format."}},"zh-CN":{"stringUnit":{"state":"translated","value":"语音采集返回了意外的音频格式。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語音擷取傳回了非預期的音訊格式。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A captura de voz retornou um formato de áudio inesperado."}},"de":{"stringUnit":{"state":"translated","value":"Die Sprachaufnahme hat ein unerwartetes Audioformat zurückgegeben."}},"es":{"stringUnit":{"state":"translated","value":"La captura de voz devolvió un formato de audio inesperado."}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声キャプチャで予期しない音声形式が返されました。"}},"ko":{"stringUnit":{"state":"translated","value":"음성 캡처에서 예상치 못한 오디오 형식이 반환되었습니다."}},"fr":{"stringUnit":{"state":"translated","value":"La capture vocale a renvoyé un format audio inattendu."}},"hi":{"stringUnit":{"state":"translated","value":"वॉइस कैप्चर से अनपेक्षित ऑडियो प्रारूप मिला।"}},"ar":{"stringUnit":{"state":"translated","value":"أعاد التقاط الصوت تنسيقًا صوتيًا غير متوقع."}},"it":{"stringUnit":{"state":"translated","value":"L'acquisizione vocale ha restituito un formato audio imprevisto."}},"tr":{"stringUnit":{"state":"translated","value":"Ses kaydı beklenmeyen bir ses biçimi döndürdü."}},"uk":{"stringUnit":{"state":"translated","value":"Під час запису голосу отримано неочікуваний формат аудіо."}},"id":{"stringUnit":{"state":"translated","value":"Perekaman suara menghasilkan format audio yang tidak diharapkan."}},"pl":{"stringUnit":{"state":"translated","value":"Przechwytywanie głosu zwróciło nieoczekiwany format dźwięku."}},"th":{"stringUnit":{"state":"translated","value":"การบันทึกเสียงส่งคืนรูปแบบเสียงที่ไม่คาดคิด"}},"vi":{"stringUnit":{"state":"translated","value":"Quá trình thu giọng nói trả về định dạng âm thanh không mong đợi."}},"nl":{"stringUnit":{"state":"translated","value":"De spraakopname heeft een onverwacht audioformaat opgeleverd."}},"fa":{"stringUnit":{"state":"translated","value":"ضبط صدا در حالت صوتی، قالب صوتی غیرمنتظره‌ای برگرداند."}},"ru":{"stringUnit":{"state":"translated","value":"При захвате голоса получен неожиданный формат аудио."}},"sv":{"stringUnit":{"state":"translated","value":"Röstinspelningen returnerade ett oväntat ljudformat."}}}},
    "Voice changed its network address.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Voice changed its network address."}},"zh-CN":{"stringUnit":{"state":"translated","value":"语音功能的网络地址已更改。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語音功能的網路位址已變更。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O recurso de voz alterou seu endereço de rede."}},"de":{"stringUnit":{"state":"translated","value":"Die Netzwerkadresse der Sprachfunktion hat sich geändert."}},"es":{"stringUnit":{"state":"translated","value":"La función de voz cambió su dirección de red."}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声機能のネットワークアドレスが変更されました。"}},"ko":{"stringUnit":{"state":"translated","value":"음성 기능의 네트워크 주소가 변경되었습니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’adresse réseau du mode vocal a changé."}},"hi":{"stringUnit":{"state":"translated","value":"वॉइस ने अपना नेटवर्क पता बदल दिया।"}},"ar":{"stringUnit":{"state":"translated","value":"غيّرت الميزة الصوتية عنوان الشبكة الخاص بها."}},"it":{"stringUnit":{"state":"translated","value":"La modalità vocale ha cambiato il proprio indirizzo di rete."}},"tr":{"stringUnit":{"state":"translated","value":"Sesli iletişimin ağ adresi değişti."}},"uk":{"stringUnit":{"state":"translated","value":"Мережева адреса голосового режиму змінилася."}},"id":{"stringUnit":{"state":"translated","value":"Fitur suara mengubah alamat jaringannya."}},"pl":{"stringUnit":{"state":"translated","value":"Adres sieciowy trybu głosowego uległ zmianie."}},"th":{"stringUnit":{"state":"translated","value":"ฟีเจอร์เสียงเปลี่ยนที่อยู่เครือข่ายแล้ว"}},"vi":{"stringUnit":{"state":"translated","value":"Tính năng giọng nói đã thay đổi địa chỉ mạng."}},"nl":{"stringUnit":{"state":"translated","value":"Het netwerkadres van de spraakfunctie is gewijzigd."}},"fa":{"stringUnit":{"state":"translated","value":"نشانی شبکهٔ حالت صوتی تغییر کرد."}},"ru":{"stringUnit":{"state":"translated","value":"Сетевой адрес голосового соединения изменился."}},"sv":{"stringUnit":{"state":"translated","value":"Röstfunktionen ändrade sin nätverksadress."}}}},
    "Voice changed its remote network address.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Voice changed its remote network address."}},"zh-CN":{"stringUnit":{"state":"translated","value":"语音功能的远程网络地址已更改。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語音功能的遠端網路位址已變更。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O recurso de voz alterou seu endereço de rede remoto."}},"de":{"stringUnit":{"state":"translated","value":"Die entfernte Netzwerkadresse der Sprachfunktion hat sich geändert."}},"es":{"stringUnit":{"state":"translated","value":"La función de voz cambió su dirección de red remota."}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声機能のリモートネットワークアドレスが変更されました。"}},"ko":{"stringUnit":{"state":"translated","value":"음성 기능의 원격 네트워크 주소가 변경되었습니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’adresse réseau distante du mode vocal a changé."}},"hi":{"stringUnit":{"state":"translated","value":"वॉइस ने अपना रिमोट नेटवर्क पता बदल दिया।"}},"ar":{"stringUnit":{"state":"translated","value":"غيّرت الميزة الصوتية عنوان الشبكة البعيد الخاص بها."}},"it":{"stringUnit":{"state":"translated","value":"La modalità vocale ha cambiato il proprio indirizzo di rete remoto."}},"tr":{"stringUnit":{"state":"translated","value":"Sesli iletişimin uzak ağ adresi değişti."}},"uk":{"stringUnit":{"state":"translated","value":"Віддалена мережева адреса голосового режиму змінилася."}},"id":{"stringUnit":{"state":"translated","value":"Fitur suara mengubah alamat jaringan jarak jauhnya."}},"pl":{"stringUnit":{"state":"translated","value":"Zdalny adres sieciowy trybu głosowego uległ zmianie."}},"th":{"stringUnit":{"state":"translated","value":"ฟีเจอร์เสียงเปลี่ยนที่อยู่เครือข่ายปลายทางแล้ว"}},"vi":{"stringUnit":{"state":"translated","value":"Tính năng giọng nói đã thay đổi địa chỉ mạng từ xa."}},"nl":{"stringUnit":{"state":"translated","value":"Het externe netwerkadres van de spraakfunctie is gewijzigd."}},"fa":{"stringUnit":{"state":"translated","value":"نشانی شبکهٔ راه دور حالت صوتی تغییر کرد."}},"ru":{"stringUnit":{"state":"translated","value":"Удалённый сетевой адрес голосового соединения изменился."}},"sv":{"stringUnit":{"state":"translated","value":"Röstfunktionen ändrade sin fjärrnätverksadress."}}}},
    "Voice could not bind its local network address.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Voice could not bind its local network address."}},"zh-CN":{"stringUnit":{"state":"translated","value":"语音功能无法绑定本地网络地址。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語音功能無法繫結本機網路位址。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O recurso de voz não conseguiu vincular seu endereço de rede local."}},"de":{"stringUnit":{"state":"translated","value":"Die Sprachfunktion konnte ihre lokale Netzwerkadresse nicht binden."}},"es":{"stringUnit":{"state":"translated","value":"La función de voz no pudo vincular su dirección de red local."}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声機能がローカルネットワークアドレスをバインドできませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"음성 기능이 로컬 네트워크 주소에 바인딩하지 못했습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le mode vocal n’a pas pu se lier à son adresse réseau locale."}},"hi":{"stringUnit":{"state":"translated","value":"वॉइस अपना स्थानीय नेटवर्क पता बाइंड नहीं कर सका।"}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر على الميزة الصوتية ربط عنوان الشبكة المحلي الخاص بها."}},"it":{"stringUnit":{"state":"translated","value":"La modalità vocale non è riuscita a collegarsi al proprio indirizzo di rete locale."}},"tr":{"stringUnit":{"state":"translated","value":"Sesli iletişim, yerel ağ adresine bağlanamadı."}},"uk":{"stringUnit":{"state":"translated","value":"Голосовому режиму не вдалося прив’язати локальну мережеву адресу."}},"id":{"stringUnit":{"state":"translated","value":"Fitur suara tidak dapat mengikat alamat jaringan lokalnya."}},"pl":{"stringUnit":{"state":"translated","value":"Tryb głosowy nie mógł powiązać lokalnego adresu sieciowego."}},"th":{"stringUnit":{"state":"translated","value":"ฟีเจอร์เสียงไม่สามารถผูกกับที่อยู่เครือข่ายภายในเครื่องได้"}},"vi":{"stringUnit":{"state":"translated","value":"Tính năng giọng nói không thể liên kết với địa chỉ mạng cục bộ."}},"nl":{"