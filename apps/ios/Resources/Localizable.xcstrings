    "Pause Talk mode before playing this attachment.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Pause Talk mode before playing this attachment."}},"zh-CN":{"stringUnit":{"state":"translated","value":"播放此附件前，请暂停对话模式。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"播放此附件前，請先暫停交談模式。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Pause o modo de conversa antes de reproduzir este anexo."}},"de":{"stringUnit":{"state":"translated","value":"Pausiere den Gesprächsmodus, bevor du diesen Anhang abspielst."}},"es":{"stringUnit":{"state":"translated","value":"Pausa el modo de conversación antes de reproducir este archivo adjunto."}},"ja-JP":{"stringUnit":{"state":"translated","value":"この添付ファイルを再生する前にトークモードを一時停止してください。"}},"ko":{"stringUnit":{"state":"translated","value":"이 첨부 파일을 재생하기 전에 대화 모드를 일시 정지하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Mettez le mode Conversation en pause avant de lire cette pièce jointe."}},"hi":{"stringUnit":{"state":"translated","value":"यह अटैचमेंट चलाने से पहले बातचीत मोड को विराम दें."}},"ar":{"stringUnit":{"state":"translated","value":"أوقف وضع التحدث مؤقتًا قبل تشغيل هذا المرفق."}},"it":{"stringUnit":{"state":"translated","value":"Metti in pausa la modalità Talk prima di riprodurre questo allegato."}},"tr":{"stringUnit":{"state":"translated","value":"Bu eki oynatmadan önce Konuşma modunu duraklatın."}},"uk":{"stringUnit":{"state":"translated","value":"Призупиніть режим розмови перед відтворенням цього вкладення."}},"id":{"stringUnit":{"state":"translated","value":"Jeda mode Bicara sebelum memutar lampiran ini."}},"pl":{"stringUnit":{"state":"translated","value":"Wstrzymaj tryb rozmowy przed odtworzeniem tego załącznika."}},"th":{"stringUnit":{"state":"translated","value":"หยุดโหมดสนทนาชั่วคราวก่อนเล่นไฟล์แนบนี้."}},"vi":{"stringUnit":{"state":"translated","value":"Tạm dừng chế độ Trò chuyện trước khi phát tệp đính kèm này."}},"nl":{"stringUnit":{"state":"translated","value":"Pauzeer de gesp