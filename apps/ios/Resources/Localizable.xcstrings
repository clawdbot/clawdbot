    "Web Search and Connectors": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Web Search and Connectors"}},"zh-CN":{"stringUnit":{"state":"translated","value":"网页搜索和连接器"}},"zh-TW":{"stringUnit":{"state":"translated","value":"網頁搜尋與連接器"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Pesquisa na Web e Conectores"}},"de":{"stringUnit":{"state":"translated","value":"Websuche und Konnektoren"}},"es":{"stringUnit":{"state":"translated","value":"Búsqueda web y conectores"}},"ja-JP":{"stringUnit":{"state":"translated","value":"Web検索とコネクタ"}},"ko":{"stringUnit":{"state":"translated","value":"웹 검색 및 커넥터"}},"fr":{"stringUnit":{"state":"translated","value":"Recherche Web et connecteurs"}},"hi":{"stringUnit":{"state":"translated","value":"वेब खोज और कनेक्टर"}},"ar":{"stringUnit":{"state":"translated","value":"البحث على الويب والموصلات"}},"it":{"stringUnit":{"state":"translated","value":"Ricerca web e connettori"}},"tr":{"stringUnit":{"state":"translated","value":"Web Araması ve Bağlayıcılar"}},"uk":{"stringUnit":{"state":"translated","value":"Пошук в інтернеті та конектори"}},"id":{"stringUnit":{"state":"translated","value":"Pencarian Web dan Konektor"}},"pl":{"stringUnit":{"state":"translated","value":"Wyszukiwanie w internecie i konektory"}},"th":{"stringUnit":{"state":"translated","value":"ค้นหาเว็บและตัวเชื่อมต่อ"}},"vi":{"stringUnit":{"state":"translated","value":"Tìm kiếm trên web và trình kết nối"}},"nl":{"stringUnit":{"state":"translated","value":"Zoeken op het web en connectoren"}},"fa":{"stringUnit":{"state":"translated","value":"جستجوی وب و اتصال‌دهنده‌ها"}},"ru":{"stringUnit":{"state":"translated","value":"Поиск в интернете и коннекторы"}},"sv":{"stringUnit":{"state":"translated","value":"Webbsökning och anslutningar"}}}},
    "Web Search is disabled in the Gateway configuration.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Web Search is disabled in the Gateway configuration."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Gateway 配置中已禁用网页搜索。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 設定中已停用網頁搜尋。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A Pesquisa na Web está desativada na configuração do Gateway."}},"de":{"stringUnit":{"state":"translated","value":"Die Websuche ist in der Gateway-Konfiguration deaktiviert."}},"es":{"stringUnit":{"state":"translated","value":"La búsqueda web está desactivada en la configuración del Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayの設定でWeb検索が無効になっています。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway 설정에서 웹 검색이 비활성화되어 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"La recherche Web est désactivée dans la configuration du Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway कॉन्फ़िगरेशन में वेब खोज बंद है."}},"ar":{"stringUnit":{"state":"translated","value":"البحث على الويب معطّل في إعدادات Gateway."}},"it":{"stringUnit":{"state":"translated","value":"La ricerca web è disabilitata nella configurazione del Gateway."}},"tr":{"stringUnit":{"state":"translated","value":"Web Araması, Gateway yapılandırmasında devre dışı."}},"uk":{"stringUnit":{"state":"translated","value":"Пошук в інтернеті вимкнено в конфігурації Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Pencarian Web dinonaktifkan dalam konfigurasi Gateway."}},"pl":{"stringUnit":{"state":"translated","value":"Wyszukiwanie w internecie jest wyłączone w konfiguracji Gateway."}},"th":{"stringUnit":{"state":"translated","value":"การค้นหาเว็บถูกปิดใช้งานในการกำหนดค่า Gateway."}},"vi":{"stringUnit":{"state":"translated","value":"Tìm kiếm trên web bị tắt trong cấu hình Gateway."}},"nl":{"stringUnit":{"state":"translated","value":"Zoeken op het web is uitgeschakeld in de Gateway-configuratie."}},"fa":{"stringUnit":{"state":"translated","value":"جستجوی وب در پیکربندی Gateway غیرفعال است."}},"ru":{"stringUnit":{"state":"translated","value":"Поиск в интернете отключён в конфигурации Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Webbsökning är inaktiverad i Gateway-konfigurationen."}}}},
    "Web Search is unavailable on this Gateway.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Web Search is unavailable on this Gateway."}},"zh-CN":{"stringUnit":{"state":"translated","value":"此 Gateway 不支持网页搜索。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此 Gateway 無法使用網頁搜尋。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A Pesquisa na Web não está disponível neste Gateway."}},"de":{"stringUnit":{"state":"translated","value":"Die Websuche ist auf diesem Gateway nicht verfügbar."}},"es":{"stringUnit":{"state":"translated","value":"La búsqueda web no está disponible en este Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このGatewayではWeb検索を利用できません。"}},"ko":{"stringUnit":{"state":"translated","value":"이 Gateway에서는 웹 검색을 사용할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"La recherche Web n’est pas disponible sur ce Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"इस Gateway पर वेब खोज उपलब्ध नहीं है."}},"ar":{"stringUnit":{"state":"translated","value":"البحث على الويب غير متاح على Gateway هذا."}},"it":{"stringUnit":{"state":"translated","value":"La ricerca web non è disponibile su questo Gateway."}},"tr":{"stringUnit":{"state":"translated","value":"Web Araması bu Gateway üzerinde kullanılamıyor."}},"uk":{"stringUnit":{"state":"translated","value":"Пошук в інтернеті недоступний на цьому Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Pencarian Web tidak tersedia di Gateway ini."}},"pl":{"stringUnit":{"state":"translated","value":"Wyszukiwanie w internecie jest niedostępne w tym Gateway."}},"th":{"stringUnit":{"state":"translated","value":"การค้นหาเว็บไม่พร้อมใช้งานบน Gateway นี้."}},"vi":{"stringUnit":{"state":"translated","value":"Tìm kiếm trên web không khả dụng trên Gateway này."}},"nl":{"stringUnit":{"state":"translated","value":"Zoeken op het web is niet beschikbaar op deze Gateway."}},"fa":{"stringUnit":{"state":"translated","value":"جستجوی وب در این Gateway در دسترس نیست."}},"ru":{"stringUnit":{"state":"translated","value":"Поиск в интернете недоступен на этом Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Webbsökning är inte tillgänglig på denna Gateway."}}}},
