    "Camera": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Camera"}},"zh-CN":{"stringUnit":{"state":"translated","value":"相机"}},"zh-TW":{"stringUnit":{"state":"translated","value":"相機"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Câmera"}},"de":{"stringUnit":{"state":"translated","value":"Kamera"}},"es":{"stringUnit":{"state":"translated","value":"Cámara"}},"ja-JP":{"stringUnit":{"state":"translated","value":"カメラ"}},"ko":{"stringUnit":{"state":"translated","value":"카메라"}},"fr":{"stringUnit":{"state":"translated","value":"Caméra"}},"hi":{"stringUnit":{"state":"translated","value":"कैमरा"}},"ar":{"stringUnit":{"state":"translated","value":"الكاميرا"}},"it":{"stringUnit":{"state":"translated","value":"Fotocamera"}},"tr":{"stringUnit":{"state":"translated","value":"Kamera"}},"uk":{"stringUnit":{"state":"translated","value":"Камера"}},"id":{"stringUnit":{"state":"translated","value":"Kamera"}},"pl":{"stringUnit":{"state":"translated","value":"Aparat"}},"th":{"stringUnit":{"state":"translated","value":"กล้อง"}},"vi":{"stringUnit":{"state":"new","value":"Camera"}},"nl":{"stringUnit":{"state":"new","value":"Camera"}},"fa":{"stringUnit":{"state":"translated","value":"دوربین"}},"ru":{"stringUnit":{"state":"translated","value":"Камера"}},"sv":{"stringUnit":{"state":"translated","value":"Kamera"}}}},
    "Camera, microphone, photos, contacts, calendar, and location may be available.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Camera, microphone, photos, contacts, calendar, and location may be available."}},"zh-CN":{"stringUnit":{"state":"translated","value":"相机、麦克风、照片、通讯录、日历和位置信息可能可用。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"相機、麥克風、照片、聯絡人、行事曆和位置可能可供使用。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Câmera, microfone, fotos, contatos, calendário e localização podem estar disponíveis."}},"de":{"stringUnit":{"state":"translated","value":"Kamera, Mikrofon, Fotos, Kontakte, Kalender und Standort sind möglicherweise verfügbar."}},"es":{"stringUnit":{"state":"translated","value":"La cámara, el micrófono, las fotos, los contactos, el calendario y la ubicación pueden estar disponibles."}},"ja-JP":{"stringUnit":{"state":"translated","value":"カメラ、マイク、写真、連絡先、カレンダー、位置情報を利用できる場合があります。"}},"ko":{"stringUnit":{"state":"translated","value":"카메라, 마이크, 사진, 연락처, 캘린더 및 위치를 사용할 수 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"La caméra, le microphone, les photos, les contacts, le calendrier et la localisation peuvent être disponibles."}},"hi":{"stringUnit":{"state":"translated","value":"कैमरा, माइक्रोफ़ोन, फ़ोटो, संपर्क, कैलेंडर, और स्थान उपलब्ध हो सकते हैं."}},"ar":{"stringUnit":{"state":"translated","value":"قد يتاح الوصول إلى الكاميرا والميكروفون والصور وجهات الاتصال والتقويم والموقع."}},"it":{"stringUnit":{"state":"translated","value":"Fotocamera, microfono, foto, contatti, calendario e posizione potrebbero essere disponibili."}},"tr":{"stringUnit":{"state":"translated","value":"Kamera, mikrofon, fotoğraflar, kişiler, takvim ve konum kullanılabilir olabilir."}},"uk":{"stringUnit":{"state":"translated","value":"Можуть бути доступні камера, мікрофон, фотографії, контакти, календар і геопозиція."}},"id":{"stringUnit":{"state":"translated","value":"Kamera, mikrofon, foto, kontak, kalender, dan lokasi mungkin tersedia."}},"pl":{"stringUnit":{"state":"translated","value":"Aparat, mikrofon, zdjęcia, kontakty, kalendarz i lokalizacja mogą być dostępne."}},"th":{"stringUnit":{"state":"translated","value":"อาจใช้งานกล้อง ไมโครโฟน รูปภาพ รายชื่อผู้ติดต่อ ปฏิทิน และตำแหน่งที่ตั้งได้."}},"vi":{"stringUnit":{"state":"translated","value":"Có thể sử dụng camera, micrô, ảnh, danh bạ, lịch và vị trí."}},"nl":{"stringUnit":{"state":"translated","value":"Camera, microfoon, foto's, contacten, agenda en locatie zijn mogelijk beschikbaar."}},"fa":{"stringUnit":{"state":"translated","value":"ممکن است دوربین، میکروفون، عکس‌ها، مخاطبین، تقویم و موقعیت مکانی در دسترس باشند."}},"ru":{"stringUnit":{"state":"translated","value":"Могут быть доступны камера, микрофон, фотографии, контакты, календарь и местоположение."}},"sv":{"stringUnit":{"state":"translated","value":"Kamera, mikrofon, bilder, kontakter, kalender och plats kan vara tillgängliga."}}}},
    "Can't reach gateway at %1$@:%2$@. Check Tailscale or LAN.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Can't reach gateway at %1$@:%2$@. Check Tailscale or LAN."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法连接到 %1$@:%2$@ 上的 Gateway。请检查 Tailscale 或局域网。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法連線至 %1$@:%2$@ 的 Gateway. 請檢查 Tailscale 或區域網路。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível acessar o Gateway em %1$@:%2$@. Verifique o Tailscale ou a LAN."}},"de":{"stringUnit":{"state":"translated","value":"Gateway unter %1$@:%2$@ nicht erreichbar. Überprüfen Sie Tailscale oder LAN."}},"es":{"stringUnit":{"state":"translated","value":"No se puede acceder al Gateway en %1$@:%2$@. Comprueba Tailscale o la red LAN."}},"ja-JP":{"stringUnit":{"state":"translated","value":"%1$@:%2$@のGatewayに接続できません。TailscaleまたはLANを確認してください。"}},"ko":{"stringUnit":{"state":"translated","value":"%1$@:%2$@의 Gateway에 연결할 수 없습니다. Tailscale 또는 LAN을 확인하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Impossible de joindre le Gateway à l'adresse %1$@:%2$@. Vérifiez Tailscale ou le réseau local."}},"hi":{"stringUnit":{"state":"translated","value":"%1$@:%2$@ पर Gateway से कनेक्ट नहीं हो पा रहा है. Tailscale या LAN जाँचें."}},"ar":{"stringUnit":{"state":"translated","value":"يتعذر الوصول إلى البوابة على %1$@:%2$@. تحقق من Tailscale أو الشبكة المحلية."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile raggiungere il gateway all'indirizzo %1$@:%2$@. Controlla Tailscale o la LAN."}},"tr":{"stringUnit":{"state":"translated","value":"%1$@:%2$@ adresindeki Gateway'e ulaşılamıyor. Tailscale veya LAN bağlantısını kontrol edin."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдається підключитися до Gateway за адресою %1$@:%2$@. Перевірте Tailscale або локальну мережу."}},"id":{"stringUnit":{"state":"translated","value":"Tidak dapat menjangkau gateway di %1$@:%2$@. Periksa Tailscale atau LAN."}},"pl":{"stringUnit":{"state":"translated","value":"Nie można połączyć się z bramą pod adresem %1$@:%2$@. Sprawdź Tailscale lub sieć LAN."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถเชื่อมต่อกับ Gateway ที่ %1$@:%2$@ ได้. ตรวจสอบ Tailscale หรือ LAN."}},"vi":{"stringUnit":{"state":"translated","value":"Không thể kết nối với Gateway tại %1$@:%2$@. Hãy kiểm tra Tailscale hoặc mạng LAN."}},"nl":{"stringUnit":{"state":"translated","value":"Kan gateway op %1$@:%2$@ niet bereiken. Controleer Tailscale of LAN."}},"fa":{"stringUnit":{"state":"translated","value":"دسترسی به Gateway در %1$@:%2$@ ممکن نیست. Tailscale یا شبکهٔ محلی را بررسی کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Не удаётся подключиться к Gateway по адресу %1$@:%2$@. Проверьте Tailscale или локальную сеть."}},"sv":{"stringUnit":{"state":"translated","value":"Kan inte nå Gateway på %1$@:%2$@. Kontrollera Tailscale eller LAN."}}}},
    "Can't reach gateway at %1$@:%2$@. Verify Tailscale Serve is enabled and publishes this Gateway.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Can't reach gateway at %1$@:%2$@. Verify Tailscale Serve is enabled and publishes this Gateway."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法连接到 %1$@:%2$@ 的 Gateway. 请确认已启用 Tailscale Serve 并通过其发布此 Gateway."}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法連線至位於 %1$@:%2$@ 的 Gateway. 請確認 Tailscale Serve 已啟用並發佈此 Gateway."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não é possível acessar o Gateway em %1$@:%2$@. Verifique se o Tailscale Serve está ativado e publica este Gateway."}},"de":{"stringUnit":{"state":"translated","value":"Gateway unter %1$@:%2$@ nicht erreichbar. Prüfe, ob Tailscale Serve aktiviert ist und diesen Gateway veröffentlicht."}},"es":{"stringUnit":{"state":"translated","value":"No se puede acceder al Gateway en %1$@:%2$@. Verifica que Tailscale Serve esté habilitado y publique este Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"%1$@:%2$@ の Gateway に接続できません。 Tailscale Serve が有効で、この Gateway を公開していることを確認してください。"}},"ko":{"stringUnit":{"state":"translated","value":"%1$@:%2$@의 Gateway에 연결할 수 없습니다. Tailscale Serve가 활성화되어 있고 이 Gateway를 게시하고 있는지 확인하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Impossible de joindre la Gateway à l’adresse %1$@:%2$@. Vérifiez que Tailscale Serve est activé et publie cette Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"%1$@:%2$@ पर Gateway से कनेक्ट नहीं हो पा रहा है. जाँचें कि Tailscale Serve सक्षम है और इस Gateway को प्रकाशित करता है."}},"ar":{"stringUnit":{"state":"translated","value":"يتعذر الوصول إلى Gateway على %1$@:%2$@. تحقق من أن Tailscale Serve مفعّل ويتيح الوصول إلى Gateway هذا."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile raggiungere il gateway all'indirizzo %1$@:%2$@. Verifica che Tailscale Serve sia abilitato e pubblichi questo Gateway."}},"tr":{"stringUnit":{"state":"translated","value":"%1$@:%2$@ adresindeki Gateway'e ulaşılamıyor. Tailscale Serve'ün etkin olduğunu ve bu Gateway'i yayınladığını doğrulayın."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдається підключитися до Gateway за адресою %1$@:%2$@. Переконайтеся, що Tailscale Serve увімкнено та надає доступ до цього Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Tidak dapat menjangkau Gateway di %1$@:%2$@. Pastikan Tailscale Serve diaktifkan dan memublikasikan Gateway ini."}},"pl":{"stringUnit":{"state":"translated","value":"Nie można połączyć się z Gateway pod adresem %1$@:%2$@. Sprawdź, czy Tailscale Serve jest włączone i udostępnia ten Gateway."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถเชื่อมต่อ Gateway ที่ %1$@:%2$@ ได้ ตรวจสอบว่าเปิดใช้งาน Tailscale Serve และเผยแพร่ Gateway นี้อยู่"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể kết nối với Gateway tại %1$@:%2$@. Hãy kiểm tra xem Tailscale Serve đã được bật và đang cung cấp quyền truy cập vào Gateway này chưa."}},"nl":{"stringUnit":{"state":"translated","value":"Kan de gateway op %1$@:%2$@ niet bereiken. Controleer of Tailscale Serve is ingeschakeld en deze Gateway publiceert."}},"fa":{"stringUnit":{"state":"translated","value":"دسترسی به Gateway در %1$@:%2$@ ممکن نیست. بررسی کنید که Tailscale Serve فعال باشد و این Gateway را در دسترس قرار دهد."}},"ru":{"stringUnit":{"state":"translated","value":"Не удаётся подключиться к Gateway по адресу %1$@:%2$@. Убедитесь, что Tailscale Serve включён и предоставляет доступ к этому Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Kan inte nå Gateway på %1$@:%2$@. Kontrollera att Tailscale Serve är aktiverat och publicerar denna Gateway."}}}},
