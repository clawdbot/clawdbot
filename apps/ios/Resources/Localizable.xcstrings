{
  "sourceLanguage": "en",
  "strings": {
    " The new certificate is trusted by this device; this is commonly caused by certificate rotation.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":" The new certificate is trusted by this device; this is commonly caused by certificate rotation."}},"zh-CN":{"stringUnit":{"state":"translated","value":" 此设备信任新证书; 这通常是由证书轮换引起的。"}},"zh-TW":{"stringUnit":{"state":"translated","value":" 此裝置信任新憑證; 這通常是憑證輪替所致。"}},"pt-BR":{"stringUnit":{"state":"translated","value":" O novo certificado é confiável para este dispositivo; isso geralmente ocorre devido à rotação de certificados."}},"de":{"stringUnit":{"state":"translated","value":" Dieses Gerät vertraut dem neuen Zertifikat; dies wird häufig durch eine Zertifikatsrotation verursacht."}},"es":{"stringUnit":{"state":"translated","value":" Este dispositivo confía en el nuevo certificado; esto suele deberse a la rotación de certificados."}},"ja-JP":{"stringUnit":{"state":"translated","value":" 新しい証明書はこのデバイスで信頼されています; これは通常、証明書のローテーションによって発生します。"}},"ko":{"stringUnit":{"state":"translated","value":" 이 기기는 새 인증서를 신뢰합니다; 이는 일반적으로 인증서 교체로 인해 발생합니다."}},"fr":{"stringUnit":{"state":"translated","value":" Cet appareil fait confiance au nouveau certificat; cela est généralement dû à une rotation des certificats."}},"hi":{"stringUnit":{"state":"translated","value":" यह डिवाइस नए प्रमाणपत्र पर भरोसा करता है; ऐसा आम तौर पर प्रमाणपत्र बदलने के कारण होता है."}},"ar":{"stringUnit":{"state":"translated","value":" الشهادة الجديدة موثوقة لدى هذا الجهاز؛ يحدث هذا عادةً بسبب تدوير الشهادات."}},"it":{"stringUnit":{"state":"translated","value":" Il nuovo certificato è considerato attendibile da questo dispositivo; questo accade comunemente a causa della rotazione dei certificati."}},"tr":{"stringUnit":{"state":"translated","value":" Bu cihaz yeni sertifikaya güveniyor; bunun nedeni genellikle sertifika yenilemesidir."}},"uk":{"stringUnit":{"state":"translated","value":" Цей пристрій довіряє новому сертифікату; зазвичай це спричинено ротацією сертифікатів."}},"id":{"stringUnit":{"state":"translated","value":" Sertifikat baru dipercaya oleh perangkat ini; hal ini biasanya disebabkan oleh rotasi sertifikat."}},"pl":{"stringUnit":{"state":"translated","value":" To urządzenie ufa nowemu certyfikatowi; zwykle wynika to z rotacji certyfikatów."}},"th":{"stringUnit":{"state":"translated","value":" อุปกรณ์นี้เชื่อถือใบรับรองใหม่; โดยทั่วไปเหตุการณ์นี้เกิดจากการหมุนเวียนใบรับรอง."}},"vi":{"stringUnit":{"state":"translated","value":" Chứng chỉ mới được thiết bị này tin cậy; điều này thường xảy ra khi chứng chỉ được thay mới."}},"nl":{"stringUnit":{"state":"translated","value":" Het nieuwe certificaat wordt door dit apparaat vertrouwd; dit wordt meestal veroorzaakt door certificaatrotatie."}},"fa":{"stringUnit":{"state":"translated","value":" گواهی جدید مورد اعتماد این دستگاه است؛ این وضعیت معمولاً به دلیل تعویض دوره‌ای گواهی رخ می‌دهد."}},"ru":{"stringUnit":{"state":"translated","value":" Это устройство доверяет новому сертификату; обычно это связано с ротацией сертификатов."}},"sv":{"stringUnit":{"state":"translated","value":" Den här enheten litar på det nya certifikatet; detta beror vanligtvis på certifikatrotation."}}}},
    " This device could not verify the new certificate.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":" This device could not verify the new certificate."}},"zh-CN":{"stringUnit":{"state":"translated","value":" 此设备无法验证新证书。"}},"zh-TW":{"stringUnit":{"state":"translated","value":" 此裝置無法驗證新憑證。"}},"pt-BR":{"stringUnit":{"state":"translated","value":" Este dispositivo não conseguiu verificar o novo certificado."}},"de":{"stringUnit":{"state":"translated","value":" Dieses Gerät konnte das neue Zertifikat nicht verifizieren."}},"es":{"stringUnit":{"state":"translated","value":" Este dispositivo no pudo verificar el nuevo certificado."}},"ja-JP":{"stringUnit":{"state":"translated","value":" このデバイスは新しい証明書を検証できませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":" 이 기기에서 새 인증서를 확인할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":" Cet appareil n’a pas pu vérifier le nouveau certificat."}},"hi":{"stringUnit":{"state":"translated","value":" यह डिवाइस नए प्रमाणपत्र को सत्यापित नहीं कर सका."}},"ar":{"stringUnit":{"state":"translated","value":" تعذّر على هذا الجهاز التحقق من الشهادة الجديدة."}},"it":{"stringUnit":{"state":"translated","value":" Questo dispositivo non ha potuto verificare il nuovo certificato."}},"tr":{"stringUnit":{"state":"translated","value":" Bu cihaz yeni sertifikayı doğrulayamadı."}},"uk":{"stringUnit":{"state":"translated","value":" Цей пристрій не зміг перевірити новий сертифікат."}},"id":{"stringUnit":{"state":"translated","value":" Perangkat ini tidak dapat memverifikasi sertifikat baru."}},"pl":{"stringUnit":{"state":"translated","value":" To urządzenie nie mogło zweryfikować nowego certyfikatu."}},"th":{"stringUnit":{"state":"translated","value":" อุปกรณ์นี้ไม่สามารถตรวจสอบใบรับรองใหม่ได้."}},"vi":{"stringUnit":{"state":"translated","value":" Thiết bị này không thể xác minh chứng chỉ mới."}},"nl":{"stringUnit":{"state":"translated","value":" Dit apparaat kon het nieuwe certificaat niet verifiëren."}},"fa":{"stringUnit":{"state":"translated","value":" این دستگاه نتوانست گواهی جدید را تأیید کند."}},"ru":{"stringUnit":{"state":"translated","value":" Это устройство не смогло проверить новый сертификат."}},"sv":{"stringUnit":{"state":"translated","value":" Den här enheten kunde inte verifiera det nya certifikatet."}}}},
