    "Could not save the watch device identity": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Could not save the watch device identity"}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法保存手表设备身份"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法儲存手錶裝置的身分"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível salvar a identidade do dispositivo do relógio"}},"de":{"stringUnit":{"state":"translated","value":"Die Geräteidentität der Watch konnte nicht gespeichert werden"}},"es":{"stringUnit":{"state":"translated","value":"No se pudo guardar la identidad del reloj"}},"ja-JP":{"stringUnit":{"state":"translated","value":"ウォッチデバイスの識別情報を保存できませんでした"}},"ko":{"stringUnit":{"state":"translated","value":"워치 기기 ID를 저장할 수 없습니다"}},"fr":{"stringUnit":{"state":"translated","value":"Impossible d’enregistrer l’identité de la montre"}},"hi":{"stringUnit":{"state":"translated","value":"वॉच डिवाइस की पहचान सहेजी नहीं जा सकी"}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر حفظ هوية جهاز الساعة"}},"it":{"stringUnit":{"state":"translated","value":"Impossibile salvare l’identità del dispositivo Watch"}},"tr":{"stringUnit":{"state":"translated","value":"Saat cihazının kimliği kaydedilemedi"}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося зберегти ідентифікаційні дані годинника"}},"id":{"stringUnit":{"state":"translated","value":"Tidak dapat menyimpan identitas perangkat jam tangan"}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się zapisać tożsamości zegarka"}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถบันทึกข้อมูลระบุตัวตนของอุปกรณ์นาฬิกาได้"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể lưu danh tính của thiết bị đồng hồ"}},"nl":{"stringUnit":{"state":"translated","value":"Kon de apparaatidentiteit van het horloge niet opslaan"}},"fa":{"stringUnit":{"state":"translated","value":"ذخیره هویت دستگاه ساعت ممکن نشد"}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось сохранить идентификационные данные часов"}},"sv":{"stringUnit":{"state":"translated","value":"Kunde inte spara klockans enhetsidentitet"}}}},
    "Could not secure queued messages before changing session settings.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Could not secure queued messages before changing session settings."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法在更改会话设置前安全保存排队中的消息。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法在變更工作階段設定前確保佇列中的訊息安全。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível proteger as mensagens na fila antes de alterar as configurações da sessão."}},"de":{"stringUnit":{"state":"translated","value":"Nachrichten in der Warteschlange konnten vor dem Ändern der Sitzungseinstellungen nicht gesichert werden."}},"es":{"stringUnit":{"state":"translated","value":"No se pudieron proteger los mensajes en cola antes de cambiar la configuración de la sesión."}},"ja-JP":{"stringUnit":{"state":"translated","value":"セッション設定の変更前に、キュー内のメッセージを保護できませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"세션 설정을 변경하기 전에 대기 중인 메시지를 안전하게 보관할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Impossible de sécuriser les messages en attente avant de modifier les paramètres de session."}},"hi":{"stringUnit":{"state":"translated","value":"सत्र की सेटिंग बदलने से पहले कतार में मौजूद संदेशों को सुरक्षित नहीं किया जा सका."}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر تأمين الرسائل في قائمة الانتظار قبل تغيير إعدادات الجلسة."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile mettere al sicuro i messaggi in coda prima di modificare le impostazioni della sessione."}},"tr":{"stringUnit":{"state":"translated","value":"Oturum ayarları değiştirilmeden önce sıradaki mesajlar güvenceye alınamadı."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося захистити повідомлення в черзі перед зміною налаштувань сеансу."}},"id":{"stringUnit":{"state":"translated","value":"Tidak dapat mengamankan pesan dalam antrean sebelum mengubah pengaturan sesi."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się zabezpieczyć wiadomości w kolejce przed zmianą ustawień sesji."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถรักษาความปลอดภัยของข้อความในคิวก่อนเปลี่ยนการตั้งค่าเซสชันได้."}},"vi":{"stringUnit":{"state":"translated","value":"Không thể bảo vệ các tin nhắn trong hàng đợi trước khi thay đổi cài đặt phiên."}},"nl":{"stringUnit":{"state":"translated","value":"Kon berichten in de wachtrij niet veiligstellen voordat de sessie-instellingen werden gewijzigd."}},"fa":{"stringUnit":{"state":"translated","value":"ایمن‌سازی پیام‌های در صف پیش از تغییر تنظیمات نشست ممکن نشد."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось защитить сообщения в очереди перед изменением настроек сеанса."}},"sv":{"stringUnit":{"state":"translated","value":"Kunde inte säkra köade meddelanden innan sessionsinställningarna ändrades."}}}},
    "Could not share this file.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Could not share this file."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法分享此文件。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法分享此檔案。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível compartilhar este arquivo."}},"de":{"stringUnit":{"state":"translated","value":"Diese Datei konnte nicht geteilt werden."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo compartir este archivo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このファイルを共有できませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"이 파일을 공유할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Impossible de partager ce fichier."}},"hi":{"stringUnit":{"state":"translated","value":"यह फ़ाइल साझा नहीं की जा सकी."}},"ar":{"stringUnit":{"state":"translated","value":"تعذّرت مشاركة هذا الملف."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile condividere questo file."}},"tr":{"stringUnit":{"state":"translated","value":"Bu dosya paylaşılamadı."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося поділитися цим файлом."}},"id":{"stringUnit":{"state":"translated","value":"Tidak dapat membagikan file ini."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się udostępnić tego pliku."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถแชร์ไฟล์นี้ได้."}},"vi":{"stringUnit":{"state":"translated","value":"Không thể chia sẻ tệp này."}},"nl":{"stringUnit":{"state":"translated","value":"Kon dit bestand niet delen."}},"fa":{"stringUnit":{"state":"translated","value":"اشتراک‌گذاری این فایل ممکن نشد."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось поделиться этим файлом."}},"sv":{"stringUnit":{"state":"translated","value":"Kunde inte dela den här filen."}}}},
    "Could not sign watch identity": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Could not sign watch identity"}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法对手表身份进行签名"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法簽署手錶身分"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível assinar a identidade do relógio"}},"de":{"stringUnit":{"state":"translated","value":"Die Identität der Watch konnte nicht signiert werden"}},"es":{"stringUnit":{"state":"translated","value":"No se pudo firmar la identidad del reloj"}},"ja-JP":{"stringUnit":{"state":"translated","value":"ウォッチの識別情報に署名できませんでした"}},"ko":{"stringUnit":{"state":"translated","value":"워치 ID에 서명할 수 없습니다"}},"fr":{"stringUnit":{"state":"translated","value":"Impossible de signer l’identité de la montre"}},"hi":{"stringUnit":{"state":"translated","value":"वॉच की पहचान पर हस्ताक्षर नहीं किए जा सके"}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر توقيع هوية الساعة"}},"it":{"stringUnit":{"state":"translated","value":"Impossibile firmare l’identità del Watch"}},"tr":{"stringUnit":{"state":"translated","value":"Saat kimliği imzalanamadı"}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося підписати ідентифікаційні дані годинника"}},"id":{"stringUnit":{"state":"translated","value":"Tidak dapat menandatangani identitas jam tangan"}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się podpisać tożsamości zegarka"}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถลงลายเซ็นข้อมูลระบุตัวตนของนาฬิกาได้"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể ký danh tính đồng hồ"}},"nl":{"stringUnit":{"state":"translated","value":"Kon de identiteit van het horloge niet ondertekenen"}},"fa":{"stringUnit":{"state":"translated","value":"امضای هویت ساعت ممکن نشد"}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось подписать идентификационные данные часов"}},"sv":{"stringUnit":{"state":"translated","value":"Kunde inte signera klockans identitet"}}}},
    "Could not start recording: %@": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Could not start recording: %@"}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法开始录音: %@"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法開始錄音: %@"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível iniciar a gravação: %@"}},"de":{"stringUnit":{"state":"translated","value":"Aufnahme konnte nicht gestartet werden: %@"}},"es":{"stringUnit":{"state":"translated","value":"No se pudo iniciar la grabación: %@"}},"ja-JP":{"stringUnit":{"state":"translated","value":"録音を開始できませんでした: %@"}},"ko":{"stringUnit":{"state":"translated","value":"녹음을 시작할 수 없습니다: %@"}},"fr":{"stringUnit":{"state":"translated","value":"Impossible de démarrer l’enregistrement: %@"}},"hi":{"stringUnit":{"state":"translated","value":"रिकॉर्डिंग शुरू नहीं की जा सकी: %@"}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر بدء التسجيل: %@"}},"it":{"stringUnit":{"state":"translated","value":"Impossibile avviare la registrazione: %@"}},"tr":{"stringUnit":{"state":"translated","value":"Kayıt başlatılamadı: %@"}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося почати запис: %@"}},"id":{"stringUnit":{"state":"translated","value":"Tidak dapat memulai perekaman: %@"}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się rozpocząć nagrywania: %@"}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถเริ่มบันทึกเสียงได้: %@"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể bắt đầu ghi âm: %@"}},"nl":{"stringUnit":{"state":"translated","value":"Kon de opname niet starten: %@"}},"fa":{"stringUnit":{"state":"translated","value":"شروع ضبط ممکن نشد: %@"}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось начать запись: %@"}},"sv":{"stringUnit":{"state":"translated","value":"Kunde inte starta inspelningen: %@"}}}},
    "Couldn't reach iPhone. Tap to retry.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Couldn't reach iPhone. Tap to retry."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法连接到 iPhone. 轻点以重试。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法連線至 iPhone. 點一下以重試。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível conectar ao iPhone. Toque para tentar novamente."}},"de":{"stringUnit":{"state":"translated","value":"Das iPhone konnte nicht erreicht werden. Zum erneuten Versuchen tippen."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo conectar con el iPhone. Toca para reintentar."}},"ja-JP":{"stringUnit":{"state":"translated","value":"iPhoneに接続できませんでした。 タップして再試行してください。"}},"ko":{"stringUnit":{"state":"translated","value":"iPhone에 연결할 수 없습니다. 탭하여 다시 시도하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Impossible de joindre l’iPhone. Touchez pour réessayer."}},"hi":{"stringUnit":{"state":"translated","value":"iPhone से संपर्क नहीं हो सका. फिर से कोशिश करने के लिए टैप करें."}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر الاتصال بـ iPhone. اضغط لإعادة المحاولة."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile raggiungere iPhone. Tocca per riprovare."}},"tr":{"stringUnit":{"state":"translated","value":"iPhone'a ulaşılamadı. Yeniden denemek için dokunun."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося зв’язатися з iPhone. Торкніться, щоб повторити спробу."}},"id":{"stringUnit":{"state":"translated","value":"Tidak dapat terhubung ke iPhone. Ketuk untuk mencoba lagi."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się połączyć z iPhone’em. Stuknij, aby spróbować ponownie."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถติดต่อ iPhone ได้. แตะเพื่อลองอีกครั้ง."}},"vi":{"stringUnit":{"state":"translated","value":"Không thể kết nối với iPhone. Chạm để thử lại."}},"nl":{"stringUnit":{"state":"translated","value":"Kon de iPhone niet bereiken. Tik om het opnieuw te proberen."}},"fa":{"stringUnit":{"state":"translated","value":"اتصال به iPhone ممکن نشد. برای تلاش دوباره ضربه بزنید."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось связаться с iPhone. Нажмите, чтобы повторить попытку."}},"sv":{"stringUnit":{"state":"translated","value":"Kunde inte nå iPhone. Tryck för att försöka igen."}}}},
    "Couldn't save this Watch message. Try again when storage is available.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Couldn't save this Watch message. Try again when storage is available."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法保存此 Watch 消息。 请在有可用存储空间时重试。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法儲存此 Watch 訊息。 請在有可用儲存空間時再試一次。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível salvar esta mensagem do Watch. Tente novamente quando houver espaço de armazenamento disponível."}},"de":{"stringUnit":{"state":"translated","value":"Diese Watch-Nachricht konnte nicht gespeichert werden. Versuchen Sie es erneut, wenn Speicherplatz verfügbar ist."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo guardar este mensaje del Watch. Inténtalo de nuevo cuando haya espacio de almacenamiento disponible."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このWatchのメッセージを保存できませんでした。 ストレージに空きができたら再試行してください。"}},"ko":{"stringUnit":{"state":"translated","value":"이 Watch 메시지를 저장할 수 없습니다. 저장 공간이 확보되면 다시 시도하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Impossible d’enregistrer ce message de la Watch. Réessayez lorsque de l’espace de stockage sera disponible."}},"hi":{"stringUnit":{"state":"translated","value":"Watch का यह संदेश सहेजा नहीं जा सका. स्टोरेज उपलब्ध होने पर फिर से कोशिश करें."}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر حفظ رسالة الساعة هذه. حاول مجددًا عند توفّر مساحة تخزين."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile salvare questo messaggio del Watch. Riprova quando sarà disponibile spazio di archiviazione."}},"tr":{"stringUnit":{"state":"translated","value":"Bu Watch mesajı kaydedilemedi. Depolama alanı kullanılabilir olduğunda tekrar deneyin."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося зберегти це повідомлення Watch. Спробуйте ще раз, коли буде доступне місце в сховищі."}},"id":{"stringUnit":{"state":"translated","value":"Tidak dapat menyimpan pesan Watch ini. Coba lagi saat ruang penyimpanan tersedia."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się zapisać tej wiadomości z Watch. Spróbuj ponownie, gdy będzie dostępne miejsce na dane."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถบันทึกข้อความจาก Watch นี้ได้. ลองอีกครั้งเมื่อมีพื้นที่จัดเก็บว่าง."}},"vi":{"stringUnit":{"state":"translated","value":"Không thể lưu tin nhắn Watch này. Hãy thử lại khi có dung lượng lưu trữ trống."}},"nl":{"stringUnit":{"state":"translated","value":"Kon dit Watch-bericht niet opslaan. Probeer het opnieuw wanneer er opslagruimte beschikbaar is."}},"fa":{"stringUnit":{"state":"translated","value":"ذخیره این پیام Watch ممکن نشد. وقتی فضای ذخیره‌سازی در دسترس بود، دوباره تلاش کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось сохранить это сообщение с Watch. Повторите попытку, когда появится свободное место."}},"sv":{"stringUnit":{"state":"translated","value":"Kunde inte spara det här Watch-meddelandet. Försök igen när lagringsutrymme finns tillgängligt."}}}},
    "Couldn't speak the reply. Read it in Chat.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Couldn't speak the reply. Read it in Chat."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法朗读回复。 请在聊天中阅读。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法朗讀回覆。 請在聊天中閱讀。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível ler a resposta em voz alta. Leia no Chat."}},"de":{"stringUnit":{"state":"translated","value":"Die Antwort konnte nicht vorgelesen werden. Lesen Sie sie im Chat."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo leer la respuesta en voz alta. Léela en Chat."}},"ja-JP":{"stringUnit":{"state":"translated","value":"返信を読み上げられませんでした。 チャットで確認してください。"}},"ko":{"stringUnit":{"state":"translated","value":"답변을 음성으로 읽을 수 없습니다. 채팅에서 확인하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Impossible de lire la réponse à voix haute. Lisez-la dans Discussion."}},"hi":{"stringUnit":{"state":"translated","value":"जवाब बोलकर सुनाया नहीं जा सका. इसे चैट में पढ़ें."}},"ar":{"stringUnit":{"state":"translated","value":"تعذّرت قراءة الرد بصوت عالٍ. اقرأه في الدردشة."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile leggere la risposta ad alta voce. Leggila in Chat."}},"tr":{"stringUnit":{"state":"translated","value":"Yanıt seslendirilemedi. Sohbet'te okuyun."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося озвучити відповідь. Прочитайте її в Чаті."}},"id":{"stringUnit":{"state":"translated","value":"Tidak dapat membacakan balasan. Baca di Obrolan."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się odczytać odpowiedzi na głos. Przeczytaj ją na Czacie."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถอ่านออกเสียงข้อความตอบกลับได้. อ่านข้อความได้ในแชท."}},"vi":{"stringUnit":{"state":"translated","value":"Không thể đọc câu trả lời thành tiếng. Hãy đọc trong Trò chuyện."}},"nl":{"stringUnit":{"state":"translated","value":"Kon het antwoord niet voorlezen. Lees het in Chat."}},"fa":{"stringUnit":{"state":"translated","value":"خواندن پاسخ با صدا ممکن نشد. آن را در گفتگو بخوانید."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось озвучить ответ. Прочитайте его в Чате."}},"sv":{"stringUnit":{"state":"translated","value":"Kunde inte läsa upp svaret. Läs det i Chatten."}}}},
