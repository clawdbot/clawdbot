    "Some sessions could not be loaded. Refresh to try again.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Some sessions could not be loaded. Refresh to try again."}},"zh-CN":{"stringUnit":{"state":"translated","value":"部分会话无法加载。 请刷新后重试。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"部分工作階段無法載入。 請重新整理後再試。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível carregar algumas sessões. Atualize para tentar novamente."}},"de":{"stringUnit":{"state":"translated","value":"Einige Sitzungen konnten nicht geladen werden. Zum erneuten Versuch aktualisieren."}},"es":{"stringUnit":{"state":"translated","value":"No se pudieron cargar algunas sesiones. Actualiza para volver a intentarlo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"一部のセッションを読み込めませんでした。 更新して再試行してください。"}},"ko":{"stringUnit":{"state":"translated","value":"일부 세션을 불러오지 못했습니다. 새로고침하여 다시 시도하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Certaines sessions n’ont pas pu être chargées. Actualisez pour réessayer."}},"hi":{"stringUnit":{"state":"translated","value":"कुछ सत्र लोड नहीं हो सके. फिर से प्रयास करने के लिए रीफ़्रेश करें."}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر تحميل بعض الجلسات. حدّث للمحاولة مجددًا."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile caricare alcune sessioni. Aggiorna per riprovare."}},"tr":{"stringUnit":{"state":"translated","value":"Bazı oturumlar yüklenemedi. Tekrar denemek için yenileyin."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося завантажити деякі сеанси. Оновіть, щоб спробувати ще раз."}},"id":{"stringUnit":{"state":"translated","value":"Beberapa sesi tidak dapat dimuat. Segarkan untuk mencoba lagi."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się wczytać niektórych sesji. Odśwież, aby spróbować ponownie."}},"th":{"stringUnit":{"state":"translated","value":"โหลดบางเซสชันไม่ได้. รีเฟรชเพื่อลองอีกครั้ง."}},"vi":{"stringUnit":{"state":"translated","value":"Không thể tải một số phiên. Làm mới để thử lại."}},"nl":{"stringUnit":{"state":"translated","value":"Sommige sessies konden niet worden geladen. Vernieuw om het opnieuw te proberen."}},"fa":{"stringUnit":{"state":"translated","value":"برخی نشست‌ها بارگیری نشدند. برای تلاش دوباره، تازه‌سازی کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось загрузить некоторые сеансы. Обновите, чтобы повторить попытку."}},"sv":{"stringUnit":{"state":"translated","value":"Vissa sessioner kunde inte läsas in. Uppdatera för att försöka igen."}}}},
