    "Discovered Gateways": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Discovered Gateways"}},"zh-CN":{"stringUnit":{"state":"translated","value":"发现的 Gateway"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已探索到的 Gateway"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Gateways Descobertos"}},"de":{"stringUnit":{"state":"translated","value":"Gefundene Gateways"}},"es":{"stringUnit":{"state":"translated","value":"Gateways detectados"}},"ja-JP":{"stringUnit":{"state":"translated","value":"検出されたGateway"}},"ko":{"stringUnit":{"state":"translated","value":"발견된 Gateway"}},"fr":{"stringUnit":{"state":"translated","value":"Gateways détectés"}},"hi":{"stringUnit":{"state":"translated","value":"खोजे गए Gateway"}},"ar":{"stringUnit":{"state":"translated","value":"بوابات Gateway المكتشفة"}},"it":{"stringUnit":{"state":"translated","value":"Gateway rilevati"}},"tr":{"stringUnit":{"state":"translated","value":"Keşfedilen Gateway'ler"}},"uk":{"stringUnit":{"state":"translated","value":"Виявлені Gateway"}},"id":{"stringUnit":{"state":"translated","value":"Gateway yang Ditemukan"}},"pl":{"stringUnit":{"state":"translated","value":"Wykryte instancje Gateway"}},"th":{"stringUnit":{"state":"translated","value":"Gateway ที่ค้นพบ"}},"vi":{"stringUnit":{"state":"translated","value":"Các Gateway đã phát hiện"}},"nl":{"stringUnit":{"state":"translated","value":"Gevonden Gateways"}},"fa":{"stringUnit":{"state":"translated","value":"Gatewayهای کشف‌شده"}},"ru":{"stringUnit":{"state":"translated","value":"Обнаруженные Gateway"}},"sv":{"stringUnit":{"state":"translated","value":"Upptäckta Gateway"}}}},
    "Discovered gateways and manual setup live here when the gateway has not connected yet.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Discovered gateways and manual setup live here when the gateway has not connected yet."}},"zh-CN":{"stringUnit":{"state":"translated","value":"尚未连接网关时, 已发现的网关和手动设置选项会显示在这里。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"尚未連上 Gateway 時，這裡會顯示已探索到的 Gateway 和手動設定選項。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Os gateways descobertos e a configuração manual ficam aqui enquanto o gateway ainda não estiver conectado."}},"de":{"stringUnit":{"state":"translated","value":"Hier finden Sie gefundene Gateways und die manuelle Einrichtung, solange das Gateway noch nicht verbunden ist."}},"es":{"stringUnit":{"state":"translated","value":"Aquí aparecen los Gateways detectados y la configuración manual cuando el Gateway aún no se ha conectado."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayがまだ接続されていない場合、検出されたGatewayと手動設定がここに表示されます。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway가 아직 연결되지 않은 경우 발견된 Gateway와 수동 설정이 여기에 표시됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les Gateways détectés et la configuration manuelle s’affichent ici lorsque le Gateway n’est pas encore connecté."}},"hi":{"stringUnit":{"state":"translated","value":"जब Gateway अभी तक कनेक्ट नहीं हुआ हो, तो खोजे गए Gateway और मैन्युअल सेटअप यहाँ उपलब्ध होते हैं."}},"ar":{"stringUnit":{"state":"translated","value":"تظهر هنا البوابات المكتشفة وخيارات الإعداد اليدوي عندما لا تكون البوابة قد اتصلت بعد."}},"it":{"stringUnit":{"state":"translated","value":"Qui trovi i Gateway rilevati e la configurazione manuale quando il Gateway non è ancora connesso."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway henüz bağlanmadığında keşfedilen Gateway'ler ve manuel kurulum burada yer alır."}},"uk":{"stringUnit":{"state":"translated","value":"Тут відображаються виявлені шлюзи та ручне налаштування, поки шлюз ще не підключено."}},"id":{"stringUnit":{"state":"translated","value":"Gateway yang ditemukan dan penyiapan manual tersedia di sini saat Gateway belum terhubung."}},"pl":{"stringUnit":{"state":"translated","value":"Tutaj znajdziesz wykryte instancje Gateway i konfigurację ręczną, gdy połączenie z Gateway nie zostało jeszcze nawiązane."}},"th":{"stringUnit":{"state":"translated","value":"Gateway ที่ค้นพบและการตั้งค่าด้วยตนเองจะแสดงที่นี่เมื่อยังไม่ได้เชื่อมต่อกับ Gateway."}},"vi":{"stringUnit":{"state":"translated","value":"Các Gateway đã phát hiện và phần thiết lập thủ công hiển thị ở đây khi Gateway chưa kết nối."}},"nl":{"stringUnit":{"state":"translated","value":"Hier vind je gevonden gateways en de handmatige configuratie zolang de gateway nog niet verbonden is."}},"fa":{"stringUnit":{"state":"translated","value":"وقتی هنوز اتصال به دروازه برقرار نشده است، دروازه‌های کشف‌شده و راه‌اندازی دستی در اینجا نمایش داده می‌شوند."}},"ru":{"stringUnit":{"state":"translated","value":"Пока подключение к шлюзу не установлено, здесь отображаются обнаруженные шлюзы и ручная настройка."}},"sv":{"stringUnit":{"state":"translated","value":"Upptäckta gateways och manuell konfiguration visas här när gatewayen inte har anslutit ännu."}}}},
