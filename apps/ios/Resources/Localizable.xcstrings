    "Install the OpenClaw watch app before enabling direct mode.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Install the OpenClaw watch app before enabling direct mode."}},"zh-CN":{"stringUnit":{"state":"translated","value":"启用直连模式前，请先安装 OpenClaw 手表应用。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"啟用直接模式前, 請先安裝 OpenClaw 手錶應用程式。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Instale o app OpenClaw para relógio antes de ativar o modo direto."}},"de":{"stringUnit":{"state":"translated","value":"Installieren Sie die OpenClaw-App für die Watch, bevor Sie den Direktmodus aktivieren."}},"es":{"stringUnit":{"state":"translated","value":"Instala la app de OpenClaw para el reloj antes de habilitar el modo directo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ダイレクトモードを有効にする前に、OpenClawのウォッチアプリをインストールしてください。"}},"ko":{"stringUnit":{"state":"translated","value":"직접 모드를 활성화하기 전에 OpenClaw 워치 앱을 설치하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Installez l’application OpenClaw pour montre avant d’activer le mode direct."}},"hi":{"stringUnit":{"state":"translated","value":"डायरेक्ट मोड सक्षम करने से पहले OpenClaw वॉच ऐप इंस्टॉल करें."}},"ar":{"stringUnit":{"state":"translated","value":"ثبّت تطبيق OpenClaw للساعة قبل تفعيل الوضع المباشر."}},"it":{"stringUnit":{"state":"translated","value":"Installa l'app OpenClaw sull'orologio prima di abilitare la modalità diretta."}},"tr":{"stringUnit":{"state":"translated","value":"Doğrudan modu etkinleştirmeden önce OpenClaw saat uygulamasını yükleyin."}},"uk":{"stringUnit":{"state":"translated","value":"Встановіть застосунок OpenClaw для годинника, перш ніж увімкнути прямий режим."}},"id":{"stringUnit":{"state":"translated","value":"Instal aplikasi jam tangan OpenClaw sebelum mengaktifkan mode langsung."}},"pl":{"stringUnit":{"state":"translated","value":"Zainstaluj aplikację OpenClaw na zegarku przed włączeniem trybu bezpośredniego."}},"th":{"stringUnit":{"state":"translated","valu