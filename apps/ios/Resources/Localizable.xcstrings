    "Voice decoding failed.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Voice decoding failed."}},"zh-CN":{"stringUnit":{"state":"translated","value":"语音解码失败。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語音解碼失敗。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Falha na decodificação de voz."}},"de":{"stringUnit":{"state":"translated","value":"Die Sprachdekodierung ist fehlgeschlagen."}},"es":{"stringUnit":{"state":"translated","value":"Falló la decodificación de voz."}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声のデコードに失敗しました。"}},"ko":{"stringUnit":{"state":"translated","value":"음성 디코딩에 실패했습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Échec du décodage vocal."}},"hi":{"stringUnit":{"state":"translated","value":"वॉइस डिकोडिंग विफल रही।"}},"ar":{"stringUnit":{"state":"translated","value":"فشل فك ترميز الصوت."}},"it":{"stringUnit":{"state":"translated","value":"Decodifica vocale non riuscita."}},"tr":{"stringUnit":{"state":"translated","value":"Ses kod çözme işlemi başarısız oldu."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося декодувати голосове аудіо."}},"id":{"stringUnit":{"state":"translated","value":"Pendekodean suara gagal."}},"pl":{"stringUnit":{"state":"translated","value":"Dekodowanie głosu nie powiodło się."}},"th":{"stringUnit":{"state":"translated","value":"ถอดรหัสเสียงไม่สำเร็จ"}},"vi":{"stringUnit":{"state":"translated","value":"Giải mã giọng nói thất bại."}},"nl":{"stringUnit":{"state":"translated","value":"Het decoderen van spraak is mislukt."}},"fa":{"stringUnit":{"state":"translated","value":"رمزگشایی حالت صوتی ناموفق بود."}},"ru":{"stringUnit":{"state":"translated","value":"Ошибка декодирования голоса."}},"sv":{"stringUnit":{"state":"translated","value":"Röstavkodningen misslyckades."}}}},
    "Voice did not connect. Check your network and try again.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Voice did not connect. Check your network and try again."}},"zh-CN":{"stringUnit":{"state":"translated","value":"语音未能连接。请检查网络后重试。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語音未能連線。請檢查網路後再試一次。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O recurso de voz não conseguiu se conectar. Verifique sua rede e tente novamente."}},"de":{"stringUnit":{"state":"translated","value":"Die Sprachverbindung konnte nicht hergestellt werden. Prüfen Sie Ihr Netzwerk und versuchen Sie es erneut."}},"es":{"stringUnit":{"state":"translated","value":"La función de voz no se conectó. Comprueba tu conexión de red e inténtalo de nuevo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声接続に失敗しました。ネットワークを確認して、もう一度お試しください。"}},"ko":{"stringUnit":{"state":"translated","value":"음성 연결에 실패했습니다. 네트워크를 확인하고 다시 시도하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Le mode vocal n’a pas pu se connecter. Vérifiez votre réseau et réessayez."}},"hi":{"stringUnit":{"state":"translated","value":"वॉइस कनेक्ट नहीं हुआ। अपना नेटवर्क जाँचें और फिर से प्रयास करें।"}},"ar":{"stringUnit":{"state":"translated","value":"لم يتم الاتصال الصوتي. تحقّق من الشبكة وحاول مجددًا."}},"it":{"stringUnit":{"state":"translated","value":"La modalità vocale non si è connessa. Controlla la rete e riprova."}},"tr":{"stringUnit":{"state":"translated","value":"Sesli iletişim bağlantısı kurulamadı. Ağınızı kontrol edip tekrar deneyin."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося встановити голосове з’єднання. Перевірте мережу та спробуйте ще раз."}},"id":{"stringUnit":{"state":"translated","value":"Fitur suara tidak terhubung. Periksa jaringan Anda dan coba lagi."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się nawiązać połączenia głosowego. Sprawdź połączenie sieciowe i spróbuj ponownie."}},"th":{"stringUnit":{"state":"translated","value":"เชื่อมต่อฟีเจอร์เสียงไม่สำเร็จ ตรวจสอบเครือข่ายแล้วลองอีกครั้ง"}},"vi":{"stringUnit":{"state":"translated","value":"Tính năng giọng nói không kết nối được. Kiểm tra mạng của bạn rồi thử lại."}},"nl":{"stringUnit":{"state":"translated","value":"De spraakfunctie kon geen verbinding maken. Controleer je netwerk en probeer het opnieuw."}},"fa":{"stringUnit":{"state":"translated","value":"حالت صوتی متصل نشد. شبکهٔ خود را بررسی کنید و دوباره تلاش کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось установить голосовое соединение. Проверьте сеть и повторите попытку."}},"sv":{"stringUnit":{"state":"translated","value":"Röstfunktionen kunde inte ansluta. Kontrollera nätverket och försök igen."}}}},
    "Voice encoding failed.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Voice encoding failed."}},"zh-CN":{"stringUnit":{"state":"translated","value":"语音编码失败。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語音編碼失敗。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Falha na codificação de voz."}},"de":{"stringUnit":{"state":"translated","value":"Die Sprachkodierung ist fehlgeschlagen."}},"es":{"stringUnit":{"state":"translated","value":"Falló la codificación de voz."}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声のエンコードに失敗しました。"}},"ko":{"stringUnit":{"state":"translated","value":"음성 인코딩에 실패했습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Échec de l’encodage vocal."}},"hi":{"stringUnit":{"state":"translated","value":"वॉइस एन्कोडिंग विफल रही।"}},"ar":{"stringUnit":{"state":"translated","value":"فشل ترميز الصوت."}},"it":{"stringUnit":{"state":"translated","value":"Codifica vocale non riuscita."}},"tr":{"stringUnit":{"state":"translated","value":"Ses kodlama işlemi başarısız oldu."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося закодувати голосове аудіо."}},"id":{"stringUnit":{"state":"translated","value":"Pengodean suara gagal."}},"pl":{"stringUnit":{"state":"translated","value":"Kodowanie głosu nie powiodło się."}},"th":{"stringUnit":{"state":"translated","value":"เข้ารหัสเสียงไม่สำเร็จ"}},"vi":{"stringUnit":{"state":"translated","value":"Mã hóa giọng nói thất bại."}},"nl":{"stringUnit":{"state":"translated","value":"Het coderen van spraak is mislukt."}},"fa":{"stringUnit":{"state":"translated","value":"کدگذاری حالت صوتی ناموفق بود."}},"ru":{"stringUnit":{"state":"translated","value":"Ошибка кодирования голоса."}},"sv":{"stringUnit":{"state":"translated","value":"Röstkodningen misslyckades."}}}},
    "Voice encountered an error. Try speaking again.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Voice encountered an error. Try speaking again."}},"zh-CN":{"stringUnit":{"state":"translated","value":"语音功能遇到错误。请再说一次。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語音功能發生錯誤。請再說一次。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ocorreu um erro no recurso de voz. Tente falar novamente."}},"de":{"stringUnit":{"state":"translated","value":"Bei der Sprachfunktion ist ein Fehler aufgetreten. Versuchen Sie erneut zu sprechen."}},"es":{"stringUnit":{"state":"translated","value":"Se produjo un error en la función de voz. Intenta hablar de nuevo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声機能でエラーが発生しました。もう一度話しかけてください。"}},"ko":{"stringUnit":{"state":"translated","value":"음성 기능에 오류가 발생했습니다. 다시 말해 보세요."}},"fr":{"stringUnit":{"state":"translated","value":"Le mode vocal a rencontré une erreur. Essayez de parler à nouveau."}},"hi":{"stringUnit":{"state":"translated","value":"वॉइस में त्रुटि आई। फिर से बोलने का प्रयास करें।"}},"ar":{"stringUnit":{"state":"translated","value":"واجهت الميزة الصوتية خطأً. حاول التحدث مجددًا."}},"it":{"stringUnit":{"state":"translated","value":"Si è verificato un errore nella modalità vocale. Prova a parlare di nuovo."}},"tr":{"stringUnit":{"state":"translated","value":"Sesli iletişimde bir hata oluştu. Tekrar konuşmayı deneyin."}},"uk":{"stringUnit":{"state":"translated","value":"У голосовому режимі сталася помилка. Спробуйте заговорити ще раз."}},"id":{"stringUnit":{"state":"translated","value":"Fitur suara mengalami kesalahan. Coba bicara lagi."}},"pl":{"stringUnit":{"state":"translated","value":"W trybie głosowym wystąpił błąd. Spróbuj powiedzieć coś ponownie."}},"th":{"stringUnit":{"state":"translated","value":"ฟีเจอร์เสียงพบข้อผิดพลาด ลองพูดอีกครั้ง"}},"vi":{"stringUnit":{"state":"translated","value":"Tính năng giọng nói gặp lỗi. Hãy thử nói lại."}},"nl":{"stringUnit":{"state":"translated","v