    "Trust this gateway?": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Trust this gateway?"}},"zh-CN":{"stringUnit":{"state":"translated","value":"信任此网关？"}},"zh-TW":{"stringUnit":{"state":"translated","value":"要信任此 gateway 嗎？"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Confiar neste gateway?"}},"de":{"stringUnit":{"state":"translated","value":"Diesem Gateway vertrauen?"}},"es":{"stringUnit":{"state":"translated","value":"¿Confiar en este gateway?"}},"ja-JP":{"stringUnit":{"state":"translated","value":"このゲートウェイを信頼しますか？"}},"ko":{"stringUnit":{"state":"translated","value":"이 게이트웨이를 신뢰할까요?"}},"fr":{"stringUnit":{"state":"translated","value":"Faire confiance à cette passerelle ?"}},"hi":{"stringUnit":{"state":"translated","value":"इस गेटवे पर विश्वास करें?"}},"ar":{"stringUnit":{"state":"translated","value":"هل تثق بهذه البوابة؟"}},"it":{"stringUnit":{"state":"translated","value":"Considerare attendibile questo gateway?"}},"tr":{"stringUnit":{"state":"translated","value":"Bu gateway’e güvenilsin mi?"}},"uk":{"stringUnit":{"state":"translated","value":"Довіряти цьому шлюзу?"}},"id":{"stringUnit":{"state":"translated","value":"Percayai Gateway ini?"}},"pl":{"stringUnit":{"state":"translated","value":"Zaufać temu gatewayowi?"}},"th":{"stringUnit":{"state":"translated","value":"เชื่อถือเกตเวย์นี้หรือไม่?"}},"vi":{"stringUnit":{"state":"translated","value":"Tin cậy gateway này?"}},"nl":{"stringUnit":{"state":"translated","value":"Deze gateway vertrouwen?"}},"fa":{"stringUnit":{"state":"translated","value":"به این Gateway اعتماد می‌کنید?"}},"ru":{"stringUnit":{"state":"translated","value":"Доверять этому шлюзу?"}},"sv":{"stringUnit":{"state":"translated","value":"Lita på denna gateway?"}}}},
    "Try Again": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Try Again"}},"zh-CN":{"stringUnit":{"state":"translated","value":"重试"}},"zh-TW":{"stringUnit":{"state":"translated","value":"再試一次"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Tentar novamente"}},"de":{"stringUnit":{"state":"translated","value":"Erneut versuchen"}},"es":{"stringUnit":{"state":"translated","value":"Volver a intentarlo"}},"ja-JP":{"stringUnit":{"state":"translated","value":"再試行"}},"ko":{"stringUnit":{"state":"translated","value":"다시 시도"}},"fr":{"stringUnit":{"state":"translated","value":"Réessayer"}},"hi":{"stringUnit":{"state":"translated","value":"फिर से कोशिश करें"}},"ar":{"stringUnit":{"state":"translated","value":"حاول مجددًا"}},"it":{"stringUnit":{"state":"translated","value":"Riprova"}},"tr":{"stringUnit":{"state":"translated","value":"Tekrar dene"}},"uk":{"stringUnit":{"state":"translated","value":"Спробувати знову"}},"id":{"stringUnit":{"state":"translated","value":"Coba Lagi"}},"pl":{"stringUnit":{"state":"translated","value":"Spróbuj ponownie"}},"th":{"stringUnit":{"state":"translated","value":"ลองอีกครั้ง"}},"vi":{"stringUnit":{"state":"translated","value":"Thử lại"}},"nl":{"stringUnit":{"state":"translated","value":"Opnieuw proberen"}},"fa":{"stringUnit":{"state":"translated","value":"تلاش دوباره"}},"ru":{"stringUnit":{"state":"translated","value":"Повторить попытку"}},"sv":{"stringUnit":{"state":"translated","value":"Försök igen"}}}},
    "Try again": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Try again"}},"zh-CN":{"stringUnit":{"state":"translated","value":"重试"}},"zh-TW":{"stringUnit":{"state":"translated","value":"再試一次"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Tentar novamente"}},"de":{"stringUnit":{"state":"translated","value":"Erneut versuchen"}},"es":{"stringUnit":{"state":"translated","value":"Volver a intentar"}},"ja-JP":{"stringUnit":{"state":"translated","value":"再試行"}},"ko":{"stringUnit":{"state":"translated","value":"다시 시도"}},"fr":{"stringUnit":{"state":"translated","value":"Réessayer"}},"hi":{"stringUnit":{"state":"translated","value":"फिर से कोशिश करें"}},"ar":{"stringUnit":{"state":"translated","value":"حاول مجددًا"}},"it":{"stringUnit":{"state":"translated","value":"Riprova"}},"tr":{"stringUnit":{"state":"translated","value":"Tekrar dene"}},"uk":{"stringUnit":{"state":"translated","value":"Спробувати ще раз"}},"id":{"stringUnit":{"state":"translated","value":"Coba lagi"}},"pl":{"stringUnit":{"state":"translated","value":"Spróbuj ponownie"}},"th":{"stringUnit":{"state":"translated","value":"ลองอีกครั้ง"}},"vi":{"stringUnit":{"state":"translated","value":"Thử lại"}},"nl":{"stringUnit":{"state":"translated","value":"Opnieuw proberen"}},"fa":{"stringUnit":{"state":"translated","value":"دوباره تلاش کنید"}},"ru":{"stringUnit":{"state":"translated","value":"Попробовать снова"}},"sv":{"stringUnit":{"state":"translated","value":"Försök igen"}}}},
    "Try again after the gateway reconnects.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Try again after the gateway reconnects."}},"zh-CN":{"stringUnit":{"state":"translated","value":"请在 Gateway 重新连接后重试。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"請在 Gateway 重新連線後再試一次。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Tente novamente após a reconexão do Gateway."}},"de":{"stringUnit":{"state":"translated","value":"Versuchen Sie es erneut, sobald die Verbindung zum Gateway wiederhergestellt ist."}},"es":{"stringUnit":{"state":"translated","value":"Inténtalo de nuevo cuando el Gateway se vuelva a conectar."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gateway が再接続した後にもう一度お試しください。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway가 다시 연결된 후 다시 시도하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Réessayez après la reconnexion du Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway के फिर से कनेक्ट होने के बाद दोबारा कोशिश करें."}},"ar":{"stringUnit":{"state":"translated","value":"حاول مجددًا بعد إعادة اتصال Gateway."}},"it":{"stringUnit":{"state":"translated","value":"Riprova dopo la riconnessione del gateway."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway yeniden bağlandıktan sonra tekrar deneyin."}},"uk":{"stringUnit":{"state":"translated","value":"Спробуйте ще раз після відновлення з’єднання з Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Coba lagi setelah Gateway terhubung kembali."}},"pl":{"stringUnit":{"state":"translated","value":"Spróbuj ponownie po ponownym połączeniu z Gateway."}},"th":{"stringUnit":{"state":"translated","value":"ลองอีกครั้งหลังจาก Gateway เชื่อมต่อใหม่แล้ว."}},"vi":{"stringUnit":{"state":"translated","value":"Thử lại sau khi Gateway kết nối lại."}},"nl":{"stringUnit":{"state":"translated","value":"Probeer het opnieuw nadat de gateway opnieuw verbinding heeft gemaakt."}},"fa":{"stringUnit":{"state":"translated","value":"پس از اتصال مجدد Gateway دوباره تلاش کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Повторите попытку после восстановления подключения к Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Försök igen när Gateway har återanslutit."}}}},
    "Try another search or clear the agent filters.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Try another search or clear the agent filters."}},"zh-CN":{"stringUnit":{"state":"translated","value":"请尝试其他搜索或清除智能体筛选条件。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"請嘗試其他搜尋條件或清除代理程式篩選條件。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Tente outra busca ou limpe os filtros de agentes."}},"de":{"stringUnit":{"state":"translated","value":"Versuchen Sie eine andere Suche oder setzen Sie die Agentenfilter zurück."}},"es":{"stringUnit":{"state":"translated","value":"Prueba otra búsqueda o borra los filtros de agentes."}},"ja-JP":{"stringUnit":{"state":"translated","value":"別の検索を試すか、エージェントのフィルターをクリアしてください。"}},"ko":{"stringUnit":{"state":"translated","value":"다른 검색어를 사용하거나 에이전트 필터를 해제하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Essayez une autre recherche ou effacez les filtres d’agents."}},"hi":{"stringUnit":{"state":"translated","value":"कोई और खोज आज़माएँ या एजेंट फ़िल्टर हटाएँ."}},"ar":{"stringUnit":{"state":"translated","value":"جرّب بحثًا آخر أو امسح عوامل تصفية الوكلاء."}},"it":{"stringUnit":{"state":"translated","value":"Prova un'altra ricerca o cancella i filtri degli agenti."}},"tr":{"stringUnit":{"state":"translated","value":"Başka bir arama deneyin veya ajan filtrelerini temizleyin."}},"uk":{"stringUnit":{"state":"translated","value":"Спробуйте інший пошуковий запит або скиньте фільтри агентів."}},"id":{"stringUnit":{"state":"translated","value":"Coba pencarian lain atau hapus filter agen."}},"pl":{"stringUnit":{"state":"translated","value":"Spróbuj innego wyszukiwania lub wyczyść filtry agentów."}},"th":{"stringUnit":{"state":"translated","value":"ลองค้นหาด้วยคำอื่นหรือล้างตัวกรองเอเจนต์."}},"vi":{"stringUnit":{"state":"translated","value":"Thử tìm kiếm khác hoặc xóa bộ lọc tác nhân."}},"nl":{"stringUnit":{"state":"translated","value":"Probeer een andere zoekopdracht of wis de agentfilters."}},"fa":{"stringUnit":{"state":"translated","value":"جستجوی دیگری را امتحان کنید یا فیلترهای عامل را پاک کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Попробуйте другой поисковый запрос или сбросьте фильтры агентов."}},"sv":{"stringUnit":{"state":"translated","value":"Prova en annan sökning eller rensa agentfiltren."}}}},
    "Turn interrupted by a gateway restart — asked the agent to resume and finish the response.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Turn interrupted by a gateway restart — asked the agent to resume and finish the response."}},"zh-CN":{"stringUnit":{"state":"translated","value":"本轮对话因 Gateway 重启而中断 — 已请求智能体继续并完成回复。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"回合因 Gateway 重新啟動而中斷 — 已要求代理程式繼續並完成回覆。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Turno interrompido por uma reinicialização do Gateway — foi solicitado ao agente que retomasse e concluísse a resposta."}},"de":{"stringUnit":{"state":"translated","value":"Durchgang durch einen Gateway-Neustart unterbrochen — der Agent wurde aufgefordert, fortzufahren und die Antwort abzuschließen."}},"es":{"stringUnit":{"state":"translated","value":"Turno interrumpido por un reinicio del Gateway — se le pidió al agente que reanudara y terminara la respuesta."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gateway の再起動によりターンが中断されました — エージェントに応答を再開して完了するよう依頼しました。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway 재시작으로 턴이 중단되었습니다 — 에이전트에게 응답을 재개하고 완료하도록 요청했습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Tour interrompu par un redémarrage du Gateway — l’agent a été invité à reprendre et à terminer la réponse."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway के रीस्टार्ट होने से बारी बाधित हुई — एजेंट से जवाब फिर से शुरू करके पूरा करने को कहा गया."}},"ar":{"stringUnit":{"state":"translated","value":"انقطعت الجولة بسبب إعادة تشغيل Gateway — طُلب من الوكيل استئناف الرد وإكماله."}},"it":{"stringUnit":{"state":"translated","value":"Turno interrotto da un riavvio del gateway — è stato chiesto all'agente di riprendere e completare la risposta."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway yeniden başlatıldığı için tur kesintiye uğradı — ajandan devam edip yanıtı tamamlaması istendi."}},"uk":{"stringUnit":{"state":"translated","value":"Хід перервано через перезапуск Gateway — агенту надіслано запит на відновлення та завершення відповіді."}},"id":{"stringUnit":{"state":"translated","value":"Giliran terinterupsi karena Gateway dimulai ulang — agen telah diminta untuk melanjutkan dan menyelesaikan respons."}},"pl":{"stringUnit":{"state":"translated","value":"Tura przerwana przez ponowne uruchomienie Gateway — wysłano do agenta prośbę o wznowienie i dokończenie odpowiedzi."}},"th":{"stringUnit":{"state":"translated","value":"รอบการสนทนาถูกขัดจังหวะเนื่องจาก Gateway เริ่มระบบใหม่ — ขอให้เอเจนต์ดำเนินการต่อและตอบให้เสร็จแล้ว."}},"vi":{"stringUnit":{"state":"translated","value":"Lượt bị gián đoạn do Gateway khởi động lại — đã yêu cầu tác nhân tiếp tục và hoàn tất phản hồi."}},"nl":{"stringUnit":{"state":"translated","value":"Beurt onderbroken door een herstart van de gateway — de agent is gevraagd het antwoord te hervatten en af te maken."}},"fa":{"stringUnit":{"state":"translated","value":"نوبت به‌دلیل راه‌اندازی مجدد Gateway قطع شد — از عامل خواسته شد پاسخ را ادامه دهد و تکمیل کند."}},"ru":{"stringUnit":{"state":"translated","value":"Ход прерван перезапуском Gateway — агенту отправлен запрос на возобновление и завершение ответа."}},"sv":{"stringUnit":{"state":"translated","value":"Turen avbröts av en omstart av Gateway — agenten har ombetts att återuppta och slutföra svaret."}}}},
    "Unable to Export Transcript": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unable to Export Transcript"}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法导出对话记录"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法匯出對話記錄"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não Foi Possível Exportar a Transcrição"}},"de":{"stringUnit":{"state":"translated","value":"Transkript kann nicht exportiert werden"}},"es":{"stringUnit":{"state":"translated","value":"No se Puede Exportar la Transcripción"}},"ja-JP":{"stringUnit":{"state":"translated","value":"会話記録をエクスポートできません"}},"ko":{"stringUnit":{"state":"translated","value":"대화 기록을 내보낼 수 없음"}},"fr":{"stringUnit":{"state":"translated","value":"Impossible d’exporter la transcription"}},"hi":{"stringUnit":{"state":"translated","value":"प्रतिलेख निर्यात नहीं किया जा सका"}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر تصدير نص المحادثة"}},"it":{"stringUnit":{"state":"translated","value":"Impossibile esportare la trascrizione"}},"tr":{"stringUnit":{"state":"translated","value":"Konuşma Dökümü Dışa Aktarılamadı"}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося експортувати розшифровку"}},"id":{"stringUnit":{"state":"translated","value":"Tidak Dapat Mengekspor Transkrip"}},"pl":{"stringUnit":{"state":"translated","value":"Nie można wyeksportować transkrypcji"}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถส่งออกบันทึกการสนทนาได้"}},"vi":{"stringUnit":{"state":"translated","value":"Không Thể Xuất Bản Ghi Hội Thoại"}},"nl":{"stringUnit":{"state":"translated","value":"Transcript Exporteren Niet Mogelijk"}},"fa":{"stringUnit":{"state":"translated","value":"امکان خروجی گرفتن از متن گفتگو وجود ندارد"}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось экспортировать переписку"}},"sv":{"stringUnit":{"state":"translated","value":"Det gick inte att exportera konversationshistoriken"}}}},
    "Unable to Start Live Voice": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unable to Start Live Voice"}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法启动实时语音"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法啟動即時語音"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível iniciar a conversa por voz ao vivo"}},"de":{"stringUnit":{"state":"translated","value":"Live Voice kann nicht gestartet werden"}},"es":{"stringUnit":{"state":"translated","value":"No se puede iniciar la voz en directo"}},"ja-JP":{"stringUnit":{"state":"translated","value":"ライブ音声を開始できません"}},"ko":{"stringUnit":{"state":"translated","value":"실시간 음성을 시작할 수 없음"}},"fr":{"stringUnit":{"state":"translated","value":"Impossible de démarrer la voix en direct"}},"hi":{"stringUnit":{"state":"translated","value":"लाइव वॉइस शुरू नहीं हो सकी"}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر بدء الصوت المباشر"}},"it":{"stringUnit":{"state":"translated","value":"Impossibile avviare la conversazione vocale in tempo reale"}},"tr":{"stringUnit":{"state":"translated","value":"Canlı Ses Başlatılamadı"}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося запустити голосове спілкування наживо"}},"id":{"stringUnit":{"state":"translated","value":"Tidak Dapat Memulai Suara Langsung"}},"pl":{"stringUnit":{"state":"translated","value":"Nie można uruchomić rozmowy głosowej na żywo"}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถเริ่มโหมดเสียงสดได้"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể khởi động chế độ thoại trực tiếp"}},"nl":{"stringUnit":{"state":"translated","value":"Live Voice kan niet worden gestart"}},"fa":{"stringUnit":{"state":"translated","value":"امکان شروع صدای زنده وجود ندارد"}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось запустить голосовой разговор"}},"sv":{"stringUnit":{"state":"translated","value":"Det gick inte att starta liveröst"}}}},
