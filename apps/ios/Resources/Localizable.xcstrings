    "No gateways found yet.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No gateways found yet."}},"zh-CN":{"stringUnit":{"state":"translated","value":"尚未找到任何 Gateway。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"尚未找到 Gateway."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ainda não foi encontrado nenhum Gateway."}},"de":{"stringUnit":{"state":"translated","value":"Noch keine Gateways gefunden."}},"es":{"stringUnit":{"state":"translated","value":"Aún no se han encontrado Gateways."}},"ja-JP":{"stringUnit":{"state":"translated","value":"まだGatewayが見つかっていません。"}},"ko":{"stringUnit":{"state":"translated","value":"아직 Gateway를 찾지 못했습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Aucun gateway trouvé pour le moment."}},"hi":{"stringUnit":{"state":"translated","value":"अभी तक कोई Gateway नहीं मिला है."}},"ar":{"stringUnit":{"state":"translated","value":"لم يتم العثور على أي بوابات بعد."}},"it":{"stringUnit":{"state":"translated","value":"Nessun gateway trovato ancora."}},"tr":{"stringUnit":{"state":"translated","value":"Henüz Gateway bulunamadı."}},"uk":{"stringUnit":{"state":"translated","value":"Ще не знайдено жодного Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Belum ada gateway yang ditemukan."}},"pl":{"stringUnit":{"state":"translated","value":"Nie znaleziono jeszcze żadnych gateway."}},"th":{"stringUnit":{"state":"translated","value":"ยังไม่พบ Gateway."}},"vi":{"stringUnit":{"state":"translated","value":"Chưa tìm thấy Gateway nào."}},"nl":{"stringUnit":{"state":"translated","value":"Nog geen gateways gevonden."}},"fa":{"stringUnit":{"state":"translated","value":"هنوز هیچ gatewayی پیدا نشده است."}},"ru":{"stringUnit":{"state":"translated","value":"Gateway пока не найдены."}},"sv":{"stringUnit":{"state":"translated","value":"Inga Gateway hittades ännu."}}}},
    "No gateways found yet. Use manual setup if Bonjour is blocked.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No gateways found yet. Use manual setup if Bonjour is blocked."}},"zh-CN":{"stringUnit":{"state":"translated","value":"尚未找到 Gateway. 如果 Bonjour 被阻止, 请使用手动设置。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"尚未找到 Gateway. 若 Bonjour 遭到封鎖, 請使用手動設定。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ainda não foi encontrado nenhum Gateway. Use a configuração manual se o Bonjour estiver bloqueado."}},"de":{"stringUnit":{"state":"translated","value":"Noch keine Gateways gefunden. Verwenden Sie die manuelle Einrichtung, wenn Bonjour blockiert ist."}},"es":{"stringUnit":{"state":"translated","value":"Aún no se han encontrado Gateways. Usa la configuración manual si Bonjour está bloqueado."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gateway はまだ見つかっていません。 Bonjour がブロックされている場合は、手動設定を使用してください。"}},"ko":{"stringUnit":{"state":"translated","value":"아직 Gateway를 찾지 못했습니다. Bonjour가 차단된 경우 수동 설정을 사용하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Aucun Gateway trouvé pour le moment. Utilisez la configuration manuelle si Bonjour est bloqué."}},"hi":{"stringUnit":{"state":"translated","value":"अभी तक कोई Gateway नहीं मिला है. यदि Bonjour ब्लॉक है, तो मैन्युअल सेटअप का उपयोग करें."}},"ar":{"stringUnit":{"state":"translated","value":"لم يتم العثور على أي مثيلات Gateway بعد. استخدم الإعداد اليدوي إذا كان Bonjour محظورًا."}},"it":{"stringUnit":{"state":"translated","value":"Ancora nessun Gateway trovato. Usa la configurazione manuale se Bonjour è bloccato."}},"tr":{"stringUnit":{"state":"translated","value":"Henüz Gateway bulunamadı. Bonjour engelleniyorsa manuel kurulumu kullanın."}},"uk":{"stringUnit":{"state":"translated","value":"Ще не знайдено жодного Gateway. Якщо Bonjour заблоковано, скористайтеся ручним налаштуванням."}},"id":{"stringUnit":{"state":"translated","value":"Belum ada gateway yang ditemukan. Gunakan pen