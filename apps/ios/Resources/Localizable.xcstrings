    "Voice could not encode its Gateway request.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Voice could not encode its Gateway request."}},"zh-CN":{"stringUnit":{"state":"translated","value":"语音功能无法对 Gateway 请求进行编码。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語音功能無法編碼其 Gateway 請求。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O recurso de voz não conseguiu codificar sua solicitação ao Gateway."}},"de":{"stringUnit":{"state":"translated","value":"Die Sprachfunktion konnte ihre Gateway-Anfrage nicht kodieren."}},"es":{"stringUnit":{"state":"translated","value":"La función de voz no pudo codificar su solicitud al Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声機能がGatewayリクエストをエンコードできませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"음성 기능이 Gateway 요청을 인코딩하지 못했습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le mode vocal n’a pas pu encoder sa requête au Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"वॉइस अपना Gateway अनुरोध एन्कोड नहीं कर सका।"}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر على الميزة الصوتية ترميز طلبها الموجّه إلى Gateway."}},"it":{"stringUnit":{"state":"translated","value":"La modalità vocale non è riuscita a codificare la richiesta al Gateway."}},"tr":{"stringUnit":{"state":"translated","value":"Sesli iletişim, Gateway isteğini kodlayamadı."}},"uk":{"stringUnit":{"state":"translated","value":"Голосовому режиму не вдалося закодувати запит до Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Fitur suara tidak dapat mengodekan permintaannya ke Gateway."}},"pl":{"stringUnit":{"state":"translated","value":"Tryb głosowy nie mógł zakodować żądania do Gateway."}},"th":{"stringUnit":{"state":"translated","value":"ฟีเจอร์เสียงไม่สามารถเข้ารหัสคำขอไปยัง Gateway ได้"}},"vi":{"stringUnit":{"state":"translated","value":"Tính năng giọng nói không thể mã hóa yêu cầu gửi đến Gateway."}},"nl":{"stringUnit":{"state":"translated","value":"De spraakfunctie kon het Gateway-verzoek niet coderen."}},"fa":{"stringUnit":{"state":"translated","value":"حالت صوتی نتوانست درخواست خود برای Gateway را کدگذاری کند."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось закодировать запрос голосового режима к Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Röstfunktionen kunde inte koda sin begäran till Gateway."}}}},
    "Voice could not retain its network address.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Voice could not retain its network address."}},"zh-CN":{"stringUnit":{"state":"translated","value":"语音功能无法保留网络地址。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語音功能無法保留其網路位址。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O recurso de voz não conseguiu manter seu endereço de rede."}},"de":{"stringUnit":{"state":"translated","value":"Die Sprachfunktion konnte ihre Netzwerkadresse nicht beibehalten."}},"es":{"stringUnit":{"state":"translated","value":"La función de voz no pudo conservar su dirección de red."}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声機能がネットワークアドレスを保持できませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"음성 기능이 네트워크 주소를 유지하지 못했습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le mode vocal n’a pas pu conserver son adresse réseau."}},"hi":{"stringUnit":{"state":"translated","value":"वॉइस अपना नेटवर्क पता बनाए नहीं रख सका।"}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر على الميزة الصوتية الاحتفاظ بعنوان الشبكة الخاص بها."}},"it":{"stringUnit":{"state":"translated","value":"La modalità vocale non è riuscita a mantenere il proprio indirizzo di rete."}},"tr":{"stringUnit":{"state":"translated","value":"Sesli iletişim, ağ adresini koruyamadı."}},"uk":{"stringUnit":{"state":"translated","value":"Голосовому режиму не вдалося зберегти мережеву адресу."}},"id":{"stringUnit":{"state":"translated","value":"Fitur suara tidak dapat mempertahankan alamat jaringannya."}},"pl":{"stringUnit":{"state":"translated","value":"Tryb głosowy nie mógł zachować swojego adresu sieciowego."}},"th":{"stringUnit":{"state":"translated","value":"ฟีเจอร์เสียงไม่สามารถคงที่อยู่เครือข่ายไว้ได้"}},"vi":{"stringUnit":{"state":"translated","value":"Tính năng giọng nói không thể duy trì địa chỉ mạng."}},"nl":{"stringUnit":{"state":"translated","value":"De spraakfunctie kon het netwerkadres niet behouden."}},"fa":{"