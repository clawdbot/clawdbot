    "Realtime connection ended before it became ready.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Realtime connection ended before it became ready."}},"zh-CN":{"stringUnit":{"state":"translated","value":"实时连接在就绪前已结束。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"即時連線尚未就緒便已結束。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A conexão em tempo real foi encerrada antes de ficar pronta."}},"de":{"stringUnit":{"state":"translated","value":"Echtzeitverbindung wurde beendet, bevor sie bereit war."}},"es":{"stringUnit":{"state":"translated","value":"La conexión en tiempo real finalizó antes de estar lista."}},"ja-JP":{"stringUnit":{"state":"translated","value":"準備が完了する前にリアルタイム接続が終了しました。"}},"ko":{"stringUnit":{"state":"translated","value":"실시간 연결이 준비되기 전에 종료되었습니다."}},"fr":{"stringUnit":{"state":"translated","value":"La connexion en temps réel s’est terminée avant d’être prête."}},"hi":{"stringUnit":{"state":"translated","value":"रीयलटाइम कनेक्शन तैयार होने से पहले ही समाप्त हो गया।"}},"ar":{"stringUnit":{"state":"translated","value":"انتهى الاتصال في الوقت الفعلي قبل أن يصبح جاهزًا."}},"it":{"stringUnit":{"state":"translated","value":"La connessione in tempo reale è terminata prima di essere pronta."}},"tr":{"stringUnit":{"state":"translated","value":"Gerçek zamanlı bağlantı hazır olmadan sona erdi."}},"uk":{"stringUnit":{"state":"translated","value":"З’єднання в реальному часі завершилося до завершення підготовки."}},"id":{"stringUnit":{"state":"translated","value":"Koneksi waktu nyata berakhir sebelum siap."}},"pl":{"stringUnit":{"state":"translated","value":"Połączenie w czasie rzeczywistym zakończyło się przed osiągnięciem gotowości."}},"th":{"stringUnit":{"state":"translated","value":"การเชื่อมต่อแบบเรียลไทม์สิ้นสุดลงก่อนที่จะพร้อมใช้งาน."}},"vi":{"stringUnit":{"state":"translated","value":"Kết nối thời gian thực đã kết thúc trước khi sẵn sàng."}},"nl":{"stringUnit":{"state":"translated","value":"Realtime-verbinding is beëindigd voordat deze gereed was."}},"fa":{"stringUnit":{"state":"translated","value":"اتصال بلادرنگ پیش از آماده شدن پایان یافت."}},"ru":{"stringUnit":{"state":"translated","value":"Соединение в реальном времени завершилось до перехода в состояние готовности."}},"sv":{"stringUnit":{"state":"translated","value":"Realtidsanslutningen avslutades innan den blev redo."}}}},
