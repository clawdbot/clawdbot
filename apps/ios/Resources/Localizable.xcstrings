    "Terminal needs a connected gateway": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Terminal needs a connected gateway"}},"zh-CN":{"stringUnit":{"state":"translated","value":"终端需要连接到 Gateway"}},"zh-TW":{"stringUnit":{"state":"translated","value":"終端機需要已連線的 Gateway"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O terminal precisa de um gateway conectado"}},"de":{"stringUnit":{"state":"translated","value":"Das Terminal benötigt einen verbundenen Gateway"}},"es":{"stringUnit":{"state":"translated","value":"El terminal necesita un gateway conectado"}},"ja-JP":{"stringUnit":{"state":"translated","value":"ターミナルにはGatewayへの接続が必要です"}},"ko":{"stringUnit":{"state":"translated","value":"터미널을 사용하려면 Gateway가 연결되어 있어야 합니다"}},"fr":{"stringUnit":{"state":"translated","value":"Le terminal nécessite une passerelle connectée"}},"hi":{"stringUnit":{"state":"translated","value":"टर्मिनल के लिए कनेक्ट किया हुआ Gateway आवश्यक है"}},"ar":{"stringUnit":{"state":"translated","value":"تحتاج الطرفية إلى اتصال ببوابة"}},"it":{"stringUnit":{"state":"translated","value":"Il terminale richiede un gateway connesso"}},"tr":{"stringUnit":{"state":"translated","value":"Terminal için bağlı bir Gateway gerekir"}},"uk":{"stringUnit":{"state":"translated","value":"Для термінала потрібне підключення до Gateway"}},"id":{"stringUnit":{"state":"translated","value":"Terminal memerlukan gateway yang terhubung"}},"pl":{"stringUnit":{"state":"translated","value":"Terminal wymaga połączenia z bramą"}},"th":{"stringUnit":{"state":"translated","value":"เทอร์มินัลต้องใช้ Gateway ที่เชื่อมต่ออยู่"}},"vi":{"stringUnit":{"state":"translated","value":"Thiết bị đầu cuối cần có kết nối với Gateway"}},"nl":{"stringUnit":{"state":"translated","value":"Terminal vereist een verbonden gateway"}},"fa":{"stringUnit":{"state":"translated","value":"ترمینال به یک Gateway متصل نیاز دارد"}},"ru":{"stringUnit":{"state":"translated","value":"Для работы терминала требуется подключение к шлюзу"}},"sv":{"stringUnit":{"state":"translated","value":"Terminalen behöver en ansluten gateway"}}}},
    "The Gateway can request photos and video from this device's camera, subject to iOS permission.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Gateway can request photos and video from this device's camera, subject to iOS permission."}},"zh-CN":{"stringUnit":{"state":"translated","value":"获得 iOS 权限后，Gateway 可以请求使用此设备的摄像头拍摄照片和视频。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"取得 iOS 權限後，Gateway 可以請求使用此裝置的相機拍攝照片和影片。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Gateway pode solicitar fotos e vídeos da câmera deste dispositivo, mediante permissão do iOS."}},"de":{"stringUnit":{"state":"translated","value":"Der Gateway kann Fotos und Videos von der Kamera dieses Geräts anfordern, sofern die entsprechende iOS-Berechtigung erteilt wurde."}},"es":{"stringUnit":{"state":"translated","value":"El Gateway puede solicitar fotos y vídeos de la cámara de este dispositivo, siempre que iOS conceda el permiso."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayは、iOSで許可されている場合、このデバイスのカメラから写真や動画の取得をリクエストできます。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway는 iOS 권한이 허용하는 범위 내에서 이 기기의 카메라로 사진 및 동영상 촬영을 요청할 수 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le Gateway peut demander des photos et des vidéos à la caméra de cet appareil, sous réserve de l’autorisation d’iOS."}},"hi":{"stringUnit":{"state":"translated","value":"iOS की अनुमति के अधीन, Gateway इस डिवाइस के कैमरे से फ़ोटो और वीडियो का अनुरोध कर सकता है।"}},"ar":{"stringUnit":{"state":"translated","value":"يمكن لـ Gateway طلب صور وفيديو من كاميرا هذا الجهاز، بشرط الحصول على إذن iOS."}},"it":{"stringUnit":{"state":"translated","value":"Il Gateway può richiedere foto e video dalla fotocamera di questo dispositivo, previa autorizzazione di iOS."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway, iOS iznine bağlı olarak bu cihazın kamerasından fotoğraf ve video isteyebilir."}},"uk":{"stringUnit":{"state":"translated","value":"Gateway може запитувати фото та відео з камери цього пристрою за наявності дозволу iOS."}},"id":{"stringUnit":{"state":"translated","value":"Gateway dapat meminta foto dan video dari kamera perangkat ini, sesuai izin iOS."}},"pl":{"stringUnit":{"state":"translated","value":"Gateway może żądać zdjęć i nagrań wideo z aparatu tego urządzenia, o ile przyznano uprawnienia w iOS."}},"th":{"stringUnit":{"state":"translated","value":"Gateway สามารถขอภาพถ่ายและวิดีโอจากกล้องของอุปกรณ์นี้ได้ โดยต้องได้รับอนุญาตจาก iOS"}},"vi":{"stringUnit":{"state":"translated","value":"Gateway có thể yêu cầu ảnh và video từ camera của thiết bị này, tùy theo quyền được cấp trên iOS."}},"nl":{"stringUnit":{"state":"translated","value":"De Gateway kan foto's en video's van de camera van dit apparaat opvragen, mits iOS hiervoor toestemming heeft verleend."}},"fa":{"stringUnit":{"state":"translated","value":"Gateway می‌تواند با داشتن مجوز iOS، از دوربین این دستگاه درخواست عکس و ویدیو کند."}},"ru":{"stringUnit":{"state":"translated","value":"Gateway может запрашивать фото и видео с камеры этого устройства при наличии разрешения iOS."}},"sv":{"stringUnit":{"state":"translated","value":"Gateway kan begära foton och video från den här enhetens kamera, förutsatt att behörighet har beviljats i iOS."}}}},
    "The Gateway can request this device's location even when OpenClaw is not in use.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Gateway can request this device's location even when OpenClaw is not in use."}},"zh-CN":{"stringUnit":{"state":"translated","value":"即使未在使用 OpenClaw，Gateway 也可以请求获取此设备的位置。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"即使未使用 OpenClaw，Gateway 仍可請求取得此裝置的位置。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Gateway pode solicitar a localização deste dispositivo mesmo quando o OpenClaw não estiver em uso."}},"de":{"stringUnit":{"state":"translated","value":"Der Gateway kann den Standort dieses Geräts auch dann anfordern, wenn OpenClaw nicht verwendet wird."}},"es":{"stringUnit":{"state":"translated","value":"El Gateway puede solicitar la ubicación de este dispositivo incluso cuando OpenClaw no esté en uso."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayは、OpenClawを使用していないときでも、このデバイスの位置情報をリクエストできます。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway는 OpenClaw를 사용하지 않을 때도 이 기기의 위치를 요청할 수 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le Gateway peut demander la position de cet appareil même lorsque OpenClaw n’est pas utilisé."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway इस डिवाइस की लोकेशन का अनुरोध तब भी कर सकता है, जब OpenClaw का इस्तेमाल नहीं हो रहा हो।"}},"ar":{"stringUnit":{"state":"translated","value":"يمكن لـ Gateway طلب موقع هذا الجهاز حتى عندما لا يكون OpenClaw قيد الاستخدام."}},"it":{"stringUnit":{"state":"translated","value":"Il Gateway può richiedere la posizione di questo dispositivo anche quando OpenClaw non è in uso."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway, OpenClaw kullanılmadığında bile bu cihazın konumunu isteyebilir."}},"uk":{"stringUnit":{"state":"translated","value":"Gateway може запитувати місцеположення цього пристрою, навіть коли OpenClaw не використовується."}},"id":{"stringUnit":{"state":"translated","value":"Gateway dapat meminta lokasi perangkat ini meskipun OpenClaw tidak sedang digunakan."}},"pl":{"stringUnit":{"state":"translated","value":"Gateway może żądać lokalizacji tego urządzenia nawet wtedy, gdy OpenClaw nie jest używany."}},"th":{"stringUnit":{"state":"translated","value":"Gateway สามารถขอตำแหน่งของอุปกรณ์นี้ได้ แม้ในขณะที่ไม่ได้ใช้งาน OpenClaw"}},"vi":{"stringUnit":{"state":"translated","value":"Gateway có thể yêu cầu vị trí của thiết bị này ngay cả khi bạn không sử dụng OpenClaw."}},"nl":{"stringUnit":{"state":"translated","value":"De Gateway kan de locatie van dit apparaat opvragen, ook wanneer OpenClaw niet in gebruik is."}},"fa":{"stringUnit":{"state":"translated","value":"Gateway می‌تواند حتی زمانی که از OpenClaw استفاده نمی‌شود، موقعیت مکانی این دستگاه را درخواست کند."}},"ru":{"stringUnit":{"state":"translated","value":"Gateway может запрашивать местоположение этого устройства, даже когда OpenClaw не используется."}},"sv":{"stringUnit":{"state":"translated","value":"Gateway kan begära den här enhetens plats även när OpenClaw inte används."}}}},
    "The Gateway connection changed. Start voice again.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Gateway connection changed. Start voice again."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Gateway 连接已更改。请重新启动语音。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 連線已變更。請重新啟動語音功能。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A conexão com o Gateway mudou. Inicie a voz novamente."}},"de":{"stringUnit":{"state":"translated","value":"Die Gateway-Verbindung hat sich geändert. Starte die Sprachfunktion erneut."}},"es":{"stringUnit":{"state":"translated","value":"La conexión con el Gateway ha cambiado. Vuelve a iniciar la función de voz."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayへの接続が変更されました。音声を再度開始してください。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway 연결이 변경되었습니다. 음성을 다시 시작하세요."}},"fr":{"stringUnit":{"state":"translated","value":"La connexion au Gateway a changé. Relancez le mode vocal."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway कनेक्शन बदल गया है। वॉइस फिर से शुरू करें।"}},"ar":{"stringUnit":{"state":"translated","value":"تغيّر اتصال Gateway. ابدأ المحادثة الصوتية مجددًا."}},"it":{"stringUnit":{"state":"translated","value":"La connessione al Gateway è cambiata. Riavvia la modalità vocale."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway bağlantısı değişti. Sesli görüşmeyi yeniden başlatın."}},"uk":{"stringUnit":{"state":"translated","value":"З’єднання з Gateway змінилося. Запустіть голосовий зв’язок знову."}},"id":{"stringUnit":{"state":"translated","value":"Koneksi Gateway berubah. Mulai lagi sesi suara."}},"pl":{"stringUnit":{"state":"translated","value":"Połączenie z Gateway uległo zmianie. Uruchom ponownie rozmowę głosową."}},"th":{"stringUnit":{"state":"translated","value":"การเชื่อมต่อ Gateway เปลี่ยนไป โปรดเริ่มการสนทนาด้วยเสียงอีกครั้ง"}},"vi":{"stringUnit":{"state":"translated","value":"Kết nối Gateway đã thay đổi. Hãy khởi động lại tính năng thoại."}},"nl":{"stringUnit":{"state":"translated","value":"De Gateway-verbinding is gewijzigd. Start de spraakfunctie opnieuw."}},"fa":{"stringUnit":{"state":"translated","value":"اتصال Gateway تغییر کرد. مکالمهٔ صوتی را دوباره شروع کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Подключение к Gateway изменилось. Запустите голосовую связь снова."}},"sv":{"stringUnit":{"state":"translated","value":"Anslutningen till Gateway har ändrats. Starta röstfunktionen igen."}}}},
    "The Gateway delivery target changed. Review this message on iPhone.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Gateway delivery target changed. Review this message on iPhone."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Gateway 投递目标已更改。请在 iPhone 上查看此消息。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 的傳送目標已變更。請在 iPhone 上檢視此訊息。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O destino de entrega do Gateway mudou. Revise esta mensagem no iPhone."}},"de":{"stringUnit":{"state":"translated","value":"Das Zustellungsziel des Gateways hat sich geändert. Prüfen Sie diese Nachricht auf dem iPhone."}},"es":{"stringUnit":{"state":"translated","value":"El destino de entrega del Gateway cambió. Revisa este mensaje en el iPhone."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayの配信先が変更されました。iPhoneでこのメッセージを確認してください。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway의 전달 대상이 변경되었습니다. iPhone에서 이 메시지를 검토하세요."}},"fr":{"stringUnit":{"state":"translated","value":"La destination d’envoi du Gateway a changé. Vérifiez ce message sur iPhone."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway का डिलीवरी लक्ष्य बदल गया। iPhone पर इस संदेश की समीक्षा करें।"}},"ar":{"stringUnit":{"state":"translated","value":"تغيّرت وجهة التسليم في Gateway. راجع هذه الرسالة على iPhone."}},"it":{"stringUnit":{"state":"translated","value":"La destinazione di consegna del Gateway è cambiata. Controlla questo messaggio su iPhone."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway teslim hedefi değişti. Bu mesajı iPhone üzerinde gözden geçirin."}},"uk":{"stringUnit":{"state":"translated","value":"Ціль доставки Gateway змінилася. Перегляньте це повідомлення на iPhone."}},"id":{"stringUnit":{"state":"translated","value":"Tujuan pengiriman Gateway berubah. Tinjau pesan ini di iPhone."}},"pl":{"stringUnit":{"state":"translated","value":"Miejsce docelowe dostarczania w Gateway uległo zmianie. Sprawdź tę wiadomość na iPhonie."}},"th":{"stringUnit":{"state":"translated","value":"ปลายทางการส่งของ Gateway เปลี่ยนไป. ตรวจสอบข้อความนี้บน iPhone."}},"vi":{"stringUnit":{"state":"translated","value":"Đích gửi của Gateway đã thay đổi. Xem lại tin nhắn này trên iPhone."}},"nl":{"stringUnit":{"state":"translated","value":"De afleverbestemming van de Gateway is gewijzigd. Controleer dit bericht op iPhone."}},"fa":{"stringUnit":{"state":"translated","value":"مقصد تحویل Gateway تغییر کرد. این پیام را در iPhone بررسی کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Адресат доставки Gateway изменился. Просмотрите это сообщение на iPhone."}},"sv":{"stringUnit":{"state":"translated","value":"Leveransmålet för Gateway ändrades. Granska det här meddelandet på iPhone."}}}},
    "The Gateway returned an unexpected delivery result. Check Chat on iPhone.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Gateway returned an unexpected delivery result. Check Chat on iPhone."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Gateway 返回了意外的投递结果。请在 iPhone 上查看聊天。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 傳回了非預期的傳送結果。請在 iPhone 上查看聊天。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Gateway retornou um resultado de entrega inesperado. Verifique o Chat no iPhone."}},"de":{"stringUnit":{"state":"translated","value":"Das Gateway hat ein unerwartetes Zustellungsergebnis zurückgegeben. Prüfen Sie den Chat auf dem iPhone."}},"es":{"stringUnit":{"state":"translated","value":"El Gateway devolvió un resultado de entrega inesperado. Consulta el Chat en el iPhone."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayから予期しない配信結果が返されました。iPhoneでチャットを確認してください。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway가 예상치 못한 전달 결과를 반환했습니다. iPhone에서 채팅을 확인하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Le Gateway a renvoyé un résultat d’envoi inattendu. Consultez la Discussion sur iPhone."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway से डिलीवरी का अप्रत्याशित परिणाम मिला। iPhone पर चैट जाँचें।"}},"ar":{"stringUnit":{"state":"translated","value":"أعاد Gateway نتيجة تسليم غير متوقعة. تحقّق من الدردشة على iPhone."}},"it":{"stringUnit":{"state":"translated","value":"Il Gateway ha restituito un risultato di consegna imprevisto. Controlla la Chat su iPhone."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway beklenmeyen bir teslim sonucu döndürdü. iPhone üzerinde Sohbeti kontrol edin."}},"uk":{"stringUnit":{"state":"translated","value":"Gateway повернув неочікуваний результат доставки. Перевірте чат на iPhone."}},"id":{"stringUnit":{"state":"translated","value":"Gateway mengembalikan hasil pengiriman yang tidak terduga. Periksa Obrolan di iPhone."}},"pl":{"stringUnit":{"state":"translated","value":"Gateway zwrócił nieoczekiwany wynik dostarczenia. Sprawdź Czat na iPhonie."}},"th":{"stringUnit":{"state":"translated","value":"Gateway ส่งคืนผลการส่งที่ไม่คาดคิด. ตรวจสอบแชตบน iPhone."}},"vi":{"stringUnit":{"state":"translated","value":"Gateway đã trả về kết quả gửi không như mong đợi. Kiểm tra Trò chuyện trên iPhone."}},"nl":{"stringUnit":{"state":"translated","value":"De Gateway heeft een onverwacht afleverresultaat geretourneerd. Controleer Chat op iPhone."}},"fa":{"stringUnit":{"state":"translated","value":"Gateway نتیجهٔ تحویل غیرمنتظره‌ای برگرداند. گفتگو را در iPhone بررسی کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Gateway вернул неожиданный результат доставки. Проверьте чат на iPhone."}},"sv":{"stringUnit":{"state":"translated","value":"Gateway returnerade ett oväntat leveransresultat. Kontrollera Chatt på iPhone."}}}},
    "The Gateway's session routing changed. Start a new message from its current Watch context.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Gateway's session routing changed. Start a new message from its current Watch context."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Gateway 的会话路由已更改。 请从其当前的 Watch 上下文发起新消息。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 的工作階段路由已變更。 請從目前的 Watch 情境開始傳送新訊息。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O roteamento de sessões do Gateway mudou. Inicie uma nova mensagem a partir do contexto atual do Watch."}},"de":{"stringUnit":{"state":"translated","value":"Das Sitzungsrouting des Gateways hat sich geändert. Starten Sie eine neue Nachricht aus dem aktuellen Watch-Kontext."}},"es":{"stringUnit":{"state":"translated","value":"El enrutamiento de sesiones del Gateway cambió. Inicia un nuevo mensaje desde su contexto actual de Watch."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gateway のセッションルーティングが変更されました。現在の Watch コンテキストから新しいメッセージを開始してください。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway의 세션 라우팅이 변경되었습니다. 현재 Watch 컨텍스트에서 새 메시지를 시작하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Le routage des sessions du Gateway a changé. Commencez un nouveau message depuis son contexte Watch actuel."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway की सत्र रूटिंग बदल गई है. उसके वर्तमान Watch संदर्भ से एक नया संदेश शुरू करें."}},"ar":{"stringUnit":{"state":"translated","value":"تغيّر توجيه الجلسات في Gateway. ابدأ رسالة جديدة من سياق Watch الحالي الخاص به."}},"it":{"stringUnit":{"state":"translated","value":"L'instradamento delle sessioni del Gateway è cambiato. Inizia un nuovo messaggio dal contesto attuale del Watch."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway'in oturum yönlendirmesi değişti. Mevcut Watch bağlamından yeni bir mesaj başlatın."}},"uk":{"stringUnit":{"state":"translated","value":"Маршрутизація сеансів Gateway змінилася. Почніть нове повідомлення з його поточного контексту Watch."}},"id":{"stringUnit":{"state":"translated","value":"Perutean sesi Gateway berubah. Mulai pesan baru dari konteks Watch saat ini."}},"pl":{"stringUnit":{"state":"translated","value":"Routing sesji Gateway uległ zmianie. Rozpocznij nową wiadomość w jego bieżącym kontekście na Watch."}},"th":{"stringUnit":{"state":"translated","value":"การกำหนดเส้นทางเซสชันของ Gateway เปลี่ยนไป. เริ่มข้อความใหม่จากบริบท Watch ปัจจุบัน."}},"vi":{"stringUnit":{"state":"translated","value":"Định tuyến phiên của Gateway đã thay đổi. Hãy bắt đầu một tin nhắn mới từ ngữ cảnh Watch hiện tại của Gateway."}},"nl":{"stringUnit":{"state":"translated","value":"De sessieroutering van de Gateway is gewijzigd. Start een nieuw bericht vanuit de huidige Watch-context."}},"fa":{"stringUnit":{"state":"translated","value":"مسیریابی نشست Gateway تغییر کرد. پیام جدیدی را از زمینهٔ فعلی Watch آن آغاز کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Маршрутизация сеансов Gateway изменилась. Начните новое сообщение из текущего контекста Watch."}},"sv":{"stringUnit":{"state":"translated","value":"Sessionsroutningen för Gateway har ändrats. Starta ett nytt meddelande från dess aktuella Watch-kontext."}}}},
    "The TLS challenge came from a different host or port than the requested Gateway.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The TLS challenge came from a different host or port than the requested Gateway."}},"zh-CN":{"stringUnit":{"state":"translated","value":"TLS 质询来自与所请求的 Gateway 不同的主机或端口。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"TLS 驗證要求來自與所請求的 Gateway 不同的主機或連接埠。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O desafio TLS veio de um host ou porta diferente do Gateway solicitado."}},"de":{"stringUnit":{"state":"translated","value":"Die TLS-Anfrage kam von einem anderen Host oder Port als dem angeforderten Gateway."}},"es":{"stringUnit":{"state":"translated","value":"El desafío TLS provino de un host o puerto distinto al del Gateway solicitado."}},"ja-JP":{"stringUnit":{"state":"translated","value":"TLS チャレンジは、要求した Gateway とは異なるホストまたはポートから送信されました。"}},"ko":{"stringUnit":{"state":"translated","value":"TLS 인증 요청이 요청한 Gateway와 다른 호스트 또는 포트에서 왔습니다."}},"fr":{"stringUnit":{"state":"translated","value":"La demande d’authentification TLS provenait d’un hôte ou d’un port différent de celui du Gateway demandé."}},"hi":{"stringUnit":{"state":"translated","value":"TLS चुनौती अनुरोधित Gateway से अलग होस्ट या पोर्ट से आई है."}},"ar":{"stringUnit":{"state":"translated","value":"ورد تحدّي TLS من مضيف أو منفذ مختلف عن مضيف أو منفذ Gateway المطلوب."}},"it":{"stringUnit":{"state":"translated","value":"La richiesta di autenticazione TLS proviene da un host o da una porta diversi da quelli del Gateway richiesto."}},"tr":{"stringUnit":{"state":"translated","value":"TLS doğrulama isteği, istenen Gateway'den farklı bir ana bilgisayardan veya bağlantı noktasından geldi."}},"uk":{"stringUnit":{"state":"translated","value":"Запит перевірки TLS надійшов з іншого хоста або порту, ніж у запитаного Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Tantangan TLS berasal dari host atau port yang berbeda dari Gateway yang diminta."}},"pl":{"stringUnit":{"state":"translated","value":"Żądanie uwierzytelnienia TLS pochodziło z innego hosta lub portu niż wskazany Gateway."}},"th":{"stringUnit":{"state":"translated","value":"คำขอพิสูจน์ตัวตน TLS มาจากโฮสต์หรือพอร์ตที่ต่างจาก Gateway ที่ร้องขอ."}},"vi":{"stringUnit":{"state":"translated","value":"Yêu cầu xác thực TLS đến từ máy chủ hoặc cổng khác với Gateway được yêu cầu."}},"nl":{"stringUnit":{"state":"translated","value":"De TLS-challenge kwam van een andere host of poort dan de aangevraagde Gateway."}},"fa":{"stringUnit":{"state":"translated","value":"چالش TLS از میزبان یا درگاهی متفاوت با Gateway درخواستی دریافت شد."}},"ru":{"stringUnit":{"state":"translated","value":"Запрос TLS поступил с другого хоста или порта, не соответствующего запрошенному Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"TLS-utmaningen kom från en annan värd eller port än den begärda Gateway."}}}},
    "The Watch message queue is full. Reconnect to iPhone before sending more.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Watch message queue is full. Reconnect to iPhone before sending more."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Watch 消息队列已满。 请重新连接 iPhone 后再发送更多消息。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Watch 訊息佇列已滿。 請先重新連線至 iPhone 再傳送更多訊息。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A fila de mensagens do Watch está cheia. Reconecte-se ao iPhone antes de enviar mais mensagens."}},"de":{"stringUnit":{"state":"translated","value":"Die Nachrichtenwarteschlange der Watch ist voll. Stellen Sie die Verbindung zum iPhone wieder her, bevor Sie weitere Nachrichten senden."}},"es":{"stringUnit":{"state":"translated","value":"La cola de mensajes de Watch está llena. Vuelve a conectarte al iPhone antes de enviar más mensajes."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Watch のメッセージキューがいっぱいです。さらに送信するには、iPhone に再接続してください。"}},"ko":{"stringUnit":{"state":"translated","value":"Watch 메시지 대기열이 가득 찼습니다. 메시지를 더 보내기 전에 iPhone에 다시 연결하세요."}},"fr":{"stringUnit":{"state":"translated","value":"La file d’attente des messages de la Watch est pleine. Reconnectez-vous à l’iPhone avant d’en envoyer d’autres."}},"hi":{"stringUnit":{"state":"translated","value":"Watch की संदेश कतार भर गई है. और संदेश भेजने से पहले iPhone से फिर से कनेक्ट करें."}},"ar":{"stringUnit":{"state":"translated","value":"قائمة انتظار رسائل Watch ممتلئة. أعد الاتصال بـ iPhone قبل إرسال المزيد."}},"it":{"stringUnit":{"state":"translated","value":"La coda dei messaggi del Watch è piena. Riconnettiti all'iPhone prima di inviarne altri."}},"tr":{"stringUnit":{"state":"translated","value":"Watch mesaj kuyruğu dolu. Daha fazla mesaj göndermeden önce iPhone'a yeniden bağlanın."}},"uk":{"stringUnit":{"state":"translated","value":"Черга повідомлень Watch заповнена. Перш ніж надсилати нові повідомлення, повторно підключіться до iPhone."}},"id":{"stringUnit":{"state":"translated","value":"Antrean pesan Watch penuh. Hubungkan kembali ke iPhone sebelum mengirim pesan lagi."}},"pl":{"stringUnit":{"state":"translated","value":"Kolejka wiadomości na Watch jest pełna. Połącz się ponownie z iPhone przed wysłaniem kolejnych."}},"th":{"stringUnit":{"state":"translated","value":"คิวข้อความของ Watch เต็มแล้ว. เชื่อมต่อกับ iPhone อีกครั้งก่อนส่งข้อความเพิ่มเติม."}},"vi":{"stringUnit":{"state":"translated","value":"Hàng đợi tin nhắn trên Watch đã đầy. Hãy kết nối lại với iPhone trước khi gửi thêm."}},"nl":{"stringUnit":{"state":"translated","value":"De berichtenwachtrij van de Watch is vol. Maak opnieuw verbinding met de iPhone voordat je meer berichten verstuurt."}},"fa":{"stringUnit":{"state":"translated","value":"صف پیام‌های Watch پر است. پیش از ارسال پیام‌های بیشتر، دوباره به iPhone متصل شوید."}},"ru":{"stringUnit":{"state":"translated","value":"Очередь сообщений Watch заполнена. Подключитесь к iPhone повторно, прежде чем отправлять новые сообщения."}},"sv":{"stringUnit":{"state":"translated","value":"Meddelandekön på Watch är full. Återanslut till iPhone innan du skickar fler."}}}},
    "The connected OpenClaw agent can use device capabilities you enable.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The connected OpenClaw agent can use device capabilities you enable."}},"zh-CN":{"stringUnit":{"state":"translated","value":"已连接的 OpenClaw 智能体可以使用您启用的设备功能。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"連線的 OpenClaw 代理程式可以使用您啟用的裝置功能。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O agente OpenClaw conectado pode usar os recursos do dispositivo que você habilitar."}},"de":{"stringUnit":{"state":"translated","value":"Der verbundene OpenClaw-Agent kann die von Ihnen aktivierten Gerätefunktionen nutzen."}},"es":{"stringUnit":{"state":"translated","value":"El agente de OpenClaw conectado puede usar las funciones del dispositivo que habilites."}},"ja-JP":{"stringUnit":{"state":"translated","value":"接続されている OpenClaw エージェントは、有効にしたデバイス機能を使用できます。"}},"ko":{"stringUnit":{"state":"translated","value":"연결된 OpenClaw 에이전트는 사용자가 활성화한 기기 기능을 사용할 수 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’agent OpenClaw connecté peut utiliser les fonctionnalités de l’appareil que vous activez."}},"hi":{"stringUnit":{"state":"translated","value":"कनेक्ट किया गया OpenClaw एजेंट डिवाइस की उन क्षमताओं का उपयोग कर सकता है जिन्हें आप सक्षम करते हैं."}},"ar":{"stringUnit":{"state":"translated","value":"يمكن لوكيل OpenClaw المتصل استخدام إمكانات الجهاز التي تفعّلها."}},"it":{"stringUnit":{"state":"translated","value":"L'agente OpenClaw connesso può usare le funzionalità del dispositivo che abiliti."}},"tr":{"stringUnit":{"state":"translated","value":"Bağlı OpenClaw aracısı, etkinleştirdiğiniz cihaz özelliklerini kullanabilir."}},"uk":{"stringUnit":{"state":"translated","value":"Підключений агент OpenClaw може використовувати можливості пристрою, які ви ввімкнете."}},"id":{"stringUnit":{"state":"translated","value":"Agen OpenClaw yang terhubung dapat menggunakan kemampuan perangkat yang Anda aktifkan."}},"pl":{"stringUnit":{"state":"translated","value":"Połączony agent OpenClaw może korzystać z włączonych przez Ciebie funkcji urządzenia."}},"th":{"stringUnit":{"state":"translated","value":"เอเจนต์ OpenClaw ที่เชื่อมต่อสามารถใช้ความสามารถของอุปกรณ์ที่คุณเปิดใช้งานได้."}},"vi":{"stringUnit":{"state":"translated","value":"Tác nhân OpenClaw được kết nối có thể sử dụng các khả năng của thiết bị mà bạn bật."}},"nl":{"stringUnit":{"state":"translated","value":"De verbonden OpenClaw-agent kan apparaatfuncties gebruiken die je inschakelt."}},"fa":{"stringUnit":{"state":"translated","value":"عامل متصل OpenClaw می‌تواند از قابلیت‌های دستگاه که فعال می‌کنید استفاده کند."}},"ru":{"stringUnit":{"state":"translated","value":"Подключённый агент OpenClaw может использовать функции устройства, которые вы разрешите."}},"sv":{"stringUnit":{"state":"translated","value":"Den anslutna OpenClaw-agenten kan använda enhetsfunktioner som du aktiverar."}}}},
    "The connected gateway did not return an agent list.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The connected gateway did not return an agent list."}},"zh-CN":{"stringUnit":{"state":"translated","value":"已连接的网关未返回智能体列表。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"連線的閘道未傳回代理程式清單。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O gateway conectado não retornou uma lista de agentes."}},"de":{"stringUnit":{"state":"translated","value":"Der verbundene Gateway hat keine Agentenliste zurückgegeben."}},"es":{"stringUnit":{"state":"translated","value":"El gateway conectado no devolvió una lista de agentes."}},"ja-JP":{"stringUnit":{"state":"translated","value":"接続先の Gateway からエージェント一覧が返されませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"연결된 게이트웨이가 에이전트 목록을 반환하지 않았습니다."}},"fr":{"stringUnit":{"state":"translated","value":"La passerelle connectée n’a pas renvoyé de liste d’agents."}},"hi":{"stringUnit":{"state":"translated","value":"कनेक्ट किए गए गेटवे ने एजेंट सूची नहीं लौटाई."}},"ar":{"stringUnit":{"state":"translated","value":"لم تُرجع البوابة المتصلة قائمة بالوكلاء."}},"it":{"stringUnit":{"state":"translated","value":"Il gateway connesso non ha restituito un elenco di agenti."}},"tr":{"stringUnit":{"state":"translated","value":"Bağlı ağ geçidi bir aracı listesi döndürmedi."}},"uk":{"stringUnit":{"state":"translated","value":"Підключений шлюз не повернув список агентів."}},"id":{"stringUnit":{"state":"translated","value":"Gateway yang terhubung tidak mengembalikan daftar agen."}},"pl":{"stringUnit":{"state":"translated","value":"Połączona brama nie zwróciła listy agentów."}},"th":{"stringUnit":{"state":"translated","value":"เกตเวย์ที่เชื่อมต่อไม่ได้ส่งรายการเอเจนต์กลับมา."}},"vi":{"stringUnit":{"state":"translated","value":"Gateway được kết nối không trả về danh sách tác nhân."}},"nl":{"stringUnit":{"state":"translated","value":"De verbonden gateway heeft geen lijst met agents geretourneerd."}},"fa":{"stringUnit":{"state":"translated","value":"دروازهٔ متصل فهرستی از عامل‌ها برنگرداند."}},"ru":{"stringUnit":{"state":"translated","value":"Подключённый шлюз не вернул список агентов."}},"sv":{"stringUnit":{"state":"translated","value":"Ansluten gateway returnerade ingen agentlista."}}}},
    "The current audio route has no microphone.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The current audio route has no microphone."}},"zh-CN":{"stringUnit":{"state":"translated","value":"当前音频路由没有麦克风。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"目前的音訊路由沒有麥克風。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A rota de áudio atual não tem microfone."}},"de":{"stringUnit":{"state":"translated","value":"Der aktuelle Audiopfad verfügt über kein Mikrofon."}},"es":{"stringUnit":{"state":"translated","value":"La ruta de audio actual no tiene micrófono."}},"ja-JP":{"stringUnit":{"state":"translated","value":"現在のオーディオ経路にはマイクがありません。"}},"ko":{"stringUnit":{"state":"translated","value":"현재 오디오 경로에 마이크가 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le périphérique audio actuel ne dispose d’aucun microphone."}},"hi":{"stringUnit":{"state":"translated","value":"मौजूदा ऑडियो रूट में कोई माइक्रोफ़ोन नहीं है।"}},"ar":{"stringUnit":{"state":"translated","value":"مسار الصوت الحالي لا يتضمن ميكروفونًا."}},"it":{"stringUnit":{"state":"translated","value":"Il percorso audio attuale non dispone di un microfono."}},"tr":{"stringUnit":{"state":"translated","value":"Geçerli ses yolunda mikrofon yok."}},"uk":{"stringUnit":{"state":"translated","value":"Поточний аудіоканал не має мікрофона."}},"id":{"stringUnit":{"state":"translated","value":"Jalur audio saat ini tidak memiliki mikrofon."}},"pl":{"stringUnit":{"state":"translated","value":"Bieżąca ścieżka audio nie ma mikrofonu."}},"th":{"stringUnit":{"state":"translated","value":"เส้นทางเสียงปัจจุบันไม่มีไมโครโฟน"}},"vi":{"stringUnit":{"state":"translated","value":"Đường truyền âm thanh hiện tại không có micrô."}},"nl":{"stringUnit":{"state":"translated","value":"De huidige audioroute heeft geen microfoon."}},"fa":{"stringUnit":{"state":"translated","value":"مسیر صوتی فعلی میکروفون ندارد."}},"ru":{"stringUnit":{"state":"translated","value":"В текущем аудиомаршруте нет микрофона."}},"sv":{"stringUnit":{"state":"translated","value":"Den aktuella ljudvägen saknar mikrofon."}}}},
    "The earlier conversation was cleared.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The earlier conversation was cleared."}},"zh-CN":{"stringUnit":{"state":"translated","value":"之前的对话已清除。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"先前的對話已清除。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A conversa anterior foi apagada."}},"de":{"stringUnit":{"state":"translated","value":"Die vorherige Unterhaltung wurde gelöscht."}},"es":{"stringUnit":{"state":"translated","value":"Se borró la conversación anterior."}},"ja-JP":{"stringUnit":{"state":"translated","value":"以前の会話は消去されました。"}},"ko":{"stringUnit":{"state":"translated","value":"이전 대화가 지워졌습니다."}},"fr":{"stringUnit":{"state":"translated","value":"La conversation précédente a été effacée."}},"hi":{"stringUnit":{"state":"translated","value":"पिछली बातचीत हटा दी गई थी."}},"ar":{"stringUnit":{"state":"translated","value":"تم مسح المحادثة السابقة."}},"it":{"stringUnit":{"state":"translated","value":"La conversazione precedente è stata cancellata."}},"tr":{"stringUnit":{"state":"translated","value":"Önceki konuşma temizlendi."}},"uk":{"stringUnit":{"state":"translated","value":"Попередню розмову очищено."}},"id":{"stringUnit":{"state":"translated","value":"Percakapan sebelumnya telah dihapus."}},"pl":{"stringUnit":{"state":"translated","value":"Wcześniejsza rozmowa została wyczyszczona."}},"th":{"stringUnit":{"state":"translated","value":"ล้างการสนทนาก่อนหน้าแล้ว"}},"vi":{"stringUnit":{"state":"translated","value":"Cuộc trò chuyện trước đó đã được xóa."}},"nl":{"stringUnit":{"state":"translated","value":"Het eerdere gesprek is gewist."}},"fa":{"stringUnit":{"state":"translated","value":"گفتگوی قبلی پاک شد."}},"ru":{"stringUnit":{"state":"translated","value":"Предыдущая переписка была очищена."}},"sv":{"stringUnit":{"state":"translated","value":"Den tidigare konversationen rensades."}}}},
    "The full message could not be loaded.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The full message could not be loaded."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法加载完整消息。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法載入完整訊息。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível carregar a mensagem completa."}},"de":{"stringUnit":{"state":"translated","value":"Die vollständige Nachricht konnte nicht geladen werden."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo cargar el mensaje completo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"メッセージの全文を読み込めませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"전체 메시지를 불러오지 못했습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le message complet n’a pas pu être chargé."}},"hi":{"stringUnit":{"state":"translated","value":"पूरा संदेश लोड नहीं हो सका."}},"ar":{"stringUnit":{"state":"translated","value":"تعذر تحميل الرسالة كاملة."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile caricare il messaggio completo."}},"tr":{"stringUnit":{"state":"translated","value":"Mesajın tamamı yüklenemedi."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося завантажити повне повідомлення."}},"id":{"stringUnit":{"state":"translated","value":"Pesan lengkap tidak dapat dimuat."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się wczytać pełnej wiadomości."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถโหลดข้อความฉบับเต็มได้"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể tải toàn bộ tin nhắn."}},"nl":{"stringUnit":{"state":"translated","value":"Het volledige bericht kon niet worden geladen."}},"fa":{"stringUnit":{"state":"translated","value":"بارگیری پیام کامل ممکن نشد."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось загрузить полное сообщение."}},"sv":{"stringUnit":{"state":"translated","value":"Det fullständiga meddelandet kunde inte läsas in."}}}},
    "The full message has no readable text.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The full message has no readable text."}},"zh-CN":{"stringUnit":{"state":"translated","value":"完整消息中没有可读文本。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"完整訊息中沒有可讀取的文字。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A mensagem completa não tem texto legível."}},"de":{"stringUnit":{"state":"translated","value":"Die vollständige Nachricht enthält keinen lesbaren Text."}},"es":{"stringUnit":{"state":"translated","value":"El mensaje completo no contiene texto legible."}},"ja-JP":{"stringUnit":{"state":"translated","value":"メッセージの全文に読み取り可能なテキストがありません。"}},"ko":{"stringUnit":{"state":"translated","value":"전체 메시지에 읽을 수 있는 텍스트가 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le message complet ne contient aucun texte lisible."}},"hi":{"stringUnit":{"state":"translated","value":"पूरे संदेश में पढ़ने योग्य कोई पाठ नहीं है."}},"ar":{"stringUnit":{"state":"translated","value":"لا تحتوي الرسالة الكاملة على نص قابل للقراءة."}},"it":{"stringUnit":{"state":"translated","value":"Il messaggio completo non contiene testo leggibile."}},"tr":{"stringUnit":{"state":"translated","value":"Mesajın tamamında okunabilir metin yok."}},"uk":{"stringUnit":{"state":"translated","value":"Повне повідомлення не містить читабельного тексту."}},"id":{"stringUnit":{"state":"translated","value":"Pesan lengkap tidak memiliki teks yang dapat dibaca."}},"pl":{"stringUnit":{"state":"translated","value":"Pełna wiadomość nie zawiera tekstu możliwego do odczytania."}},"th":{"stringUnit":{"state":"translated","value":"ข้อความฉบับเต็มไม่มีเนื้อหาที่อ่านได้"}},"vi":{"stringUnit":{"state":"translated","value":"Toàn bộ tin nhắn không có văn bản nào đọc được."}},"nl":{"stringUnit":{"state":"translated","value":"Het volledige bericht bevat geen leesbare tekst."}},"fa":{"stringUnit":{"state":"translated","value":"پیام کامل متن خواندنی ندارد."}},"ru":{"stringUnit":{"state":"translated","value":"В полном сообщении нет читаемого текста."}},"sv":{"stringUnit":{"state":"translated","value":"Det fullständiga meddelandet saknar läsbar text."}}}},
    "The full message is no longer available.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The full message is no longer available."}},"zh-CN":{"stringUnit":{"state":"translated","value":"完整消息已不可用。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"完整訊息已無法使用。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A mensagem completa não está mais disponível."}},"de":{"stringUnit":{"state":"translated","value":"Die vollständige Nachricht ist nicht mehr verfügbar."}},"es":{"stringUnit":{"state":"translated","value":"El mensaje completo ya no está disponible."}},"ja-JP":{"stringUnit":{"state":"translated","value":"メッセージの全文は利用できなくなりました。"}},"ko":{"stringUnit":{"state":"translated","value":"전체 메시지를 더 이상 사용할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le message complet n’est plus disponible."}},"hi":{"stringUnit":{"state":"translated","value":"पूरा संदेश अब उपलब्ध नहीं है."}},"ar":{"stringUnit":{"state":"translated","value":"لم تعد الرسالة الكاملة متاحة."}},"it":{"stringUnit":{"state":"translated","value":"Il messaggio completo non è più disponibile."}},"tr":{"stringUnit":{"state":"translated","value":"Mesajın tamamı artık kullanılamıyor."}},"uk":{"stringUnit":{"state":"translated","value":"Повне повідомлення більше не доступне."}},"id":{"stringUnit":{"state":"translated","value":"Pesan lengkap tidak lagi tersedia."}},"pl":{"stringUnit":{"state":"translated","value":"Pełna wiadomość nie jest już dostępna."}},"th":{"stringUnit":{"state":"translated","value":"ข้อความฉบับเต็มไม่พร้อมใช้งานอีกต่อไป"}},"vi":{"stringUnit":{"state":"translated","value":"Toàn bộ tin nhắn không còn khả dụng."}},"nl":{"stringUnit":{"state":"translated","value":"Het volledige bericht is niet meer beschikbaar."}},"fa":{"stringUnit":{"state":"translated","value":"پیام کامل دیگر در دسترس نیست."}},"ru":{"stringUnit":{"state":"translated","value":"Полное сообщение больше недоступно."}},"sv":{"stringUnit":{"state":"translated","value":"Det fullständiga meddelandet är inte längre tillgängligt."}}}},
    "The iPhone securely sends a one-time setup code. Existing relay features stay available.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The iPhone securely sends a one-time setup code. Existing relay features stay available."}},"zh-CN":{"stringUnit":{"state":"translated","value":"iPhone 会安全地发送一次性设置码。现有中继功能仍可使用。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"iPhone 會安全地傳送一次性設定代碼。現有的中繼功能仍可使用。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O iPhone envia com segurança um código de configuração de uso único. Os recursos de retransmissão existentes continuam disponíveis."}},"de":{"stringUnit":{"state":"translated","value":"Das iPhone sendet einen einmaligen Einrichtungscode auf sichere Weise. Bestehende Relay-Funktionen bleiben verfügbar."}},"es":{"stringUnit":{"state":"translated","value":"El iPhone envía de forma segura un código de configuración de un solo uso. Las funciones de retransmisión existentes siguen disponibles."}},"ja-JP":{"stringUnit":{"state":"translated","value":"iPhoneがワンタイム設定コードを安全に送信します。既存のリレー機能は引き続き利用できます。"}},"ko":{"stringUnit":{"state":"translated","value":"iPhone이 일회용 설정 코드를 안전하게 전송합니다. 기존 릴레이 기능은 계속 사용할 수 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’iPhone envoie un code de configuration à usage unique de manière sécurisée. Les fonctionnalités de relais existantes restent disponibles."}},"hi":{"stringUnit":{"state":"translated","value":"iPhone सुरक्षित रूप से एक बार इस्तेमाल होने वाला सेटअप कोड भेजता है. मौजूदा रिले सुविधाएँ उपलब्ध रहती हैं."}},"ar":{"stringUnit":{"state":"translated","value":"يرسل iPhone رمز إعداد يُستخدم مرة واحدة بشكل آمن. تظل ميزات الترحيل الحالية متاحة."}},"it":{"stringUnit":{"state":"translated","value":"L'iPhone invia in modo sicuro un codice di configurazione monouso. Le funzionalità di inoltro esistenti restano disponibili."}},"tr":{"stringUnit":{"state":"translated","value":"iPhone, tek kullanımlık bir kurulum kodunu güvenli bir şekilde gönderir. Mevcut aktarma özellikleri kullanılabilir durumda kalır."}},"uk":{"stringUnit":{"state":"translated","value":"iPhone безпечно надсилає одноразовий код налаштування. Наявні функції ретрансляції залишаються доступними."}},"id":{"stringUnit":{"state":"translated","value":"iPhone mengirimkan kode penyiapan sekali pakai secara aman. Fitur relai yang ada tetap tersedia."}},"pl":{"stringUnit":{"state":"translated","value":"iPhone bezpiecznie wysyła jednorazowy kod konfiguracji. Dotychczasowe funkcje przekazywania pozostają dostępne."}},"th":{"stringUnit":{"state":"translated","value":"iPhone ส่งรหัสตั้งค่าแบบใช้ครั้งเดียวอย่างปลอดภัย ฟีเจอร์รีเลย์ที่มีอยู่ยังคงใช้งานได้"}},"vi":{"stringUnit":{"state":"translated","value":"iPhone gửi mã thiết lập dùng một lần một cách bảo mật. Các tính năng chuyển tiếp hiện có vẫn khả dụng."}},"nl":{"stringUnit":{"state":"translated","value":"De iPhone verstuurt veilig een eenmalige configuratiecode. Bestaande relayfuncties blijven beschikbaar."}},"fa":{"stringUnit":{"state":"translated","value":"iPhone یک کد راه‌اندازی یک‌بارمصرف را به‌صورت امن ارسال می‌کند. قابلیت‌های رلهٔ موجود همچنان در دسترس می‌مانند."}},"ru":{"stringUnit":{"state":"translated","value":"iPhone безопасно отправляет одноразовый код настройки. Существующие функции ретрансляции остаются доступными."}},"sv":{"stringUnit":{"state":"translated","value":"iPhone skickar en engångskod för konfigurering på ett säkert sätt. Befintliga reläfunktioner förblir tillgängliga."}}}},
    "The main thread cannot be deleted.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The main thread cannot be deleted."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法删除主对话。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法刪除主要對話串。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A conversa principal não pode ser excluída."}},"de":{"stringUnit":{"state":"translated","value":"Der Hauptthread kann nicht gelöscht werden."}},"es":{"stringUnit":{"state":"translated","value":"No se puede eliminar el hilo principal."}},"ja-JP":{"stringUnit":{"state":"translated","value":"メインスレッドは削除できません。"}},"ko":{"stringUnit":{"state":"translated","value":"기본 스레드는 삭제할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le fil principal ne peut pas être supprimé."}},"hi":{"stringUnit":{"state":"translated","value":"मुख्य थ्रेड को हटाया नहीं जा सकता।"}},"ar":{"stringUnit":{"state":"translated","value":"لا يمكن حذف سلسلة المحادثة الرئيسية."}},"it":{"stringUnit":{"state":"translated","value":"La conversazione principale non può essere eliminata."}},"tr":{"stringUnit":{"state":"translated","value":"Ana konu silinemez."}},"uk":{"stringUnit":{"state":"translated","value":"Головну гілку не можна видалити."}},"id":{"stringUnit":{"state":"translated","value":"Utas utama tidak dapat dihapus."}},"pl":{"stringUnit":{"state":"translated","value":"Nie można usunąć głównego wątku."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถลบเธรดหลักได้"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể xóa luồng chính."}},"nl":{"stringUnit":{"state":"translated","value":"De hoofdthread kan niet worden verwijderd."}},"fa":{"stringUnit":{"state":"translated","value":"رشتهٔ اصلی را نمی‌توان حذف کرد."}},"ru":{"stringUnit":{"state":"translated","value":"Основную ветку нельзя удалить."}},"sv":{"stringUnit":{"state":"translated","value":"Huvudtråden kan inte tas bort."}}}},
    "The message changed. Refresh its delivery status before trying again.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The message changed. Refresh its delivery status before trying again."}},"zh-CN":{"stringUnit":{"state":"translated","value":"消息已更改。请刷新其投递状态后重试。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"訊息已變更。請重新整理其傳送狀態後再試一次。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A mensagem foi alterada. Atualize o status de entrega antes de tentar novamente."}},"de":{"stringUnit":{"state":"translated","value":"Die Nachricht wurde geändert. Aktualisieren Sie vor einem erneuten Versuch den Zustellstatus."}},"es":{"stringUnit":{"state":"translated","value":"El mensaje ha cambiado. Actualiza su estado de entrega antes de volver a intentarlo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"メッセージが変更されました。配信状況を更新してから再試行してください。"}},"ko":{"stringUnit":{"state":"translated","value":"메시지가 변경되었습니다. 다시 시도하기 전에 전송 상태를 새로고침하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Le message a changé. Actualisez son statut de livraison avant de réessayer."}},"hi":{"stringUnit":{"state":"translated","value":"संदेश बदल गया है. फिर कोशिश करने से पहले इसकी डिलीवरी स्थिति रीफ़्रेश करें."}},"ar":{"stringUnit":{"state":"translated","value":"تغيّرت الرسالة. حدّث حالة تسليمها قبل المحاولة مجددًا."}},"it":{"stringUnit":{"state":"translated","value":"Il messaggio è cambiato. Aggiorna il suo stato di consegna prima di riprovare."}},"tr":{"stringUnit":{"state":"translated","value":"Mesaj değişti. Yeniden denemeden önce teslim durumunu yenileyin."}},"uk":{"stringUnit":{"state":"translated","value":"Повідомлення змінилося. Оновіть його статус доставки, перш ніж повторити спробу."}},"id":{"stringUnit":{"state":"translated","value":"Pesan telah berubah. Perbarui status pengirimannya sebelum mencoba lagi."}},"pl":{"stringUnit":{"state":"translated","value":"Wiadomość uległa zmianie. Odśwież jej status dostarczenia przed ponowną próbą."}},"th":{"stringUnit":{"state":"translated","value":"ข้อความมีการเปลี่ยนแปลง โปรดรีเฟรชสถานะการส่งก่อนลองอีกครั้ง"}},"vi":{"stringUnit":{"state":"translated","value":"Tin nhắn đã thay đổi. Hãy làm mới trạng thái gửi trước khi thử lại."}},"nl":{"stringUnit":{"state":"translated","value":"Het bericht is gewijzigd. Vernieuw de bezorgstatus voordat je het opnieuw probeert."}},"fa":{"stringUnit":{"state":"translated","value":"پیام تغییر کرده است. پیش از تلاش دوباره، وضعیت تحویل آن را تازه‌سازی کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Сообщение изменилось. Обновите статус его доставки перед повторной попыткой."}},"sv":{"stringUnit":{"state":"translated","value":"Meddelandet har ändrats. Uppdatera leveransstatusen innan du försöker igen."}}}},
    "The message could not be updated. Refresh the delivery status and try again.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The message could not be updated. Refresh the delivery status and try again."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法更新消息。请刷新投递状态后重试。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法更新訊息。請重新整理傳送狀態後再試一次。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível atualizar a mensagem. Atualize o status de entrega e tente novamente."}},"de":{"stringUnit":{"state":"translated","value":"Die Nachricht konnte nicht aktualisiert werden. Aktualisieren Sie den Zustellstatus und versuchen Sie es erneut."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo actualizar el mensaje. Actualiza el estado de entrega y vuelve a intentarlo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"メッセージを更新できませんでした。配信状況を更新して再試行してください。"}},"ko":{"stringUnit":{"state":"translated","value":"메시지를 업데이트하지 못했습니다. 전송 상태를 새로고침한 후 다시 시도하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Le message n’a pas pu être mis à jour. Actualisez le statut de livraison et réessayez."}},"hi":{"stringUnit":{"state":"translated","value":"संदेश अपडेट नहीं हो सका. डिलीवरी स्थिति रीफ़्रेश करके फिर कोशिश करें."}},"ar":{"stringUnit":{"state":"translated","value":"تعذر تحديث الرسالة. حدّث حالة التسليم وحاول مجددًا."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile aggiornare il messaggio. Aggiorna lo stato di consegna e riprova."}},"tr":{"stringUnit":{"state":"translated","value":"Mesaj güncellenemedi. Teslim durumunu yenileyip yeniden deneyin."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося оновити повідомлення. Оновіть статус доставки та повторіть спробу."}},"id":{"stringUnit":{"state":"translated","value":"Pesan tidak dapat diperbarui. Perbarui status pengiriman dan coba lagi."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się zaktualizować wiadomości. Odśwież status dostarczenia i spróbuj ponownie."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถอัปเดตข้อความได้ โปรดรีเฟรชสถานะการส่งแล้วลองอีกครั้ง"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể cập nhật tin nhắn. Hãy làm mới trạng thái gửi rồi thử lại."}},"nl":{"stringUnit":{"state":"translated","value":"Het bericht kon niet worden bijgewerkt. Vernieuw de bezorgstatus en probeer het opnieuw."}},"fa":{"stringUnit":{"state":"translated","value":"به‌روزرسانی پیام ممکن نشد. وضعیت تحویل را تازه‌سازی کنید و دوباره تلاش کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось обновить сообщение. Обновите статус доставки и повторите попытку."}},"sv":{"stringUnit":{"state":"translated","value":"Meddelandet kunde inte uppdateras. Uppdatera leveransstatusen och försök igen."}}}},
    "The saved TLS certificate pin for %@ no longer matches the gateway certificate. The new certificate is trusted by this device; this is commonly caused by certificate rotation.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The saved TLS certificate pin for %@ no longer matches the gateway certificate. The new certificate is trusted by this device; this is commonly caused by certificate rotation."}},"zh-CN":{"stringUnit":{"state":"translated","value":"为 %@ 保存的 TLS 证书固定值不再与 Gateway 证书匹配。 此设备信任新证书; 这通常是由证书轮换引起的。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"為 %@ 儲存的 TLS 憑證釘選值不再符合 Gateway 憑證。此裝置信任新的憑證; 這通常是憑證輪替所致。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O certificado TLS fixado salvo para %@ não corresponde mais ao certificado do Gateway. Este dispositivo confia no novo certificado; isso geralmente ocorre devido à rotação de certificados."}},"de":{"stringUnit":{"state":"translated","value":"Der gespeicherte TLS-Zertifikat-Pin für %@ stimmt nicht mehr mit dem Gateway-Zertifikat überein. Dieses Gerät vertraut dem neuen Zertifikat; dies wird häufig durch einen Zertifikatswechsel verursacht."}},"es":{"stringUnit":{"state":"translated","value":"La huella del certificado TLS guardada para %@ ya no coincide con el certificado del Gateway. Este dispositivo confía en el nuevo certificado; esto suele deberse a la rotación de certificados."}},"ja-JP":{"stringUnit":{"state":"translated","value":"%@ の保存済みTLS証明書ピンがGatewayの証明書と一致しなくなりました。 新しい証明書はこのデバイスで信頼されています; これは通常、証明書のローテーションによって発生します。"}},"ko":{"stringUnit":{"state":"translated","value":"%@에 저장된 TLS 인증서 핀이 더 이상 Gateway 인증서와 일치하지 않습니다. 새 인증서는 이 기기에서 신뢰하는 인증서입니다; 이는 일반적으로 인증서 교체로 인해 발생합니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’empreinte du certificat TLS enregistrée pour %@ ne correspond plus au certificat du Gateway. Cet appareil considère le nouveau certificat comme fiable ; cela est généralement dû à une rotation des certificats."}},"hi":{"stringUnit":{"state":"translated","value":"%@ के लिए सहेजा गया TLS प्रमाणपत्र पिन अब Gateway प्रमाणपत्र से मेल नहीं खाता. यह डिवाइस नए प्रमाणपत्र पर भरोसा करता है; ऐसा आम तौर पर प्रमाणपत्र बदलने के कारण होता है."}},"ar":{"stringUnit":{"state":"translated","value":"لم تعد بصمة شهادة TLS المحفوظة لـ %@ تطابق شهادة Gateway. يثق هذا الجهاز بالشهادة الجديدة؛ ويحدث هذا عادةً بسبب تجديد الشهادة."}},"it":{"stringUnit":{"state":"translated","value":"L'impronta del certificato TLS salvata per %@ non corrisponde più al certificato del Gateway. Il nuovo certificato è considerato attendibile da questo dispositivo; ciò è comunemente dovuto alla rotazione dei certificati."}},"tr":{"stringUnit":{"state":"translated","value":"%@ için kaydedilen TLS sertifika sabitlemesi artık Gateway sertifikasıyla eşleşmiyor. Bu cihaz yeni sertifikaya güveniyor; bu durum genellikle sertifika yenilemesinden kaynaklanır."}},"uk":{"stringUnit":{"state":"translated","value":"Збережений відбиток сертифіката TLS для %@ більше не відповідає сертифікату Gateway. Цей пристрій довіряє новому сертифікату; зазвичай це спричинено ротацією сертифікатів."}},"id":{"stringUnit":{"state":"translated","value":"Pin sertifikat TLS yang tersimpan untuk %@ tidak lagi cocok dengan sertifikat Gateway. Sertifikat baru dipercaya oleh perangkat ini; hal ini biasanya disebabkan oleh rotasi sertifikat."}},"pl":{"stringUnit":{"state":"translated","value":"Zapisany odcisk certyfikatu TLS dla %@ nie odpowiada już certyfikatowi Gateway. Nowy certyfikat jest zaufany na tym urządzeniu; częstą przyczyną jest rotacja certyfikatów."}},"th":{"stringUnit":{"state":"translated","value":"ใบรับรอง TLS ที่บันทึกไว้เพื่อยืนยันตัวตนของ %@ ไม่ตรงกับใบรับรองของ Gateway อีกต่อไป อุปกรณ์นี้เชื่อถือใบรับรองใหม่ ซึ่งโดยทั่วไปเกิดจากการเปลี่ยนใบรับรอง."}},"vi":{"stringUnit":{"state":"translated","value":"Dấu vân tay chứng chỉ TLS đã lưu cho %@ không còn khớp với chứng chỉ Gateway. Thiết bị này tin cậy chứng chỉ mới; điều này thường xảy ra do việc luân chuyển chứng chỉ."}},"nl":{"stringUnit":{"state":"translated","value":"De opgeslagen TLS-certificaatpin voor %@ komt niet meer overeen met het Gateway-certificaat. Het nieuwe certificaat wordt door dit apparaat vertrouwd; dit wordt meestal veroorzaakt door certificaatrotatie."}},"fa":{"stringUnit":{"state":"translated","value":"اثر انگشت ذخیره‌شدهٔ گواهی TLS برای %@ دیگر با گواهی Gateway مطابقت ندارد. این دستگاه به گواهی جدید اعتماد دارد؛ این وضعیت معمولاً به دلیل تعویض دوره‌ای گواهی رخ می‌دهد."}},"ru":{"stringUnit":{"state":"translated","value":"Сохранённый отпечаток TLS-сертификата для %@ больше не совпадает с сертификатом Gateway. Это устройство доверяет новому сертификату; обычно такое происходит при ротации сертификатов."}},"sv":{"stringUnit":{"state":"translated","value":"Den sparade TLS-certifikatbindningen för %@ matchar inte längre Gateway-certifikatet. Den här enheten litar på det nya certifikatet; detta beror vanligtvis på certifikatrotation."}}}},
    "The saved TLS certificate pin for %@ no longer matches the gateway certificate. This device could not verify the new certificate.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The saved TLS certificate pin for %@ no longer matches the gateway certificate. This device could not verify the new certificate."}},"zh-CN":{"stringUnit":{"state":"translated","value":"为 %@ 保存的 TLS 证书固定值不再与 Gateway 证书匹配。 此设备无法验证新证书。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"為 %@ 儲存的 TLS 憑證釘選值不再符合 Gateway 憑證。此裝置無法驗證新的憑證。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O certificado TLS fixado salvo para %@ não corresponde mais ao certificado do Gateway. Este dispositivo não conseguiu verificar o novo certificado."}},"de":{"stringUnit":{"state":"translated","value":"Der gespeicherte TLS-Zertifikat-Pin für %@ stimmt nicht mehr mit dem Gateway-Zertifikat überein. Dieses Gerät konnte das neue Zertifikat nicht überprüfen."}},"es":{"stringUnit":{"state":"translated","value":"La huella del certificado TLS guardada para %@ ya no coincide con el certificado del Gateway. Este dispositivo no pudo verificar el nuevo certificado."}},"ja-JP":{"stringUnit":{"state":"translated","value":"%@ の保存済みTLS証明書ピンがGatewayの証明書と一致しなくなりました。 このデバイスでは新しい証明書を検証できませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"%@에 저장된 TLS 인증서 핀이 더 이상 Gateway 인증서와 일치하지 않습니다. 이 기기에서 새 인증서를 확인할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’empreinte du certificat TLS enregistrée pour %@ ne correspond plus au certificat du Gateway. Cet appareil n’a pas pu vérifier le nouveau certificat."}},"hi":{"stringUnit":{"state":"translated","value":"%@ के लिए सहेजा गया TLS प्रमाणपत्र पिन अब Gateway प्रमाणपत्र से मेल नहीं खाता. यह डिवाइस नए प्रमाणपत्र को सत्यापित नहीं कर सका."}},"ar":{"stringUnit":{"state":"translated","value":"لم تعد بصمة شهادة TLS المحفوظة لـ %@ تطابق شهادة Gateway. تعذّر على هذا الجهاز التحقق من الشهادة الجديدة."}},"it":{"stringUnit":{"state":"translated","value":"L'impronta del certificato TLS salvata per %@ non corrisponde più al certificato del Gateway. Questo dispositivo non ha potuto verificare il nuovo certificato."}},"tr":{"stringUnit":{"state":"translated","value":"%@ için kaydedilen TLS sertifika sabitlemesi artık Gateway sertifikasıyla eşleşmiyor. Bu cihaz yeni sertifikayı doğrulayamadı."}},"uk":{"stringUnit":{"state":"translated","value":"Збережений відбиток сертифіката TLS для %@ більше не відповідає сертифікату Gateway. Цей пристрій не зміг перевірити новий сертифікат."}},"id":{"stringUnit":{"state":"translated","value":"Pin sertifikat TLS yang tersimpan untuk %@ tidak lagi cocok dengan sertifikat Gateway. Perangkat ini tidak dapat memverifikasi sertifikat baru."}},"pl":{"stringUnit":{"state":"translated","value":"Zapisany odcisk certyfikatu TLS dla %@ nie odpowiada już certyfikatowi Gateway. To urządzenie nie mogło zweryfikować nowego certyfikatu."}},"th":{"stringUnit":{"state":"translated","value":"ใบรับรอง TLS ที่บันทึกไว้เพื่อยืนยันตัวตนของ %@ ไม่ตรงกับใบรับรองของ Gateway อีกต่อไป อุปกรณ์นี้ไม่สามารถตรวจสอบใบรับรองใหม่ได้."}},"vi":{"stringUnit":{"state":"translated","value":"Dấu vân tay chứng chỉ TLS đã lưu cho %@ không còn khớp với chứng chỉ Gateway. Thiết bị này không thể xác minh chứng chỉ mới."}},"nl":{"stringUnit":{"state":"translated","value":"De opgeslagen TLS-certificaatpin voor %@ komt niet meer overeen met het Gateway-certificaat. Dit apparaat kon het nieuwe certificaat niet verifiëren."}},"fa":{"stringUnit":{"state":"translated","value":"اثر انگشت ذخیره‌شدهٔ گواهی TLS برای %@ دیگر با گواهی Gateway مطابقت ندارد. این دستگاه نتوانست گواهی جدید را تأیید کند."}},"ru":{"stringUnit":{"state":"translated","value":"Сохранённый отпечаток TLS-сертификата для %@ больше не совпадает с сертификатом Gateway. Это устройство не смогло проверить новый сертификат."}},"sv":{"stringUnit":{"state":"translated","value":"Den sparade TLS-certifikatbindningen för %@ matchar inte längre Gateway-certifikatet. Den här enheten kunde inte verifiera det nya certifikatet."}}}},
    "The secure voice connection failed.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The secure voice connection failed."}},"zh-CN":{"stringUnit":{"state":"translated","value":"安全语音连接失败。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"安全語音連線失敗。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A conexão segura de voz falhou."}},"de":{"stringUnit":{"state":"translated","value":"Die sichere Sprachverbindung ist fehlgeschlagen."}},"es":{"stringUnit":{"state":"translated","value":"Se ha producido un error en la conexión de voz segura."}},"ja-JP":{"stringUnit":{"state":"translated","value":"安全な音声接続に失敗しました。"}},"ko":{"stringUnit":{"state":"translated","value":"보안 음성 연결에 실패했습니다."}},"fr":{"stringUnit":{"state":"translated","value":"La connexion vocale sécurisée a échoué."}},"hi":{"stringUnit":{"state":"translated","value":"सुरक्षित वॉइस कनेक्शन विफल हो गया।"}},"ar":{"stringUnit":{"state":"translated","value":"فشل الاتصال الصوتي الآمن."}},"it":{"stringUnit":{"state":"translated","value":"La connessione vocale sicura non è riuscita."}},"tr":{"stringUnit":{"state":"translated","value":"Güvenli ses bağlantısı başarısız oldu."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося встановити захищене голосове з’єднання."}},"id":{"stringUnit":{"state":"translated","value":"Koneksi suara aman gagal."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się nawiązać bezpiecznego połączenia głosowego."}},"th":{"stringUnit":{"state":"translated","value":"การเชื่อมต่อเสียงแบบปลอดภัยล้มเหลว"}},"vi":{"stringUnit":{"state":"translated","value":"Kết nối thoại bảo mật không thành công."}},"nl":{"stringUnit":{"state":"translated","value":"De beveiligde spraakverbinding is mislukt."}},"fa":{"stringUnit":{"state":"translated","value":"اتصال صوتی امن برقرار نشد."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось установить защищённое голосовое соединение."}},"sv":{"stringUnit":{"state":"translated","value":"Den säkra röstanslutningen misslyckades."}}}},
    "The selected agent is no longer available. Start a new call.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The selected agent is no longer available. Start a new call."}},"zh-CN":{"stringUnit":{"state":"translated","value":"所选智能体已不可用。请发起新的通话。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"所選的代理程式已無法使用。請開始新的通話。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O agente selecionado não está mais disponível. Inicie uma nova chamada."}},"de":{"stringUnit":{"state":"translated","value":"Der ausgewählte Agent ist nicht mehr verfügbar. Starte einen neuen Anruf."}},"es":{"stringUnit":{"state":"translated","value":"El agente seleccionado ya no está disponible. Inicia una nueva llamada."}},"ja-JP":{"stringUnit":{"state":"translated","value":"選択したエージェントは利用できなくなりました。新しい通話を開始してください。"}},"ko":{"stringUnit":{"state":"translated","value":"선택한 에이전트를 더 이상 사용할 수 없습니다. 새 통화를 시작하세요."}},"fr":{"stringUnit":{"state":"translated","value":"L’agent sélectionné n’est plus disponible. Lancez un nouvel appel."}},"hi":{"stringUnit":{"state":"translated","value":"चुना गया एजेंट अब उपलब्ध नहीं है। नई कॉल शुरू करें।"}},"ar":{"stringUnit":{"state":"translated","value":"لم يعد الوكيل المحدد متاحًا. ابدأ مكالمة جديدة."}},"it":{"stringUnit":{"state":"translated","value":"L'agente selezionato non è più disponibile. Avvia una nuova chiamata."}},"tr":{"stringUnit":{"state":"translated","value":"Seçilen aracı artık kullanılamıyor. Yeni bir arama başlatın."}},"uk":{"stringUnit":{"state":"translated","value":"Вибраний агент більше недоступний. Почніть новий виклик."}},"id":{"stringUnit":{"state":"translated","value":"Agen yang dipilih tidak lagi tersedia. Mulai panggilan baru."}},"pl":{"stringUnit":{"state":"translated","value":"Wybrany agent nie jest już dostępny. Rozpocznij nową rozmowę."}},"th":{"stringUnit":{"state":"translated","value":"เอเจนต์ที่เลือกไม่พร้อมใช้งานแล้ว โปรดเริ่มการโทรใหม่"}},"vi":{"stringUnit":{"state":"translated","value":"Tác nhân đã chọn không còn khả dụng. Hãy bắt đầu cuộc gọi mới."}},"nl":{"stringUnit":{"state":"translated","value":"De geselecteerde agent is niet meer beschikbaar. Start een nieuw gesprek."}},"fa":{"stringUnit":{"state":"translated","value":"عامل انتخاب‌شده دیگر در دسترس نیست. تماس جدیدی شروع کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Выбранный агент больше недоступен. Начните новый звонок."}},"sv":{"stringUnit":{"state":"translated","value":"Den valda agenten är inte längre tillgänglig. Starta ett nytt samtal."}}}},
    "The session attaches once the gateway is ready.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The session attaches once the gateway is ready."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Gateway 就绪后会连接会话。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 就緒後，工作階段便會連接。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A sessão se conecta assim que o Gateway estiver pronto."}},"de":{"stringUnit":{"state":"translated","value":"Die Sitzung wird verbunden, sobald das Gateway bereit ist."}},"es":{"stringUnit":{"state":"translated","value":"La sesión se conecta cuando el Gateway está listo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayの準備が整うとセッションが接続されます。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway가 준비되면 세션이 연결됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"La session se connecte une fois le Gateway prêt."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway तैयार होते ही सत्र जुड़ जाता है."}},"ar":{"stringUnit":{"state":"translated","value":"تتصل الجلسة بمجرد أن يصبح Gateway جاهزًا."}},"it":{"stringUnit":{"state":"translated","value":"La sessione si collega non appena il Gateway è pronto."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway hazır olduğunda oturum bağlanır."}},"uk":{"stringUnit":{"state":"translated","value":"Сеанс під’єднається, щойно Gateway буде готовий."}},"id":{"stringUnit":{"state":"translated","value":"Sesi akan terhubung setelah Gateway siap."}},"pl":{"stringUnit":{"state":"translated","value":"Sesja zostanie podłączona, gdy Gateway będzie gotowy."}},"th":{"stringUnit":{"state":"translated","value":"เซสชันจะเชื่อมต่อเมื่อ Gateway พร้อมใช้งาน."}},"vi":{"stringUnit":{"state":"translated","value":"Phiên sẽ kết nối khi Gateway sẵn sàng."}},"nl":{"stringUnit":{"state":"translated","value":"De sessie wordt verbonden zodra de Gateway gereed is."}},"fa":{"stringUnit":{"state":"translated","value":"به‌محض آماده شدن Gateway، نشست متصل می‌شود."}},"ru":{"stringUnit":{"state":"translated","value":"Сеанс подключится, как только Gateway будет готов."}},"sv":{"stringUnit":{"state":"translated","value":"Sessionen ansluts när Gateway är redo."}}}},
    "The thread and its transcript are removed from the gateway.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The thread and its transcript are removed from the gateway."}},"zh-CN":{"stringUnit":{"state":"translated","value":"该对话及其对话记录将从 Gateway 中移除。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此對話串及其文字記錄將從 Gateway 移除。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A conversa e sua transcrição serão removidas do Gateway."}},"de":{"stringUnit":{"state":"translated","value":"Der Thread und sein Transkript werden vom Gateway entfernt."}},"es":{"stringUnit":{"state":"translated","value":"El hilo y su transcripción se eliminarán del Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"スレッドとその会話記録はGatewayから削除されます。"}},"ko":{"stringUnit":{"state":"translated","value":"스레드와 해당 대화 기록이 Gateway에서 제거됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le fil de discussion et sa transcription sont supprimés du Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"थ्रेड और उसका प्रतिलेख Gateway से हटा दिए जाते हैं."}},"ar":{"stringUnit":{"state":"translated","value":"تُزال المحادثة وسجلها من Gateway."}},"it":{"stringUnit":{"state":"translated","value":"La conversazione e la relativa trascrizione vengono rimosse dal gateway."}},"tr":{"stringUnit":{"state":"translated","value":"Konu ve dökümü gateway'den kaldırılır."}},"uk":{"stringUnit":{"state":"translated","value":"Гілку та її стенограму буде видалено з Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Utas dan transkripnya dihapus dari Gateway."}},"pl":{"stringUnit":{"state":"translated","value":"Wątek i jego transkrypcja zostaną usunięte z gateway."}},"th":{"stringUnit":{"state":"translated","value":"เธรดและบันทึกการสนทนาจะถูกลบออกจาก Gateway"}},"vi":{"stringUnit":{"state":"translated","value":"Cuộc trò chuyện và bản ghi của cuộc trò chuyện đó sẽ bị xóa khỏi Gateway."}},"nl":{"stringUnit":{"state":"translated","value":"De thread en het transcript ervan worden uit de gateway verwijderd."}},"fa":{"stringUnit":{"state":"translated","value":"گفت‌وگو و رونوشت آن از Gateway حذف می‌شوند."}},"ru":{"stringUnit":{"state":"translated","value":"Ветка и её история удаляются из Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Tråden och dess transkription tas bort från Gateway."}}}},
    "The thread could not be created.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The thread could not be created."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法创建对话。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法建立討論串。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível criar a conversa."}},"de":{"stringUnit":{"state":"translated","value":"Der Thread konnte nicht erstellt werden."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo crear el hilo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"スレッドを作成できませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"스레드를 만들 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le fil de discussion n’a pas pu être créé."}},"hi":{"stringUnit":{"state":"translated","value":"थ्रेड बनाया नहीं जा सका।"}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر إنشاء المحادثة."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile creare la conversazione."}},"tr":{"stringUnit":{"state":"translated","value":"Konu oluşturulamadı."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося створити гілку."}},"id":{"stringUnit":{"state":"translated","value":"Utas tidak dapat dibuat."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się utworzyć wątku."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถสร้างเธรดได้."}},"vi":{"stringUnit":{"state":"translated","value":"Không thể tạo cuộc trò chuyện."}},"nl":{"stringUnit":{"state":"translated","value":"De gespreksdraad kon niet worden aangemaakt."}},"fa":{"stringUnit":{"state":"translated","value":"گفت‌وگو ایجاد نشد."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось создать ветку."}},"sv":{"stringUnit":{"state":"translated","value":"Tråden kunde inte skapas."}}}},
    "The voice call ended. Start a new call to continue.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The voice call ended. Start a new call to continue."}},"zh-CN":{"stringUnit":{"state":"translated","value":"语音通话已结束。请发起新的通话以继续。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語音通話已結束。請開始新的通話以繼續。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A chamada de voz terminou. Inicie uma nova chamada para continuar."}},"de":{"stringUnit":{"state":"translated","value":"Der Sprachanruf wurde beendet. Starte einen neuen Anruf, um fortzufahren."}},"es":{"stringUnit":{"state":"translated","value":"La llamada de voz ha finalizado. Inicia una nueva llamada para continuar."}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声通話が終了しました。続けるには新しい通話を開始してください。"}},"ko":{"stringUnit":{"state":"translated","value":"음성 통화가 종료되었습니다. 계속하려면 새 통화를 시작하세요."}},"fr":{"stringUnit":{"state":"translated","value":"L’appel vocal est terminé. Lancez un nouvel appel pour continuer."}},"hi":{"stringUnit":{"state":"translated","value":"वॉइस कॉल समाप्त हो गई। जारी रखने के लिए नई कॉल शुरू करें।"}},"ar":{"stringUnit":{"state":"translated","value":"انتهت المكالمة الصوتية. ابدأ مكالمة جديدة للمتابعة."}},"it":{"stringUnit":{"state":"translated","value":"La chiamata vocale è terminata. Avvia una nuova chiamata per continuare."}},"tr":{"stringUnit":{"state":"translated","value":"Sesli arama sona erdi. Devam etmek için yeni bir arama başlatın."}},"uk":{"stringUnit":{"state":"translated","value":"Голосовий виклик завершено. Щоб продовжити, почніть новий виклик."}},"id":{"stringUnit":{"state":"translated","value":"Panggilan suara berakhir. Mulai panggilan baru untuk melanjutkan."}},"pl":{"stringUnit":{"state":"translated","value":"Rozmowa głosowa została zakończona. Rozpocznij nową rozmowę, aby kontynuować."}},"th":{"stringUnit":{"state":"translated","value":"การโทรด้วยเสียงสิ้นสุดแล้ว โปรดเริ่มการโทรใหม่เพื่อดำเนินการต่อ"}},"vi":{"stringUnit":{"state":"translated","value":"Cuộc gọi thoại đã kết thúc. Hãy bắt đầu cuộc gọi mới để tiếp tục."}},"nl":{"stringUnit":{"state":"translated","value":"Het spraakgesprek is beëindigd. Start een nieuw gesprek om door te gaan."}},"fa":{"stringUnit":{"state":"translated","value":"تماس صوتی پایان یافت. برای ادامه، تماس جدیدی شروع کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Голосовой звонок завершён. Чтобы продолжить, начните новый звонок."}},"sv":{"stringUnit":{"state":"translated","value":"Röstsamtalet avslutades. Starta ett nytt samtal för att fortsätta."}}}},
    "The voice provider rejected the connection. Start a new call.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The voice provider rejected the connection. Start a new call."}},"zh-CN":{"stringUnit":{"state":"translated","value":"语音服务提供商拒绝了连接。请发起新的通话。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語音服務供應商拒絕連線。請開始新的通話。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O provedor de voz rejeitou a conexão. Inicie uma nova chamada."}},"de":{"stringUnit":{"state":"translated","value":"Der Sprachanbieter hat die Verbindung abgelehnt. Starte einen neuen Anruf."}},"es":{"stringUnit":{"state":"translated","value":"El proveedor de voz ha rechazado la conexión. Inicia una nueva llamada."}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声プロバイダーが接続を拒否しました。新しい通話を開始してください。"}},"ko":{"stringUnit":{"state":"translated","value":"음성 제공업체가 연결을 거부했습니다. 새 통화를 시작하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Le fournisseur vocal a rejeté la connexion. Lancez un nouvel appel."}},"hi":{"stringUnit":{"state":"translated","value":"वॉइस प्रदाता ने कनेक्शन अस्वीकार कर दिया। नई कॉल शुरू करें।"}},"ar":{"stringUnit":{"state":"translated","value":"رفض مزوّد الخدمة الصوتية الاتصال. ابدأ مكالمة جديدة."}},"it":{"stringUnit":{"state":"translated","value":"Il fornitore del servizio vocale ha rifiutato la connessione. Avvia una nuova chiamata."}},"tr":{"stringUnit":{"state":"translated","value":"Ses sağlayıcısı bağlantıyı reddetti. Yeni bir arama başlatın."}},"uk":{"stringUnit":{"state":"translated","value":"Постачальник голосових послуг відхилив з’єднання. Почніть новий виклик."}},"id":{"stringUnit":{"state":"translated","value":"Penyedia layanan suara menolak koneksi. Mulai panggilan baru."}},"pl":{"stringUnit":{"state":"translated","value":"Dostawca usługi głosowej odrzucił połączenie. Rozpocznij nową rozmowę."}},"th":{"stringUnit":{"state":"translated","value":"ผู้ให้บริการเสียงปฏิเสธการเชื่อมต่อ โปรดเริ่มการโทรใหม่"}},"vi":{"stringUnit":{"state":"translated","value":"Nhà cung cấp dịch vụ thoại đã từ chối kết nối. Hãy bắt đầu cuộc gọi mới."}},"nl":{"stringUnit":{"state":"translated","value":"De spraakprovider heeft de verbinding geweigerd. Start een nieuw gesprek."}},"fa":{"stringUnit":{"state":"translated","value":"ارائه‌دهندهٔ خدمات صوتی اتصال را رد کرد. تماس جدیدی شروع کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Провайдер голосовой связи отклонил подключение. Начните новый звонок."}},"sv":{"stringUnit":{"state":"translated","value":"Röstleverantören avvisade anslutningen. Starta ett nytt samtal."}}}},
    "The voice provider returned an empty SDP answer.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The voice provider returned an empty SDP answer."}},"zh-CN":{"stringUnit":{"state":"translated","value":"语音服务提供商返回了空的 SDP 应答。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語音服務供應商傳回了空白的 SDP 回應。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O provedor de voz retornou uma resposta SDP vazia."}},"de":{"stringUnit":{"state":"translated","value":"Der Sprachanbieter hat eine leere SDP-Antwort zurückgegeben."}},"es":{"stringUnit":{"state":"translated","value":"El proveedor de voz ha devuelto una respuesta SDP vacía."}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声プロバイダーが空のSDP応答を返しました。"}},"ko":{"stringUnit":{"state":"translated","value":"음성 제공업체가 빈 SDP 응답을 반환했습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le fournisseur vocal a renvoyé une réponse SDP vide."}},"hi":{"stringUnit":{"state":"translated","value":"वॉइस प्रदाता ने खाली SDP उत्तर लौटाया।"}},"ar":{"stringUnit":{"state":"translated","value":"أعاد مزوّد الخدمة الصوتية إجابة SDP فارغة."}},"it":{"stringUnit":{"state":"translated","value":"Il fornitore del servizio vocale ha restituito una risposta SDP vuota."}},"tr":{"stringUnit":{"state":"translated","value":"Ses sağlayıcısı boş bir SDP yanıtı döndürdü."}},"uk":{"stringUnit":{"state":"translated","value":"Постачальник голосових послуг повернув порожню відповідь SDP."}},"id":{"stringUnit":{"state":"translated","value":"Penyedia layanan suara mengembalikan jawaban SDP kosong."}},"pl":{"stringUnit":{"state":"translated","value":"Dostawca usługi głosowej zwrócił pustą odpowiedź SDP."}},"th":{"stringUnit":{"state":"translated","value":"ผู้ให้บริการเสียงส่งคำตอบ SDP ที่ว่างเปล่ากลับมา"}},"vi":{"stringUnit":{"state":"translated","value":"Nhà cung cấp dịch vụ thoại đã trả về phản hồi SDP trống."}},"nl":{"stringUnit":{"state":"translated","value":"De spraakprovider heeft een leeg SDP-antwoord teruggestuurd."}},"fa":{"stringUnit":{"state":"translated","value":"ارائه‌دهندهٔ خدمات صوتی پاسخ SDP خالی برگرداند."}},"ru":{"stringUnit":{"state":"translated","value":"Провайдер голосовой связи вернул пустой SDP-ответ."}},"sv":{"stringUnit":{"state":"translated","value":"Röstleverantören returnerade ett tomt SDP-svar."}}}},
    "The voice provider returned an invalid SDP answer.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The voice provider returned an invalid SDP answer."}},"zh-CN":{"stringUnit":{"state":"translated","value":"语音服务提供商返回了无效的 SDP 应答。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語音服務供應商傳回了無效的 SDP 回應。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O provedor de voz retornou uma resposta SDP inválida."}},"de":{"stringUnit":{"state":"translated","value":"Der Sprachanbieter hat eine ungültige SDP-Antwort zurückgegeben."}},"es":{"stringUnit":{"state":"translated","value":"El proveedor de voz ha devuelto una respuesta SDP no válida."}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声プロバイダーが無効なSDP応答を返しました。"}},"ko":{"stringUnit":{"state":"translated","value":"음성 제공업체가 유효하지 않은 SDP 응답을 반환했습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le fournisseur vocal a renvoyé une réponse SDP non valide."}},"hi":{"stringUnit":{"state":"translated","value":"वॉइस प्रदाता ने अमान्य SDP उत्तर लौटाया।"}},"ar":{"stringUnit":{"state":"translated","value":"أعاد مزوّد الخدمة الصوتية إجابة SDP غير صالحة."}},"it":{"stringUnit":{"state":"translated","value":"Il fornitore del servizio vocale ha restituito una risposta SDP non valida."}},"tr":{"stringUnit":{"state":"translated","value":"Ses sağlayıcısı geçersiz bir SDP yanıtı döndürdü."}},"uk":{"stringUnit":{"state":"translated","value":"Постачальник голосових послуг повернув некоректну відповідь SDP."}},"id":{"stringUnit":{"state":"translated","value":"Penyedia layanan suara mengembalikan jawaban SDP yang tidak valid."}},"pl":{"stringUnit":{"state":"translated","value":"Dostawca usługi głosowej zwrócił nieprawidłową odpowiedź SDP."}},"th":{"stringUnit":{"state":"translated","value":"ผู้ให้บริการเสียงส่งคำตอบ SDP ที่ไม่ถูกต้องกลับมา"}},"vi":{"stringUnit":{"state":"translated","value":"Nhà cung cấp dịch vụ thoại đã trả về phản hồi SDP không hợp lệ."}},"nl":{"stringUnit":{"state":"translated","value":"De spraakprovider heeft een ongeldig SDP-antwoord teruggestuurd."}},"fa":{"stringUnit":{"state":"translated","value":"ارائه‌دهندهٔ خدمات صوتی پاسخ SDP نامعتبر برگرداند."}},"ru":{"stringUnit":{"state":"translated","value":"Провайдер голосовой связи вернул некорректный SDP-ответ."}},"sv":{"stringUnit":{"state":"translated","value":"Röstleverantören returnerade ett ogiltigt SDP-svar."}}}},
    "The watch receives a one-time pairing code and its own device credentials. Voice is included with read and Talk access, without admin access. The microphone starts only when you tap Start on the watch. A reachable secure Gateway URL is required away from the iPhone.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The watch receives a one-time pairing code and its own device credentials. Voice is included with read and Talk access, without admin access. The microphone starts only when you tap Start on the watch. A reachable secure Gateway URL is required away from the iPhone."}},"zh-CN":{"stringUnit":{"state":"translated","value":"手表会收到一次性配对码和专属设备凭据。语音功能包含读取和 Talk 访问权限，不包含管理员权限。只有在手表上轻点“开始”时，麦克风才会启动。离开 iPhone 后，需要可访问的安全 Gateway URL。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"手錶會收到一次性配對碼及其專屬的裝置憑證。語音功能包含讀取和 Talk 存取權限，但不包含管理員權限。只有當你在手錶上點選「開始」時，麥克風才會啟動。離開 iPhone 的連線範圍時，需要可連線的安全 Gateway URL。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O relógio recebe um código de emparelhamento de uso único e suas próprias credenciais de dispositivo. A voz é incluída com acesso de leitura e ao Talk, sem acesso de administrador. O microfone só é ativado quando você toca em Iniciar no relógio. Longe do iPhone, é necessária uma URL segura e acessível do Gateway."}},"de":{"stringUnit":{"state":"translated","value":"Die Apple Watch erhält einen einmaligen Kopplungscode und eigene Gerätezugangsdaten. Die Sprachfunktion ist mit Lese- und Talk-Zugriff enthalten, ohne Administratorzugriff. Das Mikrofon wird erst aktiviert, wenn du auf der Apple Watch auf „Start“ tippst. Außerhalb der Reichweite des iPhones ist eine erreichbare, sichere Gateway-URL erforderlich."}},"es":{"stringUnit":{"state":"translated","value":"El reloj recibe un código de vinculación de un solo uso y sus propias credenciales de dispositivo. La voz se incluye con acceso de lectura y a Talk, sin acceso de administrador. El micrófono solo se activa cuando tocas Iniciar en el reloj. Para usarlo lejos del iPhone, se requiere una URL segura y accesible del Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ウォッチは1回限りのペアリングコードと専用のデバイス認証情報を受信します。音声機能には読み取り権限とTalkへのアクセス権が含まれますが、管理者権限は含まれません。マイクは、ウォッチで「開始」をタップしたときにのみ起動します。iPhoneから離れて使用する場合は、到達可能な安全なGateway URLが必要です。"}},"ko":{"stringUnit":{"state":"translated","value":"워치에 일회용 페어링 코드와 전용 기기 인증 정보가 전송됩니다. 음성 기능에는 관리자 권한 없이 읽기 및 Talk 접근 권한이 포함됩니다. 마이크는 워치에서 시작을 탭할 때만 켜집니다. iPhone에서 멀리 떨어져 있을 때는 접속 가능한 보안 Gateway URL이 필요합니다."}},"fr":{"stringUnit":{"state":"translated","value":"La montre reçoit un code d’association à usage unique et ses propres identifiants d’appareil. La voix est incluse avec les droits de lecture et l’accès à Talk, sans droits d’administration. Le microphone ne s’active que lorsque vous touchez Démarrer sur la montre. Une URL sécurisée et accessible du Gateway est nécessaire lorsque la montre est éloignée de l’iPhone."}},"hi":{"stringUnit":{"state":"translated","value":"घड़ी को एक बार इस्तेमाल होने वाला पेयरिंग कोड और उसके अपने डिवाइस क्रेडेंशियल मिलते हैं। वॉइस में पढ़ने और Talk का एक्सेस शामिल है, लेकिन एडमिन एक्सेस नहीं है। माइक्रोफ़ोन तभी चालू होता है जब आप घड़ी पर शुरू करें टैप करते हैं। iPhone से दूर होने पर एक सुरक्षित और पहुँच योग्य Gateway URL आवश्यक है।"}},"ar":{"stringUnit":{"state":"translated","value":"تتلقى الساعة رمز إقران يُستخدم لمرة واحدة وبيانات اعتماد خاصة بها. يتوفر الصوت مع صلاحيتَي القراءة والتحدث، دون صلاحيات المسؤول. لا يبدأ الميكروفون بالعمل إلا عند النقر على «بدء» على الساعة. يلزم عنوان URL آمن لـ Gateway يمكن الوصول إليه عند الابتعاد عن iPhone."}},"it":{"stringUnit":{"state":"translated","value":"L’orologio riceve un codice di abbinamento monouso e credenziali proprie del dispositivo. La voce è inclusa con accesso in lettura e a Talk, senza accesso amministratore. Il microfono si attiva solo quando tocchi Avvia sull’orologio. Quando sei lontano dall’iPhone, è necessario un URL sicuro e raggiungibile del Gateway."}},"tr":{"stringUnit":{"state":"translated","value":"Saat, tek kullanımlık bir eşleştirme kodu ve kendine ait cihaz kimlik bilgilerini alır. Ses özelliği, yönetici erişimi olmadan okuma ve Talk erişimiyle birlikte sunulur. Mikrofon yalnızca saatte Başlat'a dokunduğunuzda açılır. iPhone'dan uzaktayken erişilebilir, güvenli bir Gateway URL'si gereklidir."}},"uk":{"stringUnit":{"state":"translated","value":"Годинник отримує одноразовий код сполучення та власні облікові дані пристрою. Голосові функції доступні з правами на читання та доступом до Talk, без прав адміністратора. Мікрофон вмикається лише після натискання «Почати» на годиннику. Коли iPhone не поруч, потрібна доступна захищена URL-адреса Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Jam tangan menerima kode pemasangan sekali pakai dan kredensial perangkatnya sendiri. Fitur suara disertakan dengan akses baca dan Talk, tanpa akses admin. Mikrofon hanya aktif saat Anda mengetuk Mulai di jam tangan. URL Gateway yang aman dan dapat dijangkau diperlukan saat berada jauh dari iPhone."}},"pl":{"stringUnit":{"state":"translated","value":"Zegarek otrzymuje jednorazowy kod parowania i własne dane uwierzytelniające urządzenia. Obsługa głosu obejmuje uprawnienia do odczytu i dostęp do Talk, bez uprawnień administratora. Mikrofon włącza się dopiero po stuknięciu Start na zegarku. Poza zasięgiem iPhone’a wymagany jest osiągalny, bezpieczny adres URL Gateway."}},"th":{"stringUnit":{"state":"translated","value":"นาฬิกาจะได้รับรหัสจับคู่แบบใช้ครั้งเดียวและข้อมูลรับรองอุปกรณ์ของตัวเอง การใช้งานเสียงมาพร้อมกับสิทธิ์การอ่านและการเข้าถึง Talk โดยไม่มีสิทธิ์ผู้ดูแลระบบ ไมโครโฟนจะเริ่มทำงานเมื่อคุณแตะเริ่มบนนาฬิกาเท่านั้น เมื่ออยู่ห่างจาก iPhone จำเป็นต้องใช้ URL ของ Gateway ที่ปลอดภัยและเข้าถึงได้"}},"vi":{"stringUnit":{"state":"translated","value":"Đồng hồ nhận mã ghép đôi dùng một lần và thông tin xác thực thiết bị riêng. Tính năng giọng nói được tích hợp với quyền đọc và quyền truy cập Talk, không có quyền quản trị. Micrô chỉ bật khi bạn chạm vào Bắt đầu trên đồng hồ. Khi ở xa iPhone, cần có URL Gateway bảo mật có thể truy cập được."}},"nl":{"stringUnit":{"state":"translated","value":"Het horloge ontvangt een eenmalige koppelingscode en eigen apparaatreferenties. Spraak is inbegrepen met lees- en Talk-toegang, zonder beheerderstoegang. De microfoon wordt pas ingeschakeld wanneer je op Start tikt op het horloge. Buiten het bereik van de iPhone is een bereikbare, beveiligde Gateway-URL vereist."}},"fa":{"stringUnit":{"state":"translated","value":"ساعت یک کد جفت‌سازی یک‌بارمصرف و اطلاعات احراز هویت مختص خود را دریافت می‌کند. قابلیت صوتی با دسترسی خواندن و Talk، بدون دسترسی مدیر، ارائه می‌شود. میکروفون تنها زمانی فعال می‌شود که روی Start در ساعت بزنید. برای استفاده دور از iPhone، یک URL امن و قابل‌دسترسی برای Gateway لازم است."}},"ru":{"stringUnit":{"state":"translated","value":"Часы получают одноразовый код сопряжения и собственные учётные данные устройства. Голосовые функции доступны с правами на чтение и доступом к Talk, без прав администратора. Микрофон включается только при нажатии «Начать» на часах. Для работы вдали от iPhone требуется доступный защищённый URL Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Klockan får en parkopplingskod för engångsbruk och egna inloggningsuppgifter för enheten. Röstfunktioner ingår med läsbehörighet och åtkomst till Talk, utan administratörsbehörighet. Mikrofonen startar bara när du trycker på Start på klockan. När du är borta från din iPhone krävs en säker URL till Gateway som går att nå."}}}},
    "The widget image could not be captured.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The widget image could not be captured."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法捕捉小组件图像。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法擷取小工具圖片。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível capturar a imagem do widget."}},"de":{"stringUnit":{"state":"translated","value":"Das Widget-Bild konnte nicht aufgenommen werden."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo capturar la imagen del widget."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ウィジェットの画像をキャプチャできませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"위젯 이미지를 캡처할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’image du widget n’a pas pu être capturée."}},"hi":{"stringUnit":{"state":"translated","value":"विजेट की छवि कैप्चर नहीं की जा सकी।"}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر التقاط صورة الأداة."}},"it":{"stringUnit":{"state":"translated","value":"Non è stato possibile acquisire l'immagine del widget."}},"tr":{"stringUnit":{"state":"translated","value":"Araç takımı görüntüsü yakalanamadı."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося зробити знімок віджета."}},"id":{"stringUnit":{"state":"translated","value":"Gambar widget tidak dapat ditangkap."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się przechwycić obrazu widżetu."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถจับภาพวิดเจ็ตได้."}},"vi":{"stringUnit":{"state":"translated","value":"Không thể chụp ảnh tiện ích."}},"nl":{"stringUnit":{"state":"translated","value":"De widgetafbeelding kon niet worden vastgelegd."}},"fa":{"stringUnit":{"state":"translated","value":"تصویر ویجت ثبت نشد."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось сделать снимок виджета."}},"sv":{"stringUnit":{"state":"translated","value":"Widgetbilden kunde inte tas."}}}},
    "The widget image could not be copied.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The widget image could not be copied."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法拷贝小组件图像。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法複製小工具圖片。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível copiar a imagem do widget."}},"de":{"stringUnit":{"state":"translated","value":"Das Widget-Bild konnte nicht kopiert werden."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo copiar la imagen del widget."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ウィジェットの画像をコピーできませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"위젯 이미지를 복사할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’image du widget n’a pas pu être copiée."}},"hi":{"stringUnit":{"state":"translated","value":"विजेट की छवि कॉपी नहीं की जा सकी।"}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر نسخ صورة الأداة."}},"it":{"stringUnit":{"state":"translated","value":"Non è stato possibile copiare l'immagine del widget."}},"tr":{"stringUnit":{"state":"translated","value":"Araç takımı görüntüsü kopyalanamadı."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося скопіювати зображення віджета."}},"id":{"stringUnit":{"state":"translated","value":"Gambar widget tidak dapat disalin."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się skopiować obrazu widżetu."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถคัดลอกภาพวิดเจ็ตได้"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể sao chép ảnh tiện ích."}},"nl":{"stringUnit":{"state":"translated","value":"De widgetafbeelding kon niet worden gekopieerd."}},"fa":{"stringUnit":{"state":"translated","value":"تصویر ویجت کپی نشد."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось скопировать изображение виджета."}},"sv":{"stringUnit":{"state":"translated","value":"Widgetbilden kunde inte kopieras."}}}},
    "The widget image could not be encoded as PNG.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The widget image could not be encoded as PNG."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法将小组件图像编码为 PNG."}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法將小工具圖片編碼為 PNG。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível codificar a imagem do widget como PNG."}},"de":{"stringUnit":{"state":"translated","value":"Das Widget-Bild konnte nicht als PNG kodiert werden."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo codificar la imagen del widget como PNG."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ウィジェットの画像をPNG形式でエンコードできませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"위젯 이미지를 PNG로 인코딩할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’image du widget n’a pas pu être encodée au format PNG."}},"hi":{"stringUnit":{"state":"translated","value":"विजेट की छवि को PNG के रूप में एन्कोड नहीं किया जा सका।"}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر ترميز صورة الأداة بتنسيق PNG."}},"it":{"stringUnit":{"state":"translated","value":"Non è stato possibile codificare l'immagine del widget in formato PNG."}},"tr":{"stringUnit":{"state":"translated","value":"Araç takımı görüntüsü PNG olarak kodlanamadı."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося закодувати зображення віджета у форматі PNG."}},"id":{"stringUnit":{"state":"translated","value":"Gambar widget tidak dapat dikodekan sebagai PNG."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się zakodować obrazu widżetu w formacie PNG."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถเข้ารหัสภาพวิดเจ็ตเป็น PNG ได้"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể mã hóa ảnh tiện ích dưới dạng PNG."}},"nl":{"stringUnit":{"state":"translated","value":"De widgetafbeelding kon niet als PNG worden gecodeerd."}},"fa":{"stringUnit":{"state":"translated","valu