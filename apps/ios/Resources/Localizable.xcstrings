    "Out-of-app approval alerts need notification permission.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Out-of-app approval alerts need notification permission."}},"zh-CN":{"stringUnit":{"state":"translated","value":"应用外审批提醒需要通知权限。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"應用程式外的核准提醒需要通知權限。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Alertas de aprovação fora do app precisam de permissão para notificações."}},"de":{"stringUnit":{"state":"translated","value":"Für Genehmigungsbenachrichtigungen außerhalb der App ist eine Mitteilungsberechtigung erforderlich."}},"es":{"stringUnit":{"state":"translated","value":"Las alertas de aprobación fuera de la aplicación requieren permiso para enviar notificaciones."}},"ja-JP":{"stringUnit":{"state":"translated","value":"アプリ外での承認アラートには通知の許可が必要です。"}},"ko":{"stringUnit":{"state":"translated","value":"앱 외부 승인 알림에는 알림 권한이 필요합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les alertes d’approbation hors de l’application nécessitent l’autorisation d’envoyer des notifications."}},"hi":{"stringUnit":{"state":"translated","value":"ऐप के बाहर स्वीकृति अलर्ट के लिए सूचनाओं की अनुमति आवश्यक है."}},"ar":{"stringUnit":{"state":"translated","value":"تتطلب تنبيهات الموافقة خارج التطبيق إذن الإشعارات."}},"it":{"stringUnit":{"state":"translated","value":"Gli avvisi di approvazione al di fuori dell'app richiedono l'autorizzazione per le notifiche."}},"tr":{"stringUnit":{"state":"translated","value":"Uygulama dışı onay uyarıları için bildirim izni gerekir."}},"uk":{"stringUnit":{"state":"translated","value":"Для сповіщень про запити на схвалення поза застосунком потрібен дозвіл на сповіщення."}},"id":{"stringUnit":{"state":"translated","value":"Peringatan persetujuan di luar aplikasi memerlukan izin notifikasi."}},"pl":{"stringUnit":{"state":"translated","value":"Alerty o prośbach o zatwierdzenie poza aplikacją wymagają uprawnienia do wysyłania powiadomień."}},"th":{"stringUnit":{"state":