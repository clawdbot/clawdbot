    "Review gateway action": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Review gateway action"}},"zh-CN":{"stringUnit":{"state":"translated","value":"审查 Gateway 操作"}},"zh-TW":{"stringUnit":{"state":"translated","value":"審查 Gateway 動作"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Revisar ação do Gateway"}},"de":{"stringUnit":{"state":"translated","value":"Gateway-Aktion überprüfen"}},"es":{"stringUnit":{"state":"translated","value":"Revisar acción del Gateway"}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayのアクションを確認"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway 작업 검토"}},"fr":{"stringUnit":{"state":"translated","value":"Examiner l’action du Gateway"}},"hi":{"stringUnit":{"state":"translated","value":"Gateway कार्रवाई की समीक्षा करें"}},"ar":{"stringUnit":{"state":"translated","value":"مراجعة إجراء Gateway"}},"it":{"stringUnit":{"state":"translated","value":"Esamina l'azione del gateway"}},"tr":{"stringUnit":{"state":"translated","value":"Gateway eylemini incele"}},"uk":{"stringUnit":{"state":"translated","value":"Переглянути дію шлюзу"}},"id":{"stringUnit":{"state":"translated","value":"Tinjau tindakan Gateway"}},"pl":{"stringUnit":{"state":"translated","value":"Sprawdź działanie bramy"}},"th":{"stringUnit":{"state":"translated","value":"ตรวจสอบการดำเนินการของ Gateway"}},"vi":{"stringUnit":{"state":"translated","value":"Xem xét thao tác của Gateway"}},"nl":{"stringUnit":{"state":"translated","value":"Gateway-actie beoordelen"}},"fa":{"stringUnit":{"state":"translated","value":"بررسی اقدام Gateway"}},"ru":{"stringUnit":{"state":"translated","value":"Проверить действие Gateway"}},"sv":{"stringUnit":{"state":"translated","value":"Granska gateway-åtgärd"}}}},
    "Review pending gateway actions.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Review pending gateway actions."}},"zh-CN":{"stringUnit":{"state":"translated","value":"审查待处理的 Gateway 操作。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"審查待處理的 Gateway 動作。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Revise as ações pendentes do Gateway."}},"de":{"stringUnit":{"state":"translated","value":"Ausstehende Gateway-Aktionen überprüfen."}},"es":{"stringUnit":{"state":"translated","value":"Revisa las acciones pendientes del Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"保留中のGatewayのアクションを確認します。"}},"ko":{"stringUnit":{"state":"translated","value":"대기 중인 Gateway 작업을 검토하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Examiner les actions du Gateway en attente."}},"hi":{"stringUnit":{"state":"translated","value":"लंबित Gateway कार्रवाइयों की समीक्षा करें."}},"ar":{"stringUnit":{"state":"translated","value":"مراجعة إجراءات Gateway المعلّقة."}},"it":{"stringUnit":{"state":"translated","value":"Esamina le azioni del gateway in sospeso."}},"tr":{"stringUnit":{"state":"translated","value":"Bekleyen Gateway eylemlerini inceleyin."}},"uk":{"stringUnit":{"state":"translated","value":"Перегляньте дії шлюзу, що очікують на розгляд."}},"id":{"stringUnit":{"state":"translated","value":"Tinjau tindakan Gateway yang tertunda."}},"pl":{"stringUnit":{"state":"translated","value":"Sprawdź oczekujące działania bramy."}},"th":{"stringUnit":{"state":"translated","value":"ตรวจสอบการดำเนินการของ Gateway ที่รอดำเนินการ."}},"vi":{"stringUnit":{"state":"translated","value":"Xem xét các thao tác đang chờ của Gateway."}},"nl":{"stringUnit":{"state":"translated","value":"Openstaande Gateway-acties beoordelen."}},"fa":{"stringUnit":{"state":"translated","value":"اقدام‌های در انتظار Gateway را بررسی کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Проверьте ожидающие действия Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Granska väntande gateway-åtgärder."}}}},
    "Review this endpoint. Credentials are applied only after you tap Connect.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Review this endpoint. Credentials are applied only after you tap Connect."}},"zh-CN":{"stringUnit":{"state":"translated","value":"请检查此端点。 凭据仅在你轻点“连接”后才会应用。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"請檢查此端點。 憑證只會在您點選「連線」後套用。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Revise este endpoint. As credenciais só serão aplicadas depois que você tocar em Conectar."}},"de":{"stringUnit":{"state":"translated","value":"Überprüfen Sie diesen Endpunkt. Die Zugangsdaten werden erst verwendet, wenn Sie auf Verbinden tippen."}},"es":{"stringUnit":{"state":"translated","value":"Revisa este punto de conexión. Las credenciales solo se aplicarán después de que toques Conectar."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このエンドポイントを確認してください。 認証情報は「接続」をタップした後にのみ適用されます。"}},"ko":{"stringUnit":{"state":"translated","value":"이 엔드포인트를 검토하세요. 자격 증명은 연결을 탭한 후에만 적용됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Examinez ce point de terminaison. Les identifiants ne sont appliqués qu’après avoir appuyé sur Se connecter."}},"hi":{"stringUnit":{"state":"translated","value":"इस एंडपॉइंट की समीक्षा करें. आपके कनेक्ट करें पर टैप करने के बाद ही क्रेडेंशियल लागू किए जाते हैं."}},"ar":{"stringUnit":{"state":"translated","value":"راجع نقطة النهاية هذه. لا تُطبَّق بيانات الاعتماد إلا بعد النقر على اتصال."}},"it":{"stringUnit":{"state":"translated","value":"Esamina questo endpoint. Le credenziali vengono applicate solo dopo aver toccato Connetti."}},"tr":{"stringUnit":{"state":"translated","value":"Bu uç noktayı inceleyin. Kimlik bilgileri yalnızca Bağlan'a dokunduktan sonra uygulanır."}},"uk":{"stringUnit":{"state":"translated","value":"Перегляньте цю кінцеву точку. Облікові дані застосовуються лише після натискання «Підключитися»."}},"id":{"stringUnit":{"state":"translated","value":"Tinjau titik akhir ini. Kredensial hanya diterapkan setelah Anda mengetuk Hubungkan."}},"pl":{"stringUnit":{"state":"translated","value":"Sprawdź ten punkt końcowy. Dane uwierzytelniające zostaną użyte dopiero po stuknięciu przycisku Połącz."}},"th":{"stringUnit":{"state":"translated","value":"ตรวจสอบปลายทางนี้. ข้อมูลรับรองจะถูกใช้หลังจากที่คุณแตะเชื่อมต่อเท่านั้น."}},"vi":{"stringUnit":{"state":"translated","value":"Xem xét điểm cuối này. Thông tin xác thực chỉ được áp dụng sau khi bạn chạm vào Kết nối."}},"nl":{"stringUnit":{"state":"translated","value":"Controleer dit eindpunt. Inloggegevens worden pas toegepast nadat je op Verbinden tikt."}},"fa":{"stringUnit":{"state":"translated","value":"این نقطهٔ پایانی را بررسی کنید. اطلاعات احراز هویت فقط پس از ضربه زدن روی اتصال اعمال می‌شوند."}},"ru":{"stringUnit":{"state":"translated","value":"Проверьте эту конечную точку. Учётные данные будут применены только после нажатия «Подключиться»."}},"sv":{"stringUnit":{"state":"translated","value":"Granska denna slutpunkt. Inloggningsuppgifter används först när du trycker på Anslut."}}}},
    "Review this exec request before continuing. Your decision will be sent back to the gateway.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Review this exec request before continuing. Your decision will be sent back to the gateway."}},"zh-CN":{"stringUnit":{"state":"translated","value":"继续前，请审查此执行请求。 你的决定将发送回 Gateway."}},"zh-TW":{"stringUnit":{"state":"translated","value":"繼續前請先審查此執行請求。 您的決定將傳回 Gateway."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Revise esta solicitação de execução antes de continuar. Sua decisão será enviada de volta ao Gateway."}},"de":{"stringUnit":{"state":"translated","value":"Überprüfen Sie diese Ausführungsanfrage, bevor Sie fortfahren. Ihre Entscheidung wird an das Gateway zurückgesendet."}},"es":{"stringUnit":{"state":"translated","value":"Revisa esta solicitud de ejecución antes de continuar. Tu decisión se enviará al Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"続行する前にこの実行リクエストを確認してください。 判断結果はGatewayに送信されます。"}},"ko":{"stringUnit":{"state":"translated","value":"계속하기 전에 이 실행 요청을 검토하세요. 결정 사항은 Gateway로 다시 전송됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Examinez cette demande d’exécution avant de continuer. Votre décision sera renvoyée au Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"जारी रखने से पहले इस निष्पादन अनुरोध की समीक्षा करें. आपका निर्णय Gateway को वापस भेजा जाएगा."}},"ar":{"stringUnit":{"state":"translated","value":"راجع طلب التنفيذ هذا قبل المتابعة. سيُرسَل قرارك إلى Gateway."}},"it":{"stringUnit":{"state":"translated","value":"Esamina questa richiesta di esecuzione prima di continuare. La tua decisione verrà inviata al gateway."}},"tr":{"stringUnit":{"state":"translated","value":"Devam etmeden önce bu çalıştırma isteğini inceleyin. Kararınız Gateway'e geri gönderilecektir."}},"uk":{"stringUnit":{"state":"translated","value":"Перегляньте цей запит на виконання, перш ніж продовжити. Ваше рішення буде надіслано назад до шлюзу."}},"id":{"stringUnit":{"state":"translated","value":"Tinjau permintaan eksekusi ini sebelum melanjutkan. Keputusan Anda akan dikirim kembali ke Gateway."}},"pl":{"stringUnit":{"state":"translated","value":"Sprawdź to żądanie wykonania przed kontynuowaniem. Twoja decyzja zostanie odesłana do bramy."}},"th":{"stringUnit":{"state":"translated","value":"ตรวจสอบคำขอเรียกใช้คำสั่งนี้ก่อนดำเนินการต่อ. การตัดสินใจของคุณจะถูกส่งกลับไปยัง Gateway."}},"vi":{"stringUnit":{"state":"translated","value":"Xem xét yêu cầu thực thi này trước khi tiếp tục. Quyết định của bạn sẽ được gửi lại cho Gateway."}},"nl":{"stringUnit":{"state":"translated","value":"Beoordeel dit uitvoeringsverzoek voordat je doorgaat. Je beslissing wordt teruggestuurd naar de Gateway."}},"fa":{"stringUnit":{"state":"translated","value":"این درخواست اجرا را پیش از ادامه بررسی کنید. تصمیم شما به Gateway بازگردانده می‌شود."}},"ru":{"stringUnit":{"state":"translated","value":"Проверьте этот запрос на выполнение, прежде чем продолжить. Ваше решение будет отправлено обратно в Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Granska denna körningsbegäran innan du fortsätter. Ditt beslut skickas tillbaka till gatewayen."}}}},
