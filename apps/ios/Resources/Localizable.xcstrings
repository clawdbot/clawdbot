    "Location sharing is disabled in OpenClaw. Location Services are off in iOS Settings.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Location sharing is disabled in OpenClaw. Location Services are off in iOS Settings."}},"zh-CN":{"stringUnit":{"state":"translated","value":"OpenClaw 中的位置共享已禁用。 iOS 设置中的定位服务已关闭。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw 中的位置分享已停用。 iOS 設定中的定位服務已關閉。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O compartilhamento de localização está desativado no OpenClaw. Os Serviços de Localização estão desativados nos Ajustes do iOS."}},"de":{"stringUnit":{"state":"translated","value":"Die Standortfreigabe ist in OpenClaw deaktiviert. Die Ortungsdienste sind in den iOS-Einstellungen deaktiviert."}},"es":{"stringUnit":{"state":"translated","value":"Compartir ubicación está desactivado en OpenClaw. Los servicios de ubicación están desactivados en Ajustes de iOS."}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClawで位置情報の共有が無効になっています。 iOSの設定で位置情報サービスがオフになっています。"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw에서 위치 공유가 비활성화되어 있습니다. iOS 설정에서 위치 서비스가 꺼져 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le partage de localisation est désactivé dans OpenClaw. Le service de localisation est désactivé dans les réglages iOS."}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw में स्थान साझा करना अक्षम है. iOS सेटिंग्स में स्थान सेवाएँ बंद हैं."}},"ar":{"stringUnit":{"state":"translated","value":"مشاركة الموقع معطّلة في OpenClaw. خدمات الموقع متوقفة في إعدادات iOS."}},"it":{"stringUnit":{"state":"translated","value":"La condivisione della posizione è disabilitata in OpenClaw. I servizi di localizzazione sono disattivati nelle impostazioni di iOS."}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw'da konum paylaşımı devre dışı. iOS Ayarları'nda Konum Servisleri kapalı."}},"uk":{"stringUnit":{"state":"translated","value":"Поширення місцеположення вимкнено в OpenClaw. Служби геолокації вимкнено в налаштуваннях iOS."}},"id":{"stringUnit":{"state":"translated","value":"Berbagi lokasi dinonaktifkan di OpenClaw. Layanan Lokasi dinonaktifkan di Pengaturan iOS."}},"pl":{"stringUnit":{"state":"translated","value":"Udostępnianie lokalizacji jest wyłączone w OpenClaw. Usługi lokalizacji są wyłączone w ustawieniach iOS."}},"th":{"stringUnit":{"state":"translated","value":"การแชร์ตำแหน่งที่ตั้งถูกปิดใช้งานใน OpenClaw บริการหาตำแหน่งที่ตั้งปิดอยู่ในการตั้งค่า iOS"}},"vi":{"stringUnit":{"state":"translated","value":"Tính năng chia sẻ vị trí bị tắt trong OpenClaw. Dịch vụ định vị đang tắt trong Cài đặt iOS."}},"nl":{"stringUnit":{"state":"translated","value":"Locatie delen is uitgeschakeld in OpenClaw. Locatievoorzieningen zijn uitgeschakeld in de iOS-instellingen."}},"fa":{"stringUnit":{"state":"translated","value":"اشتراک‌گذاری موقعیت مکانی در OpenClaw غیرفعال است. خدمات موقعیت مکانی در تنظیمات iOS خاموش است."}},"ru":{"stringUnit":{"state":"translated","value":"Передача геопозиции отключена в OpenClaw. Службы геолокации выключены в настройках iOS."}},"sv":{"stringUnit":{"state":"translated","value":"Platsdelning är inaktiverad i OpenClaw. Platstjänster är avstängda i iOS-inställningarna."}}}},
