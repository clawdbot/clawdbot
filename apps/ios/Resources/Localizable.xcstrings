    "Connect to this Gateway": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connect to this Gateway"}},"zh-CN":{"stringUnit":{"state":"translated","value":"连接到此 Gateway"}},"zh-TW":{"stringUnit":{"state":"translated","value":"連接至此 Gateway"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Conectar a este Gateway"}},"de":{"stringUnit":{"state":"translated","value":"Mit diesem Gateway verbinden"}},"es":{"stringUnit":{"state":"translated","value":"Conectar a este Gateway"}},"ja-JP":{"stringUnit":{"state":"translated","value":"このGatewayに接続"}},"ko":{"stringUnit":{"state":"translated","value":"이 Gateway에 연결"}},"fr":{"stringUnit":{"state":"translated","value":"Se connecter à ce Gateway"}},"hi":{"stringUnit":{"state":"translated","value":"इस Gateway से कनेक्ट करें"}},"ar":{"stringUnit":{"state":"translated","value":"الاتصال بـ Gateway هذا"}},"it":{"stringUnit":{"state":"translated","value":"Connettiti a questo Gateway"}},"tr":{"stringUnit":{"state":"translated","value":"Bu Gateway'e bağlanın"}},"uk":{"stringUnit":{"state":"translated","value":"Підключитися до цього Gateway"}},"id":{"stringUnit":{"state":"translated","value":"Hubungkan ke Gateway ini"}},"pl":{"stringUnit":{"state":"translated","value":"Połącz z tym Gateway"}},"th":{"stringUnit":{"state":"translated","value":"เชื่อมต่อกับ Gateway นี้"}},"vi":{"stringUnit":{"state":"translated","value":"Kết nối với Gateway này"}},"nl":{"stringUnit":{"state":"translated","value":"Verbinding maken met deze Gateway"}},"fa":{"stringUnit":{"state":"translated","value":"به این Gateway متصل شوید"}},"ru":{"stringUnit":{"state":"translated","value":"Подключиться к этому Gateway"}},"sv":{"stringUnit":{"state":"translated","value":"Anslut till denna Gateway"}}}},
    "Connect to your Gateway, then run Start Live Voice again.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connect to your Gateway, then run Start Live Voice again."}},"zh-CN":{"stringUnit":{"state":"translated","value":"请连接到你的 Gateway，然后再次启动实时语音。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"請先連線至您的 Gateway，再次執行「啟動即時語音」。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Conecte-se ao seu Gateway e execute Iniciar conversa por voz ao vivo novamente."}},"de":{"stringUnit":{"state":"translated","value":"Verbinde dich mit deinem Gateway und starte dann Live Voice erneut."}},"es":{"stringUnit":{"state":"translated","value":"Conéctate a tu Gateway y vuelve a iniciar la voz en directo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayに接続してから、もう一度ライブ音声を開始してください。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway에 연결한 다음 실시간 음성 시작을 다시 실행하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Connectez-vous à votre Gateway, puis relancez la voix en direct."}},"hi":{"stringUnit":{"state":"translated","value":"अपने Gateway से कनेक्ट करें, फिर लाइव वॉइस दोबारा शुरू करें।"}},"ar":{"stringUnit":{"state":"translated","value":"اتصل بـ Gateway الخاص بك، ثم شغّل الصوت المباشر مرة أخرى."}},"it":{"stringUnit":{"state":"translated","value":"Connettiti al tuo Gateway, poi riprova ad avviare la conversazione vocale in tempo reale."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway'inize bağlanın, ardından Canlı Sesi Başlat işlemini yeniden çalıştırın."}},"uk":{"stringUnit":{"state":"translated","value":"Підключіться до свого Gateway, а потім знову запустіть голосове спілкування наживо."}},"id":{"stringUnit":{"state":"translated","value":"Hubungkan ke Gateway Anda, lalu jalankan Mulai Suara Langsung lagi."}},"pl":{"stringUnit":{"state":"translated","value":"Połącz się z Gateway, a następnie ponownie uruchom rozmowę głosową na żywo."}},"th":{"stringUnit":{"state":"translated","value":"เชื่อมต่อกับ Gateway ของคุณ แล้วเริ่มโหมดเสียงสดอีกครั้ง"}},"vi":{"stringUnit":{"state":"translated","value":"Kết nối với Gateway của bạn, rồi khởi động lại chế độ thoại trực tiếp."}},"nl":{"stringUnit":{"state":"translated","value":"Maak verbinding met je Gateway en start daarna Live Voice opnieuw."}},"fa":{"stringUnit":{"state":"translated","value":"به Gateway خود متصل شوید، سپس دوباره صدای زنده را شروع کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Подключитесь к своему Gateway, затем снова запустите голосовой разговор."}},"sv":{"stringUnit":{"state":"translated","value":"Anslut till din Gateway och starta sedan liveröst igen."}}}},
    "Connect to your gateway to open a shell in the agent workspace.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connect to your gateway to open a shell in the agent workspace."}},"zh-CN":{"stringUnit":{"state":"translated","value":"连接到您的网关以在智能体工作区中打开 shell."}},"zh-TW":{"stringUnit":{"state":"translated","value":"連接至您的 Gateway 以在代理程式工作區中開啟命令列介面。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Conecte-se ao seu gateway para abrir um shell no espaço de trabalho do agente."}},"de":{"stringUnit":{"state":"translated","value":"Verbinde dich mit deinem Gateway, um eine Shell im Arbeitsbereich des Agenten zu öffnen."}},"es":{"stringUnit":{"state":"translated","value":"Conéctate a tu gateway para abrir una shell en el espacio de trabajo del agente."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayに接続して、エージェントのワークスペースでシェルを開きます。"}},"ko":{"stringUnit":{"state":"translated","value":"에이전트 작업 공간에서 셸을 열려면 Gateway에 연결하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Connectez-vous à votre passerelle pour ouvrir un shell dans l’espace de travail de l’agent."}},"hi":{"stringUnit":{"state":"translated","value":"एजेंट कार्यक्षेत्र में शेल खोलने के लिए अपने Gateway से कनेक्ट करें."}},"ar":{"stringUnit":{"state":"translated","value":"اتصل بـ Gateway الخاص بك لفتح صدفة أوامر في مساحة عمل الوكيل."}},"it":{"stringUnit":{"state":"translated","value":"Connettiti al tuo gateway per aprire una shell nello spazio di lavoro dell'agente."}},"tr":{"stringUnit":{"state":"translated","value":"Aracının çalışma alanında bir kabuk açmak için Gateway'inize bağlanın."}},"uk":{"stringUnit":{"state":"translated","value":"Підключіться до свого шлюзу, щоб відкрити командну оболонку в робочому просторі агента."}},"id":{"stringUnit":{"state":"translated","value":"Hubungkan ke gateway Anda untuk membuka shell di ruang kerja agen."}},"pl":{"stringUnit":{"state":"translated","value":"Połącz ze swoją bramą, aby otworzyć powłokę w obszarze roboczym agenta."}},"th":{"stringUnit":{"state":"translated","value":"เชื่อมต่อกับ Gateway ของคุณเพื่อเปิดเชลล์ในพื้นที่ทำงานของเอเจนต์"}},"vi":{"stringUnit":{"state":"translated","value":"Kết nối với Gateway của bạn để mở shell trong không gian làm việc của tác nhân."}},"nl":{"stringUnit":{"state":"translated","value":"Maak verbinding met je gateway om een shell in de werkruimte van de agent te openen."}},"fa":{"stringUnit":{"state":"translated","value":"برای باز کردن یک پوسته در فضای کاری عامل، به Gateway خود متصل شوید."}},"ru":{"stringUnit":{"state":"translated","value":"Подключитесь к своему шлюзу, чтобы открыть командную оболочку в рабочем пространстве агента."}},"sv":{"stringUnit":{"state":"translated","value":"Anslut till din gateway för att öppna ett skal i agentens arbetsyta."}}}},
    "Connect to your gateway to open this session dashboard.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connect to your gateway to open this session dashboard."}},"zh-CN":{"stringUnit":{"state":"translated","value":"连接到您的网关以打开此会话仪表盘。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"連接至您的 Gateway 以開啟此工作階段儀表板。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Conecte-se ao seu gateway para abrir o painel desta sessão."}},"de":{"stringUnit":{"state":"translated","value":"Verbinde dich mit deinem Gateway, um dieses Sitzungsdashboard zu öffnen."}},"es":{"stringUnit":{"state":"translated","value":"Conéctate a tu gateway para abrir el panel de esta sesión."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayに接続して、このセッションのダッシュボードを開きます。"}},"ko":{"stringUnit":{"state":"translated","value":"이 세션 대시보드를 열려면 Gateway에 연결하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Connectez-vous à votre passerelle pour ouvrir le tableau de bord de cette session."}},"hi":{"stringUnit":{"state":"translated","value":"इस सत्र का डैशबोर्ड खोलने के लिए अपने Gateway से कनेक्ट करें."}},"ar":{"stringUnit":{"state":"translated","value":"اتصل بـ Gateway الخاص بك لفتح لوحة معلومات هذه الجلسة."}},"it":{"stringUnit":{"state":"translated","value":"Connettiti al tuo gateway per aprire la dashboard di questa sessione."}},"tr":{"stringUnit":{"state":"translated","value":"Bu oturumun panosunu açmak için Gateway'inize bağlanın."}},"uk":{"stringUnit":{"state":"translated","value":"Підключіться до свого шлюзу, щоб відкрити цю панель сеансу."}},"id":{"stringUnit":{"state":"translated","value":"Hubungkan ke gateway Anda untuk membuka dasbor sesi ini."}},"pl":{"stringUnit":{"state":"translated","value":"Połącz ze swoją bramą, aby otworzyć panel tej sesji."}},"th":{"stringUnit":{"state":"translated","value":"เชื่อมต่อกับ Gateway ของคุณเพื่อเปิดแดชบอร์ดของเซสชันนี้"}},"vi":{"stringUnit":{"state":"translated","value":"Kết nối với Gateway của bạn để mở bảng điều khiển phiên này."}},"nl":{"stringUnit":{"state":"translated","value":"Maak verbinding met je gateway om dit sessiedashboard te openen."}},"fa":{"stringUnit":{"state":"translated","value":"برای باز کردن داشبورد این نشست به Gateway خود متصل شوید."}},"ru":{"stringUnit":{"state":"translated","value":"Подключитесь к своему шлюзу, чтобы открыть панель управления этим сеансом."}},"sv":{"stringUnit":{"state":"translated","value":"Anslut till din gateway för att öppna denna sessionsöversikt."}}}},
    "Connect to your gateway to view an observable machine.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connect to your gateway to view an observable machine."}},"zh-CN":{"stringUnit":{"state":"translated","value":"连接到您的网关以查看可观测的机器。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"連接至您的 Gateway 以檢視可觀測的機器。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Conecte-se ao seu gateway para visualizar uma máquina observável."}},"de":{"stringUnit":{"state":"translated","value":"Verbinde dich mit deinem Gateway, um einen überwachbaren Rechner anzuzeigen."}},"es":{"stringUnit":{"state":"translated","value":"Conéctate a tu gateway para ver una máquina observable."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayに接続して、監視可能なマシンを表示します。"}},"ko":{"stringUnit":{"state":"translated","value":"모니터링 가능한 머신을 보려면 Gateway에 연결하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Connectez-vous à votre passerelle pour afficher une machine observable."}},"hi":{"stringUnit":{"state":"translated","value":"निगरानी योग्य मशीन देखने के लिए अपने Gateway से कनेक्ट करें."}},"ar":{"stringUnit":{"state":"translated","value":"اتصل بـ Gateway الخاص بك لعرض جهاز قابل للمراقبة."}},"it":{"stringUnit":{"state":"translated","value":"Connettiti al tuo gateway per visualizzare una macchina osservabile."}},"tr":{"stringUnit":{"state":"translated","value":"İzlenebilir bir makineyi görüntülemek için Gateway'inize bağlanın."}},"uk":{"stringUnit":{"state":"translated","value":"Підключіться до свого шлюзу, щоб переглянути комп’ютер, доступний для спостереження."}},"id":{"stringUnit":{"state":"translated","value":"Hubungkan ke gateway Anda untuk melihat mesin yang dapat dipantau."}},"pl":{"stringUnit":{"state":"translated","value":"Połącz ze swoją bramą, aby wyświetlić monitorowaną maszynę."}},"th":{"stringUnit":{"state":"translated","value":"เชื่อมต่อกับ Gateway ของคุณเพื่อดูเครื่องที่สามารถตรวจสอบสถานะได้"}},"vi":{"stringUnit":{"state":"translated","value":"Kết nối với Gateway của bạn để xem một máy có thể giám sát."}},"nl":{"stringUnit":{"state":"translated","value":"Maak verbinding met je gateway om een waarneembare machine te bekijken."}},"fa":{"stringUnit":{"state":"translated","value":"برای مشاهدهٔ یک ماشین قابل پایش به Gateway خود متصل شوید."}},"ru":{"stringUnit":{"state":"translated","value":"Подключитесь к своему шлюзу, чтобы просмотреть наблюдаемый компьютер."}},"sv":{"stringUnit":{"state":"translated","value":"Anslut till din gateway för att visa en maskin som kan övervakas."}}}},
    "Connected": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connected"}},"zh-CN":{"stringUnit":{"state":"translated","value":"已连接"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已連線"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Conectado"}},"de":{"stringUnit":{"state":"translated","value":"Verbunden"}},"es":{"stringUnit":{"state":"translated","value":"Conectado"}},"ja-JP":{"stringUnit":{"state":"translated","value":"接続済み"}},"ko":{"stringUnit":{"state":"translated","value":"연결됨"}},"fr":{"stringUnit":{"state":"translated","value":"Connecté"}},"hi":{"stringUnit":{"state":"translated","value":"कनेक्ट है"}},"ar":{"stringUnit":{"state":"translated","value":"متصل"}},"it":{"stringUnit":{"state":"translated","value":"Connesso"}},"tr":{"stringUnit":{"state":"translated","value":"Bağlandı"}},"uk":{"stringUnit":{"state":"translated","value":"Підключено"}},"id":{"stringUnit":{"state":"translated","value":"Terhubung"}},"pl":{"stringUnit":{"state":"translated","value":"Połączono"}},"th":{"stringUnit":{"state":"translated","value":"เชื่อมต่อแล้ว"}},"vi":{"stringUnit":{"state":"translated","value":"Đã kết nối"}},"nl":{"stringUnit":{"state":"translated","value":"Verbonden"}},"fa":{"stringUnit":{"state":"translated","value":"متصل"}},"ru":{"stringUnit":{"state":"translated","value":"Подключено"}},"sv":{"stringUnit":{"state":"translated","value":"Ansluten"}}}},
    "Connected directly. Reconnect from iPhone Settings → Apple Watch to add voice.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connected directly. Reconnect from iPhone Settings → Apple Watch to add voice."}},"zh-CN":{"stringUnit":{"state":"translated","value":"已直接连接。请从 iPhone 的设置 → Apple Watch 重新连接，以启用语音功能。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已直接連線。請從 iPhone 的設定 → Apple Watch 重新連線，以啟用語音功能。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Conectado diretamente. Reconecte em Ajustes → Apple Watch no iPhone para adicionar voz."}},"de":{"stringUnit":{"state":"translated","value":"Direkt verbunden. Stelle auf dem iPhone unter Einstellungen → Apple Watch erneut eine Verbindung her, um die Sprachfunktion hinzuzufügen."}},"es":{"stringUnit":{"state":"translated","value":"Conectado directamente. Vuelve a conectarte desde Ajustes → Apple Watch en el iPhone para añadir voz."}},"ja-JP":{"stringUnit":{"state":"translated","value":"直接接続されています。音声機能を追加するには、iPhoneの設定 → Apple Watchから再接続してください。"}},"ko":{"stringUnit":{"state":"translated","value":"직접 연결되었습니다. 음성 기능을 추가하려면 iPhone의 설정 → Apple Watch에서 다시 연결하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Connexion directe établie. Reconnectez-vous depuis Réglages → Apple Watch sur l’iPhone pour ajouter la voix."}},"hi":{"stringUnit":{"state":"translated","value":"सीधे कनेक्ट किया गया है। वॉइस जोड़ने के लिए iPhone की सेटिंग्स → Apple Watch से फिर से कनेक्ट करें।"}},"ar":{"stringUnit":{"state":"translated","value":"متصل مباشرةً. أعد الاتصال من الإعدادات على iPhone → Apple Watch لإضافة الصوت."}},"it":{"stringUnit":{"state":"translated","value":"Connessione diretta attiva. Riconnettiti da Impostazioni → Apple Watch su iPhone per aggiungere la voce."}},"tr":{"stringUnit":{"state":"translated","value":"Doğrudan bağlandı. Ses özelliğini eklemek için iPhone'da Ayarlar → Apple Watch üzerinden yeniden bağlanın."}},"uk":{"stringUnit":{"state":"translated","value":"Підключено напряму. Щоб додати голосові функції, підключіться повторно з iPhone через Налаштування → Apple Watch."}},"id":{"stringUnit":{"state":"translated","value":"Terhubung langsung. Hubungkan ulang dari Pengaturan iPhone → Apple Watch untuk menambahkan fitur suara."}},"pl":{"stringUnit":{"state":"translated","value":"Połączono bezpośrednio. Aby dodać obsługę głosu, połącz ponownie z iPhone’a: Ustawienia → Apple Watch."}},"th":{"stringUnit":{"state":"translated","value":"เชื่อมต่อโดยตรงแล้ว เชื่อมต่ออีกครั้งจากการตั้งค่าบน iPhone → Apple Watch เพื่อเพิ่มการใช้งานเสียง"}},"vi":{"stringUnit":{"state":"translated","value":"Đã kết nối trực tiếp. Kết nối lại từ Cài đặt trên iPhone → Apple Watch để thêm tính năng giọng nói."}},"nl":{"stringUnit":{"state":"translated","value":"Rechtstreeks verbonden. Maak opnieuw verbinding via Instellingen → Apple Watch op de iPhone om spraak toe te voegen."}},"fa":{"stringUnit":{"state":"translated","value":"مستقیماً متصل شده است. برای افزودن قابلیت صوتی، از مسیر Settings → Apple Watch در iPhone دوباره متصل شوید."}},"ru":{"stringUnit":{"state":"translated","value":"Подключено напрямую. Чтобы добавить голосовые функции, подключитесь заново на iPhone: Настройки → Apple Watch."}},"sv":{"stringUnit":{"state":"translated","value":"Direktansluten. Återanslut via Inställningar → Apple Watch på iPhone för att lägga till röstfunktioner."}}}},
    "Connected directly. Voice setup saved.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connected directly. Voice setup saved."}},"zh-CN":{"stringUnit":{"state":"translated","value":"已直接连接。语音设置已保存。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已直接連線。語音設定已儲存。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Conectado diretamente. Configuração de voz salva."}},"de":{"stringUnit":{"state":"translated","value":"Direkt verbunden. Spracheinrichtung gespeichert."}},"es":{"stringUnit":{"state":"translated","value":"Conexión directa establecida. Configuración de voz guardada."}},"ja-JP":{"stringUnit":{"state":"translated","value":"直接接続しました。音声設定を保存しました。"}},"ko":{"stringUnit":{"state":"translated","value":"직접 연결되었습니다. 음성 설정이 저장되었습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Connexion directe établie. Configuration vocale enregistrée."}},"hi":{"stringUnit":{"state":"translated","value":"सीधे कनेक्ट हो गया। वॉइस सेटअप सहेज लिया गया।"}},"ar":{"stringUnit":{"state":"translated","value":"تم الاتصال مباشرةً. تم حفظ إعداد المحادثة الصوتية."}},"it":{"stringUnit":{"state":"translated","value":"Connessione diretta stabilita. Configurazione vocale salvata."}},"tr":{"stringUnit":{"state":"translated","value":"Doğrudan bağlandı. Sesli iletişim kurulumu kaydedildi."}},"uk":{"stringUnit":{"state":"translated","value":"Підключено напряму. Налаштування голосового спілкування збережено."}},"id":{"stringUnit":{"state":"translated","value":"Terhubung langsung. Pengaturan suara tersimpan."}},"pl":{"stringUnit":{"state":"translated","value":"Połączono bezpośrednio. Zapisano konfigurację rozmów głosowych."}},"th":{"stringUnit":{"state":"translated","value":"เชื่อมต่อโดยตรงแล้ว บันทึกการตั้งค่าเสียงแล้ว"}},"vi":{"stringUnit":{"state":"translated","value":"Đã kết nối trực tiếp. Đã lưu thiết lập giọng nói."}},"nl":{"stringUnit":{"state":"translated","value":"Rechtstreeks verbonden. Spraakconfiguratie opgeslagen."}},"fa":{"stringUnit":{"state":"translated","value":"اتصال مستقیم برقرار شد. تنظیمات صوتی ذخیره شد."}},"ru":{"stringUnit":{"state":"translated","value":"Подключено напрямую. Настройки голосового общения сохранены."}},"sv":{"stringUnit":{"state":"translated","value":"Direktansluten. Röstinställningarna har sparats."}}}},
    "Connected to openclaw-gateway.tailnet.ts.net.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connected to openclaw-gateway.tailnet.ts.net."}},"zh-CN":{"stringUnit":{"state":"translated","value":"已连接到 openclaw-gateway.tailnet.ts.net."}},"zh-TW":{"stringUnit":{"state":"translated","value":"已連接至 openclaw-gateway.tailnet.ts.net."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Conectado a openclaw-gateway.tailnet.ts.net."}},"de":{"stringUnit":{"state":"translated","value":"Mit openclaw-gateway.tailnet.ts.net verbunden."}},"es":{"stringUnit":{"state":"translated","value":"Conectado a openclaw-gateway.tailnet.ts.net."}},"ja-JP":{"stringUnit":{"state":"translated","value":"openclaw-gateway.tailnet.ts.netに接続済み。"}},"ko":{"stringUnit":{"state":"translated","value":"openclaw-gateway.tailnet.ts.net에 연결되었습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Connecté à openclaw-gateway.tailnet.ts.net."}},"hi":{"stringUnit":{"state":"translated","value":"openclaw-gateway.tailnet.ts.net से कनेक्ट है."}},"ar":{"stringUnit":{"state":"translated","value":"متصل بـ openclaw-gateway.tailnet.ts.net."}},"it":{"stringUnit":{"state":"translated","value":"Connesso a openclaw-gateway.tailnet.ts.net."}},"tr":{"stringUnit":{"state":"translated","value":"openclaw-gateway.tailnet.ts.net adresine bağlandı."}},"uk":{"stringUnit":{"state":"translated","value":"Підключено до openclaw-gateway.tailnet.ts.net."}},"id":{"stringUnit":{"state":"translated","value":"Terhubung ke openclaw-gateway.tailnet.ts.net."}},"pl":{"stringUnit":{"state":"translated","value":"Połączono z openclaw-gateway.tailnet.ts.net."}},"th":{"stringUnit":{"state":"translated","value":"เชื่อมต่อกับ openclaw-gateway.tailnet.ts.net แล้ว."}},"vi":{"stringUnit":{"state":"translated","value":"Đã kết nối với openclaw-gateway.tailnet.ts.net."}},"nl":{"stringUnit":{"state":"translated","value":"Verbonden met openclaw-gateway.tailnet.ts.net."}},"fa":{"stringUnit":{"state":"translated","value":"به openclaw-gateway.tailnet.ts.net متصل شد."}},"ru":{"stringUnit":{"state":"translated","value":"Подключено к openclaw-gateway.tailnet.ts.net."}},"sv":{"stringUnit":{"state":"translated","value":"Ansluten till openclaw-gateway.tailnet.ts.net."}}}},
    "Connected, but some controls are restricted for nodes. This is expected.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connected, but some controls are restricted for nodes. This is expected."}},"zh-CN":{"stringUnit":{"state":"translated","value":"已连接, 但节点的部分控制功能受限。 这是正常现象。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已連線, 但部分控制功能對節點有所限制。 這是預期行為。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Conectado, mas alguns controles são restritos para nós. Isso é esperado."}},"de":{"stringUnit":{"state":"translated","value":"Verbunden, aber einige Steuerelemente sind für Knoten eingeschränkt. Dies ist erwartetes Verhalten."}},"es":{"stringUnit":{"state":"translated","value":"Conectado, pero algunos controles están restringidos para los nodos. Esto es normal."}},"ja-JP":{"stringUnit":{"state":"translated","value":"接続済みですが、ノードでは一部の操作が制限されています。 これは正常な動作です。"}},"ko":{"stringUnit":{"state":"translated","value":"연결되었지만 노드에서는 일부 제어 기능이 제한됩니다. 이는 정상적인 동작입니다."}},"fr":{"stringUnit":{"state":"translated","value":"Connecté, mais certaines commandes sont restreintes pour les nœuds. Ce comportement est normal."}},"hi":{"stringUnit":{"state":"translated","value":"कनेक्ट हो गया है, लेकिन नोड्स के लिए कुछ नियंत्रण प्रतिबंधित हैं. यह अपेक्षित है."}},"ar":{"stringUnit":{"state":"translated","value":"متصل، لكن بعض عناصر التحكم مقيّدة للعُقد. هذا متوقع."}},"it":{"stringUnit":{"state":"translated","value":"Connesso, ma alcuni controlli sono limitati per i nodi. È normale."}},"tr":{"stringUnit":{"state":"translated","value":"Bağlandı, ancak bazı denetimler düğümler için kısıtlı. Bu beklenen bir durumdur."}},"uk":{"stringUnit":{"state":"translated","value":"Підключено, але деякі елементи керування обмежені для вузлів. Це очікувана поведінка."}},"id":{"stringUnit":{"state":"translated","value":"Terhubung, tetapi beberapa kontrol dibatasi untuk node. Ini sesuai dengan yang diharapkan."}},"pl":{"stringUnit":{"state":"translated","value":"Połączono, ale niektóre funkcje sterowania są ograniczone dla węzłów. Jest to oczekiwane zachowanie."}},"th":{"stringUnit":{"state":"translated","value":"เชื่อมต่อแล้ว แต่การควบคุมบางอย่างถูกจำกัดสำหรับโหนด. นี่เป็นพฤติกรรมปกติ."}},"vi":{"stringUnit":{"state":"translated","value":"Đã kết nối, nhưng một số chức năng điều khiển bị hạn chế đối với các nút. Đây là hành vi bình thường."}},"nl":{"stringUnit":{"state":"translated","value":"Verbonden, maar sommige bedieningselementen zijn beperkt voor nodes. Dit is normaal."}},"fa":{"stringUnit":{"state":"translated","value":"متصل است، اما برخی کنترل‌ها برای گره‌ها محدود شده‌اند. این وضعیت طبیعی است."}},"ru":{"stringUnit":{"state":"translated","value":"Подключено, но некоторые элементы управления недоступны для узлов. Это ожидаемое поведение."}},"sv":{"stringUnit":{"state":"translated","value":"Ansluten, men vissa kontroller är begränsade för noder. Detta är förväntat."}}}},
