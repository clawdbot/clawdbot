    "Connect a gateway to load the live agent roster.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connect a gateway to load the live agent roster."}},"zh-CN":{"stringUnit":{"state":"translated","value":"连接 Gateway 以加载实时智能体列表。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"連線至 Gateway 以載入即時代理清單。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Conecte-se a um Gateway para carregar a lista de agentes em tempo real."}},"de":{"stringUnit":{"state":"translated","value":"Verbinden Sie ein Gateway, um die aktuelle Agentenübersicht zu laden."}},"es":{"stringUnit":{"state":"translated","value":"Conecta un Gateway para cargar la lista de agentes en tiempo real."}},"ja-JP":{"stringUnit":{"state":"translated","value":"最新のエージェント一覧を読み込むには、Gateway に接続してください。"}},"ko":{"stringUnit":{"state":"translated","value":"실시간 에이전트 목록을 불러오려면 Gateway에 연결하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Connectez un Gateway pour charger la liste des agents en temps réel."}},"hi":{"stringUnit":{"state":"translated","value":"एजेंटों की लाइव सूची लोड करने के लिए एक Gateway कनेक्ट करें."}},"ar":{"stringUnit":{"state":"translated","value":"اتصل بـ Gateway لتحميل قائمة الوكلاء المباشرة."}},"it":{"stringUnit":{"state":"translated","value":"Connetti un Gateway per caricare l'elenco degli agenti in tempo reale."}},"tr":{"stringUnit":{"state":"translated","value":"Canlı ajan listesini yüklemek için bir Gateway bağlayın."}},"uk":{"stringUnit":{"state":"translated","value":"Підключіть Gateway, щоб завантажити актуальний список агентів."}},"id":{"stringUnit":{"state":"translated","value":"Hubungkan Gateway untuk memuat daftar agen secara langsung."}},"pl":{"stringUnit":{"state":"translated","value":"Połącz z Gateway, aby wczytać aktualną listę agentów."}},"th":{"stringUnit":{"state":"translated","value":"เชื่อมต่อ Gateway เพื่อโหลดรายชื่อเอเจนต์แบบเรียลไทม์."}},"vi":{"stringUnit":{"state":"translated","value":"Kết nối một Gateway để tải danh sách tác tử theo 