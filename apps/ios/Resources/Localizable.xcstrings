    "Spoken reply timed out. Check Chat on iPhone.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Spoken reply timed out. Check Chat on iPhone."}},"zh-CN":{"stringUnit":{"state":"translated","value":"语音回复超时。请在 iPhone 上查看聊天。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語音回覆已逾時。 請查看 iPhone 上的聊天。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O tempo limite da resposta falada foi excedido. Confira o Chat no iPhone."}},"de":{"stringUnit":{"state":"translated","value":"Zeitüberschreitung bei der gesprochenen Antwort. Prüfen Sie den Chat auf dem iPhone."}},"es":{"stringUnit":{"state":"translated","value":"Se agotó el tiempo de espera de la respuesta hablada. Revisa el chat en el iPhone."}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声での返信がタイムアウトしました。 iPhoneでチャットを確認してください。"}},"ko":{"stringUnit":{"state":"translated","value":"음성 답변 시간이 초과되었습니다. iPhone에서 채팅을 확인하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Le délai de réponse vocale a expiré. Consultez la discussion sur l’iPhone."}},"hi":{"stringUnit":{"state":"translated","value":"बोले गए जवाब की समय सीमा समाप्त हो गई. iPhone पर चैट देखें."}},"ar":{"stringUnit":{"state":"translated","value":"انتهت مهلة الرد المنطوق. تحقق من الدردشة على iPhone."}},"it":{"stringUnit":{"state":"translated","value":"Tempo scaduto per la risposta vocale. Controlla la chat su iPhone."}},"tr":{"stringUnit":{"state":"translated","value":"Sesli yanıt zaman aşımına uğradı. iPhone'da Sohbeti kontrol edin."}},"uk":{"stringUnit":{"state":"translated","value":"Час очікування голосової відповіді минув. Перевірте чат на iPhone."}},"id":{"stringUnit":{"state":"translated","value":"Waktu tunggu balasan suara habis. Periksa Obrolan di iPhone."}},"pl":{"stringUnit":{"state":"translated","value":"Upłynął limit czasu odpowiedzi głosowej. Sprawdź czat na iPhonie."}},"th":{"stringUnit":{"state":"translated","value":"หมดเวลารอการตอบกลับด้วยเสียง ตรวจสอบแชทบน iPhone"}},"vi":{"stringUnit":{"state":"translated","value":"Đã hết thời gian chờ trả lời bằng giọng nói. Kiểm tra mục Trò chuyện trên iPhone."}},"nl":{"stringUnit":{"state":"translated","value":"Time-out voor gesproken antwoord. Bekijk de chat op iPhone."}},"fa":{"stringUnit":{"state":"translated","value":"مهلت پاسخ صوتی به پایان رسید. گفتگو را در iPhone بررسی کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Время ожидания голосового ответа истекло. Проверьте чат на iPhone."}},"sv":{"stringUnit":{"state":"translated","value":"Tidsgränsen för det upplästa svaret överskreds. Kontrollera chatten på iPhone."}}}},
