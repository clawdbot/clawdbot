    "Dismiss capability notice": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Dismiss capability notice"}},"zh-CN":{"stringUnit":{"state":"translated","value":"关闭功能提示"}},"zh-TW":{"stringUnit":{"state":"translated","value":"關閉功能通知"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Dispensar aviso de capacidade"}},"de":{"stringUnit":{"state":"translated","value":"Funktionshinweis ausblenden"}},"es":{"stringUnit":{"state":"translated","value":"Descartar aviso de capacidades"}},"ja-JP":{"stringUnit":{"state":"translated","value":"機能に関する通知を閉じる"}},"ko":{"stringUnit":{"state":"translated","value":"기능 안내 닫기"}},"fr":{"stringUnit":{"state":"translated","value":"Masquer l’avis sur les capacités"}},"hi":{"stringUnit":{"state":"translated","value":"क्षमता संबंधी सूचना हटाएँ"}},"ar":{"stringUnit":{"state":"translated","value":"تجاهل إشعار الإمكانات"}},"it":{"stringUnit":{"state":"translated","value":"Ignora avviso sulle funzionalità"}},"tr":{"stringUnit":{"state":"translated","value":"Yetenek bildirimini kapat"}},"uk":{"stringUnit":{"state":"translated","value":"Закрити повідомлення про можливості"}},"id":{"stringUnit":{"state":"translated","value":"Tutup pemberitahuan kemampuan"}},"pl":{"stringUnit":{"state":"translated","value":"Zamknij powiadomienie o możliwościach"}},"th":{"stringUnit":{"state":"translated","value":"ปิดประกาศเกี่ยวกับความสามารถ"}},"vi":{"stringUnit":{"state":"translated","value":"Ẩn thông báo về khả năng"}},"nl":{"stringUnit":{"state":"translated","value":"Melding over mogelijkheden sluiten"}},"fa":{"stringUnit":{"state":"translated","value":"بستن اعلان قابلیت"}},"ru":{"stringUnit":{"state":"translated","value":"Скрыть уведомление о возможностях"}},"sv":{"stringUnit":{"state":"translated","value":"Avfärda funktionsmeddelandet"}}}},
    "Dismiss hides cards; receipts still expire after 48 hours. Needs review stays until discarded.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Dismiss hides cards; receipts still expire after 48 hours. Needs review stays until discarded."}},"zh-CN":{"stringUnit":{"state":"translated","value":"关闭会隐藏卡片; 回执仍会在 48 小时后过期。 待审核项会一直保留，直到被丢弃。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"關閉會隱藏卡片; 回條仍會在 48 小時後到期。 待審核項目會保留直到捨棄。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Dispensar oculta os cartões; os comprovantes ainda expiram após 48 horas. Os itens que precisam de revisão permanecem até serem descartados."}},"de":{"stringUnit":{"state":"translated","value":"Ausblenden verbirgt Karten; Belege verfallen weiterhin nach 48 Stunden. Zu prüfende Einträge bleiben bestehen, bis sie verworfen werden."}},"es":{"stringUnit":{"state":"translated","value":"Descartar oculta las tarjetas; los comprobantes siguen caducando después de 48 horas. Los elementos que necesitan revisión permanecen hasta que se descartan."}},"ja-JP":{"stringUnit":{"state":"translated","value":"閉じるとカードが非表示になります; 受領記録は引き続き48時間後に期限切れになります。 要確認の項目は破棄するまで残ります。"}},"ko":{"stringUnit":{"state":"translated","value":"닫으면 카드가 숨겨집니다; 수신 확인은 그대로 48시간 후에 만료됩니다. 검토 필요 항목은 버릴 때까지 유지됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Masquer cache les cartes ; les reçus expirent toujours après 48 heures. Les éléments à examiner restent jusqu’à leur suppression."}},"hi":{"stringUnit":{"state":"translated","value":"हटाने से कार्ड छिप जाते हैं; रसीदें फिर भी 48 घंटे बाद समाप्त हो जाती हैं. समीक्षा की आवश्यकता वाली चीज़ें त्यागे जाने तक बनी रहती हैं."}},"ar":{"stringUnit":{"state":"translated","value":"يؤدي التجاهل إلى إخفاء البطاقات؛ وتظل الإيصالات تنتهي صلاحيتها بعد 48 ساعة. تبقى العناصر التي تحتاج إلى مراجعة حتى يتم استبعادها."}},"it":{"stringUnit":{"state":"translated","value":"Ignora nasconde le schede; le ricevute scadono comunque dopo 48 ore. Gli elementi da rivedere rimangono finché non vengono scartati."}},"tr":{"stringUnit":{"state":"translated","value":"Kapat seçeneği kartları gizler; alındıların süresi yine 48 saat sonra dolar. İnceleme gerekenler silinene kadar kalır."}},"uk":{"stringUnit":{"state":"translated","value":"Закриття приховує картки; термін дії квитанцій усе одно спливає через 48 годин. Елементи, що потребують перевірки, залишаються, доки їх не буде відкинуто."}},"id":{"stringUnit":{"state":"translated","value":"Tutup menyembunyikan kartu; tanda terima tetap kedaluwarsa setelah 48 jam. Item yang perlu ditinjau tetap ada hingga dibuang."}},"pl":{"stringUnit":{"state":"translated","value":"Zamknięcie ukrywa karty; potwierdzenia nadal wygasają po 48 godzinach. Elementy wymagające sprawdzenia pozostają do momentu odrzucenia."}},"th":{"stringUnit":{"state":"translated","value":"การปิดจะซ่อนการ์ด; ใบรับยังคงหมดอายุหลังจาก 48 ชั่วโมง. รายการที่ต้องตรวจสอบจะคงอยู่จนกว่าจะถูกทิ้ง."}},"vi":{"stringUnit":{"state":"translated","value":"Thao tác ẩn sẽ ẩn các thẻ; biên nhận vẫn hết hạn sau 48 giờ. Các mục cần xem xét sẽ được giữ lại cho đến khi bị loại bỏ."}},"nl":{"stringUnit":{"state":"translated","value":"Sluiten verbergt kaarten; ontvangstbewijzen verlopen nog steeds na 48 uur. Te beoordelen blijft staan totdat het wordt verwijderd."}},"fa":{"stringUnit":{"state":"translated","value":"بستن، کارت‌ها را پنهان می‌کند؛ رسیدها همچنان پس از 48 ساعت منقضی می‌شوند. موارد نیازمند بررسی تا زمان کنار گذاشته شدن باقی می‌مانند."}},"ru":{"stringUnit":{"state":"translated","value":"Скрытие убирает карточки; срок действия квитанций по-прежнему истекает через 48 часов. Элементы, требующие проверки, остаются до удаления."}},"sv":{"stringUnit":{"state":"translated","value":"Avfärda döljer kort; kvittenser upphör fortfarande att gälla efter 48 timmar. Behöver granskas finns kvar tills det kasseras."}}}},
    "Dismiss this update": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Dismiss this update"}},"zh-CN":{"stringUnit":{"state":"translated","value":"忽略此更新"}},"zh-TW":{"stringUnit":{"state":"translated","value":"關閉此更新通知"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Dispensar esta atualização"}},"de":{"stringUnit":{"state":"translated","value":"Dieses Update ausblenden"}},"es":{"stringUnit":{"state":"translated","value":"Descartar esta actualización"}},"ja-JP":{"stringUnit":{"state":"translated","value":"この更新を閉じる"}},"ko":{"stringUnit":{"state":"translated","value":"이 업데이트 닫기"}},"fr":{"stringUnit":{"state":"translated","value":"Masquer cette mise à jour"}},"hi":{"stringUnit":{"state":"translated","value":"यह अपडेट हटाएँ"}},"ar":{"stringUnit":{"state":"translated","value":"تجاهل هذا التحديث"}},"it":{"stringUnit":{"state":"translated","value":"Ignora questo aggiornamento"}},"tr":{"stringUnit":{"state":"translated","value":"Bu güncellemeyi kapat"}},"uk":{"stringUnit":{"state":"translated","value":"Приховати це оновлення"}},"id":{"stringUnit":{"state":"translated","value":"Tutup pembaruan ini"}},"pl":{"stringUnit":{"state":"translated","value":"Zamknij tę aktualizację"}},"th":{"stringUnit":{"state":"translated","value":"ปิดการอัปเดตนี้"}},"vi":{"stringUnit":{"state":"translated","value":"Ẩn bản cập nhật này"}},"nl":{"stringUnit":{"state":"translated","value":"Deze update sluiten"}},"fa":{"stringUnit":{"state":"translated","value":"بستن این به‌روزرسانی"}},"ru":{"stringUnit":{"state":"translated","value":"Скрыть это обновление"}},"sv":{"stringUnit":{"state":"translated","value":"Avfärda den här uppdateringen"}}}},
