    "TLS fingerprint verification timed out for %1$@:%2$@. Secure endpoint was reached, but TLS did not finish in time.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"TLS fingerprint verification timed out for %1$@:%2$@. Secure endpoint was reached, but TLS did not finish in time."}},"zh-CN":{"stringUnit":{"state":"translated","value":"%1$@:%2$@ 的 TLS 指纹验证超时。 已连接到安全端点，但 TLS 未能及时完成。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"%1$@:%2$@ 的 TLS 指紋驗證逾時。 已連線至安全端點，但 TLS 未能及時完成。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O tempo limite da verificação da impressão digital TLS foi excedido para %1$@:%2$@. O endpoint seguro foi alcançado, mas o TLS não foi concluído a tempo."}},"de":{"stringUnit":{"state":"translated","value":"Zeitüberschreitung bei der TLS-Fingerabdruckprüfung für %1$@:%2$@. Der sichere Endpunkt wurde erreicht, aber TLS wurde nicht rechtzeitig abgeschlossen."}},"es":{"stringUnit":{"state":"translated","value":"Se agotó el tiempo de espera de la verificación de la huella TLS para %1$@:%2$@. Se contactó con el punto de conexión seguro, pero TLS no se completó a tiempo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"%1$@:%2$@ の TLS フィンガープリント検証がタイムアウトしました。 セキュアなエンドポイントに到達しましたが、TLS が時間内に完了しませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"%1$@:%2$@의 TLS 지문 확인 시간이 초과되었습니다. 보안 엔드포인트에 연결했지만 TLS가 제시간에 완료되지 않았습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le délai de vérification de l’empreinte TLS a expiré pour %1$@:%2$@. Le point de terminaison sécurisé a été atteint, mais la négociation TLS ne s’est pas terminée à temps."}},"hi":{"stringUnit":{"state":"translated","value":"%1$@:%2$@ के लिए TLS फ़िंगरप्रिंट सत्यापन का समय समाप्त हो गया। सुरक्षित एंडपॉइंट तक पहुँच हुई, लेकिन TLS समय पर पूरा नहीं हुआ।"}},"ar":{"stringUnit":{"state":"translated","value":"انتهت مهلة التحقق من بصمة TLS لـ %1$@:%2$@. تم الوصول إلى نقطة النهاية الآمنة، لكن TLS لم يكتمل في الوقت المحدد."}},"it":{"stringUnit":{"state":"translated","value":"Tempo scaduto per la verifica dell'impronta TLS per %1$@:%2$@. L'endpoint sicuro è stato raggiunto, ma TLS non è stato completato in tempo."}},"tr":{"stringUnit":{"state":"translated","value":"%1$@:%2$@ için TLS parmak izi doğrulaması zaman aşımına uğradı. Güvenli uç noktaya ulaşıldı, ancak TLS zamanında tamamlanmadı."}},"uk":{"stringUnit":{"state":"translated","value":"Час очікування перевірки відбитка TLS для %1$@:%2$@ вичерпано. З’єднання із захищеною кінцевою точкою встановлено, але узгодження TLS не завершилося вчасно."}},"id":{"stringUnit":{"state":"translated","value":"Verifikasi sidik jari TLS kehabisan waktu untuk %1$@:%2$@. Endpoint aman berhasil dijangkau, tetapi TLS tidak selesai tepat waktu."}},"pl":{"stringUnit":{"state":"translated","value":"Upłynął limit czasu weryfikacji odcisku TLS dla %1$@:%2$@. Nawiązano połączenie z bezpiecznym punktem końcowym, ale negocjacja TLS nie zakończyła się na czas."}},"th":{"stringUnit":{"state":"translated","value":"การตรวจสอบลายนิ้วมือ TLS หมดเวลาสำหรับ %1$@:%2$@. เข้าถึงปลายทางที่ปลอดภัยแล้ว แต่ TLS ไม่เสร็จสมบูรณ์ภายในเวลาที่กำหนด."}},"vi":{"stringUnit":{"state":"translated","value":"Đã hết thời gian xác minh dấu vân tay TLS cho %1$@:%2$@. Đã kết nối được với điểm cuối bảo mật, nhưng TLS không hoàn tất kịp thời."}},"nl":{"stringUnit":{"state":"translated","value":"Time-out bij TLS-vingerafdrukverificatie voor %1$@:%2$@. Het beveiligde eindpunt is bereikt, maar TLS is niet op tijd voltooid."}},"fa":{"stringUnit":{"state":"translated","value":"مهلت تأیید اثر انگشت TLS برای %1$@:%2$@ به پایان رسید. اتصال به نقطهٔ پایانی امن برقرار شد، اما TLS به‌موقع تکمیل نشد."}},"ru":{"stringUnit":{"state":"translated","value":"Время ожидания проверки отпечатка TLS для %1$@:%2$@ истекло. Защищённый узел доступен, но согласование TLS не завершилось вовремя."}},"sv":{"stringUnit":{"state":"translated","value":"Tidsgränsen för verifiering av TLS-fingeravtryck överskreds för %1$@:%2$@. Den säkra slutpunkten nåddes, men TLS slutfördes inte i tid."}}}},
    "TLS required": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"TLS required"}},"zh-CN":{"stringUnit":{"state":"translated","value":"需要 TLS"}},"zh-TW":{"stringUnit":{"state":"translated","value":"需要 TLS"}},"pt-BR":{"stringUnit":{"state":"translated","value":"TLS obrigatório"}},"de":{"stringUnit":{"state":"translated","value":"TLS erforderlich"}},"es":{"stringUnit":{"state":"translated","value":"TLS obligatorio"}},"ja-JP":{"stringUnit":{"state":"translated","value":"TLS が必要です"}},"ko":{"stringUnit":{"state":"translated","value":"TLS 필요"}},"fr":{"stringUnit":{"state":"translated","value":"TLS requis"}},"hi":{"stringUnit":{"state":"translated","value":"TLS आवश्यक है"}},"ar":{"stringUnit":{"state":"translated","value":"TLS مطلوب"}},"it":{"stringUnit":{"state":"translated","value":"TLS richiesto"}},"tr":{"stringUnit":{"state":"translated","value":"TLS gerekli"}},"uk":{"stringUnit":{"state":"translated","value":"Потрібен TLS"}},"id":{"stringUnit":{"state":"translated","value":"TLS diperlukan"}},"pl":{"stringUnit":{"state":"translated","value":"Wymagany TLS"}},"th":{"stringUnit":{"state":"translated","value":"ต้องใช้ TLS"}},"vi":{"stringUnit":{"state":"translated","value":"Yêu cầu TLS"}},"nl":{"stringUnit":{"state":"translated","value":"TLS vereist"}},"fa":{"stringUnit":{"state":"translated","value":"TLS الزامی است"}},"ru":{"stringUnit":{"state":"translated","value":"Требуется TLS"}},"sv":{"stringUnit":{"state":"translated","value":"TLS krävs"}}}},
    "Tailscale is off on this device. Turn it on, then try again.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Tailscale is off on this device. Turn it on, then try again."}},"zh-CN":{"stringUnit":{"state":"translated","value":"此设备上的 Tailscale 已关闭。 请将其开启，然后重试。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此裝置上的 Tailscale 已關閉。 請開啟後再試一次。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Tailscale está desativado neste dispositivo. Ative-o e tente novamente."}},"de":{"stringUnit":{"state":"translated","value":"Tailscale ist auf diesem Gerät ausgeschaltet. Schalten Sie es ein und versuchen Sie es erneut."}},"es":{"stringUnit":{"state":"translated","value":"Tailscale está desactivado en este dispositivo. Actívalo e inténtalo de nuevo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このデバイスでは Tailscale がオフになっています。 オンにしてから、もう一度お試しください。"}},"ko":{"stringUnit":{"state":"translated","value":"이 기기에서 Tailscale이 꺼져 있습니다. 켠 후 다시 시도하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Tailscale est désactivé sur cet appareil. Activez-le, puis réessayez."}},"hi":{"stringUnit":{"state":"translated","value":"इस डिवाइस पर Tailscale बंद है। इसे चालू करें, फिर दोबारा कोशिश करें।"}},"ar":{"stringUnit":{"state":"translated","value":"Tailscale متوقف على هذا الجهاز. شغّله، ثم حاول مجددًا."}},"it":{"stringUnit":{"state":"translated","value":"Tailscale è disattivato su questo dispositivo. Attivalo, poi riprova."}},"tr":{"stringUnit":{"state":"translated","value":"Bu cihazda Tailscale kapalı. Açıp tekrar deneyin."}},"uk":{"stringUnit":{"state":"translated","value":"Tailscale вимкнено на цьому пристрої. Увімкніть його, а потім спробуйте ще раз."}},"id":{"stringUnit":{"state":"translated","value":"Tailscale nonaktif di perangkat ini. Aktifkan, lalu coba lagi."}},"pl":{"stringUnit":{"state":"translated","value":"Tailscale jest wyłączony na tym urządzeniu. Włącz go, a następnie spróbuj ponownie."}},"th":{"stringUnit":{"state":"translated","value":"Tailscale ปิดอยู่บนอุปกรณ์นี้. เปิดใช้งาน แล้วลองอีกครั้ง."}},"vi":{"stringUnit":{"state":"translated","value":"Tailscale đang tắt trên thiết bị này. Hãy bật rồi thử lại."}},"nl":{"stringUnit":{"state":"translated","value":"Tailscale is uitgeschakeld op dit apparaat. Schakel het in en probeer het opnieuw."}},"fa":{"stringUnit":{"state":"translated","value":"Tailscale در این دستگاه خاموش است. آن را روشن کنید، سپس دوباره تلاش کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Tailscale выключен на этом устройстве. Включите его и попробуйте снова."}},"sv":{"stringUnit":{"state":"translated","value":"Tailscale är avstängt på den här enheten. Slå på det och försök sedan igen."}}}},
