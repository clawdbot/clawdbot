    "Run app, permission, and gateway-adjacent checks without editing setup.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Run app, permission, and gateway-adjacent checks without editing setup."}},"zh-CN":{"stringUnit":{"state":"translated","value":"运行应用、权限和 Gateway 相关检查，不修改设置。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"在不修改設定的情況下，執行應用程式、權限及 Gateway 相關檢查。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Execute verificações do aplicativo, das permissões e de componentes relacionados ao Gateway sem alterar a configuração."}},"de":{"stringUnit":{"state":"translated","value":"App, Berechtigungen und Gateway-Umgebung prüfen, ohne die Einrichtung zu ändern."}},"es":{"stringUnit":{"state":"translated","value":"Ejecuta comprobaciones de la aplicación, los permisos y los componentes relacionados con el Gateway sin modificar la configuración."}},"ja-JP":{"stringUnit":{"state":"translated","value":"設定を変更せずに、アプリ、権限、Gateway 関連のチェックを実行します。"}},"ko":{"stringUnit":{"state":"translated","value":"설정을 변경하지 않고 앱, 권한 및 Gateway 관련 점검을 실행합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Exécuter des vérifications de l’application, des autorisations et des éléments liés au Gateway sans modifier la configuration."}},"hi":{"stringUnit":{"state":"translated","value":"सेटअप में बदलाव किए बिना ऐप, अनुमतियों और Gateway से संबंधित जाँच चलाएँ."}},"ar":{"stringUnit":{"state":"translated","value":"تشغيل فحوصات التطبيق والأذونات والفحوصات المتعلقة بـ Gateway دون تعديل الإعدادات."}},"it":{"stringUnit":{"state":"translated","value":"Esegui controlli sull'app, sui permessi e sui componenti correlati al gateway senza modificare la configurazione."}},"tr":{"stringUnit":{"state":"translated","value":"Kurulumu değiştirmeden uygulama, izin ve Gateway ile ilgili denetimleri çalıştırın."}},"uk":{"stringUnit":{"state":"translated","value":"Виконати перевірки застосунку, дозволів і компонентів, пов’язаних із Gateway, без зміни налаштувань."}},"id":{"stringUnit":{"state":"translated","value":"Jalankan pemeriksaan aplikasi, izin, dan hal-hal terkait Gateway tanpa mengubah pengaturan."}},"pl":{"stringUnit":{"state":"translated","value":"Sprawdź aplikację, uprawnienia i elementy powiązane z Gateway bez zmiany konfiguracji."}},"th":{"stringUnit":{"state":"translated","value":"ตรวจสอบแอป สิทธิ์ และส่วนที่เกี่ยวข้องกับ Gateway โดยไม่แก้ไขการตั้งค่า."}},"vi":{"stringUnit":{"state":"translated","value":"Chạy các kiểm tra ứng dụng, quyền và những thành phần liên quan đến gateway mà không chỉnh sửa thiết lập."}},"nl":{"stringUnit":{"state":"translated","value":"Voer controles voor de app, machtigingen en gatewaygerelateerde onderdelen uit zonder de configuratie te wijzigen."}},"fa":{"stringUnit":{"state":"translated","value":"بررسی‌های برنامه، مجوزها و موارد مرتبط با Gateway را بدون ویرایش تنظیمات اجرا کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Проверить приложение, разрешения и компоненты, связанные с Gateway, без изменения настроек."}},"sv":{"stringUnit":{"state":"translated","value":"Kör kontroller av appen, behörigheter och Gateway-relaterade funktioner utan att ändra konfigurationen."}}}},
