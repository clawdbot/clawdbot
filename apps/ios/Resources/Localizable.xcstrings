    "Discard this saved message?": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Discard this saved message?"}},"zh-CN":{"stringUnit":{"state":"translated","value":"丢弃这条已保存的消息？"}},"zh-TW":{"stringUnit":{"state":"translated","value":"要捨棄這則已儲存的訊息嗎？"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Descartar esta mensagem salva?"}},"de":{"stringUnit":{"state":"translated","value":"Diese gespeicherte Nachricht verwerfen?"}},"es":{"stringUnit":{"state":"translated","value":"¿Descartar este mensaje guardado?"}},"ja-JP":{"stringUnit":{"state":"translated","value":"この保存済みメッセージを破棄しますか？"}},"ko":{"stringUnit":{"state":"translated","value":"이 저장된 메시지를 버리시겠습니까?"}},"fr":{"stringUnit":{"state":"translated","value":"Supprimer ce message enregistré ?"}},"hi":{"stringUnit":{"state":"translated","value":"यह सहेजा गया संदेश हटाएँ?"}},"ar":{"stringUnit":{"state":"translated","value":"هل تريد تجاهل هذه الرسالة المحفوظة?"}},"it":{"stringUnit":{"state":"translated","value":"Scartare questo messaggio salvato?"}},"tr":{"stringUnit":{"state":"translated","value":"Bu kayıtlı mesaj silinsin mi?"}},"uk":{"stringUnit":{"state":"translated","value":"Відкинути це збережене повідомлення?"}},"id":{"stringUnit":{"state":"translated","value":"Buang pesan tersimpan ini?"}},"pl":{"stringUnit":{"state":"translated","value":"Odrzucić tę zapisaną wiadomość?"}},"th":{"stringUnit":{"state":"translated","value":"ทิ้งข้อความที่บันทึกไว้นี้หรือไม่?"}},"vi":{"stringUnit":{"state":"translated","value":"Loại bỏ tin nhắn đã lưu này?"}},"nl":{"stringUnit":{"state":"translated","value":"Dit opgeslagen bericht verwerpen?"}},"fa":{"stringUnit":{"state":"translated","value":"این پیام ذخیره‌شده دور انداخته شود؟"}},"ru":{"stringUnit":{"state":"translated","value":"Удалить это сохранённое сообщение?"}},"sv":{"stringUnit":{"state":"translated","value":"Kasta det här sparade meddelandet?"}}}},
