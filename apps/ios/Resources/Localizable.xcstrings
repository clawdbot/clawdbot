    "Allow the Gateway to use this device's camera?": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allow the Gateway to use this device's camera?"}},"zh-CN":{"stringUnit":{"state":"translated","value":"允许 Gateway 使用此设备的摄像头吗？"}},"zh-TW":{"stringUnit":{"state":"translated","value":"允許 Gateway 使用此裝置的相機嗎？"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Permitir que o Gateway use a câmera deste dispositivo?"}},"de":{"stringUnit":{"state":"translated","value":"Dem Gateway erlauben, die Kamera dieses Geräts zu verwenden?"}},"es":{"stringUnit":{"state":"translated","value":"¿Permitir que el Gateway use la cámara de este dispositivo?"}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayによるこのデバイスのカメラの使用を許可しますか？"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway가 이 기기의 카메라를 사용하도록 허용할까요?"}},"fr":{"stringUnit":{"state":"translated","value":"Autoriser le Gateway à utiliser la caméra de cet appareil ?"}},"hi":{"stringUnit":{"state":"translated","value":"Gateway को इस डिवाइस का कैमरा इस्तेमाल करने की अनुमति दें?"}},"ar":{"stringUnit":{"state":"translated","value":"هل تسمح لـ Gateway باستخدام كاميرا هذا الجهاز؟"}},"it":{"stringUnit":{"state":"translated","value":"Consentire al Gateway di usare la fotocamera di questo dispositivo?"}},"tr":{"stringUnit":{"state":"translated","value":"Gateway'in bu cihazın kamerasını kullanmasına izin verilsin mi?"}},"uk":{"stringUnit":{"state":"translated","value":"Дозволити Gateway використовувати камеру цього пристрою?"}},"id":{"stringUnit":{"state":"translated","value":"Izinkan Gateway menggunakan kamera perangkat ini?"}},"pl":{"stringUnit":{"state":"translated","value":"Zezwolić Gateway na korzystanie z aparatu tego urządzenia?"}},"th":{"stringUnit":{"state":"translated","value":"อนุญาตให้ Gateway ใช้กล้องของอุปกรณ์นี้หรือไม่?"}},"vi":{"stringUnit":{"state":"translated","value":"Cho phép Gateway sử dụng camera của thiết bị này?"}},"nl":{"stringUnit":{"state":"translated","value":"De Gateway toestaan de camera van dit apparaat te gebruiken?"}},"fa":{"stringUnit":{"state":"translated","value":"به Gateway اجازه می‌دهید از دوربین این دستگاه استفاده کند؟"}},"ru":{"stringUnit":{"state":"translated","value":"Разрешить Gateway использовать камеру этого устройства?"}},"sv":{"stringUnit":{"state":"translated","value":"Tillåta att Gateway använder den här enhetens kamera?"}}}},
    "Allowed HTTPS hosts": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allowed HTTPS hosts"}},"zh-CN":{"stringUnit":{"state":"translated","value":"允许的 HTTPS 主机"}},"zh-TW":{"stringUnit":{"state":"translated","value":"允許的 HTTPS 主機"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Hosts HTTPS permitidos"}},"de":{"stringUnit":{"state":"translated","value":"Erlaubte HTTPS-Hosts"}},"es":{"stringUnit":{"state":"translated","value":"Hosts HTTPS permitidos"}},"ja-JP":{"stringUnit":{"state":"translated","value":"許可されたHTTPSホスト"}},"ko":{"stringUnit":{"state":"translated","value":"허용된 HTTPS 호스트"}},"fr":{"stringUnit":{"state":"translated","value":"Hôtes HTTPS autorisés"}},"hi":{"stringUnit":{"state":"translated","value":"अनुमत HTTPS होस्ट"}},"ar":{"stringUnit":{"state":"translated","value":"مضيفو HTTPS المسموح بهم"}},"it":{"stringUnit":{"state":"translated","value":"Host HTTPS consentiti"}},"tr":{"stringUnit":{"state":"translated","value":"İzin verilen HTTPS ana bilgisayarları"}},"uk":{"stringUnit":{"state":"translated","value":"Дозволені хости HTTPS"}},"id":{"stringUnit":{"state":"translated","value":"Host HTTPS yang diizinkan"}},"pl":{"stringUnit":{"state":"translated","value":"Dozwolone hosty HTTPS"}},"th":{"stringUnit":{"state":"translated","value":"โฮสต์ HTTPS ที่อนุญาต"}},"vi":{"stringUnit":{"state":"translated","value":"Các máy chủ HTTPS được phép"}},"nl":{"stringUnit":{"state":"translated","value":"Toegestane HTTPS-hosts"}},"fa":{"stringUnit":{"state":"translated","value":"میزبان‌های مجاز HTTPS"}},"ru":{"stringUnit":{"state":"translated","value":"Разрешённые HTTPS-хосты"}},"sv":{"stringUnit":{"state":"translated","value":"Tillåtna HTTPS-värdar"}}}},
    "Allowed once": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allowed once"}},"zh-CN":{"stringUnit":{"state":"translated","value":"已允许一次"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已允許一次"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Permitido uma vez"}},"de":{"stringUnit":{"state":"translated","value":"Einmalig erlaubt"}},"es":{"stringUnit":{"state":"translated","value":"Permitido una vez"}},"ja-JP":{"stringUnit":{"state":"translated","value":"今回のみ許可済み"}},"ko":{"stringUnit":{"state":"translated","value":"한 번 허용됨"}},"fr":{"stringUnit":{"state":"translated","value":"Autorisé une fois"}},"hi":{"stringUnit":{"state":"translated","value":"एक बार अनुमति दी गई"}},"ar":{"stringUnit":{"state":"translated","value":"مسموح لمرة واحدة"}},"it":{"stringUnit":{"state":"translated","value":"Consentito una volta"}},"tr":{"stringUnit":{"state":"translated","value":"Bir kez izin verildi"}},"uk":{"stringUnit":{"state":"translated","value":"Дозволено одноразово"}},"id":{"stringUnit":{"state":"translated","value":"Diizinkan sekali"}},"pl":{"stringUnit":{"state":"translated","value":"Zezwolono jednorazowo"}},"th":{"stringUnit":{"state":"translated","value":"อนุญาตครั้งเดียวแล้ว"}},"vi":{"stringUnit":{"state":"translated","value":"Đã cho phép một lần"}},"nl":{"stringUnit":{"state":"translated","value":"Eenmalig toegestaan"}},"fa":{"stringUnit":{"state":"translated","value":"یک‌بار مجاز شد"}},"ru":{"stringUnit":{"state":"translated","value":"Разрешено однократно"}},"sv":{"stringUnit":{"state":"translated","value":"Tillåtet en gång"}}}},
    "Always": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Always"}},"zh-CN":{"stringUnit":{"state":"translated","value":"始终"}},"zh-TW":{"stringUnit":{"state":"translated","value":"永遠"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Sempre"}},"de":{"stringUnit":{"state":"translated","value":"Immer"}},"es":{"stringUnit":{"state":"translated","value":"Siempre"}},"ja-JP":{"stringUnit":{"state":"translated","value":"常に許可"}},"ko":{"stringUnit":{"state":"translated","value":"항상"}},"fr":{"stringUnit":{"state":"translated","value":"Toujours"}},"hi":{"stringUnit":{"state":"translated","value":"हमेशा"}},"ar":{"stringUnit":{"state":"translated","value":"دائمًا"}},"it":{"stringUnit":{"state":"translated","value":"Sempre"}},"tr":{"stringUnit":{"state":"translated","value":"Her Zaman"}},"uk":{"stringUnit":{"state":"translated","value":"Завжди"}},"id":{"stringUnit":{"state":"translated","value":"Selalu"}},"pl":{"stringUnit":{"state":"translated","value":"Zawsze"}},"th":{"stringUnit":{"state":"translated","value":"เสมอ"}},"vi":{"stringUnit":{"state":"translated","value":"Luôn luôn"}},"nl":{"stringUnit":{"state":"translated","value":"Altijd"}},"fa":{"stringUnit":{"state":"translated","value":"همیشه"}},"ru":{"stringUnit":{"state":"translated","value":"Всегда"}},"sv":{"stringUnit":{"state":"translated","value":"Alltid"}}}},
    "Always is selected, but iOS currently allows location only while using the app.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Always is selected, but iOS currently allows location only while using the app."}},"zh-CN":{"stringUnit":{"state":"translated","value":"已选择始终，但 iOS 目前仅允许在使用 App 期间访问位置。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已選取「永遠」，但 iOS 目前僅允許在使用 App 期間存取位置。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Sempre está selecionado, mas o iOS atualmente permite acesso à localização apenas durante o uso do app."}},"de":{"stringUnit":{"state":"translated","value":"Immer ist ausgewählt, aber iOS erlaubt den Standortzugriff derzeit nur beim Verwenden der App."}},"es":{"stringUnit":{"state":"translated","value":"La opción Siempre está seleccionada, pero iOS actualmente solo permite acceder a la ubicación mientras se usa la app."}},"ja-JP":{"stringUnit":{"state":"translated","value":"「常に」が選択されていますが、現在iOSではアプリの使用中のみ位置情報へのアクセスが許可されています。"}},"ko":{"stringUnit":{"state":"translated","value":"항상이 선택되어 있지만, 현재 iOS에서는 앱을 사용하는 동안에만 위치 접근을 허용합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Toujours est sélectionné, mais iOS n’autorise actuellement la localisation que lorsque l’app est utilisée."}},"hi":{"stringUnit":{"state":"translated","value":"हमेशा चुना गया है, लेकिन iOS अभी केवल ऐप का उपयोग करते समय ही स्थान की अनुमति देता है."}},"ar":{"stringUnit":{"state":"translated","value":"تم تحديد دائمًا، لكن iOS يسمح حاليًا بالوصول إلى الموقع أثناء استخدام التطبيق فقط."}},"it":{"stringUnit":{"state":"translated","value":"È selezionato Sempre, ma al momento iOS consente l'accesso alla posizione solo durante l'uso dell'app."}},"tr":{"stringUnit":{"state":"translated","value":"Her Zaman seçili, ancak iOS şu anda konum erişimine yalnızca uygulama kullanılırken izin veriyor."}},"uk":{"stringUnit":{"state":"translated","value":"Вибрано «Завжди», але наразі iOS дозволяє доступ до геопозиції лише під час використання програми."}},"id":{"stringUnit":{"state":"translated","value":"Selalu dipilih, tetapi iOS saat ini hanya mengizinkan akses lokasi saat menggunakan aplikasi."}},"pl":{"stringUnit":{"state":"translated","value":"Wybrano opcję Zawsze, ale iOS obecnie zezwala na dostęp do lokalizacji tylko podczas używania aplikacji."}},"th":{"stringUnit":{"state":"translated","value":"เลือกตลอดเวลาไว้ แต่ขณะนี้ iOS อนุญาตให้เข้าถึงตำแหน่งที่ตั้งเฉพาะขณะใช้แอปเท่านั้น."}},"vi":{"stringUnit":{"state":"translated","value":"Đã chọn Luôn luôn, nhưng iOS hiện chỉ cho phép truy cập vị trí khi sử dụng ứng dụng."}},"nl":{"stringUnit":{"state":"translated","value":"Altijd is geselecteerd, maar iOS staat momenteel alleen locatietoegang toe tijdens het gebruik van de app."}},"fa":{"stringUnit":{"state":"translated","value":"گزینهٔ همیشه انتخاب شده است، اما iOS در حال حاضر فقط هنگام استفاده از برنامه اجازهٔ دسترسی به موقعیت مکانی را می‌دهد."}},"ru":{"stringUnit":{"state":"translated","value":"Выбрано «Всегда», но сейчас iOS разрешает доступ к геопозиции только при использовании приложения."}},"sv":{"stringUnit":{"state":"translated","value":"Alltid är valt, men iOS tillåter för närvarande bara platsåtkomst när appen används."}}}},
    "Always is selected, but iOS currently allows location only while using the app. Precise Location is off.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Always is selected, but iOS currently allows location only while using the app. Precise Location is off."}},"zh-CN":{"stringUnit":{"state":"translated","value":"已选择始终，但 iOS 目前仅允许在使用 App 期间访问位置。 精确位置已关闭。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已選取「永遠」，但 iOS 目前僅允許在使用 App 期間存取位置。 精確位置已關閉。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Sempre está selecionado, mas o iOS atualmente permite acesso à localização apenas durante o uso do app. A Localização Precisa está desativada."}},"de":{"stringUnit":{"state":"translated","value":"Immer ist ausgewählt, aber iOS erlaubt den Standortzugriff derzeit nur beim Verwenden der App. Genauer Standort ist deaktiviert."}},"es":{"stringUnit":{"state":"translated","value":"La opción Siempre está seleccionada, pero iOS actualmente solo permite acceder a la ubicación mientras se usa la app. La Ubicación Precisa está desactivada."}},"ja-JP":{"stringUnit":{"state":"translated","value":"「常に」が選択されていますが、現在iOSではアプリの使用中のみ位置情報へのアクセスが許可されています。「正確な位置情報」はオフです。"}},"ko":{"stringUnit":{"state":"translated","value":"항상이 선택되어 있지만, 현재 iOS에서는 앱을 사용하는 동안에만 위치 접근을 허용합니다. 정확한 위치가 꺼져 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Toujours est sélectionné, mais iOS n’autorise actuellement la localisation que lorsque l’app est utilisée. La position exacte est désactivée."}},"hi":{"stringUnit":{"state":"translated","value":"हमेशा चुना गया है, लेकिन iOS अभी केवल ऐप का उपयोग करते समय ही स्थान की अनुमति देता है. सटीक स्थान बंद है."}},"ar":{"stringUnit":{"state":"translated","value":"تم تحديد دائمًا، لكن iOS يسمح حاليًا بالوصول إلى الموقع أثناء استخدام التطبيق فقط. الموقع الدقيق معطّل."}},"it":{"stringUnit":{"state":"translated","value":"È selezionato Sempre, ma al momento iOS consente l'accesso alla posizione solo durante l'uso dell'app. La posizione precisa è disattivata."}},"tr":{"stringUnit":{"state":"translated","value":"Her Zaman seçili, ancak iOS şu anda konum erişimine yalnızca uygulama kullanılırken izin veriyor. Tam Konum kapalı."}},"uk":{"stringUnit":{"state":"translated","value":"Вибрано «Завжди», але наразі iOS дозволяє доступ до геопозиції лише під час використання програми. Точну геопозицію вимкнено."}},"id":{"stringUnit":{"state":"translated","value":"Selalu dipilih, tetapi iOS saat ini hanya mengizinkan akses lokasi saat menggunakan aplikasi. Lokasi Presisi nonaktif."}},"pl":{"stringUnit":{"state":"translated","value":"Wybrano opcję Zawsze, ale iOS obecnie zezwala na dostęp do lokalizacji tylko podczas używania aplikacji. Dokładna lokalizacja jest wyłączona."}},"th":{"stringUnit":{"state":"translated","value":"เลือกตลอดเวลาไว้ แต่ขณะนี้ iOS อนุญาตให้เข้าถึงตำแหน่งที่ตั้งเฉพาะขณะใช้แอปเท่านั้น. ตำแหน่งที่ตั้งจริงปิดอยู่."}},"vi":{"stringUnit":{"state":"translated","value":"Đã chọn Luôn luôn, nhưng iOS hiện chỉ cho phép truy cập vị trí khi sử dụng ứng dụng. Vị trí chính xác đang tắt."}},"nl":{"stringUnit":{"state":"translated","value":"Altijd is geselecteerd, maar iOS staat momenteel alleen locatietoegang toe tijdens het gebruik van de app. Exacte locatie is uitgeschakeld."}},"fa":{"stringUnit":{"state":"translated","value":"گزینهٔ همیشه انتخاب شده است، اما iOS در حال حاضر فقط هنگام استفاده از برنامه اجازهٔ دسترسی به موقعیت مکانی را می‌دهد. موقعیت مکانی دقیق خاموش است."}},"ru":{"stringUnit":{"state":"translated","value":"Выбрано «Всегда», но сейчас iOS разрешает доступ к геопозиции только при использовании приложения. Точная геопозиция выключена."}},"sv":{"stringUnit":{"state":"translated","value":"Alltid är valt, men iOS tillåter för närvarande bara platsåtkomst när appen används. Exakt platsinfo är av."}}}},
    "Always is selected, but iOS currently allows location only while using the app. Precise Location is on.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Always is selected, but iOS currently allows location only while using the app. Precise Location is on."}},"zh-CN":{"stringUnit":{"state":"translated","value":"已选择始终，但 iOS 目前仅允许在使用 App 期间访问位置。 精确位置已开启。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已選取「永遠」，但 iOS 目前僅允許在使用 App 期間存取位置。 精確位置已開啟。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Sempre está selecionado, mas o iOS atualmente permite acesso à localização apenas durante o uso do app. A Localização Precisa está ativada."}},"de":{"stringUnit":{"state":"translated","value":"Immer ist ausgewählt, aber iOS erlaubt den Standortzugriff derzeit nur beim Verwenden der App. Genauer Standort ist aktiviert."}},"es":{"stringUnit":{"state":"translated","value":"La opción Siempre está seleccionada, pero iOS actualmente solo permite acceder a la ubicación mientras se usa la app. La Ubicación Precisa está activada."}},"ja-JP":{"stringUnit":{"state":"translated","value":"「常に」が選択されていますが、現在iOSではアプリの使用中のみ位置情報へのアクセスが許可されています。「正確な位置情報」はオンです。"}},"ko":{"stringUnit":{"state":"translated","value":"항상이 선택되어 있지만, 현재 iOS에서는 앱을 사용하는 동안에만 위치 접근을 허용합니다. 정확한 위치가 켜져 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Toujours est sélectionné, mais iOS n’autorise actuellement la localisation que lorsque l’app est utilisée. La position exacte est activée."}},"hi":{"stringUnit":{"state":"translated","value":"हमेशा चुना गया है, लेकिन iOS अभी केवल ऐप का उपयोग करते समय ही स्थान की अनुमति देता है. सटीक स्थान चालू है."}},"ar":{"stringUnit":{"state":"translated","value":"تم تحديد دائمًا، لكن iOS يسمح حاليًا بالوصول إلى الموقع أثناء استخدام التطبيق فقط. الموقع الدقيق مفعّل."}},"it":{"stringUnit":{"state":"translated","value":"È selezionato Sempre, ma al momento iOS consente l'accesso alla posizione solo durante l'uso dell'app. La posizione precisa è attivata."}},"tr":{"stringUnit":{"state":"translated","value":"Her Zaman seçili, ancak iOS şu anda konum erişimine yalnızca uygulama kullanılırken izin veriyor. Tam Konum açık."}},"uk":{"stringUnit":{"state":"translated","value":"Вибрано «Завжди», але наразі iOS дозволяє доступ до геопозиції лише під час використання програми. Точну геопозицію ввімкнено."}},"id":{"stringUnit":{"state":"translated","value":"Selalu dipilih, tetapi iOS saat ini hanya mengizinkan akses lokasi saat menggunakan aplikasi. Lokasi Presisi aktif."}},"pl":{"stringUnit":{"state":"translated","value":"Wybrano opcję Zawsze, ale iOS obecnie zezwala na dostęp do lokalizacji tylko podczas używania aplikacji. Dokładna lokalizacja jest włączona."}},"th":{"stringUnit":{"state":"translated","value":"เลือกตลอดเวลาไว้ แต่ขณะนี้ iOS อนุญาตให้เข้าถึงตำแหน่งที่ตั้งเฉพาะขณะใช้แอปเท่านั้น. ตำแหน่งที่ตั้งจริงเปิดอยู่."}},"vi":{"stringUnit":{"state":"translated","value":"Đã chọn Luôn luôn, nhưng iOS hiện chỉ cho phép truy cập vị trí khi sử dụng ứng dụng. Vị trí chính xác đang bật."}},"nl":{"stringUnit":{"state":"translated","value":"Altijd is geselecteerd, maar iOS staat momenteel alleen locatietoegang toe tijdens het gebruik van de app. Exacte locatie is ingeschakeld."}},"fa":{"stringUnit":{"state":"translated","value":"گزینهٔ همیشه انتخاب شده است، اما iOS در حال حاضر فقط هنگام استفاده از برنامه اجازهٔ دسترسی به موقعیت مکانی را می‌دهد. موقعیت مکانی دقیق روشن است."}},"ru":{"stringUnit":{"state":"translated","value":"Выбрано «Всегда», но сейчас iOS разрешает доступ к геопозиции только при использовании приложения. Точная геопозиция включена."}},"sv":{"stringUnit":{"state":"translated","value":"Alltid är valt, men iOS tillåter för närvarande bara platsåtkomst när appen används. Exakt platsinfo är på."}}}},
    "Another feature is using the microphone.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Another feature is using the microphone."}},"zh-CN":{"stringUnit":{"state":"translated","value":"另一项功能正在使用麦克风。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"另一項功能正在使用麥克風。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Outro recurso está usando o microfone."}},"de":{"stringUnit":{"state":"translated","value":"Eine andere Funktion verwendet das Mikrofon."}},"es":{"stringUnit":{"state":"translated","value":"Otra función está usando el micrófono."}},"ja-JP":{"stringUnit":{"state":"translated","value":"別の機能がマイクを使用しています。"}},"ko":{"stringUnit":{"state":"translated","value":"다른 기능이 마이크를 사용하고 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Une autre fonctionnalité utilise le microphone."}},"hi":{"stringUnit":{"state":"translated","value":"कोई अन्य सुविधा माइक्रोफ़ोन का उपयोग कर रही है."}},"ar":{"stringUnit":{"state":"translated","value":"تستخدم ميزة أخرى الميكروفون."}},"it":{"stringUnit":{"state":"translated","value":"Un'altra funzionalità sta utilizzando il microfono."}},"tr":{"stringUnit":{"state":"translated","value":"Başka bir özellik mikrofonu kullanıyor."}},"uk":{"stringUnit":{"state":"translated","value":"Інша функція використовує мікрофон."}},"id":{"stringUnit":{"state":"translated","value":"Fitur lain sedang menggunakan mikrofon."}},"pl":{"stringUnit":{"state":"translated","value":"Inna funkcja korzysta z mikrofonu."}},"th":{"stringUnit":{"state":"translated","value":"ฟีเจอร์อื่นกำลังใช้ไมโครโฟนอยู่."}},"vi":{"stringUnit":{"state":"translated","value":"Một tính năng khác đang sử dụng micrô."}},"nl":{"stringUnit":{"state":"translated","value":"Een andere functie gebruikt de microfoon."}},"fa":{"stringUnit":{"state":"translated","value":"قابلیت دیگری در حال استفاده از میکروفون است."}},"ru":{"stringUnit":{"state":"translated","value":"Другая функция использует микрофон."}},"sv":{"stringUnit":{"state":"translated","value":"En 