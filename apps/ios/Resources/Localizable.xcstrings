    "OpenClaw could not prepare the Markdown file.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenClaw could not prepare the Markdown file."}},"zh-CN":{"stringUnit":{"state":"translated","value":"OpenClaw 无法准备 Markdown 文件。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw 無法準備 Markdown 檔案。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O OpenClaw não conseguiu preparar o arquivo Markdown."}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw konnte die Markdown-Datei nicht vorbereiten."}},"es":{"stringUnit":{"state":"translated","value":"OpenClaw no pudo preparar el archivo Markdown."}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClawはMarkdownファイルを準備できませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw에서 Markdown 파일을 준비하지 못했습니다."}},"fr":{"stringUnit":{"state":"translated","value":"OpenClaw n’a pas pu préparer le fichier Markdown."}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw Markdown फ़ाइल तैयार नहीं कर सका."}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر على OpenClaw تجهيز ملف Markdown."}},"it":{"stringUnit":{"state":"translated","value":"OpenClaw non ha potuto preparare il file Markdown."}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw Markdown dosyasını hazırlayamadı."}},"uk":{"stringUnit":{"state":"translated","value":"OpenClaw не вдалося підготувати файл Markdown."}},"id":{"stringUnit":{"state":"translated","value":"OpenClaw tidak dapat menyiapkan file Markdown."}},"pl":{"stringUnit":{"state":"translated","value":"OpenClaw nie może przygotować pliku Markdown."}},"th":{"stringUnit":{"state":"translated","value":"OpenClaw ไม่สามารถเตรียมไฟล์ Markdown ได้."}},"vi":{"stringUnit":{"state":"translated","value":"OpenClaw không thể chuẩn bị tệp Markdown."}},"nl":{"stringUnit":{"state":"translated","value":"OpenClaw kon het Markdown-bestand niet voorbereiden."}},"fa":{"stringUnit":{"state":"translated","value":"OpenClaw نتوانست فایل Markdown 