    "Open OpenClaw on iPhone and try the action again.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open OpenClaw on iPhone and try the action again."}},"zh-CN":{"stringUnit":{"state":"translated","value":"在 iPhone 上打开 OpenClaw，然后重试该操作。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"在 iPhone 上開啟 OpenClaw，然後再次嘗試此操作。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Abra o OpenClaw no iPhone e tente a ação novamente."}},"de":{"stringUnit":{"state":"translated","value":"Öffnen Sie OpenClaw auf dem iPhone und versuchen Sie die Aktion erneut."}},"es":{"stringUnit":{"state":"translated","value":"Abre OpenClaw en el iPhone e intenta la acción de nuevo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"iPhone で OpenClaw を開き、もう一度操作を試してください。"}},"ko":{"stringUnit":{"state":"translated","value":"iPhone에서 OpenClaw를 열고 작업을 다시 시도하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Ouvrez OpenClaw sur l’iPhone et réessayez l’action."}},"hi":{"stringUnit":{"state":"translated","value":"iPhone पर OpenClaw खोलें और कार्रवाई फिर से आज़माएँ."}},"ar":{"stringUnit":{"state":"translated","value":"افتح OpenClaw على iPhone وحاول تنفيذ الإجراء مرة أخرى."}},"it":{"stringUnit":{"state":"translated","value":"Apri OpenClaw su iPhone e riprova l'azione."}},"tr":{"stringUnit":{"state":"translated","value":"iPhone'da OpenClaw uygulamasını açın ve işlemi tekrar deneyin."}},"uk":{"stringUnit":{"state":"translated","value":"Відкрийте OpenClaw на iPhone і спробуйте виконати дію ще раз."}},"id":{"stringUnit":{"state":"translated","value":"Buka OpenClaw di iPhone dan coba tindakan tersebut lagi."}},"pl":{"stringUnit":{"state":"translated","value":"Otwórz OpenClaw na iPhonie i spróbuj wykonać tę czynność ponownie."}},"th":{"stringUnit":{"state":"translated","value":"เปิด OpenClaw บน iPhone แล้วลองดำเนินการอีกครั้ง."}},"vi":{"stringUnit":{"state":"translated","value":"Mở OpenClaw trên iPhone và thử lại thao tác."}},"nl":{"stringUnit":{"state":"translated","