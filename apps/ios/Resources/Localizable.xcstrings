    "Reconnect on iPhone": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reconnect on iPhone"}},"zh-CN":{"stringUnit":{"state":"translated","value":"在 iPhone 上重新连接"}},"zh-TW":{"stringUnit":{"state":"translated","value":"在 iPhone 上重新連線"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Reconectar no iPhone"}},"de":{"stringUnit":{"state":"translated","value":"Auf dem iPhone erneut verbinden"}},"es":{"stringUnit":{"state":"translated","value":"Reconectar en iPhone"}},"ja-JP":{"stringUnit":{"state":"translated","value":"iPhoneで再接続"}},"ko":{"stringUnit":{"state":"translated","value":"iPhone에서 다시 연결"}},"fr":{"stringUnit":{"state":"translated","value":"Reconnecter sur iPhone"}},"hi":{"stringUnit":{"state":"translated","value":"iPhone पर फिर से कनेक्ट करें"}},"ar":{"stringUnit":{"state":"translated","value":"إعادة الاتصال على iPhone"}},"it":{"stringUnit":{"state":"translated","value":"Riconnetti su iPhone"}},"tr":{"stringUnit":{"state":"translated","value":"iPhone'da yeniden bağlan"}},"uk":{"stringUnit":{"state":"translated","value":"Підключитися знову на iPhone"}},"id":{"stringUnit":{"state":"translated","value":"Hubungkan kembali di iPhone"}},"pl":{"stringUnit":{"state":"translated","value":"Połącz ponownie na iPhonie"}},"th":{"stringUnit":{"state":"translated","value":"เชื่อมต่อใหม่บน iPhone"}},"vi":{"stringUnit":{"state":"translated","value":"Kết nối lại trên iPhone"}},"nl":{"stringUnit":{"state":"translated","value":"Opnieuw verbinden op iPhone"}},"fa":{"stringUnit":{"state":"translated","value":"اتصال مجدد در iPhone"}},"ru":{"stringUnit":{"state":"translated","value":"Переподключиться на iPhone"}},"sv":{"stringUnit":{"state":"translated","value":"Återanslut på iPhone"}}}},
    "Reconnect the Watch to your Gateway, then start voice again.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reconnect the Watch to your Gateway, then start voice again."}},"zh-CN":{"stringUnit":{"state":"translated","value":"将手表重新连接到你的 Gateway，然后再次启动语音。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"請將手錶重新連線至您的 Gateway，然後再次啟動語音。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Reconecte o Watch ao seu Gateway e inicie a conversa por voz novamente."}},"de":{"stringUnit":{"state":"translated","value":"Verbinden Sie die Watch erneut mit Ihrem Gateway und starten Sie dann die Sprachfunktion erneut."}},"es":{"stringUnit":{"state":"translated","value":"Vuelve a conectar el Apple Watch a tu Gateway y, después, inicia de nuevo el modo de voz."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Apple WatchをGatewayに再接続してから、音声をもう一度開始してください。"}},"ko":{"stringUnit":{"state":"translated","value":"Watch를 Gateway에 다시 연결한 다음 음성 기능을 다시 시작하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Reconnectez l’Apple Watch à votre Gateway, puis relancez le mode vocal."}},"hi":{"stringUnit":{"state":"translated","value":"Watch को अपने Gateway से फिर से कनेक्ट करें, फिर वॉइस दोबारा शुरू करें।"}},"ar":{"stringUnit":{"state":"translated","value":"أعِد توصيل الساعة بـ Gateway، ثم ابدأ المحادثة الصوتية مجددًا."}},"it":{"stringUnit":{"state":"translated","value":"Riconnetti il Watch al tuo Gateway, quindi riavvia la modalità vocale."}},"tr":{"stringUnit":{"state":"translated","value":"Watch'u Gateway'inize yeniden bağlayın, ardından sesli görüşmeyi tekrar başlatın."}},"uk":{"stringUnit":{"state":"translated","value":"Повторно підключіть годинник до Gateway, а потім знову запустіть голосовий режим."}},"id":{"stringUnit":{"state":"translated","value":"Hubungkan ulang Watch ke Gateway Anda, lalu mulai percakapan suara lagi."}},"pl":{"stringUnit":{"state":"translated","value":"Połącz ponownie zegarek z Gateway, a następnie ponownie uruchom tryb głosowy."}},"th":{"stringUnit":{"state":"translated","value":"เชื่อมต่อ Watch กับ Gateway ของคุณอีกครั้ง แล้วเริ่มการสนทนาด้วยเสียงอีกครั้ง"}},"vi":{"stringUnit":{"state":"translated","value":"Kết nối lại Apple Watch với Gateway của bạn, rồi bắt đầu trò chuyện thoại lại."}},"nl":{"stringUnit":{"state":"translated","value":"Verbind de Watch opnieuw met je Gateway en start daarna spraak opnieuw."}},"fa":{"stringUnit":{"state":"translated","value":"Apple Watch را دوباره به Gateway خود متصل کنید، سپس گفت‌وگوی صوتی را دوباره آغاز کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Снова подключите часы к Gateway, затем ещё раз запустите голосовой режим."}},"sv":{"stringUnit":{"state":"translated","value":"Återanslut din Watch till din Gateway och starta sedan röstläget igen."}}}},
