    "This Gateway did not provide a usable Gateway-controlled WebRTC session.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This Gateway did not provide a usable Gateway-controlled WebRTC session."}},"zh-CN":{"stringUnit":{"state":"translated","value":"此 Gateway 未提供可用的、由 Gateway 控制的 WebRTC 会话。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此 Gateway 未提供可用且由 Gateway 控制的 WebRTC 工作階段。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Este Gateway não forneceu uma sessão WebRTC utilizável controlada pelo Gateway."}},"de":{"stringUnit":{"state":"translated","value":"Dieses Gateway hat keine nutzbare, vom Gateway gesteuerte WebRTC-Sitzung bereitgestellt."}},"es":{"stringUnit":{"state":"translated","value":"Este Gateway no ha proporcionado una sesión WebRTC utilizable y controlada por el Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このGatewayは、Gatewayが制御する利用可能なWebRTCセッションを提供しませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"이 Gateway는 사용 가능한 Gateway 제어 WebRTC 세션을 제공하지 않았습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Ce Gateway n’a pas fourni de session WebRTC exploitable contrôlée par le Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"इस Gateway ने उपयोग करने योग्य Gateway-नियंत्रित WebRTC सत्र उपलब्ध नहीं कराया।"}},"ar":{"stringUnit":{"state":"translated","value":"لم يوفّر Gateway هذا جلسة WebRTC قابلة للاستخدام يتحكم بها Gateway."}},"it":{"stringUnit":{"state":"translated","value":"Questo Gateway non ha fornito una sessione WebRTC utilizzabile e controllata dal Gateway."}},"tr":{"stringUnit":{"state":"translated","value":"Bu Gateway, Gateway tarafından kontrol edilen kullanılabilir bir WebRTC oturumu sağlamadı."}},"uk":{"stringUnit":{"state":"translated","value":"Цей Gateway не надав придатного для використання сеансу WebRTC під керуванням Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Gateway ini tidak menyediakan sesi WebRTC yang dikendalikan Gateway dan dapat digunakan."}},"pl":{"stringUnit":{"state":"translated","value":"Ten Gateway nie udostępnił działającej sesji WebRTC sterowanej przez Gateway."}},"th":{"stringUnit":{"state":"translated","value":"Gateway นี้ไม่ได้จัดเตรียมเซสชัน WebRTC ที่ควบคุมโดย Gateway และใช้งานได้"}},"vi":{"stringUnit":{"state":"translated","value":"Gateway này không cung cấp phiên WebRTC khả dụng do Gateway điều khiển."}},"nl":{"stringUnit":{"state":"translated","value":"Deze Gateway heeft geen bruikbare, door de Gateway beheerde WebRTC-sessie geleverd."}},"fa":{"stringUnit":{"state":"translated","value":"این Gateway نشست WebRTC قابل‌استفاده‌ای تحت کنترل Gateway ارائه نکرد."}},"ru":{"stringUnit":{"state":"translated","value":"Этот Gateway не предоставил пригодный для использования сеанс WebRTC под управлением Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Denna Gateway tillhandahöll ingen användbar Gateway-styrd WebRTC-session."}}}},
    "This Gateway's Dashboard is older than the app; update the Gateway to manage app settings here": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This Gateway's Dashboard is older than the app; update the Gateway to manage app settings here"}},"zh-CN":{"stringUnit":{"state":"translated","value":"此 Gateway 的仪表盘版本比应用旧；请更新 Gateway，以便在此处管理应用设置"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此 Gateway 的儀表板版本比應用程式舊；請更新 Gateway，以便在此管理應用程式設定"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O painel deste Gateway é mais antigo que o aplicativo; atualize o Gateway para gerenciar as configurações do aplicativo aqui"}},"de":{"stringUnit":{"state":"translated","value":"Das Dashboard dieses Gateways ist älter als die App; aktualisiere den Gateway, um die App-Einstellungen hier zu verwalten"}},"es":{"stringUnit":{"state":"translated","value":"El panel de este Gateway es de una versión anterior a la de la aplicación; actualiza el Gateway para gestionar aquí los ajustes de la aplicación"}},"ja-JP":{"stringUnit":{"state":"translated","value":"このGatewayのダッシュボードはアプリよりも古いバージョンです。ここでアプリの設定を管理するには、Gatewayを更新してください"}},"ko":{"stringUnit":{"state":"translated","value":"이 Gateway의 대시보드는 앱보다 이전 버전입니다. 여기서 앱 설정을 관리하려면 Gateway를 업데이트하세요"}},"fr":{"stringUnit":{"state":"translated","value":"Le tableau de bord de ce Gateway est plus ancien que l’application ; mettez à jour le Gateway pour gérer les paramètres de l’application ici"}},"hi":{"stringUnit":{"state":"translated","value":"इस Gateway का डैशबोर्ड ऐप से पुराना है; यहाँ ऐप की सेटिंग प्रबंधित करने के लिए Gateway अपडेट करें"}},"ar":{"stringUnit":{"state":"translated","value":"لوحة تحكّم Gateway هذا أقدم من التطبيق؛ حدّث Gateway لإدارة إعدادات التطبيق هنا"}},"it":{"stringUnit":{"state":"translated","value":"La dashboard di questo Gateway è meno recente dell'app; aggiorna il Gateway per gestire qui le impostazioni dell'app"}},"tr":{"stringUnit":{"state":"translated","value":"Bu Gateway'in kontrol paneli uygulamadan daha eski; uygulama ayarlarını buradan yönetmek için Gateway'i güncelleyin"}},"uk":{"stringUnit":{"state":"translated","value":"Панель керування цього Gateway старіша за застосунок; оновіть Gateway, щоб керувати налаштуваннями застосунку тут"}},"id":{"stringUnit":{"state":"translated","value":"Dasbor Gateway ini lebih lama daripada aplikasi; perbarui Gateway untuk mengelola pengaturan aplikasi di sini"}},"pl":{"stringUnit":{"state":"translated","value":"Panel tego Gateway jest starszy niż aplikacja; zaktualizuj Gateway, aby zarządzać tutaj ustawieniami aplikacji"}},"th":{"stringUnit":{"state":"translated","value":"แดชบอร์ดของ Gateway นี้เป็นเวอร์ชันเก่ากว่าแอป โปรดอัปเดต Gateway เพื่อจัดการการตั้งค่าแอปที่นี่"}},"vi":{"stringUnit":{"state":"translated","value":"Bảng điều khiển của Gateway này có phiên bản cũ hơn ứng dụng; hãy cập nhật Gateway để quản lý cài đặt ứng dụng tại đây"}},"nl":{"stringUnit":{"state":"translated","value":"Het dashboard van deze Gateway is ouder dan de app; werk de Gateway bij om hier appinstellingen te beheren"}},"fa":{"stringUnit":{"state":"translated","value":"داشبورد این Gateway از برنامه قدیمی‌تر است؛ برای مدیریت تنظیمات برنامه در اینجا، Gateway را به‌روزرسانی کنید"}},"ru":{"stringUnit":{"state":"translated","value":"Панель управления этого Gateway устарела по сравнению с приложением; обновите Gateway, чтобы управлять настройками приложения здесь"}},"sv":{"stringUnit":{"state":"translated","value":"Översiktspanelen för denna Gateway är äldre än appen. Uppdatera Gateway för att hantera appinställningar här"}}}},
    "This Watch message belongs to a retired Gateway route. Open OpenClaw on iPhone.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This Watch message belongs to a retired Gateway route. Open OpenClaw on iPhone."}},"zh-CN":{"stringUnit":{"state":"translated","value":"这条 Watch 消息属于已停用的 Gateway 路由。 请在 iPhone 上打开 OpenClaw."}},"zh-TW":{"stringUnit":{"state":"translated","value":"這則 Watch 訊息屬於已停用的 Gateway 路由。 請在 iPhone 上開啟 OpenClaw."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Esta mensagem do Watch pertence a uma rota do Gateway desativada. Abra o OpenClaw no iPhone."}},"de":{"stringUnit":{"state":"translated","value":"Diese Watch-Nachricht gehört zu einer stillgelegten Gateway-Route. Öffne OpenClaw auf dem iPhone."}},"es":{"stringUnit":{"state":"translated","value":"Este mensaje de Watch pertenece a una ruta de Gateway retirada. Abre OpenClaw en el iPhone."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このWatchメッセージは、廃止されたGatewayルートに属しています。iPhoneでOpenClawを開いてください。"}},"ko":{"stringUnit":{"state":"translated","value":"이 Watch 메시지는 더 이상 사용되지 않는 Gateway 경로에 속합니다. iPhone에서 OpenClaw를 여세요."}},"fr":{"stringUnit":{"state":"translated","value":"Ce message Watch appartient à une route Gateway désactivée. Ouvrez OpenClaw sur iPhone."}},"hi":{"stringUnit":{"state":"translated","value":"यह Watch संदेश अब उपयोग में न आने वाले Gateway रूट से जुड़ा है. iPhone पर OpenClaw खोलें."}},"ar":{"stringUnit":{"state":"translated","value":"تنتمي رسالة Watch هذه إلى مسار Gateway لم يعد مستخدمًا. افتح OpenClaw على iPhone."}},"it":{"stringUnit":{"state":"translated","value":"Questo messaggio di Watch appartiene a un percorso Gateway dismesso. Apri OpenClaw su iPhone."}},"tr":{"stringUnit":{"state":"translated","value":"Bu Watch mesajı, artık kullanılmayan bir Gateway rotasına ait. iPhone'da OpenClaw'u açın."}},"uk":{"stringUnit":{"state":"translated","value":"Це повідомлення з Watch належить до виведеного з експлуатації маршруту Gateway. Відкрийте OpenClaw на iPhone."}},"id":{"stringUnit":{"state":"translated","value":"Pesan Watch ini terkait dengan rute Gateway yang sudah dinonaktifkan. Buka OpenClaw di iPhone."}},"pl":{"stringUnit":{"state":"translated","value":"Ta wiadomość z zegarka Watch należy do wycofanej trasy Gateway. Otwórz OpenClaw na iPhonie."}},"th":{"stringUnit":{"state":"translated","value":"ข้อความจาก Watch นี้เป็นของเส้นทาง Gateway ที่เลิกใช้งานแล้ว. เปิด OpenClaw บน iPhone."}},"vi":{"stringUnit":{"state":"translated","value":"Tin nhắn Watch này thuộc về một tuyến Gateway đã ngừng hoạt động. Mở OpenClaw trên iPhone."}},"nl":{"stringUnit":{"state":"translated","value":"Dit Watch-bericht hoort bij een buiten gebruik gestelde Gateway-route. Open OpenClaw op iPhone."}},"fa":{"stringUnit":{"state":"translated","value":"این پیام Watch به یک مسیر از رده خارج‌شدهٔ Gateway تعلق دارد. OpenClaw را در iPhone باز کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Это сообщение с Watch относится к выведенному из эксплуатации маршруту Gateway. Откройте OpenClaw на iPhone."}},"sv":{"stringUnit":{"state":"translated","value":"Det här Watch-meddelandet tillhör en avvecklad Gateway-rutt. Öppna OpenClaw på iPhone."}}}},
    "This Watch message expired. Check Chat on iPhone.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This Watch message expired. Check Chat on iPhone."}},"zh-CN":{"stringUnit":{"state":"translated","value":"这条 Watch 消息已过期。 请在 iPhone 上查看聊天。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"這則 Watch 訊息已過期。 請在 iPhone 上查看聊天。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Esta mensagem do Watch expirou. Confira o Chat no iPhone."}},"de":{"stringUnit":{"state":"translated","value":"Diese Watch-Nachricht ist abgelaufen. Sieh im Chat auf dem iPhone nach."}},"es":{"stringUnit":{"state":"translated","value":"Este mensaje de Watch ha caducado. Revisa el Chat en el iPhone."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このWatchメッセージは有効期限が切れています。iPhoneでチャットを確認してください。"}},"ko":{"stringUnit":{"state":"translated","value":"이 Watch 메시지는 만료되었습니다. iPhone에서 채팅을 확인하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Ce message Watch a expiré. Consultez la discussion sur iPhone."}},"hi":{"stringUnit":{"state":"translated","value":"इस Watch संदेश की समय सीमा समाप्त हो गई है. iPhone पर चैट देखें."}},"ar":{"stringUnit":{"state":"translated","value":"انتهت صلاحية رسالة Watch هذه. تحقق من الدردشة على iPhone."}},"it":{"stringUnit":{"state":"translated","value":"Questo messaggio di Watch è scaduto. Controlla la chat su iPhone."}},"tr":{"stringUnit":{"state":"translated","value":"Bu Watch mesajının süresi doldu. iPhone'da Sohbet'i kontrol edin."}},"uk":{"stringUnit":{"state":"translated","value":"Термін дії цього повідомлення з Watch минув. Перевірте чат на iPhone."}},"id":{"stringUnit":{"state":"translated","value":"Pesan Watch ini telah kedaluwarsa. Periksa Obrolan di iPhone."}},"pl":{"stringUnit":{"state":"translated","value":"Ta wiadomość z zegarka Watch wygasła. Sprawdź Czat na iPhonie."}},"th":{"stringUnit":{"state":"translated","value":"ข้อความจาก Watch นี้หมดอายุแล้ว. ตรวจสอบแชทบน iPhone."}},"vi":{"stringUnit":{"state":"translated","value":"Tin nhắn Watch này đã hết hạn. Kiểm tra Trò chuyện trên iPhone."}},"nl":{"stringUnit":{"state":"translated","value":"Dit Watch-bericht is verlopen. Controleer Chat op iPhone."}},"fa":{"stringUnit":{"state":"translated","value":"این پیام Watch منقضی شده است. گفتگو را در iPhone بررسی کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Срок действия этого сообщения с Watch истёк. Проверьте чат на iPhone."}},"sv":{"stringUnit":{"state":"translated","value":"Det här Watch-meddelandet har gått ut. Kontrollera chatten på iPhone."}}}},
    "This Watch message is too large. Shorten it and try again.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This Watch message is too large. Shorten it and try again."}},"zh-CN":{"stringUnit":{"state":"translated","value":"这条 Watch 消息过大。 请缩短内容后重试。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"這則 Watch 訊息太大。 請縮短內容後再試一次。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Esta mensagem do Watch é muito grande. Encurte-a e tente novamente."}},"de":{"stringUnit":{"state":"translated","value":"Diese Watch-Nachricht ist zu groß. Kürze sie und versuche es erneut."}},"es":{"stringUnit":{"state":"translated","value":"Este mensaje de Watch es demasiado grande. Acórtalo e inténtalo de nuevo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このWatchメッセージは大きすぎます。短くしてからもう一度お試しください。"}},"ko":{"stringUnit":{"state":"translated","value":"이 Watch 메시지는 너무 큽니다. 내용을 줄이고 다시 시도하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Ce message Watch est trop volumineux. Raccourcissez-le et réessayez."}},"hi":{"stringUnit":{"state":"translated","value":"यह Watch संदेश बहुत बड़ा है. इसे छोटा करें और फिर से कोशिश करें."}},"ar":{"stringUnit":{"state":"translated","value":"رسالة Watch هذه كبيرة جدًا. اختصرها وحاول مرة أخرى."}},"it":{"stringUnit":{"state":"translated","value":"Questo messaggio di Watch è troppo grande. Accorcialo e riprova."}},"tr":{"stringUnit":{"state":"translated","value":"Bu Watch mesajı çok büyük. Kısaltıp tekrar deneyin."}},"uk":{"stringUnit":{"state":"translated","value":"Це повідомлення з Watch завелике. Скоротіть його та спробуйте ще раз."}},"id":{"stringUnit":{"state":"translated","value":"Pesan Watch ini terlalu besar. Persingkat dan coba lagi."}},"pl":{"stringUnit":{"state":"translated","value":"Ta wiadomość z zegarka Watch jest zbyt duża. Skróć ją i spróbuj ponownie."}},"th":{"stringUnit":{"state":"translated","value":"ข้อความจาก Watch นี้มีขนาดใหญ่เกินไป. ย่อข้อความแล้วลองอีกครั้ง."}},"vi":{"stringUnit":{"state":"translated","value":"Tin nhắn Watch này quá lớn. Hãy rút ngắn rồi thử lại."}},"nl":{"stringUnit":{"state":"translated","value":"Dit Watch-bericht is te groot. Kort het in en probeer het opnieuw."}},"fa":{"stringUnit":{"state":"translated","value":"این پیام Watch بیش از حد بزرگ است. آن را کوتاه کنید و دوباره تلاش کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Это сообщение с Watch слишком большое. Сократите его и повторите попытку."}},"sv":{"stringUnit":{"state":"translated","value":"Det här Watch-meddelandet är för stort. Korta ner det och försök igen."}}}},
    "This Watch message no longer matches its saved delivery owner.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This Watch message no longer matches its saved delivery owner."}},"zh-CN":{"stringUnit":{"state":"translated","value":"这条 Watch 消息不再与其保存的投递归属者匹配。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"這則 Watch 訊息已不再符合其儲存的傳遞擁有者。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Esta mensagem do Watch não corresponde mais ao responsável pela entrega salvo."}},"de":{"stringUnit":{"state":"translated","value":"Diese Watch-Nachricht stimmt nicht mehr mit ihrem gespeicherten Zustellungsverantwortlichen überein."}},"es":{"stringUnit":{"state":"translated","value":"Este mensaje de Watch ya no coincide con su propietario de entrega guardado."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このWatchメッセージは、保存された配信所有者と一致しなくなりました。"}},"ko":{"stringUnit":{"state":"translated","value":"이 Watch 메시지는 저장된 전송 소유자와 더 이상 일치하지 않습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Ce message Watch ne correspond plus à son propriétaire de livraison enregistré."}},"hi":{"stringUnit":{"state":"translated","value":"यह Watch संदेश अब अपने सहेजे गए डिलीवरी स्वामी से मेल नहीं खाता."}},"ar":{"stringUnit":{"state":"translated","value":"لم تعد رسالة Watch هذه تطابق مالك التسليم المحفوظ لها."}},"it":{"stringUnit":{"state":"translated","value":"Questo messaggio di Watch non corrisponde più al titolare della consegna salvato."}},"tr":{"stringUnit":{"state":"translated","value":"Bu Watch mesajı artık kayıtlı teslimat sahibiyle eşleşmiyor."}},"uk":{"stringUnit":{"state":"translated","value":"Це повідомлення з Watch більше не відповідає збереженому власнику доставки."}},"id":{"stringUnit":{"state":"translated","value":"Pesan Watch ini tidak lagi cocok dengan pemilik pengiriman yang tersimpan."}},"pl":{"stringUnit":{"state":"translated","value":"Ta wiadomość z zegarka Watch nie odpowiada już zapisanemu właścicielowi dostarczania."}},"th":{"stringUnit":{"state":"translated","value":"ข้อความจาก Watch นี้ไม่ตรงกับเจ้าของการจัดส่งที่บันทึกไว้อีกต่อไป."}},"vi":{"stringUnit":{"state":"translated","value":"Tin nhắn Watch này không còn khớp với chủ thể gửi đã lưu."}},"nl":{"stringUnit":{"state":"translated","value":"Dit Watch-bericht komt niet meer overeen met de opgeslagen bezorgingseigenaar."}},"fa":{"stringUnit":{"state":"translated","value":"این پیام Watch دیگر با مالک ذخیره‌شدهٔ تحویل آن مطابقت ندارد."}},"ru":{"stringUnit":{"state":"translated","value":"Это сообщение с Watch больше не соответствует сохранённому владельцу доставки."}},"sv":{"stringUnit":{"state":"translated","value":"Det här Watch-meddelandet matchar inte längre sin sparade leveransägare."}}}},
    "This approval was already": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This approval was already"}},"zh-CN":{"stringUnit":{"state":"translated","value":"此审批已经"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此核准已經"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Esta aprovação já foi"}},"de":{"stringUnit":{"state":"translated","value":"Diese Genehmigung wurde bereits"}},"es":{"stringUnit":{"state":"translated","value":"Esta aprobación ya estaba"}},"ja-JP":{"stringUnit":{"state":"translated","value":"この承認はすでに"}},"ko":{"stringUnit":{"state":"translated","value":"이 승인은 이미"}},"fr":{"stringUnit":{"state":"translated","value":"Cette approbation était déjà"}},"hi":{"stringUnit":{"state":"translated","value":"यह स्वीकृति पहले ही"}},"ar":{"stringUnit":{"state":"translated","value":"سبق أن كانت هذه الموافقة"}},"it":{"stringUnit":{"state":"translated","value":"Questa approvazione era già"}},"tr":{"stringUnit":{"state":"translated","value":"Bu onay zaten"}},"uk":{"stringUnit":{"state":"translated","value":"Цей запит на схвалення вже було"}},"id":{"stringUnit":{"state":"translated","value":"Persetujuan ini sudah"}},"pl":{"stringUnit":{"state":"translated","value":"To zatwierdzenie zostało już"}},"th":{"stringUnit":{"state":"translated","value":"การอนุมัตินี้ได้รับการดำเนินการแล้ว"}},"vi":{"stringUnit":{"state":"translated","value":"Yêu cầu phê duyệt này đã được"}},"nl":{"stringUnit":{"state":"translated","value":"Deze goedkeuring was al"}},"fa":{"stringUnit":{"state":"translated","value":"این تأیید قبلاً"}},"ru":{"stringUnit":{"state":"translated","value":"Это одобрение уже было"}},"sv":{"stringUnit":{"state":"translated","value":"Det här godkännandet var redan"}}}},
    "This approval was already set to Always Allow.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This approval was already set to Always Allow."}},"zh-CN":{"stringUnit":{"state":"translated","value":"此审批已设为始终允许。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此核准已設為一律允許。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Esta aprovação já foi definida como Permitir Sempre."}},"de":{"stringUnit":{"state":"translated","value":"Diese Genehmigung wurde bereits auf Immer erlauben gesetzt."}},"es":{"stringUnit":{"state":"translated","value":"Esta aprobación ya estaba configurada como Permitir siempre."}},"ja-JP":{"stringUnit":{"state":"translated","value":"この承認はすでに「常に許可」に設定されています。"}},"ko":{"stringUnit":{"state":"translated","value":"이 승인은 이미 항상 허용으로 설정되었습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Cette approbation était déjà définie sur Toujours autoriser."}},"hi":{"stringUnit":{"state":"translated","value":"यह स्वीकृति पहले ही हमेशा अनुमति दें पर सेट की जा चुकी है."}},"ar":{"stringUnit":{"state":"translated","value":"سبق ضبط هذه الموافقة على السماح دائمًا."}},"it":{"stringUnit":{"state":"translated","value":"Questa approvazione era già impostata su Consenti sempre."}},"tr":{"stringUnit":{"state":"translated","value":"Bu onay zaten Her Zaman İzin Ver olarak ayarlanmış."}},"uk":{"stringUnit":{"state":"translated","value":"Для цього запиту на схвалення вже встановлено «Завжди дозволяти»."}},"id":{"stringUnit":{"state":"translated","value":"Persetujuan ini sudah diatur ke Selalu Izinkan."}},"pl":{"stringUnit":{"state":"translated","value":"Dla tego zatwierdzenia ustawiono już opcję Zawsze zezwalaj."}},"th":{"stringUnit":{"state":"translated","value":"การอนุมัตินี้ถูกตั้งค่าเป็นอนุญาตเสมอแล้ว."}},"vi":{"stringUnit":{"state":"translated","value":"Yêu cầu phê duyệt này đã được đặt thành Luôn cho phép."}},"nl":{"stringUnit":{"state":"translated","value":"Deze goedkeuring was al ingesteld op Altijd Toestaan."}},"fa":{"stringUnit":{"state":"translated","value":"این تأیید قبلاً روی همیشه اجازه داده شود تنظیم شده است."}},"ru":{"stringUnit":{"state":"translated","value":"Для этого одобрения уже установлено значение «Всегда разрешать»."}},"sv":{"stringUnit":{"state":"translated","value":"Det här godkännandet var redan inställt på Tillåt alltid."}}}},
    "This deletes the saved Needs review message from iPhone.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This deletes the saved Needs review message from iPhone."}},"zh-CN":{"stringUnit":{"state":"translated","value":"这将从 iPhone 中删除已保存的待审核消息。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"這會從 iPhone 刪除已儲存的待審查訊息。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Isso exclui do iPhone a mensagem salva com o status Precisa de revisão."}},"de":{"stringUnit":{"state":"translated","value":"Dadurch wird die gespeicherte Nachricht mit dem Status Überprüfung erforderlich vom iPhone gelöscht."}},"es":{"stringUnit":{"state":"translated","value":"Esto elimina del iPhone el mensaje guardado como Necesita revisión."}},"ja-JP":{"stringUnit":{"state":"translated","value":"保存された「要確認」メッセージをiPhoneから削除します。"}},"ko":{"stringUnit":{"state":"translated","value":"iPhone에 저장된 검토 필요 메시지가 삭제됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Cette action supprime de l’iPhone le message enregistré À examiner."}},"hi":{"stringUnit":{"state":"translated","value":"इससे iPhone से सहेजा गया समीक्षा आवश्यक संदेश हट जाता है."}},"ar":{"stringUnit":{"state":"translated","value":"سيؤدي هذا إلى حذف الرسالة المحفوظة التي تحتاج إلى مراجعة من iPhone."}},"it":{"stringUnit":{"state":"translated","value":"Questa operazione elimina da iPhone il messaggio salvato Da rivedere."}},"tr":{"stringUnit":{"state":"translated","value":"Bu işlem, kaydedilmiş İnceleme gerekiyor mesajını iPhone'dan siler."}},"uk":{"stringUnit":{"state":"translated","value":"Це видалить з iPhone збережене повідомлення зі статусом «Потребує перевірки»."}},"id":{"stringUnit":{"state":"translated","value":"Tindakan ini menghapus pesan Perlu ditinjau yang tersimpan dari iPhone."}},"pl":{"stringUnit":{"state":"translated","value":"Spowoduje to usunięcie z iPhone’a zapisanej wiadomości Wymaga sprawdzenia."}},"th":{"stringUnit":{"state":"translated","value":"การดำเนินการนี้จะลบข้อความที่บันทึกไว้ซึ่งต้องตรวจสอบออกจาก iPhone."}},"vi":{"stringUnit":{"state":"translated","value":"Thao tác này xóa tin nhắn Cần xem xét đã lưu khỏi iPhone."}},"nl":{"stringUnit":{"state":"translated","value":"Hiermee verwijder je het opgeslagen bericht met de status Beoordeling nodig van iPhone."}},"fa":{"stringUnit":{"state":"translated","value":"با این کار، پیام ذخیره‌شدهٔ نیازمند بررسی از iPhone حذف می‌شود."}},"ru":{"stringUnit":{"state":"translated","value":"Это удалит с iPhone сохранённое сообщение со статусом «Требует проверки»."}},"sv":{"stringUnit":{"state":"translated","value":"Det här raderar det sparade meddelandet Behöver granskas från iPhone."}}}},
    "This device does not trust the TLS certificate presented by %@.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This device does not trust the TLS certificate presented by %@."}},"zh-CN":{"stringUnit":{"state":"translated","value":"此设备不信任 %@ 提供的 TLS 证书。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此裝置不信任 %@ 提供的 TLS 憑證。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Este dispositivo não confia no certificado TLS apresentado por %@."}},"de":{"stringUnit":{"state":"translated","value":"Dieses Gerät vertraut dem von %@ bereitgestellten TLS-Zertifikat nicht."}},"es":{"stringUnit":{"state":"translated","value":"Este dispositivo no confía en el certificado TLS presentado por %@."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このデバイスは、%@が提示したTLS証明書を信頼していません。"}},"ko":{"stringUnit":{"state":"translated","value":"이 기기는 %@에서 제시한 TLS 인증서를 신뢰하지 않습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Cet appareil ne fait pas confiance au certificat TLS présenté par %@."}},"hi":{"stringUnit":{"state":"translated","value":"यह डिवाइस %@ द्वारा प्रस्तुत TLS प्रमाणपत्र पर भरोसा नहीं करता."}},"ar":{"stringUnit":{"state":"translated","value":"لا يثق هذا الجهاز بشهادة TLS التي يقدمها %@."}},"it":{"stringUnit":{"state":"translated","value":"Questo dispositivo non considera attendibile il certificato TLS presentato da %@."}},"tr":{"stringUnit":{"state":"translated","value":"Bu aygıt, %@ tarafından sunulan TLS sertifikasına güvenmiyor."}},"uk":{"stringUnit":{"state":"translated","value":"Цей пристрій не довіряє сертифікату TLS, наданому %@."}},"id":{"stringUnit":{"state":"translated","value":"Perangkat ini tidak memercayai sertifikat TLS yang disajikan oleh %@."}},"pl":{"stringUnit":{"state":"translated","value":"To urządzenie nie ufa certyfikatowi TLS przedstawionemu przez %@."}},"th":{"stringUnit":{"state":"translated","value":"อุปกรณ์นี้ไม่เชื่อถือใบรับรอง TLS ที่แสดงโดย %@."}},"vi":{"stringUnit":{"state":"translated","value":"Thiết bị này không tin cậy chứng chỉ TLS do %@ cung cấp."}},"nl":{"stringUnit":{"state":"translated","value":"Dit apparaat vertrouwt het TLS-certificaat dat door %@ wordt aangeboden niet."}},"fa":{"stringUnit":{"state":"translated","value":"این دستگاه به گواهی TLS ارائه‌شده توسط %@ اعتماد ندارد."}},"ru":{"stringUnit":{"state":"translated","value":"Это устройство не доверяет TLS-сертификату, предоставленному %@."}},"sv":{"stringUnit":{"state":"translated","value":"Den här enheten litar inte på TLS-certifikatet som presenteras av %@."}}}},
    "This disconnects, clears saved gateway credentials, and reopens onboarding.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This disconnects, clears saved gateway credentials, and reopens onboarding."}},"zh-CN":{"stringUnit":{"state":"translated","value":"这将断开连接，清除已保存的 Gateway 凭据，并重新打开初始设置流程。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"這會中斷連線、清除已儲存的 Gateway 憑證，並重新開啟初始設定流程。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Isso desconecta, apaga as credenciais salvas do Gateway e reabre a configuração inicial."}},"de":{"stringUnit":{"state":"translated","value":"Dadurch wird die Verbindung getrennt, gespeicherte Gateway-Zugangsdaten werden gelöscht und die Ersteinrichtung wird erneut geöffnet."}},"es":{"stringUnit":{"state":"translated","value":"Esto desconecta, borra las credenciales guardadas del Gateway y vuelve a abrir la configuración inicial."}},"ja-JP":{"stringUnit":{"state":"translated","value":"接続を切断し、保存済みのGateway認証情報を消去して、オンボーディングを再開します。"}},"ko":{"stringUnit":{"state":"translated","value":"연결을 끊고, 저장된 Gateway 자격 증명을 지운 다음 온보딩을 다시 엽니다."}},"fr":{"stringUnit":{"state":"translated","value":"Cette action déconnecte, efface les identifiants enregistrés du Gateway et relance la configuration initiale."}},"hi":{"stringUnit":{"state":"translated","value":"इससे कनेक्शन कट जाता है, सहेजे गए Gateway क्रेडेंशियल मिट जाते हैं, और ऑनबोर्डिंग फिर से खुल जाती है."}},"ar":{"stringUnit":{"state":"translated","value":"يؤدي هذا إلى قطع الاتصال، ومسح بيانات اعتماد Gateway المحفوظة، وإعادة فتح الإعداد الأولي."}},"it":{"stringUnit":{"state":"translated","value":"Questa operazione interrompe la connessione, cancella le credenziali salvate del gateway e riapre la configurazione iniziale."}},"tr":{"stringUnit":{"state":"translated","value":"Bu işlem bağlantıyı keser, kayıtlı Gateway kimlik bilgilerini temizler ve ilk kurulum ekranını yeniden açar."}},"uk":{"stringUnit":{"state":"translated","value":"Це розриває з’єднання, видаляє збережені облікові дані Gateway і знову відкриває початкове налаштування."}},"id":{"stringUnit":{"state":"translated","value":"Tindakan ini memutus koneksi, menghapus kredensial Gateway yang tersimpan, dan membuka kembali penyiapan awal."}},"pl":{"stringUnit":{"state":"translated","value":"Spowoduje to rozłączenie, usunięcie zapisanych danych uwierzytelniających bramy i ponowne otwarcie konfiguracji początkowej."}},"th":{"stringUnit":{"state":"translated","value":"การดำเนินการนี้จะตัดการเชื่อมต่อ ล้างข้อมูลรับรอง Gateway ที่บันทึกไว้ และเปิดขั้นตอนการตั้งค่าเริ่มต้นอีกครั้ง."}},"vi":{"stringUnit":{"state":"translated","value":"Thao tác này sẽ ngắt kết nối, xóa thông tin xác thực Gateway đã lưu và mở lại quy trình thiết lập ban đầu."}},"nl":{"stringUnit":{"state":"translated","value":"Hiermee wordt de verbinding verbroken, worden opgeslagen gatewayreferenties gewist en wordt de introductie opnieuw geopend."}},"fa":{"stringUnit":{"state":"translated","value":"این کار اتصال را قطع می‌کند، اطلاعات احراز هویت ذخیره‌شدهٔ Gateway را پاک می‌کند و راه‌اندازی اولیه را دوباره باز می‌کند."}},"ru":{"stringUnit":{"state":"translated","value":"Это отключит соединение, удалит сохранённые учётные данные Gateway и снова откроет первоначальную настройку."}},"sv":{"stringUnit":{"state":"translated","value":"Detta kopplar från, rensar sparade autentiseringsuppgifter för Gateway och öppnar introduktionen igen."}}}},
    "This folder is empty.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This folder is empty."}},"zh-CN":{"stringUnit":{"state":"translated","value":"此文件夹为空。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此資料夾是空的。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Esta pasta está vazia."}},"de":{"stringUnit":{"state":"translated","value":"Dieser Ordner ist leer."}},"es":{"stringUnit":{"state":"translated","value":"Esta carpeta está vacía."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このフォルダは空です。"}},"ko":{"stringUnit":{"state":"translated","value":"이 폴더는 비어 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Ce dossier est vide."}},"hi":{"stringUnit":{"state":"translated","value":"यह फ़ोल्डर खाली है."}},"ar":{"stringUnit":{"state":"translated","value":"هذا المجلد فارغ."}},"it":{"stringUnit":{"state":"translated","value":"Questa cartella è vuota."}},"tr":{"stringUnit":{"state":"translated","value":"Bu klasör boş."}},"uk":{"stringUnit":{"state":"translated","value":"Ця папка порожня."}},"id":{"stringUnit":{"state":"translated","value":"Folder ini kosong."}},"pl":{"stringUnit":{"state":"translated","value":"Ten folder jest pusty."}},"th":{"stringUnit":{"state":"translated","value":"โฟลเดอร์นี้ว่างเปล่า."}},"vi":{"stringUnit":{"state":"translated","value":"Thư mục này trống."}},"nl":{"stringUnit":{"state":"translated","value":"Deze map is leeg."}},"fa":{"stringUnit":{"state":"translated","value":"این پوشه خالی است."}},"ru":{"stringUnit":{"state":"translated","value":"Эта папка пуста."}},"sv":{"stringUnit":{"state":"translated","value":"Den här mappen är tom."}}}},
    "This gateway is on your tailnet. Turn on Tailscale on this device, then tap Connect.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This gateway is on your tailnet. Turn on Tailscale on this device, then tap Connect."}},"zh-CN":{"stringUnit":{"state":"translated","value":"此 Gateway 位于你的 tailnet 中。请在此设备上开启 Tailscale，然后轻点连接。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此 Gateway 位於您的 tailnet 上。請在此裝置上開啟 Tailscale，然後點選「連線」。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Este Gateway está na sua tailnet. Ative o Tailscale neste dispositivo e toque em Conectar."}},"de":{"stringUnit":{"state":"translated","value":"Dieses Gateway befindet sich in Ihrem Tailnet. Aktivieren Sie Tailscale auf diesem Gerät und tippen Sie dann auf Verbinden."}},"es":{"stringUnit":{"state":"translated","value":"Este Gateway está en tu tailnet. Activa Tailscale en este dispositivo y luego toca Conectar."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このGatewayはお使いのtailnet上にあります。このデバイスでTailscaleを有効にしてから、「接続」をタップしてください。"}},"ko":{"stringUnit":{"state":"translated","value":"이 Gateway는 사용자의 tailnet에 있습니다. 이 기기에서 Tailscale을 켠 다음 연결을 탭하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Ce Gateway se trouve sur votre tailnet. Activez Tailscale sur cet appareil, puis appuyez sur Se connecter."}},"hi":{"stringUnit":{"state":"translated","value":"यह Gateway आपके टेलनेट पर है. इस डिवाइस पर Tailscale चालू करें, फिर कनेक्ट करें पर टैप करें."}},"ar":{"stringUnit":{"state":"translated","value":"يوجد Gateway هذا على شبكة tailnet الخاصة بك. شغّل Tailscale على هذا الجهاز، ثم اضغط على اتصال."}},"it":{"stringUnit":{"state":"translated","value":"Questo gateway si trova nella tua tailnet. Attiva Tailscale su questo dispositivo, quindi tocca Connetti."}},"tr":{"stringUnit":{"state":"translated","value":"Bu Gateway, tailnet ağınızda. Bu cihazda Tailscale uygulamasını açın, ardından Bağlan'a dokunun."}},"uk":{"stringUnit":{"state":"translated","value":"Цей Gateway перебуває у вашій мережі tailnet. Увімкніть Tailscale на цьому пристрої, а потім натисніть «Підключитися»."}},"id":{"stringUnit":{"state":"translated","value":"Gateway ini berada di tailnet Anda. Aktifkan Tailscale di perangkat ini, lalu ketuk Hubungkan."}},"pl":{"stringUnit":{"state":"translated","value":"Ta brama znajduje się w Twojej sieci tailnet. Włącz Tailscale na tym urządzeniu, a następnie stuknij Połącz."}},"th":{"stringUnit":{"state":"translated","value":"Gateway นี้อยู่ใน tailnet ของคุณ เปิด Tailscale บนอุปกรณ์นี้ แล้วแตะ เชื่อมต่อ."}},"vi":{"stringUnit":{"state":"translated","value":"Gateway này nằm trong mạng tailnet của bạn. Bật Tailscale trên thiết bị này, rồi nhấn Kết nối."}},"nl":{"stringUnit":{"state":"translated","value":"Deze gateway bevindt zich op je tailnet. Schakel Tailscale in op dit apparaat en tik vervolgens op Verbinden."}},"fa":{"stringUnit":{"state":"translated","value":"این Gateway در شبکهٔ tailnet شما قرار دارد. Tailscale را در این دستگاه روشن کنید، سپس روی اتصال بزنید."}},"ru":{"stringUnit":{"state":"translated","value":"Этот Gateway находится в вашей сети tailnet. Включите Tailscale на этом устройстве, затем нажмите «Подключиться»."}},"sv":{"stringUnit":{"state":"translated","value":"Den här Gateway finns på ditt tailnet. Aktivera Tailscale på den här enheten och tryck sedan på Anslut."}}}},
    "This gateway is unavailable.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This gateway is unavailable."}},"zh-CN":{"stringUnit":{"state":"translated","value":"此 Gateway 不可用。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此 Gateway 無法使用。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Este Gateway está indisponível."}},"de":{"stringUnit":{"state":"translated","value":"Dieses Gateway ist nicht verfügbar."}},"es":{"stringUnit":{"state":"translated","value":"Este Gateway no está disponible."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このGatewayは利用できません。"}},"ko":{"stringUnit":{"state":"translated","value":"이 Gateway를 사용할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Ce Gateway est indisponible."}},"hi":{"stringUnit":{"state":"translated","value":"यह Gateway उपलब्ध नहीं है."}},"ar":{"stringUnit":{"state":"translated","value":"Gateway هذا غير متاح."}},"it":{"stringUnit":{"state":"translated","value":"Questo gateway non è disponibile."}},"tr":{"stringUnit":{"state":"translated","value":"Bu Gateway kullanılamıyor."}},"uk":{"stringUnit":{"state":"translated","value":"Цей Gateway недоступний."}},"id":{"stringUnit":{"state":"translated","value":"Gateway ini tidak tersedia."}},"pl":{"stringUnit":{"state":"translated","value":"Ta brama jest niedostępna."}},"th":{"stringUnit":{"state":"translated","value":"Gateway นี้ไม่พร้อมใช้งาน."}},"vi":{"stringUnit":{"state":"translated","value":"Gateway này không khả dụng."}},"nl":{"stringUnit":{"state":"translated","value":"Deze gateway is niet beschikbaar."}},"fa":{"stringUnit":{"state":"translated","value":"این Gateway در دسترس نیست."}},"ru":{"stringUnit":{"state":"translated","value":"Этот Gateway недоступен."}},"sv":{"stringUnit":{"state":"translated","value":"Den här Gateway är inte tillgänglig."}}}},
    "This message ID already belongs to different or older work. Start a new message.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This message ID already belongs to different or older work. Start a new message."}},"zh-CN":{"stringUnit":{"state":"translated","value":"此消息 ID 已属于其他或较早的任务。请新建一条消息。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此訊息 ID 已屬於其他或較舊的工作。請建立新訊息。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Este ID de mensagem já pertence a um trabalho diferente ou anterior. Inicie uma nova mensagem."}},"de":{"stringUnit":{"state":"translated","value":"Diese Nachrichten-ID gehört bereits zu einem anderen oder älteren Vorgang. Beginnen Sie eine neue Nachricht."}},"es":{"stringUnit":{"state":"translated","value":"Este ID de mensaje ya pertenece a un trabajo diferente o anterior. Inicia un mensaje nuevo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このメッセージIDは、すでに別の作業または以前の作業に属しています。新しいメッセージを開始してください。"}},"ko":{"stringUnit":{"state":"translated","value":"이 메시지 ID는 이미 다른 작업이나 이전 작업에 속해 있습니다. 새 메시지를 시작하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Cet identifiant de message appartient déjà à une tâche différente ou antérieure. Créez un nouveau message."}},"hi":{"stringUnit":{"state":"translated","value":"यह संदेश ID पहले से किसी दूसरे या पुराने कार्य से जुड़ी है. नया संदेश शुरू करें."}},"ar":{"stringUnit":{"state":"translated","value":"معرّف الرسالة هذا مرتبط بالفعل بعمل آخر أو أقدم. ابدأ رسالة جديدة."}},"it":{"stringUnit":{"state":"translated","value":"Questo ID messaggio appartiene già a un'attività diversa o precedente. Inizia un nuovo messaggio."}},"tr":{"stringUnit":{"state":"translated","value":"Bu mesaj kimliği zaten farklı veya daha eski bir işe ait. Yeni bir mesaj başlatın."}},"uk":{"stringUnit":{"state":"translated","value":"Цей ідентифікатор повідомлення вже належить іншому або попередньому завданню. Створіть нове повідомлення."}},"id":{"stringUnit":{"state":"translated","value":"ID pesan ini sudah digunakan untuk pekerjaan lain atau yang lebih lama. Mulai pesan baru."}},"pl":{"stringUnit":{"state":"translated","value":"Ten identyfikator wiadomości należy już do innego lub wcześniejszego zadania. Rozpocznij nową wiadomość."}},"th":{"stringUnit":{"state":"translated","value":"รหัสข้อความนี้เป็นของงานอื่นหรืองานก่อนหน้าแล้ว โปรดเริ่มข้อความใหม่."}},"vi":{"stringUnit":{"state":"translated","value":"ID tin nhắn này đã thuộc về công việc khác hoặc cũ hơn. Hãy bắt đầu một tin nhắn mới."}},"nl":{"stringUnit":{"state":"translated","value":"Deze bericht-ID hoort al bij ander of ouder werk. Begin een nieuw bericht."}},"fa":{"stringUnit":{"state":"translated","value":"این شناسهٔ پیام از قبل به کاری دیگر یا قدیمی‌تر تعلق دارد. پیام جدیدی شروع کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Этот идентификатор сообщения уже относится к другой или более ранней задаче. Создайте новое сообщение."}},"sv":{"stringUnit":{"state":"translated","value":"Det här meddelande-ID:t tillhör redan ett annat eller äldre arbete. Starta ett nytt meddelande."}}}},
    "This paired gateway has an invalid saved endpoint.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This paired gateway has an invalid saved endpoint."}},"zh-CN":{"stringUnit":{"state":"translated","value":"为此已配对的 Gateway 保存的端点无效。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此已配對 Gateway 儲存的端點無效。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Este Gateway pareado tem um endpoint salvo inválido."}},"de":{"stringUnit":{"state":"translated","value":"Dieses gekoppelte Gateway hat einen ungültigen gespeicherten Endpunkt."}},"es":{"stringUnit":{"state":"translated","value":"Este Gateway vinculado tiene un endpoint guardado no válido."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このペアリング済みGatewayの保存済みエンドポイントは無効です。"}},"ko":{"stringUnit":{"state":"translated","value":"이 페어링된 Gateway에 저장된 엔드포인트가 유효하지 않습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le point de terminaison enregistré pour ce Gateway associé est invalide."}},"hi":{"stringUnit":{"state":"translated","value":"इस पेयर किए गए Gateway का सहेजा गया एंडपॉइंट अमान्य है."}},"ar":{"stringUnit":{"state":"translated","value":"عنوان نقطة النهاية المحفوظ لـ Gateway المقترن هذا غير صالح."}},"it":{"stringUnit":{"state":"translated","value":"Questo gateway abbinato ha un endpoint salvato non valido."}},"tr":{"stringUnit":{"state":"translated","value":"Bu eşleştirilmiş Gateway için kayıtlı uç nokta geçersiz."}},"uk":{"stringUnit":{"state":"translated","value":"Цей сполучений Gateway має недійсну збережену кінцеву точку."}},"id":{"stringUnit":{"state":"translated","value":"Gateway yang dipasangkan ini memiliki endpoint tersimpan yang tidak valid."}},"pl":{"stringUnit":{"state":"translated","value":"Ta sparowana brama ma nieprawidłowy zapisany punkt końcowy."}},"th":{"stringUnit":{"state":"translated","value":"Gateway ที่จับคู่นี้มีปลายทางที่บันทึกไว้ไม่ถูกต้อง."}},"vi":{"stringUnit":{"state":"translated","value":"Gateway đã ghép đôi này có điểm cuối đã lưu không hợp lệ."}},"nl":{"stringUnit":{"state":"translated","value":"Deze gekoppelde gateway heeft een ongeldig opgeslagen eindpunt."}},"fa":{"stringUnit":{"state":"translated","value":"نشانی نقطهٔ پایانی ذخیره‌شده برای این Gateway جفت‌شده نامعتبر است."}},"ru":{"stringUnit":{"state":"translated","value":"У этого сопряжённого Gateway сохранён некорректный адрес подключения."}},"sv":{"stringUnit":{"state":"translated","value":"Den här parkopplade Gateway har en ogiltig sparad slutpunkt."}}}},
    "This paired gateway is no longer available.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This paired gateway is no longer available."}},"zh-CN":{"stringUnit":{"state":"translated","value":"此已配对的 Gateway 已不再可用。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此已配對的 Gateway 已無法使用。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Este Gateway pareado não está mais disponível."}},"de":{"stringUnit":{"state":"translated","value":"Dieses gekoppelte Gateway ist nicht mehr verfügbar."}},"es":{"stringUnit":{"state":"translated","value":"Este Gateway vinculado ya no está disponible."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このペアリング済みGatewayは利用できなくなりました。"}},"ko":{"stringUnit":{"state":"translated","value":"이 페어링된 Gateway는 더 이상 사용할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Ce Gateway associé n’est plus disponible."}},"hi":{"stringUnit":{"state":"translated","value":"यह पेयर किया गया Gateway अब उपलब्ध नहीं है."}},"ar":{"stringUnit":{"state":"translated","value":"لم يعد Gateway المقترن هذا متاحاً."}},"it":{"stringUnit":{"state":"translated","value":"Questo gateway abbinato non è più disponibile."}},"tr":{"stringUnit":{"state":"translated","value":"Bu eşleştirilmiş Gateway artık kullanılamıyor."}},"uk":{"stringUnit":{"state":"translated","value":"Цей сполучений Gateway більше недоступний."}},"id":{"stringUnit":{"state":"translated","value":"Gateway yang dipasangkan ini tidak lagi tersedia."}},"pl":{"stringUnit":{"state":"translated","value":"Ta sparowana brama nie jest już dostępna."}},"th":{"stringUnit":{"state":"translated","value":"Gateway ที่จับคู่นี้ไม่พร้อมใช้งานอีกต่อไป."}},"vi":{"stringUnit":{"state":"translated","value":"Gateway đã ghép đôi này không còn khả dụng."}},"nl":{"stringUnit":{"state":"translated","value":"Deze gekoppelde gateway is niet meer beschikbaar."}},"fa":{"stringUnit":{"state":"translated","value":"این Gateway جفت‌شده دیگر در دسترس نیست."}},"ru":{"stringUnit":{"state":"translated","value":"Этот сопряжённый Gateway больше недоступен."}},"sv":{"stringUnit":{"state":"translated","value":"Den här parkopplade Gateway är inte längre tillgänglig."}}}},
    "This permanently deletes the session and its transcript.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This permanently deletes the session and its transcript."}},"zh-CN":{"stringUnit":{"state":"translated","value":"这将永久删除此会话及其对话记录。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"這會永久刪除工作階段及其對話記錄。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Isso exclui permanentemente a sessão e sua transcrição."}},"de":{"stringUnit":{"state":"translated","value":"Dadurch werden die Sitzung und ihr Transkript dauerhaft gelöscht."}},"es":{"stringUnit":{"state":"translated","value":"Esto elimina permanentemente la sesión y su transcripción."}},"ja-JP":{"stringUnit":{"state":"translated","value":"セッションとその会話履歴を完全に削除します。"}},"ko":{"stringUnit":{"state":"translated","value":"세션과 해당 대화 기록이 영구적으로 삭제됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Cette action supprime définitivement la session et sa transcription."}},"hi":{"stringUnit":{"state":"translated","value":"इससे सत्र और उसका प्रतिलेख स्थायी रूप से मिट जाते हैं."}},"ar":{"stringUnit":{"state":"translated","value":"يؤدي هذا إلى حذف الجلسة وسجل محادثتها نهائياً."}},"it":{"stringUnit":{"state":"translated","value":"Questa operazione elimina definitivamente la sessione e la relativa trascrizione."}},"tr":{"stringUnit":{"state":"translated","value":"Bu işlem oturumu ve konuşma dökümünü kalıcı olarak siler."}},"uk":{"stringUnit":{"state":"translated","value":"Це назавжди видаляє сеанс і його стенограму."}},"id":{"stringUnit":{"state":"translated","value":"Tindakan ini menghapus sesi beserta transkripnya secara permanen."}},"pl":{"stringUnit":{"state":"translated","value":"Spowoduje to trwałe usunięcie sesji i jej transkrypcji."}},"th":{"stringUnit":{"state":"translated","value":"การดำเนินการนี้จะลบเซสชันและบันทึกการสนทนาของเซสชันนั้นอย่างถาวร."}},"vi":{"stringUnit":{"state":"translated","value":"Thao tác này sẽ xóa vĩnh viễn phiên và bản ghi hội thoại của phiên đó."}},"nl":{"stringUnit":{"state":"translated","value":"Hiermee worden de sessie en het bijbehorende transcript definitief verwijderd."}},"fa":{"stringUnit":{"state":"translated","value":"این کار جلسه و متن گفت‌وگوی آن را برای همیشه حذف می‌کند."}},"ru":{"stringUnit":{"state":"translated","value":"Это навсегда удалит сеанс и его историю переписки."}},"sv":{"stringUnit":{"state":"translated","value":"Detta raderar sessionen och dess konversationshistorik permanent."}}}},
    "This phone has limited Gateway access.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This phone has limited Gateway access."}},"zh-CN":{"stringUnit":{"state":"translated","value":"此手机对 Gateway 的访问受限。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"這支手機的 Gateway 存取權限有限。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Este telefone tem acesso limitado ao Gateway."}},"de":{"stringUnit":{"state":"translated","value":"Dieses Telefon hat eingeschränkten Gateway-Zugriff."}},"es":{"stringUnit":{"state":"translated","value":"Este teléfono tiene acceso limitado a Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このスマートフォンからのGatewayへのアクセスは制限されています。"}},"ko":{"stringUnit":{"state":"translated","value":"이 휴대폰은 Gateway 접근이 제한되어 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Ce téléphone dispose d’un accès limité au Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"इस फ़ोन पर Gateway का एक्सेस सीमित है।"}},"ar":{"stringUnit":{"state":"translated","value":"يتمتع هذا الهاتف بوصول محدود إلى Gateway."}},"it":{"stringUnit":{"state":"translated","value":"Questo telefono ha accesso limitato al Gateway."}},"tr":{"stringUnit":{"state":"translated","value":"Bu telefonun Gateway erişimi sınırlı."}},"uk":{"stringUnit":{"state":"translated","value":"Цей телефон має обмежений доступ до Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Ponsel ini memiliki akses Gateway yang terbatas."}},"pl":{"stringUnit":{"state":"translated","value":"Ten telefon ma ograniczony dostęp do Gateway."}},"th":{"stringUnit":{"state":"translated","value":"โทรศัพท์เครื่องนี้มีสิทธิ์เข้าถึง Gateway แบบจำกัด."}},"vi":{"stringUnit":{"state":"translated","value":"Điện thoại này có quyền truy cập Gateway hạn chế."}},"nl":{"stringUnit":{"state":"translated","value":"Deze telefoon heeft beperkte toegang tot de Gateway."}},"fa":{"stringUnit":{"state":"translated","value":"این تلفن دسترسی محدودی به Gateway دارد."}},"ru":{"stringUnit":{"state":"translated","value":"У этого телефона ограниченный доступ к Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Den här telefonen har begränsad åtkomst till Gateway."}}}},
    "This removes saved credentials, device access, TLS trust, and cached chats for this gateway.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This removes saved credentials, device access, TLS trust, and cached chats for this gateway."}},"zh-CN":{"stringUnit":{"state":"translated","value":"这将移除此网关已保存的凭据、设备访问权限、TLS 信任和缓存的聊天记录。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"這會移除此 Gateway 已儲存的憑證、裝置存取權限、TLS 信任設定及快取的聊天記錄。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Isso remove as credenciais salvas, o acesso do dispositivo, a confiança TLS e as conversas em cache deste gateway."}},"de":{"stringUnit":{"state":"translated","value":"Dadurch werden gespeicherte Anmeldedaten, Gerätezugriff, TLS-Vertrauen und zwischengespeicherte Chats für dieses Gateway entfernt."}},"es":{"stringUnit":{"state":"translated","value":"Esto elimina las credenciales guardadas, el acceso del dispositivo, la confianza TLS y los chats en caché de este gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このゲートウェイの保存済み認証情報、デバイスアクセス、TLSの信頼設定、キャッシュされたチャットが削除されます。"}},"ko":{"stringUnit":{"state":"translated","value":"이 Gateway에 저장된 자격 증명, 기기 접근 권한, TLS 신뢰 정보 및 캐시된 채팅이 삭제됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Cette action supprime les identifiants enregistrés, l’accès de l’appareil, la confiance TLS et les conversations en cache pour cette passerelle."}},"hi":{"stringUnit":{"state":"translated","value":"इससे इस Gateway के सहेजे गए क्रेडेंशियल, डिवाइस एक्सेस, TLS ट्रस्ट और कैश की गई चैट हट जाएँगी।"}},"ar":{"stringUnit":{"state":"translated","value":"سيؤدي هذا إلى إزالة بيانات الاعتماد المحفوظة، ووصول الجهاز، وثقة TLS، والمحادثات المخزنة مؤقتًا لهذه البوابة."}},"it":{"stringUnit":{"state":"translated","value":"Questa operazione rimuove le credenziali salvate, l'accesso al dispositivo, l'attendibilità TLS e le chat memorizzate nella cache per questo gateway."}},"tr":{"stringUnit":{"state":"translated","value":"Bu, bu ağ geçidi için kaydedilmiş kimlik bilgilerini, cihaz erişimini, TLS güvenini ve önbelleğe alınmış sohbetleri kaldırır."}},"uk":{"stringUnit":{"state":"translated","value":"Це видалить збережені облікові дані, доступ пристрою, довіру TLS і кешовані чати для цього шлюзу."}},"id":{"stringUnit":{"state":"translated","value":"Ini menghapus kredensial tersimpan, akses perangkat, kepercayaan TLS, dan cache percakapan untuk gateway ini."}},"pl":{"stringUnit":{"state":"translated","value":"Spowoduje to usunięcie zapisanych danych uwierzytelniających, dostępu urządzenia, zaufania TLS i czatów z pamięci podręcznej dla tej bramy."}},"th":{"stringUnit":{"state":"translated","value":"การดำเนินการนี้จะลบข้อมูลรับรองที่บันทึกไว้ สิทธิ์การเข้าถึงของอุปกรณ์ ความเชื่อถือ TLS และแชทที่แคชไว้สำหรับเกตเวย์นี้."}},"vi":{"stringUnit":{"state":"translated","value":"Thao tác này xóa thông tin xác thực đã lưu, quyền truy cập thiết bị, độ tin cậy TLS và các cuộc trò chuyện được lưu trong bộ nhớ đệm cho gateway này."}},"nl":{"stringUnit":{"state":"translated","value":"Dit verwijdert opgeslagen inloggegevens, apparaattoegang, TLS-vertrouwen en gecachte chats voor deze gateway."}},"fa":{"stringUnit":{"state":"translated","value":"این کار اطلاعات احراز هویت ذخیره‌شده، دسترسی دستگاه، اعتماد TLS و گفتگوهای ذخیره‌شده در حافظهٔ نهان را برای این دروازه حذف می‌کند."}},"ru":{"stringUnit":{"state":"translated","value":"Это удалит сохранённые учётные данные, доступ устройства, доверие TLS и кэшированные чаты для этого шлюза."}},"sv":{"stringUnit":{"state":"translated","value":"Detta tar bort sparade inloggningsuppgifter, enhetsåtkomst, TLS-tillit och cachade chattar för denna gateway."}}}},
    "This resets the conversation for %@. The session key stays the same.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This resets the conversation for %@. The session key stays the same."}},"zh-CN":{"stringUnit":{"state":"translated","value":"这将重置 %@ 的对话。 会话密钥保持不变。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"這會重設 %@ 的對話。 工作階段金鑰保持不變。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Isso reinicia a conversa de %@. A chave da sessão permanece a mesma."}},"de":{"stringUnit":{"state":"translated","value":"Dadurch wird die Unterhaltung für %@ zurückgesetzt. Der Sitzungsschlüssel bleibt unverändert."}},"es":{"stringUnit":{"state":"translated","value":"Esto restablece la conversación de %@. La clave de sesión sigue siendo la misma."}},"ja-JP":{"stringUnit":{"state":"translated","value":"%@の会話がリセットされます。セッションキーは変わりません。"}},"ko":{"stringUnit":{"state":"translated","value":"%@의 대화가 초기화됩니다. 세션 키는 그대로 유지됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Cette action réinitialise la conversation pour %@. La clé de session reste identique."}},"hi":{"stringUnit":{"state":"translated","value":"इससे %@ की बातचीत रीसेट हो जाएगी। सत्र कुंजी वही रहेगी।"}},"ar":{"stringUnit":{"state":"translated","value":"سيؤدي هذا إلى إعادة تعيين المحادثة لـ %@. سيبقى مفتاح الجلسة كما هو."}},"it":{"stringUnit":{"state":"translated","value":"Questa operazione reimposta la conversazione per %@. La chiave di sessione rimane la stessa."}},"tr":{"stringUnit":{"state":"translated","value":"Bu, %@ için konuşmayı sıfırlar. Oturum anahtarı aynı kalır."}},"uk":{"stringUnit":{"state":"translated","value":"Це скине розмову для %@. Ключ сеансу залишиться незмінним."}},"id":{"stringUnit":{"state":"translated","value":"Ini mengatur ulang percakapan untuk %@. Kunci sesi tetap sama."}},"pl":{"stringUnit":{"state":"translated","value":"Spowoduje to zresetowanie rozmowy dla %@. Klucz sesji pozostanie bez zmian."}},"th":{"stringUnit":{"state":"translated","value":"การดำเนินการนี้จะรีเซ็ตการสนทนาสำหรับ %@. คีย์เซสชันจะยังคงเดิม."}},"vi":{"stringUnit":{"state":"translated","value":"Thao tác này đặt lại cuộc trò chuyện cho %@. Khóa phiên vẫn giữ nguyên."}},"nl":{"stringUnit":{"state":"translated","value":"Dit stelt het gesprek voor %@ opnieuw in. De sessiesleutel blijft hetzelfde."}},"fa":{"stringUnit":{"state":"translated","value":"این کار گفتگوی %@ را بازنشانی می‌کند. کلید نشست بدون تغییر می‌ماند."}},"ru":{"stringUnit":{"state":"translated","value":"Это сбросит переписку для %@. Ключ сеанса останется прежним."}},"sv":{"stringUnit":{"state":"translated","value":"Detta återställer konversationen för %@. Sessionsnyckeln förblir densamma."}}}},
    "This thread cannot be archived while it is active or running.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This thread cannot be archived while it is active or running."}},"zh-CN":{"stringUnit":{"state":"translated","value":"此对话处于活跃或运行状态时无法归档。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此討論串仍在活動或執行中，無法封存。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Esta conversa não pode ser arquivada enquanto estiver ativa ou em execução."}},"de":{"stringUnit":{"state":"translated","value":"Dieser Thread kann nicht archiviert werden, solange er aktiv ist oder ausgeführt wird."}},"es":{"stringUnit":{"state":"translated","value":"Este hilo no se puede archivar mientras esté activo o en ejecución."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このスレッドはアクティブまたは実行中のため、アーカイブできません。"}},"ko":{"stringUnit":{"state":"translated","value":"활성 상태이거나 실행 중인 스레드는 보관할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Ce fil ne peut pas être archivé tant qu’il est actif ou en cours d’exécution."}},"hi":{"stringUnit":{"state":"translated","value":"सक्रिय या चल रहे इस थ्रेड को आर्काइव नहीं किया जा सकता।"}},"ar":{"stringUnit":{"state":"translated","value":"لا يمكن أرشفة سلسلة المحادثة هذه أثناء نشاطها أو تشغيلها."}},"it":{"stringUnit":{"state":"translated","value":"Questa conversazione non può essere archiviata mentre è attiva o in esecuzione."}},"tr":{"stringUnit":{"state":"translated","value":"Bu konu etkinken veya çalışırken arşivlenemez."}},"uk":{"stringUnit":{"state":"translated","value":"Цю гілку не можна архівувати, поки вона активна або виконується."}},"id":{"stringUnit":{"state":"translated","value":"Utas ini tidak dapat diarsipkan saat masih aktif atau berjalan."}},"pl":{"stringUnit":{"state":"translated","value":"Nie można zarchiwizować tego wątku, gdy jest aktywny lub uruchomiony."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถเก็บเธรดนี้ถาวรได้ขณะที่ยังทำงานอยู่หรือกำลังประมวลผล"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể lưu trữ luồng này khi luồng đang hoạt động hoặc đang chạy."}},"nl":{"stringUnit":{"state":"translated","value":"Dit gesprek kan niet worden gearchiveerd zolang het actief is of wordt uitgevoerd."}},"fa":{"stringUnit":{"state":"translated","value":"تا زمانی که این رشته‌گفتگو فعال یا در حال اجرا باشد، نمی‌توان آن را بایگانی کرد."}},"ru":{"stringUnit":{"state":"translated","value":"Эту ветку нельзя архивировать, пока она активна или выполняется."}},"sv":{"stringUnit":{"state":"translated","value":"Den här tråden kan inte arkiveras medan den är aktiv eller körs."}}}},
    "This voice service must support ICE-lite with UDP candidates.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This voice service must support ICE-lite with UDP candidates."}},"zh-CN":{"stringUnit":{"state":"translated","value":"此语音服务必须支持使用 UDP 候选的 ICE-lite。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此語音服務必須支援使用 UDP 候選位址的 ICE-lite。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Este serviço de voz deve oferecer suporte a ICE-lite com candidatos UDP."}},"de":{"stringUnit":{"state":"translated","value":"Dieser Sprachdienst muss ICE-lite mit UDP-Kandidaten unterstützen."}},"es":{"stringUnit":{"state":"translated","value":"Este servicio de voz debe admitir ICE-lite con candidatos UDP."}},"ja-JP":{"stringUnit":{"state":"translated","value":"この音声サービスは、UDP候補を使用するICE-liteに対応している必要があります。"}},"ko":{"stringUnit":{"state":"translated","value":"이 음성 서비스는 UDP 후보를 사용하는 ICE-lite를 지원해야 합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Ce service vocal doit prendre en charge ICE-lite avec des candidats UDP."}},"hi":{"stringUnit":{"state":"translated","value":"इस वॉइस सेवा को UDP कैंडिडेट के साथ ICE-lite का समर्थन करना चाहिए।"}},"ar":{"stringUnit":{"state":"translated","value":"يجب أن تدعم هذه الخدمة الصوتية ICE-lite مع مرشّحات UDP."}},"it":{"stringUnit":{"state":"translated","value":"Questo servizio vocale deve supportare ICE-lite con candidati UDP."}},"tr":{"stringUnit":{"state":"translated","value":"Bu ses hizmeti, UDP adaylarıyla ICE-lite desteği sunmalıdır."}},"uk":{"stringUnit":{"state":"translated","value":"Цей голосовий сервіс має підтримувати ICE-lite з UDP-кандидатами."}},"id":{"stringUnit":{"state":"translated","value":"Layanan suara ini harus mendukung ICE-lite dengan kandidat UDP."}},"pl":{"stringUnit":{"state":"translated","value":"Ta usługa głosowa musi obsługiwać ICE-lite z kandydatami UDP."}},"th":{"stringUnit":{"state":"translated","value":"บริการเสียงนี้ต้องรองรับ ICE-lite พร้อมตัวเลือกการเชื่อมต่อ UDP"}},"vi":{"stringUnit":{"state":"translated","value":"Dịch vụ thoại này phải hỗ trợ ICE-lite với các ứng viên UDP."}},"nl":{"stringUnit":{"state":"translated","value":"Deze spraakdienst moet ICE-lite met UDP-kandidaten ondersteunen."}},"fa":{"stringUnit":{"state":"translated","value":"این سرویس صوتی باید از ICE-lite با گزینه‌های اتصال UDP پشتیبانی کند."}},"ru":{"stringUnit":{"state":"translated","value":"Этот сервис голосовой связи должен поддерживать ICE-lite с UDP-кандидатами."}},"sv":{"stringUnit":{"state":"translated","value":"Denna rösttjänst måste stödja ICE-lite med UDP-kandidater."}}}},
