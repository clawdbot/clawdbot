    "Dreaming": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Dreaming"}},"zh-CN":{"stringUnit":{"state":"translated","value":"梦境"}},"zh-TW":{"stringUnit":{"state":"translated","value":"夢境"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Sonhando"}},"de":{"stringUnit":{"state":"translated","value":"Träumen"}},"es":{"stringUnit":{"state":"translated","value":"Soñando"}},"ja-JP":{"stringUnit":{"state":"translated","value":"夢の処理"}},"ko":{"stringUnit":{"state":"translated","value":"꿈꾸기"}},"fr":{"stringUnit":{"state":"translated","value":"Rêve"}},"hi":{"stringUnit":{"state":"translated","value":"स्वप्न प्रक्रिया"}},"ar":{"stringUnit":{"state":"translated","value":"الحلم"}},"it":{"stringUnit":{"state":"translated","value":"Sogno"}},"tr":{"stringUnit":{"state":"translated","value":"Rüya görme"}},"uk":{"stringUnit":{"state":"translated","value":"Сновидіння"}},"id":{"stringUnit":{"state":"translated","value":"Bermimpi"}},"pl":{"stringUnit":{"state":"translated","value":"Śnienie"}},"th":{"stringUnit":{"state":"translated","value":"การฝัน"}},"vi":{"stringUnit":{"state":"translated","value":"Mơ"}},"nl":{"stringUnit":{"state":"translated","value":"Dromen"}},"fa":{"stringUnit":{"state":"translated","value":"رؤیاپردازی"}},"ru":{"stringUnit":{"state":"translated","value":"Сновидения"}},"sv":{"stringUnit":{"state":"translated","value":"Drömmande"}}}},
    "Each selected thread and its transcript will be removed from the gateway.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Each selected thread and its transcript will be removed from the gateway."}},"zh-CN":{"stringUnit":{"state":"translated","value":"每个所选对话及其对话记录都将从 Gateway 中移除。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"每個所選的對話串及其文字記錄都將從 Gateway 移除。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Cada conversa selecionada e sua transcrição serão removidas do Gateway."}},"de":{"stringUnit":{"state":"translated","value":"Jeder ausgewählte Thread und sein Transkript werden vom Gateway entfernt."}},"es":{"stringUnit":{"state":"translated","value":"Cada hilo seleccionado y su transcripción se eliminarán del Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"選択した各スレッドとそのトランスクリプトがGatewayから削除されます。"}},"ko":{"stringUnit":{"state":"translated","value":"선택한 각 스레드와 해당 대화 내용이 Gateway에서 제거됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Chaque conversation sélectionnée et sa transcription seront supprimées du Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"प्रत्येक चयनित थ्रेड और उसकी ट्रांसक्रिप्ट Gateway से हटा दी जाएगी।"}},"ar":{"stringUnit":{"state":"translated","value":"ستتم إزالة كل محادثة محددة وسجلها من Gateway."}},"it":{"stringUnit":{"state":"translated","value":"Ogni conversazione selezionata e la relativa trascrizione verranno rimosse dal Gateway."}},"tr":{"stringUnit":{"state":"translated","value":"Seçilen her konu ve dökümü gateway'den kaldırılacak."}},"uk":{"stringUnit":{"state":"translated","value":"Кожну вибрану гілку та її історію буде видалено з Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Setiap utas yang dipilih beserta transkripnya akan dihapus dari Gateway."}},"pl":{"stringUnit":{"state":"translated","value":"Każdy wybrany wątek i jego transkrypcja zostaną usunięte z Gateway."}},"th":{"stringUnit":{"state":"translated","value":"เธรดที่เลือกแต่ละรายการและบทสนทนาจะถูกลบออกจาก Gateway"}},"vi":{"stringUnit":{"state":"translated","value":"Mỗi luồng được chọn và bản ghi hội thoại của luồng đó sẽ bị xóa khỏi Gateway."}},"nl":{"stringUnit":{"state":"translated","value":"Elke geselecteerde thread en de bijbehorende transcriptie worden van de Gateway verwijderd."}},"fa":{"stringUnit":{"state":"translated","value":"هر رشته‌گفتگوی انتخاب‌شده و متن آن از Gateway حذف خواهد شد."}},"ru":{"stringUnit":{"state":"translated","value":"Все выбранные ветки и их стенограммы будут удалены из Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Varje vald tråd och dess transkription tas bort från Gateway."}}}},
    "Edit Pages": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Edit Pages"}},"zh-CN":{"stringUnit":{"state":"translated","value":"编辑页面"}},"zh-TW":{"stringUnit":{"state":"translated","value":"編輯頁面"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Editar Páginas"}},"de":{"stringUnit":{"state":"translated","value":"Seiten bearbeiten"}},"es":{"stringUnit":{"state":"translated","value":"Editar páginas"}},"ja-JP":{"stringUnit":{"state":"translated","value":"ページを編集"}},"ko":{"stringUnit":{"state":"translated","value":"페이지 편집"}},"fr":{"stringUnit":{"state":"translated","value":"Modifier les pages"}},"hi":{"stringUnit":{"state":"translated","value":"पृष्ठ संपादित करें"}},"ar":{"stringUnit":{"state":"translated","value":"تحرير الصفحات"}},"it":{"stringUnit":{"state":"translated","value":"Modifica pagine"}},"tr":{"stringUnit":{"state":"translated","value":"Sayfaları Düzenle"}},"uk":{"stringUnit":{"state":"translated","value":"Редагувати сторінки"}},"id":{"stringUnit":{"state":"translated","value":"Edit Halaman"}},"pl":{"stringUnit":{"state":"translated","value":"Edytuj strony"}},"th":{"stringUnit":{"state":"translated","value":"แก้ไขหน้า"}},"vi":{"stringUnit":{"state":"translated","value":"Chỉnh sửa trang"}},"nl":{"stringUnit":{"state":"translated","value":"Pagina's bewerken"}},"fa":{"stringUnit":{"state":"translated","value":"ویرایش صفحه‌ها"}},"ru":{"stringUnit":{"state":"translated","value":"Изменить страницы"}},"sv":{"stringUnit":{"state":"translated","value":"Redigera sidor"}}}},
    "Effort": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Effort"}},"zh-CN":{"stringUnit":{"state":"translated","value":"思考强度"}},"zh-TW":{"stringUnit":{"state":"translated","value":"投入程度"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Esforço"}},"de":{"stringUnit":{"state":"translated","value":"Aufwand"}},"es":{"stringUnit":{"state":"translated","value":"Esfuerzo"}},"ja-JP":{"stringUnit":{"state":"translated","value":"思考量"}},"ko":{"stringUnit":{"state":"translated","value":"노력 수준"}},"fr":{"stringUnit":{"state":"new","value":"Effort"}},"hi":{"stringUnit":{"state":"translated","value":"प्रयास"}},"ar":{"stringUnit":{"state":"translated","value":"الجهد"}},"it":{"stringUnit":{"state":"translated","value":"Impegno"}},"tr":{"stringUnit":{"state":"translated","value":"Çaba"}},"uk":{"stringUnit":{"state":"translated","value":"Зусилля"}},"id":{"stringUnit":{"state":"translated","value":"Upaya"}},"pl":{"stringUnit":{"state":"translated","value":"Wysiłek"}},"th":{"stringUnit":{"state":"translated","value":"ความพยายาม"}},"vi":{"stringUnit":{"state":"translated","value":"Mức độ nỗ lực"}},"nl":{"stringUnit":{"state":"translated","value":"Inspanning"}},"fa":{"stringUnit":{"state":"translated","value":"تلاش"}},"ru":{"stringUnit":{"state":"translated","value":"Усилия"}},"sv":{"stringUnit":{"state":"translated","value":"Ansträngning"}}}},
    "Empty": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Empty"}},"zh-CN":{"stringUnit":{"state":"translated","value":"空"}},"zh-TW":{"stringUnit":{"state":"translated","value":"空白"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Vazio"}},"de":{"stringUnit":{"state":"translated","value":"Leer"}},"es":{"stringUnit":{"state":"translated","value":"Vacío"}},"ja-JP":{"stringUnit":{"state":"translated","value":"空"}},"ko":{"stringUnit":{"state":"translated","value":"비어 있음"}},"fr":{"stringUnit":{"state":"translated","value":"Vide"}},"hi":{"stringUnit":{"state":"translated","value":"खाली"}},"ar":{"stringUnit":{"state":"translated","value":"فارغ"}},"it":{"stringUnit":{"state":"translated","value":"Vuoto"}},"tr":{"stringUnit":{"state":"translated","value":"Boş"}},"uk":{"stringUnit":{"state":"translated","value":"Порожньо"}},"id":{"stringUnit":{"state":"translated","value":"Kosong"}},"pl":{"stringUnit":{"state":"translated","value":"Puste"}},"th":{"stringUnit":{"state":"translated","value":"ว่างเปล่า"}},"vi":{"stringUnit":{"state":"translated","value":"Trống"}},"nl":{"stringUnit":{"state":"translated","value":"Leeg"}},"fa":{"stringUnit":{"state":"translated","value":"خالی"}},"ru":{"stringUnit":{"state":"translated","value":"Пусто"}},"sv":{"stringUnit":{"state":"translated","value":"Tom"}}}},
    "Enable Gateway TLS, or enter your Tailscale Serve HTTPS host in Manual Setup. Use Unencrypted only with a trusted private-LAN address.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enable Gateway TLS, or enter your Tailscale Serve HTTPS host in Manual Setup. Use Unencrypted only with a trusted private-LAN address."}},"zh-CN":{"stringUnit":{"state":"translated","value":"启用 Gateway TLS, 或在手动设置中输入你的 Tailscale Serve HTTPS 主机。仅对可信的专用局域网地址使用未加密连接。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"啟用 Gateway TLS, 或在手動設定中輸入您的 Tailscale Serve HTTPS 主機。 僅在使用受信任的私人區域網路位址時選擇不加密。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ative o TLS do Gateway ou insira seu host HTTPS do Tailscale Serve na configuração manual. Use Sem criptografia apenas com um endereço confiável de rede local privada."}},"de":{"stringUnit":{"state":"translated","value":"Aktivieren Sie Gateway-TLS oder geben Sie Ihren Tailscale Serve-HTTPS-Host unter „Manuelle Einrichtung“ ein. Verwenden Sie „Unverschlüsselt“ nur mit einer vertrauenswürdigen privaten LAN-Adresse."}},"es":{"stringUnit":{"state":"translated","value":"Activa TLS en el Gateway, o introduce tu host HTTPS de Tailscale Serve en Configuración manual. Usa Sin cifrar solo con una dirección de LAN privada de confianza."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gateway TLSを有効にするか、手動設定でTailscale ServeのHTTPSホストを入力してください。 暗号化なしの接続は、信頼できるプライベートLANアドレスでのみ使用してください。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway TLS를 활성화하거나 수동 설정에서 Tailscale Serve HTTPS 호스트를 입력하세요. 암호화되지 않은 연결은 신뢰할 수 있는 사설 LAN 주소에서만 사용하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Activez TLS sur le Gateway, ou saisissez votre hôte HTTPS Tailscale Serve dans la configuration manuelle. Utilisez le mode non chiffré uniquement avec une adresse de réseau local privé de confiance."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway TLS सक्षम करें, या मैन्युअल सेटअप में अपना Tailscale Serve HTTPS होस्ट दर्ज करें. अनएन्क्रिप्टेड विकल्प का उपयोग केवल विश्वसनीय निजी-LAN पते के साथ करें."}},"ar":{"stringUnit":{"state":"translated","value":"قم بتمكين TLS على Gateway، أو أدخل مضيف HTTPS الخاص بـ Tailscale Serve في الإعداد اليدوي. استخدم الاتصال غير المشفر فقط مع عنوان موثوق على شبكة محلية خاصة."}},"it":{"stringUnit":{"state":"translated","value":"Abilita TLS sul Gateway, oppure inserisci il tuo host HTTPS di Tailscale Serve in Configurazione manuale. Usa Non crittografato solo con un indirizzo LAN privata attendibile."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway TLS'yi etkinleştirin veya Manuel Kurulum'da Tailscale Serve HTTPS ana makinenizi girin. Şifrelenmemiş seçeneğini yalnızca güvenilir bir özel LAN adresiyle kullanın."}},"uk":{"stringUnit":{"state":"translated","value":"Увімкніть TLS для Gateway або введіть HTTPS-хост Tailscale Serve у ручному налаштуванні. Використовуйте підключення без шифрування лише з довіреною адресою приватної локальної мережі."}},"id":{"stringUnit":{"state":"translated","value":"Aktifkan TLS Gateway, atau masukkan host HTTPS Tailscale Serve Anda di Pengaturan Manual. Gunakan Tanpa Enkripsi hanya dengan alamat LAN pribadi yang tepercaya."}},"pl":{"stringUnit":{"state":"translated","value":"Włącz TLS dla Gateway lub wpisz host HTTPS Tailscale Serve w konfiguracji ręcznej. Używaj opcji Bez szyfrowania tylko z zaufanym adresem w prywatnej sieci LAN."}},"th":{"stringUnit":{"state":"translated","value":"เปิดใช้งาน TLS ของ Gateway หรือป้อนโฮสต์ HTTPS ของ Tailscale Serve ในการตั้งค่าด้วยตนเอง. ใช้แบบไม่เข้ารหัสเฉพาะกับที่อยู่ LAN ส่วนตัวที่เชื่อถือได้เท่านั้น."}},"vi":{"stringUnit":{"state":"translated","value":"Bật TLS cho Gateway, hoặc nhập tên máy chủ HTTPS Tailscale Serve của bạn trong Thiết lập thủ công. Chỉ dùng chế độ Không mã hóa với địa chỉ LAN riêng đáng tin cậy."}},"nl":{"stringUnit":{"state":"translated","value":"Schakel Gateway TLS in, of voer je Tailscale Serve HTTPS-host in bij Handmatige configuratie. Gebruik Onversleuteld alleen met een vertrouwd privé-LAN-adres."}},"fa":{"stringUnit":{"state":"translated","value":"TLS را برای Gateway فعال کنید، یا میزبان HTTPS مربوط به Tailscale Serve خود را در راه‌اندازی دستی وارد کنید. از حالت بدون رمزگذاری فقط با یک آدرس مورد اعتماد در شبکهٔ محلی خصوصی استفاده کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Включите TLS для Gateway или укажите HTTPS-хост Tailscale Serve в разделе «Ручная настройка». Используйте режим «Без шифрования» только с доверенным адресом частной локальной сети."}},"sv":{"stringUnit":{"state":"translated","value":"Aktivera TLS för Gateway, eller ange din HTTPS-värd för Tailscale Serve under Manuell konfiguration. Använd Okrypterat endast med en betrodd adress i ett privat LAN."}}}},
    "Enable Notifications to receive approval alerts while OpenClaw is not open.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enable Notifications to receive approval alerts while OpenClaw is not open."}},"zh-CN":{"stringUnit":{"state":"translated","value":"启用通知，以便在 OpenClaw 未打开时接收审批提醒。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"啟用通知, 即可在 OpenClaw 未開啟時收到核准提醒。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ative as notificações para receber alertas de aprovação enquanto o OpenClaw não estiver aberto."}},"de":{"stringUnit":{"state":"translated","value":"Aktivieren Sie Benachrichtigungen, um Genehmigungshinweise zu erhalten, wenn OpenClaw nicht geöffnet ist."}},"es":{"stringUnit":{"state":"translated","value":"Activa las notificaciones para recibir alertas de aprobación mientras OpenClaw no esté abierto."}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClawを開いていないときに承認アラートを受け取るには、通知を有効にしてください。"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw가 열려 있지 않을 때 승인 알림을 받으려면 알림을 활성화하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Activez les notifications pour recevoir des alertes d’approbation lorsque OpenClaw n’est pas ouvert."}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw खुला न होने पर भी अनुमोदन अलर्ट पाने के लिए सूचनाएँ सक्षम करें."}},"ar":{"stringUnit":{"state":"translated","value":"قم بتمكين الإشعارات لتلقي تنبيهات الموافقة عندما لا يكون OpenClaw مفتوحًا."}},"it":{"stringUnit":{"state":"translated","value":"Abilita le notifiche per ricevere avvisi di approvazione quando OpenClaw non è aperto."}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw açık değilken onay uyarıları almak için Bildirimleri etkinleştirin."}},"uk":{"stringUnit":{"state":"translated","value":"Увімкніть сповіщення, щоб отримувати запити на схвалення, коли OpenClaw не відкрито."}},"id":{"stringUnit":{"state":"translated","value":"Aktifkan Notifikasi untuk menerima peringatan persetujuan saat OpenClaw tidak terbuka."}},"pl":{"stringUnit":{"state":"translated","value":"Włącz powiadomienia, aby otrzymywać prośby o zatwierdzenie, gdy OpenClaw nie jest otwarty."}},"th":{"stringUnit":{"state":"translated","value":"เปิดใช้งานการแจ้งเตือนเพื่อรับการแจ้งเตือนคำขออนุมัติขณะที่ไม่ได้เปิด OpenClaw."}},"vi":{"stringUnit":{"state":"translated","value":"Bật Thông báo để nhận cảnh báo phê duyệt khi OpenClaw không mở."}},"nl":{"stringUnit":{"state":"translated","value":"Schakel meldingen in om goedkeuringsverzoeken te ontvangen wanneer OpenClaw niet geopend is."}},"fa":{"stringUnit":{"state":"translated","value":"اعلان‌ها را فعال کنید تا وقتی OpenClaw باز نیست، هشدارهای تأیید را دریافت کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Включите уведомления, чтобы получать запросы на одобрение, когда OpenClaw не открыт."}},"sv":{"stringUnit":{"state":"translated","value":"Aktivera notiser för att få aviseringar om godkännanden när OpenClaw inte är öppet."}}}},
    "Enable OpenClaw Hosted Push Relay?": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enable OpenClaw Hosted Push Relay?"}},"zh-CN":{"stringUnit":{"state":"translated","value":"启用 OpenClaw 托管推送中继？"}},"zh-TW":{"stringUnit":{"state":"translated","value":"啟用 OpenClaw 託管推播轉送服務？"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ativar o relay de push hospedado pelo OpenClaw?"}},"de":{"stringUnit":{"state":"translated","value":"Von OpenClaw gehostetes Push-Relay aktivieren?"}},"es":{"stringUnit":{"state":"translated","value":"¿Activar el servicio de retransmisión de notificaciones push alojado por OpenClaw?"}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClawがホストするプッシュリレーを有効にしますか？"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw 호스팅 푸시 릴레이를 활성화할까요?"}},"fr":{"stringUnit":{"state":"translated","value":"Activer le relais de notifications push hébergé par OpenClaw?"}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw होस्टेड पुश रिले सक्षम करें?"}},"ar":{"stringUnit":{"state":"translated","value":"تمكين وسيط الإشعارات الفورية المستضاف من OpenClaw?"}},"it":{"stringUnit":{"state":"translated","value":"Abilitare il relay push ospitato di OpenClaw?"}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw Tarafından Barındırılan Anlık Bildirim Aktarıcısı Etkinleştirilsin mi?"}},"uk":{"stringUnit":{"state":"translated","value":"Увімкнути розміщений OpenClaw ретранслятор push-сповіщень?"}},"id":{"stringUnit":{"state":"translated","value":"Aktifkan Relai Push yang Dihosting OpenClaw?"}},"pl":{"stringUnit":{"state":"translated","value":"Włączyć hostowaną usługę przekazywania powiadomień push OpenClaw?"}},"th":{"stringUnit":{"state":"translated","value":"เปิดใช้งานรีเลย์การแจ้งเตือนแบบพุชที่โฮสต์โดย OpenClaw หรือไม่?"}},"vi":{"stringUnit":{"state":"translated","value":"Bật dịch vụ chuyển tiếp thông báo đẩy do OpenClaw lưu trữ?"}},"nl":{"stringUnit":{"state":"translated","value":"Door OpenClaw gehoste pushrelay inschakelen?"}},"fa":{"stringUnit":{"state":"translated","value":"رلهٔ اعلان فشاری میزبانی‌شدهٔ OpenClaw فعال شود؟"}},"ru":{"stringUnit":{"state":"translated","value":"Включить размещённый в OpenClaw ретранслятор push-уведомлений?"}},"sv":{"stringUnit":{"state":"translated","value":"Aktivera OpenClaws värdbaserade pushrelä?"}}}},
    "Enable continuous microphone listening?": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enable continuous microphone listening?"}},"zh-CN":{"stringUnit":{"state":"translated","value":"启用麦克风持续监听吗？"}},"zh-TW":{"stringUnit":{"state":"translated","value":"啟用麥克風持續聆聽？"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ativar a escuta contínua do microfone?"}},"de":{"stringUnit":{"state":"translated","value":"Kontinuierliches Mithören über das Mikrofon aktivieren?"}},"es":{"stringUnit":{"state":"translated","value":"¿Activar la escucha continua del micrófono?"}},"ja-JP":{"stringUnit":{"state":"translated","value":"マイクによる常時リスニングを有効にしますか？"}},"ko":{"stringUnit":{"state":"translated","value":"마이크로 계속 듣기를 활성화하시겠습니까?"}},"fr":{"stringUnit":{"state":"translated","value":"Activer l’écoute continue du microphone ?"}},"hi":{"stringUnit":{"state":"translated","value":"माइक्रोफ़ोन से लगातार सुनना चालू करें?"}},"ar":{"stringUnit":{"state":"translated","value":"هل تريد تفعيل الاستماع المستمر عبر الميكروفون؟"}},"it":{"stringUnit":{"state":"translated","value":"Abilitare l’ascolto continuo del microfono?"}},"tr":{"stringUnit":{"state":"translated","value":"Mikrofonun sürekli dinlemesi etkinleştirilsin mi?"}},"uk":{"stringUnit":{"state":"translated","value":"Увімкнути безперервне прослуховування через мікрофон?"}},"id":{"stringUnit":{"state":"translated","value":"Aktifkan pendengaran mikrofon secara terus-menerus?"}},"pl":{"stringUnit":{"state":"translated","value":"Włączyć ciągłe nasłuchiwanie przez mikrofon?"}},"th":{"stringUnit":{"state":"translated","value":"เปิดใช้งานการฟังผ่านไมโครโฟนอย่างต่อเนื่องหรือไม่?"}},"vi":{"stringUnit":{"state":"translated","value":"Bật chế độ nghe micrô liên tục?"}},"nl":{"stringUnit":{"state":"translated","value":"Continu luisteren via de microfoon inschakelen?"}},"fa":{"stringUnit":{"state":"translated","value":"گوش‌دادن پیوسته از طریق میکروفون فعال شود؟"}},"ru":{"stringUnit":{"state":"translated","value":"Включить постоянное прослушивание микрофона?"}},"sv":{"stringUnit":{"state":"translated","value":"Aktivera kontinuerlig mikrofonavlyssning?"}}}},
    "Enable from iPhone": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enable from iPhone"}},"zh-CN":{"stringUnit":{"state":"translated","value":"从 iPhone 启用"}},"zh-TW":{"stringUnit":{"state":"translated","value":"從 iPhone 啟用"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ativar pelo iPhone"}},"de":{"stringUnit":{"state":"translated","value":"Vom iPhone aus aktivieren"}},"es":{"stringUnit":{"state":"translated","value":"Activar desde el iPhone"}},"ja-JP":{"stringUnit":{"state":"translated","value":"iPhoneから有効にする"}},"ko":{"stringUnit":{"state":"translated","value":"iPhone에서 활성화"}},"fr":{"stringUnit":{"state":"translated","value":"Activer depuis l’iPhone"}},"hi":{"stringUnit":{"state":"translated","value":"iPhone से सक्षम करें"}},"ar":{"stringUnit":{"state":"translated","value":"التمكين من iPhone"}},"it":{"stringUnit":{"state":"translated","value":"Abilita da iPhone"}},"tr":{"stringUnit":{"state":"translated","value":"iPhone'dan etkinleştir"}},"uk":{"stringUnit":{"state":"translated","value":"Увімкнути з iPhone"}},"id":{"stringUnit":{"state":"translated","value":"Aktifkan dari iPhone"}},"pl":{"stringUnit":{"state":"translated","value":"Włącz z iPhone'a"}},"th":{"stringUnit":{"state":"translated","value":"เปิดใช้งานจาก iPhone"}},"vi":{"stringUnit":{"state":"translated","value":"Bật từ iPhone"}},"nl":{"stringUnit":{"state":"translated","value":"Inschakelen vanaf iPhone"}},"fa":{"stringUnit":{"state":"translated","value":"فعال‌سازی از iPhone"}},"ru":{"stringUnit":{"state":"translated","value":"Включить с iPhone"}},"sv":{"stringUnit":{"state":"translated","value":"Aktivera från iPhone"}}}},
    "Enable “Discovery Debug Logs” to start collecting events.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enable “Discovery Debug Logs” to start collecting events."}},"zh-CN":{"stringUnit":{"state":"translated","value":"启用“发现调试日志”以开始收集事件。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"啟用 “探索偵錯記錄” 以開始收集事件。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ative “Logs de depuração de descoberta” para começar a coletar eventos."}},"de":{"stringUnit":{"state":"translated","value":"Aktivieren Sie “Debug-Protokolle zur Erkennung”, um mit der Erfassung von Ereignissen zu beginnen."}},"es":{"stringUnit":{"state":"translated","value":"Activa “Registros de depuración de descubrimiento” para empezar a recopilar eventos."}},"ja-JP":{"stringUnit":{"state":"translated","value":"イベントの収集を開始するには、“検出デバッグログ”を有効にしてください。"}},"ko":{"stringUnit":{"state":"translated","value":"이벤트 수집을 시작하려면 “검색 디버그 로그”를 활성화하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Activez “Journaux de débogage de la découverte” pour commencer à collecter des événements."}},"hi":{"stringUnit":{"state":"translated","value":"इवेंट एकत्र करना शुरू करने के लिए “डिस्कवरी डीबग लॉग” सक्षम करें."}},"ar":{"stringUnit":{"state":"translated","value":"قم بتمكين “سجلات تصحيح أخطاء الاكتشاف” لبدء جمع الأحداث."}},"it":{"stringUnit":{"state":"translated","value":"Abilita “Log di debug del rilevamento” per iniziare a raccogliere gli eventi."}},"tr":{"stringUnit":{"state":"translated","value":"Olayları toplamaya başlamak için “Keşif Hata Ayıklama Günlükleri” seçeneğini etkinleştirin."}},"uk":{"stringUnit":{"state":"translated","value":"Увімкніть “Журнали налагодження виявлення”, щоб почати збирати події."}},"id":{"stringUnit":{"state":"translated","value":"Aktifkan “Log Debug Penemuan” untuk mulai mengumpulkan peristiwa."}},"pl":{"stringUnit":{"state":"translated","value":"Włącz „Dzienniki debugowania wykrywania”, aby rozpocząć zbieranie zdarzeń."}},"th":{"stringUnit":{"state":"translated","value":"เปิดใช้งาน “บันทึกการแก้จุดบกพร่องการค้นหา” เพื่อเริ่มรวบรวมเหตุการณ์."}},"vi":{"stringUnit":{"state":"translated","value":"Bật “Nhật ký gỡ lỗi khám phá” để bắt đầu thu thập sự kiện."}},"nl":{"stringUnit":{"state":"translated","value":"Schakel “Debuglogboeken voor detectie” in om gebeurtenissen te verzamelen."}},"fa":{"stringUnit":{"state":"translated","value":"برای شروع جمع‌آوری رویدادها، “گزارش‌های اشکال‌زدایی کشف” را فعال کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Включите “Журналы отладки обнаружения”, чтобы начать сбор событий."}},"sv":{"stringUnit":{"state":"translated","value":"Aktivera ”Felsökningsloggar för upptäckt” för att börja samla in händelser."}}}},
    "Enabled": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enabled"}},"zh-CN":{"stringUnit":{"state":"translated","value":"已启用"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已啟用"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ativado"}},"de":{"stringUnit":{"state":"translated","value":"Aktiviert"}},"es":{"stringUnit":{"state":"translated","value":"Activado"}},"ja-JP":{"stringUnit":{"state":"translated","value":"有効"}},"ko":{"stringUnit":{"state":"translated","value":"사용 설정됨"}},"fr":{"stringUnit":{"state":"translated","value":"Activé"}},"hi":{"stringUnit":{"state":"translated","value":"सक्षम"}},"ar":{"stringUnit":{"state":"translated","value":"مُمكّن"}},"it":{"stringUnit":{"state":"translated","value":"Abilitato"}},"tr":{"stringUnit":{"state":"translated","value":"Etkin"}},"uk":{"stringUnit":{"state":"translated","value":"Увімкнено"}},"id":{"stringUnit":{"state":"translated","value":"Aktif"}},"pl":{"stringUnit":{"state":"translated","value":"Włączone"}},"th":{"stringUnit":{"state":"translated","value":"เปิดใช้งานแล้ว"}},"vi":{"stringUnit":{"state":"translated","value":"Đã bật"}},"nl":{"stringUnit":{"state":"translated","value":"Ingeschakeld"}},"fa":{"stringUnit":{"state":"translated","value":"فعال"}},"ru":{"stringUnit":{"state":"translated","value":"Включено"}},"sv":{"stringUnit":{"state":"translated","value":"Aktiverat"}}}},
    "Enabled for this session": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enabled for this session"}},"zh-CN":{"stringUnit":{"state":"translated","value":"已为此会话启用"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已為此工作階段啟用"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ativado para esta sessão"}},"de":{"stringUnit":{"state":"translated","value":"Für diese Sitzung aktiviert"}},"es":{"stringUnit":{"state":"translated","value":"Activado para esta sesión"}},"ja-JP":{"stringUnit":{"state":"translated","value":"このセッションで有効"}},"ko":{"stringUnit":{"state":"translated","value":"이 세션에서 활성화됨"}},"fr":{"stringUnit":{"state":"translated","value":"Activé pour cette session"}},"hi":{"stringUnit":{"state":"translated","value":"इस सत्र के लिए सक्षम"}},"ar":{"stringUnit":{"state":"translated","value":"مفعّل لهذه الجلسة"}},"it":{"stringUnit":{"state":"translated","value":"Abilitato per questa sessione"}},"tr":{"stringUnit":{"state":"translated","value":"Bu oturum için etkin"}},"uk":{"stringUnit":{"state":"translated","value":"Увімкнено для цього сеансу"}},"id":{"stringUnit":{"state":"translated","value":"Diaktifkan untuk sesi ini"}},"pl":{"stringUnit":{"state":"translated","value":"Włączone w tej sesji"}},"th":{"stringUnit":{"state":"translated","value":"เปิดใช้งานสำหรับเซสชันนี้"}},"vi":{"stringUnit":{"state":"translated","value":"Đã bật cho phiên này"}},"nl":{"stringUnit":{"state":"translated","value":"Ingeschakeld voor deze sessie"}},"fa":{"stringUnit":{"state":"translated","value":"برای این نشست فعال است"}},"ru":{"stringUnit":{"state":"translated","value":"Включено для этого сеанса"}},"sv":{"stringUnit":{"state":"translated","value":"Aktiverat för den här sessionen"}}}},
    "Enabling this sends delivery data through OpenClaw's hosted push relay.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enabling this sends delivery data through OpenClaw's hosted push relay."}},"zh-CN":{"stringUnit":{"state":"translated","value":"启用此功能会通过 OpenClaw 的托管推送中继发送投递数据。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"啟用此選項會透過 OpenClaw 託管的推播中繼服務傳送遞送資料。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ativar esta opção envia dados de entrega pelo serviço de retransmissão de notificações push hospedado pelo OpenClaw."}},"de":{"stringUnit":{"state":"translated","value":"Wenn diese Option aktiviert ist, werden Zustellungsdaten über das von OpenClaw gehostete Push-Relay gesendet."}},"es":{"stringUnit":{"state":"translated","value":"Al activar esta opción, se envían datos de entrega a través del servicio de retransmisión de notificaciones push alojado por OpenClaw."}},"ja-JP":{"stringUnit":{"state":"translated","value":"これを有効にすると、OpenClawがホストするプッシュリレーを通じて配信データが送信されます。"}},"ko":{"stringUnit":{"state":"translated","value":"이 기능을 활성화하면 OpenClaw의 호스팅 푸시 릴레이를 통해 전송 데이터가 전송됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’activation de cette option envoie les données de livraison via le relais de notifications push hébergé d’OpenClaw."}},"hi":{"stringUnit":{"state":"translated","value":"इसे सक्षम करने पर डिलीवरी डेटा OpenClaw के होस्ट किए गए पुश रिले के माध्यम से भेजा जाता है।"}},"ar":{"stringUnit":{"state":"translated","value":"يؤدي تفعيل هذا الخيار إلى إرسال بيانات التسليم عبر وسيط الإشعارات الفورية المستضاف لدى OpenClaw."}},"it":{"stringUnit":{"state":"translated","value":"Abilitando questa opzione, i dati di consegna vengono inviati tramite il relay push ospitato da OpenClaw."}},"tr":{"stringUnit":{"state":"translated","value":"Bu seçenek etkinleştirildiğinde teslimat verileri OpenClaw'ın barındırılan anlık bildirim aktarıcısı üzerinden gönderilir."}},"uk":{"stringUnit":{"state":"translated","value":"Увімкнення цієї функції надсилає дані доставки через хмарний ретранслятор push-сповіщень OpenClaw."}},"id":{"stringUnit":{"state":"translated","value":"Mengaktifkan ini akan mengirim data pengiriman melalui relai push yang dihosting OpenClaw."}},"pl":{"stringUnit":{"state":"translated","value":"Włączenie tej opcji powoduje przesyłanie danych dostarczania przez hostowany serwer pośredniczący push OpenClaw."}},"th":{"stringUnit":{"state":"translated","value":"การเปิดใช้งานนี้จะส่งข้อมูลการนำส่งผ่านบริการส่งต่อการแจ้งเตือนแบบพุชที่ OpenClaw โฮสต์ไว้."}},"vi":{"stringUnit":{"state":"translated","value":"Bật tùy chọn này sẽ gửi dữ liệu chuyển phát qua dịch vụ chuyển tiếp thông báo đẩy do OpenClaw lưu trữ."}},"nl":{"stringUnit":{"state":"translated","value":"Als je dit inschakelt, worden aflevergegevens via de gehoste pushrelay van OpenClaw verzonden."}},"fa":{"stringUnit":{"state":"translated","value":"با فعال‌سازی این گزینه، داده‌های تحویل از طریق رلهٔ اعلان پوش میزبانی‌شدهٔ OpenClaw ارسال می‌شوند."}},"ru":{"stringUnit":{"state":"translated","value":"При включении данные о доставке отправляются через облачный ретранслятор push-уведомлений OpenClaw."}},"sv":{"stringUnit":{"state":"translated","value":"Om detta aktiveras skickas leveransdata via OpenClaws driftade pushrelä."}}}},
    "End": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"End"}},"zh-CN":{"stringUnit":{"state":"translated","value":"结束"}},"zh-TW":{"stringUnit":{"state":"translated","value":"結束"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Encerrar"}},"de":{"stringUnit":{"state":"translated","value":"Beenden"}},"es":{"stringUnit":{"state":"translated","value":"Finalizar"}},"ja-JP":{"stringUnit":{"state":"translated","value":"終了"}},"ko":{"stringUnit":{"state":"translated","value":"종료"}},"fr":{"stringUnit":{"state":"translated","value":"Terminer"}},"hi":{"stringUnit":{"state":"translated","value":"समाप्त करें"}},"ar":{"stringUnit":{"state":"translated","value":"إنهاء"}},"it":{"stringUnit":{"state":"translated","value":"Termina"}},"tr":{"stringUnit":{"state":"translated","value":"Sonlandır"}},"uk":{"stringUnit":{"state":"translated","value":"Завершити"}},"id":{"stringUnit":{"state":"translated","value":"Akhiri"}},"pl":{"stringUnit":{"state":"translated","value":"Zakończ"}},"th":{"stringUnit":{"state":"translated","value":"วางสาย"}},"vi":{"stringUnit":{"state":"translated","value":"Kết thúc"}},"nl":{"stringUnit":{"state":"translated","value":"Beëindigen"}},"fa":{"stringUnit":{"state":"translated","value":"پایان"}},"ru":{"stringUnit":{"state":"translated","value":"Завершить"}},"sv":{"stringUnit":{"state":"translated","value":"Avsluta"}}}},
    "Ending call…": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Ending call…"}},"zh-CN":{"stringUnit":{"state":"translated","value":"正在结束通话…"}},"zh-TW":{"stringUnit":{"state":"translated","value":"正在結束通話…"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Encerrando chamada…"}},"de":{"stringUnit":{"state":"translated","value":"Anruf wird beendet…"}},"es":{"stringUnit":{"state":"translated","value":"Finalizando llamada…"}},"ja-JP":{"stringUnit":{"state":"translated","value":"通話を終了中…"}},"ko":{"stringUnit":{"state":"translated","value":"통화 종료 중…"}},"fr":{"stringUnit":{"state":"translated","value":"Fin de l’appel…"}},"hi":{"stringUnit":{"state":"translated","value":"कॉल समाप्त हो रही है…"}},"ar":{"stringUnit":{"state":"translated","value":"جارٍ إنهاء المكالمة…"}},"it":{"stringUnit":{"state":"translated","value":"Chiusura della chiamata…"}},"tr":{"stringUnit":{"state":"translated","value":"Arama sonlandırılıyor…"}},"uk":{"stringUnit":{"state":"translated","value":"Завершення виклику…"}},"id":{"stringUnit":{"state":"translated","value":"Mengakhiri panggilan…"}},"pl":{"stringUnit":{"state":"translated","value":"Kończenie połączenia…"}},"th":{"stringUnit":{"state":"translated","value":"กำลังวางสาย…"}},"vi":{"stringUnit":{"state":"translated","value":"Đang kết thúc cuộc gọi…"}},"nl":{"stringUnit":{"state":"translated","value":"Oproep beëindigen…"}},"fa":{"stringUnit":{"state":"translated","value":"در حال پایان دادن به تماس…"}},"ru":{"stringUnit":{"state":"translated","value":"Завершение вызова…"}},"sv":{"stringUnit":{"state":"translated","value":"Avslutar samtalet…"}}}},
    "Enter setup code": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter setup code"}},"zh-CN":{"stringUnit":{"state":"translated","value":"输入设置码"}},"zh-TW":{"stringUnit":{"state":"translated","value":"輸入設定代碼"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Digite o código de configuração"}},"de":{"stringUnit":{"state":"translated","value":"Einrichtungscode eingeben"}},"es":{"stringUnit":{"state":"translated","value":"Introduce el código de configuración"}},"ja-JP":{"stringUnit":{"state":"translated","value":"セットアップコードを入力"}},"ko":{"stringUnit":{"state":"translated","value":"설정 코드 입력"}},"fr":{"stringUnit":{"state":"translated","value":"Saisir le code de configuration"}},"hi":{"stringUnit":{"state":"translated","value":"सेटअप कोड दर्ज करें"}},"ar":{"stringUnit":{"state":"translated","value":"أدخل رمز الإعداد"}},"it":{"stringUnit":{"state":"translated","value":"Inserisci il codice di configurazione"}},"tr":{"stringUnit":{"state":"translated","value":"Kurulum kodunu girin"}},"uk":{"stringUnit":{"state":"translated","value":"Введіть код налаштування"}},"id":{"stringUnit":{"state":"translated","value":"Masukkan kode penyiapan"}},"pl":{"stringUnit":{"state":"translated","value":"Wpisz kod konfiguracji"}},"th":{"stringUnit":{"state":"translated","value":"ป้อนรหัสการตั้งค่า"}},"vi":{"stringUnit":{"state":"translated","value":"Nhập mã thiết lập"}},"nl":{"stringUnit":{"state":"translated","value":"Installatiecode invoeren"}},"fa":{"stringUnit":{"state":"translated","value":"کد راه‌اندازی را وارد کنید"}},"ru":{"stringUnit":{"state":"translated","value":"Введите код настройки"}},"sv":{"stringUnit":{"state":"translated","value":"Ange konfigurationskod"}}}},
    "Error": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Error"}},"zh-CN":{"stringUnit":{"state":"translated","value":"错误"}},"zh-TW":{"stringUnit":{"state":"translated","value":"錯誤"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Erro"}},"de":{"stringUnit":{"state":"translated","value":"Fehler"}},"es":{"stringUnit":{"state":"new","value":"Error"}},"ja-JP":{"stringUnit":{"state":"translated","value":"エラー"}},"ko":{"stringUnit":{"state":"translated","value":"오류"}},"fr":{"stringUnit":{"state":"translated","value":"Erreur"}},"hi":{"stringUnit":{"state":"translated","value":"त्रुटि"}},"ar":{"stringUnit":{"state":"translated","value":"خطأ"}},"it":{"stringUnit":{"state":"translated","value":"Errore"}},"tr":{"stringUnit":{"state":"translated","value":"Hata"}},"uk":{"stringUnit":{"state":"translated","value":"Помилка"}},"id":{"stringUnit":{"state":"translated","value":"Kesalahan"}},"pl":{"stringUnit":{"state":"translated","value":"Błąd"}},"th":{"stringUnit":{"state":"translated","value":"ข้อผิดพลาด"}},"vi":{"stringUnit":{"state":"translated","value":"Lỗi"}},"nl":{"stringUnit":{"state":"translated","value":"Fout"}},"fa":{"stringUnit":{"state":"translated","value":"خطا"}},"ru":{"stringUnit":{"state":"translated","value":"Ошибка"}},"sv":{"stringUnit":{"state":"translated","value":"Fel"}}}},
    "Exact HTTPS hosts, separated by commas or spaces. Empty allows config SecretRefs only.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Exact HTTPS hosts, separated by commas or spaces. Empty allows config SecretRefs only."}},"zh-CN":{"stringUnit":{"state":"translated","value":"精确的 HTTPS 主机名，以逗号或空格分隔。留空则仅允许配置中的 SecretRefs。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"須完全符合的 HTTPS 主機, 以逗號或空格分隔。 留空時僅允許設定中的 SecretRefs."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Hosts HTTPS exatos, separados por vírgulas ou espaços. Se estiver vazio, permite apenas SecretRefs da configuração."}},"de":{"stringUnit":{"state":"translated","value":"Exakte HTTPS-Hosts, durch Kommas oder Leerzeichen getrennt. Ein leeres Feld erlaubt nur SecretRefs aus der Konfiguration."}},"es":{"stringUnit":{"state":"translated","value":"Hosts HTTPS exactos, separados por comas o espacios. Si se deja vacío, solo se permiten SecretRefs de la configuración."}},"ja-JP":{"stringUnit":{"state":"translated","value":"完全一致するHTTPSホストをカンマまたはスペースで区切って指定します。空の場合は設定内のSecretRefsのみが許可されます。"}},"ko":{"stringUnit":{"state":"translated","value":"정확한 HTTPS 호스트를 쉼표나 공백으로 구분하여 입력하세요. 비워 두면 구성의 SecretRefs만 허용됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Noms d’hôtes HTTPS exacts, séparés par des virgules ou des espaces. Si ce champ est vide, seuls les SecretRefs de la configuration sont autorisés."}},"hi":{"stringUnit":{"state":"translated","value":"सटीक HTTPS होस्ट, अल्पविराम या स्पेस से अलग किए गए। खाली होने पर केवल कॉन्फ़िगरेशन के SecretRefs की अनुमति है।"}},"ar":{"stringUnit":{"state":"translated","value":"أسماء مضيفي HTTPS الدقيقة، مفصولة بفواصل أو مسافات. ترك الحقل فارغًا يسمح فقط باستخدام SecretRefs في الإعدادات."}},"it":{"stringUnit":{"state":"translated","value":"Host HTTPS esatti, separati da virgole o spazi. Se vuoto, consente solo i SecretRefs della configurazione."}},"tr":{"stringUnit":{"state":"translated","value":"Virgül veya boşlukla ayrılmış tam HTTPS ana makine adları. Boş bırakılırsa yalnızca yapılandırmadaki SecretRefs değerlerine izin verilir."}},"uk":{"stringUnit":{"state":"translated","value":"Точні імена хостів HTTPS, розділені комами або пробілами. Порожнє поле дозволяє лише SecretRefs із конфігурації."}},"id":{"stringUnit":{"state":"translated","value":"Host HTTPS yang harus cocok persis, dipisahkan dengan koma atau spasi. Jika kosong, hanya SecretRefs konfigurasi yang diizinkan."}},"pl":{"stringUnit":{"state":"translated","value":"Dokładne nazwy hostów HTTPS, oddzielone przecinkami lub spacjami. Puste pole zezwala tylko na SecretRefs z konfiguracji."}},"th":{"stringUnit":{"state":"translated","value":"ระบุโฮสต์ HTTPS ให้ตรงทุกตัวอักษร โดยคั่นด้วยจุลภาคหรือเว้นวรรค. หากเว้นว่างไว้ จะอนุญาตเฉพาะ SecretRefs ในการกำหนดค่าเท่านั้น."}},"vi":{"stringUnit":{"state":"translated","value":"Tên máy chủ HTTPS chính xác, phân tách bằng dấu phẩy hoặc dấu cách. Để trống thì chỉ cho phép SecretRefs trong cấu hình."}},"nl":{"stringUnit":{"state":"translated","value":"Exacte HTTPS-hosts, gescheiden door komma's of spaties. Als dit leeg is, zijn alleen SecretRefs uit de configuratie toegestaan."}},"fa":{"stringUnit":{"state":"translated","value":"نام دقیق میزبان‌های HTTPS، جداشده با ویرگول یا فاصله. خالی گذاشتن این بخش فقط SecretRefs پیکربندی را مجاز می‌کند."}},"ru":{"stringUnit":{"state":"translated","value":"Точные имена HTTPS-хостов, разделённые запятыми или пробелами. Если поле пустое, разрешены только SecretRefs из конфигурации."}},"sv":{"stringUnit":{"state":"translated","value":"Exakta HTTPS-värdar, avgränsade med kommatecken eller mellanslag. Tomt tillåter endast SecretRefs från konfigurationen."}}}},
    "Exec approval required": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Exec approval required"}},"zh-CN":{"stringUnit":{"state":"translated","value":"需要执行审批"}},"zh-TW":{"stringUnit":{"state":"translated","value":"需要執行核准"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Aprovação de execução necessária"}},"de":{"stringUnit":{"state":"translated","value":"Ausführungsgenehmigung erforderlich"}},"es":{"stringUnit":{"state":"translated","value":"Se requiere aprobación de ejecución"}},"ja-JP":{"stringUnit":{"state":"translated","value":"実行の承認が必要です"}},"ko":{"stringUnit":{"state":"translated","value":"실행 승인 필요"}},"fr":{"stringUnit":{"state":"translated","value":"Approbation d’exécution requise"}},"hi":{"stringUnit":{"state":"translated","value":"निष्पादन के लिए स्वीकृति आवश्यक है"}},"ar":{"stringUnit":{"state":"translated","value":"موافقة التنفيذ مطلوبة"}},"it":{"stringUnit":{"state":"translated","value":"Approvazione di esecuzione richiesta"}},"tr":{"stringUnit":{"state":"translated","value":"Yürütme onayı gerekli"}},"uk":{"stringUnit":{"state":"translated","value":"Потрібне схвалення виконання"}},"id":{"stringUnit":{"state":"translated","value":"Persetujuan eksekusi diperlukan"}},"pl":{"stringUnit":{"state":"translated","value":"Wymagana zgoda na wykonanie"}},"th":{"stringUnit":{"state":"translated","value":"ต้องได้รับการอนุมัติเพื่อเรียกใช้คำสั่ง"}},"vi":{"stringUnit":{"state":"translated","value":"Cần phê duyệt thực thi"}},"nl":{"stringUnit":{"state":"translated","value":"Goedkeuring voor uitvoering vereist"}},"fa":{"stringUnit":{"state":"translated","value":"تأیید اجرا لازم است"}},"ru":{"stringUnit":{"state":"translated","value":"Требуется подтверждение выполнения"}},"sv":{"stringUnit":{"state":"translated","value":"Körningsgodkännande krävs"}}}},
    "Exec approvals can only be reviewed while OpenClaw is open and connected.\n\nEnable Notifications to receive approval notifications while OpenClaw is not open.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Exec approvals can only be reviewed while OpenClaw is open and connected.\n\nEnable Notifications to receive approval notifications while OpenClaw is not open."}},"zh-CN":{"stringUnit":{"state":"translated","value":"仅当 OpenClaw 已打开并保持连接时，才能审核执行审批请求。\n\n启用通知，以便在 OpenClaw 未打开时接收审批通知。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"只有在 OpenClaw 開啟且已連線時，才能審核執行核准請求。\n\n啟用通知，即可在 OpenClaw 未開啟時收到核准通知。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"As aprovações de execução só podem ser revisadas enquanto o OpenClaw estiver aberto e conectado.\n\nAtive as Notificações para receber notificações de aprovação enquanto o OpenClaw não estiver aberto."}},"de":{"stringUnit":{"state":"translated","value":"Ausführungsgenehmigungen können nur geprüft werden, während OpenClaw geöffnet und verbunden ist.\n\nAktivieren Sie Mitteilungen, um Genehmigungsmitteilungen zu erhalten, während OpenClaw nicht geöffnet ist."}},"es":{"stringUnit":{"state":"translated","value":"Las aprobaciones de ejecución solo se pueden revisar mientras OpenClaw esté abierto y conectado.\n\nActiva las notificaciones para recibir notificaciones de aprobación mientras OpenClaw no esté abierto."}},"ja-JP":{"stringUnit":{"state":"translated","value":"実行の承認は、OpenClaw が開いていて接続されている間のみ確認できます。\n\nOpenClaw が開いていないときに承認通知を受け取るには、通知を有効にしてください。"}},"ko":{"stringUnit":{"state":"translated","value":"실행 승인은 OpenClaw이 열려 있고 연결된 상태에서만 검토할 수 있습니다.\n\nOpenClaw이 열려 있지 않을 때 승인 알림을 받으려면 알림을 활성화하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Les demandes d’autorisation d’exécution ne peuvent être examinées que lorsque OpenClaw est ouvert et connecté.\n\nActivez les notifications pour recevoir les demandes d’autorisation lorsque OpenClaw n’est pas ouvert."}},"hi":{"stringUnit":{"state":"translated","value":"निष्पादन अनुमोदनों की समीक्षा केवल तभी की जा सकती है जब OpenClaw खुला हो और कनेक्ट हो।\n\nOpenClaw खुला न होने पर अनुमोदन सूचनाएँ पाने के लिए सूचनाएँ सक्षम करें।"}},"ar":{"stringUnit":{"state":"translated","value":"لا يمكن مراجعة موافقات التنفيذ إلا عندما يكون OpenClaw مفتوحًا ومتصلاً.\n\nفعّل الإشعارات لتلقي إشعارات الموافقة عندما لا يكون OpenClaw مفتوحًا."}},"it":{"stringUnit":{"state":"translated","value":"Le approvazioni di esecuzione possono essere esaminate solo quando OpenClaw è aperto e connesso.\n\nAbilita le notifiche per ricevere le notifiche di approvazione quando OpenClaw non è aperto."}},"tr":{"stringUnit":{"state":"translated","value":"Komut çalıştırma onayları yalnızca OpenClaw açık ve bağlıyken incelenebilir.\n\nOpenClaw açık değilken onay bildirimleri almak için Bildirimleri etkinleştirin."}},"uk":{"stringUnit":{"state":"translated","value":"Запити на дозвіл виконання можна переглядати лише тоді, коли OpenClaw відкрито та підключено.\n\nУвімкніть сповіщення, щоб отримувати сповіщення про запити на дозвіл, коли OpenClaw не відкрито."}},"id":{"stringUnit":{"state":"translated","value":"Persetujuan eksekusi hanya dapat ditinjau saat OpenClaw terbuka dan terhubung.\n\nAktifkan Notifikasi untuk menerima notifikasi persetujuan saat OpenClaw tidak terbuka."}},"pl":{"stringUnit":{"state":"translated","value":"Prośby o zatwierdzenie wykonania poleceń można przeglądać tylko wtedy, gdy aplikacja OpenClaw jest otwarta i połączona.\n\nWłącz powiadomienia, aby otrzymywać powiadomienia o prośbach o zatwierdzenie, gdy aplikacja OpenClaw nie jest otwarta."}},"th":{"stringUnit":{"state":"translated","value":"สามารถตรวจสอบคำขออนุมัติการเรียกใช้คำสั่งได้เฉพาะเมื่อ OpenClaw เปิดอยู่และเชื่อมต่อแล้วเท่านั้น\n\nเปิดใช้งานการแจ้งเตือนเพื่อรับการแจ้งเตือนคำขออนุมัติเมื่อไม่ได้เปิด OpenClaw อยู่"}},"vi":{"stringUnit":{"state":"translated","value":"Chỉ có thể xem xét các yêu cầu phê duyệt thực thi khi OpenClaw đang mở và được kết nối.\n\nBật Thông báo để nhận thông báo phê duyệt khi OpenClaw không mở."}},"nl":{"stringUnit":{"state":"translated","value":"Uitvoeringsgoedkeuringen kunnen alleen worden beoordeeld terwijl OpenClaw geopend en verbonden is.\n\nSchakel Meldingen in om goedkeuringsmeldingen te ontvangen wanneer OpenClaw niet geopend is."}},"fa":{"stringUnit":{"state":"translated","value":"درخواست‌های تأیید اجرا فقط زمانی قابل بررسی هستند که OpenClaw باز و متصل باشد.\n\nاعلان‌ها را فعال کنید تا زمانی که OpenClaw باز نیست، اعلان‌های تأیید را دریافت کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Запросы на разрешение выполнения можно рассматривать только тогда, когда OpenClaw открыт и подключён.\n\nВключите уведомления, чтобы получать запросы на разрешение, когда OpenClaw не открыт."}},"sv":{"stringUnit":{"state":"translated","value":"Godkännanden för körning kan bara granskas när OpenClaw är öppet och anslutet.\n\nAktivera notiser för att få notiser om godkännanden när OpenClaw inte är öppet."}}}},
    "Expand diagram": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Expand diagram"}},"zh-CN":{"stringUnit":{"state":"translated","value":"展开图表"}},"zh-TW":{"stringUnit":{"state":"translated","value":"展開圖表"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Expandir diagrama"}},"de":{"stringUnit":{"state":"translated","value":"Diagramm aufklappen"}},"es":{"stringUnit":{"state":"translated","value":"Expandir diagrama"}},"ja-JP":{"stringUnit":{"state":"translated","value":"図を展開"}},"ko":{"stringUnit":{"state":"translated","value":"다이어그램 펼치기"}},"fr":{"stringUnit":{"state":"translated","value":"Développer le diagramme"}},"hi":{"stringUnit":{"state":"translated","value":"आरेख विस्तृत करें"}},"ar":{"stringUnit":{"state":"translated","value":"توسيع المخطط"}},"it":{"stringUnit":{"state":"translated","value":"Espandi diagramma"}},"tr":{"stringUnit":{"state":"translated","value":"Diyagramı genişlet"}},"uk":{"stringUnit":{"state":"translated","value":"Розгорнути діаграму"}},"id":{"stringUnit":{"state":"translated","value":"Perluas diagram"}},"pl":{"stringUnit":{"state":"translated","value":"Rozwiń diagram"}},"th":{"stringUnit":{"state":"translated","value":"ขยายแผนภาพ"}},"vi":{"stringUnit":{"state":"translated","value":"Mở rộng sơ đồ"}},"nl":{"stringUnit":{"state":"translated","value":"Diagram uitklappen"}},"fa":{"stringUnit":{"state":"translated","value":"باز کردن نمودار"}},"ru":{"stringUnit":{"state":"translated","value":"Развернуть диаграмму"}},"sv":{"stringUnit":{"state":"translated","value":"Expandera diagram"}}}},
    "Expand plan": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Expand plan"}},"zh-CN":{"stringUnit":{"state":"translated","value":"展开计划"}},"zh-TW":{"stringUnit":{"state":"translated","value":"展開計畫"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Expandir plano"}},"de":{"stringUnit":{"state":"translated","value":"Plan aufklappen"}},"es":{"stringUnit":{"state":"translated","value":"Expandir plan"}},"ja-JP":{"stringUnit":{"state":"translated","value":"プランを展開"}},"ko":{"stringUnit":{"state":"translated","value":"계획 펼치기"}},"fr":{"stringUnit":{"state":"translated","value":"Développer le plan"}},"hi":{"stringUnit":{"state":"translated","value":"योजना विस्तृत करें"}},"ar":{"stringUnit":{"state":"translated","value":"توسيع الخطة"}},"it":{"stringUnit":{"state":"translated","value":"Espandi piano"}},"tr":{"stringUnit":{"state":"translated","value":"Planı genişlet"}},"uk":{"stringUnit":{"state":"translated","value":"Розгорнути план"}},"id":{"stringUnit":{"state":"translated","value":"Perluas rencana"}},"pl":{"stringUnit":{"state":"translated","value":"Rozwiń plan"}},"th":{"stringUnit":{"state":"translated","value":"ขยายแผน"}},"vi":{"stringUnit":{"state":"translated","value":"Mở rộng kế hoạch"}},"nl":{"stringUnit":{"state":"translated","value":"Plan uitklappen"}},"fa":{"stringUnit":{"state":"translated","value":"باز کردن طرح"}},"ru":{"stringUnit":{"state":"translated","value":"Развернуть план"}},"sv":{"stringUnit":{"state":"translated","value":"Expandera plan"}}}},
    "Expand tool result": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Expand tool result"}},"zh-CN":{"stringUnit":{"state":"translated","value":"展开工具结果"}},"zh-TW":{"stringUnit":{"state":"translated","value":"展開工具結果"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Expandir resultado da ferramenta"}},"de":{"stringUnit":{"state":"translated","value":"Tool-Ergebnis aufklappen"}},"es":{"stringUnit":{"state":"translated","value":"Expandir resultado de la herramienta"}},"ja-JP":{"stringUnit":{"state":"translated","value":"ツールの結果を展開"}},"ko":{"stringUnit":{"state":"translated","value":"도구 결과 펼치기"}},"fr":{"stringUnit":{"state":"translated","value":"Développer le résultat de l’outil"}},"hi":{"stringUnit":{"state":"translated","value":"टूल का परिणाम विस्तृत करें"}},"ar":{"stringUnit":{"state":"translated","value":"توسيع نتيجة الأداة"}},"it":{"stringUnit":{"state":"translated","value":"Espandi risultato dello strumento"}},"tr":{"stringUnit":{"state":"translated","value":"Araç sonucunu genişlet"}},"uk":{"stringUnit":{"state":"translated","value":"Розгорнути результат інструмента"}},"id":{"stringUnit":{"state":"translated","value":"Perluas hasil alat"}},"pl":{"stringUnit":{"state":"translated","value":"Rozwiń wynik narzędzia"}},"th":{"stringUnit":{"state":"translated","value":"ขยายผลลัพธ์ของเครื่องมือ"}},"vi":{"stringUnit":{"state":"translated","value":"Mở rộng kết quả công cụ"}},"nl":{"stringUnit":{"state":"translated","value":"Toolresultaat uitklappen"}},"fa":{"stringUnit":{"state":"translated","value":"باز کردن نتیجهٔ ابزار"}},"ru":{"stringUnit":{"state":"translated","value":"Развернуть результат инструмента"}},"sv":{"stringUnit":{"state":"translated","value":"Expandera verktygsresultat"}}}},
