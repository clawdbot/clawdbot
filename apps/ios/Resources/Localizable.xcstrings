    "OpenClaw could not read the gateway certificate for %@.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenClaw could not read the gateway certificate for %@."}},"zh-CN":{"stringUnit":{"state":"translated","value":"OpenClaw 无法读取 %@ 的网关证书。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw 無法讀取 %@ 的 Gateway 憑證。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O OpenClaw não conseguiu ler o certificado do gateway de %@."}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw konnte das Gateway-Zertifikat für %@ nicht lesen."}},"es":{"stringUnit":{"state":"translated","value":"OpenClaw no pudo leer el certificado del Gateway para %@."}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClawは%@のGateway証明書を読み取れませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw에서 %@의 Gateway 인증서를 읽지 못했습니다."}},"fr":{"stringUnit":{"state":"translated","value":"OpenClaw n’a pas pu lire le certificat du Gateway pour %@."}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw %@ के लिए गेटवे प्रमाणपत्र नहीं पढ़ सका."}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر على OpenClaw قراءة شهادة البوابة الخاصة بـ %@."}},"it":{"stringUnit":{"state":"translated","value":"OpenClaw non ha potuto leggere il certificato del gateway per %@."}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw, %@ için ağ geçidi sertifikasını okuyamadı."}},"uk":{"stringUnit":{"state":"translated","value":"OpenClaw не вдалося прочитати сертифікат шлюзу для %@."}},"id":{"stringUnit":{"state":"translated","value":"OpenClaw tidak dapat membaca sertifikat gateway untuk %@."}},"pl":{"stringUnit":{"state":"translated","value":"OpenClaw nie może odczytać certyfikatu bramy dla %@."}},"th":{"stringUnit":{"state":"translated","value":"OpenClaw ไม่สามารถอ่านใบรับรองของเกตเวย์สำหรับ %@ ได้."}},"vi":{"stringUnit":{"state":"translated","value":"OpenClaw không thể đọc chứng chỉ cổng kết nối cho %@."}},"nl":{"stringUnit":{"state":"translated","value":"OpenClaw kon het gatewaycertificaat voor %@ niet lezen."}},"fa":{"stringUnit":{"state":"translated","value":"OpenClaw نتوانست گواهی دروازه را برای %@ بخواند."}},"ru":{"stringUnit":{"state":"translated","value":"OpenClaw не удалось прочитать сертификат шлюза для %@."}},"sv":{"stringUnit":{"state":"translated","value":"OpenClaw kunde inte läsa gateway-certifikatet för %@."}}}},
    "OpenClaw could not securely save the TLS certificate pin for %@.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenClaw could not securely save the TLS certificate pin for %@."}},"zh-CN":{"stringUnit":{"state":"translated","value":"OpenClaw 无法安全保存 %@ 的 TLS 证书固定信息。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw 無法安全地儲存 %@ 的 TLS 憑證釘選值。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O OpenClaw não conseguiu salvar com segurança a fixação do certificado TLS de %@."}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw konnte den TLS-Zertifikat-Pin für %@ nicht sicher speichern."}},"es":{"stringUnit":{"state":"translated","value":"OpenClaw no pudo guardar de forma segura la huella fijada del certificado TLS para %@."}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClawは%@のTLS証明書ピンを安全に保存できませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw에서 %@의 TLS 인증서 핀을 안전하게 저장하지 못했습니다."}},"fr":{"stringUnit":{"state":"translated","value":"OpenClaw n’a pas pu enregistrer de manière sécurisée l’empreinte du certificat TLS pour %@."}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw %@ के लिए TLS प्रमाणपत्र पिन सुरक्षित रूप से सहेज नहीं सका."}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر على OpenClaw حفظ بصمة تثبيت شهادة TLS الخاصة بـ %@ بشكل آمن."}},"it":{"stringUnit":{"state":"translated","value":"OpenClaw non ha potuto salvare in modo sicuro il pin del certificato TLS per %@."}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw, %@ için TLS sertifikası sabitleme bilgisini güvenli bir şekilde kaydedemedi."}},"uk":{"stringUnit":{"state":"translated","value":"OpenClaw не вдалося безпечно зберегти закріплений сертифікат TLS для %@."}},"id":{"stringUnit":{"state":"translated","value":"OpenClaw tidak dapat menyimpan pin sertifikat TLS untuk %@ secara aman."}},"pl":{"stringUnit":{"state":"translated","value":"OpenClaw nie może bezpiecznie zapisać przypięcia certyfikatu TLS dla %@."}},"th":{"stringUnit":{"state":"translated","value":"OpenClaw ไม่สามารถบันทึกข้อมูลการตรึงใบรับรอง TLS สำหรับ %@ ได้อย่างปลอดภัย."}},"vi":{"stringUnit":{"state":"translated","value":"OpenClaw không thể lưu thông tin ghim chứng chỉ TLS cho %@ một cách an toàn."}},"nl":{"stringUnit":{"state":"translated","value":"OpenClaw kon de TLS-certificaatpin voor %@ niet veilig opslaan."}},"fa":{"stringUnit":{"state":"translated","value":"OpenClaw نتوانست پین گواهی TLS را برای %@ به‌صورت امن ذخیره کند."}},"ru":{"stringUnit":{"state":"translated","value":"OpenClaw не удалось безопасно сохранить привязку TLS-сертификата для %@."}},"sv":{"stringUnit":{"state":"translated","value":"OpenClaw kunde inte spara TLS-certifikatbindningen för %@ på ett säkert sätt."}}}},
    "OpenClaw is checking gateway and node access.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenClaw is checking gateway and node access."}},"zh-CN":{"stringUnit":{"state":"translated","value":"OpenClaw 正在检查 Gateway 和节点访问权限。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw 正在檢查 Gateway 和節點的存取權限。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O OpenClaw está verificando o acesso ao gateway e ao nó."}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw überprüft den Zugriff auf Gateway und Knoten."}},"es":{"stringUnit":{"state":"translated","value":"OpenClaw está comprobando el acceso al Gateway y al nodo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClawはGatewayとノードへのアクセスを確認しています。"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw가 게이트웨이 및 노드 접근을 확인하고 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"OpenClaw vérifie l’accès à la passerelle et au nœud."}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw, gateway और नोड तक पहुँच की जाँच कर रहा है।"}},"ar":{"stringUnit":{"state":"translated","value":"يتحقق OpenClaw من إمكانية الوصول إلى البوابة والعقدة."}},"it":{"stringUnit":{"state":"translated","value":"OpenClaw sta verificando l’accesso al gateway e al nodo."}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw, Gateway ve düğüm erişimini kontrol ediyor."}},"uk":{"stringUnit":{"state":"translated","value":"OpenClaw перевіряє доступ до Gateway і вузла."}},"id":{"stringUnit":{"state":"translated","value":"OpenClaw sedang memeriksa akses gateway dan node."}},"pl":{"stringUnit":{"state":"translated","value":"OpenClaw sprawdza dostęp do bramy i węzła."}},"th":{"stringUnit":{"state":"translated","value":"OpenClaw กำลังตรวจสอบการเข้าถึง Gateway และโหนด."}},"vi":{"stringUnit":{"state":"translated","value":"OpenClaw đang kiểm tra quyền truy cập gateway và nút."}},"nl":{"stringUnit":{"state":"translated","value":"OpenClaw controleert de toegang tot de gateway en het knooppunt."}},"fa":{"stringUnit":{"state":"translated","value":"OpenClaw در حال بررسی دسترسی به دروازه و گره است."}},"ru":{"stringUnit":{"state":"translated","value":"OpenClaw проверяет доступ к Gateway и узлу."}},"sv":{"stringUnit":{"state":"translated","value":"OpenClaw kontrollerar åtkomsten till gateway och nod."}}}},
    "OpenClaw reads steps, sleep, resting heart rate, and workouts from Apple Health only when a summary is requested. Only the aggregate leaves this device through your Gateway to your configured AI provider; raw samples stay on this device and results may remain in chat history.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenClaw reads steps, sleep, resting heart rate, and workouts from Apple Health only when a summary is requested. Only the aggregate leaves this device through your Gateway to your configured AI provider; raw samples stay on this device and results may remain in chat history."}},"zh-CN":{"stringUnit":{"state":"translated","value":"OpenClaw 仅在请求摘要时才会从 Apple Health 读取步数、睡眠、静息心率和体能训练数据。只有汇总数据会通过你的 Gateway 从此设备发送至你配置的 AI 提供商；原始样本会保留在此设备上，结果可能会保留在聊天记录中。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw 僅在收到摘要請求時，才會從 Apple Health 讀取步數、睡眠、靜止心率和體能訓練資料。只有彙總資料會透過您的 Gateway 傳送至您設定的 AI 供應商；原始樣本會保留在此裝置上，結果則可能留存在聊天記錄中。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O OpenClaw lê dados de passos, sono, frequência cardíaca em repouso e treinos do Apple Health somente quando um resumo é solicitado. Apenas os dados agregados saem deste dispositivo, passando pelo seu Gateway até o provedor de IA configurado; as amostras brutas permanecem neste dispositivo e os resultados podem permanecer no histórico de conversas."}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw liest Schritte, Schlaf, Ruheherzfrequenz und Trainings aus Apple Health nur dann aus, wenn eine Zusammenfassung angefordert wird. Nur die zusammengefassten Daten verlassen dieses Gerät über dein Gateway und werden an deinen konfigurierten KI-Anbieter übermittelt; die Rohdaten bleiben auf diesem Gerät und Ergebnisse können im Chatverlauf gespeichert bleiben."}},"es":{"stringUnit":{"state":"translated","value":"OpenClaw lee los pasos, el sueño, la frecuencia cardíaca en reposo y los entrenamientos de Apple Health solo cuando se solicita un resumen. Solo los datos agregados salen de este dispositivo a través de tu Gateway hacia el proveedor de IA que hayas configurado; las muestras sin procesar permanecen en este dispositivo y los resultados pueden quedar en el historial de chat."}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClawは、要約がリクエストされた場合にのみ、Apple Healthから歩数、睡眠、安静時心拍数、ワークアウトのデータを読み取ります。集計データのみが、このデバイスからGatewayを経由して、設定済みのAIプロバイダーに送信されます。生のサンプルデータはこのデバイスに保存され、結果はチャット履歴に残る場合があります。"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw는 요약이 요청된 경우에만 Apple Health에서 걸음 수, 수면, 안정 시 심박수 및 운동 데이터를 읽습니다. 집계된 데이터만 Gateway를 통해 설정된 AI 제공업체로 전송됩니다. 원시 샘플은 이 기기에 보관되며 결과는 채팅 기록에 남을 수 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"OpenClaw lit les données de pas, de sommeil, de fréquence cardiaque au repos et d’entraînement dans Apple Health uniquement lorsqu’un résumé est demandé. Seules les données agrégées quittent cet appareil via votre Gateway pour être transmises au fournisseur d’IA que vous avez configuré ; les données brutes restent sur cet appareil et les résultats peuvent rester dans l’historique des conversations."}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw केवल सारांश का अनुरोध किए जाने पर ही Apple Health से कदमों, नींद, आराम के दौरान हृदय गति और व्यायाम का डेटा पढ़ता है। केवल समेकित डेटा ही इस डिवाइस से आपके Gateway के ज़रिए आपके कॉन्फ़िगर किए गए AI प्रदाता को भेजा जाता है; मूल नमूने इसी डिवाइस पर रहते हैं और परिणाम चैट इतिहास में बने रह सकते हैं।"}},"ar":{"stringUnit":{"state":"translated","value":"يقرأ OpenClaw بيانات الخطوات والنوم ومعدل ضربات القلب أثناء الراحة والتمارين من Apple Health فقط عند طلب ملخّص. لا تُرسَل خارج هذا الجهاز إلا البيانات المجمّعة، وذلك عبر Gateway الخاص بك إلى مزوّد الذكاء الاصطناعي الذي أعددته؛ وتبقى العينات الخام على هذا الجهاز، وقد تبقى النتائج في سجل الدردشة."}},"it":{"stringUnit":{"state":"translated","value":"OpenClaw legge passi, sonno, frequenza cardiaca a riposo e allenamenti da Apple Health solo quando viene richiesto un riepilogo. Solo i dati aggregati vengono inviati da questo dispositivo, tramite il tuo Gateway, al fornitore di IA configurato; i campioni grezzi restano su questo dispositivo e i risultati potrebbero rimanere nella cronologia della chat."}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw, Apple Health'ten adım, uyku, dinlenme kalp atış hızı ve antrenman verilerini yalnızca bir özet istendiğinde okur. Bu cihazdan yalnızca toplu veriler, Gateway'iniz üzerinden yapılandırdığınız yapay zekâ sağlayıcısına gönderilir; ham örnekler bu cihazda kalır ve sonuçlar sohbet geçmişinde saklanabilir."}},"uk":{"stringUnit":{"state":"translated","value":"OpenClaw зчитує дані про кроки, сон, пульс у стані спокою та тренування з Apple Health лише за запитом на зведення. Через ваш Gateway до налаштованого постачальника ШІ передаються лише узагальнені дані; первинні вимірювання залишаються на цьому пристрої, а результати можуть зберігатися в історії чату."}},"id":{"stringUnit":{"state":"translated","value":"OpenClaw membaca data langkah, tidur, detak jantung saat istirahat, dan latihan dari Apple Health hanya saat ringkasan diminta. Hanya data agregat yang dikirim dari perangkat ini melalui Gateway Anda ke penyedia AI yang Anda konfigurasikan; sampel mentah tetap berada di perangkat ini dan hasilnya mungkin tersimpan dalam riwayat obrolan."}},"pl":{"stringUnit":{"state":"translated","value":"OpenClaw odczytuje dane o krokach, śnie, tętnie spoczynkowym i treningach z Apple Health tylko na żądanie podsumowania. Wyłącznie dane zbiorcze są przesyłane z tego urządzenia przez Gateway do skonfigurowanego dostawcy AI; surowe próbki pozostają na tym urządzeniu, a wyniki mogą pozostać w historii czatu."}},"th":{"stringUnit":{"state":"translated","value":"OpenClaw จะอ่านข้อมูลจำนวนก้าว การนอนหลับ อัตราการเต้นของหัวใจขณะพัก และการออกกำลังกายจาก Apple Health เฉพาะเมื่อมีการขอสรุปข้อมูลเท่านั้น ระบบจะส่งเฉพาะข้อมูลสรุปรวมออกจากอุปกรณ์นี้ผ่าน Gateway ของคุณไปยังผู้ให้บริการ AI ที่คุณตั้งค่าไว้ โดยข้อมูลดิบแต่ละรายการจะยังคงอยู่บนอุปกรณ์นี้ และผลลัพธ์อาจยังคงอยู่ในประวัติการแชท"}},"vi":{"stringUnit":{"state":"translated","value":"OpenClaw chỉ đọc dữ liệu về số bước chân, giấc ngủ, nhịp tim khi nghỉ và các buổi tập từ Apple Health khi có yêu cầu tóm tắt. Chỉ dữ liệu tổng hợp được gửi ra khỏi thiết bị này qua Gateway của bạn đến nhà cung cấp AI mà bạn đã cấu hình; các mẫu dữ liệu thô vẫn ở trên thiết bị này và kết quả có thể được lưu trong lịch sử trò chuyện."}},"nl":{"stringUnit":{"state":"translated","value":"OpenClaw leest stappen, slaap, rusthartslag en work-outs uit Apple Health alleen wanneer er een samenvatting wordt aangevraagd. Alleen de samengevoegde gegevens verlaten dit apparaat via je Gateway naar je ingestelde AI-provider; ruwe meetgegevens blijven op dit apparaat en resultaten kunnen in de chatgeschiedenis blijven staan."}},"fa":{"stringUnit":{"state":"translated","value":"OpenClaw تنها زمانی که خلاصه‌ای درخواست شود، تعداد گام‌ها، خواب، ضربان قلب در حالت استراحت و تمرین‌های ورزشی را از Apple Health می‌خواند. فقط داده‌های تجمیع‌شده از طریق Gateway شما از این دستگاه به ارائه‌دهندهٔ هوش مصنوعی پیکربندی‌شدهٔ شما ارسال می‌شوند؛ نمونه‌های خام روی این دستگاه باقی می‌مانند و ممکن است نتایج در سابقهٔ گفتگو باقی بمانند."}},"ru":{"stringUnit":{"state":"translated","value":"OpenClaw считывает данные о шагах, сне, пульсе в покое и тренировках из Apple Health только при запросе сводки. Только обобщённые данные передаются с этого устройства через ваш Gateway выбранному вами поставщику ИИ; исходные данные остаются на устройстве, а результаты могут сохраняться в истории чата."}},"sv":{"stringUnit":{"state":"translated","value":"OpenClaw läser steg, sömn, vilopuls och träningspass från Apple Health endast när en sammanfattning begärs. Endast sammanställda data lämnar den här enheten via din Gateway till din konfigurerade AI-leverantör. Rådata stannar på enheten och resultaten kan finnas kvar i chatthistoriken."}}}},
    "OpenClaw unavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenClaw unavailable"}},"zh-CN":{"stringUnit":{"state":"translated","value":"OpenClaw 不可用"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw 無法使用"}},"pt-BR":{"stringUnit":{"state":"translated","value":"OpenClaw indisponível"}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw nicht verfügbar"}},"es":{"stringUnit":{"state":"translated","value":"OpenClaw no disponible"}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClawを利用できません"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw 사용 불가"}},"fr":{"stringUnit":{"state":"translated","value":"OpenClaw indisponible"}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw उपलब्ध नहीं है"}},"ar":{"stringUnit":{"state":"translated","value":"OpenClaw غير متاح"}},"it":{"stringUnit":{"state":"translated","value":"OpenClaw non disponibile"}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw kullanılamıyor"}},"uk":{"stringUnit":{"state":"translated","value":"OpenClaw недоступний"}},"id":{"stringUnit":{"state":"translated","value":"OpenClaw tidak tersedia"}},"pl":{"stringUnit":{"state":"translated","value":"OpenClaw niedostępny"}},"th":{"stringUnit":{"state":"translated","value":"OpenClaw ไม่พร้อมใช้งาน"}},"vi":{"stringUnit":{"state":"translated","value":"OpenClaw không khả dụng"}},"nl":{"stringUnit":{"state":"translated","value":"OpenClaw niet beschikbaar"}},"fa":{"stringUnit":{"state":"translated","value":"OpenClaw در دسترس نیست"}},"ru":{"stringUnit":{"state":"translated","value":"OpenClaw недоступен"}},"sv":{"stringUnit":{"state":"translated","value":"OpenClaw är inte tillgängligt"}}}},
