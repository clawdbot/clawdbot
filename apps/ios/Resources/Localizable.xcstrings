    "Ignored an expired direct connection setup. Send setup again from iPhone.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Ignored an expired direct connection setup. Send setup again from iPhone."}},"zh-CN":{"stringUnit":{"state":"translated","value":"已忽略过期的直连设置。请从 iPhone 重新发送设置。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已忽略過期的直接連線設定。請從 iPhone 重新傳送設定。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Uma configuração de conexão direta expirada foi ignorada. Envie a configuração novamente pelo iPhone."}},"de":{"stringUnit":{"state":"translated","value":"Eine abgelaufene Einrichtung für eine Direktverbindung wurde ignoriert. Einrichtung erneut vom iPhone senden."}},"es":{"stringUnit":{"state":"translated","value":"Se ha ignorado una configuración de conexión directa caducada. Vuelve a enviar la configuración desde el iPhone."}},"ja-JP":{"stringUnit":{"state":"translated","value":"期限切れの直接接続設定を無視しました。iPhoneから設定を再送信してください。"}},"ko":{"stringUnit":{"state":"translated","value":"만료된 직접 연결 설정을 무시했습니다. iPhone에서 설정을 다시 보내세요."}},"fr":{"stringUnit":{"state":"translated","value":"Une configuration de connexion directe expirée a été ignorée. Renvoyez la configuration depuis l’iPhone."}},"hi":{"stringUnit":{"state":"translated","value":"समय-सीमा समाप्त हो चुके सीधे कनेक्शन सेटअप को अनदेखा किया गया। iPhone से सेटअप फिर से भेजें।"}},"ar":{"stringUnit":{"state":"translated","value":"تم تجاهل إعداد اتصال مباشر منتهي الصلاحية. أرسل الإعداد مجددًا من iPhone."}},"it":{"stringUnit":{"state":"translated","value":"Configurazione della connessione diretta scaduta ignorata. Invia nuovamente la configurazione da iPhone."}},"tr":{"stringUnit":{"state":"translated","value":"Süresi dolmuş bir doğrudan bağlantı kurulumu yok sayıldı. Kurulumu iPhone'dan yeniden gönderin."}},"uk":{"stringUnit":{"state":"translated","value":"Прострочовані налаштування прямого підключення проігноровано. Надішліть налаштування з iPhone ще раз."}},"id":{"stringUnit":{"state":"translated","value":"Penyiapan koneksi langsung yang kedaluwarsa diabaikan. Kirim ulang penyiapan dari iPhone."}},"pl":{"stringUnit":{"state":"translated","value":"Zignorowano wygasłą konfigurację połączenia bezpośredniego. Wyślij konfigurację ponownie z iPhone."}},"th":{"stringUnit":{"state":"translated","value":"ละเว้นการตั้งค่าการเชื่อมต่อโดยตรงที่หมดอายุแล้ว. ส่งการตั้งค่าอีกครั้งจาก iPhone."}},"vi":{"stringUnit":{"state":"translated","value":"Đã bỏ qua thiết lập kết nối trực tiếp đã hết hạn. Hãy gửi lại thiết lập từ iPhone."}},"nl":{"stringUnit":{"state":"translated","value":"Een verlopen configuratie voor een directe verbinding is genegeerd. Verzend de configuratie opnieuw vanaf de iPhone."}},"fa":{"stringUnit":{"state":"translated","value":"تنظیمات منقضی‌شدهٔ اتصال مستقیم نادیده گرفته شد. تنظیمات را دوباره از iPhone ارسال کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Просроченные настройки прямого подключения проигнорированы. Отправьте настройки с iPhone повторно."}},"sv":{"stringUnit":{"state":"translated","value":"Ignorerade en utgången konfiguration för direktanslutning. Skicka konfigurationen igen från iPhone."}}}},
