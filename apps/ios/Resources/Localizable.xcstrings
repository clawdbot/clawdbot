    "OpenClaw appreciates its partners in the open-source community.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenClaw appreciates its partners in the open-source community."}},"zh-CN":{"stringUnit":{"state":"translated","value":"OpenClaw 感谢开源社区中的合作伙伴。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw 感謝開放原始碼社群中的合作夥伴。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O OpenClaw agradece aos seus parceiros na comunidade de código aberto."}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw schätzt seine Partner in der Open-Source-Community."}},"es":{"stringUnit":{"state":"translated","value":"OpenClaw agradece a sus colaboradores de la comunidad de código abierto."}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClaw は、オープンソースコミュニティのパートナーの皆様に感謝しています。"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw는 오픈 소스 커뮤니티의 파트너들에게 감사드립니다."}},"fr":{"stringUnit":{"state":"translated","value":"OpenClaw remercie ses partenaires de la communauté open source."}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw ओपन-सोर्स समुदाय में अपने साझेदारों की सराहना करता है."}},"ar":{"stringUnit":{"state":"translated","value":"يقدّر OpenClaw شركاءه في مجتمع المصادر المفتوحة."}},"it":{"stringUnit":{"state":"translated","value":"OpenClaw ringrazia i suoi partner nella comunità open source."}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw, açık kaynak topluluğundaki iş ortaklarına değer verir."}},"uk":{"stringUnit":{"state":"translated","value":"OpenClaw цінує своїх партнерів у спільноті відкритого програмного забезпечення."}},"id":{"stringUnit":{"state":"translated","value":"OpenClaw menghargai para mitranya di komunitas sumber terbuka."}},"pl":{"stringUnit":{"state":"translated","value":"OpenClaw docenia swoich partnerów ze społeczności open source."}},"th":{"stringUnit":{"state":"translated","value":"OpenClaw ขอขอบคุณพันธมิตรในชุมชนโอเพนซอร์ส."}},"vi":{"stringUnit":{"state":"translated","value":"OpenClaw trân trọng các đối tác trong cộng đồng mã nguồn mở."}},"nl":{"stringUnit":{"state":"translated","value":"OpenClaw waardeert zijn partners in de opensourcegemeenschap."}},"fa":{"stringUnit":{"state":"translated","value":"OpenClaw از شرکای خود در جامعهٔ متن‌باز قدردانی می‌کند."}},"ru":{"stringUnit":{"state":"translated","value":"OpenClaw благодарит своих партнёров из сообщества открытого ПО."}},"sv":{"stringUnit":{"state":"translated","value":"OpenClaw uppskattar sina partner i gemenskapen för öppen källkod."}}}},
    "OpenClaw cannot determine the current iOS location permission.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenClaw cannot determine the current iOS location permission."}},"zh-CN":{"stringUnit":{"state":"translated","value":"OpenClaw 无法确定当前的 iOS 位置权限。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw 無法判定目前的 iOS 位置權限。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O OpenClaw não consegue determinar a permissão atual de localização do iOS."}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw kann die aktuelle iOS-Standortberechtigung nicht ermitteln."}},"es":{"stringUnit":{"state":"translated","value":"OpenClaw no puede determinar el permiso de ubicación actual de iOS."}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClawは現在のiOSの位置情報の許可状態を確認できません。"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw에서 현재 iOS 위치 권한을 확인할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"OpenClaw ne peut pas déterminer l’autorisation actuelle d’accès à la localisation sous iOS."}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw वर्तमान iOS स्थान अनुमति का पता नहीं लगा सकता."}},"ar":{"stringUnit":{"state":"translated","value":"لا يستطيع OpenClaw تحديد إذن الوصول الحالي إلى الموقع في iOS."}},"it":{"stringUnit":{"state":"translated","value":"OpenClaw non riesce a determinare l'autorizzazione attuale per la posizione su iOS."}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw mevcut iOS konum iznini belirleyemiyor."}},"uk":{"stringUnit":{"state":"translated","value":"OpenClaw не може визначити поточний дозвіл на доступ до геопозиції в iOS."}},"id":{"stringUnit":{"state":"translated","value":"OpenClaw tidak dapat menentukan izin lokasi iOS saat ini."}},"pl":{"stringUnit":{"state":"translated","value":"OpenClaw nie może określić aktualnego uprawnienia do lokalizacji w iOS."}},"th":{"stringUnit":{"state":"translated","value":"OpenClaw ไม่สามารถระบุสิทธิ์การเข้าถึงตำแหน่งปัจจุบัน