    "Refresh from an updated iPhone before sending a Watch message.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Refresh from an updated iPhone before sending a Watch message."}},"zh-CN":{"stringUnit":{"state":"translated","value":"发送 Watch 消息前，请从已更新的 iPhone 刷新。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"傳送 Watch 訊息前，請從已更新的 iPhone 重新整理。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Atualize a partir de um iPhone atualizado antes de enviar uma mensagem pelo Watch."}},"de":{"stringUnit":{"state":"translated","value":"Vor dem Senden einer Watch-Nachricht von einem aktualisierten iPhone aktualisieren."}},"es":{"stringUnit":{"state":"translated","value":"Actualiza desde un iPhone actualizado antes de enviar un mensaje desde el Watch."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Watch メッセージを送信する前に、最新の状態の iPhone から更新してください。"}},"ko":{"stringUnit":{"state":"translated","value":"Watch 메시지를 보내기 전에 업데이트된 iPhone에서 새로고침하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Actualisez depuis un iPhone à jour avant d’envoyer un message depuis la Watch."}},"hi":{"stringUnit":{"state":"translated","value":"Watch से संदेश भेजने से पहले अपडेट किए गए iPhone से रीफ़्रेश करें."}},"ar":{"stringUnit":{"state":"translated","value":"حدّث من جهاز iPhone محدّث قبل إرسال رسالة من Watch."}},"it":{"stringUnit":{"state":"translated","value":"Aggiorna da un iPhone aggiornato prima di inviare un messaggio da Watch."}},"tr":{"stringUnit":{"state":"translated","value":"Watch mesajı göndermeden önce güncellenmiş bir iPhone'dan yenileyin."}},"uk":{"stringUnit":{"state":"translated","value":"Оновіть дані з оновленого iPhone, перш ніж надсилати повідомлення з Watch."}},"id":{"stringUnit":{"state":"translated","value":"Segarkan dari iPhone yang telah diperbarui sebelum mengirim pesan Watch."}},"pl":{"stringUnit":{"state":"translated","value":"Odśwież dane ze zaktualizowanego iPhone'a przed wysłaniem wiadomości z Watch."}},"th":{"stringUnit":{"state":"translated","value":"รีเฟรชจาก iPhone ที่อัปเดตแล้วก่อนส่งข้อความจาก Watch."}},"vi":{"stringUnit":{"state":"translated","value":"Làm mới từ iPhone đã cập nhật trước khi gửi tin nhắn trên Watch."}},"nl":{"stringUnit":{"state":"translated","value":"Vernieuw vanaf een bijgewerkte iPhone voordat je een Watch-bericht verstuurt."}},"fa":{"stringUnit":{"state":"translated","value":"پیش از ارسال پیام از Watch، اطلاعات را از یک iPhone به‌روز تازه‌سازی کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Обновите данные с iPhone с актуальной версией ПО перед отправкой сообщения с Watch."}},"sv":{"stringUnit":{"state":"translated","value":"Uppdatera från en uppdaterad iPhone innan du skickar ett Watch-meddelande."}}}},
    "Refresh this prompt from an updated iPhone before replying.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Refresh this prompt from an updated iPhone before replying."}},"zh-CN":{"stringUnit":{"state":"translated","value":"回复前，请从已更新的 iPhone 刷新此提示。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"回覆前，請從已更新的 iPhone 重新整理此提示。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Atualize esta solicitação a partir de um iPhone atualizado antes de responder."}},"de":{"stringUnit":{"state":"translated","value":"Diese Eingabeaufforderung vor dem Antworten von einem aktualisierten iPhone aktualisieren."}},"es":{"stringUnit":{"state":"translated","value":"Actualiza esta solicitud desde un iPhone actualizado antes de responder."}},"ja-JP":{"stringUnit":{"state":"translated","value":"返信する前に、最新の状態の iPhone からこのプロンプトを更新してください。"}},"ko":{"stringUnit":{"state":"translated","value":"답장하기 전에 업데이트된 iPhone에서 이 프롬프트를 새로고침하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Actualisez cette invite depuis un iPhone à jour avant de répondre."}},"hi":{"stringUnit":{"state":"translated","value":"जवाब देने से पहले इस प्रॉम्प्ट को अपडेट किए गए iPhone से रीफ़्रेश करें."}},"ar":{"stringUnit":{"state":"translated","value":"حدّث هذه المطالبة من جهاز iPhone محدّث قبل الرد."}},"it":{"stringUnit":{"state":"translated","value":"Aggiorna questa richiesta da un iPhone aggiornato prima di rispondere."}},"tr":{"stringUnit":{"state":"translated","value":"Yanıtlamadan önce bu istemi güncellenmiş bir iPhone'dan yenileyin."}},"uk":{"stringUnit":{"state":"translated","value":"Оновіть цей запит з оновленого iPhone, перш ніж відповідати."}},"id":{"stringUnit":{"state":"translated","value":"Segarkan prompt ini dari iPhone yang telah diperbarui sebelum membalas."}},"pl":{"stringUnit":{"state":"translated","value":"Odśwież ten monit ze zaktualizowanego iPhone'a przed udzieleniem odpowiedzi."}},"th":{"stringUnit":{"state":"translated","value":"รีเฟรชพรอมต์นี้จาก iPhone ที่อัปเดตแล้วก่อนตอบกลับ."}},"vi":{"stringUnit":{"state":"translated","value":"Làm mới lời nhắc này từ iPhone đã cập nhật trước khi trả lời."}},"nl":{"stringUnit":{"state":"translated","value":"Vernieuw deze prompt vanaf een bijgewerkte iPhone voordat je antwoordt."}},"fa":{"stringUnit":{"state":"translated","value":"پیش از پاسخ دادن، این درخواست را از یک iPhone به‌روز تازه‌سازی کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Обновите этот запрос с iPhone с актуальной версией ПО перед ответом."}},"sv":{"stringUnit":{"state":"translated","value":"Uppdatera den här förfrågan från en uppdaterad iPhone innan du svarar."}}}},
    "Refresh this thread before changing its capabilities.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Refresh this thread before changing its capabilities."}},"zh-CN":{"stringUnit":{"state":"translated","value":"更改此会话的功能前请先刷新。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"變更此討論串的功能前，請先重新整理。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Atualize esta conversa antes de alterar seus recursos."}},"de":{"stringUnit":{"state":"translated","value":"Diesen Thread aktualisieren, bevor seine Funktionen geändert werden."}},"es":{"stringUnit":{"state":"translated","value":"Actualiza este hilo antes de cambiar sus capacidades."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このスレッドの機能を変更する前に更新してください。"}},"ko":{"stringUnit":{"state":"translated","value":"이 스레드의 기능을 변경하기 전에 새로고침하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Actualisez ce fil avant de modifier ses fonctionnalités."}},"hi":{"stringUnit":{"state":"translated","value":"इस थ्रेड की क्षमताएँ बदलने से पहले इसे रीफ़्रेश करें."}},"ar":{"stringUnit":{"state":"translated","value":"حدّث سلسلة المحادثة هذه قبل تغيير إمكاناتها."}},"it":{"stringUnit":{"state":"translated","value":"Aggiorna questa conversazione prima di modificarne le funzionalità."}},"tr":{"stringUnit":{"state":"translated","value":"Yeteneklerini değiştirmeden önce bu konuşmayı yenileyin."}},"uk":{"stringUnit":{"state":"translated","value":"Оновіть цю гілку, перш ніж змінювати її можливості."}},"id":{"stringUnit":{"state":"translated","value":"Segarkan utas ini sebelum mengubah kemampuannya."}},"pl":{"stringUnit":{"state":"translated","value":"Odśwież ten wątek przed zmianą jego możliwości."}},"th":{"stringUnit":{"state":"translated","value":"รีเฟรชเธรดนี้ก่อนเปลี่ยนความสามารถ."}},"vi":{"stringUnit":{"state":"translated","value":"Làm mới chuỗi hội thoại này trước khi thay đổi các khả năng của nó."}},"nl":{"stringUnit":{"state":"translated","value":"Vernieuw dit gesprek voordat je de mogelijkheden ervan wijzigt."}},"fa":{"stringUnit":{"state":"translated","value":"پیش از تغییر قابلیت‌های این رشته‌گفتگو، آن را تازه‌سازی کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Обновите эту ветку перед изменением её возможностей."}},"sv":{"stringUnit":{"state":"translated","value":"Uppdatera den här tråden innan du ändrar dess funktioner."}}}},
    "Refreshing connection, discovery, and device trust state.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Refreshing connection, discovery, and device trust state."}},"zh-CN":{"stringUnit":{"state":"translated","value":"正在刷新连接、发现和设备信任状态。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"正在重新整理連線、探索及裝置信任狀態。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Atualizando o estado da conexão, da descoberta e da confiança dos dispositivos."}},"de":{"stringUnit":{"state":"translated","value":"Verbindungs-, Erkennungs- und Gerätevertrauensstatus werden aktualisiert."}},"es":{"stringUnit":{"state":"translated","value":"Actualizando el estado de conexión, detección y confianza del dispositivo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"接続、検出、デバイスの信頼状態を更新しています。"}},"ko":{"stringUnit":{"state":"translated","value":"연결, 검색 및 기기 신뢰 상태를 새로고침하는 중입니다."}},"fr":{"stringUnit":{"state":"translated","value":"Actualisation de l’état de la connexion, de la découverte et de la confiance des appareils."}},"hi":{"stringUnit":{"state":"translated","value":"कनेक्शन, खोज और डिवाइस की विश्वसनीयता की स्थिति रीफ़्रेश की जा रही है."}},"ar":{"stringUnit":{"state":"translated","value":"جارٍ تحديث حالة الاتصال والاكتشاف والثقة بالأجهزة."}},"it":{"stringUnit":{"state":"translated","value":"Aggiornamento dello stato della connessione, del rilevamento e dell'attendibilità dei dispositivi."}},"tr":{"stringUnit":{"state":"translated","value":"Bağlantı, keşif ve cihaz güven durumu yenileniyor."}},"uk":{"stringUnit":{"state":"translated","value":"Оновлення стану з’єднання, виявлення та довіри до пристроїв."}},"id":{"stringUnit":{"state":"translated","value":"Menyegarkan status koneksi, penemuan, dan kepercayaan perangkat."}},"pl":{"stringUnit":{"state":"translated","value":"Odświeżanie stanu połączenia, wykrywania i zaufania do urządzeń."}},"th":{"stringUnit":{"state":"translated","value":"กำลังรีเฟรชสถานะการเชื่อมต่อ การค้นหา และความเชื่อถืออุปกรณ์."}},"vi":{"stringUnit":{"state":"translated","value":"Đang làm mới trạng thái kết nối, khám phá và độ tin cậy của thiết bị."}},"nl":{"stringUnit":{"state":"translated","value":"Verbinding, detectie en vertrouwensstatus van apparaten worden vernieuwd."}},"fa":{"stringUnit":{"state":"translated","value":"در حال تازه‌سازی وضعیت اتصال، شناسایی و اعتماد به دستگاه."}},"ru":{"stringUnit":{"state":"translated","value":"Обновление состояния подключения, обнаружения и доверия к устройствам."}},"sv":{"stringUnit":{"state":"translated","value":"Uppdaterar anslutning, identifiering och enheternas tillitsstatus."}}}},
    "Refreshing from iPhone…": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Refreshing from iPhone…"}},"zh-CN":{"stringUnit":{"state":"translated","value":"正在从 iPhone 刷新…"}},"zh-TW":{"stringUnit":{"state":"translated","value":"正在從 iPhone 重新整理…"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Atualizando a partir do iPhone…"}},"de":{"stringUnit":{"state":"translated","value":"Daten vom iPhone werden aktualisiert…"}},"es":{"stringUnit":{"state":"translated","value":"Actualizando desde el iPhone…"}},"ja-JP":{"stringUnit":{"state":"translated","value":"iPhone から更新中…"}},"ko":{"stringUnit":{"state":"translated","value":"iPhone에서 새로고침 중…"}},"fr":{"stringUnit":{"state":"translated","value":"Actualisation depuis l’iPhone…"}},"hi":{"stringUnit":{"state":"translated","value":"iPhone से रीफ़्रेश किया जा रहा है…"}},"ar":{"stringUnit":{"state":"translated","value":"جارٍ التحديث من iPhone…"}},"it":{"stringUnit":{"state":"translated","value":"Aggiornamento da iPhone…"}},"tr":{"stringUnit":{"state":"translated","value":"iPhone'dan yenileniyor…"}},"uk":{"stringUnit":{"state":"translated","value":"Оновлення з iPhone…"}},"id":{"stringUnit":{"state":"translated","value":"Menyegarkan dari iPhone…"}},"pl":{"stringUnit":{"state":"translated","value":"Odświeżanie danych z iPhone'a…"}},"th":{"stringUnit":{"state":"translated","value":"กำลังรีเฟรชจาก iPhone…"}},"vi":{"stringUnit":{"state":"translated","value":"Đang làm mới từ iPhone…"}},"nl":{"stringUnit":{"state":"translated","value":"Vernieuwen vanaf iPhone…"}},"fa":{"stringUnit":{"state":"translated","value":"در حال تازه‌سازی از iPhone…"}},"ru":{"stringUnit":{"state":"translated","value":"Обновление с iPhone…"}},"sv":{"stringUnit":{"state":"translated","value":"Uppdaterar från iPhone…"}}}},
    "Relay remains available; direct mode adds an independent Gateway node.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Relay remains available; direct mode adds an independent Gateway node."}},"zh-CN":{"stringUnit":{"state":"translated","value":"中继仍然可用; 直连模式会添加一个独立的 Gateway 节点。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"中繼仍可使用; 直接模式會新增獨立的 Gateway 節點。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A retransmissão continua disponível; o modo direto adiciona um nó Gateway independente."}},"de":{"stringUnit":{"state":"translated","value":"Relay bleibt verfügbar; der Direktmodus fügt einen unabhängigen Gateway-Knoten hinzu."}},"es":{"stringUnit":{"state":"translated","value":"La retransmisión sigue disponible; el modo directo añade un nodo Gateway independiente."}},"ja-JP":{"stringUnit":{"state":"translated","value":"リレーは引き続き利用できます; ダイレクトモードでは独立したGatewayノードが追加されます。"}},"ko":{"stringUnit":{"state":"translated","value":"릴레이는 계속 사용할 수 있습니다; 직접 모드는 독립적인 Gateway 노드를 추가합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le relais reste disponible ; le mode direct ajoute un nœud Gateway indépendant."}},"hi":{"stringUnit":{"state":"translated","value":"रिले उपलब्ध रहता है; प्रत्यक्ष मोड एक स्वतंत्र Gateway नोड जोड़ता है।"}},"ar":{"stringUnit":{"state":"translated","value":"يظل الترحيل متاحًا; ويضيف الوضع المباشر عقدة Gateway مستقلة."}},"it":{"stringUnit":{"state":"translated","value":"Il relay rimane disponibile; la modalità diretta aggiunge un nodo Gateway indipendente."}},"tr":{"stringUnit":{"state":"translated","value":"Aktarma kullanılabilir durumda kalır; doğrudan mod bağımsız bir Gateway düğümü ekler."}},"uk":{"stringUnit":{"state":"translated","value":"Ретранслятор залишається доступним; прямий режим додає незалежний вузол Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Relai tetap tersedia; mode langsung menambahkan simpul Gateway independen."}},"pl":{"stringUnit":{"state":"translated","value":"Połączenie pośredniczone pozostaje dostępne; tryb bezpośredni dodaje niezależny węzeł Gateway."}},"th":{"stringUnit":{"state":"translated","value":"รีเลย์ยังคงใช้งานได้; โหมดโดยตรงจะเพิ่มโหนด Gateway ที่ทำงานอย่างอิสระ."}},"vi":{"stringUnit":{"state":"translated","value":"Chuyển tiếp vẫn khả dụng; chế độ trực tiếp bổ sung một nút Gateway độc lập."}},"nl":{"stringUnit":{"state":"translated","value":"De relay blijft beschikbaar; de directe modus voegt een onafhankelijk Gateway-knooppunt toe."}},"fa":{"stringUnit":{"state":"translated","value":"رله همچنان در دسترس است; حالت مستقیم یک گره مستقل Gateway اضافه می‌کند."}},"ru":{"stringUnit":{"state":"translated","value":"Ретранслятор остаётся доступным; прямой режим добавляет независимый узел Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Reläet förblir tillgängligt; direktläget lägger till en oberoende Gateway-nod."}}}},
    "Remote Domain": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Remote Domain"}},"zh-CN":{"stringUnit":{"state":"translated","value":"远程域名"}},"zh-TW":{"stringUnit":{"state":"translated","value":"遠端網域"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Domínio Remoto"}},"de":{"stringUnit":{"state":"translated","value":"Remote-Domain"}},"es":{"stringUnit":{"state":"translated","value":"Dominio Remoto"}},"ja-JP":{"stringUnit":{"state":"translated","value":"リモートドメイン"}},"ko":{"stringUnit":{"state":"translated","value":"원격 도메인"}},"fr":{"stringUnit":{"state":"translated","value":"Domaine distant"}},"hi":{"stringUnit":{"state":"translated","value":"रिमोट डोमेन"}},"ar":{"stringUnit":{"state":"translated","value":"النطاق البعيد"}},"it":{"stringUnit":{"state":"translated","value":"Dominio remoto"}},"tr":{"stringUnit":{"state":"translated","value":"Uzak Alan Adı"}},"uk":{"stringUnit":{"state":"translated","value":"Віддалений домен"}},"id":{"stringUnit":{"state":"translated","value":"Domain Jarak Jauh"}},"pl":{"stringUnit":{"state":"translated","value":"Domena zdalna"}},"th":{"stringUnit":{"state":"translated","value":"โดเมนระยะไกล"}},"vi":{"stringUnit":{"state":"translated","value":"Tên miền từ xa"}},"nl":{"stringUnit":{"state":"translated","value":"Extern domein"}},"fa":{"stringUnit":{"state":"translated","value":"دامنه راه دور"}},"ru":{"stringUnit":{"state":"translated","value":"Удалённый домен"}},"sv":{"stringUnit":{"state":"translated","value":"Fjärrdomän"}}}},
    "Remove attachments or wait for delivery before archiving or deleting this thread.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Remove attachments or wait for delivery before archiving or deleting this thread."}},"zh-CN":{"stringUnit":{"state":"translated","value":"请移除附件或等待传送完成后，再归档或删除此对话。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"請先移除附件或等待傳送完成，再封存或刪除此討論串。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Remova os anexos ou aguarde a entrega antes de arquivar ou excluir esta conversa."}},"de":{"stringUnit":{"state":"translated","value":"Entferne Anhänge oder warte auf die Zustellung, bevor du diesen Thread archivierst oder löschst."}},"es":{"stringUnit":{"state":"translated","value":"Elimina los archivos adjuntos o espera a que se entreguen antes de archivar o eliminar este hilo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このスレッドをアーカイブまたは削除する前に、添付ファイルを削除するか、送信が完了するまでお待ちください。"}},"ko":{"stringUnit":{"state":"translated","value":"이 스레드를 보관하거나 삭제하기 전에 첨부 파일을 제거하거나 전송이 완료될 때까지 기다리세요."}},"fr":{"stringUnit":{"state":"translated","value":"Supprimez les pièces jointes ou attendez leur livraison avant d’archiver ou de supprimer ce fil de discussion."}},"hi":{"stringUnit":{"state":"translated","value":"इस थ्रेड को आर्काइव करने या हटाने से पहले अटैचमेंट हटाएँ या डिलीवरी की प्रतीक्षा करें।"}},"ar":{"stringUnit":{"state":"translated","value":"أزل المرفقات أو انتظر التسليم قبل أرشفة سلسلة المحادثة هذه أو حذفها."}},"it":{"stringUnit":{"state":"translated","value":"Rimuovi gli allegati o attendi la consegna prima di archiviare o eliminare questa conversazione."}},"tr":{"stringUnit":{"state":"translated","value":"Bu konuyu arşivlemeden veya silmeden önce ekleri kaldırın ya da teslim edilmelerini bekleyin."}},"uk":{"stringUnit":{"state":"translated","value":"Видаліть вкладення або дочекайтеся доставки, перш ніж архівувати чи видаляти цю гілку."}},"id":{"stringUnit":{"state":"translated","value":"Hapus lampiran atau tunggu hingga pengiriman selesai sebelum mengarsipkan atau menghapus utas ini."}},"pl":{"stringUnit":{"state":"translated","value":"Usuń załączniki lub poczekaj na dostarczenie przed zarchiwizowaniem lub usunięciem tego wątku."}},"th":{"stringUnit":{"state":"translated","value":"ลบไฟล์แนบหรือรอให้ส่งเสร็จก่อนเก็บถาวรหรือลบเธรดนี้"}},"vi":{"stringUnit":{"state":"translated","value":"Xóa tệp đính kèm hoặc chờ gửi xong trước khi lưu trữ hoặc xóa luồng này."}},"nl":{"stringUnit":{"state":"translated","value":"Verwijder bijlagen of wacht tot ze zijn afgeleverd voordat u dit gesprek archiveert of verwijdert."}},"fa":{"stringUnit":{"state":"translated","value":"پیش از بایگانی یا حذف این رشته، پیوست‌ها را حذف کنید یا منتظر تحویل بمانید."}},"ru":{"stringUnit":{"state":"translated","value":"Удалите вложения или дождитесь доставки, прежде чем архивировать или удалять эту ветку."}},"sv":{"stringUnit":{"state":"translated","value":"Ta bort bilagor eller vänta på leverans innan du arkiverar eller tar bort den här tråden."}}}},
    "Remove attachments or wait for delivery to resolve before starting a new chat.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Remove attachments or wait for delivery to resolve before starting a new chat."}},"zh-CN":{"stringUnit":{"state":"translated","value":"请先移除附件或等待发送结束，再开始新聊天。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"開始新聊天前，請先移除附件或等待傳送狀態確定。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Remova os anexos ou aguarde a entrega ser concluída antes de iniciar uma nova conversa."}},"de":{"stringUnit":{"state":"translated","value":"Entfernen Sie Anhänge oder warten Sie auf die Zustellung, bevor Sie einen neuen Chat starten."}},"es":{"stringUnit":{"state":"translated","value":"Elimina los archivos adjuntos o espera a que se resuelva la entrega antes de iniciar un nuevo chat."}},"ja-JP":{"stringUnit":{"state":"translated","value":"新しいチャットを開始する前に、添付ファイルを削除するか送信が完了するのを待ってください。"}},"ko":{"stringUnit":{"state":"translated","value":"새 채팅을 시작하기 전에 첨부 파일을 제거하거나 전송이 처리될 때까지 기다리세요."}},"fr":{"stringUnit":{"state":"translated","value":"Supprimez les pièces jointes ou attendez la livraison avant de démarrer une nouvelle conversation."}},"hi":{"stringUnit":{"state":"translated","value":"नई चैट शुरू करने से पहले अटैचमेंट हटाएं या डिलीवरी पूरी होने की प्रतीक्षा करें।"}},"ar":{"stringUnit":{"state":"translated","value":"أزِل المرفقات أو انتظر اكتمال التسليم قبل بدء محادثة جديدة."}},"it":{"stringUnit":{"state":"translated","value":"Rimuovi gli allegati o attendi l'esito della consegna prima di avviare una nuova chat."}},"tr":{"stringUnit":{"state":"translated","value":"Yeni bir sohbet başlatmadan önce ekleri kaldırın ya da iletim işleminin sonuçlanmasını bekleyin."}},"uk":{"stringUnit":{"state":"translated","value":"Видаліть вкладення або зачекайте на завершення доставлення, перш ніж починати новий чат."}},"id":{"stringUnit":{"state":"translated","value":"Hapus lampiran atau tunggu pengiriman selesai sebelum memulai obrolan baru."}},"pl":{"stringUnit":{"state":"translated","value":"Usuń załączniki lub poczekaj na zakończenie dostarczania przed rozpoczęciem nowego czatu."}},"th":{"stringUnit":{"state":"translated","value":"ลบไฟล์แนบหรือรอให้การส่งเสร็จสิ้นก่อนเริ่มแชทใหม่"}},"vi":{"stringUnit":{"state":"translated","value":"Xóa các tệp đính kèm hoặc đợi quá trình gửi hoàn tất trước khi bắt đầu cuộc trò chuyện mới."}},"nl":{"stringUnit":{"state":"translated","value":"Verwijder bijlagen of wacht tot de bezorging is voltooid voordat je een nieuwe chat start."}},"fa":{"stringUnit":{"state":"translated","value":"پیش از شروع گفتگوی جدید، پیوست‌ها را حذف کنید یا منتظر تعیین وضعیت تحویل بمانید."}},"ru":{"stringUnit":{"state":"translated","value":"Удалите вложения или дождитесь завершения доставки, прежде чем начать новый чат."}},"sv":{"stringUnit":{"state":"translated","value":"Ta bort bilagor eller vänta tills leveransen är klar innan du startar en ny chatt."}}}},
    "Remove attachments or wait for delivery to resolve before switching chats.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Remove attachments or wait for delivery to resolve before switching chats."}},"zh-CN":{"stringUnit":{"state":"translated","value":"请先移除附件或等待发送结束，再切换聊天。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"切換聊天前，請先移除附件或等待傳送狀態確定。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Remova os anexos ou aguarde a resolução da entrega antes de trocar de chat."}},"de":{"stringUnit":{"state":"translated","value":"Entfernen Sie die Anhänge oder warten Sie, bis der Zustellvorgang abgeschlossen ist, bevor Sie den Chat wechseln."}},"es":{"stringUnit":{"state":"translated","value":"Elimina los archivos adjuntos o espera a que se resuelva la entrega antes de cambiar de chat."}},"ja-JP":{"stringUnit":{"state":"translated","value":"チャットを切り替える前に、添付ファイルを削除するか、送信処理が完了するまでお待ちください。"}},"ko":{"stringUnit":{"state":"translated","value":"채팅을 전환하기 전에 첨부 파일을 제거하거나 전송이 처리될 때까지 기다리세요."}},"fr":{"stringUnit":{"state":"translated","value":"Supprimez les pièces jointes ou attendez la fin de l’envoi avant de changer de discussion."}},"hi":{"stringUnit":{"state":"translated","value":"चैट बदलने से पहले अटैचमेंट हटाएँ या डिलीवरी पूरी होने की प्रतीक्षा करें."}},"ar":{"stringUnit":{"state":"translated","value":"أزل المرفقات أو انتظر حسم حالة التسليم قبل التبديل بين الدردشات."}},"it":{"stringUnit":{"state":"translated","value":"Rimuovi gli allegati o attendi l'esito della consegna prima di passare a un'altra chat."}},"tr":{"stringUnit":{"state":"translated","value":"Sohbetler arasında geçiş yapmadan önce ekleri kaldırın ya da iletim işleminin sonuçlanmasını bekleyin."}},"uk":{"stringUnit":{"state":"translated","value":"Видаліть вкладення або дочекайтеся завершення доставки, перш ніж перемикатися між чатами."}},"id":{"stringUnit":{"state":"translated","value":"Hapus lampiran atau tunggu hingga proses pengiriman selesai sebelum beralih obrolan."}},"pl":{"stringUnit":{"state":"translated","value":"Usuń załączniki lub poczekaj na zakończenie dostarczania przed przełączeniem czatu."}},"th":{"stringUnit":{"state":"translated","value":"ลบไฟล์แนบหรือรอให้การส่งเสร็จสิ้นก่อนสลับแชท"}},"vi":{"stringUnit":{"state":"translated","value":"Xóa các tệp đính kèm hoặc đợi quá trình gửi hoàn tất trước khi chuyển cuộc trò chuyện."}},"nl":{"stringUnit":{"state":"translated","value":"Verwijder bijlagen of wacht tot de bezorging is afgehandeld voordat je van chat wisselt."}},"fa":{"stringUnit":{"state":"translated","value":"پیش از جابه‌جایی بین گفتگوها، پیوست‌ها را حذف کنید یا منتظر تعیین وضعیت تحویل بمانید."}},"ru":{"stringUnit":{"state":"translated","value":"Удалите вложения или дождитесь завершения доставки, прежде чем переключаться между чатами."}},"sv":{"stringUnit":{"state":"translated","value":"Ta bort bilagor eller vänta tills leveransen är klar innan du byter chatt."}}}},
