    "Allow microphone access in Settings to start voice.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allow microphone access in Settings to start voice."}},"zh-CN":{"stringUnit":{"state":"translated","value":"请在“设置”中允许访问麦克风，以启动语音。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"請在「設定」中允許存取麥克風，以啟動語音。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Permita o acesso ao microfone nos Ajustes para iniciar a voz."}},"de":{"stringUnit":{"state":"translated","value":"Erlaube den Mikrofonzugriff in den Einstellungen, um die Sprachfunktion zu starten."}},"es":{"stringUnit":{"state":"translated","value":"Permite el acceso al micrófono en Ajustes para iniciar el modo de voz."}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声機能を開始するには、設定でマイクへのアクセスを許可してください。"}},"ko":{"stringUnit":{"state":"translated","value":"음성 기능을 시작하려면 설정에서 마이크 접근을 허용하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Autorisez l’accès au microphone dans Réglages pour démarrer le mode vocal."}},"hi":{"stringUnit":{"state":"translated","value":"वॉइस शुरू करने के लिए सेटिंग्स में माइक्रोफ़ोन ऐक्सेस की अनुमति दें।"}},"ar":{"stringUnit":{"state":"translated","value":"اسمح بالوصول إلى الميكروفون في الإعدادات لبدء المحادثة الصوتية."}},"it":{"stringUnit":{"state":"translated","value":"Consenti l'accesso al microfono nelle Impostazioni per avviare la modalità vocale."}},"tr":{"stringUnit":{"state":"translated","value":"Sesli iletişimi başlatmak için Ayarlar'dan mikrofon erişimine izin verin."}},"uk":{"stringUnit":{"state":"translated","value":"Дозвольте доступ до мікрофона в налаштуваннях, щоб почати голосове спілкування."}},"id":{"stringUnit":{"state":"translated","value":"Izinkan akses mikrofon di Pengaturan untuk mulai menggunakan suara."}},"pl":{"stringUnit":{"state":"translated","value":"Zezwól na dostęp do mikrofonu w Ustawieniach, aby rozpocząć rozmowę głosową."}},"th":{"stringUnit":{"state":"translated","value":"อนุญาตให้เข้าถึงไมโครโฟนในการตั้งค่าเพื่อเ