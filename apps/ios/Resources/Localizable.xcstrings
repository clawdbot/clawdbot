    "Delivery could not be confirmed. Check Chat on iPhone before sending again.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delivery could not be confirmed. Check Chat on iPhone before sending again."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法确认是否已送达。再次发送前，请检查 iPhone 上的聊天。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法確認是否已送達。再次傳送前，請先查看 iPhone 上的聊天。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível confirmar a entrega. Verifique o Chat no iPhone antes de enviar novamente."}},"de":{"stringUnit":{"state":"translated","value":"Die Zustellung konnte nicht bestätigt werden. Prüfe den Chat auf dem iPhone, bevor du erneut sendest."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo confirmar la entrega. Revisa el chat en el iPhone antes de volver a enviar."}},"ja-JP":{"stringUnit":{"state":"translated","value":"配信を確認できませんでした。再送信する前にiPhoneのチャットを確認してください。"}},"ko":{"stringUnit":{"state":"translated","value":"전송 여부를 확인할 수 없습니다. 다시 보내기 전에 iPhone에서 채팅을 확인하세요."}},"fr":{"stringUnit":{"state":"translated","value":"L’envoi n’a pas pu être confirmé. Vérifiez la discussion sur l’iPhone avant de renvoyer."}},"hi":{"stringUnit":{"state":"translated","value":"डिलीवरी की पुष्टि नहीं हो सकी। दोबारा भेजने से पहले iPhone पर चैट देखें।"}},"ar":{"stringUnit":{"state":"translated","value":"تعذر تأكيد التسليم. تحقق من الدردشة على iPhone قبل الإرسال مجددًا."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile confermare la consegna. Controlla la chat su iPhone prima di inviare di nuovo."}},"tr":{"stringUnit":{"state":"translated","value":"Teslimat doğrulanamadı. Yeniden göndermeden önce iPhone'daki Sohbet'i kontrol edin."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося підтвердити доставку. Перевірте чат на iPhone, перш ніж надсилати знову."}},"id":{"stringUnit":{"state":"translated","value":"Pengiriman tidak dapat dikonfirmasi. Periksa Obrolan di iPhone sebelum mengirim lagi."}},"p