    "Voice received an invalid network port.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Voice received an invalid network port."}},"zh-CN":{"stringUnit":{"state":"translated","value":"语音收到了无效的网络端口。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語音收到無效的網路連接埠。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O recurso de voz recebeu uma porta de rede inválida."}},"de":{"stringUnit":{"state":"translated","value":"Die Sprachfunktion hat einen ungültigen Netzwerkport empfangen."}},"es":{"stringUnit":{"state":"translated","value":"La función de voz recibió un puerto de red no válido."}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声で無効なネットワークポートを受信しました。"}},"ko":{"stringUnit":{"state":"translated","value":"음성 연결에서 잘못된 네트워크 포트를 수신했습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le mode vocal a reçu un port réseau non valide."}},"hi":{"stringUnit":{"state":"translated","value":"वॉइस को एक अमान्य नेटवर्क पोर्ट मिला।"}},"ar":{"stringUnit":{"state":"translated","value":"تلقى الاتصال الصوتي منفذ شبكة غير صالح."}},"it":{"stringUnit":{"state":"translated","value":"La modalità vocale ha ricevuto una porta di rete non valida."}},"tr":{"stringUnit":{"state":"translated","value":"Ses için geçersiz bir ağ bağlantı noktası alındı."}},"uk":{"stringUnit":{"state":"translated","value":"Голосовий зв’язок отримав некоректний мережевий порт."}},"id":{"stringUnit":{"state":"translated","value":"Suara menerima port jaringan yang tidak valid."}},"pl":{"stringUnit":{"state":"translated","value":"Połączenie głosowe otrzymało nieprawidłowy port sieciowy."}},"th":{"stringUnit":{"state":"translated","value":"ระบบเสียงได้รับพอร์ตเครือข่ายที่ไม่ถูกต้อง"}},"vi":{"stringUnit":{"state":"translated","value":"Tính năng thoại đã nhận được cổng mạng không hợp lệ."}},"nl":{"stringUnit":{"state":"translated","value":"Er is een ongeldige netwerkpoort ontvangen voor spraak."}},"fa":{"stringUnit":{"state":"translated","value":"قابلیت صوتی یک درگاه شبکهٔ