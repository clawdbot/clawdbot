    "Voice ended.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Voice ended."}},"zh-CN":{"stringUnit":{"state":"translated","value":"语音已结束。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語音已結束。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A sessão de voz foi encerrada."}},"de":{"stringUnit":{"state":"translated","value":"Die Sprachsitzung wurde beendet."}},"es":{"stringUnit":{"state":"translated","value":"La sesión de voz finalizó."}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声が終了しました。"}},"ko":{"stringUnit":{"state":"translated","value":"음성이 종료되었습니다."}},"fr":{"stringUnit":{"state":"translated","value":"La session vocale est terminée."}},"hi":{"stringUnit":{"state":"translated","value":"वॉइस समाप्त हो गया।"}},"ar":{"stringUnit":{"state":"translated","value":"انتهت الجلسة الصوتية."}},"it":{"stringUnit":{"state":"translated","value":"Sessione vocale terminata."}},"tr":{"stringUnit":{"state":"translated","value":"Sesli iletişim sona erdi."}},"uk":{"stringUnit":{"state":"translated","value":"Голосовий сеанс завершено."}},"id":{"stringUnit":{"state":"translated","value":"Sesi suara berakhir."}},"pl":{"stringUnit":{"state":"translated","value":"Tryb głosowy został zakończony."}},"th":{"stringUnit":{"state":"translated","value":"การใช้งานเสียงสิ้นสุดแล้ว"}},"vi":{"stringUnit":{"state":"translated","value":"Phiên giọng nói đã kết thúc."}},"nl":{"stringUnit":{"state":"translated","value":"De spraaksessie is beëindigd."}},"fa":{"stringUnit":{"state":"translated","value":"حالت صوتی پایان یافت."}},"ru":{"stringUnit":{"state":"translated","value":"Голосовой сеанс завершён."}},"sv":{"stringUnit":{"state":"translated","value":"Röstsessionen avslutades."}}}},
    "Voice exhausted its network candidate budget.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Voice exhausted its network candidate budget."}},"zh-CN":{"stringUnit":{"state":"translated","value":"语音功能已用尽网络候选地址配额。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語音功能已用盡網路候選項目的配額。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O recurso de voz esgotou seu limite de candidatos de rede."}},"de":{"stringUnit":{"state":"translated","value":"Die Sprachfunktion hat ihr Limit für Netzwerkkandidaten erreicht."}},"es":{"stringUnit":{"state":"translated","value":"La función de voz agotó su límite de candidatos de red."}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声機能のネットワーク候補数が上限に達しました。"}},"ko":{"stringUnit":{"state":"translated","value":"음성 기능이 네트워크 후보 허용 한도를 모두 소진했습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le mode vocal a épuisé son quota de candidats réseau."}},"hi":{"stringUnit":{"state":"translated","value":"वॉइस की नेटवर्क कैंडिडेट सीमा पूरी हो गई।"}},"ar":{"stringUnit":{"state":"translated","value":"استنفدت الميزة الصوتية الحد المسموح به لخيارات الاتصال بالشبكة."}},"it":{"stringUnit":{"state":"translated","value":"La modalità vocale ha esaurito il limite di candidati di rete."}},"tr":{"stringUnit":{"state":"translated","value":"Sesli iletişim, ağ adayı sınırına ulaştı."}},"uk":{"stringUnit":{"state":"translated","value":"Голосовий режим вичерпав ліміт кандидатів мережевого з’єднання."}},"id":{"stringUnit":{"state":"translated","value":"Fitur suara telah mencapai batas kandidat jaringan."}},"pl":{"stringUnit":{"state":"translated","value":"Tryb głosowy wyczerpał limit kandydatów sieciowych."}},"th":{"stringUnit":{"state":"translated","value":"ฟีเจอร์เสียงใช้ตัวเลือกการเชื่อมต่อเครือข่ายครบตามขีดจำกัดแล้ว"}},"vi":{"stringUnit":{"state":"translated","value":"Tính năng giọng nói đã dùng hết giới hạn ứng viên mạng."}},"nl":{"stringUnit":{"state":"translated","value":"De spraakfunctie heeft de limiet voor netwerkkandidaten bereikt."}},"fa":{"stringUnit":{"state":"translated","value":"حالت صوتی به سقف مجاز بررسی گزینه‌های اتصال شبکه رسید."}},"ru":{"stringUnit":{"state":"translated","value":"Исчерпан лимит сетевых кандидатов для голосового соединения."}},"sv":{"stringUnit":{"state":"translated","value":"Röstfunktionen har nått gränsen för antalet nätverkskandidater."}}}},
    "Voice has no ready media route.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Voice has no ready media route."}},"zh-CN":{"stringUnit":{"state":"translated","value":"语音功能没有就绪的媒体路由。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語音功能沒有已就緒的媒體路由。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O recurso de voz não tem nenhuma rota de mídia pronta."}},"de":{"stringUnit":{"state":"translated","value":"Für die Sprachfunktion ist kein Medienübertragungsweg bereit."}},"es":{"stringUnit":{"state":"translated","value":"La función de voz no tiene ninguna ruta multimedia lista."}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声機能に使用可能なメディアルートがありません。"}},"ko":{"stringUnit":{"state":"translated","value":"음성 기능에 준비된 미디어 경로가 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Aucune route multimédia n’est prête pour le mode vocal."}},"hi":{"stringUnit":{"state":"translated","value":"वॉइस के लिए कोई मीडिया रूट तैयार नहीं है।"}},"ar":{"stringUnit":{"state":"translated","value":"لا يتوفر للميزة الصوتية مسار جاهز للوسائط."}},"it":{"stringUnit":{"state":"translated","value":"La modalità vocale non dispone di un percorso multimediale pronto."}},"tr":{"stringUnit":{"state":"translated","value":"Sesli iletişim için hazır bir medya yolu yok."}},"uk":{"stringUnit":{"state":"translated","value":"У голосовому режимі немає готового маршруту передавання медіаданих."}},"id":{"stringUnit":{"state":"translated","value":"Fitur suara tidak memiliki rute media yang siap digunakan."}},"pl":{"stringUnit":{"state":"translated","value":"Tryb głosowy nie ma gotowej ścieżki transmisji multimediów."}},"th":{"stringUnit":{"state":"translated","value":"ฟีเจอร์เสียงไม่มีเส้นทางสื่อที่พร้อมใช้งาน"}},"vi":{"stringUnit":{"state":"translated","value":"Tính năng giọng nói không có tuyến truyền phương tiện nào sẵn sàng."}},"nl":{"stringUnit":{"state":"translated","value":"Er is geen mediaroute gereed voor de spraakfunctie."}},"fa":{"stringUnit":{"state":"tra