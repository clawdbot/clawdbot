    "Could not forget %@.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Could not forget %@."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法忘记 %@."}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法忘記 %@."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível esquecer %@."}},"de":{"stringUnit":{"state":"translated","value":"%@ konnte nicht entfernt werden."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo olvidar %@."}},"ja-JP":{"stringUnit":{"state":"translated","value":"%@ の登録を解除できませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"%@의 저장 정보를 삭제하지 못했습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Impossible d’oublier %@."}},"hi":{"stringUnit":{"state":"translated","value":"%@ को भुलाया नहीं जा सका."}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر نسيان %@."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile dimenticare %@."}},"tr":{"stringUnit":{"state":"translated","value":"%@ unutulamadı."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося забути %@."}},"id":{"stringUnit":{"state":"translated","value":"Tidak dapat melupakan %@."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się zapomnieć %@."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถลืม %@ ได้."}},"vi":{"stringUnit":{"state":"translated","value":"Không thể quên %@."}},"nl":{"stringUnit":{"state":"translated","value":"Kon %@ niet vergeten."}},"fa":{"stringUnit":{"state":"translated","value":"فراموش کردن %@ ممکن نشد."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось забыть %@."}},"sv":{"stringUnit":{"state":"translated","value":"Kunde inte glömma %@."}}}},
    "Could not load saved Watch messages. Try again after unlocking iPhone.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Could not load saved Watch messages. Try again after unlocking iPhone."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法加载已保存的 Watch 消息。 请解锁 iPhone 后重试。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法載入已儲存的 Watch 訊息。 請解鎖 iPhone 後再試一次。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível carregar as mensagens salvas do Watch. Tente novamente após desbloquear o iPhone."}},"de":{"stringUnit":{"state":"translated","value":"Gespeicherte Watch-Nachrichten konnten nicht geladen werden. Nach dem Entsperren des iPhone erneut versuchen."}},"es":{"stringUnit":{"state":"translated","value":"No se pudieron cargar los mensajes guardados de Watch. Inténtalo de nuevo después de desbloquear el iPhone."}},"ja-JP":{"stringUnit":{"state":"translated","value":"保存済みの Watch メッセージを読み込めませんでした。 iPhone のロックを解除してから再試行してください。"}},"ko":{"stringUnit":{"state":"translated","value":"저장된 Watch 메시지를 불러오지 못했습니다. iPhone의 잠금을 해제한 후 다시 시도하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Impossible de charger les messages Watch enregistrés. Réessayez après avoir déverrouillé l’iPhone."}},"hi":{"stringUnit":{"state":"translated","value":"Watch के सहेजे गए संदेश लोड नहीं किए जा सके. iPhone अनलॉक करने के बाद फिर से कोशिश करें."}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر تحميل رسائل Watch المحفوظة. حاول مجددًا بعد فتح قفل iPhone."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile caricare i messaggi salvati di Watch. Riprova dopo aver sbloccato iPhone."}},"tr":{"stringUnit":{"state":"translated","value":"Kaydedilmiş Watch mesajları yüklenemedi. iPhone'un kilidini açtıktan sonra tekrar deneyin."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося завантажити збережені повідомлення Watch. Спробуйте ще раз після розблокування iPhone."}},"id":{"stringUnit":{"state":"translated","value":"Tidak dapat memuat pesan Watch yang tersimpan. Coba lagi setelah membuka kunci iPhone."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się wczytać zapisanych wiadomości Watch. Spróbuj ponownie po odblokowaniu iPhone'a."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถโหลดข้อความ Watch ที่บันทึกไว้ได้. ลองอีกครั้งหลังจากปลดล็อก iPhone."}},"vi":{"stringUnit":{"state":"translated","value":"Không thể tải tin nhắn Watch đã lưu. Hãy thử lại sau khi mở khóa iPhone."}},"nl":{"stringUnit":{"state":"translated","value":"Kon opgeslagen Watch-berichten niet laden. Probeer het opnieuw nadat je de iPhone hebt ontgrendeld."}},"fa":{"stringUnit":{"state":"translated","value":"بارگذاری پیام‌های ذخیره‌شدهٔ Watch ممکن نشد. پس از باز کردن قفل iPhone دوباره تلاش کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось загрузить сохранённые сообщения Watch. Повторите попытку после разблокировки iPhone."}},"sv":{"stringUnit":{"state":"translated","value":"Kunde inte läsa in sparade Watch-meddelanden. Försök igen efter att du har låst upp iPhone."}}}},
    "Could not load: %@. Retry.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Could not load: %@. Retry."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法加载: %@. 请重试。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法載入: %@. 請重試。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível carregar: %@. Tente novamente."}},"de":{"stringUnit":{"state":"translated","value":"Laden fehlgeschlagen: %@. Erneut versuchen."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo cargar: %@. Inténtalo de nuevo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"読み込めませんでした: %@. 再試行してください。"}},"ko":{"stringUnit":{"state":"translated","value":"불러오지 못했습니다: %@. 다시 시도하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Impossible de charger : %@. Réessayez."}},"hi":{"stringUnit":{"state":"translated","value":"लोड नहीं किया जा सका: %@. फिर से कोशिश करें."}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر التحميل: %@. أعد المحاولة."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile caricare: %@. Riprova."}},"tr":{"stringUnit":{"state":"translated","value":"Yüklenemedi: %@. Tekrar deneyin."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося завантажити: %@. Спробуйте ще раз."}},"id":{"stringUnit":{"state":"translated","value":"Tidak dapat memuat: %@. Coba lagi."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się wczytać: %@. Spróbuj ponownie."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถโหลดได้: %@. ลองอีกครั้ง."}},"vi":{"stringUnit":{"state":"translated","value":"Không thể tải: %@. Thử lại."}},"nl":{"stringUnit":{"state":"translated","value":"Kon niet laden: %@. Probeer het opnieuw."}},"fa":{"stringUnit":{"state":"translated","value":"بارگذاری ممکن نشد: %@. دوباره تلاش کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось загрузить: %@. Повторите попытку."}},"sv":{"stringUnit":{"state":"translated","value":"Kunde inte läsa in: %@. För