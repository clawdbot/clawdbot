    "Pair a gateway to make it available here.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Pair a gateway to make it available here."}},"zh-CN":{"stringUnit":{"state":"translated","value":"配对一个 Gateway 即可在此处使用。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"配對 Gateway 即可在此使用。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Pareie um gateway para disponibilizá-lo aqui."}},"de":{"stringUnit":{"state":"translated","value":"Koppeln Sie ein Gateway, um es hier verfügbar zu machen."}},"es":{"stringUnit":{"state":"translated","value":"Vincula un Gateway para que esté disponible aquí."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayをペアリングすると、ここで利用できるようになります。"}},"ko":{"stringUnit":{"state":"translated","value":"여기에서 사용할 수 있도록 Gateway를 페어링하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Associez une passerelle pour la rendre disponible ici."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway को यहाँ उपलब्ध कराने के लिए उसे पेयर करें."}},"ar":{"stringUnit":{"state":"translated","value":"أقرن Gateway لإتاحته هنا."}},"it":{"stringUnit":{"state":"translated","value":"Associa un Gateway per renderlo disponibile qui."}},"tr":{"stringUnit":{"state":"translated","value":"Burada kullanılabilir hale getirmek için bir Gateway eşleştirin."}},"uk":{"stringUnit":{"state":"translated","value":"Створіть пару з Gateway, щоб він став доступним тут."}},"id":{"stringUnit":{"state":"translated","value":"Pasangkan Gateway agar tersedia di sini."}},"pl":{"stringUnit":{"state":"translated","value":"Sparuj Gateway, aby był tutaj dostępny."}},"th":{"stringUnit":{"state":"translated","value":"จับคู่ Gateway เพื่อให้ใช้งานได้ที่นี่"}},"vi":{"stringUnit":{"state":"translated","value":"Ghép đôi một Gateway để có thể sử dụng tại đây."}},"nl":{"stringUnit":{"state":"translated","value":"Koppel een gateway om deze hier beschikbaar te maken."}},"fa":{"stringUnit":{"state":"translated","value":"یک Gateway را جفت‌سازی کنید تا در اینجا د