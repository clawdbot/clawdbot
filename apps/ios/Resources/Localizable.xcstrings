    "For local iOS app development": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"For local iOS app development"}},"zh-CN":{"stringUnit":{"state":"translated","value":"用于本地 iOS 应用开发"}},"zh-TW":{"stringUnit":{"state":"translated","value":"用於本機 iOS 應用程式開發"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Para desenvolvimento local de apps iOS"}},"de":{"stringUnit":{"state":"translated","value":"Für die lokale iOS-App-Entwicklung"}},"es":{"stringUnit":{"state":"translated","value":"Para el desarrollo local de aplicaciones iOS"}},"ja-JP":{"stringUnit":{"state":"translated","value":"ローカルでのiOSアプリ開発用"}},"ko":{"stringUnit":{"state":"translated","value":"로컬 iOS 앱 개발용"}},"fr":{"stringUnit":{"state":"translated","value":"Pour le développement local d’apps iOS"}},"hi":{"stringUnit":{"state":"translated","value":"स्थानीय iOS ऐप विकास के लिए"}},"ar":{"stringUnit":{"state":"translated","value":"لتطوير تطبيقات iOS محليًا"}},"it":{"stringUnit":{"state":"translated","value":"Per lo sviluppo locale di app iOS"}},"tr":{"stringUnit":{"state":"translated","value":"Yerel iOS uygulaması geliştirmek için"}},"uk":{"stringUnit":{"state":"translated","value":"Для локальної розробки застосунків iOS"}},"id":{"stringUnit":{"state":"translated","value":"Untuk pengembangan aplikasi iOS lokal"}},"pl":{"stringUnit":{"state":"translated","value":"Do lokalnego tworzenia aplikacji na iOS"}},"th":{"stringUnit":{"state":"translated","value":"สำหรับการพัฒนาแอป iOS บนเครื่อง"}},"vi":{"stringUnit":{"state":"translated","value":"Dành cho việc phát triển ứng dụng iOS cục bộ"}},"nl":{"stringUnit":{"state":"translated","value":"Voor lokale iOS-appontwikkeling"}},"fa":{"stringUnit":{"state":"translated","value":"برای توسعهٔ محلی برنامهٔ iOS"}},"ru":{"stringUnit":{"state":"translated","value":"Для локальной разработки приложений iOS"}},"sv":{"stringUnit":{"state":"translated","value":"För lokal utveckling av iOS-appar"}}}},
    "Foreground approvals still appear while OpenClaw is connected.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Foreground approvals still appear while OpenClaw is connected."}},"zh-CN":{"stringUnit":{"state":"translated","value":"OpenClaw 连接期间仍会显示前台审批请求。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw 連線期間，前景核准請求仍會顯示。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"As aprovações em primeiro plano continuam aparecendo enquanto o OpenClaw está conectado."}},"de":{"stringUnit":{"state":"translated","value":"Genehmigungsanfragen im Vordergrund werden weiterhin angezeigt, während OpenClaw verbunden ist."}},"es":{"stringUnit":{"state":"translated","value":"Las solicitudes de aprobación en primer plano siguen apareciendo mientras OpenClaw está conectado."}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClawに接続中も、フォアグラウンドの承認リクエストは表示されます。"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw가 연결된 동안에도 포그라운드 승인 요청은 계속 표시됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les demandes d’approbation au premier plan continuent de s’afficher tant qu’OpenClaw est connecté."}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw के कनेक्ट रहने के दौरान भी फ़ोरग्राउंड में अनुमति अनुरोध दिखाई देते हैं."}},"ar":{"stringUnit":{"state":"translated","value":"تظل طلبات الموافقة تظهر في المقدمة أثناء اتصال OpenClaw."}},"it":{"stringUnit":{"state":"translated","value":"Le richieste di approvazione in primo piano continuano a comparire mentre OpenClaw è connesso."}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw bağlıyken ön plan onayları görünmeye devam eder."}},"uk":{"stringUnit":{"state":"translated","value":"Запити на схвалення й надалі з’являються на передньому плані, поки OpenClaw підключено."}},"id":{"stringUnit":{"state":"translated","value":"Persetujuan latar depan tetap muncul selama OpenClaw terhubung."}},"pl":{"stringUnit":{"state":"translated","value":"Prośby o zatwierdzenie na pierwszym planie nadal pojawiają się, gdy OpenClaw jest połączony."}},"th":{"stringUnit":{"state":"translated","value":"คำขออนุมัติยังคงปรากฏเมื่อแอปอยู่เบื้องหน้าขณะที่ OpenClaw เชื่อมต่ออยู่."}},"vi":{"stringUnit":{"state":"translated","value":"Yêu cầu phê duyệt vẫn xuất hiện ở tiền cảnh khi OpenClaw được kết nối."}},"nl":{"stringUnit":{"state":"translated","value":"Goedkeuringsverzoeken op de voorgrond blijven verschijnen terwijl OpenClaw verbonden is."}},"fa":{"stringUnit":{"state":"translated","value":"درخواست‌های تأیید در پیش‌زمینه همچنان هنگام اتصال OpenClaw نمایش داده می‌شوند."}},"ru":{"stringUnit":{"state":"translated","value":"Запросы на подтверждение по-прежнему появляются на переднем плане, пока OpenClaw подключён."}},"sv":{"stringUnit":{"state":"translated","value":"Förfrågningar om godkännande visas fortfarande i förgrunden medan OpenClaw är anslutet."}}}},
    "Foreground location requests are allowed.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Foreground location requests are allowed."}},"zh-CN":{"stringUnit":{"state":"translated","value":"已允许前台位置请求。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已允許前景定位請求。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"As solicitações de localização em primeiro plano são permitidas."}},"de":{"stringUnit":{"state":"translated","value":"Standortanfragen im Vordergrund sind erlaubt."}},"es":{"stringUnit":{"state":"translated","value":"Se permiten las solicitudes de ubicación en primer plano."}},"ja-JP":{"stringUnit":{"state":"translated","value":"フォアグラウンドでの位置情報リクエストは許可されています。"}},"ko":{"stringUnit":{"state":"translated","value":"포그라운드 위치 요청이 허용됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les demandes de localisation au premier plan sont autorisées."}},"hi":{"stringUnit":{"state":"translated","value":"फ़ोरग्राउंड में स्थान के अनुरोधों की अनुमति है."}},"ar":{"stringUnit":{"state":"translated","value":"يُسمح بطلبات الموقع في المقدمة."}},"it":{"stringUnit":{"state":"translated","value":"Le richieste di posizione in primo piano sono consentite."}},"tr":{"stringUnit":{"state":"translated","value":"Ön planda konum isteklerine izin veriliyor."}},"uk":{"stringUnit":{"state":"translated","value":"Запити геопозиції на передньому плані дозволено."}},"id":{"stringUnit":{"state":"translated","value":"Permintaan lokasi di latar depan diizinkan."}},"pl":{"stringUnit":{"state":"translated","value":"Żądania lokalizacji na pierwszym planie są dozwolone."}},"th":{"stringUnit":{"state":"translated","value":"อนุญาตคำขอตำแหน่งที่ตั้งเมื่อแอปอยู่เบื้องหน้า."}},"vi":{"stringUnit":{"state":"translated","value":"Cho phép yêu cầu vị trí ở tiền cảnh."}},"nl":{"stringUnit":{"state":"translated","value":"Locatieverzoeken op de voorgrond zijn toegestaan."}},"fa":{"stringUnit":{"state":"translated","value":"درخواست‌های موقعیت مکانی در پیش‌زمینه مجاز هستند."}},"r