    "Archived sessions will appear here.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Archived sessions will appear here."}},"zh-CN":{"stringUnit":{"state":"translated","value":"已归档的会话将显示在此处。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已封存的工作階段會顯示在這裡。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"As sessões arquivadas aparecerão aqui."}},"de":{"stringUnit":{"state":"translated","value":"Archivierte Sitzungen werden hier angezeigt."}},"es":{"stringUnit":{"state":"translated","value":"Las sesiones archivadas aparecerán aquí."}},"ja-JP":{"stringUnit":{"state":"translated","value":"アーカイブ済みのセッションがここに表示されます。"}},"ko":{"stringUnit":{"state":"translated","value":"보관된 세션이 여기에 표시됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les sessions archivées apparaîtront ici."}},"hi":{"stringUnit":{"state":"translated","value":"संग्रहित सत्र यहाँ दिखाई देंगे।"}},"ar":{"stringUnit":{"state":"translated","value":"ستظهر الجلسات المؤرشفة هنا."}},"it":{"stringUnit":{"state":"translated","value":"Le sessioni archiviate appariranno qui."}},"tr":{"stringUnit":{"state":"translated","value":"Arşivlenen oturumlar burada görünecek."}},"uk":{"stringUnit":{"state":"translated","value":"Тут з’являтимуться архівовані сеанси."}},"id":{"stringUnit":{"state":"translated","value":"Sesi yang diarsipkan akan muncul di sini."}},"pl":{"stringUnit":{"state":"translated","value":"Tutaj pojawią się zarchiwizowane sesje."}},"th":{"stringUnit":{"state":"translated","value":"เซสชันที่เก็บถาวรจะปรากฏที่นี่."}},"vi":{"stringUnit":{"state":"translated","value":"Các phiên đã lưu trữ sẽ xuất hiện ở đây."}},"nl":{"stringUnit":{"state":"translated","value":"Gearchiveerde sessies verschijnen hier."}},"fa":{"stringUnit":{"state":"translated","value":"نشست‌های بایگانی‌شده اینجا نمایش داده می‌شوند."}},"ru":{"stringUnit":{"state":"translated","value":"Здесь появятся архивные сеансы."}},"sv":{"stringUnit":{"state":"translated","value":"Arkiverade sessioner visas här."}}}},
