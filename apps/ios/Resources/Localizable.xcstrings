    "Voice access requires a new setup from iPhone Settings.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Voice access requires a new setup from iPhone Settings."}},"zh-CN":{"stringUnit":{"state":"translated","value":"需要在 iPhone 设置中重新设置才能使用语音功能。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語音存取需要在 iPhone 設定中重新設定。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O acesso por voz exige uma nova configuração nos Ajustes do iPhone."}},"de":{"stringUnit":{"state":"translated","value":"Der Sprachzugriff muss in den iPhone-Einstellungen neu eingerichtet werden."}},"es":{"stringUnit":{"state":"translated","value":"El acceso por voz requiere una nueva configuración desde los ajustes del iPhone."}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声アクセスには、iPhoneの設定から再設定が必要です。"}},"ko":{"stringUnit":{"state":"translated","value":"음성 접근을 사용하려면 iPhone 설정에서 새로 설정해야 합니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’accès vocal nécessite une nouvelle configuration dans les réglages de l’iPhone."}},"hi":{"stringUnit":{"state":"translated","value":"वॉइस एक्सेस के लिए iPhone की सेटिंग्स से नया सेटअप करना आवश्यक है।"}},"ar":{"stringUnit":{"state":"translated","value":"يتطلب الوصول الصوتي إعدادًا جديدًا من إعدادات iPhone."}},"it":{"stringUnit":{"state":"translated","value":"L'accesso vocale richiede una nuova configurazione nelle impostazioni di iPhone."}},"tr":{"stringUnit":{"state":"translated","value":"Sesli erişim için iPhone Ayarları'ndan yeniden kurulum yapılması gerekiyor."}},"uk":{"stringUnit":{"state":"translated","value":"Для голосового доступу потрібне повторне налаштування в параметрах iPhone."}},"id":{"stringUnit":{"state":"translated","value":"Akses suara memerlukan pengaturan ulang melalui Pengaturan iPhone."}},"pl":{"stringUnit":{"state":"translated","value":"Dostęp głosowy wymaga ponownej konfiguracji w ustawieniach iPhone’a."}},"th":{"stringUnit":{"state":"translated","value":"การเข้าถึงเสียงต้องตั้งค่าใหม่จากการต