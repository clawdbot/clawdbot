    "No paired gateway is available to reconnect.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No paired gateway is available to reconnect."}},"zh-CN":{"stringUnit":{"state":"translated","value":"没有可用于重新连接的已配对网关。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"沒有已配對的 Gateway 可供重新連線。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Nenhum Gateway pareado está disponível para reconexão."}},"de":{"stringUnit":{"state":"translated","value":"Kein gekoppeltes Gateway zum erneuten Verbinden verfügbar."}},"es":{"stringUnit":{"state":"translated","value":"No hay ningún Gateway emparejado disponible para volver a conectarse."}},"ja-JP":{"stringUnit":{"state":"translated","value":"再接続できるペアリング済みのゲートウェイはありません。"}},"ko":{"stringUnit":{"state":"translated","value":"다시 연결할 수 있는 페어링된 Gateway가 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Aucune passerelle appairée n’est disponible pour la reconnexion."}},"hi":{"stringUnit":{"state":"translated","value":"फिर से कनेक्ट करने के लिए कोई पेयर किया गया Gateway उपलब्ध नहीं है."}},"ar":{"stringUnit":{"state":"translated","value":"لا يتوفر Gateway مقترن لإعادة الاتصال."}},"it":{"stringUnit":{"state":"translated","value":"Nessun gateway abbinato disponibile per la riconnessione."}},"tr":{"stringUnit":{"state":"translated","value":"Yeniden bağlanmak için eşleştirilmiş bir Gateway yok."}},"uk":{"stringUnit":{"state":"translated","value":"Немає сполученого Gateway для повторного підключення."}},"id":{"stringUnit":{"state":"translated","value":"Tidak ada Gateway yang telah dipasangkan yang tersedia untuk disambungkan kembali."}},"pl":{"stringUnit":{"state":"translated","value":"Brak sparowanego Gateway, z którym można ponownie nawiązać połączenie."}},"th":{"stringUnit":{"state":"translated","value":"ไม่มี Gateway ที่จับคู่ไว้พร้อมให้เชื่อมต่อใหม่."}},"vi":{"stringUnit":{"state":"translated","value":"Không có Gateway đã ghép đôi nào để kết nối lại."}},"nl":{"stringUnit":{"state":"translated","value":"Geen gekoppelde Gateway beschikbaar om opnieuw verbinding mee te maken."}},"fa":{"stringUnit":{"state":"translated","value":"هیچ درگاه جفت‌شده‌ای برای اتصال مجدد در دسترس نیست."}},"ru":{"stringUnit":{"state":"translated","value":"Нет сопряжённого шлюза для повторного подключения."}},"sv":{"stringUnit":{"state":"translated","value":"Ingen parkopplad Gateway är tillgänglig för återanslutning."}}}},
    "No provider credential is configured for this model. Set it up in Model Setup.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No provider credential is configured for this model. Set it up in Model Setup."}},"zh-CN":{"stringUnit":{"state":"translated","value":"尚未为此模型配置提供商凭据。 请在模型设置中进行配置。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"尚未為此模型設定供應商憑證。 請在模型設定中進行設定。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Nenhuma credencial de provedor está configurada para este modelo. Configure-a em Configuração do modelo."}},"de":{"stringUnit":{"state":"translated","value":"Für dieses Modell sind keine Anbieter-Zugangsdaten konfiguriert. Richten Sie diese in der Modelleinrichtung ein."}},"es":{"stringUnit":{"state":"translated","value":"No hay ninguna credencial de proveedor configurada para este modelo. Configúrala en Configuración del modelo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このモデルにはプロバイダーの認証情報が設定されていません。 モデル設定で設定してください。"}},"ko":{"stringUnit":{"state":"translated","value":"이 모델의 제공업체 인증 정보가 구성되지 않았습니다. 모델 설정에서 구성하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Aucun identifiant de fournisseur n’est configuré pour ce modèle. Configurez-le dans Configuration du modèle."}},"hi":{"stringUnit":{"state":"translated","value":"इस मॉडल के लिए प्रदाता का कोई क्रेडेंशियल कॉन्फ़िगर नहीं किया गया है. इसे मॉडल सेटअप में सेट करें."}},"ar":{"stringUnit":{"state":"translated","value":"لم يتم إعداد بيانات اعتماد موفر الخدمة لهذا النموذج. يمكنك إعدادها في إعداد النموذج."}},"it":{"stringUnit":{"state":"translated","value":"Nessuna credenziale del provider configurata per questo modello. Configurala in Configurazione modello."}},"tr":{"stringUnit":{"state":"translated","value":"Bu model için sağlayıcı kimlik bilgisi yapılandırılmamış. Model Kurulumu bölümünden yapılandırın."}},"uk":{"stringUnit":{"state":"translated","value":"Для цієї моделі не налаштовано облікові дані постачальника. Укажіть їх у розділі налаштування моделі."}},"id":{"stringUnit":{"state":"translated","value":"Tidak ada kredensial penyedia yang dikonfigurasi untuk model ini. Konfigurasikan di Pengaturan Model."}},"pl":{"stringUnit":{"state":"translated","value":"Nie skonfigurowano danych uwierzytelniających dostawcy dla tego modelu. Skonfiguruj je w sekcji Konfiguracja modelu."}},"th":{"stringUnit":{"state":"translated","value":"ยังไม่ได้กำหนดค่าข้อมูลรับรองของผู้ให้บริการสำหรับโมเดลนี้. ตั้งค่าได้ในการตั้งค่าโมเดล."}},"vi":{"stringUnit":{"state":"translated","value":"Chưa cấu hình thông tin xác thực của nhà cung cấp cho mô hình này. Hãy thiết lập trong phần Thiết lập mô hình."}},"nl":{"stringUnit":{"state":"translated","value":"Er zijn geen inloggegevens voor de provider geconfigureerd voor dit model. Stel deze in bij Modelconfiguratie."}},"fa":{"stringUnit":{"state":"translated","value":"هیچ اطلاعات احراز هویت ارائه‌دهنده‌ای برای این مدل پیکربندی نشده است. آن را در بخش راه‌اندازی مدل تنظیم کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Для этой модели не настроены учётные данные провайдера. Укажите их в разделе «Настройка модели»."}},"sv":{"stringUnit":{"state":"translated","value":"Inga inloggningsuppgifter för leverantören har konfigurerats för den här modellen. Konfigurera dem i modellkonfigurationen."}}}},
    "No ready agents": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No ready agents"}},"zh-CN":{"stringUnit":{"state":"translated","value":"没有就绪的智能体"}},"zh-TW":{"stringUnit":{"state":"translated","value":"沒有就緒的代理程式"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Nenhum agente pronto"}},"de":{"stringUnit":{"state":"translated","value":"Keine bereiten Agenten"}},"es":{"stringUnit":{"state":"translated","value":"No hay agentes listos"}},"ja-JP":{"stringUnit":{"state":"translated","value":"準備完了のエージェントはありません"}},"ko":{"stringUnit":{"state":"translated","value":"준비된 에이전트 없음"}},"fr":{"stringUnit":{"state":"translated","value":"Aucun agent prêt"}},"hi":{"stringUnit":{"state":"translated","value":"कोई एजेंट तैयार नहीं है"}},"ar":{"stringUnit":{"state":"translated","value":"لا يوجد وكلاء جاهزون"}},"it":{"stringUnit":{"state":"translated","value":"Nessun agente pronto"}},"tr":{"stringUnit":{"state":"translated","value":"Hazır aracı yok"}},"uk":{"stringUnit":{"state":"translated","value":"Немає готових агентів"}},"id":{"stringUnit":{"state":"translated","value":"Tidak ada agen yang siap"}},"pl":{"stringUnit":{"state":"translated","value":"Brak gotowych agentów"}},"th":{"stringUnit":{"state":"translated","value":"ไม่มีเอเจนต์ที่พร้อมใช้งาน"}},"vi":{"stringUnit":{"state":"translated","value":"Không có tác nhân nào sẵn sàng"}},"nl":{"stringUnit":{"state":"translated","value":"Geen agents gereed"}},"fa":{"stringUnit":{"state":"translated","value":"هیچ عامل آماده‌ای وجود ندارد"}},"ru":{"stringUnit":{"state":"translated","value":"Нет готовых агентов"}},"sv":{"stringUnit":{"state":"translated","value":"Inga redo agenter"}}}},
    "No recent activity": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No recent activity"}},"zh-CN":{"stringUnit":{"state":"translated","value":"没有近期活动"}},"zh-TW":{"stringUnit":{"state":"translated","value":"沒有近期活動"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Nenhuma atividade recente"}},"de":{"stringUnit":{"state":"translated","value":"Keine aktuellen Aktivitäten"}},"es":{"stringUnit":{"state":"translated","value":"No hay actividad reciente"}},"ja-JP":{"stringUnit":{"state":"translated","value":"最近のアクティビティはありません"}},"ko":{"stringUnit":{"state":"translated","value":"최근 활동 없음"}},"fr":{"stringUnit":{"state":"translated","value":"Aucune activité récente"}},"hi":{"stringUnit":{"state":"translated","value":"हाल में कोई गतिविधि नहीं हुई"}},"ar":{"stringUnit":{"state":"translated","value":"لا يوجد نشاط حديث"}},"it":{"stringUnit":{"state":"translated","value":"Nessuna attività recente"}},"tr":{"stringUnit":{"state":"translated","value":"Son etkinlik yok"}},"uk":{"stringUnit":{"state":"translated","value":"Немає нещодавньої активності"}},"id":{"stringUnit":{"state":"translated","value":"Tidak ada aktivitas terbaru"}},"pl":{"stringUnit":{"state":"translated","value":"Brak ostatniej aktywności"}},"th":{"stringUnit":{"state":"translated","value":"ไม่มีกิจกรรมล่าสุด"}},"vi":{"stringUnit":{"state":"translated","value":"Không có hoạt động gần đây"}},"nl":{"stringUnit":{"state":"translated","value":"Geen recente activiteit"}},"fa":{"stringUnit":{"state":"translated","value":"هیچ فعالیت اخیری وجود ندارد"}},"ru":{"stringUnit":{"state":"translated","value":"Нет недавней активности"}},"sv":{"stringUnit":{"state":"translated","value":"Ingen aktivitet på sistone"}}}},
    "No recent sessions": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No recent sessions"}},"zh-CN":{"stringUnit":{"state":"translated","value":"没有近期会话"}},"zh-TW":{"stringUnit":{"state":"translated","value":"沒有近期工作階段"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Nenhuma sessão recente"}},"de":{"stringUnit":{"state":"translated","value":"Keine aktuellen Sitzungen"}},"es":{"stringUnit":{"state":"translated","value":"No hay sesiones recientes"}},"ja-JP":{"stringUnit":{"state":"translated","value":"最近のセッションはありません"}},"ko":{"stringUnit":{"state":"translated","value":"최근 세션 없음"}},"fr":{"stringUnit":{"state":"translated","value":"Aucune session récente"}},"hi":{"stringUnit":{"state":"translated","value":"हाल में कोई सत्र नहीं हुआ"}},"ar":{"stringUnit":{"state":"translated","value":"لا توجد جلسات حديثة"}},"it":{"stringUnit":{"state":"translated","value":"Nessuna sessione recente"}},"tr":{"stringUnit":{"state":"translated","value":"Son oturum yok"}},"uk":{"stringUnit":{"state":"translated","value":"Немає нещодавніх сеансів"}},"id":{"stringUnit":{"state":"translated","value":"Tidak ada sesi terbaru"}},"pl":{"stringUnit":{"state":"translated","value":"Brak ostatnich sesji"}},"th":{"stringUnit":{"state":"translated","value":"ไม่มีเซสชันล่าสุด"}},"vi":{"stringUnit":{"state":"translated","value":"Không có phiên gần đây"}},"nl":{"stringUnit":{"state":"translated","value":"Geen recente sessies"}},"fa":{"stringUnit":{"state":"translated","value":"هیچ نشست اخیری وجود ندارد"}},"ru":{"stringUnit":{"state":"translated","value":"Нет недавних сеансов"}},"sv":{"stringUnit":{"state":"translated","value":"Inga sessioner på sistone"}}}},
    "No reply": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No reply"}},"zh-CN":{"stringUnit":{"state":"translated","value":"没有回复"}},"zh-TW":{"stringUnit":{"state":"translated","value":"沒有回覆"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Nenhuma resposta"}},"de":{"stringUnit":{"state":"translated","value":"Keine Antwort"}},"es":{"stringUnit":{"state":"translated","value":"Sin respuesta"}},"ja-JP":{"stringUnit":{"state":"translated","value":"返信なし"}},"ko":{"stringUnit":{"state":"translated","value":"답장 없음"}},"fr":{"stringUnit":{"state":"translated","value":"Aucune réponse"}},"hi":{"stringUnit":{"state":"translated","value":"कोई जवाब नहीं"}},"ar":{"stringUnit":{"state":"translated","value":"لا يوجد رد"}},"it":{"stringUnit":{"state":"translated","value":"Nessuna risposta"}},"tr":{"stringUnit":{"state":"translated","value":"Yanıt yok"}},"uk":{"stringUnit":{"state":"translated","value":"Немає відповіді"}},"id":{"stringUnit":{"state":"translated","value":"Tidak ada balasan"}},"pl":{"stringUnit":{"state":"translated","value":"Brak odpowiedzi"}},"th":{"stringUnit":{"state":"translated","value":"ไม่มีการตอบกลับ"}},"vi":{"stringUnit":{"state":"translated","value":"Không có phản hồi"}},"nl":{"stringUnit":{"state":"translated","value":"Geen antwoord"}},"fa":{"stringUnit":{"state":"translated","value":"بدون پاسخ"}},"ru":{"stringUnit":{"state":"translated","value":"Нет ответа"}},"sv":{"stringUnit":{"state":"translated","value":"Inget svar"}}}},
    "No running tasks": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No running tasks"}},"zh-CN":{"stringUnit":{"state":"translated","value":"没有正在运行的任务"}},"zh-TW":{"stringUnit":{"state":"translated","value":"沒有執行中的任務"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Nenhuma tarefa em execução"}},"de":{"stringUnit":{"state":"translated","value":"Keine laufenden Aufgaben"}},"es":{"stringUnit":{"state":"translated","value":"No hay tareas en ejecución"}},"ja-JP":{"stringUnit":{"state":"translated","value":"実行中のタスクはありません"}},"ko":{"stringUnit":{"state":"translated","value":"실행 중인 작업 없음"}},"fr":{"stringUnit":{"state":"translated","value":"Aucune tâche en cours"}},"hi":{"stringUnit":{"state":"translated","value":"कोई कार्य नहीं चल रहा है"}},"ar":{"stringUnit":{"state":"translated","value":"لا توجد مهام قيد التشغيل"}},"it":{"stringUnit":{"state":"translated","value":"Nessuna attività in esecuzione"}},"tr":{"stringUnit":{"state":"translated","value":"Çalışan görev yok"}},"uk":{"stringUnit":{"state":"translated","value":"Немає завдань, що виконуються"}},"id":{"stringUnit":{"state":"translated","value":"Tidak ada tugas yang berjalan"}},"pl":{"stringUnit":{"state":"translated","value":"Brak uruchomionych zadań"}},"th":{"stringUnit":{"state":"translated","value":"ไม่มีงานที่กำลังทำงาน"}},"vi":{"stringUnit":{"state":"translated","value":"Không có tác vụ đang chạy"}},"nl":{"stringUnit":{"state":"translated","value":"Geen actieve taken"}},"fa":{"stringUnit":{"state":"translated","value":"هیچ وظیفه‌ای در حال اجرا نیست"}},"ru":{"stringUnit":{"state":"translated","value":"Нет выполняющихся задач"}},"sv":{"stringUnit":{"state":"translated","value":"Inga pågående uppgifter"}}}},
    "No saved Watch messages": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No saved Watch messages"}},"zh-CN":{"stringUnit":{"state":"translated","value":"没有已保存的 Watch 消息"}},"zh-TW":{"stringUnit":{"state":"translated","value":"沒有已儲存的 Watch 訊息"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Nenhuma mensagem salva do Watch"}},"de":{"stringUnit":{"state":"translated","value":"Keine gespeicherten Watch-Nachrichten"}},"es":{"stringUnit":{"state":"translated","value":"No hay mensajes guardados del Watch"}},"ja-JP":{"stringUnit":{"state":"translated","value":"保存済みのWatchメッセージはありません"}},"ko":{"stringUnit":{"state":"translated","value":"저장된 Watch 메시지 없음"}},"fr":{"stringUnit":{"state":"translated","value":"Aucun message Watch enregistré"}},"hi":{"stringUnit":{"state":"translated","value":"Watch का कोई संदेश सहेजा नहीं गया है"}},"ar":{"stringUnit":{"state":"translated","value":"لا توجد رسائل Watch محفوظة"}},"it":{"stringUnit":{"state":"translated","value":"Nessun messaggio Watch salvato"}},"tr":{"stringUnit":{"state":"translated","value":"Kayıtlı Watch mesajı yok"}},"uk":{"stringUnit":{"state":"translated","value":"Немає збережених повідомлень Watch"}},"id":{"stringUnit":{"state":"translated","value":"Tidak ada pesan Watch yang tersimpan"}},"pl":{"stringUnit":{"state":"translated","value":"Brak zapisanych wiadomości z Watch"}},"th":{"stringUnit":{"state":"translated","value":"ไม่มีข้อความจาก Watch ที่บันทึกไว้"}},"vi":{"stringUnit":{"state":"translated","value":"Không có tin nhắn Watch đã lưu"}},"nl":{"stringUnit":{"state":"translated","value":"Geen opgeslagen Watch-berichten"}},"fa":{"stringUnit":{"state":"translated","value":"هیچ پیام ذخیره‌شده‌ای از Watch وجود ندارد"}},"ru":{"stringUnit":{"state":"translated","value":"Нет сохранённых сообщений Watch"}},"sv":{"stringUnit":{"state":"translated","value":"Inga sparade Watch-meddelanden"}}}},
    "No secure gateway endpoint was detected at %1$@:%2$@. Enable gateway TLS or Tailscale Serve, or use a trusted private LAN address with Unencrypted selected.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No secure gateway endpoint was detected at %1$@:%2$@. Enable gateway TLS or Tailscale Serve, or use a trusted private LAN address with Unencrypted selected."}},"zh-CN":{"stringUnit":{"state":"translated","value":"未在 %1$@:%2$@ 检测到安全的 Gateway 端点。请启用 Gateway TLS 或 Tailscale Serve，或选择“未加密”并使用受信任的私有局域网地址。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"未在 %1$@:%2$@ 偵測到安全的 Gateway 端點。請啟用 Gateway TLS 或 Tailscale Serve，或使用受信任的私人區域網路位址並選取「未加密」。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Nenhum endpoint seguro do Gateway foi detectado em %1$@:%2$@. Ative o TLS do Gateway ou o Tailscale Serve, ou use um endereço de LAN privada confiável com a opção Sem criptografia selecionada."}},"de":{"stringUnit":{"state":"translated","value":"Unter %1$@:%2$@ wurde kein sicherer Gateway-Endpunkt erkannt. Aktivieren Sie Gateway-TLS oder Tailscale Serve, oder verwenden Sie eine vertrauenswürdige private LAN-Adresse mit der Einstellung Unverschlüsselt."}},"es":{"stringUnit":{"state":"translated","value":"No se detectó ningún punto de conexión seguro del Gateway en %1$@:%2$@. Habilita TLS en el Gateway o Tailscale Serve, o usa una dirección LAN privada de confianza con la opción Sin cifrar seleccionada."}},"ja-JP":{"stringUnit":{"state":"translated","value":"%1$@:%2$@で安全なGatewayエンドポイントが検出されませんでした. GatewayのTLSまたはTailscale Serveを有効にするか、「暗号化なし」を選択して信頼できるプライベートLANアドレスを使用してください。"}},"ko":{"stringUnit":{"state":"translated","value":"%1$@:%2$@에서 보안 Gateway 엔드포인트가 감지되지 않았습니다. Gateway TLS 또는 Tailscale Serve를 활성화하거나, 암호화 안 함을 선택한 상태에서 신뢰할 수 있는 사설 LAN 주소를 사용하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Aucun point de terminaison sécurisé du Gateway n’a été détecté à %1$@:%2$@. Activez TLS sur le Gateway ou Tailscale Serve, ou utilisez une adresse de réseau local privé de confiance avec l’option Non chiffré sélectionnée."}},"hi":{"stringUnit":{"state":"translated","value":"%1$@:%2$@ पर कोई सुरक्षित Gateway एंडपॉइंट नहीं मिला. Gateway TLS या Tailscale Serve सक्षम करें, या अनएन्क्रिप्टेड विकल्प चुनकर किसी विश्वसनीय निजी LAN पते का उपयोग करें."}},"ar":{"stringUnit":{"state":"translated","value":"لم يتم اكتشاف نقطة نهاية آمنة لـ Gateway على %1$@:%2$@. فعّل TLS لـ Gateway أو Tailscale Serve، أو استخدم عنوان شبكة محلية خاصة موثوقًا مع تحديد خيار غير مشفّر."}},"it":{"stringUnit":{"state":"translated","value":"Non è stato rilevato alcun endpoint sicuro del gateway all'indirizzo %1$@:%2$@. Abilita TLS per il gateway o Tailscale Serve, oppure usa un indirizzo LAN privato attendibile con l'opzione Non crittografato selezionata."}},"tr":{"stringUnit":{"state":"translated","value":"%1$@:%2$@ adresinde güvenli bir Gateway uç noktası algılanmadı. Gateway TLS veya Tailscale Serve özelliğini etkinleştirin ya da Şifrelenmemiş seçiliyken güvenilir bir özel LAN adresi kullanın."}},"uk":{"stringUnit":{"state":"translated","value":"За адресою %1$@:%2$@ не виявлено захищеної кінцевої точки шлюзу. Увімкніть TLS для шлюзу або Tailscale Serve чи скористайтеся довіреною адресою приватної локальної мережі, вибравши «Без шифрування»."}},"id":{"stringUnit":{"state":"translated","value":"Tidak ada endpoint Gateway aman yang terdeteksi di %1$@:%2$@. Aktifkan TLS Gateway atau Tailscale Serve, atau gunakan alamat LAN pribadi tepercaya dengan opsi Tidak terenkripsi dipilih."}},"pl":{"stringUnit":{"state":"translated","value":"Nie wykryto bezpiecznego punktu końcowego bramy pod adresem %1$@:%2$@. Włącz TLS bramy lub Tailscale Serve albo użyj zaufanego prywatnego adresu LAN z wybraną opcją Bez szyfrowania."}},"th":{"stringUnit":{"state":"translated","value":"ไม่พบปลายทาง Gateway ที่ปลอดภัยที่ %1$@:%2$@. เปิดใช้งาน TLS ของ Gateway หรือ Tailscale Serve หรือใช้ที่อยู่ LAN ส่วนตัวที่เชื่อถือได้โดยเลือก ไม่เข้ารหัส."}},"vi":{"stringUnit":{"state":"translated","value":"Không phát hiện điểm cuối Gateway bảo mật tại %1$@:%2$@. Bật TLS cho Gateway hoặc Tailscale Serve, hoặc sử dụng địa chỉ LAN riêng đáng tin cậy và chọn Không mã hóa."}},"nl":{"stringUnit":{"state":"translated","value":"Er is geen beveiligd gateway-eindpunt gedetecteerd op %1$@:%2$@. Schakel gateway-TLS of Tailscale Serve in, of gebruik een vertrouwd privé-LAN-adres met Onversleuteld geselecteerd."}},"fa":{"stringUnit":{"state":"translated","value":"هیچ نقطهٔ پایانی امنی برای Gateway در %1$@:%2$@ شناسایی نشد. TLS را برای Gateway فعال کنید یا از Tailscale Serve استفاده کنید، یا با انتخاب گزینهٔ بدون رمزگذاری از یک آدرس شبکهٔ محلی خصوصی و قابل اعتماد استفاده کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Защищённая конечная точка шлюза по адресу %1$@:%2$@ не обнаружена. Включите TLS для шлюза или Tailscale Serve либо используйте доверенный адрес частной локальной сети, выбрав «Без шифрования»."}},"sv":{"stringUnit":{"state":"translated","value":"Ingen säker Gateway-slutpunkt upptäcktes på %1$@:%2$@. Aktivera TLS för Gateway eller Tailscale Serve, eller använd en betrodd privat LAN-adress med Okrypterad valt."}}}},
    "No sessions": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No sessions"}},"zh-CN":{"stringUnit":{"state":"translated","value":"没有会话"}},"zh-TW":{"stringUnit":{"state":"translated","value":"沒有工作階段"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Nenhuma sessão"}},"de":{"stringUnit":{"state":"translated","value":"Keine Sitzungen"}},"es":{"stringUnit":{"state":"translated","value":"No hay sesiones"}},"ja-JP":{"stringUnit":{"state":"translated","value":"セッションはありません"}},"ko":{"stringUnit":{"state":"translated","value":"세션 없음"}},"fr":{"stringUnit":{"state":"translated","value":"Aucune session"}},"hi":{"stringUnit":{"state":"translated","value":"कोई सत्र नहीं है"}},"ar":{"stringUnit":{"state":"translated","value":"لا توجد جلسات"}},"it":{"stringUnit":{"state":"translated","value":"Nessuna sessione"}},"tr":{"stringUnit":{"state":"translated","value":"Oturum yok"}},"uk":{"stringUnit":{"state":"translated","value":"Немає сеансів"}},"id":{"stringUnit":{"state":"translated","value":"Tidak ada sesi"}},"pl":{"stringUnit":{"state":"translated","value":"Brak sesji"}},"th":{"stringUnit":{"state":"translated","value":"ไม่มีเซสชัน"}},"vi":{"stringUnit":{"state":"translated","value":"Không có phiên nào"}},"nl":{"stringUnit":{"state":"translated","value":"Geen sessies"}},"fa":{"stringUnit":{"state":"translated","value":"هیچ نشستی وجود ندارد"}},"ru":{"stringUnit":{"state":"translated","value":"Нет сеансов"}},"sv":{"stringUnit":{"state":"translated","value":"Inga sessioner"}}}},
