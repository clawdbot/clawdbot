    "Gateway did not return a realtime relay session": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Gateway did not return a realtime relay session"}},"zh-CN":{"stringUnit":{"state":"translated","value":"Gateway 未返回实时中继会话"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 未傳回即時轉送工作階段"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Gateway não retornou uma sessão de retransmissão em tempo real"}},"de":{"stringUnit":{"state":"translated","value":"Das Gateway hat keine Echtzeit-Relay-Sitzung zurückgegeben"}},"es":{"stringUnit":{"state":"translated","value":"Gateway no devolvió una sesión de retransmisión en tiempo real"}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gateway がリアルタイムリレーセッションを返しませんでした"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway가 실시간 릴레이 세션을 반환하지 않았습니다"}},"fr":{"stringUnit":{"state":"translated","value":"Gateway n’a pas renvoyé de session de relais en temps réel"}},"hi":{"stringUnit":{"state":"translated","value":"Gateway ने रीयलटाइम रिले सत्र नहीं लौटाया"}},"ar":{"stringUnit":{"state":"translated","value":"لم يُرجع Gateway جلسة ترحيل في الوقت الفعلي"}},"it":{"stringUnit":{"state":"translated","value":"Gateway non ha restituito una sessione di inoltro in tempo reale"}},"tr":{"stringUnit":{"state":"translated","value":"Gateway gerçek zamanlı bir aktarma oturumu döndürmedi"}},"uk":{"stringUnit":{"state":"translated","value":"Gateway не повернув сеанс ретрансляції в реальному часі"}},"id":{"stringUnit":{"state":"translated","value":"Gateway tidak mengembalikan sesi relai waktu nyata"}},"pl":{"stringUnit":{"state":"translated","value":"Gateway nie zwrócił sesji pośredniczącej w czasie rzeczywistym"}},"th":{"stringUnit":{"state":"translated","value":"Gateway ไม่ได้ส่งคืนเซสชันรีเลย์แบบเรียลไทม์"}},"vi":{"stringUnit":{"state":"translated","value":"Gateway không trả về phiên chuyển tiếp thời gian thực"}},"nl":{"stringUnit":{"state":"translated","value":"Gateway heeft geen realtime relaysessie 