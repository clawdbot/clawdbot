/* OpenClaw source: "OpenClaw uses the camera when you scan a Gateway setup QR code or ask your paired Gateway or assistant to capture a photo or short video from this iPhone, for example to connect to your Gateway or show your assistant a document, device screen, or workspace." */
"NSCameraUsageDescription" = "OpenClaw використовує камеру, коли ви скануєте QR-код налаштування Gateway або просите сполучений Gateway чи асистента зробити фото або записати коротке відео на цьому iPhone, наприклад, щоб підключитися до свого Gateway або показати асистенту документ, екран пристрою чи робоче місце.";
/* OpenClaw source: "OpenClaw uses your contacts so you can search and reference people while using the assistant." */
"NSContactsUsageDescription" = "OpenClaw використовує ваші контакти, щоб ви могли шукати людей і посилатися на них під час роботи з асистентом.";
/* OpenClaw source: "OpenClaw reads your steps, sleep, resting heart rate, and workouts from the Apple Health app to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthShareUsageDescription" = "OpenClaw зчитує дані про ваші кроки, сон, пульс у стані спокою та тренування з програми Apple Health, щоб створювати зведення на ваш запит і надсилати їх через ваш Gateway до налаштованого постачальника ШІ.";
/* OpenClaw source: "OpenClaw does not write to the Apple Health app. It uses read-only data to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthUpdateUsageDescription" = "OpenClaw не записує дані в застосунок Apple Health. Він використовує дані лише для читання, щоб створювати зведення на ваш запит і надсилати їх через ваш Gateway до налаштованого постачальника ШІ.";
/* OpenClaw source: "OpenClaw discovers and connects to your OpenClaw gateway on the local network." */
"NSLocalNetworkUsageDescription" = "OpenClaw виявляє ваш шлюз OpenClaw у локальній мережі та підключається до нього.";
/* OpenClaw source: "OpenClaw can share your location in the background when you enable Always." */
"NSLocationAlwaysAndWhenInUseUsageDescription" = "OpenClaw може передавати ваше місцеположення у фоновому режимі, якщо ви ввімкнете опцію «Завжди».";
/* OpenClaw source: "OpenClaw uses your location when you allow location sharing." */
