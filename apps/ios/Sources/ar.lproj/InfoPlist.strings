/* OpenClaw source: "OpenClaw uses your calendars to show events and scheduling context when you enable calendar access." */
"NSCalendarsFullAccessUsageDescription" = "يستخدم OpenClaw تقاويمك لعرض الأحداث وسياق الجدولة عند تمكين الوصول إلى التقويم.";
/* OpenClaw source: "OpenClaw uses your calendars to show events and scheduling context when you enable calendar access." */
"NSCalendarsUsageDescription" = "يستخدم OpenClaw تقاويمك لعرض الأحداث وسياق الجدولة عند تمكين الوصول إلى التقويم.";
/* OpenClaw source: "OpenClaw uses your calendars to add events when you enable calendar access." */
"NSCalendarsWriteOnlyAccessUsageDescription" = "يستخدم OpenClaw تقاويمك لإضافة أحداث عند تمكين الوصول إلى التقويم.";
/* OpenClaw source: "OpenClaw uses the camera when you scan a Gateway setup QR code or ask your paired Gateway or assistant to capture a photo or short video from this iPhone, for example to connect to your Gateway or show your assistant a document, device screen, or workspace." */
"NSCameraUsageDescription" = "يستخدم OpenClaw الكاميرا عندما تمسح رمز QR لإعداد Gateway أو تطلب من Gateway المقترن أو مساعدك التقاط صورة أو مقطع فيديو قصير من جهاز iPhone هذا، على سبيل المثال للاتصال بـ Gateway أو لعرض مستند أو شاشة جهاز أو مساحة عمل على مساعدك.";
/* OpenClaw source: "OpenClaw uses your contacts so you can search and reference people while using the assistant." */
"NSContactsUsageDescription" = "يستخدم OpenClaw جهات اتصالك لتتمكن من البحث عن الأشخاص والإشارة إليهم أثناء استخدام المساعد.";
/* OpenClaw source: "OpenClaw reads your steps, sleep, resting heart rate, and workouts from the Apple Health app to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthShareUsageDescription" = "يقرأ OpenClaw خطواتك ونومك ومعدل نبض قلبك أثناء الراحة وتمارينك من تطبيق Apple Health لإنشاء الملخصات التي تطلبها وإرسالها عبر Gateway إلى مزود الذكاء الاصطناعي الذي أعددته.";
/* OpenClaw source: "OpenClaw does not write to the Apple Health app. It uses read-only data to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthUpdateUsageDescription" = "لا يكتب OpenClaw أي بيانات إلى تطبيق Apple Health. بل يستخدم البيانات بصلاحية القراءة فقط لإنشاء الملخصات التي تطلبها وإرسالها عبر Gateway إلى موفّر الذكاء الاصطناعي الذي أعددته.";
/* OpenClaw source: "OpenClaw discovers and connects to your OpenClaw gateway on the local network." */
"NSLocalNetworkUsageDescription" = "يكتشف OpenClaw بوابة OpenClaw على الشبكة المحلية ويتصل بها.";
/* OpenClaw source: "OpenClaw can share your location in the background when you enable Always." */
"NSLocationAlwaysAndWhenInUseUsageDescription" = "يمكن لـ OpenClaw مشاركة موقعك في الخلفية عند تمكين «دائمًا».";
/* OpenClaw source: "OpenClaw uses your location when you allow location sharing." */
"NSLocationWhenInUseUsageDescription" = "يستخدم OpenClaw موقعك عندما تسمح بمشاركة الموقع.";
/* OpenClaw source: "OpenClaw uses the microphone for realtime chat, voice wake, push-to-talk, and voice notes." */
"NSMicrophoneUsageDescription" = "يستخدم OpenClaw الميكروفون للدردشة في الوقت الفعلي، والتنشيط الصوتي، والضغط للتحدث، والملاحظات الصوتية.";
/* OpenClaw source: "OpenClaw may use motion data to support device-aware interactions and automations." */
"NSMotionUsageDescription" = "قد يستخدم OpenClaw بيانات الحركة لدعم التفاعلات وعمليات الأتمتة التي تراعي الجهاز.";
/* OpenClaw source: "OpenClaw lets your assistant read photos you allow and lets you choose photos to share." */
"NSPhotoLibraryUsageDescription" = "يتيح OpenClaw لمساعدك قراءة الصور التي تسمح بها، ويتيح لك اختيار الصور لمشاركتها.";
/* OpenClaw source: "OpenClaw uses your reminders to list, add, and complete tasks when you enable reminders access." */
"NSRemindersFullAccessUsageDescription" = "يستخدم OpenClaw تذكيراتك لعرض المهام وإضافتها وإكمالها عند تمكين الوصول إلى التذكيرات.";
/* OpenClaw source: "OpenClaw uses on-device speech recognition for talk mode and voice wake." */
"NSSpeechRecognitionUsageDescription" = "يستخدم OpenClaw ميزة التعرّف على الكلام على الجهاز لوضع التحدث والتنشيط الصوتي.";
