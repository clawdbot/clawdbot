    "Each selected thread and its transcript will be removed from the gateway.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Each selected thread and its transcript will be removed from the gateway."}},"zh-CN":{"stringUnit":{"state":"translated","value":"每个所选对话及其记录都将从 Gateway 中移除。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"每個所選的對話串及其文字記錄都將從 Gateway 中移除。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Cada conversa selecionada e sua transcrição serão removidas do Gateway."}},"de":{"stringUnit":{"state":"translated","value":"Jeder ausgewählte Thread und sein Transkript werden aus dem Gateway entfernt."}},"es":{"stringUnit":{"state":"translated","value":"Cada hilo seleccionado y su transcripción se eliminarán del Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"選択した各スレッドとその記録がGatewayから削除されます。"}},"ko":{"stringUnit":{"state":"translated","value":"선택한 각 스레드와 해당 대화 내용이 Gateway에서 삭제됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Chaque fil de discussion sélectionné et sa transcription seront supprimés du Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"हर चुना गया थ्रेड और उसका ट्रांसक्रिप्ट Gateway से हटा दिया जाएगा।"}},"ar":{"stringUnit":{"state":"translated","value":"ستُزال كل محادثة محددة وسجلها من Gateway."}},"it":{"stringUnit":{"state":"translated","value":"Ogni conversazione selezionata e la relativa trascrizione verranno rimosse dal gateway."}},"tr":{"stringUnit":{"state":"translated","value":"Seçili her iş parçacığı ve dökümü gateway'den kaldırılacak."}},"uk":{"stringUnit":{"state":"translated","value":"Кожну вибрану гілку та її стенограму буде видалено з Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Setiap utas yang dipilih beserta transkripnya akan dihapus dari Gateway."}},"pl":{"stringUnit":{"state":"translated","value":"Każdy wybrany wątek wraz z jego transkrypcją zostanie usunięty z Gateway."}},"th":{"stringUnit":{"state":"translated","value":"เธรดที่เลือกแต่ละรายการและบันทึกการสนทนาจะถูกลบออกจาก Gateway"}},"vi":{"stringUnit":{"state":"translated","value":"Mỗi luồng đã chọn và bản ghi của luồng đó sẽ bị xóa khỏi Gateway."}},"nl":{"stringUnit":{"state":"translated","value":"Elk geselecteerd gesprek en het bijbehorende transcript worden uit de gateway verwijderd."}},"fa":{"stringUnit":{"state":"translated","value":"هر رشته انتخاب‌شده و رونوشت آن از Gateway حذف خواهد شد."}},"ru":{"stringUnit":{"state":"translated","value":"Все выбранные ветки и их расшифровки будут удалены из Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Varje markerad tråd och dess transkript tas bort från gatewayen."}}}},
