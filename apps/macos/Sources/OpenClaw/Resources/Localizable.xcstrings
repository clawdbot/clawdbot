    "Agents can run shell commands on this Mac without allowlist checks.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Agents can run shell commands on this Mac without allowlist checks."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Agent 可以在此 Mac 上运行 Shell 命令，无需进行允许列表检查。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Agents 可在此 Mac 上執行 shell commands，無需允許清單檢查。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Agentes podem executar comandos de shell neste Mac sem verificações da lista de permissões."}},"de":{"stringUnit":{"state":"translated","value":"Agents können Shell-Befehle auf diesem Mac ohne Prüfung der Zulassungsliste ausführen."}},"es":{"stringUnit":{"state":"translated","value":"Los agentes pueden ejecutar comandos de shell en este Mac sin comprobaciones de la lista de permitidos."}},"ja-JP":{"stringUnit":{"state":"translated","value":"エージェントは、この Mac で許可リストのチェックなしにシェルコマンドを実行できます。"}},"ko":{"stringUnit":{"state":"translated","value":"에이전트가 이 Mac에서 허용 목록 확인 없이 셸 명령을 실행할 수 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les agents peuvent exécuter des commandes shell sur ce Mac sans vérification de la liste d’autorisation."}},"hi":{"stringUnit":{"state":"translated","value":"एजेंट इस Mac पर allowlist जाँचों के बिना shell कमांड चला सकते हैं।"}},"ar":{"stringUnit":{"state":"translated","value":"يمكن للوكلاء تشغيل أوامر Shell على جهاز Mac هذا دون التحقق من قائمة السماح."}},"it":{"stringUnit":{"state":"translated","value":"Gli agenti possono eseguire comandi shell su questo Mac senza controlli dell'elenco consentiti."}},"tr":{"stringUnit":{"state":"translated","value":"Ajanlar, bu Mac’te allowlist kontrolleri olmadan shell komutları çalıştırabilir."}},"uk":{"stringUnit":{"state":"translated","value":"Агенти можуть виконувати команди оболонки на цьому Mac без перевірок списку дозволених."}},"id":{"stringUnit":{"state":"translated","value":"Agent dapat menjalankan perintah shell di Mac ini tanpa pemeriksaan allowlist."}},"pl":{"stringUnit":{"state":"translated","value":"Agenci mogą uruchamiać polecenia powłoki na tym Macu bez sprawdzania listy dozwolonych."}},"th":{"stringUnit":{"state":"translated","value":"เอเจนต์สามารถเรียกใช้คำสั่งเชลล์บน Mac เครื่องนี้ได้โดยไม่ต้องตรวจสอบ allowlist"}},"vi":{"stringUnit":{"state":"translated","value":"Agent có thể chạy lệnh shell trên máy Mac này mà không cần kiểm tra danh sách cho phép."}},"nl":{"stringUnit":{"state":"translated","value":"Agents kunnen shell-opdrachten op deze Mac uitvoeren zonder allowlist-controles."}},"fa":{"stringUnit":{"state":"translated","value":"عامل‌ها می‌توانند فرمان‌های Shell را روی این Mac بدون بررسی فهرست مجاز اجرا کنند."}},"ru":{"stringUnit":{"state":"translated","value":"Агенты могут выполнять команды оболочки на этом Mac без проверок по списку разрешённых."}},"sv":{"stringUnit":{"state":"translated","value":"Agenter kan köra skalkommandon på denna Mac utan kontroller mot tillåtelselistan."}}}},
