    "Switch this Mac app to a local Gateway before importing browser cookies.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Switch this Mac app to a local Gateway before importing browser cookies."}},"zh-CN":{"stringUnit":{"state":"translated","value":"导入浏览器 Cookie 前，请将此 Mac 应用切换到本地 Gateway。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"匯入瀏覽器 Cookie 前，請先將此 Mac App 切換至本機 Gateway。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Altere este app para Mac para usar um Gateway local antes de importar cookies do navegador."}},"de":{"stringUnit":{"state":"translated","value":"Stellen Sie diese Mac-App auf ein lokales Gateway um, bevor Sie Browser-Cookies importieren."}},"es":{"stringUnit":{"state":"translated","value":"Cambia esta aplicación para Mac a un Gateway local antes de importar las cookies del navegador."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ブラウザのCookieをインポートする前に、このMacアプリをローカルのGatewayに切り替えてください。"}},"ko":{"stringUnit":{"state":"translated","value":"브라우저 쿠키를 가져오기 전에 이 Mac 앱을 로컬 Gateway로 전환하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Connectez cette application Mac à un Gateway local avant d’importer les cookies du navigateur."}},"hi":{"stringUnit":{"state":"translated","value":"ब्राउज़र कुकीज़ आयात करने से पहले इस Mac ऐप को स्थानीय Gateway पर स्विच करें।"}},"ar":{"stringUnit":{"state":"translated","value":"حوّل تطبيق Mac هذا إلى Gateway محلي قبل استيراد ملفات تعريف ارتباط المتصفح."}},"it":{"stringUnit":{"state":"translated","value":"Passa questa app per Mac a un Gateway locale prima di importare i cookie del browser."}},"tr":{"stringUnit":{"state":"translated","value":"Tarayıcı çerezlerini içe aktarmadan önce bu Mac uygulamasını yerel bir Gateway'e geçirin."}},"uk":{"stringUnit":{"state":"translated","value":"Перемкніть цей застосунок для Mac на локальний Gateway, перш ніж імпортувати файли cookie браузера."}},"id":{"stringUnit":{"state":"translated","value":"Alihkan aplikasi Mac ini ke Gateway 