    "Open Settings → Channels to link channels and monitor status.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open Settings → Channels to link channels and monitor status."}},"zh-CN":{"stringUnit":{"state":"translated","value":"打开“设置 → 频道”以关联频道并监控状态。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"開啟「設定」→「Channels」以連結 channels 並監控狀態。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Abra Ajustes → Canais para vincular canais e monitorar o status."}},"de":{"stringUnit":{"state":"translated","value":"Öffne Einstellungen → Channels, um Channels zu verknüpfen und den Status zu überwachen."}},"es":{"stringUnit":{"state":"translated","value":"Abre Ajustes → Channels para vincular canales y supervisar el estado."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Settings → Channels を開いて、チャンネルをリンクし、ステータスを監視してください。"}},"ko":{"stringUnit":{"state":"translated","value":"Settings → Channels를 열어 채널을 연결하고 상태를 모니터링하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Ouvrez Réglages → Canaux pour lier des canaux et surveiller le statut."}},"hi":{"stringUnit":{"state":"translated","value":"चैनल लिंक करने और स्थिति मॉनिटर करने के लिए Settings → Channels खोलें।"}},"ar":{"stringUnit":{"state":"translated","value":"افتح Settings → Channels لربط القنوات ومراقبة الحالة."}},"it":{"stringUnit":{"state":"translated","value":"Apri Settings → Channels per collegare i canali e monitorarne lo stato."}},"tr":{"stringUnit":{"state":"translated","value":"Kanalları bağlamak ve durumu izlemek için Settings → Channels bölümünü açın."}},"uk":{"stringUnit":{"state":"translated","value":"Відкрийте Settings → Channels, щоб прив’язати канали та відстежувати стан."}},"id":{"stringUnit":{"state":"translated","value":"Buka Settings → Channels untuk menautkan saluran dan memantau status."}},"pl":{"stringUnit":{"state":"translated","value":"Otwórz Ustawienia → Channels, aby połączyć kanały i monitorować status."}},"th":{"stringUnit":{"state":"translated","value":"เปิด Settings → Channels เพื่อลิงก์ช่องทางและติดตามสถานะ"}},"vi":{"stringUnit":{"state":"translated","value":"Mở Settings → Channels để liên kết các kênh và theo dõi trạng thái."}},"nl":{"stringUnit":{"state":"translated","value":"Open Settings → Channels om kanalen te koppelen en de status te controleren."}},"fa":{"stringUnit":{"state":"translated","value":"برای پیوند دادن کانال‌ها و پایش وضعیت، Settings → Channels را باز کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Откройте Settings → Channels, чтобы связать каналы и отслеживать статус."}},"sv":{"stringUnit":{"state":"translated","value":"Öppna Settings → Channels för att länka kanaler och övervaka status."}}}},
