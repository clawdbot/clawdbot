    "Waiting for the previous AI test to finish…": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Waiting for the previous AI test to finish…"}},"zh-CN":{"stringUnit":{"state":"translated","value":"正在等待上一个 AI 测试完成…"}},"zh-TW":{"stringUnit":{"state":"translated","value":"正在等待前一個 AI 測試完成…"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Aguardando a conclusão do teste de IA anterior…"}},"de":{"stringUnit":{"state":"translated","value":"Warten auf den Abschluss des vorherigen KI-Tests…"}},"es":{"stringUnit":{"state":"translated","value":"Esperando a que finalice la prueba de IA anterior…"}},"ja-JP":{"stringUnit":{"state":"translated","value":"前のAIテストの完了を待っています…"}},"ko":{"stringUnit":{"state":"translated","value":"이전 AI 테스트가 완료되기를 기다리는 중…"}},"fr":{"stringUnit":{"state":"translated","value":"En attente de la fin du test IA précédent…"}},"hi":{"stringUnit":{"state":"translated","value":"पिछले AI परीक्षण के समाप्त होने की प्रतीक्षा हो रही है…"}},"ar":{"stringUnit":{"state":"translated","value":"في انتظار انتهاء اختبار الذكاء الاصطناعي السابق…"}},"it":{"stringUnit":{"state":"translated","value":"In attesa del completamento del test AI precedente…"}},"tr":{"stringUnit":{"state":"translated","value":"Önceki AI testinin bitmesi bekleniyor…"}},"uk":{"stringUnit":{"state":"translated","value":"Очікування завершення попереднього тесту ШІ…"}},"id":{"stringUnit":{"state":"translated","value":"Menunggu pengujian AI sebelumnya selesai…"}},"pl":{"stringUnit":{"state":"translated","value":"Oczekiwanie na zakończenie poprzedniego testu AI…"}},"th":{"stringUnit":{"state":"translated","value":"กำลังรอให้การทดสอบ AI ก่อนหน้านี้เสร็จสิ้น…"}},"vi":{"stringUnit":{"state":"translated","value":"Đang chờ bài kiểm tra AI trước đó hoàn tất…"}},"nl":{"stringUnit":{"state":"translated","value":"Wachten tot de vorige AI-test is voltooid…"}},"fa":{"stringUnit":{"state":"translated","value":"در انتظار پایان آزمایش قبلی هوش مصنوعی…"}},"ru":{"stringUnit":{"state":"translated",