    "Selected audio input has no usable Float32 format": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Selected audio input has no usable Float32 format"}},"zh-CN":{"stringUnit":{"state":"translated","value":"所选音频输入没有可用的 Float32 格式"}},"zh-TW":{"stringUnit":{"state":"translated","value":"所選音訊輸入沒有可用的 Float32 格式"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A entrada de áudio selecionada não tem um formato Float32 utilizável"}},"de":{"stringUnit":{"state":"translated","value":"Der ausgewählte Audioeingang hat kein verwendbares Float32-Format"}},"es":{"stringUnit":{"state":"translated","value":"La entrada de audio seleccionada no tiene un formato Float32 utilizable"}},"ja-JP":{"stringUnit":{"state":"translated","value":"選択したオーディオ入力に使用可能なFloat32フォーマットがありません"}},"ko":{"stringUnit":{"state":"translated","value":"선택한 오디오 입력에 사용 가능한 Float32 형식이 없습니다"}},"fr":{"stringUnit":{"state":"translated","value":"L'entrée audio sélectionnée n'a aucun format Float32 utilisable"}},"hi":{"stringUnit":{"state":"translated","value":"चयनित ऑडियो इनपुट में कोई उपयोग योग्य Float32 फ़ॉर्मेट नहीं है"}},"ar":{"stringUnit":{"state":"translated","value":"مُدخل الصوت المُحدد لا يحتوي على تنسيق Float32 قابل للاستخدام"}},"it":{"stringUnit":{"state":"translated","value":"L'ingresso audio selezionato non ha un formato Float32 utilizzabile"}},"tr":{"stringUnit":{"state":"translated","value":"Seçilen ses girişinde kullanılabilir Float32 biçimi yok"}},"uk":{"stringUnit":{"state":"translated","value":"Вибраний аудіовхід не має придатного формату Float32"}},"id":{"stringUnit":{"state":"translated","value":"Input audio yang dipilih tidak memiliki format Float32 yang dapat digunakan"}},"pl":{"stringUnit":{"state":"translated","value":"Wybrane wejście audio nie ma używalnego formatu Float32"}},"th":{"stringUnit":{"state":"translated","value":"อินพุตเสียงที่เลือกไม่มีรูปแบบ Float32 ที่ใช้งานได้"}},"vi":{"stringUnit":{"state":"translated","value":"Đầu vào âm thanh đã chọn không có đị