    "Original": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Original"}},"zh-CN":{"stringUnit":{"state":"translated","value":"原版"}},"zh-TW":{"stringUnit":{"state":"translated","value":"原始"}},"pt-BR":{"stringUnit":{"state":"new","value":"Original"}},"de":{"stringUnit":{"state":"new","value":"Original"}},"es":{"stringUnit":{"state":"new","value":"Original"}},"ja-JP":{"stringUnit":{"state":"translated","value":"オリジナル"}},"ko":{"stringUnit":{"state":"translated","value":"기본"}},"fr":{"stringUnit":{"state":"new","value":"Original"}},"hi":{"stringUnit":{"state":"translated","value":"मूल"}},"ar":{"stringUnit":{"state":"translated","value":"الأصلي"}},"it":{"stringUnit":{"state":"translated","value":"Originale"}},"tr":{"stringUnit":{"state":"translated","value":"Orijinal"}},"uk":{"stringUnit":{"state":"translated","value":"Оригінальний"}},"id":{"stringUnit":{"state":"translated","value":"Asli"}},"pl":{"stringUnit":{"state":"translated","value":"Oryginał"}},"th":{"stringUnit":{"state":"translated","value":"ดั้งเดิม"}},"vi":{"stringUnit":{"state":"translated","value":"Nguyên bản"}},"nl":{"stringUnit":{"state":"translated","value":"Origineel"}},"fa":{"stringUnit":{"state":"translated","value":"اصلی"}},"ru":{"stringUnit":{"state":"translated","value":"Оригинал"}},"sv":{"stringUnit":{"state":"new","value":"Original"}}}},
    "Original uses your Mac’s icon style. Other designs follow light/dark mode while OpenClaw runs.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Original uses your Mac’s icon style. Other designs follow light/dark mode while OpenClaw runs."}},"zh-CN":{"stringUnit":{"state":"translated","value":"原版使用 Mac 的图标样式。其他设计会在 OpenClaw 运行时随浅色或深色模式切换。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"「原始」使用 Mac 的圖像樣式。其他設計會在 OpenClaw 執行期間隨淺色或深色模式切換。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Original usa o estilo de ícone do seu Mac. Os outros designs seguem o modo claro ou escuro enquanto o OpenClaw está em execução."}},"de":{"stringUnit":{"state":"translated","value":"Original verwendet den Symbolstil deines Mac. Andere Designs passen sich dem Hell- oder Dunkelmodus an, während OpenClaw läuft."}},"es":{"stringUnit":{"state":"translated","value":"Original usa el estilo de iconos de tu Mac. Los demás diseños se adaptan al modo claro u oscuro mientras OpenClaw está en ejecución."}},"ja-JP":{"stringUnit":{"state":"translated","value":"オリジナルはMacのアイコンスタイルを使用します。その他のデザインは、OpenClawの実行中、ライト／ダークモードに合わせて切り替わります。"}},"ko":{"stringUnit":{"state":"translated","value":"기본 디자인은 Mac의 아이콘 스타일을 사용합니다. 다른 디자인은 OpenClaw가 실행되는 동안 라이트 모드와 다크 모드에 맞춰 변경됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le modèle Original utilise le style d’icône de votre Mac. Les autres modèles suivent le mode clair ou sombre pendant qu’OpenClaw est en cours d’exécution."}},"hi":{"stringUnit":{"state":"translated","value":"मूल डिज़ाइन आपके Mac की आइकन शैली का उपयोग करता है। OpenClaw चलने के दौरान अन्य डिज़ाइन लाइट/डार्क मोड के अनुसार बदलते हैं।"}},"ar":{"stringUnit":{"state":"translated","value":"يستخدم التصميم الأصلي نمط الأيقونات على جهاز Mac الخاص بك. وتتبع التصاميم الأخرى الوضع الفاتح أو الداكن أثناء تشغيل OpenClaw."}},"it":{"stringUnit":{"state":"translated","value":"Originale usa lo stile delle icone del tuo Mac. Gli altri design seguono la modalità chiara o scura mentre OpenClaw è in esecuzione."}},"tr":{"stringUnit":{"state":"translated","value":"Orijinal, Mac’inizin simge stilini kullanır. Diğer tasarımlar, OpenClaw çalışırken açık/koyu moda uyum sağlar."}},"uk":{"stringUnit":{"state":"translated","value":"Оригінальний дизайн використовує стиль іконок вашого Mac. Інші дизайни відповідають світлому або темному режиму, поки працює OpenClaw."}},"id":{"stringUnit":{"state":"translated","value":"Asli menggunakan gaya ikon Mac Anda. Desain lainnya mengikuti mode terang/gelap saat OpenClaw berjalan."}},"pl":{"stringUnit":{"state":"translated","value":"Oryginał używa stylu ikon Twojego Maca. Pozostałe wzory dostosowują się do trybu jasnego lub ciemnego podczas działania OpenClaw."}},"th":{"stringUnit":{"state":"translated","value":"แบบดั้งเดิมใช้สไตล์ไอคอนของ Mac ของคุณ ส่วนดีไซน์อื่นจะปรับตามโหมดสว่าง/มืดขณะที่ OpenClaw ทำงาน"}},"vi":{"stringUnit":{"state":"translated","value":"Thiết kế Nguyên bản sử dụng kiểu biểu tượng của máy Mac. Các thiết kế khác thay đổi theo chế độ sáng/tối khi OpenClaw đang chạy."}},"nl":{"stringUnit":{"state":"translated","value":"Origineel gebruikt de symboolstijl van je Mac. Andere ontwerpen volgen de lichte of donkere modus terwijl OpenClaw actief is."}},"fa":{"stringUnit":{"state":"translated","value":"طرح اصلی از سبک آیکون Mac شما استفاده می‌کند. سایر طرح‌ها هنگام اجرای OpenClaw از حالت روشن/تیره پیروی می‌کنند."}},"ru":{"stringUnit":{"state":"translated","value":"«Оригинал» использует стиль значков вашего Mac. Остальные дизайны соответствуют светлому или тёмному режиму, пока OpenClaw запущен."}},"sv":{"stringUnit":{"state":"translated","value":"Original använder ikonstilen på din Mac. Övriga designer följer ljust eller mörkt läge medan OpenClaw körs."}}}},
