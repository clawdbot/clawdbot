    "Manage installed capabilities or discover verified releases on ClawHub.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Manage installed capabilities or discover verified releases on ClawHub."}},"zh-CN":{"stringUnit":{"state":"translated","value":"管理已安装的功能，或在 ClawHub 上发现经过验证的版本。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"管理已安裝的功能，或在 ClawHub 上探索經驗證的版本。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Gerencie os recursos instalados ou descubra versões verificadas no ClawHub."}},"de":{"stringUnit":{"state":"translated","value":"Verwalten Sie installierte Funktionen oder entdecken Sie verifizierte Versionen auf ClawHub."}},"es":{"stringUnit":{"state":"translated","value":"Gestiona las funcionalidades instaladas o descubre versiones verificadas en ClawHub."}},"ja-JP":{"stringUnit":{"state":"translated","value":"インストール済みの機能を管理するか、ClawHubで検証済みのリリースを探します。"}},"ko":{"stringUnit":{"state":"translated","value":"설치된 기능을 관리하거나 ClawHub에서 검증된 릴리스를 찾아보세요."}},"fr":{"stringUnit":{"state":"translated","value":"Gérez les fonctionnalités installées ou découvrez les versions vérifiées sur ClawHub."}},"hi":{"stringUnit":{"state":"translated","value":"इंस्टॉल की गई क्षमताओं को प्रबंधित करें या ClawHub पर सत्यापित रिलीज़ खोजें।"}},"ar":{"stringUnit":{"state":"translated","value":"أدِر الإمكانات المثبتة أو اكتشف الإصدارات الموثّقة على ClawHub."}},"it":{"stringUnit":{"state":"translated","value":"Gestisci le funzionalità installate o scopri le versioni verificate su ClawHub."}},"tr":{"stringUnit":{"state":"translated","value":"Yüklü özellikleri yönetin veya ClawHub'da doğrulanmış sürümleri keşfedin."}},"uk":{"stringUnit":{"state":"translated","value":"Керуйте встановленими можливостями або знаходьте перевірені випуски в ClawHub."}},"id":{"stringUnit":{"state":"translated","value":"Kelola kapabilitas yang terinstal atau temukan rilis terverifikasi di ClawHub."}},"pl":{"stringUnit":{"state":"translated","value":"Zarządzaj zainstalowanymi funkcjami 