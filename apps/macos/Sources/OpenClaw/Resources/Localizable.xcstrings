    "Refresh after changing binaries, environment variables, or skill config.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Refresh after changing binaries, environment variables, or skill config."}},"zh-CN":{"stringUnit":{"state":"translated","value":"更改二进制文件、环境变量或技能配置后请刷新。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"變更二進位檔案、環境變數或技能設定後，請重新整理。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Atualize após alterar binários, variáveis de ambiente ou a configuração da skill."}},"de":{"stringUnit":{"state":"translated","value":"Nach Änderungen an Binärdateien, Umgebungsvariablen oder der Skill-Konfiguration aktualisieren."}},"es":{"stringUnit":{"state":"translated","value":"Actualiza después de cambiar los binarios, las variables de entorno o la configuración de la habilidad."}},"ja-JP":{"stringUnit":{"state":"translated","value":"バイナリ、環境変数、またはスキル設定を変更した後は更新してください。"}},"ko":{"stringUnit":{"state":"translated","value":"바이너리, 환경 변수 또는 스킬 설정을 변경한 후 새로고침하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Actualisez après avoir modifié les binaires, les variables d’environnement ou la configuration des compétences."}},"hi":{"stringUnit":{"state":"translated","value":"बाइनरी, एनवायरनमेंट वैरिएबल या स्किल कॉन्फ़िगरेशन बदलने के बाद रीफ़्रेश करें."}},"ar":{"stringUnit":{"state":"translated","value":"حدّث بعد تغيير الملفات التنفيذية أو متغيرات البيئة أو إعدادات المهارة."}},"it":{"stringUnit":{"state":"translated","value":"Aggiorna dopo aver modificato i file binari, le variabili d'ambiente o la configurazione delle skill."}},"tr":{"stringUnit":{"state":"translated","value":"İkili dosyaları, ortam değişkenlerini veya beceri yapılandırmasını değiştirdikten sonra yenileyin."}},"uk":{"stringUnit":{"state":"translated","value":"Оновіть після зміни виконуваних файлів, змінних середовища або конфігурації навички."}},"id":{"stringUnit":{"state":"translated","value":"Segarkan setelah mengubah berkas biner, variabel lingkungan, atau konfigura