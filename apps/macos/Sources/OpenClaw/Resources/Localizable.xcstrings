    "Session tool controls require operator.admin access.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Session tool controls require operator.admin access."}},"zh-CN":{"stringUnit":{"state":"translated","value":"会话工具控件需要 operator.admin 访问权限。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"工作階段工具控制項需要 operator.admin 存取權限。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Os controles das ferramentas de sessão exigem acesso operator.admin."}},"de":{"stringUnit":{"state":"translated","value":"Die Steuerung der Sitzungswerkzeuge erfordert operator.admin-Zugriff."}},"es":{"stringUnit":{"state":"translated","value":"Los controles de herramientas de sesión requieren acceso operator.admin."}},"ja-JP":{"stringUnit":{"state":"translated","value":"セッションツールの操作には operator.admin アクセス権が必要です。"}},"ko":{"stringUnit":{"state":"translated","value":"세션 도구를 제어하려면 operator.admin 권한이 필요합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les commandes des outils de session nécessitent un accès operator.admin."}},"hi":{"stringUnit":{"state":"translated","value":"सत्र टूल नियंत्रणों के लिए operator.admin एक्सेस आवश्यक है."}},"ar":{"stringUnit":{"state":"translated","value":"تتطلب عناصر التحكم في أدوات الجلسة صلاحية operator.admin."}},"it":{"stringUnit":{"state":"translated","value":"I controlli degli strumenti di sessione richiedono l'accesso operator.admin."}},"tr":{"stringUnit":{"state":"translated","value":"Oturum aracı kontrolleri operator.admin erişimi gerektirir."}},"uk":{"stringUnit":{"state":"translated","value":"Керування інструментами сеансу потребує доступу operator.admin."}},"id":{"stringUnit":{"state":"translated","value":"Kontrol alat sesi memerlukan akses operator.admin."}},"pl":{"stringUnit":{"state":"translated","value":"Sterowanie narzędziami sesji wymaga uprawnień operator.admin."}},"th":{"stringUnit":{"state":"translated","value":"การควบคุมเครื่องมือเซสชันต้องใช้สิทธิ์ operator.admin."}},"vi":{"stringUnit":{"state":"translated",