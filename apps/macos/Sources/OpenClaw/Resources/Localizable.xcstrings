    "That token did not match the gateway": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"That token did not match the gateway"}},"zh-CN":{"stringUnit":{"state":"translated","value":"该令牌与 Gateway 不匹配"}},"zh-TW":{"stringUnit":{"state":"translated","value":"該權杖與 Gateway 不符"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Esse token não correspondeu ao Gateway"}},"de":{"stringUnit":{"state":"translated","value":"Dieses Token passte nicht zum Gateway"}},"es":{"stringUnit":{"state":"translated","value":"Ese token no coincidía con el Gateway"}},"ja-JP":{"stringUnit":{"state":"translated","value":"そのトークンはGatewayと一致しませんでした"}},"ko":{"stringUnit":{"state":"translated","value":"해당 토큰이 Gateway와 일치하지 않았습니다"}},"fr":{"stringUnit":{"state":"translated","value":"Ce jeton ne correspondait pas au Gateway"}},"hi":{"stringUnit":{"state":"translated","value":"वह टोकन Gateway से मेल नहीं खाया"}},"ar":{"stringUnit":{"state":"translated","value":"لم يتطابق هذا الرمز المميز مع Gateway"}},"it":{"stringUnit":{"state":"translated","value":"Il token non corrisponde al Gateway"}},"tr":{"stringUnit":{"state":"translated","value":"Bu belirteç Gateway ile eşleşmedi"}},"uk":{"stringUnit":{"state":"translated","value":"Цей токен не відповідає Gateway"}},"id":{"stringUnit":{"state":"translated","value":"Token tersebut tidak cocok dengan gateway"}},"pl":{"stringUnit":{"state":"translated","value":"Ten token nie pasował do Gateway"}},"th":{"stringUnit":{"state":"translated","value":"โทเค็นนั้นไม่ตรงกับ Gateway"}},"vi":{"stringUnit":{"state":"translated","value":"Mã thông báo đó không khớp với Gateway"}},"nl":{"stringUnit":{"state":"translated","value":"Dat token kwam niet overeen met de gateway"}},"fa":{"stringUnit":{"state":"translated","value":"آن توکن با Gateway مطابقت نداشت"}},"ru":{"stringUnit":{"state":"translated","value":"Этот токен не соответствует Gateway"}},"sv":{"stringUnit":{"state":"translated","value":"Den token matchade inte Gateway"}}}},
    "The Gateway connection changed. Restart OpenClaw to reconnect.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Gateway connection changed. Restart OpenClaw to reconnect."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Gateway 连接已更改。请重新启动 OpenClaw 以重新连接。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 連線已變更。請重新啟動 OpenClaw 以重新連線。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A conexão com o Gateway mudou. Reinicie o OpenClaw para reconectar."}},"de":{"stringUnit":{"state":"translated","value":"Die Gateway-Verbindung hat sich geändert. Starten Sie OpenClaw neu, um die Verbindung wiederherzustellen."}},"es":{"stringUnit":{"state":"translated","value":"La conexión con el Gateway cambió. Reinicia OpenClaw para volver a conectarte."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gateway接続が変更されました。再接続するにはOpenClawを再起動してください。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway 연결이 변경되었습니다. 다시 연결하려면 OpenClaw를 다시 시작하세요."}},"fr":{"stringUnit":{"state":"translated","value":"La connexion au Gateway a changé. Redémarrez OpenClaw pour vous reconnecter."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway कनेक्शन बदल गया। फिर से कनेक्ट करने के लिए OpenClaw को पुनः शुरू करें।"}},"ar":{"stringUnit":{"state":"translated","value":"تغيّر الاتصال بـ Gateway. أعد تشغيل OpenClaw لإعادة الاتصال."}},"it":{"stringUnit":{"state":"translated","value":"La connessione al Gateway è cambiata. Riavvia OpenClaw per riconnetterti."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway bağlantısı değişti. Yeniden bağlanmak için OpenClaw uygulamasını yeniden başlatın."}},"uk":{"stringUnit":{"state":"translated","value":"З’єднання з Gateway змінилося. Перезапустіть OpenClaw, щоб підключитися знову."}},"id":{"stringUnit":{"state":"translated","value":"Koneksi Gateway berubah. Mulai ulang OpenClaw untuk terhubung kembali."}},"pl":{"stringUnit":{"state":"translated","value":"Połączenie z Gateway uległo zmianie. Uruchom ponownie OpenClaw, aby połączyć się ponownie."}},"th":{"stringUnit":{"state":"translated","value":"การเชื่อมต่อ Gateway เปลี่ยนไป. เริ่ม OpenClaw ใหม่เพื่อเชื่อมต่ออีกครั้ง."}},"vi":{"stringUnit":{"state":"translated","value":"Kết nối Gateway đã thay đổi. Khởi động lại OpenClaw để kết nối lại."}},"nl":{"stringUnit":{"state":"translated","value":"De Gateway-verbinding is gewijzigd. Start OpenClaw opnieuw om opnieuw verbinding te maken."}},"fa":{"stringUnit":{"state":"translated","value":"اتصال Gateway تغییر کرد. برای اتصال مجدد، OpenClaw را راه‌اندازی مجدد کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Подключение к Gateway изменилось. Перезапустите OpenClaw, чтобы подключиться заново."}},"sv":{"stringUnit":{"state":"translated","value":"Anslutningen till Gateway ändrades. Starta om OpenClaw för att återansluta."}}}},
    "The Gateway could not be checked.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Gateway could not be checked."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法检查 Gateway。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法檢查 Gateway。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível verificar o Gateway."}},"de":{"stringUnit":{"state":"translated","value":"Das Gateway konnte nicht überprüft werden."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo comprobar el Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayを確認できませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway를 확인할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Impossible de vérifier le Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway की जाँच नहीं हो सकी।"}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر التحقّق من Gateway."}},"it":{"stringUnit":{"state":"translated","value":"Non è stato possibile verificare il Gateway."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway kontrol edilemedi."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося перевірити Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Gateway tidak dapat diperiksa."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się sprawdzić Gateway."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถตรวจสอบ Gateway ได้."}},"vi":{"stringUnit":{"state":"translated","value":"Không thể kiểm tra Gateway."}},"nl":{"stringUnit":{"state":"translated","value":"De Gateway kon niet worden gecontroleerd."}},"fa":{"stringUnit":{"state":"translated","value":"بررسی Gateway ممکن نشد."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось проверить Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Det gick inte att kontrollera Gateway."}}}},
    "The Gateway could not reconnect.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Gateway could not reconnect."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Gateway 无法重新连接。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 無法重新連線。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível reconectar o Gateway."}},"de":{"stringUnit":{"state":"translated","value":"Das Gateway konnte die Verbindung nicht wiederherstellen."}},"es":{"stringUnit":{"state":"translated","value":"El Gateway no pudo volver a conectarse."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayに再接続できませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway에 다시 연결할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le Gateway n’a pas pu se reconnecter."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway फिर से कनेक्ट नहीं हो सका।"}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر على Gateway إعادة الاتصال."}},"it":{"stringUnit":{"state":"translated","value":"Il Gateway non è riuscito a riconnettersi."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway yeniden bağlanamadı."}},"uk":{"stringUnit":{"state":"translated","value":"Gateway не вдалося підключитися знову."}},"id":{"stringUnit":{"state":"translated","value":"Gateway tidak dapat terhubung kembali."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się ponownie połączyć z Gateway."}},"th":{"stringUnit":{"state":"translated","value":"Gateway ไม่สามารถเชื่อมต่ออีกครั้งได้."}},"vi":{"stringUnit":{"state":"translated","value":"Gateway không thể kết nối lại."}},"nl":{"stringUnit":{"state":"translated","value":"De Gateway kon niet opnieuw verbinding maken."}},"fa":{"stringUnit":{"state":"translated","value":"Gateway نتوانست دوباره متصل شود."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось восстановить подключение к Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Gateway kunde inte återansluta."}}}},
    "The Gateway delivery target changed. Review this message on iPhone.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Gateway delivery target changed. Review this message on iPhone."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Gateway 投递目标已更改。请在 iPhone 上查看此消息。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 的傳送目標已變更。請在 iPhone 上檢視此訊息。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O destino de entrega do Gateway mudou. Revise esta mensagem no iPhone."}},"de":{"stringUnit":{"state":"translated","value":"Das Zustellungsziel des Gateways hat sich geändert. Prüfen Sie diese Nachricht auf dem iPhone."}},"es":{"stringUnit":{"state":"translated","value":"El destino de entrega del Gateway cambió. Revisa este mensaje en el iPhone."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayの配信先が変更されました。iPhoneでこのメッセージを確認してください。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway의 전달 대상이 변경되었습니다. iPhone에서 이 메시지를 검토하세요."}},"fr":{"stringUnit":{"state":"translated","value":"La destination d’envoi du Gateway a changé. Vérifiez ce message sur iPhone."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway का डिलीवरी लक्ष्य बदल गया। iPhone पर इस संदेश की समीक्षा करें।"}},"ar":{"stringUnit":{"state":"translated","value":"تغيّرت وجهة التسليم في Gateway. راجع هذه الرسالة على iPhone."}},"it":{"stringUnit":{"state":"translated","value":"La destinazione di consegna del Gateway è cambiata. Controlla questo messaggio su iPhone."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway teslim hedefi değişti. Bu mesajı iPhone üzerinde gözden geçirin."}},"uk":{"stringUnit":{"state":"translated","value":"Ціль доставки Gateway змінилася. Перегляньте це повідомлення на iPhone."}},"id":{"stringUnit":{"state":"translated","value":"Tujuan pengiriman Gateway berubah. Tinjau pesan ini di iPhone."}},"pl":{"stringUnit":{"state":"translated","value":"Miejsce docelowe dostarczania w Gateway uległo zmianie. Sprawdź tę wiadomość na iPhonie."}},"th":{"stringUnit":{"state":"translated","value":"ปลายทางการส่งของ Gateway เปลี่ยนไป. ตรวจสอบข้อความนี้บน iPhone."}},"vi":{"stringUnit":{"state":"translated","value":"Đích gửi của Gateway đã thay đổi. Xem lại tin nhắn này trên iPhone."}},"nl":{"stringUnit":{"state":"translated","value":"De afleverbestemming van de Gateway is gewijzigd. Controleer dit bericht op iPhone."}},"fa":{"stringUnit":{"state":"translated","value":"مقصد تحویل Gateway تغییر کرد. این پیام را در iPhone بررسی کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Адресат доставки Gateway изменился. Просмотрите это сообщение на iPhone."}},"sv":{"stringUnit":{"state":"translated","value":"Leveransmålet för Gateway ändrades. Granska det här meddelandet på iPhone."}}}},
    "The Gateway did not start.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Gateway did not start."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Gateway 未启动。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 未啟動。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Gateway não iniciou."}},"de":{"stringUnit":{"state":"translated","value":"Das Gateway wurde nicht gestartet."}},"es":{"stringUnit":{"state":"translated","value":"El Gateway no se inició."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayが起動しませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway가 시작되지 않았습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le Gateway n’a pas démarré."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway शुरू नहीं हुआ।"}},"ar":{"stringUnit":{"state":"translated","value":"لم يبدأ Gateway."}},"it":{"stringUnit":{"state":"translated","value":"Il Gateway non si è avviato."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway başlamadı."}},"uk":{"stringUnit":{"state":"translated","value":"Gateway не запустився."}},"id":{"stringUnit":{"state":"translated","value":"Gateway tidak berjalan."}},"pl":{"stringUnit":{"state":"translated","value":"Gateway nie uruchomił się."}},"th":{"stringUnit":{"state":"translated","value":"Gateway ไม่ได้เริ่มทำงาน."}},"vi":{"stringUnit":{"state":"translated","value":"Gateway đã không khởi động."}},"nl":{"stringUnit":{"state":"translated","value":"De Gateway is niet gestart."}},"fa":{"stringUnit":{"state":"translated","value":"Gateway راه‌اندازی نشد."}},"ru":{"stringUnit":{"state":"translated","value":"Gateway не запустился."}},"sv":{"stringUnit":{"state":"translated","value":"Gateway startade inte."}}}},
    "The Gateway didn’t start": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Gateway didn’t start"}},"zh-CN":{"stringUnit":{"state":"translated","value":"Gateway 未启动"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 未啟動"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Gateway não iniciou"}},"de":{"stringUnit":{"state":"translated","value":"Das Gateway wurde nicht gestartet"}},"es":{"stringUnit":{"state":"translated","value":"El Gateway no se inició"}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayが起動しませんでした"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway가 시작되지 않았습니다"}},"fr":{"stringUnit":{"state":"translated","value":"Le Gateway n’a pas démarré"}},"hi":{"stringUnit":{"state":"translated","value":"Gateway शुरू नहीं हुआ"}},"ar":{"stringUnit":{"state":"translated","value":"لم يبدأ Gateway"}},"it":{"stringUnit":{"state":"translated","value":"Il Gateway non si è avviato"}},"tr":{"stringUnit":{"state":"translated","value":"Gateway başlamadı"}},"uk":{"stringUnit":{"state":"translated","value":"Gateway не запустився"}},"id":{"stringUnit":{"state":"translated","value":"Gateway tidak berjalan"}},"pl":{"stringUnit":{"state":"translated","value":"Gateway nie uruchomił się"}},"th":{"stringUnit":{"state":"translated","value":"Gateway ไม่ได้เริ่มทำงาน"}},"vi":{"stringUnit":{"state":"translated","value":"Gateway đã không khởi động"}},"nl":{"stringUnit":{"state":"translated","value":"De Gateway is niet gestart"}},"fa":{"stringUnit":{"state":"translated","value":"Gateway راه‌اندازی نشد"}},"ru":{"stringUnit":{"state":"translated","value":"Gateway не запустился"}},"sv":{"stringUnit":{"state":"translated","value":"Gateway startade inte"}}}},
    "The Gateway remains paused, so OpenClaw did not wake your agent.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Gateway remains paused, so OpenClaw did not wake your agent."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Gateway 仍处于暂停状态，因此 OpenClaw 未唤醒你的智能体。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 仍處於暫停狀態，因此 OpenClaw 未喚醒您的代理程式。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Gateway continua pausado, então o OpenClaw não ativou seu agente."}},"de":{"stringUnit":{"state":"translated","value":"Das Gateway bleibt pausiert, daher hat OpenClaw Ihren Agenten nicht aktiviert."}},"es":{"stringUnit":{"state":"translated","value":"El Gateway sigue en pausa, por lo que OpenClaw no activó tu agente."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayは一時停止中のため、OpenClawはエージェントを起動しませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway가 계속 일시 중지 상태이므로 OpenClaw가 에이전트를 깨우지 않았습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le Gateway est toujours en pause, donc OpenClaw n’a pas réveillé votre agent."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway अभी भी रुका हुआ है, इसलिए OpenClaw ने आपके एजेंट को सक्रिय नहीं किया।"}},"ar":{"stringUnit":{"state":"translated","value":"لا يزال Gateway متوقفًا مؤقتًا، لذا لم ينشّط OpenClaw وكيلك."}},"it":{"stringUnit":{"state":"translated","value":"Il Gateway rimane in pausa, quindi OpenClaw non ha riattivato il tuo agente."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway hâlâ duraklatılmış durumda, bu nedenle OpenClaw aracınızı uyandırmadı."}},"uk":{"stringUnit":{"state":"translated","value":"Gateway залишається призупиненим, тому OpenClaw не активував вашого агента."}},"id":{"stringUnit":{"state":"translated","value":"Gateway masih dijeda, jadi OpenClaw tidak membangunkan agen Anda."}},"pl":{"stringUnit":{"state":"translated","value":"Gateway pozostaje wstrzymany, więc OpenClaw nie wybudził Twojego agenta."}},"th":{"stringUnit":{"state":"translated","value":"Gateway ยังคงหยุดชั่วคราวอยู่ ดังนั้น OpenClaw จึงไม่ได้ปลุกเอเจนต์ของคุณ."}},"vi":{"stringUnit":{"state":"translated","value":"Gateway vẫn đang tạm dừng, nên OpenClaw đã không đánh thức tác tử của bạn."}},"nl":{"stringUnit":{"state":"translated","value":"De Gateway blijft gepauzeerd, dus OpenClaw heeft je agent niet geactiveerd."}},"fa":{"stringUnit":{"state":"translated","value":"Gateway همچنان متوقف است، بنابراین OpenClaw عامل شما را بیدار نکرد."}},"ru":{"stringUnit":{"state":"translated","value":"Gateway по-прежнему приостановлен, поэтому OpenClaw не активировал вашего агента."}},"sv":{"stringUnit":{"state":"translated","value":"Gateway är fortfarande pausad, så OpenClaw väckte inte din agent."}}}},
    "The Gateway setup request failed.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Gateway setup request failed."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Gateway 设置请求失败。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 設定請求失敗。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A solicitação de configuração do Gateway falhou."}},"de":{"stringUnit":{"state":"translated","value":"Die Anfrage zur Einrichtung des Gateways ist fehlgeschlagen."}},"es":{"stringUnit":{"state":"translated","value":"La solicitud de configuración del Gateway falló."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayのセットアップリクエストに失敗しました。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway 설정 요청에 실패했습니다."}},"fr":{"stringUnit":{"state":"translated","value":"La requête de configuration du Gateway a échoué."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway सेटअप अनुरोध विफल रहा।"}},"ar":{"stringUnit":{"state":"translated","value":"فشل طلب إعداد Gateway."}},"it":{"stringUnit":{"state":"translated","value":"La richiesta di configurazione del Gateway non è riuscita."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway kurulum isteği başarısız oldu."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося виконати запит на налаштування Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Permintaan penyiapan Gateway gagal."}},"pl":{"stringUnit":{"state":"translated","value":"Żądanie konfiguracji Gateway nie powiodło się."}},"th":{"stringUnit":{"state":"translated","value":"คำขอตั้งค่า Gateway ล้มเหลว."}},"vi":{"stringUnit":{"state":"translated","value":"Yêu cầu thiết lập Gateway không thành công."}},"nl":{"stringUnit":{"state":"translated","value":"Het Gateway-configuratieverzoek is mislukt."}},"fa":{"stringUnit":{"state":"translated","value":"درخواست راه‌اندازی Gateway ناموفق بود."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось выполнить запрос настройки Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Begäran om att konfigurera Gateway misslyckades."}}}},
    "The Gateway setup request failed. Show details to inspect or copy the error.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Gateway setup request failed. Show details to inspect or copy the error."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Gateway 设置请求失败。请显示详细信息以查看或复制错误。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 設定請求失敗。請顯示詳細資訊以檢查或複製錯誤。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A solicitação de configuração do Gateway falhou. Mostre os detalhes para inspecionar ou copiar o erro."}},"de":{"stringUnit":{"state":"translated","value":"Die Anfrage zur Einrichtung des Gateways ist fehlgeschlagen. Zeigen Sie die Details an, um den Fehler zu prüfen oder zu kopieren."}},"es":{"stringUnit":{"state":"translated","value":"La solicitud de configuración del Gateway falló. Muestra los detalles para examinar o copiar el error."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayのセットアップリクエストに失敗しました。エラーを確認またはコピーするには、詳細を表示してください。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway 설정 요청에 실패했습니다. 오류를 확인하거나 복사하려면 세부 정보를 표시하세요."}},"fr":{"stringUnit":{"state":"translated","value":"La requête de configuration du Gateway a échoué. Affichez les détails pour examiner ou copier l’erreur."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway सेटअप अनुरोध विफल रहा। त्रुटि की जाँच करने या उसे कॉपी करने के लिए विवरण दिखाएँ।"}},"ar":{"stringUnit":{"state":"translated","value":"فشل طلب إعداد Gateway. أظهر التفاصيل لفحص الخطأ أو نسخه."}},"it":{"stringUnit":{"state":"translated","value":"La richiesta di configurazione del Gateway non è riuscita. Mostra i dettagli per esaminare o copiare l’errore."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway kurulum isteği başarısız oldu. Hatayı incelemek veya kopyalamak için ayrıntıları gösterin."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося виконати запит на налаштування Gateway. Відкрийте подробиці, щоб переглянути або скопіювати помилку."}},"id":{"stringUnit":{"state":"translated","value":"Permintaan penyiapan Gateway gagal. Tampilkan detail untuk memeriksa atau menyalin kesalahan."}},"pl":{"stringUnit":{"state":"translated","value":"Żądanie konfiguracji Gateway nie powiodło się. Pokaż szczegóły, aby sprawdzić lub skopiować błąd."}},"th":{"stringUnit":{"state":"translated","value":"คำขอตั้งค่า Gateway ล้มเหลว. แสดงรายละเอียดเพื่อตรวจสอบหรือคัดลอกข้อผิดพลาด."}},"vi":{"stringUnit":{"state":"translated","value":"Yêu cầu thiết lập Gateway không thành công. Hiển thị chi tiết để kiểm tra hoặc sao chép lỗi."}},"nl":{"stringUnit":{"state":"translated","value":"Het Gateway-configuratieverzoek is mislukt. Toon details om de fout te bekijken of te kopiëren."}},"fa":{"stringUnit":{"state":"translated","value":"درخواست راه‌اندازی Gateway ناموفق بود. برای بررسی یا کپی کردن خطا، جزئیات را نمایش دهید."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось выполнить запрос настройки Gateway. Откройте подробности, чтобы просмотреть или скопировать ошибку."}},"sv":{"stringUnit":{"state":"translated","value":"Begäran om att konfigurera Gateway misslyckades. Visa detaljer för att granska eller kopiera felet."}}}},
    "The Gateway verifies the exact reviewed release before download.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Gateway verifies the exact reviewed release before download."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Gateway 会在下载前验证所审核的确切版本。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 會在下載前驗證是否為已審核的確切版本。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Gateway verifica a versão exata revisada antes do download."}},"de":{"stringUnit":{"state":"translated","value":"Der Gateway verifiziert vor dem Download genau die geprüfte Version."}},"es":{"stringUnit":{"state":"translated","value":"El Gateway verifica la versión exacta revisada antes de descargarla."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayはダウンロード前に、確認済みのリリースと完全に一致することを検証します。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway는 다운로드 전에 검토된 릴리스와 정확히 일치하는지 확인합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le Gateway vérifie la version exacte examinée avant le téléchargement."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway डाउनलोड से पहले समीक्षा की गई सटीक रिलीज़ को सत्यापित करता है।"}},"ar":{"stringUnit":{"state":"translated","value":"يتحقق Gateway من الإصدار المحدد الذي تمت مراجعته قبل التنزيل."}},"it":{"stringUnit":{"state":"translated","value":"Il Gateway verifica la versione esatta esaminata prima del download."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway, indirmeden önce incelenen sürümün aynısı olduğunu doğrular."}},"uk":{"stringUnit":{"state":"translated","value":"Gateway перевіряє саме той випуск, який було розглянуто, перед завантаженням."}},"id":{"stringUnit":{"state":"translated","value":"Gateway memverifikasi rilis yang telah ditinjau secara persis sebelum mengunduh."}},"pl":{"stringUnit":{"state":"translated","value":"Gateway weryfikuje dokładnie to sprawdzone wydanie przed pobraniem."}},"th":{"stringUnit":{"state":"translated","value":"Gateway จะตรวจสอบรุ่นที่ผ่านการตรวจสอบโดยตรงก่อนดาวน์โหลด"}},"vi":{"stringUnit":{"state":"translated","value":"Gateway xác minh đúng bản phát hành đã được xem xét trước khi tải xuống."}},"nl":{"stringUnit":{"state":"translated","value":"De Gateway verifieert vóór het downloaden exact de beoordeelde release."}},"fa":{"stringUnit":{"state":"translated","value":"Gateway پیش از دانلود، دقیقاً همان نسخهٔ بررسی‌شده را تأیید می‌کند."}},"ru":{"stringUnit":{"state":"translated","value":"Перед скачиванием Gateway проверяет точную версию выпуска, которую вы просмотрели."}},"sv":{"stringUnit":{"state":"translated","value":"Gateway verifierar den exakta granskade versionen före nedladdning."}}}},
    "The Gateway will verify this exact release with ClawHub before download.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Gateway will verify this exact release with ClawHub before download."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Gateway 会在下载前通过 ClawHub 验证此确切版本。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 會在下載前向 ClawHub 驗證此確切版本。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Gateway verificará esta versão exata com o ClawHub antes do download."}},"de":{"stringUnit":{"state":"translated","value":"Das Gateway überprüft vor dem Download genau diese Version mit ClawHub."}},"es":{"stringUnit":{"state":"translated","value":"El Gateway verificará esta versión exacta con ClawHub antes de descargarla."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayはダウンロード前に、ClawHubでこの正確なリリースを検証します。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway는 다운로드 전에 ClawHub를 통해 이 릴리스를 정확히 검증합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le Gateway vérifiera cette version exacte auprès de ClawHub avant le téléchargement."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway डाउनलोड से पहले ClawHub से ठीक इसी रिलीज़ को सत्यापित करेगा."}},"ar":{"stringUnit":{"state":"translated","value":"سيتحقق Gateway من هذا الإصدار بعينه عبر ClawHub قبل التنزيل."}},"it":{"stringUnit":{"state":"translated","value":"Il Gateway verificherà questa specifica versione con ClawHub prima del download."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway, indirmeden önce bu sürümün aynısını ClawHub üzerinden doğrulayacak."}},"uk":{"stringUnit":{"state":"translated","value":"Gateway перевірить саме цей випуск через ClawHub перед завантаженням."}},"id":{"stringUnit":{"state":"translated","value":"Gateway akan memverifikasi rilis yang sama persis ini dengan ClawHub sebelum mengunduh."}},"pl":{"stringUnit":{"state":"translated","value":"Gateway zweryfikuje dokładnie to wydanie w ClawHub przed pobraniem."}},"th":{"stringUnit":{"state":"translated","value":"Gateway จะตรวจสอบรุ่นนี้กับ ClawHub ให้ตรงกันก่อนดาวน์โหลด."}},"vi":{"stringUnit":{"state":"translated","value":"Gateway sẽ xác minh chính xác bản phát hành này với ClawHub trước khi tải xuống."}},"nl":{"stringUnit":{"state":"translated","value":"De Gateway zal vóór het downloaden precies deze release bij ClawHub verifiëren."}},"fa":{"stringUnit":{"state":"translated","value":"Gateway پیش از دانلود، دقیقاً همین نسخه را از طریق ClawHub تأیید خواهد کرد."}},"ru":{"stringUnit":{"state":"translated","value":"Перед скачиванием Gateway проверит именно этот выпуск через ClawHub."}},"sv":{"stringUnit":{"state":"translated","value":"Gateway verifierar exakt den här versionen med ClawHub före nedladdning."}}}},
    "The Gateway's session routing changed. Start a new message from its current Watch context.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Gateway's session routing changed. Start a new message from its current Watch context."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Gateway 的会话路由已更改。 请从其当前的 Watch 上下文发起新消息。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 的工作階段路由已變更。 請從目前的 Watch 情境開始傳送新訊息。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O roteamento de sessões do Gateway mudou. Inicie uma nova mensagem a partir do contexto atual do Watch."}},"de":{"stringUnit":{"state":"translated","value":"Das Sitzungsrouting des Gateways hat sich geändert. Starten Sie eine neue Nachricht aus dem aktuellen Watch-Kontext."}},"es":{"stringUnit":{"state":"translated","value":"El enrutamiento de sesiones del Gateway cambió. Inicia un nuevo mensaje desde su contexto actual de Watch."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gateway のセッションルーティングが変更されました。現在の Watch コンテキストから新しいメッセージを開始してください。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway의 세션 라우팅이 변경되었습니다. 현재 Watch 컨텍스트에서 새 메시지를 시작하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Le routage des sessions du Gateway a changé. Commencez un nouveau message depuis son contexte Watch actuel."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway की सत्र रूटिंग बदल गई है. उसके वर्तमान Watch संदर्भ से एक नया संदेश शुरू करें."}},"ar":{"stringUnit":{"state":"translated","value":"تغيّر توجيه الجلسات في Gateway. ابدأ رسالة جديدة من سياق Watch الحالي الخاص به."}},"it":{"stringUnit":{"state":"translated","value":"L'instradamento delle sessioni del Gateway è cambiato. Inizia un nuovo messaggio dal contesto attuale del Watch."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway'in oturum yönlendirmesi değişti. Mevcut Watch bağlamından yeni bir mesaj başlatın."}},"uk":{"stringUnit":{"state":"translated","value":"Маршрутизація сеансів Gateway змінилася. Почніть нове повідомлення з його поточного контексту Watch."}},"id":{"stringUnit":{"state":"translated","value":"Perutean sesi Gateway berubah. Mulai pesan baru dari konteks Watch saat ini."}},"pl":{"stringUnit":{"state":"translated","value":"Routing sesji Gateway uległ zmianie. Rozpocznij nową wiadomość w jego bieżącym kontekście na Watch."}},"th":{"stringUnit":{"state":"translated","value":"การกำหนดเส้นทางเซสชันของ Gateway เปลี่ยนไป. เริ่มข้อความใหม่จากบริบท Watch ปัจจุบัน."}},"vi":{"stringUnit":{"state":"translated","value":"Định tuyến phiên của Gateway đã thay đổi. Hãy bắt đầu một tin nhắn mới từ ngữ cảnh Watch hiện tại của Gateway."}},"nl":{"stringUnit":{"state":"translated","value":"De sessieroutering van de Gateway is gewijzigd. Start een nieuw bericht vanuit de huidige Watch-context."}},"fa":{"stringUnit":{"state":"translated","value":"مسیریابی نشست Gateway تغییر کرد. پیام جدیدی را از زمینهٔ فعلی Watch آن آغاز کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Маршрутизация сеансов Gateway изменилась. Начните новое сообщение из текущего контекста Watch."}},"sv":{"stringUnit":{"state":"translated","value":"Sessionsroutningen för Gateway har ändrats. Starta ett nytt meddelande från dess aktuella Watch-kontext."}}}},
    "The Mac node could not be checked.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Mac node could not be checked."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法检查 Mac 节点。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法檢查 Mac 節點。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível verificar o nó do Mac."}},"de":{"stringUnit":{"state":"translated","value":"Der Mac-Knoten konnte nicht überprüft werden."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo comprobar el nodo de Mac."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Mac ノードを確認できませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"Mac 노드를 확인할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le nœud Mac n’a pas pu être vérifié."}},"hi":{"stringUnit":{"state":"translated","value":"Mac नोड की जाँच नहीं हो सकी."}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر فحص عقدة Mac."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile verificare il nodo Mac."}},"tr":{"stringUnit":{"state":"translated","value":"Mac düğümü kontrol edilemedi."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося перевірити вузол Mac."}},"id":{"stringUnit":{"state":"translated","value":"Node Mac tidak dapat diperiksa."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się sprawdzić węzła Mac."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถตรวจสอบโหนด Mac ได้."}},"vi":{"stringUnit":{"state":"translated","value":"Không thể kiểm tra nút Mac."}},"nl":{"stringUnit":{"state":"translated","value":"Het Mac-knooppunt kon niet worden gecontroleerd."}},"fa":{"stringUnit":{"state":"translated","value":"بررسی گره Mac ممکن نشد."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось проверить узел Mac."}},"sv":{"stringUnit":{"state":"translated","value":"Mac-noden kunde inte kontrolleras."}}}},
    "The Mac node did not become ready.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Mac node did not become ready."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Mac 节点未能就绪。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Mac 節點未能就緒。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O nó do Mac não ficou pronto."}},"de":{"stringUnit":{"state":"translated","value":"Der Mac-Knoten wurde nicht bereit."}},"es":{"stringUnit":{"state":"translated","value":"El nodo de Mac no llegó a estar listo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Mac ノードの準備が整いませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"Mac 노드가 준비 상태로 전환되지 않았습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le nœud Mac n’est pas devenu prêt."}},"hi":{"stringUnit":{"state":"translated","value":"Mac नोड तैयार नहीं हुआ."}},"ar":{"stringUnit":{"state":"translated","value":"لم تصبح عقدة Mac جاهزة."}},"it":{"stringUnit":{"state":"translated","value":"Il nodo Mac non è diventato pronto."}},"tr":{"stringUnit":{"state":"translated","value":"Mac düğümü hazır duruma gelemedi."}},"uk":{"stringUnit":{"state":"translated","value":"Вузол Mac не перейшов у стан готовності."}},"id":{"stringUnit":{"state":"translated","value":"Node Mac tidak berhasil mencapai status siap."}},"pl":{"stringUnit":{"state":"translated","value":"Węzeł Mac nie osiągnął stanu gotowości."}},"th":{"stringUnit":{"state":"translated","value":"โหนด Mac ไม่เข้าสู่สถานะพร้อมใช้งาน."}},"vi":{"stringUnit":{"state":"translated","value":"Nút Mac chưa sẵn sàng."}},"nl":{"stringUnit":{"state":"translated","value":"Het Mac-knooppunt is niet gereed gekomen."}},"fa":{"stringUnit":{"state":"translated","value":"گره Mac آماده نشد."}},"ru":{"stringUnit":{"state":"translated","value":"Узел Mac не перешёл в состояние готовности."}},"sv":{"stringUnit":{"state":"translated","value":"Mac-noden blev inte redo."}}}},
    "The Mac node did not restart.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Mac node did not restart."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Mac 节点未能重启。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Mac 節點未重新啟動。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O nó do Mac não reiniciou."}},"de":{"stringUnit":{"state":"translated","value":"Der Mac-Knoten wurde nicht neu gestartet."}},"es":{"stringUnit":{"state":"translated","value":"El nodo de Mac no se reinició."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Mac ノードが再起動しませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"Mac 노드가 다시 시작되지 않았습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le nœud Mac n’a pas redémarré."}},"hi":{"stringUnit":{"state":"translated","value":"Mac नोड पुनः शुरू नहीं हुआ."}},"ar":{"stringUnit":{"state":"translated","value":"لم تتم إعادة تشغيل عقدة Mac."}},"it":{"stringUnit":{"state":"translated","value":"Il nodo Mac non si è riavviato."}},"tr":{"stringUnit":{"state":"translated","value":"Mac düğümü yeniden başlatılamadı."}},"uk":{"stringUnit":{"state":"translated","value":"Вузол Mac не перезапустився."}},"id":{"stringUnit":{"state":"translated","value":"Node Mac tidak berhasil dimulai ulang."}},"pl":{"stringUnit":{"state":"translated","value":"Węzeł Mac nie uruchomił się ponownie."}},"th":{"stringUnit":{"state":"translated","value":"โหนด Mac ไม่ได้เริ่มการทำงานใหม่."}},"vi":{"stringUnit":{"state":"translated","value":"Nút Mac đã không khởi động lại."}},"nl":{"stringUnit":{"state":"translated","value":"Het Mac-knooppunt is niet opnieuw gestart."}},"fa":{"stringUnit":{"state":"translated","value":"گره Mac راه‌اندازی مجدد نشد."}},"ru":{"stringUnit":{"state":"translated","value":"Узел Mac не перезапустился."}},"sv":{"stringUnit":{"state":"translated","value":"Mac-noden startade inte om."}}}},
    "The OpenClaw Gateway could not be verified. Setup will repair it.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The OpenClaw Gateway could not be verified. Setup will repair it."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法验证 OpenClaw Gateway. 设置程序将进行修复。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法驗證 OpenClaw Gateway. 設定程序會進行修復。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível verificar o Gateway do OpenClaw. A configuração irá repará-lo."}},"de":{"stringUnit":{"state":"translated","value":"Der OpenClaw Gateway konnte nicht verifiziert werden. Die Einrichtung wird ihn reparieren."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo verificar el Gateway de OpenClaw. El proceso de configuración lo reparará."}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway を検証できませんでした。セットアップで修復します。"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway를 검증할 수 없습니다. 설정 과정에서 복구됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le Gateway OpenClaw n’a pas pu être vérifié. La configuration le réparera."}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway को सत्यापित नहीं किया जा सका. सेटअप इसे ठीक करेगा."}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر التحقق من OpenClaw Gateway. ستُصلحه عملية الإعداد."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile verificare il Gateway OpenClaw. La configurazione lo riparerà."}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway doğrulanamadı. Kurulum bunu onaracak."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося перевірити OpenClaw Gateway. Це буде виправлено під час налаштування."}},"id":{"stringUnit":{"state":"translated","value":"Gateway OpenClaw tidak dapat diverifikasi. Penyiapan akan memperbaikinya."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się zweryfikować OpenClaw Gateway. Konfigurator go naprawi."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถตรวจสอบยืนยัน OpenClaw Gateway ได้. ขั้นตอนการตั้งค่าจะซ่อมแซมให้."}},"vi":{"stringUnit":{"state":"translated","value":"Không thể xác minh OpenClaw Gateway. Quá trình thiết lập sẽ sửa chữa Gateway."}},"nl":{"stringUnit":{"state":"translated","value":"De OpenClaw Gateway kon niet worden geverifieerd. Dit wordt tijdens de installatie hersteld."}},"fa":{"stringUnit":{"state":"translated","value":"تأیید OpenClaw Gateway ممکن نشد. فرایند راه‌اندازی آن را ترمیم خواهد کرد."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось проверить OpenClaw Gateway. Он будет восстановлен в ходе настройки."}},"sv":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway kunde inte verifieras. Installationsprogrammet reparerar den."}}}},
    "The Voice Wake and push-to-talk controls are hidden on older macOS versions.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Voice Wake and push-to-talk controls are hidden on older macOS versions."}},"zh-CN":{"stringUnit":{"state":"translated","value":"在较旧的 macOS 版本上, 语音唤醒和按住说话控件会被隐藏。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"在較舊的 macOS 版本中, 語音喚醒和按住說話控制項會隱藏。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Os controles de ativação por voz e de pressionar para falar ficam ocultos em versões mais antigas do macOS."}},"de":{"stringUnit":{"state":"translated","value":"Die Steuerelemente für die Sprachaktivierung und Push-to-Talk sind auf älteren macOS-Versionen ausgeblendet."}},"es":{"stringUnit":{"state":"translated","value":"Los controles de activación por voz y de pulsar para hablar están ocultos en versiones anteriores de macOS."}},"ja-JP":{"stringUnit":{"state":"translated","value":"古いバージョンの macOS では、音声起動とプッシュトゥトークのコントロールは非表示になります。"}},"ko":{"stringUnit":{"state":"translated","value":"이전 macOS 버전에서는 음성 깨우기 및 눌러서 말하기 컨트롤이 숨겨집니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les commandes de réveil vocal et d’appui pour parler sont masquées sur les anciennes versions de macOS."}},"hi":{"stringUnit":{"state":"translated","value":"macOS के पुराने संस्करणों पर आवाज़ से सक्रिय करने और पुश-टू-टॉक के नियंत्रण छिपे रहते हैं."}},"ar":{"stringUnit":{"state":"translated","value":"تكون عناصر التحكم في التنشيط بالصوت والضغط للتحدث مخفية في إصدارات macOS الأقدم."}},"it":{"stringUnit":{"state":"translated","value":"I controlli di attivazione vocale e premi per parlare sono nascosti nelle versioni meno recenti di macOS."}},"tr":{"stringUnit":{"state":"translated","value":"Sesle Uyandırma ve bas-konuş denetimleri eski macOS sürümlerinde gizlidir."}},"uk":{"stringUnit":{"state":"translated","value":"Елементи керування голосовою активацією та режимом «натисніть, щоб говорити» приховані в старіших версіях macOS."}},"id":{"stringUnit":{"state":"translated","value":"Kontrol pengaktifan suara dan tekan-untuk-bicara disembunyikan pada versi macOS yang lebih lama."}},"pl":{"stringUnit":{"state":"translated","value":"Elementy sterujące wybudzaniem głosowym i funkcją „naciśnij i mów” są ukryte w starszych wersjach macOS."}},"th":{"stringUnit":{"state":"translated","value":"ตัวควบคุมการปลุกด้วยเสียงและการกดเพื่อพูดจะถูกซ่อนไว้ใน macOS รุ่นเก่า."}},"vi":{"stringUnit":{"state":"translated","value":"Các nút điều khiển đánh thức bằng giọng nói và nhấn để nói bị ẩn trên các phiên bản macOS cũ hơn."}},"nl":{"stringUnit":{"state":"translated","value":"De bedieningselementen voor Voice Wake en push-to-talk zijn verborgen in oudere macOS-versies."}},"fa":{"stringUnit":{"state":"translated","value":"کنترل‌های بیدارسازی صوتی و فشردن برای صحبت در نسخه‌های قدیمی‌تر macOS پنهان هستند."}},"ru":{"stringUnit":{"state":"translated","value":"Элементы управления голосовой активацией и разговором по нажатию скрыты в старых версиях macOS."}},"sv":{"stringUnit":{"state":"translated","value":"Reglagen för röstaktivering och tryck för att tala är dolda i äldre macOS-versioner."}}}},
    "The WebSocket URL exposed by the remote Gateway.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The WebSocket URL exposed by the remote Gateway."}},"zh-CN":{"stringUnit":{"state":"translated","value":"远程 Gateway 对外提供的 WebSocket URL."}},"zh-TW":{"stringUnit":{"state":"translated","value":"遠端 Gateway 提供的 WebSocket URL."}},"pt-BR":{"stringUnit":{"state":"translated","value":"A URL do WebSocket exposta pelo Gateway remoto."}},"de":{"stringUnit":{"state":"translated","value":"Die vom entfernten Gateway bereitgestellte WebSocket-URL."}},"es":{"stringUnit":{"state":"translated","value":"La URL de WebSocket expuesta por el Gateway remoto."}},"ja-JP":{"stringUnit":{"state":"translated","value":"リモート Gateway が公開する WebSocket URL。"}},"ko":{"stringUnit":{"state":"translated","value":"원격 Gateway가 제공하는 WebSocket URL입니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’URL WebSocket exposée par le Gateway distant."}},"hi":{"stringUnit":{"state":"translated","value":"दूरस्थ Gateway द्वारा उपलब्ध कराया गया WebSocket URL."}},"ar":{"stringUnit":{"state":"translated","value":"عنوان URL لاتصال WebSocket الذي يتيحه Gateway البعيد."}},"it":{"stringUnit":{"state":"translated","value":"L'URL WebSocket esposto dal Gateway remoto."}},"tr":{"stringUnit":{"state":"translated","value":"Uzak Gateway tarafından sunulan WebSocket URL'si."}},"uk":{"stringUnit":{"state":"translated","value":"URL-адреса WebSocket, яку надає віддалений Gateway."}},"id":{"stringUnit":{"state":"translated","value":"URL WebSocket yang disediakan oleh Gateway jarak jauh."}},"pl":{"stringUnit":{"state":"translated","value":"Adres URL WebSocket udostępniany przez zdalny Gateway."}},"th":{"stringUnit":{"state":"translated","value":"URL ของ WebSocket ที่ Gateway ระยะไกลเปิดให้ใช้งาน."}},"vi":{"stringUnit":{"state":"translated","value":"URL WebSocket do Gateway từ xa cung cấp."}},"nl":{"stringUnit":{"state":"translated","value":"De WebSocket-URL die door de externe Gateway beschikbaar wordt gesteld."}},"fa":{"stringUnit":{"state":"translated","value":"نشانی WebSocket ارائه‌شده توسط Gateway راه دور."}},"ru":{"stringUnit":{"state":"translated","value":"URL WebSocket, предоставляемый удалённым Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"WebSocket-URL:en som tillhandahålls av fjärransluten Gateway."}}}},
    "The current gateway.remote.token value is not plain text. OpenClaw for macOS cannot use it directly; enter a plaintext token here to replace it.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The current gateway.remote.token value is not plain text. OpenClaw for macOS cannot use it directly; enter a plaintext token here to replace it."}},"zh-CN":{"stringUnit":{"state":"translated","value":"当前的 gateway.remote.token 值不是纯文本。 macOS 版 OpenClaw 无法直接使用它; 请在此输入纯文本令牌以替换它。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"目前的 gateway.remote.token 值不是純文字。 macOS 版 OpenClaw 無法直接使用此值; 請在此輸入純文字權杖以取代它。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O valor atual de gateway.remote.token não está em texto simples. O OpenClaw para macOS não pode usá-lo diretamente; insira aqui um token em texto simples para substituí-lo."}},"de":{"stringUnit":{"state":"translated","value":"Der aktuelle Wert von gateway.remote.token liegt nicht als Klartext vor. OpenClaw für macOS kann ihn nicht direkt verwenden; geben Sie hier ein Klartext-Token ein, um ihn zu ersetzen."}},"es":{"stringUnit":{"state":"translated","value":"El valor actual de gateway.remote.token no es texto sin formato. OpenClaw para macOS no puede usarlo directamente; introduce aquí un token en texto sin formato para reemplazarlo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"現在の gateway.remote.token の値はプレーンテキストではありません。OpenClaw for macOS では直接使用できません。ここにプレーンテキストのトークンを入力して置き換えてください。"}},"ko":{"stringUnit":{"state":"translated","value":"현재 gateway.remote.token 값은 일반 텍스트가 아닙니다. macOS용 OpenClaw에서는 이 값을 직접 사용할 수 없습니다; 여기에 일반 텍스트 토큰을 입력하여 교체하세요."}},"fr":{"stringUnit":{"state":"translated","value":"La valeur actuelle de gateway.remote.token n’est pas en texte brut. OpenClaw pour macOS ne peut pas l’utiliser directement ; saisissez ici un jeton en texte brut pour la remplacer."}},"hi":{"stringUnit":{"state":"translated","value":"वर्तमान gateway.remote.token मान सादे टेक्स्ट में नहीं है. macOS के लिए OpenClaw इसका सीधे उपयोग नहीं कर सकता; इसे बदलने के लिए यहाँ सादे टेक्स्ट में टोकन दर्ज करें."}},"ar":{"stringUnit":{"state":"translated","value":"القيمة الحالية للمفتاح gateway.remote.token ليست نصًا عاديًا. لا يستطيع OpenClaw لنظام macOS استخدامها مباشرة؛ أدخل هنا رمزًا مميزًا بنص عادي لاستبدالها."}},"it":{"stringUnit":{"state":"translated","value":"Il valore attuale di gateway.remote.token non è in testo semplice. OpenClaw per macOS non può usarlo direttamente; inserisci qui un token in testo semplice per sostituirlo."}},"tr":{"stringUnit":{"state":"translated","value":"Mevcut gateway.remote.token değeri düz metin değil. macOS için OpenClaw bunu doğrudan kullanamaz; değiştirmek için buraya düz metin biçiminde bir belirteç girin."}},"uk":{"stringUnit":{"state":"translated","value":"Поточне значення gateway.remote.token не є звичайним текстом. OpenClaw для macOS не може використовувати його безпосередньо; введіть тут токен у вигляді звичайного тексту, щоб замінити його."}},"id":{"stringUnit":{"state":"translated","value":"Nilai gateway.remote.token saat ini bukan teks biasa. OpenClaw untuk macOS tidak dapat menggunakannya secara langsung; masukkan token teks biasa di sini untuk menggantinya."}},"pl":{"stringUnit":{"state":"translated","value":"Bieżąca wartość gateway.remote.token nie jest zwykłym tekstem. OpenClaw dla macOS nie może jej użyć bezpośrednio; wpisz tutaj token w postaci zwykłego tekstu, aby ją zastąpić."}},"th":{"stringUnit":{"state":"translated","value":"ค่า gateway.remote.token ปัจจุบันไม่ใช่ข้อความธรรมดา. OpenClaw สำหรับ macOS ไม่สามารถใช้ค่านี้ได้โดยตรง; ป้อนโทเค็นแบบข้อความธรรมดาที่นี่เพื่อแทนที่."}},"vi":{"stringUnit":{"state":"translated","value":"Giá trị gateway.remote.token hiện tại không phải là văn bản thuần. OpenClaw dành cho macOS không thể sử dụng trực tiếp giá trị này; hãy nhập mã thông báo dạng văn bản thuần tại đây để thay thế."}},"nl":{"stringUnit":{"state":"translated","value":"De huidige waarde van gateway.remote.token is geen platte tekst. OpenClaw voor macOS kan deze niet rechtstreeks gebruiken; voer hier een token in platte tekst in om deze te vervangen."}},"fa":{"stringUnit":{"state":"translated","value":"مقدار فعلی gateway.remote.token متن ساده نیست. OpenClaw برای macOS نمی‌تواند مستقیماً از آن استفاده کند; برای جایگزینی آن، یک توکن با متن ساده در اینجا وارد کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Текущее значение gateway.remote.token не является обычным текстом. OpenClaw для macOS не может использовать его напрямую; введите здесь токен в виде обычного текста, чтобы заменить его."}},"sv":{"stringUnit":{"state":"translated","value":"Det aktuella värdet för gateway.remote.token är inte i klartext. OpenClaw för macOS kan inte använda det direkt; ange en token i klartext här för att ersätta det."}}}},
    "The details are listed on each option above. You can fix the login and retry, or connect with an API key or token below.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The details are listed on each option above. You can fix the login and retry, or connect with an API key or token below."}},"zh-CN":{"stringUnit":{"state":"translated","value":"详细信息列于上方各选项中。你可以解决登录问题后重试，或在下方使用 API 密钥或令牌连接。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"詳細資訊列於上方各個選項中。您可以修正登入問題後重試，或使用下方的 API 金鑰或權杖連線。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Os detalhes estão listados em cada opção acima. Você pode corrigir o login e tentar novamente ou se conectar com uma chave de API ou um token abaixo."}},"de":{"stringUnit":{"state":"translated","value":"Die Details sind bei jeder der obigen Optionen aufgeführt. Sie können das Anmeldeproblem beheben und es erneut versuchen oder sich unten mit einem API-Schlüssel oder Token verbinden."}},"es":{"stringUnit":{"state":"translated","value":"Los detalles se indican en cada opción anterior. Puedes corregir el inicio de sesión y volver a intentarlo, o conectarte con una clave de API o un token a continuación."}},"ja-JP":{"stringUnit":{"state":"translated","value":"詳細は上記の各オプションに記載されています。ログインの問題を解決して再試行するか、下記のAPIキーまたはトークンで接続できます。"}},"ko":{"stringUnit":{"state":"translated","value":"자세한 내용은 위의 각 옵션에 나와 있습니다. 로그인 문제를 해결한 후 다시 시도하거나, 아래에서 API 키 또는 토큰으로 연결할 수 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les détails figurent dans chaque option ci-dessus. Vous pouvez résoudre le problème de connexion et réessayer, ou vous connecter avec une clé API ou un jeton ci-dessous."}},"hi":{"stringUnit":{"state":"translated","value":"विवरण ऊपर दिए गए हर विकल्प में सूचीबद्ध हैं. आप लॉगिन की समस्या ठीक करके फिर कोशिश कर सकते हैं, या नीचे API कुंजी या टोकन से कनेक्ट कर सकते हैं."}},"ar":{"stringUnit":{"state":"translated","value":"التفاصيل مدرجة في كل خيار أعلاه. يمكنك إصلاح مشكلة تسجيل الدخول وإعادة المحاولة، أو الاتصال باستخدام مفتاح API أو رمز مميز أدناه."}},"it":{"stringUnit":{"state":"translated","value":"I dettagli sono elencati per ciascuna opzione qui sopra. Puoi risolvere il problema di accesso e riprovare, oppure connetterti con una chiave API o un token qui sotto."}},"tr":{"stringUnit":{"state":"translated","value":"Ayrıntılar yukarıdaki her seçenekte listelenmiştir. Oturum açma sorununu giderip yeniden deneyebilir veya aşağıdan bir API anahtarı ya da belirteç ile bağlanabilirsiniz."}},"uk":{"stringUnit":{"state":"translated","value":"Подробиці наведено для кожного варіанта вище. Ви можете виправити проблему з входом і повторити спробу або підключитися за допомогою ключа API чи токена нижче."}},"id":{"stringUnit":{"state":"translated","value":"Detail tercantum pada setiap opsi di atas. Anda dapat memperbaiki proses masuk dan mencoba lagi, atau terhubung dengan kunci API atau token di bawah."}},"pl":{"stringUnit":{"state":"translated","value":"Szczegóły podano przy każdej z powyższych opcji. Możesz rozwiązać problem z logowaniem i spróbować ponownie lub połączyć się za pomocą klucza API albo tokena poniżej."}},"th":{"stringUnit":{"state":"translated","value":"รายละเอียดแสดงอยู่ในแต่ละตัวเลือกด้านบน คุณสามารถแก้ไขการเข้าสู่ระบบแล้วลองอีกครั้ง หรือเชื่อมต่อด้วยคีย์ API หรือโทเค็นด้านล่าง"}},"vi":{"stringUnit":{"state":"translated","value":"Chi tiết được liệt kê ở từng tùy chọn phía trên. Bạn có thể khắc phục sự cố đăng nhập rồi thử lại, hoặc kết nối bằng khóa API hay token bên dưới."}},"nl":{"stringUnit":{"state":"translated","value":"De details staan bij elke optie hierboven. Je kunt het aanmeldprobleem oplossen en het opnieuw proberen, of hieronder verbinding maken met een API-sleutel of token."}},"fa":{"stringUnit":{"state":"translated","value":"جزئیات در هر یک از گزینه‌های بالا آمده است. می‌توانید مشکل ورود را برطرف کنید و دوباره تلاش کنید، یا در پایین با کلید API یا توکن متصل شوید."}},"ru":{"stringUnit":{"state":"translated","value":"Подробности указаны для каждого варианта выше. Вы можете устранить проблему со входом и повторить попытку или подключиться с помощью API-ключа или токена ниже."}},"sv":{"stringUnit":{"state":"translated","value":"Detaljerna anges vid varje alternativ ovan. Du kan åtgärda inloggningen och försöka igen, eller ansluta med en API-nyckel eller token nedan."}}}},
    "The earlier conversation was cleared.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The earlier conversation was cleared."}},"zh-CN":{"stringUnit":{"state":"translated","value":"之前的对话已清除。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"先前的對話已清除。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A conversa anterior foi apagada."}},"de":{"stringUnit":{"state":"translated","value":"Die vorherige Unterhaltung wurde gelöscht."}},"es":{"stringUnit":{"state":"translated","value":"Se borró la conversación anterior."}},"ja-JP":{"stringUnit":{"state":"translated","value":"以前の会話は消去されました。"}},"ko":{"stringUnit":{"state":"translated","value":"이전 대화가 지워졌습니다."}},"fr":{"stringUnit":{"state":"translated","value":"La conversation précédente a été effacée."}},"hi":{"stringUnit":{"state":"translated","value":"पिछली बातचीत हटा दी गई थी."}},"ar":{"stringUnit":{"state":"translated","value":"تم مسح المحادثة السابقة."}},"it":{"stringUnit":{"state":"translated","value":"La conversazione precedente è stata cancellata."}},"tr":{"stringUnit":{"state":"translated","value":"Önceki konuşma temizlendi."}},"uk":{"stringUnit":{"state":"translated","value":"Попередню розмову очищено."}},"id":{"stringUnit":{"state":"translated","value":"Percakapan sebelumnya telah dihapus."}},"pl":{"stringUnit":{"state":"translated","value":"Wcześniejsza rozmowa została wyczyszczona."}},"th":{"stringUnit":{"state":"translated","value":"ล้างการสนทนาก่อนหน้าแล้ว"}},"vi":{"stringUnit":{"state":"translated","value":"Cuộc trò chuyện trước đó đã được xóa."}},"nl":{"stringUnit":{"state":"translated","value":"Het eerdere gesprek is gewist."}},"fa":{"stringUnit":{"state":"translated","value":"گفتگوی قبلی پاک شد."}},"ru":{"stringUnit":{"state":"translated","value":"Предыдущая переписка была очищена."}},"sv":{"stringUnit":{"state":"translated","value":"Den tidigare konversationen rensades."}}}},
    "The full message could not be loaded.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The full message could not be loaded."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法加载完整消息。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法載入完整訊息。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível carregar a mensagem completa."}},"de":{"stringUnit":{"state":"translated","value":"Die vollständige Nachricht konnte nicht geladen werden."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo cargar el mensaje completo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"メッセージの全文を読み込めませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"전체 메시지를 불러오지 못했습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le message complet n’a pas pu être chargé."}},"hi":{"stringUnit":{"state":"translated","value":"पूरा संदेश लोड नहीं हो सका."}},"ar":{"stringUnit":{"state":"translated","value":"تعذر تحميل الرسالة كاملة."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile caricare il messaggio completo."}},"tr":{"stringUnit":{"state":"translated","value":"Mesajın tamamı yüklenemedi."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося завантажити повне повідомлення."}},"id":{"stringUnit":{"state":"translated","value":"Pesan lengkap tidak dapat dimuat."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się wczytać pełnej wiadomości."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถโหลดข้อความฉบับเต็มได้"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể tải toàn bộ tin nhắn."}},"nl":{"stringUnit":{"state":"translated","value":"Het volledige bericht kon niet worden geladen."}},"fa":{"stringUnit":{"state":"translated","value":"بارگیری پیام کامل ممکن نشد."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось загрузить полное сообщение."}},"sv":{"stringUnit":{"state":"translated","value":"Det fullständiga meddelandet kunde inte läsas in."}}}},
    "The full message has no readable text.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The full message has no readable text."}},"zh-CN":{"stringUnit":{"state":"translated","value":"完整消息中没有可读文本。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"完整訊息中沒有可讀取的文字。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A mensagem completa não tem texto legível."}},"de":{"stringUnit":{"state":"translated","value":"Die vollständige Nachricht enthält keinen lesbaren Text."}},"es":{"stringUnit":{"state":"translated","value":"El mensaje completo no contiene texto legible."}},"ja-JP":{"stringUnit":{"state":"translated","value":"メッセージの全文に読み取り可能なテキストがありません。"}},"ko":{"stringUnit":{"state":"translated","value":"전체 메시지에 읽을 수 있는 텍스트가 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le message complet ne contient aucun texte lisible."}},"hi":{"stringUnit":{"state":"translated","value":"पूरे संदेश में पढ़ने योग्य कोई पाठ नहीं है."}},"ar":{"stringUnit":{"state":"translated","value":"لا تحتوي الرسالة الكاملة على نص قابل للقراءة."}},"it":{"stringUnit":{"state":"translated","value":"Il messaggio completo non contiene testo leggibile."}},"tr":{"stringUnit":{"state":"translated","value":"Mesajın tamamında okunabilir metin yok."}},"uk":{"stringUnit":{"state":"translated","value":"Повне повідомлення не містить читабельного тексту."}},"id":{"stringUnit":{"state":"translated","value":"Pesan lengkap tidak memiliki teks yang dapat dibaca."}},"pl":{"stringUnit":{"state":"translated","value":"Pełna wiadomość nie zawiera tekstu możliwego do odczytania."}},"th":{"stringUnit":{"state":"translated","value":"ข้อความฉบับเต็มไม่มีเนื้อหาที่อ่านได้"}},"vi":{"stringUnit":{"state":"translated","value":"Toàn bộ tin nhắn không có văn bản nào đọc được."}},"nl":{"stringUnit":{"state":"translated","value":"Het volledige bericht bevat geen leesbare tekst."}},"fa":{"stringUnit":{"state":"translated","value":"پیام کامل متن خواندنی ندارد."}},"ru":{"stringUnit":{"state":"translated","value":"В полном сообщении нет читаемого текста."}},"sv":{"stringUnit":{"state":"translated","value":"Det fullständiga meddelandet saknar läsbar text."}}}},
    "The full message is no longer available.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The full message is no longer available."}},"zh-CN":{"stringUnit":{"state":"translated","value":"完整消息已不可用。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"完整訊息已無法使用。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A mensagem completa não está mais disponível."}},"de":{"stringUnit":{"state":"translated","value":"Die vollständige Nachricht ist nicht mehr verfügbar."}},"es":{"stringUnit":{"state":"translated","value":"El mensaje completo ya no está disponible."}},"ja-JP":{"stringUnit":{"state":"translated","value":"メッセージの全文は利用できなくなりました。"}},"ko":{"stringUnit":{"state":"translated","value":"전체 메시지를 더 이상 사용할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le message complet n’est plus disponible."}},"hi":{"stringUnit":{"state":"translated","value":"पूरा संदेश अब उपलब्ध नहीं है."}},"ar":{"stringUnit":{"state":"translated","value":"لم تعد الرسالة الكاملة متاحة."}},"it":{"stringUnit":{"state":"translated","value":"Il messaggio completo non è più disponibile."}},"tr":{"stringUnit":{"state":"translated","value":"Mesajın tamamı artık kullanılamıyor."}},"uk":{"stringUnit":{"state":"translated","value":"Повне повідомлення більше не доступне."}},"id":{"stringUnit":{"state":"translated","value":"Pesan lengkap tidak lagi tersedia."}},"pl":{"stringUnit":{"state":"translated","value":"Pełna wiadomość nie jest już dostępna."}},"th":{"stringUnit":{"state":"translated","value":"ข้อความฉบับเต็มไม่พร้อมใช้งานอีกต่อไป"}},"vi":{"stringUnit":{"state":"translated","value":"Toàn bộ tin nhắn không còn khả dụng."}},"nl":{"stringUnit":{"state":"translated","value":"Het volledige bericht is niet meer beschikbaar."}},"fa":{"stringUnit":{"state":"translated","value":"پیام کامل دیگر در دسترس نیست."}},"ru":{"stringUnit":{"state":"translated","value":"Полное сообщение больше недоступно."}},"sv":{"stringUnit":{"state":"translated","value":"Det fullständiga meddelandet är inte längre tillgängligt."}}}},
    "The legacy native pane can be re-enabled in Settings > Debug.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The legacy native pane can be re-enabled in Settings > Debug."}},"zh-CN":{"stringUnit":{"state":"translated","value":"可在设置 > 调试中重新启用旧版原生面板。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"可在「設定 > 偵錯」中重新啟用舊版原生面板。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O painel nativo legado pode ser reativado em Ajustes > Depuração."}},"de":{"stringUnit":{"state":"translated","value":"Der bisherige native Bereich kann unter Einstellungen > Debug wieder aktiviert werden."}},"es":{"stringUnit":{"state":"translated","value":"El panel nativo antiguo se puede volver a activar en Ajustes > Depuración."}},"ja-JP":{"stringUnit":{"state":"translated","value":"従来のネイティブペインは、設定 > デバッグで再度有効にできます。"}},"ko":{"stringUnit":{"state":"translated","value":"기존 네이티브 패널은 설정 > 디버그에서 다시 활성화할 수 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’ancien panneau natif peut être réactivé dans Réglages > Débogage."}},"hi":{"stringUnit":{"state":"translated","value":"पुराने नेटिव पैन को सेटिंग्स > डीबग में फिर से सक्षम किया जा सकता है."}},"ar":{"stringUnit":{"state":"translated","value":"يمكن إعادة تمكين اللوحة الأصلية القديمة من الإعدادات > تصحيح الأخطاء."}},"it":{"stringUnit":{"state":"translated","value":"Il pannello nativo precedente può essere riattivato in Impostazioni > Debug."}},"tr":{"stringUnit":{"state":"translated","value":"Eski yerel panel, Ayarlar > Hata Ayıklama bölümünden yeniden etkinleştirilebilir."}},"uk":{"stringUnit":{"state":"translated","value":"Застарілу нативну панель можна знову ввімкнути в розділі Налаштування > Налагодження."}},"id":{"stringUnit":{"state":"translated","value":"Panel native lama dapat diaktifkan kembali di Pengaturan > Debug."}},"pl":{"stringUnit":{"state":"translated","value":"Starszy panel natywny można ponownie włączyć w Ustawienia > Debugowanie."}},"th":{"stringUnit":{"state":"translated","value":"สามารถเปิดใช้งานแผงเนทีฟแบบเดิมอีกครั้งได้ใน การตั้งค่า > ดีบัก"}},"vi":{"stringUnit":{"state":"translated","value":"Có thể bật lại bảng điều khiển gốc phiên bản cũ trong Cài đặt > Gỡ lỗi."}},"nl":{"stringUnit":{"state":"translated","value":"Het verouderde native paneel kan opnieuw worden ingeschakeld in Instellingen > Debug."}},"fa":{"stringUnit":{"state":"translated","value":"پنل بومی قدیمی را می‌توان در تنظیمات > اشکال‌زدایی دوباره فعال کرد."}},"ru":{"stringUnit":{"state":"translated","value":"Устаревшую нативную панель можно снова включить в разделе Настройки > Отладка."}},"sv":{"stringUnit":{"state":"translated","value":"Den äldre inbyggda panelen kan aktiveras igen under Inställningar > Felsökning."}}}},
    "The main thread cannot be deleted.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The main thread cannot be deleted."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法删除主会话。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法刪除主要對話串。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A conversa principal não pode ser excluída."}},"de":{"stringUnit":{"state":"translated","value":"Der Hauptthread kann nicht gelöscht werden."}},"es":{"stringUnit":{"state":"translated","value":"No se puede eliminar el hilo principal."}},"ja-JP":{"stringUnit":{"state":"translated","value":"メインスレッドは削除できません。"}},"ko":{"stringUnit":{"state":"translated","value":"기본 스레드는 삭제할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le fil principal ne peut pas être supprimé."}},"hi":{"stringUnit":{"state":"translated","value":"मुख्य थ्रेड हटाया नहीं जा सकता."}},"ar":{"stringUnit":{"state":"translated","value":"لا يمكن حذف سلسلة المحادثة الرئيسية."}},"it":{"stringUnit":{"state":"translated","value":"La conversazione principale non può essere eliminata."}},"tr":{"stringUnit":{"state":"translated","value":"Ana konuşma dizisi silinemez."}},"uk":{"stringUnit":{"state":"translated","value":"Основну гілку розмови не можна видалити."}},"id":{"stringUnit":{"state":"translated","value":"Utas utama tidak dapat dihapus."}},"pl":{"stringUnit":{"state":"translated","value":"Nie można usunąć głównego wątku."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถลบเธรดหลักได้"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể xóa luồng chính."}},"nl":{"stringUnit":{"state":"translated","value":"De hoofdthread kan niet worden verwijderd."}},"fa":{"stringUnit":{"state":"translated","value":"رشتهٔ گفتگوی اصلی را نمی‌توان حذف کرد."}},"ru":{"stringUnit":{"state":"translated","value":"Основную ветку нельзя удалить."}},"sv":{"stringUnit":{"state":"translated","value":"Huvudtråden kan inte tas bort."}}}},
    "The managed OpenClaw runtime could not be reinstalled.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The managed OpenClaw runtime could not be reinstalled."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法重新安装托管的 OpenClaw 运行时。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法重新安裝受管理的 OpenClaw 執行環境。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível reinstalar o ambiente de execução gerenciado do OpenClaw."}},"de":{"stringUnit":{"state":"translated","value":"Die verwaltete OpenClaw-Laufzeitumgebung konnte nicht erneut installiert werden."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo reinstalar el entorno de ejecución administrado de OpenClaw."}},"ja-JP":{"stringUnit":{"state":"translated","value":"管理対象のOpenClawランタイムを再インストールできませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"관리형 OpenClaw 런타임을 다시 설치하지 못했습니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’environnement d’exécution géré d’OpenClaw n’a pas pu être réinstallé."}},"hi":{"stringUnit":{"state":"translated","value":"प्रबंधित OpenClaw रनटाइम फिर से इंस्टॉल नहीं हो सका."}},"ar":{"stringUnit":{"state":"translated","value":"تعذرت إعادة تثبيت بيئة تشغيل OpenClaw المُدارة."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile reinstallare il runtime gestito di OpenClaw."}},"tr":{"stringUnit":{"state":"translated","value":"Yönetilen OpenClaw çalışma zamanı yeniden yüklenemedi."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося перевстановити кероване середовище виконання OpenClaw."}},"id":{"stringUnit":{"state":"translated","value":"Runtime OpenClaw terkelola tidak dapat diinstal ulang."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się ponownie zainstalować zarządzanego środowiska uruchomieniowego OpenClaw."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถติดตั้งรันไทม์ OpenClaw ที่มีการจัดการใหม่ได้"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể cài đặt lại môi trường thực thi OpenClaw được quản lý."}},"nl":{"stringUnit":{"state":"translated","value":"De beheerde OpenClaw-runtime kon niet opnieuw worden geïnstalleerd."}},"fa":{"stringUnit":{"state":"translated","value":"نصب مجدد محیط اجرای مدیریت‌شدهٔ OpenClaw ممکن نشد."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось переустановить управляемую среду выполнения OpenClaw."}},"sv":{"stringUnit":{"state":"translated","value":"Den hanterade OpenClaw-körmiljön kunde inte installeras om."}}}},
    "The managed runtime does not match the updated Mac app.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The managed runtime does not match the updated Mac app."}},"zh-CN":{"stringUnit":{"state":"translated","value":"托管运行时与更新后的 Mac 应用不匹配。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"受管理的執行環境與更新後的 Mac App 不相符。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O ambiente de execução gerenciado não corresponde ao app atualizado para Mac."}},"de":{"stringUnit":{"state":"translated","value":"Die verwaltete Laufzeitumgebung passt nicht zur aktualisierten Mac-App."}},"es":{"stringUnit":{"state":"translated","value":"El entorno de ejecución administrado no coincide con la aplicación actualizada para Mac."}},"ja-JP":{"stringUnit":{"state":"translated","value":"管理対象のランタイムが、更新されたMacアプリと一致しません。"}},"ko":{"stringUnit":{"state":"translated","value":"관리형 런타임이 업데이트된 Mac 앱과 일치하지 않습니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’environnement d’exécution géré ne correspond pas à l’application Mac mise à jour."}},"hi":{"stringUnit":{"state":"translated","value":"प्रबंधित रनटाइम अपडेट किए गए Mac ऐप से मेल नहीं खाता."}},"ar":{"stringUnit":{"state":"translated","value":"بيئة التشغيل المُدارة لا تتطابق مع تطبيق Mac المُحدَّث."}},"it":{"stringUnit":{"state":"translated","value":"Il runtime gestito non corrisponde all'app Mac aggiornata."}},"tr":{"stringUnit":{"state":"translated","value":"Yönetilen çalışma zamanı, güncellenmiş Mac uygulamasıyla eşleşmiyor."}},"uk":{"stringUnit":{"state":"translated","value":"Кероване середовище виконання не відповідає оновленому застосунку для Mac."}},"id":{"stringUnit":{"state":"translated","value":"Runtime terkelola tidak cocok dengan aplikasi Mac yang telah diperbarui."}},"pl":{"stringUnit":{"state":"translated","value":"Zarządzane środowisko uruchomieniowe nie jest zgodne ze zaktualizowaną aplikacją na Maca."}},"th":{"stringUnit":{"state":"translated","value":"รันไทม์ที่มีการจัดการไม่ตรงกับแอป Mac ที่อัปเดตแล้ว"}},"vi":{"stringUnit":{"state":"translated","value":"Môi trường thực thi được quản lý không khớp với ứng dụng Mac đã cập nhật."}},"nl":{"stringUnit":{"state":"translated","value":"De beheerde runtime komt niet overeen met de bijgewerkte Mac-app."}},"fa":{"stringUnit":{"state":"translated","value":"محیط اجرای مدیریت‌شده با برنامهٔ به‌روزشدهٔ Mac مطابقت ندارد."}},"ru":{"stringUnit":{"state":"translated","value":"Управляемая среда выполнения не соответствует обновлённому приложению для Mac."}},"sv":{"stringUnit":{"state":"translated","value":"Den hanterade körmiljön matchar inte den uppdaterade Mac-appen."}}}},
    "The node service restarted but did not remain running.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The node service restarted but did not remain running."}},"zh-CN":{"stringUnit":{"state":"translated","value":"节点服务已重启，但未能持续运行。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"節點服務已重新啟動，但未持續執行。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O serviço do nó foi reiniciado, mas não permaneceu em execução."}},"de":{"stringUnit":{"state":"translated","value":"Der Knotendienst wurde neu gestartet, lief danach aber nicht weiter."}},"es":{"stringUnit":{"state":"translated","value":"El servicio del nodo se reinició, pero no siguió ejecutándose."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ノードサービスは再起動しましたが、実行を継続できませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"노드 서비스가 다시 시작되었지만 실행 상태를 유지하지 못했습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le service du nœud a redémarré, mais n’est pas resté en cours d’exécution."}},"hi":{"stringUnit":{"state":"translated","value":"नोड सेवा फिर से शुरू हुई, लेकिन चलती नहीं रही."}},"ar":{"stringUnit":{"state":"translated","value":"أُعيد تشغيل خدمة العقدة لكنها لم تستمر في العمل."}},"it":{"stringUnit":{"state":"translated","value":"Il servizio del nodo è stato riavviato, ma non è rimasto in esecuzione."}},"tr":{"stringUnit":{"state":"translated","value":"Düğüm hizmeti yeniden başlatıldı ancak çalışmaya devam etmedi."}},"uk":{"stringUnit":{"state":"translated","value":"Служба вузла перезапустилася, але не продовжила роботу."}},"id":{"stringUnit":{"state":"translated","value":"Layanan node dimulai ulang tetapi tidak terus berjalan."}},"pl":{"stringUnit":{"state":"translated","value":"Usługa węzła została uruchomiona ponownie, ale nie pozostała aktywna."}},"th":{"stringUnit":{"state":"translated","value":"บริการโหนดเริ่มต้นใหม่แล้ว แต่ไม่ได้ทำงานต่อเนื่อง"}},"vi":{"stringUnit":{"state":"translated","value":"Dịch vụ nút đã khởi động lại nhưng không duy trì hoạt động."}},"nl":{"stringUnit":{"state":"translated","value":"De nodeservice is opnieuw gestart, maar bleef niet actief."}},"fa":{"stringUnit":{"state":"translated","value":"سرویس گره بازراه‌اندازی شد، اما در حال اجرا باقی نماند."}},"ru":{"stringUnit":{"state":"translated","value":"Служба узла перезапустилась, но затем остановилась."}},"sv":{"stringUnit":{"state":"translated","value":"Nodtjänsten startades om men slutade sedan köras."}}}},
    "The notification request was queued.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The notification request was queued."}},"zh-CN":{"stringUnit":{"state":"translated","value":"通知请求已加入队列。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"通知請求已加入佇列。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A solicitação de notificação foi adicionada à fila."}},"de":{"stringUnit":{"state":"translated","value":"Die Benachrichtigungsanfrage wurde in die Warteschlange eingereiht."}},"es":{"stringUnit":{"state":"translated","value":"La solicitud de notificación se añadió a la cola."}},"ja-JP":{"stringUnit":{"state":"translated","value":"通知リクエストがキューに追加されました。"}},"ko":{"stringUnit":{"state":"translated","value":"알림 요청이 대기열에 추가되었습니다."}},"fr":{"stringUnit":{"state":"translated","value":"La demande de notification a été mise en file d’attente."}},"hi":{"stringUnit":{"state":"translated","value":"सूचना का अनुरोध कतार में जोड़ दिया गया."}},"ar":{"stringUnit":{"state":"translated","value":"أُضيف طلب الإشعار إلى قائمة الانتظار."}},"it":{"stringUnit":{"state":"translated","value":"La richiesta di notifica è stata aggiunta alla coda."}},"tr":{"stringUnit":{"state":"translated","value":"Bildirim isteği kuyruğa alındı."}},"uk":{"stringUnit":{"state":"translated","value":"Запит на сповіщення додано до черги."}},"id":{"stringUnit":{"state":"translated","value":"Permintaan notifikasi telah dimasukkan ke antrean."}},"pl":{"stringUnit":{"state":"translated","value":"Żądanie powiadomienia zostało dodane do kolejki."}},"th":{"stringUnit":{"state":"translated","value":"นำคำขอแจ้งเตือนเข้าคิวแล้ว"}},"vi":{"stringUnit":{"state":"translated","value":"Yêu cầu thông báo đã được đưa vào hàng đợi."}},"nl":{"stringUnit":{"state":"translated","value":"Het meldingsverzoek is in de wachtrij geplaatst."}},"fa":{"stringUnit":{"state":"translated","value":"درخواست اعلان در صف قرار گرفت."}},"ru":{"stringUnit":{"state":"translated","value":"Запрос на уведомление поставлен в очередь."}},"sv":{"stringUnit":{"state":"translated","value":"Aviseringsbegäran lades i kö."}}}},
    "The remote Gateway is older than this Mac app, so OpenClaw skipped the agent notification.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The remote Gateway is older than this Mac app, so OpenClaw skipped the agent notification."}},"zh-CN":{"stringUnit":{"state":"translated","value":"远程 Gateway 的版本早于此 Mac 应用，因此 OpenClaw 跳过了智能体通知。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"遠端 Gateway 的版本比此 Mac App 舊，因此 OpenClaw 已略過代理程式通知。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Gateway remoto é mais antigo que este app para Mac, por isso o OpenClaw ignorou a notificação do agente."}},"de":{"stringUnit":{"state":"translated","value":"Der entfernte Gateway ist älter als diese Mac-App, daher hat OpenClaw die Agentenbenachrichtigung übersprungen."}},"es":{"stringUnit":{"state":"translated","value":"El Gateway remoto es anterior a esta aplicación para Mac, por lo que OpenClaw omitió la notificación al agente."}},"ja-JP":{"stringUnit":{"state":"translated","value":"リモートのGatewayがこのMacアプリより古いため、OpenClawはエージェントへの通知をスキップしました。"}},"ko":{"stringUnit":{"state":"translated","value":"원격 Gateway가 이 Mac 앱보다 오래된 버전이므로 OpenClaw가 에이전트 알림을 건너뛰었습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le Gateway distant est plus ancien que cette application Mac, OpenClaw n’a donc pas envoyé la notification à l’agent."}},"hi":{"stringUnit":{"state":"translated","value":"रिमोट Gateway इस Mac ऐप से पुराना है, इसलिए OpenClaw ने एजेंट सूचना छोड़ दी."}},"ar":{"stringUnit":{"state":"translated","value":"إصدار Gateway البعيد أقدم من تطبيق Mac هذا، لذا تخطى OpenClaw إشعار الوكيل."}},"it":{"stringUnit":{"state":"translated","value":"Il Gateway remoto è meno recente di questa app Mac, quindi OpenClaw ha saltato la notifica all'agente."}},"tr":{"stringUnit":{"state":"translated","value":"Uzak Gateway, bu Mac uygulamasından daha eski olduğundan OpenClaw aracı bildirimini atladı."}},"uk":{"stringUnit":{"state":"translated","value":"Версія віддаленого Gateway старіша за цей застосунок для Mac, тому OpenClaw пропустив сповіщення агента."}},"id":{"stringUnit":{"state":"translated","value":"Versi Gateway jarak jauh lebih lama daripada aplikasi Mac ini, sehingga OpenClaw melewatkan notifikasi agen."}},"pl":{"stringUnit":{"state":"translated","value":"Zdalny Gateway jest starszy niż ta aplikacja na Maca, więc OpenClaw pominął powiadomienie agenta."}},"th":{"stringUnit":{"state":"translated","value":"Gateway ระยะไกลเป็นเวอร์ชันที่เก่ากว่าแอป Mac นี้ OpenClaw จึงข้ามการแจ้งเตือนเอเจนต์"}},"vi":{"stringUnit":{"state":"translated","value":"Gateway từ xa cũ hơn ứng dụng Mac này, nên OpenClaw đã bỏ qua thông báo cho tác nhân."}},"nl":{"stringUnit":{"state":"translated","value":"De externe Gateway is ouder dan deze Mac-app, dus OpenClaw heeft de agentmelding overgeslagen."}},"fa":{"stringUnit":{"state":"translated","value":"Gateway راه دور از این برنامهٔ Mac قدیمی‌تر است، بنابراین OpenClaw از ارسال اعلان عامل صرف‌نظر کرد."}},"ru":{"stringUnit":{"state":"translated","value":"Версия удалённого Gateway старее версии этого приложения для Mac, поэтому OpenClaw пропустил отправку уведомления агенту."}},"sv":{"stringUnit":{"state":"translated","value":"Fjärrinstansen av Gateway är äldre än den här Mac-appen, så OpenClaw hoppade över agentaviseringen."}}}},
    "The selected Gateway changed.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The selected Gateway changed."}},"zh-CN":{"stringUnit":{"state":"translated","value":"所选 Gateway 已更改。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"所選的 Gateway 已變更。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Gateway selecionado mudou."}},"de":{"stringUnit":{"state":"translated","value":"Das ausgewählte Gateway hat sich geändert."}},"es":{"stringUnit":{"state":"translated","value":"El Gateway seleccionado ha cambiado."}},"ja-JP":{"stringUnit":{"state":"translated","value":"選択したGatewayが変更されました。"}},"ko":{"stringUnit":{"state":"translated","value":"선택한 Gateway가 변경되었습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le Gateway sélectionné a changé."}},"hi":{"stringUnit":{"state":"translated","value":"चयनित Gateway बदल गया."}},"ar":{"stringUnit":{"state":"translated","value":"تغيّر Gateway المحدد."}},"it":{"stringUnit":{"state":"translated","value":"Il Gateway selezionato è cambiato."}},"tr":{"stringUnit":{"state":"translated","value":"Seçili Gateway değişti."}},"uk":{"stringUnit":{"state":"translated","value":"Вибраний Gateway змінився."}},"id":{"stringUnit":{"state":"translated","value":"Gateway yang dipilih telah berubah."}},"pl":{"stringUnit":{"state":"translated","value":"Wybrany Gateway uległ zmianie."}},"th":{"stringUnit":{"state":"translated","value":"Gateway ที่เลือกมีการเปลี่ยนแปลง."}},"vi":{"stringUnit":{"state":"translated","value":"Gateway đã chọn đã thay đổi."}},"nl":{"stringUnit":{"state":"translated","value":"De geselecteerde Gateway is gewijzigd."}},"fa":{"stringUnit":{"state":"translated","value":"Gateway انتخاب‌شده تغییر کرد."}},"ru":{"stringUnit":{"state":"translated","value":"Выбранный Gateway изменился."}},"sv":{"stringUnit":{"state":"translated","value":"Vald Gateway har ändrats."}}}},
    "The thread and its transcript are removed from the gateway.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The thread and its transcript are removed from the gateway."}},"zh-CN":{"stringUnit":{"state":"translated","value":"该对话及其记录已从 Gateway 中移除。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此討論串及其對話記錄會從 Gateway 移除。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A conversa e sua transcrição são removidas do Gateway."}},"de":{"stringUnit":{"state":"translated","value":"Der Thread und sein Transkript werden vom Gateway entfernt."}},"es":{"stringUnit":{"state":"translated","value":"El hilo y su transcripción se eliminan del Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"スレッドとその会話記録はGatewayから削除されます。"}},"ko":{"stringUnit":{"state":"translated","value":"스레드와 대화 기록이 Gateway에서 삭제됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le fil de discussion et sa transcription sont supprimés du Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"थ्रेड और उसका प्रतिलेख Gateway से हटा दिए जाते हैं."}},"ar":{"stringUnit":{"state":"translated","value":"تُزال المحادثة وسجلها من Gateway."}},"it":{"stringUnit":{"state":"translated","value":"La conversazione e la relativa trascrizione vengono rimosse dal Gateway."}},"tr":{"stringUnit":{"state":"translated","value":"Konuşma ve dökümü Gateway'den kaldırılır."}},"uk":{"stringUnit":{"state":"translated","value":"Гілку та її стенограму буде видалено з Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Utas dan transkripnya dihapus dari Gateway."}},"pl":{"stringUnit":{"state":"translated","value":"Wątek i jego transkrypcja są usuwane z Gateway."}},"th":{"stringUnit":{"state":"translated","value":"เธรดและบันทึกการสนทนาจะถูกลบออกจาก Gateway."}},"vi":{"stringUnit":{"state":"translated","value":"Luồng hội thoại và bản ghi của luồng được xóa khỏi Gateway."}},"nl":{"stringUnit":{"state":"translated","value":"De gespreksdraad en het bijbehorende transcript worden van de Gateway verwijderd."}},"fa":{"stringUnit":{"state":"translated","value":"رشتهٔ گفتگو و متن ثبت‌شدهٔ آن از Gateway حذف می‌شوند."}},"ru":{"stringUnit":{"state":"translated","value":"Ветка и её история переписки удаляются из Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Tråden och dess transkript tas bort från Gateway."}}}},
    "The thread could not be created.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The thread could not be created."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法创建对话。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法建立討論串。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível criar a conversa."}},"de":{"stringUnit":{"state":"translated","value":"Der Thread konnte nicht erstellt werden."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo crear el hilo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"スレッドを作成できませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"스레드를 만들 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le fil de discussion n’a pas pu être créé."}},"hi":{"stringUnit":{"state":"translated","value":"थ्रेड बनाया नहीं जा सका."}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر إنشاء المحادثة."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile creare la conversazione."}},"tr":{"stringUnit":{"state":"translated","value":"Konuşma oluşturulamadı."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося створити гілку."}},"id":{"stringUnit":{"state":"translated","value":"Utas tidak dapat dibuat."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się utworzyć wątku."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถสร้างเธรดได้."}},"vi":{"stringUnit":{"state":"translated","value":"Không thể tạo luồng hội thoại."}},"nl":{"stringUnit":{"state":"translated","value":"De gespreksdraad kon niet worden aangemaakt."}},"fa":{"stringUnit":{"state":"translated","value":"ایجاد رشتهٔ گفتگو ممکن نشد."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось создать ветку."}},"sv":{"stringUnit":{"state":"translated","value":"Tråden kunde inte skapas."}}}},
    "The update is installed, but Gateway health did not become ready.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The update is installed, but Gateway health did not become ready."}},"zh-CN":{"stringUnit":{"state":"translated","value":"更新已安装, 但 Gateway 健康状态尚未就绪。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"更新已安裝，但 Gateway 健康狀態尚未就緒。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A atualização foi instalada, mas a verificação de integridade do Gateway não indicou que ele está pronto."}},"de":{"stringUnit":{"state":"translated","value":"Das Update ist installiert, aber das Gateway hat keinen betriebsbereiten Zustand erreicht."}},"es":{"stringUnit":{"state":"translated","value":"La actualización está instalada, pero el Gateway no alcanzó un estado operativo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"アップデートはインストールされましたが、Gatewayのヘルス状態が準備完了になりませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"업데이트가 설치되었지만 Gateway가 준비 상태가 되지 않았습니다."}},"fr":{"stringUnit":{"state":"translated","value":"La mise à jour est installée, mais le contrôle de santé du Gateway n’a pas confirmé qu’il était prêt."}},"hi":{"stringUnit":{"state":"translated","value":"अपडेट इंस्टॉल हो गया है, लेकिन Gateway की स्वास्थ्य स्थिति तैयार नहीं हुई."}},"ar":{"stringUnit":{"state":"translated","value":"تم تثبيت التحديث، لكن حالة Gateway لم تصبح جاهزة."}},"it":{"stringUnit":{"state":"translated","value":"L'aggiornamento è installato, ma il Gateway non ha raggiunto lo stato operativo."}},"tr":{"stringUnit":{"state":"translated","value":"Güncelleme yüklendi, ancak Gateway sağlık durumu hazır hale gelmedi."}},"uk":{"stringUnit":{"state":"translated","value":"Оновлення встановлено, але Gateway не перейшов у стан готовності."}},"id":{"stringUnit":{"state":"translated","value":"Pembaruan telah diinstal, tetapi status kesehatan Gateway belum siap."}},"pl":{"stringUnit":{"state":"translated","value":"Aktualizacja została zainstalowana, ale Gateway nie osiągnął stanu gotowości."}},"th":{"stringUnit":{"state":"translated","value":"ติดตั้งการอัปเดตแล้ว แต่สถานะการทำงานของ Gateway ยังไม่พร้อมใช้งาน."}},"vi":{"stringUnit":{"state":"translated","value":"Bản cập nhật đã được cài đặt, nhưng Gateway chưa đạt trạng thái sẵn sàng."}},"nl":{"stringUnit":{"state":"translated","value":"De update is geïnstalleerd, maar de Gateway-status is niet gereed."}},"fa":{"stringUnit":{"state":"translated","value":"به‌روزرسانی نصب شده است، اما وضعیت سلامت Gateway به حالت آماده نرسید."}},"ru":{"stringUnit":{"state":"translated","value":"Обновление установлено, но проверка работоспособности Gateway не подтвердила готовность."}},"sv":{"stringUnit":{"state":"translated","value":"Uppdateringen är installerad, men Gateway blev inte redo enligt hälsokontrollen."}}}},
    "The widget image could not be captured.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The widget image could not be captured."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法捕获小组件图像。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法擷取小工具影像。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível capturar a imagem do widget."}},"de":{"stringUnit":{"state":"translated","value":"Das Widget-Bild konnte nicht aufgenommen werden."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo capturar la imagen del widget."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ウィジェットの画像をキャプチャできませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"위젯 이미지를 캡처할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’image du widget n’a pas pu être capturée."}},"hi":{"stringUnit":{"state":"translated","value":"विजेट की छवि कैप्चर नहीं की जा सकी."}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر التقاط صورة الأداة."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile acquisire l'immagine del widget."}},"tr":{"stringUnit":{"state":"translated","value":"Araç takımı görüntüsü yakalanamadı."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося зробити знімок віджета."}},"id":{"stringUnit":{"state":"translated","value":"Gambar widget tidak dapat ditangkap."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się przechwycić obrazu widżetu."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถจับภาพวิดเจ็ตได้."}},"vi":{"stringUnit":{"state":"translated","value":"Không thể chụp ảnh tiện ích."}},"nl":{"stringUnit":{"state":"translated","value":"De widgetafbeelding kon niet worden vastgelegd."}},"fa":{"stringUnit":{"state":"translated","value":"ثبت تصویر ویجت ممکن نشد."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось сделать снимок виджета."}},"sv":{"stringUnit":{"state":"translated","value":"Widgetbilden kunde inte fångas."}}}},
    "The widget image could not be copied.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The widget image could not be copied."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法复制小组件图像。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法複製小工具影像。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível copiar a imagem do widget."}},"de":{"stringUnit":{"state":"translated","value":"Das Widget-Bild konnte nicht kopiert werden."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo copiar la imagen del widget."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ウィジェットの画像をコピーできませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"위젯 이미지를 복사할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’image du widget n’a pas pu être copiée."}},"hi":{"stringUnit":{"state":"translated","value":"विजेट की छवि कॉपी नहीं की जा सकी."}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر نسخ صورة الأداة."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile copiare l'immagine del widget."}},"tr":{"stringUnit":{"state":"translated","value":"Araç takımı görüntüsü kopyalanamadı."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося скопіювати зображення віджета."}},"id":{"stringUnit":{"state":"translated","value":"Gambar widget tidak dapat disalin."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się skopiować obrazu widżetu."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถคัดลอกภาพวิดเจ็ตได้."}},"vi":{"stringUnit":{"state":"translated","value":"Không thể sao chép ảnh tiện ích."}},"nl":{"stringUnit":{"state":"translated","value":"De widgetafbeelding kon niet worden gekopieerd."}},"fa":{"stringUnit":{"state":"translated","value":"کپی کردن تصویر ویجت ممکن نشد."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось скопировать изображение виджета."}},"sv":{"stringUnit":{"state":"translated","value":"Widgetbilden kunde inte kopieras."}}}},
    "The widget image could not be encoded as PNG.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The widget image could not be encoded as PNG."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法将小组件图像编码为 PNG."}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法將小工具影像編碼為 PNG。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível codificar a imagem do widget como PNG."}},"de":{"stringUnit":{"state":"translated","value":"Das Widget-Bild konnte nicht als PNG kodiert werden."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo codificar la imagen del widget como PNG."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ウィジェットの画像をPNG形式にエンコードできませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"위젯 이미지를 PNG로 인코딩할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’image du widget n’a pas pu être encodée au format PNG."}},"hi":{"stringUnit":{"state":"translated","value":"विजेट की छवि को PNG के रूप में एन्कोड नहीं किया जा सका."}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر ترميز صورة الأداة بتنسيق PNG."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile codificare l'immagine del widget in formato PNG."}},"tr":{"stringUnit":{"state":"translated","value":"Araç takımı görüntüsü PNG olarak kodlanamadı."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося закодувати зображення віджета у форматі PNG."}},"id":{"stringUnit":{"state":"translated","value":"Gambar widget tidak dapat dikodekan sebagai PNG."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się zakodować obrazu widżetu w formacie PNG."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถเข้ารหัสภาพวิดเจ็ตเป็น PNG ได้."}},"vi":{"stringUnit":{"state":"translated","value":"Không thể mã hóa ảnh tiện ích thành PNG."}},"nl":{"stringUnit":{"state":"translated","value":"De widgetafbeelding kon niet als PNG worden gecodeerd."}},"fa":{"stringUnit":{"state":"translated","value":"کدگذاری ت