    "Authentication failed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Authentication failed"}},"zh-CN":{"stringUnit":{"state":"translated","value":"身份验证失败"}},"zh-TW":{"stringUnit":{"state":"translated","value":"驗證失敗"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Falha na autenticação"}},"de":{"stringUnit":{"state":"translated","value":"Authentifizierung fehlgeschlagen"}},"es":{"stringUnit":{"state":"translated","value":"Error de autenticación"}},"ja-JP":{"stringUnit":{"state":"translated","value":"認証に失敗しました"}},"ko":{"stringUnit":{"state":"translated","value":"인증 실패"}},"fr":{"stringUnit":{"state":"translated","value":"Échec de l’authentification"}},"hi":{"stringUnit":{"state":"translated","value":"प्रमाणीकरण विफल रहा"}},"ar":{"stringUnit":{"state":"translated","value":"فشلت المصادقة"}},"it":{"stringUnit":{"state":"translated","value":"Autenticazione non riuscita"}},"tr":{"stringUnit":{"state":"translated","value":"Kimlik doğrulama başarısız oldu"}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося пройти автентифікацію"}},"id":{"stringUnit":{"state":"translated","value":"Autentikasi gagal"}},"pl":{"stringUnit":{"state":"translated","value":"Uwierzytelnianie nie powiodło się"}},"th":{"stringUnit":{"state":"translated","value":"การยืนยันตัวตนล้มเหลว"}},"vi":{"stringUnit":{"state":"translated","value":"Xác thực không thành công"}},"nl":{"stringUnit":{"state":"translated","value":"Authenticatie mislukt"}},"fa":{"stringUnit":{"state":"translated","value":"احراز هویت ناموفق بود"}},"ru":{"stringUnit":{"state":"translated","value":"Ошибка аутентификации"}},"sv":{"stringUnit":{"state":"translated","value":"Autentisering misslyckades"}}}},
    "Authentication failed. Review the provider credential or sign-in, then retry.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Authentication failed. Review the provider credential or sign-in, then retry."}},"zh-CN":{"stringUnit":{"state":"translated","value":"身份验证失败。 请检查提供商凭据或登录状态, 然后重试。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"驗證失敗。 請檢查供應商憑證或登入狀態，然後重試。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Falha na autenticação. Verifique a credencial do provedor ou o login e tente novamente."}},"de":{"stringUnit":{"state":"translated","value":"Authentifizierung fehlgeschlagen. Prüfen Sie die Zugangsdaten oder die Anmeldung beim Anbieter und versuchen Sie es erneut."}},"es":{"stringUnit":{"state":"translated","value":"Error de autenticación. Revisa la credencial del proveedor o el inicio de sesión y vuelve a intentarlo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"認証に失敗しました。 プロバイダーの認証情報またはサインイン状態を確認してから、再試行してください。"}},"ko":{"stringUnit":{"state":"translated","value":"인증에 실패했습니다. 제공업체의 인증 정보 또는 로그인 상태를 확인한 후 다시 시도하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Échec de l’authentification. Vérifiez les identifiants du fournisseur ou la connexion, puis réessayez."}},"hi":{"stringUnit":{"state":"translated","value":"प्रमाणीकरण विफल रहा. प्रदाता के क्रेडेंशियल या साइन-इन की जाँच करें, फिर दोबारा प्रयास करें."}},"ar":{"stringUnit":{"state":"translated","value":"فشلت المصادقة. راجع بيانات اعتماد المزوّد أو تسجيل الدخول، ثم أعد المحاولة."}},"it":{"stringUnit":{"state":"translated","value":"Autenticazione non riuscita. Verifica le credenziali del provider o l'accesso, quindi riprova."}},"tr":{"stringUnit":{"state":"translated","value":"Kimlik doğrulama başarısız oldu. Sağlayıcının kimlik bilgisini veya oturum açma durumunu kontrol edip yeniden deneyin."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося пройти автентифікацію. Перевірте облікові дані постачальника або вхід в обліковий запис, а потім повторіть спробу."}},"id":{"stringUnit":{"state":"translated","value":"Autentikasi gagal. Periksa kredensial penyedia atau proses masuk, lalu coba lagi."}},"pl":{"stringUnit":{"state":"translated","value":"Uwierzytelnianie nie powiodło się. Sprawdź dane uwierzytelniające dostawcy lub sposób logowania, a następnie spróbuj ponownie."}},"th":{"stringUnit":{"state":"translated","value":"การยืนยันตัวตนล้มเหลว. ตรวจสอบข้อมูลรับรองของผู้ให้บริการหรือการลงชื่อเข้าใช้ แล้วลองอีกครั้ง."}},"vi":{"stringUnit":{"state":"translated","value":"Xác thực không thành công. Kiểm tra thông tin xác thực của nhà cung cấp hoặc trạng thái đăng nhập, rồi thử lại."}},"nl":{"stringUnit":{"state":"translated","value":"Authenticatie mislukt. Controleer de inloggegevens of aanmelding bij de provider en probeer het opnieuw."}},"fa":{"stringUnit":{"state":"translated","value":"احراز هویت ناموفق بود. اطلاعات احراز هویت یا ورود به حساب ارائه‌دهنده را بررسی کنید، سپس دوباره تلاش کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Ошибка аутентификации. Проверьте учётные данные провайдера или выполните вход, затем повторите попытку."}},"sv":{"stringUnit":{"state":"translated","value":"Autentisering misslyckades. Kontrollera leverantörens autentiseringsuppgifter eller inloggning och försök sedan igen."}}}},
