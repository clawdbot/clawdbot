    "Timezone": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Timezone"}},"zh-CN":{"stringUnit":{"state":"translated","value":"时区"}},"zh-TW":{"stringUnit":{"state":"translated","value":"時區"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Fuso horário"}},"de":{"stringUnit":{"state":"translated","value":"Zeitzone"}},"es":{"stringUnit":{"state":"translated","value":"Zona horaria"}},"ja-JP":{"stringUnit":{"state":"translated","value":"タイムゾーン"}},"ko":{"stringUnit":{"state":"translated","value":"시간대"}},"fr":{"stringUnit":{"state":"translated","value":"Fuseau horaire"}},"hi":{"stringUnit":{"state":"translated","value":"समय क्षेत्र"}},"ar":{"stringUnit":{"state":"translated","value":"المنطقة الزمنية"}},"it":{"stringUnit":{"state":"translated","value":"Fuso orario"}},"tr":{"stringUnit":{"state":"translated","value":"Saat dilimi"}},"uk":{"stringUnit":{"state":"translated","value":"Часовий пояс"}},"id":{"stringUnit":{"state":"translated","value":"Zona waktu"}},"pl":{"stringUnit":{"state":"translated","value":"Strefa czasowa"}},"th":{"stringUnit":{"state":"translated","value":"เขตเวลา"}},"vi":{"stringUnit":{"state":"translated","value":"Múi giờ"}},"nl":{"stringUnit":{"state":"translated","value":"Tijdzone"}},"fa":{"stringUnit":{"state":"translated","value":"منطقه زمانی"}},"ru":{"stringUnit":{"state":"translated","value":"Часовой пояс"}},"sv":{"stringUnit":{"state":"translated","value":"Tidszon"}}}},
    "Tip: keep Tailscale enabled so your gateway stays reachable.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Tip: keep Tailscale enabled so your gateway stays reachable."}},"zh-CN":{"stringUnit":{"state":"translated","value":"提示: 保持 Tailscale 启用，以确保你的 Gateway 始终可访问。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"提示: 保持 Tailscale 啟用，讓你的 Gateway 持續可連線。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Dica: mantenha o Tailscale ativado para que seu Gateway permaneça acessível."}},"de":{"stringUnit":{"state":"translated","value":"Tipp: Tailscale aktiviert lassen, damit Ihr Gateway erreichbar bleibt."}},"es":{"stringUnit":{"state":"translated","value":"Consejo: mantén Tailscale activado para que tu Gateway siga siendo accesible."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ヒント: Gateway に常に接続できるよう、Tailscale を有効にしておいてください。"}},"ko":{"stringUnit":{"state":"translated","value":"팁: Gateway에 계속 연결할 수 있도록 Tailscale을 활성화해 두세요."}},"fr":{"stringUnit":{"state":"translated","value":"Conseil : gardez Tailscale activé pour que votre Gateway reste accessible."}},"hi":{"stringUnit":{"state":"translated","value":"सुझाव: Tailscale सक्षम रखें ताकि आपका Gateway पहुँच योग्य बना रहे."}},"ar":{"stringUnit":{"state":"translated","value":"نصيحة: أبقِ Tailscale مفعّلًا ليظل Gateway متاحًا للوصول."}},"it":{"stringUnit":{"state":"translated","value":"Suggerimento: mantieni Tailscale abilitato affinché il tuo gateway rimanga raggiungibile."}},"tr":{"stringUnit":{"state":"translated","value":"İpucu: Gateway'inizin erişilebilir kalması için Tailscale'i etkin tutun."}},"uk":{"stringUnit":{"state":"translated","value":"Порада: тримайте Tailscale увімкненим, щоб ваш шлюз залишався доступним."}},"id":{"stringUnit":{"state":"translated","value":"Tips: tetap aktifkan Tailscale agar gateway Anda tetap dapat diakses."}},"pl":{"stringUnit":{"state":"translated","value":"Wskazówka: pozostaw Tailscale włączony, aby Gateway był zawsze dostępny."}},"th":{"stringUnit":{"state":"translated","value":"เคล็ดลับ: เปิดใช้งาน Tailscale ไว้เพื่อให้เข้าถึง Gateway ของคุณได้เสมอ."}},"vi":{"stringUnit":{"state":"translated","value":"Mẹo: luôn bật Tailscale để Gateway của bạn luôn có thể truy cập được."}},"nl":{"stringUnit":{"state":"translated","value":"Tip: houd Tailscale ingeschakeld zodat je gateway bereikbaar blijft."}},"fa":{"stringUnit":{"state":"translated","value":"نکته: Tailscale را فعال نگه دارید تا Gateway شما در دسترس بماند."}},"ru":{"stringUnit":{"state":"translated","value":"Совет: держите Tailscale включённым, чтобы ваш Gateway оставался доступным."}},"sv":{"stringUnit":{"state":"translated","value":"Tips: håll Tailscale aktiverat så att din gateway förblir nåbar."}}}},
    "Tip: the session directory is returned by “Show panel”.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Tip: the session directory is returned by “Show panel”."}},"zh-CN":{"stringUnit":{"state":"translated","value":"提示: 会话目录由“显示面板”返回。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"提示: “顯示面板”會傳回工作階段目錄。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Dica: o diretório da sessão é retornado por “Mostrar painel”."}},"de":{"stringUnit":{"state":"translated","value":"Tipp: Das Sitzungsverzeichnis wird von „Panel anzeigen“ zurückgegeben."}},"es":{"stringUnit":{"state":"translated","value":"Consejo: “Mostrar panel” devuelve el directorio de la sesión."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ヒント: セッションディレクトリは “パネルを表示” で返されます。"}},"ko":{"stringUnit":{"state":"translated","value":"팁: 세션 디렉터리는 “패널 표시”를 통해 확인할 수 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Conseil : le répertoire de session est renvoyé par “Afficher le panneau”."}},"hi":{"stringUnit":{"state":"translated","value":"सुझाव: “पैनल दिखाएँ” से सत्र डायरेक्टरी मिलती है."}},"ar":{"stringUnit":{"state":"translated","value":"نصيحة: يعرض خيار “إظهار اللوحة” مسار مجلد الجلسة."}},"it":{"stringUnit":{"state":"translated","value":"Suggerimento: la directory della sessione viene restituita da “Mostra pannello”."}},"tr":{"stringUnit":{"state":"translated","value":"İpucu: oturum dizini “Paneli göster” ile döndürülür."}},"uk":{"stringUnit":{"state":"translated","value":"Порада: каталог сеансу повертається командою “Показати панель”."}},"id":{"stringUnit":{"state":"translated","value":"Tips: direktori sesi dikembalikan oleh “Tampilkan panel”."}},"pl":{"stringUnit":{"state":"translated","value":"Wskazówka: katalog sesji jest zwracany przez „Pokaż panel”."}},"th":{"stringUnit":{"state":"translated","value":"เคล็ดลับ: “แสดงแผง” จะส่งคืนไดเรกทอรีของเซสชัน."}},"vi":{"stringUnit":{"state":"translated","value":"Mẹo: thư mục phiên được trả về bởi “Hiển thị bảng điều khiển”."}},"nl":{"stringUnit":{"state":"translated","value":"Tip: de sessiemap wordt getoond via “Paneel tonen”."}},"fa":{"stringUnit":{"state":"translated","value":"نکته: مسیر پوشه نشست با «نمایش پنل» برگردانده می‌شود."}},"ru":{"stringUnit":{"state":"translated","value":"Совет: каталог сеанса можно узнать с помощью “Показать панель”."}},"sv":{"stringUnit":{"state":"translated","value":"Tips: sessionskatalogen returneras av “Visa panel”."}}}},
    "Tip: try “status”, “doctor”, “set default model …”, or “connect telegram”.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Tip: try “status”, “doctor”, “set default model …”, or “connect telegram”."}},"zh-CN":{"stringUnit":{"state":"translated","value":"提示: 试试“status”、“doctor”、“set default model …”或“connect telegram”。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"提示: 試試“status”、“doctor”、“set default model …”或“connect telegram”."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Dica: experimente “status”, “doctor”, “set default model …” ou “connect telegram”."}},"de":{"stringUnit":{"state":"translated","value":"Tipp: Probieren Sie „status“, „doctor“, „set default model …“ oder „connect telegram“."}},"es":{"stringUnit":{"state":"translated","value":"Consejo: prueba “status”, “doctor”, “set default model …” o “connect telegram”."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ヒント: “status”、 “doctor”、 “set default model …”、または “connect telegram” を試してください。"}},"ko":{"stringUnit":{"state":"translated","value":"팁: “status”, “doctor”, “set default model …” 또는 “connect telegram”을 사용해 보세요."}},"fr":{"stringUnit":{"state":"translated","value":"Conseil : essayez “status”, “doctor”, “set default model …”, ou “connect telegram”."}},"hi":{"stringUnit":{"state":"translated","value":"सुझाव: “status”, “doctor”, “set default model …”, या “connect telegram” आज़माएँ."}},"ar":{"stringUnit":{"state":"translated","value":"نصيحة: جرّب “status”، أو “doctor”، أو “set default model …”، أو “connect telegram”."}},"it":{"stringUnit":{"state":"translated","value":"Suggerimento: prova “status”, “doctor”, “set default model …” o “connect telegram”."}},"tr":{"stringUnit":{"state":"translated","value":"İpucu: “status”, “doctor”, “set default model …” veya “connect telegram” komutlarını deneyin."}},"uk":{"stringUnit":{"state":"translated","value":"Порада: спробуйте “status”, “doctor”, “set default model …” або “connect telegram”."}},"id":{"stringUnit":{"state":"translated","value":"Tips: coba “status”, “doctor”, “set default model …”, atau “connect telegram”."}},"pl":{"stringUnit":{"state":"translated","value":"Wskazówka: wypróbuj “status”, “doctor”, “set default model …” lub “connect telegram”."}},"th":{"stringUnit":{"state":"translated","value":"เคล็ดลับ: ลองใช้ “status”, “doctor”, “set default model …”, หรือ “connect telegram”."}},"vi":{"stringUnit":{"state":"translated","value":"Mẹo: thử “status”, “doctor”, “set default model …”, hoặc “connect telegram”."}},"nl":{"stringUnit":{"state":"translated","value":"Tip: probeer “status”, “doctor”, “set default model …” of “connect telegram”."}},"fa":{"stringUnit":{"state":"translated","value":"نکته: “status”، “doctor”، “set default model …”، یا “connect telegram” را امتحان کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Совет: попробуйте “status”, “doctor”, “set default model …” или “connect telegram”."}},"sv":{"stringUnit":{"state":"translated","value":"Tips: prova “status”, “doctor”, “set default model …” eller “connect telegram”."}}}},
    "Tip: use Tailscale Serve so the gateway has a valid HTTPS cert.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Tip: use Tailscale Serve so the gateway has a valid HTTPS cert."}},"zh-CN":{"stringUnit":{"state":"translated","value":"提示: 使用 Tailscale Serve，让 Gateway 拥有有效的 HTTPS 证书。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"提示: 使用 Tailscale Serve，讓 Gateway 具備有效的 HTTPS 憑證。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Dica: use o Tailscale Serve para que o Gateway tenha um certificado HTTPS válido."}},"de":{"stringUnit":{"state":"translated","value":"Tipp: Verwenden Sie Tailscale Serve, damit das Gateway ein gültiges HTTPS-Zertifikat hat."}},"es":{"stringUnit":{"state":"translated","value":"Consejo: usa Tailscale Serve para que el Gateway tenga un certificado HTTPS válido."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ヒント: Gateway に有効な HTTPS 証明書を設定するには、Tailscale Serve を使用してください。"}},"ko":{"stringUnit":{"state":"translated","value":"팁: Gateway에 유효한 HTTPS 인증서를 적용하려면 Tailscale Serve를 사용하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Conseil : utilisez Tailscale Serve pour que le Gateway dispose d’un certificat HTTPS valide."}},"hi":{"stringUnit":{"state":"translated","value":"सुझाव: Tailscale Serve का उपयोग करें ताकि Gateway के पास मान्य HTTPS प्रमाणपत्र हो."}},"ar":{"stringUnit":{"state":"translated","value":"نصيحة: استخدم Tailscale Serve ليحصل Gateway على شهادة HTTPS صالحة."}},"it":{"stringUnit":{"state":"translated","value":"Suggerimento: usa Tailscale Serve affinché il gateway disponga di un certificato HTTPS valido."}},"tr":{"stringUnit":{"state":"translated","value":"İpucu: Gateway'in geçerli bir HTTPS sertifikasına sahip olması için Tailscale Serve kullanın."}},"uk":{"stringUnit":{"state":"translated","value":"Порада: використовуйте Tailscale Serve, щоб шлюз мав дійсний сертифікат HTTPS."}},"id":{"stringUnit":{"state":"translated","value":"Tips: gunakan Tailscale Serve agar gateway memiliki sertifikat HTTPS yang valid."}},"pl":{"stringUnit":{"state":"translated","value":"Wskazówka: użyj Tailscale Serve, aby Gateway miał prawidłowy certyfikat HTTPS."}},"th":{"stringUnit":{"state":"translated","value":"เคล็ดลับ: ใช้ Tailscale Serve เพื่อให้ Gateway มีใบรับรอง HTTPS ที่ถูกต้อง."}},"vi":{"stringUnit":{"state":"translated","value":"Mẹo: dùng Tailscale Serve để Gateway có chứng chỉ HTTPS hợp lệ."}},"nl":{"stringUnit":{"state":"translated","value":"Tip: gebruik Tailscale Serve zodat de gateway een geldig HTTPS-certificaat heeft."}},"fa":{"stringUnit":{"state":"translated","value":"نکته: از Tailscale Serve استفاده کنید تا Gateway گواهی معتبر HTTPS داشته باشد."}},"ru":{"stringUnit":{"state":"translated","value":"Совет: используйте Tailscale Serve, чтобы у Gateway был действительный сертификат HTTPS."}},"sv":{"stringUnit":{"state":"translated","value":"Tips: använd Tailscale Serve så att din gateway har ett giltigt HTTPS-certifikat."}}}},
    "Tip: use ‘New Job’ to add one, or enable cron in your gateway config.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Tip: use ‘New Job’ to add one, or enable cron in your gateway config."}},"zh-CN":{"stringUnit":{"state":"translated","value":"提示: 使用‘新建任务’添加任务，或在 Gateway 配置中启用 cron。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"提示: 使用‘新增工作’來新增工作，或在 Gateway 設定中啟用 cron."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Dica: use ‘Nova tarefa’ para adicionar uma ou ative o cron na configuração do Gateway."}},"de":{"stringUnit":{"state":"translated","value":"Tipp: Verwenden Sie ‚Neuer Auftrag‘, um einen hinzuzufügen, oder aktivieren Sie cron in Ihrer Gateway-Konfiguration."}},"es":{"stringUnit":{"state":"translated","value":"Consejo: usa ‘Nueva tarea’ para añadir una, o activa cron en la configuración de tu Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ヒント: ‘新しいジョブ’ で追加するか、Gateway の設定で cron を有効にしてください。"}},"ko":{"stringUnit":{"state":"translated","value":"팁: ‘새 작업’으로 작업을 추가하거나 Gateway 설정에서 cron을 활성화하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Conseil : utilisez ‘Nouvelle tâche’ pour en ajouter une, ou activez cron dans la configuration de votre Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"सुझाव: नया कार्य जोड़ने के लिए ‘नया कार्य’ का उपयोग करें, या अपने Gateway कॉन्फ़िगरेशन में cron सक्षम करें."}},"ar":{"stringUnit":{"state":"translated","value":"نصيحة: استخدم ‘مهمة جديدة’ لإضافة مهمة، أو فعّل cron في إعدادات Gateway."}},"it":{"stringUnit":{"state":"translated","value":"Suggerimento: usa ‘Nuova attività’ per aggiungerne una, oppure abilita cron nella configurazione del gateway."}},"tr":{"stringUnit":{"state":"translated","value":"İpucu: bir iş eklemek için ‘Yeni İş’ seçeneğini kullanın veya Gateway yapılandırmanızda cron'u etkinleştirin."}},"uk":{"stringUnit":{"state":"translated","value":"Порада: скористайтеся ‘Нове завдання’, щоб додати завдання, або увімкніть cron у конфігурації шлюзу."}},"id":{"stringUnit":{"state":"translated","value":"Tips: gunakan ‘Tugas Baru’ untuk menambahkan tugas, atau aktifkan cron dalam konfigurasi gateway Anda."}},"pl":{"stringUnit":{"state":"translated","value":"Wskazówka: użyj ‘Nowe zadanie’, aby dodać zadanie, lub włącz cron w konfiguracji Gateway."}},"th":{"stringUnit":{"state":"translated","value":"เคล็ดลับ: ใช้ ‘งานใหม่’ เพื่อเพิ่มงาน หรือเปิดใช้งาน cron ในการกำหนดค่า Gateway ของคุณ."}},"vi":{"stringUnit":{"state":"translated","value":"Mẹo: dùng ‘Tác vụ mới’ để thêm tác vụ, hoặc bật cron trong cấu hình Gateway của bạn."}},"nl":{"stringUnit":{"state":"translated","value":"Tip: gebruik ‘Nieuwe taak’ om er een toe te voegen, of schakel cron in je gatewayconfiguratie in."}},"fa":{"stringUnit":{"state":"translated","value":"نکته: برای افزودن یک کار، از ‘کار جدید’ استفاده کنید، یا cron را در پیکربندی Gateway خود فعال کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Совет: используйте ‘Новое задание’, чтобы добавить задание, или включите cron в конфигурации Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Tips: använd ‘Nytt jobb’ för att lägga till ett, eller aktivera cron i din gateway-konfiguration."}}}},
