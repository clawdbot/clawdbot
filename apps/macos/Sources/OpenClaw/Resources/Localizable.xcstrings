    "Use Apple Speech; passive Voice Wake stays on-device": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use Apple Speech; passive Voice Wake stays on-device"}},"zh-CN":{"stringUnit":{"state":"translated","value":"使用 Apple Speech；被动语音唤醒保持在设备本地"}},"zh-TW":{"stringUnit":{"state":"translated","value":"使用 Apple Speech；被動語音喚醒保持在裝置端"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Usar Apple Speech; o Voice Wake passivo permanece no dispositivo"}},"de":{"stringUnit":{"state":"translated","value":"Apple Speech verwenden; passives Voice Wake bleibt auf dem Gerät"}},"es":{"stringUnit":{"state":"translated","value":"Usa Apple Speech; el Voice Wake pasivo permanece en el dispositivo"}},"ja-JP":{"stringUnit":{"state":"translated","value":"Apple Speechを使用します。パッシブなVoice Wakeはデバイス上で処理されます"}},"ko":{"stringUnit":{"state":"translated","value":"Apple Speech를 사용합니다. 수동 음성 깨우기는 기기에서 유지됩니다"}},"fr":{"stringUnit":{"state":"translated","value":"Utiliser Apple Speech ; Voice Wake passif reste sur l'appareil"}},"hi":{"stringUnit":{"state":"translated","value":"Apple Speech का उपयोग करें; निष्क्रिय Voice Wake ऑन-डिवाइस रहता है"}},"ar":{"stringUnit":{"state":"translated","value":"استخدم Apple Speech؛ يبقى التنبيه الصوتي السلبي على الجهاز"}},"it":{"stringUnit":{"state":"translated","value":"Usa Apple Speech; Voice Wake passivo resta sul dispositivo"}},"tr":{"stringUnit":{"state":"translated","value":"Apple Speech'i kullan; pasif Voice Wake cihazda kalır"}},"uk":{"stringUnit":{"state":"translated","value":"Використовувати Apple Speech; пасивний Voice Wake залишається на пристрої"}},"id":{"stringUnit":{"state":"translated","value":"Gunakan Apple Speech; Voice Wake pasif tetap di perangkat"}},"pl":{"stringUnit":{"state":"translated","value":"Używaj Apple Speech; pasywne Wybudzanie głosem pozostaje na urządzeniu"}},"th":{"stringUnit":{"state":"translated","value":"ใช้ Apple Speech; Voice Wake แบบพาสซีฟจะทำงานบนอุปกรณ์"}},"vi":{"stringUnit":{"state":"translated","value":