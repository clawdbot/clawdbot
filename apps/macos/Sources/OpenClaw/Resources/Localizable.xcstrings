    "Skip Gateway setup for now; pick Local or Remote later in Settings → General.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Skip Gateway setup for now; pick Local or Remote later in Settings → General."}},"zh-CN":{"stringUnit":{"state":"translated","value":"暂时跳过 Gateway 设置; 稍后可在设置 → 通用中选择本地或远程。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"暫時略過 Gateway 設定; 稍後可在設定 → 一般中選擇本機或遠端。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Pule a configuração do Gateway por enquanto; escolha Local ou Remoto depois em Ajustes → Geral."}},"de":{"stringUnit":{"state":"translated","value":"Gateway-Einrichtung vorerst überspringen; später unter Einstellungen → Allgemein zwischen Lokal und Remote wählen."}},"es":{"stringUnit":{"state":"translated","value":"Omite la configuración del Gateway por ahora; elige Local o Remoto más adelante en Ajustes → General."}},"ja-JP":{"stringUnit":{"state":"translated","value":"今はGatewayの設定をスキップします; 後で設定 → 一般からローカルまたはリモートを選択してください。"}},"ko":{"stringUnit":{"state":"translated","value":"지금은 Gateway 설정을 건너뛰세요; 나중에 설정 → 일반에서 로컬 또는 원격을 선택하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Ignorez la configuration du Gateway pour le moment ; choisissez Local ou Distant plus tard dans Réglages → Général."}},"hi":{"stringUnit":{"state":"translated","value":"अभी Gateway सेटअप छोड़ें; बाद में सेटिंग्स → सामान्य में स्थानीय या रिमोट चुनें."}},"ar":{"stringUnit":{"state":"translated","value":"تخطَّ إعداد Gateway حاليًا; اختر محلي أو بعيد لاحقًا في الإعدادات → عام."}},"it":{"stringUnit":{"state":"translated","value":"Salta la configurazione del Gateway per ora; scegli Locale o Remoto in seguito in Impostazioni → Generali."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway kurulumunu şimdilik atlayın; daha sonra Ayarlar → Genel bölümünden Yerel veya Uzak seçeneğini belirleyin."}},"uk":{"stringUnit":{"state":"translated","value":"Поки пропустіть налаштування Gateway; виберіть локальний або віддалений режим пізніше в Налаштування → Загальні."}},"id":{"stringUnit":{"state":"translated","value":"Lewati penyiapan Gateway untuk saat ini; pilih Lokal atau Jarak Jauh nanti di Pengaturan → Umum."}},"pl":{"stringUnit":{"state":"translated","value":"Pomiń na razie konfigurację Gateway; wybierz tryb lokalny lub zdalny później w Ustawienia → Ogólne."}},"th":{"stringUnit":{"state":"translated","value":"ข้ามการตั้งค่า Gateway ไปก่อน; เลือกภายในเครื่องหรือระยะไกลภายหลังได้ใน การตั้งค่า → ทั่วไป."}},"vi":{"stringUnit":{"state":"translated","value":"Tạm bỏ qua thiết lập Gateway; chọn Cục bộ hoặc Từ xa sau trong Cài đặt → Chung."}},"nl":{"stringUnit":{"state":"translated","value":"Sla de Gateway-configuratie voorlopig over; kies later Lokaal of Extern in Instellingen → Algemeen."}},"fa":{"stringUnit":{"state":"translated","value":"فعلاً از راه‌اندازی Gateway صرف‌نظر کنید؛ بعداً در تنظیمات → عمومی، محلی یا راه دور را انتخاب کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Пока пропустить настройку Gateway; позже выберите локальный или удалённый режим в разделе Настройки → Основные."}},"sv":{"stringUnit":{"state":"translated","value":"Hoppa över Gateway-konfigurationen tills vidare; välj Lokal eller Fjärransluten senare i Inställningar → Allmänt."}}}},
