    "Install on This Mac": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Install on This Mac"}},"zh-CN":{"stringUnit":{"state":"translated","value":"安装到此 Mac"}},"zh-TW":{"stringUnit":{"state":"translated","value":"安裝到這台 Mac"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Instalar neste Mac"}},"de":{"stringUnit":{"state":"translated","value":"Auf diesem Mac installieren"}},"es":{"stringUnit":{"state":"translated","value":"Instalar en esta Mac"}},"ja-JP":{"stringUnit":{"state":"translated","value":"この Mac にインストール"}},"ko":{"stringUnit":{"state":"translated","value":"이 Mac에 설치"}},"fr":{"stringUnit":{"state":"translated","value":"Installer sur ce Mac"}},"hi":{"stringUnit":{"state":"translated","value":"इस Mac पर इंस्टॉल करें"}},"ar":{"stringUnit":{"state":"translated","value":"التثبيت على هذا الـ Mac"}},"it":{"stringUnit":{"state":"translated","value":"Installa su questo Mac"}},"tr":{"stringUnit":{"state":"translated","value":"Bu Mac'e yükle"}},"uk":{"stringUnit":{"state":"translated","value":"Установити на цей Mac"}},"id":{"stringUnit":{"state":"translated","value":"Instal di Mac Ini"}},"pl":{"stringUnit":{"state":"translated","value":"Zainstaluj na tym Macu"}},"th":{"stringUnit":{"state":"translated","value":"ติดตั้งบน Mac เครื่องนี้"}},"vi":{"stringUnit":{"state":"translated","value":"Cài đặt trên máy Mac này"}},"nl":{"stringUnit":{"state":"translated","value":"Installeren op deze Mac"}},"fa":{"stringUnit":{"state":"translated","value":"نصب روی این Mac"}},"ru":{"stringUnit":{"state":"translated","value":"Установить на этот Mac"}},"sv":{"stringUnit":{"state":"translated","value":"Installera på denna Mac"}}}},
    "Install one of these tools, then check again. You can also connect a provider below.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Install one of these tools, then check again. You can also connect a provider below."}},"zh-CN":{"stringUnit":{"state":"translated","value":"安装以下任一工具，然后再次检查。你也可以连接下方的提供商。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"安裝其中一項工具，然後再次檢查。您也可以連接下方的供應商。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Instale uma destas ferramentas e verifique novamente. Você também pode conectar um provedor abaixo."}},"de":{"stringUnit":{"state":"translated","value":"Installiere eines dieser Tools und prüfe dann erneut. Du kannst unten auch einen Anbieter verbinden."}},"es":{"stringUnit":{"state":"translated","value":"Instala una de estas herramientas y, luego, vuelve a comprobarlo. También puedes conectar un proveedor a continuación."}},"ja-JP":{"stringUnit":{"state":"translated","value":"これらのツールのいずれかをインストールしてから、もう一度確認してください。以下のプロバイダーに接続することもできます。"}},"ko":{"stringUnit":{"state":"translated","value":"다음 도구 중 하나를 설치한 다음 다시 확인하세요. 아래 제공업체를 연결할 수도 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Installez l’un de ces outils, puis vérifiez à nouveau. Vous pouvez également connecter un fournisseur ci-dessous."}},"hi":{"stringUnit":{"state":"translated","value":"इनमें से कोई एक टूल इंस्टॉल करें, फिर दोबारा जाँचें। आप नीचे किसी प्रदाता को भी कनेक्ट कर सकते हैं।"}},"ar":{"stringUnit":{"state":"translated","value":"ثبّت إحدى هذه الأدوات، ثم تحقّق مرة أخرى. يمكنك أيضًا ربط أحد المزوّدين أدناه."}},"it":{"stringUnit":{"state":"translated","value":"Installa uno di questi strumenti, quindi verifica di nuovo. Puoi anche connettere uno dei provider qui sotto."}},"tr":{"stringUnit":{"state":"translated","value":"Bu araçlardan birini yükleyin, ardından tekrar kontrol edin. Ayrıca aşağıdaki sağlayıcılardan birine bağlanabilirsiniz."}},"uk":{"stringUnit":{"state":"translated","value":"Установіть один із цих інструментів, а потім перевірте ще раз. Також нижче можна підключити постачальника."}},"id":{"stringUnit":{"state":"translated","value":"Instal salah satu alat ini, lalu periksa kembali. Anda juga dapat menghubungkan penyedia di bawah ini."}},"pl":{"stringUnit":{"state":"translated","value":"Zainstaluj jedno z tych narzędzi, a następnie sprawdź ponownie. Możesz też połączyć dostawcę poniżej."}},"th":{"stringUnit":{"state":"translated","value":"ติดตั้งหนึ่งในเครื่องมือเหล่านี้ แล้วตรวจสอบอีกครั้ง นอกจากนี้ คุณยังสามารถเชื่อมต่อผู้ให้บริการด้านล่างได้"}},"vi":{"stringUnit":{"state":"translated","value":"Cài đặt một trong các công cụ này, sau đó kiểm tra lại. Bạn cũng có thể kết nối với một nhà cung cấp bên dưới."}},"nl":{"stringUnit":{"state":"translated","value":"Installeer een van deze tools en controleer het daarna opnieuw. Je kunt hieronder ook een provider koppelen."}},"fa":{"stringUnit":{"state":"translated","value":"یکی از این ابزارها را نصب کنید، سپس دوباره بررسی کنید. همچنین می‌توانید یکی از ارائه‌دهندگان زیر را متصل کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Установите один из этих инструментов, затем повторите проверку. Также можно подключить провайдера ниже."}},"sv":{"stringUnit":{"state":"translated","value":"Installera ett av dessa verktyg och kontrollera sedan igen. Du kan också ansluta en leverantör nedan."}}}},
    "Installed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Installed"}},"zh-CN":{"stringUnit":{"state":"translated","value":"已安装"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已安裝"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Instalada"}},"de":{"stringUnit":{"state":"translated","value":"Installiert"}},"es":{"stringUnit":{"state":"translated","value":"Instalada"}},"ja-JP":{"stringUnit":{"state":"translated","value":"インストール済み"}},"ko":{"stringUnit":{"state":"translated","value":"설치됨"}},"fr":{"stringUnit":{"state":"translated","value":"Installé"}},"hi":{"stringUnit":{"state":"translated","value":"इंस्टॉल किए गए"}},"ar":{"stringUnit":{"state":"translated","value":"المثبتة"}},"it":{"stringUnit":{"state":"translated","value":"Installata"}},"tr":{"stringUnit":{"state":"translated","value":"Yüklendi"}},"uk":{"stringUnit":{"state":"translated","value":"Встановлено"}},"id":{"stringUnit":{"state":"translated","value":"Terinstal"}},"pl":{"stringUnit":{"state":"translated","value":"Zainstalowane"}},"th":{"stringUnit":{"state":"translated","value":"ติดตั้งแล้ว"}},"vi":{"stringUnit":{"state":"translated","value":"Đã cài đặt"}},"nl":{"stringUnit":{"state":"translated","value":"Geïnstalleerd"}},"fa":{"stringUnit":{"state":"translated","value":"نصب‌شده"}},"ru":{"stringUnit":{"state":"translated","value":"Установлено"}},"sv":{"stringUnit":{"state":"translated","value":"Installerad"}}}},
    "Instances": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Instances"}},"zh-CN":{"stringUnit":{"state":"translated","value":"实例"}},"zh-TW":{"stringUnit":{"state":"translated","value":"執行個體"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Instâncias"}},"de":{"stringUnit":{"state":"translated","value":"Instanzen"}},"es":{"stringUnit":{"state":"translated","value":"Instancias"}},"ja-JP":{"stringUnit":{"state":"translated","value":"インスタンス"}},"ko":{"stringUnit":{"state":"translated","value":"인스턴스"}},"fr":{"stringUnit":{"state":"new","value":"Instances"}},"hi":{"stringUnit":{"state":"translated","value":"इंस्टेंस"}},"ar":{"stringUnit":{"state":"translated","value":"المثيلات"}},"it":{"stringUnit":{"state":"translated","value":"Istanze"}},"tr":{"stringUnit":{"state":"translated","value":"Örnekler"}},"uk":{"stringUnit":{"state":"translated","value":"Екземпляри"}},"id":{"stringUnit":{"state":"translated","value":"Instans"}},"pl":{"stringUnit":{"state":"translated","value":"Instancje"}},"th":{"stringUnit":{"state":"translated","value":"อินสแตนซ์"}},"vi":{"stringUnit":{"state":"translated","value":"Phiên bản"}},"nl":{"stringUnit":{"state":"translated","value":"Instanties"}},"fa":{"stringUnit":{"state":"translated","value":"نمونه‌ها"}},"ru":{"stringUnit":{"state":"translated","value":"Экземпляры"}},"sv":{"stringUnit":{"state":"translated","value":"Instanser"}}}},
    "It answers questions, works with your files and apps, and can chat with you on WhatsApp or Telegram. Setup takes about two minutes.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"It answers questions, works with your files and apps, and can chat with you on WhatsApp or Telegram. Setup takes about two minutes."}},"zh-CN":{"stringUnit":{"state":"translated","value":"它可以回答问题、处理你的文件和 app，还能在 WhatsApp 或 Telegram 上与你聊天。设置大约需要两分钟。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"它能回答問題、處理你的檔案和 App，並可透過 WhatsApp 或 Telegram 與你聊天。設定大約只需兩分鐘。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ele responde a perguntas, trabalha com seus arquivos e apps e pode conversar com você no WhatsApp ou Telegram. A configuração leva cerca de dois minutos."}},"de":{"stringUnit":{"state":"translated","value":"Er beantwortet Fragen, arbeitet mit Ihren Dateien und Apps und kann mit Ihnen über WhatsApp oder Telegram chatten. Die Einrichtung dauert etwa zwei Minuten."}},"es":{"stringUnit":{"state":"translated","value":"Responde preguntas, trabaja con tus archivos y apps, y puede chatear contigo en WhatsApp o Telegram. La configuración tarda unos dos minutos."}},"ja-JP":{"stringUnit":{"state":"translated","value":"質問に答え、ファイルやアプリを扱い、WhatsApp や Telegram であなたとチャットできます。セットアップは約 2 分で完了します。"}},"ko":{"stringUnit":{"state":"translated","value":"질문에 답하고, 파일과 앱을 다루며, WhatsApp 또는 Telegram에서 대화할 수 있습니다. 설정은 약 2분 정도 걸립니다."}},"fr":{"stringUnit":{"state":"translated","value":"Il répond aux questions, travaille avec vos fichiers et apps, et peut discuter avec vous sur WhatsApp ou Telegram. La configuration prend environ deux minutes."}},"hi":{"stringUnit":{"state":"translated","value":"यह सवालों के जवाब देता है, आपकी फ़ाइलों और ऐप्स के साथ काम करता है, और WhatsApp या Telegram पर आपसे चैट कर सकता है। सेटअप में लगभग दो मिनट लगते हैं।"}},"ar":{"stringUnit":{"state":"translated","value":"يجيب عن الأسئلة، ويعمل مع ملفاتك وتطبيقاتك، ويمكنه الدردشة معك على WhatsApp أو Telegram. يستغرق الإعداد حوالي دقيقتين."}},"it":{"stringUnit":{"state":"translated","value":"Risponde alle domande, lavora con i tuoi file e le tue app e può chattare con te su WhatsApp o Telegram. La configurazione richiede circa due minuti."}},"tr":{"stringUnit":{"state":"translated","value":"Soruları yanıtlar, dosyalarınız ve uygulamalarınızla çalışır ve WhatsApp veya Telegram üzerinden sizinle sohbet edebilir. Kurulum yaklaşık iki dakika sürer."}},"uk":{"stringUnit":{"state":"translated","value":"Він відповідає на запитання, працює з вашими файлами й застосунками та може спілкуватися з вами у WhatsApp або Telegram. Налаштування займає близько двох хвилин."}},"id":{"stringUnit":{"state":"translated","value":"Asisten ini menjawab pertanyaan, bekerja dengan file dan aplikasi Anda, dan dapat mengobrol dengan Anda di WhatsApp atau Telegram. Penyiapan memerlukan sekitar dua menit."}},"pl":{"stringUnit":{"state":"translated","value":"Odpowiada na pytania, pracuje z Twoimi plikami i aplikacjami oraz może rozmawiać z Tobą na WhatsApp lub Telegram. Konfiguracja zajmuje około dwóch minut."}},"th":{"stringUnit":{"state":"translated","value":"ตอบคำถาม ทำงานกับไฟล์และแอปของคุณ และแชทกับคุณบน WhatsApp หรือ Telegram ได้ การตั้งค่าใช้เวลาประมาณสองนาที"}},"vi":{"stringUnit":{"state":"translated","value":"Trợ lý trả lời câu hỏi, làm việc với tệp và ứng dụng của bạn, đồng thời có thể trò chuyện với bạn trên WhatsApp hoặc Telegram. Quá trình thiết lập mất khoảng hai phút."}},"nl":{"stringUnit":{"state":"translated","value":"Hij beantwoordt vragen, werkt met je bestanden en apps en kan met je chatten op WhatsApp of Telegram. De installatie duurt ongeveer twee minuten."}},"fa":{"stringUnit":{"state":"translated","value":"به پرسش‌ها پاسخ می‌دهد، با فایل‌ها و برنامه‌های شما کار می‌کند، و می‌تواند در WhatsApp یا Telegram با شما چت کند. راه‌اندازی حدود دو دقیقه طول می‌کشد."}},"ru":{"stringUnit":{"state":"translated","value":"Он отвечает на вопросы, работает с вашими файлами и приложениями и может общаться с вами в WhatsApp или Telegram. Настройка занимает около двух минут."}},"sv":{"stringUnit":{"state":"translated","value":"Den svarar på frågor, arbetar med dina filer och appar och kan chatta med dig på WhatsApp eller Telegram. Konfigurationen tar ungefär två minuter."}}}},
    "Item": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Item"}},"zh-CN":{"stringUnit":{"state":"translated","value":"项目"}},"zh-TW":{"stringUnit":{"state":"translated","value":"項目"}},"pt-BR":{"stringUnit":{"state":"new","value":"Item"}},"de":{"stringUnit":{"state":"translated","value":"Element"}},"es":{"stringUnit":{"state":"translated","value":"Elemento"}},"ja-JP":{"stringUnit":{"state":"translated","value":"項目"}},"ko":{"stringUnit":{"state":"translated","value":"항목"}},"fr":{"stringUnit":{"state":"translated","value":"Élément"}},"hi":{"stringUnit":{"state":"translated","value":"आइटम"}},"ar":{"stringUnit":{"state":"translated","value":"عنصر"}},"it":{"stringUnit":{"state":"translated","value":"Elemento"}},"tr":{"stringUnit":{"state":"translated","value":"Öğe"}},"uk":{"stringUnit":{"state":"translated","value":"Елемент"}},"id":{"stringUnit":{"state":"new","value":"Item"}},"pl":{"stringUnit":{"state":"translated","value":"Element"}},"th":{"stringUnit":{"state":"translated","value":"รายการ"}},"vi":{"stringUnit":{"state":"translated","value":"Mục"}},"nl":{"stringUnit":{"state":"new","value":"Item"}},"fa":{"stringUnit":{"state":"translated","value":"مورد"}},"ru":{"stringUnit":{"state":"translated","value":"Элемент"}},"sv":{"stringUnit":{"state":"translated","value":"Objekt"}}}},
    "Jobs are saved, but they will not run automatically until `cron.enabled` is set to `true` and the Gateway restarts.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Jobs are saved, but they will not run automatically until `cron.enabled` is set to `true` and the Gateway restarts."}},"zh-CN":{"stringUnit":{"state":"translated","value":"任务已保存，但在 `cron.enabled` 设置为 `true` 且 Gateway 重启之前，它们不会自动运行。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Jobs 已儲存，但在 `cron.enabled` 設為 `true` 且 Gateway 重新啟動之前，不會自動執行。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Os trabalhos estão salvos, mas não serão executados automaticamente até que `cron.enabled` seja definido como `true` e o Gateway seja reiniciado."}},"de":{"stringUnit":{"state":"translated","value":"Jobs werden gespeichert, aber sie werden nicht automatisch ausgeführt, bis `cron.enabled` auf `true` gesetzt wurde und die Gateway neu gestartet wird."}},"es":{"stringUnit":{"state":"translated","value":"Las tareas están guardadas, pero no se ejecutarán automáticamente hasta que `cron.enabled` se establezca en `true` y se reinicie el Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ジョブは保存されていますが、`cron.enabled` が `true` に設定され、Gateway が再起動されるまで自動的には実行されません。"}},"ko":{"stringUnit":{"state":"translated","value":"작업은 저장되었지만 `cron.enabled`가 `true`로 설정되고 Gateway가 다시 시작될 때까지 자동으로 실행되지 않습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les tâches sont enregistrées, mais elles ne s’exécuteront pas automatiquement tant que `cron.enabled` ne sera pas défini sur `true` et que le Gateway n’aura pas redémarré."}},"hi":{"stringUnit":{"state":"translated","value":"Jobs सहेजे गए हैं, लेकिन वे तब तक अपने आप नहीं चलेंगे जब तक `cron.enabled` को `true` पर सेट नहीं किया जाता और Gateway रीस्टार्ट नहीं होता।"}},"ar":{"stringUnit":{"state":"translated","value":"تم حفظ المهام، لكنها لن تعمل تلقائيًا حتى يتم تعيين `cron.enabled` إلى `true` وإعادة تشغيل Gateway."}},"it":{"stringUnit":{"state":"translated","value":"I job sono salvati, ma non verranno eseguiti automaticamente finché `cron.enabled` non viene impostato su `true` e il Gateway non viene riavviato."}},"tr":{"stringUnit":{"state":"translated","value":"İşler kaydedildi, ancak `cron.enabled` `true` olarak ayarlanana ve Gateway yeniden başlatılana kadar otomatik olarak çalışmayacak."}},"uk":{"stringUnit":{"state":"translated","value":"Завдання збережено, але вони не запускатимуться автоматично, доки `cron.enabled` не буде встановлено на `true` і Gateway не перезапуститься."}},"id":{"stringUnit":{"state":"translated","value":"Job disimpan, tetapi tidak akan berjalan otomatis hingga `cron.enabled` diatur ke `true` dan Gateway dimulai ulang."}},"pl":{"stringUnit":{"state":"translated","value":"Zadania są zapisane, ale nie będą uruchamiane automatycznie, dopóki `cron.enabled` nie zostanie ustawione na `true` i Gateway nie zostanie ponownie uruchomiony."}},"th":{"stringUnit":{"state":"translated","value":"บันทึกงานแล้ว แต่งานจะไม่ทำงานโดยอัตโนมัติจนกว่าจะตั้งค่า `cron.enabled` เป็น `true` และรีสตาร์ท Gateway"}},"vi":{"stringUnit":{"state":"translated","value":"Các tác vụ đã được lưu, nhưng sẽ không tự động chạy cho đến khi `cron.enabled` được đặt thành `true` và Gateway khởi động lại."}},"nl":{"stringUnit":{"state":"translated","value":"Taken zijn opgeslagen, maar worden pas automatisch uitgevoerd wanneer `cron.enabled` is ingesteld op `true` en de Gateway opnieuw is gestart."}},"fa":{"stringUnit":{"state":"translated","value":"کارها ذخیره شده‌اند، اما تا زمانی که `cron.enabled` روی `true` تنظیم نشود و Gateway دوباره راه‌اندازی نشود، به‌صورت خودکار اجرا نخواهند شد."}},"ru":{"stringUnit":{"state":"translated","value":"Задания сохранены, но они не будут запускаться автоматически, пока `cron.enabled` не будет задано значение `true` и Gateway не будет перезапущен."}},"sv":{"stringUnit":{"state":"translated","value":"Jobb sparas, men de körs inte automatiskt förrän `cron.enabled` är inställt på `true` och Gateway startas om."}}}},
    "Jump to latest reply": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Jump to latest reply"}},"zh-CN":{"stringUnit":{"state":"translated","value":"跳转到最新回复"}},"zh-TW":{"stringUnit":{"state":"translated","value":"跳至最新回覆"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ir para a resposta mais recente"}},"de":{"stringUnit":{"state":"translated","value":"Zur neuesten Antwort springen"}},"es":{"stringUnit":{"state":"translated","value":"Ir a la respuesta más reciente"}},"ja-JP":{"stringUnit":{"state":"translated","value":"最新の返信に移動"}},"ko":{"stringUnit":{"state":"translated","value":"최신 답글로 이동"}},"fr":{"stringUnit":{"state":"translated","value":"Aller à la réponse la plus récente"}},"hi":{"stringUnit":{"state":"translated","value":"नवीनतम उत्तर पर जाएँ"}},"ar":{"stringUnit":{"state":"translated","value":"الانتقال إلى أحدث رد"}},"it":{"stringUnit":{"state":"translated","value":"Vai all'ultima risposta"}},"tr":{"stringUnit":{"state":"translated","value":"En yeni yanıta atla"}},"uk":{"stringUnit":{"state":"translated","value":"Перейти до останньої відповіді"}},"id":{"stringUnit":{"state":"translated","value":"Lompat ke balasan terbaru"}},"pl":{"stringUnit":{"state":"translated","value":"Przejdź do najnowszej odpowiedzi"}},"th":{"stringUnit":{"state":"translated","value":"ข้ามไปยังการตอบกลับล่าสุด"}},"vi":{"stringUnit":{"state":"translated","value":"Chuyển đến phản hồi mới nhất"}},"nl":{"stringUnit":{"state":"translated","value":"Naar nieuwste antwoord springen"}},"fa":{"stringUnit":{"state":"translated","value":"پرش به آخرین پاسخ"}},"ru":{"stringUnit":{"state":"translated","value":"Перейти к последнему ответу"}},"sv":{"stringUnit":{"state":"translated","value":"Hoppa till senaste svar"}}}},
    "Keep OpenClaw open while it checks the embedded CUA daemon.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Keep OpenClaw open while it checks the embedded CUA daemon."}},"zh-CN":{"stringUnit":{"state":"translated","value":"在 OpenClaw 检查内嵌 CUA 守护进程期间保持其打开。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw 檢查內嵌 CUA 常駐程式時，請保持開啟。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Mantenha o OpenClaw aberto enquanto ele verifica o daemon CUA incorporado."}},"de":{"stringUnit":{"state":"translated","value":"Lass OpenClaw geöffnet, während der eingebettete CUA-Daemon geprüft wird."}},"es":{"stringUnit":{"state":"translated","value":"Mantén OpenClaw abierto mientras comprueba el daemon CUA integrado."}},"ja-JP":{"stringUnit":{"state":"translated","value":"組み込みのCUAデーモンをチェックしている間はOpenClawを開いたままにしてください。"}},"ko":{"stringUnit":{"state":"translated","value":"내장된 CUA 데몬을 확인하는 동안 OpenClaw를 열어 두세요."}},"fr":{"stringUnit":{"state":"translated","value":"Gardez OpenClaw ouvert pendant qu'il vérifie le démon CUA intégré."}},"hi":{"stringUnit":{"state":"translated","value":"जब तक OpenClaw एम्बेडेड CUA डेमन की जाँच करता है, इसे खुला रखें।"}},"ar":{"stringUnit":{"state":"translated","value":"أبقِ OpenClaw مفتوحًا أثناء فحصه لخدمة CUA المضمّنة."}},"it":{"stringUnit":{"state":"translated","value":"Tieni aperto OpenClaw mentre verifica il daemon CUA integrato."}},"tr":{"stringUnit":{"state":"translated","value":"Gömülü CUA arka plan sürecini kontrol ederken OpenClaw'ı açık tutun."}},"uk":{"stringUnit":{"state":"translated","value":"Тримайте OpenClaw відкритим, поки він перевіряє вбудований демон CUA."}},"id":{"stringUnit":{"state":"translated","value":"Biarkan OpenClaw tetap terbuka saat memeriksa daemon CUA yang tertanam."}},"pl":{"stringUnit":{"state":"translated","value":"Pozostaw OpenClaw otwarty, gdy sprawdza wbudowany demon CUA."}},"th":{"stringUnit":{"state":"translated","value":"เปิด OpenClaw ไว้ขณะที่กำลังตรวจสอบ CUA daemon แบบฝังตัว"}},"vi":{"stringUnit":{"state":"translated","value":"Giữ OpenClaw mở trong khi kiểm tra daemon CUA nhúng."}},"nl":{"stringUnit":{"state":"translated","value":"Houd OpenClaw open terwijl het de ingebedde CUA-daemon controleert."}},"fa":{"stringUnit":{"state":"translated","value":"OpenClaw را باز نگه دارید تا دیمن CUA تعبیه‌شده را بررسی کند."}},"ru":{"stringUnit":{"state":"translated","value":"Не закрывайте OpenClaw, пока он проверяет встроенный демон CUA."}},"sv":{"stringUnit":{"state":"translated","value":"Håll OpenClaw öppet medan det kontrollerar den inbäddade CUA-daemonen."}}}},
    "Keep OpenClaw visible in the Dock. When off, windows still show the Dock icon while open.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Keep OpenClaw visible in the Dock. When off, windows still show the Dock icon while open."}},"zh-CN":{"stringUnit":{"state":"translated","value":"让 OpenClaw 在 Dock 中保持可见。关闭时，窗口打开期间仍会显示 Dock 图标。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"讓 OpenClaw 保持顯示在 Dock 中。關閉時，視窗開啟期間仍會顯示 Dock 圖示。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Manter o OpenClaw visível no Dock. Quando desativado, as janelas ainda mostram o ícone no Dock enquanto estiverem abertas."}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw im Dock sichtbar halten. Wenn deaktiviert, zeigen Fenster weiterhin das Dock-Symbol an, solange sie geöffnet sind."}},"es":{"stringUnit":{"state":"translated","value":"Mantener OpenClaw visible en el Dock. Cuando está desactivado, las ventanas siguen mostrando el icono del Dock mientras están abiertas."}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClaw を Dock に表示したままにします。オフの場合でも、ウィンドウが開いている間は Dock アイコンが表示されます。"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw를 Dock에 계속 표시합니다. 꺼져 있어도 창이 열려 있는 동안에는 Dock 아이콘이 계속 표시됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Garder OpenClaw visible dans le Dock. Lorsque cette option est désactivée, les fenêtres affichent toujours l’icône dans le Dock lorsqu’elles sont ouvertes."}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw को Dock में दृश्यमान रखें। बंद होने पर, विंडो खुली रहने के दौरान भी Dock आइकन दिखाती हैं।"}},"ar":{"stringUnit":{"state":"translated","value":"إبقاء OpenClaw ظاهرًا في Dock. عند إيقاف ذلك، ستظل النوافذ تُظهر أيقونة Dock أثناء فتحها."}},"it":{"stringUnit":{"state":"translated","value":"Mantieni OpenClaw visibile nel Dock. Quando disattivato, le finestre mostrano comunque l'icona nel Dock mentre sono aperte."}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw'u Dock'ta görünür tut. Kapalıyken, pencereler açık olduğu sürece yine de Dock simgesini gösterir."}},"uk":{"stringUnit":{"state":"translated","value":"Тримати OpenClaw видимим у Dock. Якщо вимкнено, вікна все одно показуватимуть іконку в Dock, доки відкриті."}},"id":{"stringUnit":{"state":"translated","value":"Tetap tampilkan OpenClaw di Dock. Saat dinonaktifkan, jendela tetap menampilkan ikon Dock saat terbuka."}},"pl":{"stringUnit":{"state":"translated","value":"Utrzymuj OpenClaw widoczny w Docku. Gdy ta opcja jest wyłączona, otwarte okna nadal pokazują ikonę w Docku."}},"th":{"stringUnit":{"state":"translated","value":"ให้ OpenClaw แสดงอยู่ใน Dock เมื่อปิด หน้าต่างจะยังคงแสดงไอคอน Dock ขณะเปิดอยู่"}},"vi":{"stringUnit":{"state":"translated","value":"Giữ OpenClaw hiển thị trong Dock. Khi tắt, các cửa sổ vẫn hiển thị biểu tượng Dock khi đang mở."}},"nl":{"stringUnit":{"state":"translated","value":"Houd OpenClaw zichtbaar in het Dock. Wanneer uitgeschakeld, tonen vensters nog steeds het Dock-icoon terwijl ze open zijn."}},"fa":{"stringUnit":{"state":"translated","value":"OpenClaw را در Dock قابل مشاهده نگه دارید. وقتی خاموش باشد، پنجره‌ها همچنان هنگام باز بودن آیکون Dock را نشان می‌دهند."}},"ru":{"stringUnit":{"state":"translated","value":"Оставлять OpenClaw видимым в Dock. Если выключено, окна всё равно показывают значок в Dock, пока открыты."}},"sv":{"stringUnit":{"state":"translated","value":"Håll OpenClaw synligt i Dock. När det är av visas fortfarande Dock-symbolen för fönster medan de är öppna."}}}},
    "Keep my edits": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Keep my edits"}},"zh-CN":{"stringUnit":{"state":"translated","value":"保留我的编辑"}},"zh-TW":{"stringUnit":{"state":"translated","value":"保留我的編輯"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Manter minhas edições"}},"de":{"stringUnit":{"state":"translated","value":"Meine Änderungen behalten"}},"es":{"stringUnit":{"state":"translated","value":"Conservar mis cambios"}},"ja-JP":{"stringUnit":{"state":"translated","value":"自分の編集内容を保持"}},"ko":{"stringUnit":{"state":"translated","value":"내 편집 유지"}},"fr":{"stringUnit":{"state":"translated","value":"Conserver mes modifications"}},"hi":{"stringUnit":{"state":"translated","value":"मेरे संपादन रखें"}},"ar":{"stringUnit":{"state":"translated","value":"الاحتفاظ بتعديلاتي"}},"it":{"stringUnit":{"state":"translated","value":"Mantieni le mie modifiche"}},"tr":{"stringUnit":{"state":"translated","value":"Düzenlemelerimi koru"}},"uk":{"stringUnit":{"state":"translated","value":"Зберегти мої зміни"}},"id":{"stringUnit":{"state":"translated","value":"Pertahankan editan saya"}},"pl":{"stringUnit":{"state":"translated","value":"Zachowaj moje zmiany"}},"th":{"stringUnit":{"state":"translated","value":"เก็บการแก้ไขของฉัน"}},"vi":{"stringUnit":{"state":"translated","value":"Giữ chỉnh sửa của tôi"}},"nl":{"stringUnit":{"state":"translated","value":"Mijn bewerkingen behouden"}},"fa":{"stringUnit":{"state":"translated","value":"حفظ ویرایش‌های من"}},"ru":{"stringUnit":{"state":"translated","value":"Сохранить мои изменения"}},"sv":{"stringUnit":{"state":"translated","value":"Behåll mina ändringar"}}}},
    "Keeps the last 400 lines and archives the old file.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Keeps the last 400 lines and archives the old file."}},"zh-CN":{"stringUnit":{"state":"translated","value":"保留最近 400 行并归档旧文件。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"保留最後 400 行並封存舊檔案。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Mantém as últimas 400 linhas e arquiva o arquivo antigo."}},"de":{"stringUnit":{"state":"translated","value":"Behält die letzten 400 Zeilen und archiviert die alte Datei."}},"es":{"stringUnit":{"state":"translated","value":"Conserva las últimas 400 líneas y archiva el archivo antiguo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"最後の400行を保持し、古いファイルをアーカイブします。"}},"ko":{"stringUnit":{"state":"translated","value":"마지막 400줄을 유지하고 이전 파일을 보관합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Conserve les 400 dernières lignes et archive l'ancien fichier."}},"hi":{"stringUnit":{"state":"translated","value":"अंतिम 400 पंक्तियों को रखता है और पुरानी फ़ाइल को संग्रहित करता है।"}},"ar":{"stringUnit":{"state":"translated","value":"يحتفظ بآخر 400 سطر ويؤرشف الملف القديم."}},"it":{"stringUnit":{"state":"translated","value":"Mantiene le ultime 400 righe e archivia il vecchio file."}},"tr":{"stringUnit":{"state":"translated","value":"Son 400 satırı tutar ve eski dosyayı arşivler."}},"uk":{"stringUnit":{"state":"translated","value":"Зберігає останні 400 рядків і архівує старий файл."}},"id":{"stringUnit":{"state":"translated","value":"Menyimpan 400 baris terakhir dan mengarsipkan file lama."}},"pl":{"stringUnit":{"state":"translated","value":"Zachowuje ostatnie 400 wierszy i archiwizuje stary plik."}},"th":{"stringUnit":{"state":"translated","value":"เก็บ 400 บรรทัดล่าสุดและเก็บถาวรไฟล์เก่า"}},"vi":{"stringUnit":{"state":"translated","value":"Giữ lại 400 dòng cuối và lưu trữ tệp cũ."}},"nl":{"stringUnit":{"state":"translated","value":"Behoudt de laatste 400 regels en archiveert het oude bestand."}},"fa":{"stringUnit":{"state":"translated","value":"۴۰۰ خط آخر را نگه می‌دارد و فایل قدیمی را بایگانی می‌کند."}},"ru":{"stringUnit":{"state":"translated","value":"Сохраняет последние 400 строк и архивирует старый файл."}},"sv":{"stringUnit":{"state":"translated","value":"Behåller de senaste 400 raderna och arkiverar den gamla filen."}}}},
    "Key": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Key"}},"zh-CN":{"stringUnit":{"state":"translated","value":"密钥"}},"zh-TW":{"stringUnit":{"state":"translated","value":"金鑰"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Chave"}},"de":{"stringUnit":{"state":"translated","value":"Schlüssel"}},"es":{"stringUnit":{"state":"translated","value":"Clave"}},"ja-JP":{"stringUnit":{"state":"translated","value":"キー"}},"ko":{"stringUnit":{"state":"translated","value":"키"}},"fr":{"stringUnit":{"state":"translated","value":"Clé"}},"hi":{"stringUnit":{"state":"translated","value":"कुंजी"}},"ar":{"stringUnit":{"state":"translated","value":"المفتاح"}},"it":{"stringUnit":{"state":"translated","value":"Chiave"}},"tr":{"stringUnit":{"state":"translated","value":"Anahtar"}},"uk":{"stringUnit":{"state":"translated","value":"Ключ"}},"id":{"stringUnit":{"state":"translated","value":"Kunci"}},"pl":{"stringUnit":{"state":"translated","value":"Klucz"}},"th":{"stringUnit":{"state":"translated","value":"คีย์"}},"vi":{"stringUnit":{"state":"translated","value":"Khóa"}},"nl":{"stringUnit":{"state":"translated","value":"Sleutel"}},"fa":{"stringUnit":{"state":"translated","value":"کلید"}},"ru":{"stringUnit":{"state":"translated","value":"Ключ"}},"sv":{"stringUnit":{"state":"translated","value":"Nyckel"}}}},
    "Kill": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Kill"}},"zh-CN":{"stringUnit":{"state":"translated","value":"终止"}},"zh-TW":{"stringUnit":{"state":"translated","value":"結束"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Encerrar"}},"de":{"stringUnit":{"state":"translated","value":"Beenden"}},"es":{"stringUnit":{"state":"translated","value":"Terminar"}},"ja-JP":{"stringUnit":{"state":"translated","value":"終了"}},"ko":{"stringUnit":{"state":"translated","value":"종료"}},"fr":{"stringUnit":{"state":"translated","value":"Tuer"}},"hi":{"stringUnit":{"state":"translated","value":"समाप्त करें"}},"ar":{"stringUnit":{"state":"translated","value":"إنهاء"}},"it":{"stringUnit":{"state":"translated","value":"Termina"}},"tr":{"stringUnit":{"state":"translated","value":"Sonlandır"}},"uk":{"stringUnit":{"state":"translated","value":"Завершити"}},"id":{"stringUnit":{"state":"translated","value":"Hentikan"}},"pl":{"stringUnit":{"state":"translated","value":"Zakończ"}},"th":{"stringUnit":{"state":"new","value":"Kill"}},"vi":{"stringUnit":{"state":"translated","value":"Dừng"}},"nl":{"stringUnit":{"state":"translated","value":"Beëindigen"}},"fa":{"stringUnit":{"state":"translated","value":"پایان دادن"}},"ru":{"stringUnit":{"state":"translated","value":"Завершить"}},"sv":{"stringUnit":{"state":"translated","value":"Avsluta"}}}},
    "Kind": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Kind"}},"zh-CN":{"stringUnit":{"state":"translated","value":"类型"}},"zh-TW":{"stringUnit":{"state":"translated","value":"類型"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Tipo"}},"de":{"stringUnit":{"state":"translated","value":"Art"}},"es":{"stringUnit":{"state":"translated","value":"Tipo"}},"ja-JP":{"stringUnit":{"state":"translated","value":"種類"}},"ko":{"stringUnit":{"state":"translated","value":"종류"}},"fr":{"stringUnit":{"state":"translated","value":"Type"}},"hi":{"stringUnit":{"state":"translated","value":"प्रकार"}},"ar":{"stringUnit":{"state":"translated","value":"النوع"}},"it":{"stringUnit":{"state":"translated","value":"Tipo"}},"tr":{"stringUnit":{"state":"translated","value":"Tür"}},"uk":{"stringUnit":{"state":"translated","value":"Тип"}},"id":{"stringUnit":{"state":"translated","value":"Jenis"}},"pl":{"stringUnit":{"state":"translated","value":"Rodzaj"}},"th":{"stringUnit":{"state":"translated","value":"ประเภท"}},"vi":{"stringUnit":{"state":"translated","value":"Loại"}},"nl":{"stringUnit":{"state":"translated","value":"Soort"}},"fa":{"stringUnit":{"state":"translated","value":"نوع"}},"ru":{"stringUnit":{"state":"translated","value":"Тип"}},"sv":{"stringUnit":{"state":"translated","value":"Typ"}}}},
    "Known commands can run; new commands use the prompt policy.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Known commands can run; new commands use the prompt policy."}},"zh-CN":{"stringUnit":{"state":"translated","value":"已知命令可以运行；新命令使用提示策略。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已知 commands 可執行；新的 commands 會使用提示政策。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Comandos conhecidos podem ser executados; novos comandos usam a política de solicitação."}},"de":{"stringUnit":{"state":"translated","value":"Bekannte Befehle können ausgeführt werden; neue Befehle verwenden die Eingabeaufforderungsrichtlinie."}},"es":{"stringUnit":{"state":"translated","value":"Los comandos conocidos pueden ejecutarse; los comandos nuevos usan la política de solicitud."}},"ja-JP":{"stringUnit":{"state":"translated","value":"既知のコマンドを実行できます。新しいコマンドにはプロンプトポリシーが適用されます。"}},"ko":{"stringUnit":{"state":"translated","value":"알려진 명령은 실행할 수 있으며, 새 명령에는 프롬프트 정책이 적용됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les commandes connues peuvent s’exécuter ; les nouvelles commandes utilisent la politique d’invite."}},"hi":{"stringUnit":{"state":"translated","value":"ज्ञात कमांड चल सकते हैं; नए कमांड प्रॉम्प्ट नीति का उपयोग करते हैं।"}},"ar":{"stringUnit":{"state":"translated","value":"يمكن تشغيل الأوامر المعروفة؛ وتستخدم الأوامر الجديدة سياسة المطالبة."}},"it":{"stringUnit":{"state":"translated","value":"I comandi noti possono essere eseguiti; i nuovi comandi usano la policy di richiesta."}},"tr":{"stringUnit":{"state":"translated","value":"Bilinen komutlar çalıştırılabilir; yeni komutlar istem ilkesini kullanır."}},"uk":{"stringUnit":{"state":"translated","value":"Відомі команди можуть виконуватися; для нових команд використовується політика запитів."}},"id":{"stringUnit":{"state":"translated","value":"Perintah yang dikenal dapat dijalankan; perintah baru menggunakan kebijakan prompt."}},"pl":{"stringUnit":{"state":"translated","value":"Znane polecenia mogą być uruchamiane; nowe polecenia używają zasad monitów."}},"th":{"stringUnit":{"state":"translated","value":"คำสั่งที่รู้จักสามารถทำงานได้; คำสั่งใหม่ใช้แนวทางการแจ้งถาม"}},"vi":{"stringUnit":{"state":"translated","value":"Các lệnh đã biết có thể chạy; lệnh mới dùng chính sách nhắc xác nhận."}},"nl":{"stringUnit":{"state":"translated","value":"Bekende opdrachten kunnen worden uitgevoerd; nieuwe opdrachten gebruiken het promptbeleid."}},"fa":{"stringUnit":{"state":"translated","value":"فرمان‌های شناخته‌شده می‌توانند اجرا شوند؛ فرمان‌های جدید از سیاست درخواست تأیید استفاده می‌کنند."}},"ru":{"stringUnit":{"state":"translated","value":"Известные команды могут выполняться; для новых команд используется политика с запросом подтверждения."}},"sv":{"stringUnit":{"state":"translated","value":"Kända kommandon kan köras; nya kommandon använder promptpolicyn."}}}},
    "Krilling": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Krilling"}},"zh-CN":{"stringUnit":{"state":"translated","value":"捕磷虾中"}},"zh-TW":{"stringUnit":{"state":"translated","value":"捕磷蝦中"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Krillando"}},"de":{"stringUnit":{"state":"translated","value":"Krillen"}},"es":{"stringUnit":{"state":"translated","value":"Buscando kril"}},"ja-JP":{"stringUnit":{"state":"translated","value":"オキアミ漁中"}},"ko":{"stringUnit":{"state":"translated","value":"크릴을 잡는 중"}},"fr":{"stringUnit":{"state":"translated","value":"Pêche au krill"}},"hi":{"stringUnit":{"state":"translated","value":"क्रिलिंग"}},"ar":{"stringUnit":{"state":"translated","value":"صيد الكريل"}},"it":{"stringUnit":{"state":"translated","value":"Pesca del krill"}},"tr":{"stringUnit":{"state":"translated","value":"Kril avlanıyor"}},"uk":{"stringUnit":{"state":"translated","value":"Крилювання"}},"id":{"stringUnit":{"state":"translated","value":"Mencari kril"}},"pl":{"stringUnit":{"state":"translated","value":"Krylowanie"}},"th":{"stringUnit":{"state":"translated","value":"กำลังจับเคย"}},"vi":{"stringUnit":{"state":"translated","value":"Đang bắt moi"}},"nl":{"stringUnit":{"state":"translated","value":"Krillen"}},"fa":{"stringUnit":{"state":"translated","value":"کریل‌گیری"}},"ru":{"stringUnit":{"state":"translated","value":"Криллим"}},"sv":{"stringUnit":{"state":"translated","value":"Fiskar krill"}}}},
    "Language": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Language"}},"zh-CN":{"stringUnit":{"state":"translated","value":"语言"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語言"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Idioma"}},"de":{"stringUnit":{"state":"translated","value":"Sprache"}},"es":{"stringUnit":{"state":"translated","value":"Idioma"}},"ja-JP":{"stringUnit":{"state":"translated","value":"言語"}},"ko":{"stringUnit":{"state":"translated","value":"언어"}},"fr":{"stringUnit":{"state":"translated","value":"Langue"}},"hi":{"stringUnit":{"state":"translated","value":"भाषा"}},"ar":{"stringUnit":{"state":"translated","value":"اللغة"}},"it":{"stringUnit":{"state":"translated","value":"Lingua"}},"tr":{"stringUnit":{"state":"translated","value":"Dil"}},"uk":{"stringUnit":{"state":"translated","value":"Мова"}},"id":{"stringUnit":{"state":"translated","value":"Bahasa"}},"pl":{"stringUnit":{"state":"translated","value":"Język"}},"th":{"stringUnit":{"state":"translated","value":"ภาษา"}},"vi":{"stringUnit":{"state":"translated","value":"Ngôn ngữ"}},"nl":{"stringUnit":{"state":"translated","value":"Taal"}},"fa":{"stringUnit":{"state":"translated","value":"زبان"}},"ru":{"stringUnit":{"state":"translated","value":"Язык"}},"sv":{"stringUnit":{"state":"translated","value":"Språk"}}}},
    "Language %lld": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Language %lld"}},"zh-CN":{"stringUnit":{"state":"translated","value":"语言 %lld"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語言 %lld"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Idioma %lld"}},"de":{"stringUnit":{"state":"translated","value":"Sprache %lld"}},"es":{"stringUnit":{"state":"translated","value":"Idioma %lld"}},"ja-JP":{"stringUnit":{"state":"translated","value":"言語 %lld"}},"ko":{"stringUnit":{"state":"translated","value":"언어 %lld"}},"fr":{"stringUnit":{"state":"translated","value":"Langue %lld"}},"hi":{"stringUnit":{"state":"translated","value":"भाषा %lld"}},"ar":{"stringUnit":{"state":"translated","value":"اللغة %lld"}},"it":{"stringUnit":{"state":"translated","value":"Lingua %lld"}},"tr":{"stringUnit":{"state":"translated","value":"Dil %lld"}},"uk":{"stringUnit":{"state":"translated","value":"Мова %lld"}},"id":{"stringUnit":{"state":"translated","value":"Bahasa %lld"}},"pl":{"stringUnit":{"state":"translated","value":"Język %lld"}},"th":{"stringUnit":{"state":"translated","value":"ภาษา %lld"}},"vi":{"stringUnit":{"state":"translated","value":"Ngôn ngữ %lld"}},"nl":{"stringUnit":{"state":"translated","value":"Taal %lld"}},"fa":{"stringUnit":{"state":"translated","value":"زبان %lld"}},"ru":{"stringUnit":{"state":"translated","value":"Язык %lld"}},"sv":{"stringUnit":{"state":"translated","value":"Språk %lld"}}}},
    "Languages are tried in order. Models may need a first-use download on macOS 26.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Languages are tried in order. Models may need a first-use download on macOS 26."}},"zh-CN":{"stringUnit":{"state":"translated","value":"将按顺序尝试语言。模型在 macOS 26 上可能需要首次使用时下载。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語言會依序嘗試。模型在 macOS 26 上首次使用時可能需要下載。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Os idiomas são testados em ordem. Os modelos podem precisar de um download no primeiro uso no macOS 26."}},"de":{"stringUnit":{"state":"translated","value":"Sprachen werden der Reihe nach ausprobiert. Modelle erfordern unter macOS 26 möglicherweise beim ersten Gebrauch einen Download."}},"es":{"stringUnit":{"state":"translated","value":"Los idiomas se prueban en orden. Es posible que los modelos necesiten una descarga en el primer uso en macOS 26."}},"ja-JP":{"stringUnit":{"state":"translated","value":"言語は順番に試されます。macOS 26 では、モデルの初回使用時にダウンロードが必要になる場合があります。"}},"ko":{"stringUnit":{"state":"translated","value":"언어는 순서대로 시도됩니다. macOS 26에서는 모델을 처음 사용할 때 다운로드가 필요할 수 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les langues sont essayées dans l’ordre. Les modèles peuvent nécessiter un téléchargement lors de la première utilisation sur macOS 26."}},"hi":{"stringUnit":{"state":"translated","value":"भाषाएँ क्रम में आज़माई जाती हैं। macOS 26 पर मॉडल को पहली बार उपयोग के लिए डाउनलोड की आवश्यकता हो सकती है।"}},"ar":{"stringUnit":{"state":"translated","value":"تُجرَّب اللغات بالترتيب. قد تحتاج النماذج إلى تنزيل عند الاستخدام الأول على macOS 26."}},"it":{"stringUnit":{"state":"translated","value":"Le lingue vengono provate in ordine. I modelli potrebbero richiedere un download al primo utilizzo su macOS 26."}},"tr":{"stringUnit":{"state":"translated","value":"Diller sırayla denenir. Modellerin macOS 26 üzerinde ilk kullanımda indirilmesi gerekebilir."}},"uk":{"stringUnit":{"state":"translated","value":"Мови перевіряються по черзі. Для моделей може знадобитися завантаження під час першого використання в macOS 26."}},"id":{"stringUnit":{"state":"translated","value":"Bahasa dicoba secara berurutan. Model mungkin perlu diunduh saat pertama kali digunakan di macOS 26."}},"pl":{"stringUnit":{"state":"translated","value":"Języki są wypróbowywane w kolejności. Modele mogą wymagać pobrania przy pierwszym użyciu w macOS 26."}},"th":{"stringUnit":{"state":"translated","value":"ระบบจะลองใช้ภาษาตามลำดับ โมเดลอาจต้องดาวน์โหลดเมื่อใช้งานครั้งแรกบน macOS 26"}},"vi":{"stringUnit":{"state":"translated","value":"Các ngôn ngữ được thử theo thứ tự. Các mô hình có thể cần tải xuống khi dùng lần đầu trên macOS 26."}},"nl":{"stringUnit":{"state":"translated","value":"Talen worden op volgorde geprobeerd. Modellen moeten mogelijk bij het eerste gebruik worden gedownload op macOS 26."}},"fa":{"stringUnit":{"state":"translated","value":"زبان‌ها به‌ترتیب امتحان می‌شوند. مدل‌ها ممکن است در macOS 26 نیاز به دانلود در اولین استفاده داشته باشند."}},"ru":{"stringUnit":{"state":"translated","value":"Языки проверяются по порядку. Для моделей может потребоваться загрузка при первом использовании на macOS 26."}},"sv":{"stringUnit":{"state":"translated","value":"Språk provas i ordning. Modeller kan behöva hämtas vid första användning på macOS 26."}}}},
