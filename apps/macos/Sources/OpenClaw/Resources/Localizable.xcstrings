    "Back": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Back"}},"zh-CN":{"stringUnit":{"state":"translated","value":"返回"}},"zh-TW":{"stringUnit":{"state":"translated","value":"返回"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Voltar"}},"de":{"stringUnit":{"state":"translated","value":"Zurück"}},"es":{"stringUnit":{"state":"translated","value":"Atrás"}},"ja-JP":{"stringUnit":{"state":"translated","value":"戻る"}},"ko":{"stringUnit":{"state":"translated","value":"뒤로"}},"fr":{"stringUnit":{"state":"translated","value":"Retour"}},"hi":{"stringUnit":{"state":"translated","value":"वापस"}},"ar":{"stringUnit":{"state":"translated","value":"رجوع"}},"it":{"stringUnit":{"state":"translated","value":"Indietro"}},"tr":{"stringUnit":{"state":"translated","value":"Geri"}},"uk":{"stringUnit":{"state":"translated","value":"Назад"}},"id":{"stringUnit":{"state":"translated","value":"Kembali"}},"pl":{"stringUnit":{"state":"translated","value":"Wstecz"}},"th":{"stringUnit":{"state":"translated","value":"ย้อนกลับ"}},"vi":{"stringUnit":{"state":"translated","value":"Quay lại"}},"nl":{"stringUnit":{"state":"translated","value":"Terug"}},"fa":{"stringUnit":{"state":"translated","value":"بازگشت"}},"ru":{"stringUnit":{"state":"translated","value":"Назад"}},"sv":{"stringUnit":{"state":"translated","value":"Bakåt"}}}},
    "Bare names match PATH commands. Use a path glob for a specific binary.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Bare names match PATH commands. Use a path glob for a specific binary."}},"zh-CN":{"stringUnit":{"state":"translated","value":"不带路径的名称匹配 PATH 中的命令。 要匹配特定二进制文件, 请使用路径通配模式。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"單純名稱會比對 PATH 中的命令。 若要指定特定執行檔，請使用路徑萬用字元模式。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Nomes sem caminho correspondem a comandos no PATH. Use um padrão glob de caminho para um binário específico."}},"de":{"stringUnit":{"state":"translated","value":"Reine Namen gleichen Befehle in PATH ab. Verwenden Sie ein Pfad-Glob-Muster für eine bestimmte Binärdatei."}},"es":{"stringUnit":{"state":"translated","value":"Los nombres sin ruta coinciden con comandos de PATH. Usa un patrón de ruta con comodines para un binario específico."}},"ja-JP":{"stringUnit":{"state":"translated","value":"名前のみの指定は PATH 内のコマンドに一致します。 特定のバイナリを指定するには、パスの glob パターンを使用してください。"}},"ko":{"stringUnit":{"state":"translated","value":"경로 없는 이름은 PATH의 명령어와 일치합니다. 특정 바이너리를 지정하려면 경로 glob 패턴을 사용하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Les noms seuls correspondent aux commandes du PATH. Utilisez un motif de chemin avec des caractères génériques pour un binaire spécifique."}},"hi":{"stringUnit":{"state":"translated","value":"बिना पथ वाले नाम PATH कमांड से मेल खाते हैं. किसी विशिष्ट बाइनरी के लिए पथ ग्लॉब का उपयोग करें."}},"ar":{"stringUnit":{"state":"translated","value":"تطابق الأسماء المجرّدة أوامر PATH. استخدم نمط مسار بأحرف بدل لملف تنفيذي محدد."}},"it":{"stringUnit":{"state":"translated","value":"I nomi senza percorso corrispondono ai comandi in PATH. Usa un pattern glob di percorso per un eseguibile specifico."}},"tr":{"stringUnit":{"state":"translated","value":"Yalın adlar PATH komutlarıyla eşleşir. Belirli bir ikili dosya için joker karakterli bir yol kalıbı kullanın."}},"uk":{"stringUnit":{"state":"translated","value":"Назви без шляху відповідають командам із PATH. Для конкретного виконуваного файлу використовуйте glob-шаблон шляху."}},"id":{"stringUnit":{"state":"translated","value":"Nama tanpa jalur cocok dengan perintah PATH. Gunakan pola glob jalur untuk berkas biner tertentu."}},"pl":{"stringUnit":{"state":"translated","value":"Same nazwy pasują do poleceń w PATH. Użyj wzorca glob ścieżki dla konkretnego pliku wykonywalnego."}},"th":{"stringUnit":{"state":"translated","value":"ชื่อที่ไม่มีพาธจะจับคู่กับคำสั่งใน PATH. ใช้รูปแบบพาธแบบ glob เพื่อระบุไฟล์ไบนารีที่ต้องการ."}},"vi":{"stringUnit":{"state":"translated","value":"Tên không kèm đường dẫn khớp với các lệnh trong PATH. Sử dụng mẫu glob đường dẫn cho một tệp nhị phân cụ thể."}},"nl":{"stringUnit":{"state":"translated","value":"Namen zonder pad komen overeen met opdrachten in PATH. Gebruik een glob-patroon voor het pad naar een specifiek uitvoerbaar bestand."}},"fa":{"stringUnit":{"state":"translated","value":"نام‌های بدون مسیر با فرمان‌های PATH مطابقت داده می‌شوند. برای یک فایل اجرایی مشخص از الگوی glob مسیر استفاده کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Имена без пути соответствуют командам из PATH. Для конкретного исполняемого файла используйте glob-шаблон пути."}},"sv":{"stringUnit":{"state":"translated","value":"Namn utan sökväg matchar kommandon i PATH. Använd ett sökvägsmönster med jokertecken för en specifik binärfil."}}}},
