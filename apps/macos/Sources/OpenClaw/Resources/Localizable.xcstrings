    "System browser profile import is disabled in the local Gateway configuration.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"System browser profile import is disabled in the local Gateway configuration."}},"zh-CN":{"stringUnit":{"state":"translated","value":"本地 Gateway 配置已禁用系统浏览器配置文件导入。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"本機 Gateway 設定已停用系統瀏覽器設定檔匯入功能。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A importação do perfil do navegador do sistema está desativada na configuração do Gateway local."}},"de":{"stringUnit":{"state":"translated","value":"Der Import von System-Browserprofilen ist in der lokalen Gateway-Konfiguration deaktiviert."}},"es":{"stringUnit":{"state":"translated","value":"La importación de perfiles del navegador del sistema está desactivada en la configuración del Gateway local."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ローカルのGateway設定で、システムのブラウザプロファイルのインポートが無効になっています。"}},"ko":{"stringUnit":{"state":"translated","value":"로컬 Gateway 구성에서 시스템 브라우저 프로필 가져오기가 비활성화되어 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’importation du profil du navigateur système est désactivée dans la configuration du Gateway local."}},"hi":{"stringUnit":{"state":"translated","value":"स्थानीय Gateway कॉन्फ़िगरेशन में सिस्टम ब्राउज़र प्रोफ़ाइल का आयात अक्षम है।"}},"ar":{"stringUnit":{"state":"translated","value":"استيراد ملف تعريف متصفح النظام معطّل في إعدادات Gateway المحلي."}},"it":{"stringUnit":{"state":"translated","value":"L’importazione del profilo del browser di sistema è disabilitata nella configurazione del Gateway locale."}},"tr":{"stringUnit":{"state":"translated","value":"Sistem tarayıcı profilini içe aktarma, yerel Gateway yapılandırmasında devre dışı bırakılmış."}},"uk":{"stringUnit":{"state":"translated","value":"Імпорт системного профілю браузера вимкнено в конфігурації локального Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Impor profil browser sistem dinonaktifka