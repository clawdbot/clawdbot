    "Delete…": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete…"}},"zh-CN":{"stringUnit":{"state":"translated","value":"删除…"}},"zh-TW":{"stringUnit":{"state":"translated","value":"刪除…"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Excluir…"}},"de":{"stringUnit":{"state":"translated","value":"Löschen…"}},"es":{"stringUnit":{"state":"translated","value":"Eliminar…"}},"ja-JP":{"stringUnit":{"state":"translated","value":"削除…"}},"ko":{"stringUnit":{"state":"translated","value":"삭제…"}},"fr":{"stringUnit":{"state":"translated","value":"Supprimer…"}},"hi":{"stringUnit":{"state":"translated","value":"हटाएँ…"}},"ar":{"stringUnit":{"state":"translated","value":"حذف…"}},"it":{"stringUnit":{"state":"translated","value":"Elimina…"}},"tr":{"stringUnit":{"state":"translated","value":"Sil…"}},"uk":{"stringUnit":{"state":"translated","value":"Видалити…"}},"id":{"stringUnit":{"state":"translated","value":"Hapus…"}},"pl":{"stringUnit":{"state":"translated","value":"Usuń…"}},"th":{"stringUnit":{"state":"translated","value":"ลบ…"}},"vi":{"stringUnit":{"state":"translated","value":"Xóa…"}},"nl":{"stringUnit":{"state":"translated","value":"Verwijderen…"}},"fa":{"stringUnit":{"state":"translated","value":"حذف…"}},"ru":{"stringUnit":{"state":"translated","value":"Удалить…"}},"sv":{"stringUnit":{"state":"translated","value":"Ta bort…"}}}},
    "Delivery could not be confirmed. Check Chat on iPhone before sending again.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delivery could not be confirmed. Check Chat on iPhone before sending again."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法确认是否已送达。再次发送前，请检查 iPhone 上的聊天。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法確認是否已送達。再次傳送前，請先查看 iPhone 上的聊天。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível confirmar a entrega. Verifique o Chat no iPhone antes de enviar novamente."}},"de":{"stringUnit":{"state":"translated","value":"Die Zustellung konnte nicht bestätigt werden. Prüfe den Chat auf dem iPhone, bevor du erneut sendest."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo confirmar la entrega. Revisa el chat en el iPhone antes de volver a enviar."}},"ja-JP":{"stringUnit":{"state":"translated","value":"配信を確認できませんでした。再送信する前にiPhoneのチャットを確認してください。"}},"ko":{"stringUnit":{"state":"translated","value":"전송 여부를 확인할 수 없습니다. 다시 보내기 전에 iPhone에서 채팅을 확인하세요."}},"fr":{"stringUnit":{"state":"translated","value":"L’envoi n’a pas pu être confirmé. Vérifiez la discussion sur l’iPhone avant de renvoyer."}},"hi":{"stringUnit":{"state":"translated","value":"डिलीवरी की पुष्टि नहीं हो सकी। दोबारा भेजने से पहले iPhone पर चैट देखें।"}},"ar":{"stringUnit":{"state":"translated","value":"تعذر تأكيد التسليم. تحقق من الدردشة على iPhone قبل الإرسال مجددًا."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile confermare la consegna. Controlla la chat su iPhone prima di inviare di nuovo."}},"tr":{"stringUnit":{"state":"translated","value":"Teslimat doğrulanamadı. Yeniden göndermeden önce iPhone'daki Sohbet'i kontrol edin."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося підтвердити доставку. Перевірте чат на iPhone, перш ніж надсилати знову."}},"id":{"stringUnit":{"state":"translated","value":"Pengiriman tidak dapat dikonfirmasi. Periksa Obrolan di iPhone sebelum mengirim lagi."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się potwierdzić dostarczenia. Sprawdź czat na iPhonie przed ponownym wysłaniem."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถยืนยันการส่งได้. ตรวจสอบแชทบน iPhone ก่อนส่งอีกครั้ง."}},"vi":{"stringUnit":{"state":"translated","value":"Không thể xác nhận việc chuyển phát. Kiểm tra phần Trò chuyện trên iPhone trước khi gửi lại."}},"nl":{"stringUnit":{"state":"translated","value":"De aflevering kon niet worden bevestigd. Controleer Chat op je iPhone voordat je opnieuw verzendt."}},"fa":{"stringUnit":{"state":"translated","value":"تحویل تأیید نشد. پیش از ارسال مجدد، گفت‌وگو را در iPhone بررسی کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось подтвердить доставку. Проверьте чат на iPhone перед повторной отправкой."}},"sv":{"stringUnit":{"state":"translated","value":"Leveransen kunde inte bekräftas. Kontrollera chatten på iPhone innan du skickar igen."}}}},
    "Delivery was interrupted. Check Chat on iPhone before sending again.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delivery was interrupted. Check Chat on iPhone before sending again."}},"zh-CN":{"stringUnit":{"state":"translated","value":"投递已中断。再次发送前，请检查 iPhone 上的聊天。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"傳送已中斷。再次傳送前，請先查看 iPhone 上的聊天。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A entrega foi interrompida. Verifique o Chat no iPhone antes de enviar novamente."}},"de":{"stringUnit":{"state":"translated","value":"Die Zustellung wurde unterbrochen. Prüfe den Chat auf dem iPhone, bevor du erneut sendest."}},"es":{"stringUnit":{"state":"translated","value":"Se interrumpió la entrega. Revisa el chat en el iPhone antes de volver a enviar."}},"ja-JP":{"stringUnit":{"state":"translated","value":"配信が中断されました。再送信する前にiPhoneのチャットを確認してください。"}},"ko":{"stringUnit":{"state":"translated","value":"전송이 중단되었습니다. 다시 보내기 전에 iPhone에서 채팅을 확인하세요."}},"fr":{"stringUnit":{"state":"translated","value":"L’envoi a été interrompu. Vérifiez la discussion sur l’iPhone avant de renvoyer."}},"hi":{"stringUnit":{"state":"translated","value":"डिलीवरी बाधित हो गई थी। दोबारा भेजने से पहले iPhone पर चैट देखें।"}},"ar":{"stringUnit":{"state":"translated","value":"انقطع التسليم. تحقق من الدردشة على iPhone قبل الإرسال مجددًا."}},"it":{"stringUnit":{"state":"translated","value":"La consegna è stata interrotta. Controlla la chat su iPhone prima di inviare di nuovo."}},"tr":{"stringUnit":{"state":"translated","value":"Teslimat kesintiye uğradı. Yeniden göndermeden önce iPhone'daki Sohbet'i kontrol edin."}},"uk":{"stringUnit":{"state":"translated","value":"Доставку перервано. Перевірте чат на iPhone, перш ніж надсилати знову."}},"id":{"stringUnit":{"state":"translated","value":"Pengiriman terputus. Periksa Obrolan di iPhone sebelum mengirim lagi."}},"pl":{"stringUnit":{"state":"translated","value":"Dostarczanie zostało przerwane. Sprawdź czat na iPhonie przed ponownym wysłaniem."}},"th":{"stringUnit":{"state":"translated","value":"การส่งถูกขัดจังหวะ. ตรวจสอบแชทบน iPhone ก่อนส่งอีกครั้ง."}},"vi":{"stringUnit":{"state":"translated","value":"Quá trình chuyển phát bị gián đoạn. Kiểm tra phần Trò chuyện trên iPhone trước khi gửi lại."}},"nl":{"stringUnit":{"state":"translated","value":"De aflevering is onderbroken. Controleer Chat op je iPhone voordat je opnieuw verzendt."}},"fa":{"stringUnit":{"state":"translated","value":"تحویل قطع شد. پیش از ارسال مجدد، گفت‌وگو را در iPhone بررسی کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Доставка прервана. Проверьте чат на iPhone перед повторной отправкой."}},"sv":{"stringUnit":{"state":"translated","value":"Leveransen avbröts. Kontrollera chatten på iPhone innan du skickar igen."}}}},
