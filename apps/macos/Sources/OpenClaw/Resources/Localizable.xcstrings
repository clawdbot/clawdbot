    "Clear this thread's history?": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Clear this thread's history?"}},"zh-CN":{"stringUnit":{"state":"translated","value":"清除此对话的历史记录？"}},"zh-TW":{"stringUnit":{"state":"translated","value":"要清除此討論串的歷史記錄嗎？"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Limpar o histórico desta conversa?"}},"de":{"stringUnit":{"state":"translated","value":"Verlauf dieses Threads löschen?"}},"es":{"stringUnit":{"state":"translated","value":"¿Borrar el historial de este hilo?"}},"ja-JP":{"stringUnit":{"state":"translated","value":"このスレッドの履歴を消去しますか？"}},"ko":{"stringUnit":{"state":"translated","value":"이 스레드의 기록을 지우시겠습니까?"}},"fr":{"stringUnit":{"state":"translated","value":"Effacer l’historique de cette conversation?"}},"hi":{"stringUnit":{"state":"translated","value":"इस थ्रेड का इतिहास साफ़ करें?"}},"ar":{"stringUnit":{"state":"translated","value":"هل تريد مسح سجل هذه المحادثة?"}},"it":{"stringUnit":{"state":"translated","value":"Cancellare la cronologia di questa conversazione?"}},"tr":{"stringUnit":{"state":"translated","value":"Bu konuşmanın geçmişi temizlensin mi?"}},"uk":{"stringUnit":{"state":"translated","value":"Очистити історію цієї гілки?"}},"id":{"stringUnit":{"state":"translated","value":"Hapus riwayat utas ini?"}},"pl":{"stringUnit":{"state":"translated","value":"Wyczyścić historię tego wątku?"}},"th":{"stringUnit":{"state":"translated","value":"ล้างประวัติของเธรดนี้หรือไม่?"}},"vi":{"stringUnit":{"state":"translated","value":"Xóa lịch sử của luồng trò chuyện này?"}},"nl":{"stringUnit":{"state":"translated","value":"De geschiedenis van dit gesprek wissen?"}},"fa":{"stringUnit":{"state":"translated","value":"تاریخچهٔ این گفتگو پاک شود?"}},"ru":{"stringUnit":{"state":"translated","value":"Очистить историю этой ветки?"}},"sv":{"stringUnit":{"state":"translated","value":"Rensa historiken för den här tråden?"}}}},
