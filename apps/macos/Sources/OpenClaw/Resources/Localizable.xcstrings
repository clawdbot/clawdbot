    "Verbose Logging (Main): Off": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Verbose Logging (Main): Off"}},"zh-CN":{"stringUnit":{"state":"translated","value":"详细日志（主）：关闭"}},"zh-TW":{"stringUnit":{"state":"translated","value":"詳細記錄（Main）：關閉"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Registro detalhado (principal): desativado"}},"de":{"stringUnit":{"state":"translated","value":"Ausführliche Protokollierung (Main): Aus"}},"es":{"stringUnit":{"state":"translated","value":"Registro detallado (principal): desactivado"}},"ja-JP":{"stringUnit":{"state":"translated","value":"詳細ログ（メイン）：オフ"}},"ko":{"stringUnit":{"state":"translated","value":"자세한 로깅(메인): 꺼짐"}},"fr":{"stringUnit":{"state":"translated","value":"Journalisation détaillée (Main) : désactivée"}},"hi":{"stringUnit":{"state":"translated","value":"Verbose Logging (Main): बंद"}},"ar":{"stringUnit":{"state":"translated","value":"التسجيل المطوّل (الرئيسي): إيقاف"}},"it":{"stringUnit":{"state":"translated","value":"Logging dettagliato (principale): disattivato"}},"tr":{"stringUnit":{"state":"translated","value":"Ayrıntılı Günlük Kaydı (Ana): Kapalı"}},"uk":{"stringUnit":{"state":"translated","value":"Детальне журналювання (Main): вимкнено"}},"id":{"stringUnit":{"state":"translated","value":"Logging Verbose (Utama): Nonaktif"}},"pl":{"stringUnit":{"state":"translated","value":"Szczegółowe logowanie (Main): Wyłączone"}},"th":{"stringUnit":{"state":"translated","value":"การบันทึกแบบละเอียด (หลัก): ปิด"}},"vi":{"stringUnit":{"state":"translated","value":"Ghi nhật ký chi tiết (Chính): Tắt"}},"nl":{"stringUnit":{"state":"translated","value":"Uitgebreide logging (hoofd): uit"}},"fa":{"stringUnit":{"state":"translated","value":"ثبت گزارش مفصل (اصلی): خاموش"}},"ru":{"stringUnit":{"state":"translated","value":"Подробное логирование (Main): выкл."}},"sv":{"stringUnit":{"state":"translated","value":"Utförlig loggning (Main): Av"}}}},
