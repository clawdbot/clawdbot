    "Session reset": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Session reset"}},"zh-CN":{"stringUnit":{"state":"translated","value":"会话重置"}},"zh-TW":{"stringUnit":{"state":"translated","value":"工作階段重設"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Redefinição da sessão"}},"de":{"stringUnit":{"state":"translated","value":"Sitzung zurückgesetzt"}},"es":{"stringUnit":{"state":"translated","value":"Restablecimiento de la sesión"}},"ja-JP":{"stringUnit":{"state":"translated","value":"セッションのリセット"}},"ko":{"stringUnit":{"state":"translated","value":"세션 초기화"}},"fr":{"stringUnit":{"state":"translated","value":"Réinitialisation de la session"}},"hi":{"stringUnit":{"state":"translated","value":"सत्र रीसेट"}},"ar":{"stringUnit":{"state":"translated","value":"إعادة تعيين الجلسة"}},"it":{"stringUnit":{"state":"translated","value":"Reimpostazione della sessione"}},"tr":{"stringUnit":{"state":"translated","value":"Oturum sıfırlama"}},"uk":{"stringUnit":{"state":"translated","value":"Скидання сеансу"}},"id":{"stringUnit":{"state":"translated","value":"Pengaturan ulang sesi"}},"pl":{"stringUnit":{"state":"translated","value":"Reset sesji"}},"th":{"stringUnit":{"state":"translated","value":"รีเซ็ตเซสชัน"}},"vi":{"stringUnit":{"state":"translated","value":"Đặt lại phiên"}},"nl":{"stringUnit":{"state":"translated","value":"Sessiereset"}},"fa":{"stringUnit":{"state":"translated","value":"بازنشانی نشست"}},"ru":{"stringUnit":{"state":"translated","value":"Сброс сеанса"}},"sv":{"stringUnit":{"state":"translated","value":"Sessionsåterställning"}}}},
    "Session settings changed. Review and retry this message.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Session settings changed. Review and retry this message."}},"zh-CN":{"stringUnit":{"state":"translated","value":"会话设置已更改。请检查后重试此消息。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"工作階段設定已變更。請檢查設定並重新傳送此訊息。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"As configurações da sessão foram alteradas. Revise e tente enviar esta mensagem novamente."}},"de":{"stringUnit":{"state":"translated","value":"Die Sitzungseinstellungen wurden geändert. Überprüfen Sie diese und versuchen Sie erneut, diese Nachricht zu senden."}},"es":{"stringUnit":{"state":"translated","value":"La configuración de la sesión ha cambiado. Revísala y vuelve a intentar enviar este mensaje."}},"ja-JP":{"stringUnit":{"state":"translated","value":"セッション設定が変更されました。 確認して、このメッセージを再試行してください。"}},"ko":{"stringUnit":{"state":"translated","value":"세션 설정이 변경되었습니다. 확인 후 이 메시지를 다시 시도하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Les paramètres de la session ont changé. Vérifiez-les et réessayez d’envoyer ce message."}},"hi":{"stringUnit":{"state":"translated","value":"सत्र की सेटिंग बदल गई हैं. समीक्षा करें और इस संदेश को फिर से भेजें."}},"ar":{"stringUnit":{"state":"translated","value":"تغيّرت إعدادات الجلسة. راجعها وأعد محاولة إرسال هذه الرسالة."}},"it":{"stringUnit":{"state":"translated","value":"Le impostazioni della sessione sono cambiate. Verificale e riprova a inviare questo messaggio."}},"tr":{"stringUnit":{"state":"translated","value":"Oturum ayarları değişti. Bu mesajı gözden geçirip yeniden deneyin."}},"uk":{"stringUnit":{"state":"translated","value":"Налаштування сеансу змінено. Перевірте їх і повторіть надсилання цього повідомлення."}},"id":{"stringUnit":{"state":"translated","value":"Pengaturan sesi berubah. Tinjau dan coba kirim ulang pesan ini."}},"pl":{"stringUnit":{"state":"translated","value":"Ustawienia sesji uległy zmianie. Sprawdź je i spróbuj ponownie wysłać tę wiadomość."}},"th":{"stringUnit":{"state":"translated","value":"การตั้งค่าเซสชันมีการเปลี่ยนแปลง ตรวจสอบแล้วลองส่งข้อความนี้อีกครั้ง"}},"vi":{"stringUnit":{"state":"translated","value":"Cài đặt phiên đã thay đổi. Hãy xem lại và thử gửi lại tin nhắn này."}},"nl":{"stringUnit":{"state":"translated","value":"Sessie-instellingen zijn gewijzigd. Controleer dit bericht en probeer het opnieuw."}},"fa":{"stringUnit":{"state":"translated","value":"تنظیمات نشست تغییر کرده‌اند. بررسی کنید و ارسال این پیام را دوباره امتحان کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Настройки сеанса изменились. Проверьте их и повторите отправку этого сообщения."}},"sv":{"stringUnit":{"state":"translated","value":"Sessionsinställningarna har ändrats. Granska och försök skicka meddelandet igen."}}}},
    "Session settings were not captured. Review and retry this message.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Session settings were not captured. Review and retry this message."}},"zh-CN":{"stringUnit":{"state":"translated","value":"未获取到会话设置。请检查后重试此消息。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"未擷取工作階段設定。請檢查設定並重新傳送此訊息。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"As configurações da sessão não foram capturadas. Revise e tente enviar esta mensagem novamente."}},"de":{"stringUnit":{"state":"translated","value":"Die Sitzungseinstellungen wurden nicht erfasst. Überprüfen Sie diese und versuchen Sie erneut, diese Nachricht zu senden."}},"es":{"stringUnit":{"state":"translated","value":"No se registró la configuración de la sesión. Revísala y vuelve a intentar enviar este mensaje."}},"ja-JP":{"stringUnit":{"state":"translated","value":"セッション設定を取得できませんでした。 確認して、このメッセージを再試行してください。"}},"ko":{"stringUnit":{"state":"translated","value":"세션 설정이 저장되지 않았습니다. 확인 후 이 메시지를 다시 시도하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Les paramètres de la session n’ont pas été enregistrés. Vérifiez-les et réessayez d’envoyer ce message."}},"hi":{"stringUnit":{"state":"translated","value":"सत्र की सेटिंग दर्ज नहीं की गई थीं. समीक्षा करें और इस संदेश को फिर से भेजें."}},"ar":{"stringUnit":{"state":"translated","value":"لم تُلتقط إعدادات الجلسة. راجعها وأعد محاولة إرسال هذه الرسالة."}},"it":{"stringUnit":{"state":"translated","value":"Le impostazioni della sessione non sono state acquisite. Verificale e riprova a inviare questo messaggio."}},"tr":{"stringUnit":{"state":"translated","value":"Oturum ayarları alınamadı. Bu mesajı gözden geçirip yeniden deneyin."}},"uk":{"stringUnit":{"state":"translated","value":"Налаштування сеансу не зафіксовано. Перевірте їх і повторіть надсилання цього повідомлення."}},"id":{"stringUnit":{"state":"translated","value":"Pengaturan sesi tidak terekam. Tinjau dan coba kirim ulang pesan ini."}},"pl":{"stringUnit":{"state":"translated","value":"Ustawienia sesji nie zostały zarejestrowane. Sprawdź je i spróbuj ponownie wysłać tę wiadomość."}},"th":{"stringUnit":{"state":"translated","value":"ไม่ได้บันทึกการตั้งค่าเซสชันไว้ ตรวจสอบแล้วลองส่งข้อความนี้อีกครั้ง"}},"vi":{"stringUnit":{"state":"translated","value":"Cài đặt phiên chưa được ghi nhận. Hãy xem lại và thử gửi lại tin nhắn này."}},"nl":{"stringUnit":{"state":"translated","value":"Sessie-instellingen zijn niet vastgelegd. Controleer dit bericht en probeer het opnieuw."}},"fa":{"stringUnit":{"state":"translated","value":"تنظیمات نشست ثبت نشدند. بررسی کنید و ارسال این پیام را دوباره امتحان کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Настройки сеанса не были зафиксированы. Проверьте их и повторите отправку этого сообщения."}},"sv":{"stringUnit":{"state":"translated","value":"Sessionsinställningarna registrerades inte. Granska och försök skicka meddelandet igen."}}}},
