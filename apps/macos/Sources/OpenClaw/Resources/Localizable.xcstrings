    "1 gateway found on your network — click to choose it.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"1 gateway found on your network — click to choose it."}},"zh-CN":{"stringUnit":{"state":"translated","value":"在你的网络上发现 1 个 Gateway — 点击以选择。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"在您的網路上找到 1 個 Gateway — 按一下以選取。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"1 Gateway encontrado na sua rede — clique para selecioná-lo."}},"de":{"stringUnit":{"state":"translated","value":"1 Gateway in deinem Netzwerk gefunden — zum Auswählen klicken."}},"es":{"stringUnit":{"state":"translated","value":"Se ha encontrado 1 Gateway en tu red — haz clic para seleccionarlo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ネットワーク上に1つのGatewayが見つかりました — クリックして選択してください。"}},"ko":{"stringUnit":{"state":"translated","value":"네트워크에서 Gateway 1개를 찾았습니다 — 클릭하여 선택하세요."}},"fr":{"stringUnit":{"state":"translated","value":"1 Gateway détecté sur votre réseau — cliquez pour le sélectionner."}},"hi":{"stringUnit":{"state":"translated","value":"आपके नेटवर्क पर 1 Gateway मिला — इसे चुनने के लिए क्लिक करें."}},"ar":{"stringUnit":{"state":"translated","value":"تم العثور على Gateway واحد على شبكتك — انقر لاختياره."}},"it":{"stringUnit":{"state":"translated","value":"1 gateway trovato sulla tua rete — fai clic per selezionarlo."}},"tr":{"stringUnit":{"state":"translated","value":"Ağınızda 1 Gateway bulundu — seçmek için tıklayın."}},"uk":{"stringUnit":{"state":"translated","value":"У вашій мережі знайдено 1 Gateway — натисніть, щоб вибрати його."}},"id":{"stringUnit":{"state":"translated","value":"1 Gateway ditemukan di jaringan Anda — klik untuk memilihnya."}},"pl":{"stringUnit":{"state":"translated","value":"Znaleziono 1 Gateway w Twojej sieci — kliknij, aby wybrać."}},"th":{"stringUnit":{"state":"translated","value":"พบ Gateway 1 รายการบนเครือข่ายของคุณ — คลิกเพื่อเลือก."}},"vi":{"stringUnit":{"state":"translated","value":"Đã tìm thấy 1 Gateway trên mạng của bạn — nhấp để chọn."}},"nl":{"stringUnit":{"state":"translated","value":"1 gateway gevonden op je netwerk — klik om deze te kiezen."}},"fa":{"stringUnit":{"state":"translated","value":"1 Gateway در شبکهٔ شما یافت شد — برای انتخاب آن کلیک کنید."}},"ru":{"stringUnit":{"state":"translated","value":"В вашей сети найден 1 Gateway — нажмите, чтобы выбрать его."}},"sv":{"stringUnit":{"state":"translated","value":"1 Gateway hittades i ditt nätverk — klicka för att välja den."}}}},
