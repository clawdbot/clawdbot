    "Output tokens: %@": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Output tokens: %@"}},"zh-CN":{"stringUnit":{"state":"translated","value":"输出令牌数: %@"}},"zh-TW":{"stringUnit":{"state":"translated","value":"輸出權杖數: %@"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Tokens de saída: %@"}},"de":{"stringUnit":{"state":"translated","value":"Ausgabetokens: %@"}},"es":{"stringUnit":{"state":"translated","value":"Tokens de salida: %@"}},"ja-JP":{"stringUnit":{"state":"translated","value":"出力トークン数: %@"}},"ko":{"stringUnit":{"state":"translated","value":"출력 토큰: %@"}},"fr":{"stringUnit":{"state":"translated","value":"Tokens de sortie: %@"}},"hi":{"stringUnit":{"state":"translated","value":"आउटपुट टोकन: %@"}},"ar":{"stringUnit":{"state":"translated","value":"رموز المخرجات: %@"}},"it":{"stringUnit":{"state":"translated","value":"Token di output: %@"}},"tr":{"stringUnit":{"state":"translated","value":"Çıktı token sayısı: %@"}},"uk":{"stringUnit":{"state":"translated","value":"Вихідні токени: %@"}},"id":{"stringUnit":{"state":"translated","value":"Token keluaran: %@"}},"pl":{"stringUnit":{"state":"translated","value":"Tokeny wyjściowe: %@"}},"th":{"stringUnit":{"state":"translated","value":"โทเค็นขาออก: %@"}},"vi":{"stringUnit":{"state":"translated","value":"Token đầu ra: %@"}},"nl":{"stringUnit":{"state":"translated","value":"Uitvoertokens: %@"}},"fa":{"stringUnit":{"state":"translated","value":"توکن‌های خروجی: %@"}},"ru":{"stringUnit":{"state":"translated","value":"Выходные токены: %@"}},"sv":{"stringUnit":{"state":"translated","value":"Utdatatoken: %@"}}}},
    "Own a Gateway on this Mac, or attach to one on another host.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Own a Gateway on this Mac, or attach to one on another host."}},"zh-CN":{"stringUnit":{"state":"translated","value":"在这台 Mac 上运行自己的 Gateway，或连接到其他主机上的 Gateway。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"在這部 Mac 上執行自己的 Gateway，或連接至其他主機上的 Gateway。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Execute um Gateway neste Mac ou conecte-se a um em outro host."}},"de":{"stringUnit":{"state":"translated","value":"Betreiben Sie ein Gateway auf diesem Mac oder verbinden Sie sich mit einem auf einem anderen Host."}},"es":{"stringUnit":{"state":"translated","value":"Ejecuta un Gateway en este Mac o conéctate a uno en otro equipo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このMacでGatewayを管理するか、別のホスト上のGatewayに接続します。"}},"ko":{"stringUnit":{"state":"translated","value":"이 Mac에서 Gateway를 직접 실행하거나 다른 호스트의 Gateway에 연결하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Hébergez un Gateway sur ce Mac ou connectez-vous à un Gateway sur un autre hôte."}},"hi":{"stringUnit":{"state":"translated","value":"इस Mac पर Gateway चलाएँ या किसी अन्य होस्ट पर मौजूद Gateway से जुड़ें।"}},"ar":{"stringUnit":{"state":"translated","value":"شغّل Gateway على جهاز Mac هذا، أو اتصل بآخر على مضيف آخر."}},"it":{"stringUnit":{"state":"translated","value":"Gestisci un Gateway su questo Mac oppure collegati a uno su un altro host."}},"tr":{"stringUnit":{"state":"translated","value":"Bu Mac'te bir Gateway çalıştırın veya başka bir ana makinedeki Gateway'e bağlanın."}},"uk":{"stringUnit":{"state":"translated","value":"Запустіть власний Gateway на цьому Mac або підключіться до Gateway на іншому хості."}},"id":{"stringUnit":{"state":"translated","value":"Kelola Gateway di Mac ini, atau hubungkan ke Gateway di host lain."}},"pl":{"stringUnit":{"state":"translated","value":"Uruchom własną instancję Gateway na tym Macu lub połącz się z instancją na innym hoście."}},"th":{"stringUnit":{"state":"translated","value":"ใช้งาน Gateway บน Mac เครื่องนี้ หรือเชื่อมต่อกับ Gateway บนโฮสต์อื่น"}},"vi":{"stringUnit":{"state":"translated","value":"Chạy Gateway riêng trên máy Mac này hoặc kết nối với Gateway trên máy chủ khác."}},"nl":{"stringUnit":{"state":"translated","value":"Beheer een Gateway op deze Mac of maak verbinding met een Gateway op een andere host."}},"fa":{"stringUnit":{"state":"translated","value":"یک Gateway را روی این Mac میزبانی کنید یا به یک Gateway روی میزبانی دیگر متصل شوید."}},"ru":{"stringUnit":{"state":"translated","value":"Запустите Gateway на этом Mac или подключитесь к Gateway на другом хосте."}},"sv":{"stringUnit":{"state":"translated","value":"Kör en egen Gateway på den här Mac-datorn eller anslut till en på en annan värddator."}}}},
    "PID": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"PID"}},"zh-CN":{"stringUnit":{"state":"new","value":"PID"}},"zh-TW":{"stringUnit":{"state":"new","value":"PID"}},"pt-BR":{"stringUnit":{"state":"new","value":"PID"}},"de":{"stringUnit":{"state":"new","value":"PID"}},"es":{"stringUnit":{"state":"new","value":"PID"}},"ja-JP":{"stringUnit":{"state":"new","value":"PID"}},"ko":{"stringUnit":{"state":"new","value":"PID"}},"fr":{"stringUnit":{"state":"new","value":"PID"}},"hi":{"stringUnit":{"state":"new","value":"PID"}},"ar":{"stringUnit":{"state":"new","value":"PID"}},"it":{"stringUnit":{"state":"new","value":"PID"}},"tr":{"stringUnit":{"state":"new","value":"PID"}},"uk":{"stringUnit":{"state":"new","value":"PID"}},"id":{"stringUnit":{"state":"new","value":"PID"}},"pl":{"stringUnit":{"state":"new","value":"PID"}},"th":{"stringUnit":{"state":"new","value":"PID"}},"vi":{"stringUnit":{"state":"new","value":"PID"}},"nl":{"stringUnit":{"state":"new","value":"PID"}},"fa":{"stringUnit":{"state":"new","value":"PID"}},"ru":{"stringUnit":{"state":"new","value":"PID"}},"sv":{"stringUnit":{"state":"new","value":"PID"}}}},
    "Paired: No": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Paired: No"}},"zh-CN":{"stringUnit":{"state":"translated","value":"已配对: 否"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已配對: 否"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Pareado: Não"}},"de":{"stringUnit":{"state":"translated","value":"Gekoppelt: Nein"}},"es":{"stringUnit":{"state":"translated","value":"Vinculado: No"}},"ja-JP":{"stringUnit":{"state":"translated","value":"ペアリング済み: いいえ"}},"ko":{"stringUnit":{"state":"translated","value":"페어링됨: 아니요"}},"fr":{"stringUnit":{"state":"translated","value":"Associé: Non"}},"hi":{"stringUnit":{"state":"translated","value":"पेयर किया गया: नहीं"}},"ar":{"stringUnit":{"state":"translated","value":"مقترن: لا"}},"it":{"stringUnit":{"state":"translated","value":"Associato: No"}},"tr":{"stringUnit":{"state":"translated","value":"Eşleştirildi: Hayır"}},"uk":{"stringUnit":{"state":"translated","value":"Пару створено: Ні"}},"id":{"stringUnit":{"state":"translated","value":"Terpasang: Tidak"}},"pl":{"stringUnit":{"state":"translated","value":"Sparowano: Nie"}},"th":{"stringUnit":{"state":"translated","value":"จับคู่แล้ว: ไม่"}},"vi":{"stringUnit":{"state":"translated","value":"Đã ghép đôi: Không"}},"nl":{"stringUnit":{"state":"translated","value":"Gekoppeld: Nee"}},"fa":{"stringUnit":{"state":"translated","value":"جفت‌شده: خیر"}},"ru":{"stringUnit":{"state":"translated","value":"Пара создана: Нет"}},"sv":{"stringUnit":{"state":"translated","value":"Parkopplad: Nej"}}}},
    "Paired: Yes": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Paired: Yes"}},"zh-CN":{"stringUnit":{"state":"translated","value":"已配对: 是"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已配對: 是"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Pareado: Sim"}},"de":{"stringUnit":{"state":"translated","value":"Gekoppelt: Ja"}},"es":{"stringUnit":{"state":"translated","value":"Vinculado: Sí"}},"ja-JP":{"stringUnit":{"state":"translated","value":"ペアリング済み: はい"}},"ko":{"stringUnit":{"state":"translated","value":"페어링됨: 예"}},"fr":{"stringUnit":{"state":"translated","value":"Jumelé: Oui"}},"hi":{"stringUnit":{"state":"translated","value":"पेयर किया गया: हाँ"}},"ar":{"stringUnit":{"state":"translated","value":"مقترن: نعم"}},"it":{"stringUnit":{"state":"translated","value":"Abbinato: Sì"}},"tr":{"stringUnit":{"state":"translated","value":"Eşleştirildi: Evet"}},"uk":{"stringUnit":{"state":"translated","value":"Сполучено: Так"}},"id":{"stringUnit":{"state":"translated","value":"Dipasangkan: Ya"}},"pl":{"stringUnit":{"state":"translated","value":"Sparowano: Tak"}},"th":{"stringUnit":{"state":"translated","value":"จับคู่แล้ว: ใช่"}},"vi":{"stringUnit":{"state":"translated","value":"Đã ghép nối: Có"}},"nl":{"stringUnit":{"state":"translated","value":"Gekoppeld: Ja"}},"fa":{"stringUnit":{"state":"translated","value":"جفت‌شده: بله"}},"ru":{"stringUnit":{"state":"translated","value":"Сопряжено: Да"}},"sv":{"stringUnit":{"state":"translated","value":"Parkopplad: Ja"}}}},
    "Pairing approval pending": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Pairing approval pending"}},"zh-CN":{"stringUnit":{"state":"translated","value":"等待配对批准"}},"zh-TW":{"stringUnit":{"state":"translated","value":"等待配對核准"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Aprovação de pareamento pendente"}},"de":{"stringUnit":{"state":"translated","value":"Kopplungsgenehmigung ausstehend"}},"es":{"stringUnit":{"state":"translated","value":"Aprobación de vinculación pendiente"}},"ja-JP":{"stringUnit":{"state":"translated","value":"ペアリングの承認待ち"}},"ko":{"stringUnit":{"state":"translated","value":"페어링 승인 대기 중"}},"fr":{"stringUnit":{"state":"translated","value":"Approbation du jumelage en attente"}},"hi":{"stringUnit":{"state":"translated","value":"पेयरिंग की स्वीकृति लंबित है"}},"ar":{"stringUnit":{"state":"translated","value":"الموافقة على الاقتران معلّقة"}},"it":{"stringUnit":{"state":"translated","value":"Approvazione dell'abbinamento in attesa"}},"tr":{"stringUnit":{"state":"translated","value":"Eşleştirme onayı bekleniyor"}},"uk":{"stringUnit":{"state":"translated","value":"Очікується схвалення сполучення"}},"id":{"stringUnit":{"state":"translated","value":"Menunggu persetujuan pemasangan"}},"pl":{"stringUnit":{"state":"translated","value":"Oczekiwanie na zatwierdzenie parowania"}},"th":{"stringUnit":{"state":"translated","value":"รอการอนุมัติการจับคู่"}},"vi":{"stringUnit":{"state":"translated","value":"Đang chờ phê duyệt ghép nối"}},"nl":{"stringUnit":{"state":"translated","value":"In afwachting van goedkeuring van koppeling"}},"fa":{"stringUnit":{"state":"translated","value":"در انتظار تأیید جفت‌سازی"}},"ru":{"stringUnit":{"state":"translated","value":"Ожидание подтверждения сопряжения"}},"sv":{"stringUnit":{"state":"translated","value":"Väntar på godkännande av parkoppling"}}}},
    "Pairing required. In an already-paired OpenClaw client, run /pair approve, then check the connection again.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Pairing required. In an already-paired OpenClaw client, run /pair approve, then check the connection again."}},"zh-CN":{"stringUnit":{"state":"translated","value":"需要配对。在已配对的 OpenClaw 客户端中运行 /pair approve，然后再次检查连接。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"需要配對。 請在已配對的 OpenClaw 用戶端中執行 /pair approve, 然後再次檢查連線。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Pareamento necessário. Em um cliente OpenClaw já pareado, execute /pair approve e verifique a conexão novamente."}},"de":{"stringUnit":{"state":"translated","value":"Kopplung erforderlich. Führen Sie in einem bereits gekoppelten OpenClaw-Client /pair approve aus und prüfen Sie dann die Verbindung erneut."}},"es":{"stringUnit":{"state":"translated","value":"Se requiere vinculación. En un cliente de OpenClaw ya vinculado, ejecuta /pair approve y vuelve a comprobar la conexión."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ペアリングが必要です。 ペアリング済みのOpenClawクライアントで /pair approve を実行してから、接続を再確認してください。"}},"ko":{"stringUnit":{"state":"translated","value":"페어링이 필요합니다. 이미 페어링된 OpenClaw 클라이언트에서 /pair approve를 실행한 다음 연결을 다시 확인하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Jumelage requis. Dans un client OpenClaw déjà jumelé, exécutez /pair approve, puis vérifiez à nouveau la connexion."}},"hi":{"stringUnit":{"state":"translated","value":"पेयरिंग आवश्यक है. पहले से पेयर किए गए OpenClaw क्लाइंट में /pair approve चलाएँ, फिर कनेक्शन दोबारा जाँचें."}},"ar":{"stringUnit":{"state":"translated","value":"الاقتران مطلوب. في عميل OpenClaw مقترن بالفعل، شغّل /pair approve، ثم تحقّق من الاتصال مجددًا."}},"it":{"stringUnit":{"state":"translated","value":"Abbinamento richiesto. In un client OpenClaw già abbinato, esegui /pair approve, quindi verifica di nuovo la connessione."}},"tr":{"stringUnit":{"state":"translated","value":"Eşleştirme gerekli. Zaten eşleştirilmiş bir OpenClaw istemcisinde /pair approve komutunu çalıştırın, ardından bağlantıyı tekrar kontrol edin."}},"uk":{"stringUnit":{"state":"translated","value":"Потрібне сполучення. У вже сполученому клієнті OpenClaw виконайте /pair approve, а потім перевірте з’єднання ще раз."}},"id":{"stringUnit":{"state":"translated","value":"Pemasangan diperlukan. Di klien OpenClaw yang sudah dipasangkan, jalankan /pair approve, lalu periksa koneksi lagi."}},"pl":{"stringUnit":{"state":"translated","value":"Wymagane parowanie. W już sparowanym kliencie OpenClaw uruchom /pair approve, a następnie ponownie sprawdź połączenie."}},"th":{"stringUnit":{"state":"translated","value":"ต้องจับคู่ก่อน. เรียกใช้ /pair approve ในไคลเอนต์ OpenClaw ที่จับคู่แล้ว จากนั้นตรวจสอบการเชื่อมต่ออีกครั้ง."}},"vi":{"stringUnit":{"state":"translated","value":"Cần ghép nối. Trong ứng dụng OpenClaw đã được ghép nối, chạy /pair approve, rồi kiểm tra lại kết nối."}},"nl":{"stringUnit":{"state":"translated","value":"Koppeling vereist. Voer /pair approve uit in een al gekoppelde OpenClaw-client en controleer de verbinding opnieuw."}},"fa":{"stringUnit":{"state":"translated","value":"جفت‌سازی لازم است. در یک کلاینت OpenClaw که قبلاً جفت شده است، /pair approve را اجرا کنید، سپس اتصال را دوباره بررسی کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Требуется сопряжение. В уже сопряжённом клиенте OpenClaw выполните /pair approve, затем проверьте подключение ещё раз."}},"sv":{"stringUnit":{"state":"translated","value":"Parkoppling krävs. Kör /pair approve i en redan parkopplad OpenClaw-klient och kontrollera sedan anslutningen igen."}}}},
    "Partial: %lld entries missing cost": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Partial: %lld entries missing cost"}},"zh-CN":{"stringUnit":{"state":"translated","value":"部分数据: %lld 条记录缺少费用"}},"zh-TW":{"stringUnit":{"state":"translated","value":"資料不完整: %lld 筆項目缺少費用"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Parcial: %lld registros sem custo informado"}},"de":{"stringUnit":{"state":"translated","value":"Unvollständig: Bei %lld Einträgen fehlen Kosten"}},"es":{"stringUnit":{"state":"translated","value":"Parcial: %lld entradas sin costo"}},"ja-JP":{"stringUnit":{"state":"translated","value":"一部のみ: %lld件のエントリでコストが欠落"}},"ko":{"stringUnit":{"state":"translated","value":"부분 집계: 항목 %lld개의 비용 누락"}},"fr":{"stringUnit":{"state":"translated","value":"Partiel: coût manquant pour %lld entrées"}},"hi":{"stringUnit":{"state":"translated","value":"आंशिक: %lld प्रविष्टियों में लागत नहीं है"}},"ar":{"stringUnit":{"state":"translated","value":"جزئي: %lld إدخالات تفتقر إلى التكلفة"}},"it":{"stringUnit":{"state":"translated","value":"Parziale: %lld voci senza costo"}},"tr":{"stringUnit":{"state":"translated","value":"Kısmi: %lld kayıtta maliyet eksik"}},"uk":{"stringUnit":{"state":"translated","value":"Частково: для %lld записів не вказано вартість"}},"id":{"stringUnit":{"state":"translated","value":"Sebagian: %lld entri tidak memiliki biaya"}},"pl":{"stringUnit":{"state":"translated","value":"Dane częściowe: brak kosztu w %lld wpisach"}},"th":{"stringUnit":{"state":"translated","value":"ข้อมูลบางส่วน: %lld รายการไม่มีข้อมูลค่าใช้จ่าย"}},"vi":{"stringUnit":{"state":"translated","value":"Chưa đầy đủ: %lld mục thiếu chi phí"}},"nl":{"stringUnit":{"state":"translated","value":"Gedeeltelijk: bij %lld vermeldingen ontbreken de kosten"}},"fa":{"stringUnit":{"state":"translated","value":"ناقص: %lld مورد فاقد هزینه هستند"}},"ru":{"stringUnit":{"state":"translated","value":"Неполные данные: у %lld записей не указана стоимость"}},"sv":{"stringUnit":{"state":"translated","value":"Ofullständigt: %lld poster saknar kostnad"}}}},
    "Password": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Password"}},"zh-CN":{"stringUnit":{"state":"translated","value":"密码"}},"zh-TW":{"stringUnit":{"state":"translated","value":"密碼"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Senha"}},"de":{"stringUnit":{"state":"translated","value":"Passwort"}},"es":{"stringUnit":{"state":"translated","value":"Contraseña"}},"ja-JP":{"stringUnit":{"state":"translated","value":"パスワード"}},"ko":{"stringUnit":{"state":"translated","value":"비밀번호"}},"fr":{"stringUnit":{"state":"translated","value":"Mot de passe"}},"hi":{"stringUnit":{"state":"translated","value":"पासवर्ड"}},"ar":{"stringUnit":{"state":"translated","value":"كلمة المرور"}},"it":{"stringUnit":{"state":"new","value":"Password"}},"tr":{"stringUnit":{"state":"translated","value":"Parola"}},"uk":{"stringUnit":{"state":"translated","value":"Пароль"}},"id":{"stringUnit":{"state":"translated","value":"Kata sandi"}},"pl":{"stringUnit":{"state":"translated","value":"Hasło"}},"th":{"stringUnit":{"state":"translated","value":"รหัสผ่าน"}},"vi":{"stringUnit":{"state":"translated","value":"Mật khẩu"}},"nl":{"stringUnit":{"state":"translated","value":"Wachtwoord"}},"fa":{"stringUnit":{"state":"translated","value":"گذرواژه"}},"ru":{"stringUnit":{"state":"translated","value":"Пароль"}},"sv":{"stringUnit":{"state":"translated","value":"Lösenord"}}}},
    "Paste the gateway host's configured password into the Gateway token field, then try again. The gateway accepts its secret in either field. If no password is configured, set `gateway.auth.password` or `OPENCLAW_GATEWAY_PASSWORD` on the gateway host.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Paste the gateway host's configured password into the Gateway token field, then try again. The gateway accepts its secret in either field. If no password is configured, set `gateway.auth.password` or `OPENCLAW_GATEWAY_PASSWORD` on the gateway host."}},"zh-CN":{"stringUnit":{"state":"translated","value":"将 Gateway 主机上配置的密码粘贴到 Gateway 令牌字段中，然后重试。Gateway 接受在任一字段中输入的密钥。如果尚未配置密码，请在 Gateway 主机上设置 `gateway.auth.password` 或 `OPENCLAW_GATEWAY_PASSWORD`。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"將 Gateway 主機上設定的密碼貼到 Gateway 權杖欄位，然後再試一次。Gateway 接受在任一欄位中輸入其密鑰。如果尚未設定密碼，請在 Gateway 主機上設定 `gateway.auth.password` 或 `OPENCLAW_GATEWAY_PASSWORD`。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Cole a senha configurada no host do Gateway no campo de token do Gateway e tente novamente. O Gateway aceita sua credencial em qualquer um dos campos. Se nenhuma senha estiver configurada, defina `gateway.auth.password` ou `OPENCLAW_GATEWAY_PASSWORD` no host do Gateway."}},"de":{"stringUnit":{"state":"translated","value":"Fügen Sie das auf dem Gateway-Host konfigurierte Passwort in das Feld für das Gateway-Token ein und versuchen Sie es erneut. Das Gateway akzeptiert sein Geheimnis in beiden Feldern. Wenn kein Passwort konfiguriert ist, legen Sie `gateway.auth.password` oder `OPENCLAW_GATEWAY_PASSWORD` auf dem Gateway-Host fest."}},"es":{"stringUnit":{"state":"translated","value":"Pega la contraseña configurada en el host del Gateway en el campo de token del Gateway y vuelve a intentarlo. El Gateway acepta su secreto en cualquiera de los dos campos. Si no hay ninguna contraseña configurada, establece `gateway.auth.password` u `OPENCLAW_GATEWAY_PASSWORD` en el host del Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayホストに設定されているパスワードをGatewayトークン欄に貼り付けて、もう一度お試しください。Gatewayは、どちらの欄に入力されたシークレットも受け付けます。パスワードが設定されていない場合は、Gatewayホストで`gateway.auth.password`または`OPENCLAW_GATEWAY_PASSWORD`を設定してください。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway 호스트에 설정된 비밀번호를 Gateway 토큰 필드에 붙여 넣은 후 다시 시도하세요. Gateway는 어느 필드에 입력하든 인증 정보를 허용합니다. 비밀번호가 설정되어 있지 않으면 Gateway 호스트에서 `gateway.auth.password` 또는 `OPENCLAW_GATEWAY_PASSWORD`를 설정하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Collez le mot de passe configuré sur l’hôte du Gateway dans le champ du jeton Gateway, puis réessayez. Le Gateway accepte son secret dans l’un ou l’autre des champs. Si aucun mot de passe n’est configuré, définissez `gateway.auth.password` ou `OPENCLAW_GATEWAY_PASSWORD` sur l’hôte du Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway होस्ट पर कॉन्फ़िगर किया गया पासवर्ड Gateway टोकन फ़ील्ड में पेस्ट करें, फिर दोबारा कोशिश करें। Gateway दोनों में से किसी भी फ़ील्ड में अपना सीक्रेट स्वीकार करता है। अगर कोई पासवर्ड कॉन्फ़िगर नहीं किया गया है, तो Gateway होस्ट पर `gateway.auth.password` या `OPENCLAW_GATEWAY_PASSWORD` सेट करें।"}},"ar":{"stringUnit":{"state":"translated","value":"ألصق كلمة المرور المضبوطة على مضيف Gateway في حقل رمز Gateway، ثم حاول مجددًا. يقبل Gateway بياناته السرية في أيٍّ من الحقلين. إذا لم تكن هناك كلمة مرور مضبوطة، فاضبط `gateway.auth.password` أو `OPENCLAW_GATEWAY_PASSWORD` على مضيف Gateway."}},"it":{"stringUnit":{"state":"translated","value":"Incolla la password configurata sull'host del Gateway nel campo del token del Gateway, quindi riprova. Il Gateway accetta il segreto in entrambi i campi. Se non è configurata alcuna password, imposta `gateway.auth.password` o `OPENCLAW_GATEWAY_PASSWORD` sull'host del Gateway."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway sunucusunda yapılandırılmış parolayı Gateway belirteci alanına yapıştırın, ardından tekrar deneyin. Gateway, gizli kimlik doğrulama bilgisini her iki alanda da kabul eder. Yapılandırılmış bir parola yoksa Gateway sunucusunda `gateway.auth.password` veya `OPENCLAW_GATEWAY_PASSWORD` ayarını yapın."}},"uk":{"stringUnit":{"state":"translated","value":"Вставте пароль, налаштований на хості Gateway, у поле токена Gateway, а потім спробуйте ще раз. Gateway приймає свій секрет у будь-якому з цих полів. Якщо пароль не налаштовано, задайте `gateway.auth.password` або `OPENCLAW_GATEWAY_PASSWORD` на хості Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Tempel kata sandi yang dikonfigurasi pada host Gateway ke kolom token Gateway, lalu coba lagi. Gateway menerima kredensial rahasianya di salah satu kolom. Jika belum ada kata sandi yang dikonfigurasi, atur `gateway.auth.password` atau `OPENCLAW_GATEWAY_PASSWORD` pada host Gateway."}},"pl":{"stringUnit":{"state":"translated","value":"Wklej hasło skonfigurowane na hoście Gateway w polu tokenu Gateway, a następnie spróbuj ponownie. Gateway akceptuje swój sekret w dowolnym z tych pól. Jeśli hasło nie jest skonfigurowane, ustaw `gateway.auth.password` lub `OPENCLAW_GATEWAY_PASSWORD` na hoście Gateway."}},"th":{"stringUnit":{"state":"translated","value":"วางรหัสผ่านที่กำหนดไว้บนโฮสต์ของ Gateway ลงในช่องโทเค็น Gateway แล้วลองอีกครั้ง Gateway ยอมรับข้อมูลลับในช่องใดก็ได้ หากยังไม่ได้กำหนดรหัสผ่าน ให้ตั้งค่า `gateway.auth.password` หรือ `OPENCLAW_GATEWAY_PASSWORD` บนโฮสต์ของ Gateway"}},"vi":{"stringUnit":{"state":"translated","value":"Dán mật khẩu đã cấu hình trên máy chủ Gateway vào trường mã thông báo Gateway, rồi thử lại. Gateway chấp nhận thông tin xác thực bí mật trong cả hai trường. Nếu chưa cấu hình mật khẩu, hãy đặt `gateway.auth.password` hoặc `OPENCLAW_GATEWAY_PASSWORD` trên máy chủ Gateway."}},"nl":{"stringUnit":{"state":"translated","value":"Plak het wachtwoord dat op de Gateway-host is ingesteld in het veld voor het Gateway-token en probeer het opnieuw. De Gateway accepteert de geheime waarde in beide velden. Als er geen wachtwoord is ingesteld, stel dan `gateway.auth.password` of `OPENCLAW_GATEWAY_PASSWORD` in op de Gateway-host."}},"fa":{"stringUnit":{"state":"translated","value":"گذرواژهٔ پیکربندی‌شده روی میزبان Gateway را در فیلد توکن Gateway جای‌گذاری کنید، سپس دوباره تلاش کنید. Gateway مقدار محرمانهٔ خود را در هر یک از این دو فیلد می‌پذیرد. اگر گذرواژه‌ای پیکربندی نشده است، `gateway.auth.password` یا `OPENCLAW_GATEWAY_PASSWORD` را روی میزبان Gateway تنظیم کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Вставьте пароль, настроенный на хосте Gateway, в поле токена Gateway и повторите попытку. Gateway принимает секрет в любом из этих полей. Если пароль не настроен, задайте `gateway.auth.password` или `OPENCLAW_GATEWAY_PASSWORD` на хосте Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Klistra in det konfigurerade lösenordet för Gateway-värden i fältet Gateway-token och försök igen. Gateway accepterar sin hemlighet i båda fälten. Om inget lösenord har konfigurerats anger du `gateway.auth.password` eller `OPENCLAW_GATEWAY_PASSWORD` på Gateway-värden."}}}},
    "Paste the token configured on the gateway host. On the gateway host, run `openclaw gateway auth-token --show` in an interactive terminal, then paste its output.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Paste the token configured on the gateway host. On the gateway host, run `openclaw gateway auth-token --show` in an interactive terminal, then paste its output."}},"zh-CN":{"stringUnit":{"state":"translated","value":"粘贴在 Gateway 主机上配置的令牌。在 Gateway 主机的交互式终端中运行 `openclaw gateway auth-token --show`，然后粘贴其输出。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"貼上 Gateway 主機上設定的權杖。 請在 Gateway 主機的互動式終端機中執行 `openclaw gateway auth-token --show`, 然後貼上其輸出。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Cole o token configurado no host do gateway. No host do gateway, execute `openclaw gateway auth-token --show` em um terminal interativo e cole a saída."}},"de":{"stringUnit":{"state":"translated","value":"Fügen Sie das auf dem Gateway-Host konfigurierte Token ein. Führen Sie auf dem Gateway-Host `openclaw gateway auth-token --show` in einem interaktiven Terminal aus und fügen Sie dann die Ausgabe ein."}},"es":{"stringUnit":{"state":"translated","value":"Pega el token configurado en el host del Gateway. En el host del Gateway, ejecuta `openclaw gateway auth-token --show` en una terminal interactiva y pega la salida."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ゲートウェイホストで設定されたトークンを貼り付けてください。 ゲートウェイホストの対話型ターミナルで `openclaw gateway auth-token --show` を実行し、その出力を貼り付けてください。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway 호스트에 설정된 토큰을 붙여넣으세요. Gateway 호스트의 대화형 터미널에서 `openclaw gateway auth-token --show`를 실행한 다음 출력 결과를 붙여넣으세요."}},"fr":{"stringUnit":{"state":"translated","value":"Collez le jeton configuré sur l’hôte du Gateway. Sur l’hôte du Gateway, exécutez `openclaw gateway auth-token --show` dans un terminal interactif, puis collez le résultat."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway होस्ट पर कॉन्फ़िगर किया गया टोकन पेस्ट करें. Gateway होस्ट पर, इंटरैक्टिव टर्मिनल में `openclaw gateway auth-token --show` चलाएँ, फिर उसका आउटपुट पेस्ट करें."}},"ar":{"stringUnit":{"state":"translated","value":"الصق الرمز المهيّأ على مضيف Gateway. على مضيف Gateway، شغّل `openclaw gateway auth-token --show` في طرفية تفاعلية، ثم الصق مخرجاته."}},"it":{"stringUnit":{"state":"translated","value":"Incolla il token configurato sull'host del gateway. Sull'host del gateway, esegui `openclaw gateway auth-token --show` in un terminale interattivo, quindi incolla il risultato."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway sunucusunda yapılandırılmış belirteci yapıştırın. Gateway sunucusunda, etkileşimli bir terminalde `openclaw gateway auth-token --show` komutunu çalıştırın, ardından çıktısını yapıştırın."}},"uk":{"stringUnit":{"state":"translated","value":"Вставте токен, налаштований на хості шлюзу. На хості шлюзу виконайте `openclaw gateway auth-token --show` в інтерактивному терміналі, а потім вставте вивід команди."}},"id":{"stringUnit":{"state":"translated","value":"Tempel token yang dikonfigurasi pada host gateway. Pada host gateway, jalankan `openclaw gateway auth-token --show` di terminal interaktif, lalu tempel keluarannya."}},"pl":{"stringUnit":{"state":"translated","value":"Wklej token skonfigurowany na hoście Gateway. Na hoście Gateway uruchom `openclaw gateway auth-token --show` w interaktywnym terminalu, a następnie wklej wynik polecenia."}},"th":{"stringUnit":{"state":"translated","value":"วางโทเค็นที่กำหนดค่าไว้บนโฮสต์ Gateway. บนโฮสต์ Gateway ให้เรียกใช้ `openclaw gateway auth-token --show` ในเทอร์มินัลแบบโต้ตอบ จากนั้นวางผลลัพธ์ที่ได้."}},"vi":{"stringUnit":{"state":"translated","value":"Dán token đã cấu hình trên máy chủ Gateway. Trên máy chủ Gateway, chạy `openclaw gateway auth-token --show` trong terminal tương tác, rồi dán kết quả đầu ra."}},"nl":{"stringUnit":{"state":"translated","value":"Plak het token dat op de gatewayhost is geconfigureerd. Voer op de gatewayhost `openclaw gateway auth-token --show` uit in een interactieve terminal en plak de uitvoer."}},"fa":{"stringUnit":{"state":"translated","value":"توکن پیکربندی‌شده روی میزبان Gateway را جای‌گذاری کنید. روی میزبان Gateway، دستور `openclaw gateway auth-token --show` را در یک ترمینال تعاملی اجرا کنید، سپس خروجی آن را جای‌گذاری کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Вставьте токен, настроенный на хосте шлюза. На хосте шлюза выполните `openclaw gateway auth-token --show` в интерактивном терминале, затем вставьте результат."}},"sv":{"stringUnit":{"state":"translated","value":"Klistra in den token som är konfigurerad på gateway-värden. Kör `openclaw gateway auth-token --show` i en interaktiv terminal på gateway-värden och klistra sedan in utdata."}}}},
    "Paste the token from your gateway": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Paste the token from your gateway"}},"zh-CN":{"stringUnit":{"state":"translated","value":"粘贴来自 Gateway 的令牌"}},"zh-TW":{"stringUnit":{"state":"translated","value":"貼上來自您 Gateway 的權杖"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Cole o token do seu gateway"}},"de":{"stringUnit":{"state":"translated","value":"Token von Ihrem Gateway einfügen"}},"es":{"stringUnit":{"state":"translated","value":"Pega el token de tu Gateway"}},"ja-JP":{"stringUnit":{"state":"translated","value":"ゲートウェイのトークンを貼り付け"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway의 토큰을 붙여넣으세요"}},"fr":{"stringUnit":{"state":"translated","value":"Collez le jeton de votre Gateway"}},"hi":{"stringUnit":{"state":"translated","value":"अपने Gateway से टोकन पेस्ट करें"}},"ar":{"stringUnit":{"state":"translated","value":"الصق الرمز من Gateway الخاص بك"}},"it":{"stringUnit":{"state":"translated","value":"Incolla il token del tuo gateway"}},"tr":{"stringUnit":{"state":"translated","value":"Gateway'inizdeki belirteci yapıştırın"}},"uk":{"stringUnit":{"state":"translated","value":"Вставте токен вашого шлюзу"}},"id":{"stringUnit":{"state":"translated","value":"Tempel token dari gateway Anda"}},"pl":{"stringUnit":{"state":"translated","value":"Wklej token z Gateway"}},"th":{"stringUnit":{"state":"translated","value":"วางโทเค็นจาก Gateway ของคุณ"}},"vi":{"stringUnit":{"state":"translated","value":"Dán token từ Gateway của bạn"}},"nl":{"stringUnit":{"state":"translated","value":"Plak het token van je gateway"}},"fa":{"stringUnit":{"state":"translated","value":"توکن Gateway خود را جای‌گذاری کنید"}},"ru":{"stringUnit":{"state":"translated","value":"Вставьте токен вашего шлюза"}},"sv":{"stringUnit":{"state":"translated","value":"Klistra in token från din gateway"}}}},
    "Paste to %@": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Paste to %@"}},"zh-CN":{"stringUnit":{"state":"translated","value":"粘贴到 %@"}},"zh-TW":{"stringUnit":{"state":"translated","value":"貼上至 %@"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Colar em %@"}},"de":{"stringUnit":{"state":"translated","value":"In %@ einfügen"}},"es":{"stringUnit":{"state":"translated","value":"Pegar en %@"}},"ja-JP":{"stringUnit":{"state":"translated","value":"%@に貼り付け"}},"ko":{"stringUnit":{"state":"translated","value":"%@에 붙여넣기"}},"fr":{"stringUnit":{"state":"translated","value":"Coller dans %@"}},"hi":{"stringUnit":{"state":"translated","value":"%@ में पेस्ट करें"}},"ar":{"stringUnit":{"state":"translated","value":"لصق في %@"}},"it":{"stringUnit":{"state":"translated","value":"Incolla in %@"}},"tr":{"stringUnit":{"state":"translated","value":"%@ hedefine yapıştır"}},"uk":{"stringUnit":{"state":"translated","value":"Вставити в %@"}},"id":{"stringUnit":{"state":"translated","value":"Tempel ke %@"}},"pl":{"stringUnit":{"state":"translated","value":"Wklej do %@"}},"th":{"stringUnit":{"state":"translated","value":"วางไปยัง %@"}},"vi":{"stringUnit":{"state":"translated","value":"Dán vào %@"}},"nl":{"stringUnit":{"state":"translated","value":"Plakken in %@"}},"fa":{"stringUnit":{"state":"translated","value":"جای‌گذاری در %@"}},"ru":{"stringUnit":{"state":"translated","value":"Вставить в %@"}},"sv":{"stringUnit":{"state":"translated","value":"Klistra in i %@"}}}},
    "Path": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Path"}},"zh-CN":{"stringUnit":{"state":"translated","value":"路径"}},"zh-TW":{"stringUnit":{"state":"translated","value":"路徑"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Caminho"}},"de":{"stringUnit":{"state":"translated","value":"Pfad"}},"es":{"stringUnit":{"state":"translated","value":"Ruta"}},"ja-JP":{"stringUnit":{"state":"translated","value":"パス"}},"ko":{"stringUnit":{"state":"translated","value":"경로"}},"fr":{"stringUnit":{"state":"translated","value":"Chemin"}},"hi":{"stringUnit":{"state":"translated","value":"पथ"}},"ar":{"stringUnit":{"state":"translated","value":"المسار"}},"it":{"stringUnit":{"state":"translated","value":"Percorso"}},"tr":{"stringUnit":{"state":"translated","value":"Yol"}},"uk":{"stringUnit":{"state":"translated","value":"Шлях"}},"id":{"stringUnit":{"state":"translated","value":"Jalur"}},"pl":{"stringUnit":{"state":"translated","value":"Ścieżka"}},"th":{"stringUnit":{"state":"translated","value":"เส้นทาง"}},"vi":{"stringUnit":{"state":"translated","value":"Đường dẫn"}},"nl":{"stringUnit":{"state":"translated","value":"Pad"}},"fa":{"stringUnit":{"state":"translated","value":"مسیر"}},"ru":{"stringUnit":{"state":"translated","value":"Путь"}},"sv":{"stringUnit":{"state":"translated","value":"Sökväg"}}}},
    "Path to openclaw repo": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Path to openclaw repo"}},"zh-CN":{"stringUnit":{"state":"translated","value":"openclaw 仓库路径"}},"zh-TW":{"stringUnit":{"state":"translated","value":"openclaw 儲存庫路徑"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Caminho para o repositório openclaw"}},"de":{"stringUnit":{"state":"translated","value":"Pfad zum openclaw-Repository"}},"es":{"stringUnit":{"state":"translated","value":"Ruta al repositorio de openclaw"}},"ja-JP":{"stringUnit":{"state":"translated","value":"openclawリポジトリへのパス"}},"ko":{"stringUnit":{"state":"translated","value":"openclaw 저장소 경로"}},"fr":{"stringUnit":{"state":"translated","value":"Chemin du dépôt openclaw"}},"hi":{"stringUnit":{"state":"translated","value":"openclaw रिपॉज़िटरी का पथ"}},"ar":{"stringUnit":{"state":"translated","value":"المسار إلى مستودع openclaw"}},"it":{"stringUnit":{"state":"translated","value":"Percorso del repository openclaw"}},"tr":{"stringUnit":{"state":"translated","value":"openclaw deposunun yolu"}},"uk":{"stringUnit":{"state":"translated","value":"Шлях до репозиторію openclaw"}},"id":{"stringUnit":{"state":"translated","value":"Jalur ke repositori openclaw"}},"pl":{"stringUnit":{"state":"translated","value":"Ścieżka do repozytorium openclaw"}},"th":{"stringUnit":{"state":"translated","value":"เส้นทางไปยังที่เก็บโค้ด openclaw"}},"vi":{"stringUnit":{"state":"translated","value":"Đường dẫn đến kho mã openclaw"}},"nl":{"stringUnit":{"state":"translated","value":"Pad naar openclaw-repository"}},"fa":{"stringUnit":{"state":"translated","value":"مسیر مخزن openclaw"}},"ru":{"stringUnit":{"state":"translated","value":"Путь к репозиторию openclaw"}},"sv":{"stringUnit":{"state":"translated","value":"Sökväg till openclaw-kodförrådet"}}}},
    "Paths": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Paths"}},"zh-CN":{"stringUnit":{"state":"translated","value":"路径"}},"zh-TW":{"stringUnit":{"state":"translated","value":"路徑"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Caminhos"}},"de":{"stringUnit":{"state":"translated","value":"Pfade"}},"es":{"stringUnit":{"state":"translated","value":"Rutas"}},"ja-JP":{"stringUnit":{"state":"translated","value":"パス"}},"ko":{"stringUnit":{"state":"translated","value":"경로"}},"fr":{"stringUnit":{"state":"translated","value":"Chemins"}},"hi":{"stringUnit":{"state":"translated","value":"पथ"}},"ar":{"stringUnit":{"state":"translated","value":"المسارات"}},"it":{"stringUnit":{"state":"translated","value":"Percorsi"}},"tr":{"stringUnit":{"state":"translated","value":"Yollar"}},"uk":{"stringUnit":{"state":"translated","value":"Шляхи"}},"id":{"stringUnit":{"state":"translated","value":"Jalur"}},"pl":{"stringUnit":{"state":"translated","value":"Ścieżki"}},"th":{"stringUnit":{"state":"translated","value":"เส้นทาง"}},"vi":{"stringUnit":{"state":"translated","value":"Đường dẫn"}},"nl":{"stringUnit":{"state":"translated","value":"Paden"}},"fa":{"stringUnit":{"state":"translated","value":"مسیرها"}},"ru":{"stringUnit":{"state":"translated","value":"Пути"}},"sv":{"stringUnit":{"state":"translated","value":"Sökvägar"}}}},
    "Pause": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Pause"}},"zh-CN":{"stringUnit":{"state":"translated","value":"暂停"}},"zh-TW":{"stringUnit":{"state":"translated","value":"暫停"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Pausar"}},"de":{"stringUnit":{"state":"translated","value":"Pausieren"}},"es":{"stringUnit":{"state":"translated","value":"Pausar"}},"ja-JP":{"stringUnit":{"state":"translated","value":"一時停止"}},"ko":{"stringUnit":{"state":"translated","value":"일시정지"}},"fr":{"stringUnit":{"state":"new","value":"Pause"}},"hi":{"stringUnit":{"state":"translated","value":"विराम दें"}},"ar":{"stringUnit":{"state":"translated","value":"إيقاف مؤقت"}},"it":{"stringUnit":{"state":"translated","value":"Pausa"}},"tr":{"stringUnit":{"state":"translated","value":"Duraklat"}},"uk":{"stringUnit":{"state":"translated","value":"Пауза"}},"id":{"stringUnit":{"state":"translated","value":"Jeda"}},"pl":{"stringUnit":{"state":"translated","value":"Wstrzymaj"}},"th":{"stringUnit":{"state":"translated","value":"หยุดชั่วคราว"}},"vi":{"stringUnit":{"state":"translated","value":"Tạm dừng"}},"nl":{"stringUnit":{"state":"translated","value":"Pauzeren"}},"fa":{"stringUnit":{"state":"translated","value":"مکث"}},"ru":{"stringUnit":{"state":"translated","value":"Пауза"}},"sv":{"stringUnit":{"state":"translated","value":"Pausa"}}}},
    "Pause Talk mode before playing this attachment.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Pause Talk mode before playing this attachment."}},"zh-CN":{"stringUnit":{"state":"translated","value":"播放此附件前，请暂停对话模式。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"播放此附件前，請先暫停交談模式。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Pause o modo de conversa antes de reproduzir este anexo."}},"de":{"stringUnit":{"state":"translated","value":"Pausiere den Gesprächsmodus, bevor du diesen Anhang abspielst."}},"es":{"stringUnit":{"state":"translated","value":"Pausa el modo de conversación antes de reproducir este archivo adjunto."}},"ja-JP":{"stringUnit":{"state":"translated","value":"この添付ファイルを再生する前にトークモードを一時停止してください。"}},"ko":{"stringUnit":{"state":"translated","value":"이 첨부 파일을 재생하기 전에 대화 모드를 일시 정지하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Mettez le mode Conversation en pause avant de lire cette pièce jointe."}},"hi":{"stringUnit":{"state":"translated","value":"यह अटैचमेंट चलाने से पहले बातचीत मोड को विराम दें."}},"ar":{"stringUnit":{"state":"translated","value":"أوقف وضع التحدث مؤقتًا قبل تشغيل هذا المرفق."}},"it":{"stringUnit":{"state":"translated","value":"Metti in pausa la modalità Talk prima di riprodurre questo allegato."}},"tr":{"stringUnit":{"state":"translated","value":"Bu eki oynatmadan önce Konuşma modunu duraklatın."}},"uk":{"stringUnit":{"state":"translated","value":"Призупиніть режим розмови перед відтворенням цього вкладення."}},"id":{"stringUnit":{"state":"translated","value":"Jeda mode Bicara sebelum memutar lampiran ini."}},"pl":{"stringUnit":{"state":"translated","value":"Wstrzymaj tryb rozmowy przed odtworzeniem tego załącznika."}},"th":{"stringUnit":{"state":"translated","value":"หยุดโหมดสนทนาชั่วคราวก่อนเล่นไฟล์แนบนี้."}},"vi":{"stringUnit":{"state":"translated","value":"Tạm dừng chế độ Trò chuyện trước khi phát tệp đính kèm này."}},"nl":{"stringUnit":{"state":"translated","value":"Pauzeer de gespreksmodus voordat je deze bijlage afspeelt."}},"fa":{"stringUnit":{"state":"translated","value":"پیش از پخش این پیوست، حالت گفت‌وگو را موقتاً متوقف کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Приостановите режим разговора перед воспроизведением этого вложения."}},"sv":{"stringUnit":{"state":"translated","value":"Pausa samtalsläget innan du spelar upp den här bilagan."}}}},
    "Pearling": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Pearling"}},"zh-CN":{"stringUnit":{"state":"translated","value":"正在凝珠"}},"zh-TW":{"stringUnit":{"state":"translated","value":"形成珠光"}},"pt-BR":{"stringUnit":{"state":"new","value":"Pearling"}},"de":{"stringUnit":{"state":"translated","value":"Perlenbildung"}},"es":{"stringUnit":{"state":"new","value":"Pearling"}},"ja-JP":{"stringUnit":{"state":"new","value":"Pearling"}},"ko":{"stringUnit":{"state":"translated","value":"진주 형성 중"}},"fr":{"stringUnit":{"state":"translated","value":"Formation de perles"}},"hi":{"stringUnit":{"state":"new","value":"Pearling"}},"ar":{"stringUnit":{"state":"translated","value":"تشكيل اللآلئ"}},"it":{"stringUnit":{"state":"new","value":"Pearling"}},"tr":{"stringUnit":{"state":"translated","value":"İnci oluşturuluyor"}},"uk":{"stringUnit":{"state":"translated","value":"Нанизування перлин"}},"id":{"stringUnit":{"state":"new","value":"Pearling"}},"pl":{"stringUnit":{"state":"translated","value":"Perlenie"}},"th":{"stringUnit":{"state":"new","value":"Pearling"}},"vi":{"stringUnit":{"state":"translated","value":"Kết ngọc"}},"nl":{"stringUnit":{"state":"translated","value":"Parelen"}},"fa":{"stringUnit":{"state":"translated","value":"مرواریدسازی"}},"ru":{"stringUnit":{"state":"new","value":"Pearling"}},"sv":{"stringUnit":{"state":"translated","value":"Pärlar"}}}},
    "Pending": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Pending"}},"zh-CN":{"stringUnit":{"state":"translated","value":"待处理"}},"zh-TW":{"stringUnit":{"state":"translated","value":"待處理"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Pendente"}},"de":{"stringUnit":{"state":"translated","value":"Ausstehend"}},"es":{"stringUnit":{"state":"translated","value":"Pendiente"}},"ja-JP":{"stringUnit":{"state":"translated","value":"保留中"}},"ko":{"stringUnit":{"state":"translated","value":"대기 중"}},"fr":{"stringUnit":{"state":"translated","value":"En attente"}},"hi":{"stringUnit":{"state":"translated","value":"लंबित"}},"ar":{"stringUnit":{"state":"translated","value":"قيد الانتظار"}},"it":{"stringUnit":{"state":"translated","value":"In attesa"}},"tr":{"stringUnit":{"state":"translated","value":"Beklemede"}},"uk":{"stringUnit":{"state":"translated","value":"Очікує"}},"id":{"stringUnit":{"state":"translated","value":"Menunggu"}},"pl":{"stringUnit":{"state":"translated","value":"Oczekuje"}},"th":{"stringUnit":{"state":"translated","value":"รอดำเนินการ"}},"vi":{"stringUnit":{"state":"translated","value":"Đang chờ"}},"nl":{"stringUnit":{"state":"translated","value":"In afwachting"}},"fa":{"stringUnit":{"state":"translated","value":"در انتظار"}},"ru":{"stringUnit":{"state":"translated","value":"В ожидании"}},"sv":{"stringUnit":{"state":"translated","value":"Väntande"}}}},
    "Permissions, Quick Chat, voice, and updates live in Dashboard → Settings → This Mac and need a Gateway release that includes those pages.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Permissions, Quick Chat, voice, and updates live in Dashboard → Settings → This Mac and need a Gateway release that includes those pages."}},"zh-CN":{"stringUnit":{"state":"translated","value":"权限、快速聊天、语音和更新位于“仪表盘 → 设置 → 这台 Mac”中，需要使用包含这些页面的 Gateway 版本。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"權限、快速聊天、語音及更新功能位於「儀表板 → 設定 → 這部 Mac」，且需要包含這些頁面的 Gateway 版本。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Permissões, Chat rápido, voz e atualizações ficam em Painel → Configurações → Este Mac e exigem uma versão do Gateway que inclua essas páginas."}},"de":{"stringUnit":{"state":"translated","value":"Berechtigungen, Schnellchat, Sprache und Updates finden Sie unter Dashboard → Einstellungen → Dieser Mac. Dafür ist eine Gateway-Version erforderlich, die diese Seiten enthält."}},"es":{"stringUnit":{"state":"translated","value":"Los permisos, el chat rápido, la voz y las actualizaciones se encuentran en Panel → Configuración → Este Mac y requieren una versión de Gateway que incluya esas páginas."}},"ja-JP":{"stringUnit":{"state":"translated","value":"権限、クイックチャット、音声、アップデートは、ダッシュボード → 設定 → このMacにあります。これらのページを含むGatewayのリリースが必要です。"}},"ko":{"stringUnit":{"state":"translated","value":"권한, 빠른 채팅, 음성 및 업데이트는 대시보드 → 설정 → 이 Mac에서 관리하며, 해당 페이지가 포함된 Gateway 버전이 필요합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les autorisations, le chat rapide, la voix et les mises à jour se trouvent dans Tableau de bord → Paramètres → Ce Mac et nécessitent une version du Gateway qui inclut ces pages."}},"hi":{"stringUnit":{"state":"translated","value":"अनुमतियाँ, त्वरित चैट, आवाज़ और अपडेट डैशबोर्ड → सेटिंग्स → यह Mac में उपलब्ध हैं। इनके लिए Gateway का ऐसा संस्करण चाहिए जिसमें ये पेज शामिल हों।"}},"ar":{"stringUnit":{"state":"translated","value":"توجد الأذونات والدردشة السريعة والصوت والتحديثات في لوحة التحكم → الإعدادات → جهاز Mac هذا، وتتطلب إصدارًا من Gateway يتضمن هذه الصفحات."}},"it":{"stringUnit":{"state":"translated","value":"Le autorizzazioni, la chat rapida, le funzioni vocali e gli aggiornamenti si trovano in Dashboard → Impostazioni → Questo Mac e richiedono una versione del Gateway che includa queste pagine."}},"tr":{"stringUnit":{"state":"translated","value":"İzinler, Hızlı Sohbet, ses ve güncellemeler, Kontrol Paneli → Ayarlar → Bu Mac bölümünde bulunur ve bu sayfaları içeren bir Gateway sürümü gerektirir."}},"uk":{"stringUnit":{"state":"translated","value":"Дозволи, швидкий чат, голосові функції та оновлення доступні в розділі Панель керування → Налаштування → Цей Mac і потребують версії Gateway, що містить ці сторінки."}},"id":{"stringUnit":{"state":"translated","value":"Izin, Obrolan Cepat, suara, dan pembaruan tersedia di Dasbor → Pengaturan → Mac Ini dan memerlukan rilis Gateway yang menyertakan halaman-halaman tersebut."}},"pl":{"stringUnit":{"state":"translated","value":"Uprawnienia, szybki czat, głos i aktualizacje znajdują się w sekcji Panel → Ustawienia → Ten Mac i wymagają wersji Gateway zawierającej te strony."}},"th":{"stringUnit":{"state":"translated","value":"สิทธิ์อนุญาต แชตด่วน เสียง และการอัปเดตอยู่ใน แดชบอร์ด → การตั้งค่า → Mac เครื่องนี้ และต้องใช้ Gateway เวอร์ชันที่มีหน้าเหล่านั้น"}},"vi":{"stringUnit":{"state":"translated","value":"Quyền truy cập, trò chuyện nhanh, giọng nói và bản cập nhật nằm trong Bảng điều khiển → Cài đặt → Máy Mac này và cần phiên bản Gateway có các trang đó."}},"nl":{"stringUnit":{"state":"translated","value":"Machtigingen, Quick Chat, spraak en updates staan onder Dashboard → Instellingen → Deze Mac en vereisen een Gateway-versie die deze pagina's bevat."}},"fa":{"stringUnit":{"state":"translated","value":"مجوزها، گفت‌وگوی سریع، صدا و به‌روزرسانی‌ها در داشبورد → تنظیمات → این Mac قرار دارند و به نسخه‌ای از Gateway نیاز دارند که این صفحه‌ها را داشته باشد."}},"ru":{"stringUnit":{"state":"translated","value":"Разрешения, быстрый чат, голосовые функции и обновления находятся в разделе «Панель управления» → «Настройки» → «Этот Mac». Для доступа к ним нужна версия Gateway, в которой есть эти страницы."}},"sv":{"stringUnit":{"state":"translated","value":"Behörigheter, snabbchatt, röst och uppdateringar finns under Översiktspanel → Inställningar → Den här Mac-datorn och kräver en version av Gateway som innehåller dessa sidor."}}}},
    "Persistent Mac node service unavailable under app profile; runtime node remains available.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Persistent Mac node service unavailable under app profile; runtime node remains available."}},"zh-CN":{"stringUnit":{"state":"translated","value":"应用配置下无法使用持久化 Mac 节点服务; 运行时节点仍可用。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"應用程式設定檔下無法使用常駐 Mac 節點服務; 執行階段節點仍可使用。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O serviço persistente de nó do Mac não está disponível no perfil do app; o nó de execução permanece disponível."}},"de":{"stringUnit":{"state":"translated","value":"Der dauerhafte Mac-Knotendienst ist im App-Profil nicht verfügbar; der Laufzeitknoten bleibt verfügbar."}},"es":{"stringUnit":{"state":"translated","value":"El servicio de nodo persistente de Mac no está disponible en el perfil de la aplicación; el nodo en tiempo de ejecución sigue disponible."}},"ja-JP":{"stringUnit":{"state":"translated","value":"アプリプロファイルでは常駐Macノードサービスを利用できません; ランタイムノードは引き続き利用できます。"}},"ko":{"stringUnit":{"state":"translated","value":"앱 프로필에서는 상시 실행 Mac 노드 서비스를 사용할 수 없습니다; 런타임 노드는 계속 사용할 수 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le service de nœud Mac persistant est indisponible avec le profil de l’application ; le nœud d’exécution reste disponible."}},"hi":{"stringUnit":{"state":"translated","value":"ऐप प्रोफ़ाइल के अंतर्गत स्थायी Mac नोड सेवा उपलब्ध नहीं है; रनटाइम नोड उपलब्ध रहता है."}},"ar":{"stringUnit":{"state":"translated","value":"خدمة عقدة Mac الدائمة غير متاحة ضمن ملف تعريف التطبيق؛ تظل عقدة وقت التشغيل متاحة."}},"it":{"stringUnit":{"state":"translated","value":"Il servizio persistente del nodo Mac non è disponibile nel profilo dell’app; il nodo di runtime rimane disponibile."}},"tr":{"stringUnit":{"state":"translated","value":"Kalıcı Mac düğüm hizmeti uygulama profilinde kullanılamıyor; çalışma zamanı düğümü kullanılabilir durumda."}},"uk":{"stringUnit":{"state":"translated","value":"Постійна служба вузла Mac недоступна в профілі застосунку; вузол середовища виконання залишається доступним."}},"id":{"stringUnit":{"state":"translated","value":"Layanan node Mac persisten tidak tersedia dalam profil aplikasi; node runtime tetap tersedia."}},"pl":{"stringUnit":{"state":"translated","value":"Stała usługa węzła na Macu jest niedostępna w profilu aplikacji; węzeł środowiska uruchomieniowego pozostaje dostępny."}},"th":{"stringUnit":{"state":"translated","value":"บริการโหนด Mac แบบถาวรไม่พร้อมใช้งานภายใต้โปรไฟล์แอป; โหนดขณะรันยังคงพร้อมใช้งาน."}},"vi":{"stringUnit":{"state":"translated","value":"Dịch vụ nút Mac thường trực không khả dụng trong cấu hình ứng dụng; nút thời gian chạy vẫn khả dụng."}},"nl":{"stringUnit":{"state":"translated","value":"Permanente Mac-knooppuntservice niet beschikbaar onder het app-profiel; het runtime-knooppunt blijft beschikbaar."}},"fa":{"stringUnit":{"state":"translated","value":"سرویس پایدار گره Mac در نمایهٔ برنامه در دسترس نیست؛ گره زمان اجرا همچنان در دسترس است."}},"ru":{"stringUnit":{"state":"translated","value":"Постоянная служба узла Mac недоступна в профиле приложения; узел, работающий во время выполнения приложения, остаётся доступным."}},"sv":{"stringUnit":{"state":"translated","value":"Den beständiga Mac-nodtjänsten är inte tillgänglig i appens profil; körningsnoden är fortfarande tillgänglig."}}}},
    "Photo Library": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Photo Library"}},"zh-CN":{"stringUnit":{"state":"translated","value":"照片图库"}},"zh-TW":{"stringUnit":{"state":"translated","value":"照片圖庫"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Fototeca"}},"de":{"stringUnit":{"state":"translated","value":"Fotomediathek"}},"es":{"stringUnit":{"state":"translated","value":"Fototeca"}},"ja-JP":{"stringUnit":{"state":"translated","value":"写真ライブラリ"}},"ko":{"stringUnit":{"state":"translated","value":"사진 보관함"}},"fr":{"stringUnit":{"state":"translated","value":"Photothèque"}},"hi":{"stringUnit":{"state":"translated","value":"फ़ोटो लाइब्रेरी"}},"ar":{"stringUnit":{"state":"translated","value":"مكتبة الصور"}},"it":{"stringUnit":{"state":"translated","value":"Libreria foto"}},"tr":{"stringUnit":{"state":"translated","value":"Fotoğraf Arşivi"}},"uk":{"stringUnit":{"state":"translated","value":"Фототека"}},"id":{"stringUnit":{"state":"translated","value":"Perpustakaan Foto"}},"pl":{"stringUnit":{"state":"translated","value":"Biblioteka zdjęć"}},"th":{"stringUnit":{"state":"translated","value":"คลังรูปภาพ"}},"vi":{"stringUnit":{"state":"translated","value":"Thư viện ảnh"}},"nl":{"stringUnit":{"state":"translated","value":"Fotobibliotheek"}},"fa":{"stringUnit":{"state":"translated","value":"کتابخانهٔ عکس"}},"ru":{"stringUnit":{"state":"translated","value":"Медиатека"}},"sv":{"stringUnit":{"state":"translated","value":"Bildbibliotek"}}}},
    "Pick Local or Remote in the Connection window whenever you’re ready.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Pick Local or Remote in the Connection window whenever you’re ready."}},"zh-CN":{"stringUnit":{"state":"translated","value":"准备好后，随时可以在“连接”窗口中选择“本地”或“远程”。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"準備好時，請在「連線」視窗中選擇「本機」或「遠端」。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolha Local ou Remoto na janela Conexão quando quiser."}},"de":{"stringUnit":{"state":"translated","value":"Wählen Sie im Fenster „Verbindung“ die Option „Lokal“ oder „Remote“, sobald Sie bereit sind."}},"es":{"stringUnit":{"state":"translated","value":"Elige Local o Remoto en la ventana Conexión cuando quieras."}},"ja-JP":{"stringUnit":{"state":"translated","value":"準備ができたら、接続ウインドウでローカルまたはリモートを選択してください。"}},"ko":{"stringUnit":{"state":"translated","value":"준비가 되면 연결 창에서 로컬 또는 원격을 선택하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez Local ou Distant dans la fenêtre Connexion lorsque vous le souhaitez."}},"hi":{"stringUnit":{"state":"translated","value":"जब भी आप तैयार हों, कनेक्शन विंडो में स्थानीय या रिमोट चुनें।"}},"ar":{"stringUnit":{"state":"translated","value":"اختر «محلي» أو «عن بُعد» في نافذة الاتصال عندما تكون جاهزًا."}},"it":{"stringUnit":{"state":"translated","value":"Scegli Locale o Remoto nella finestra Connessione quando vuoi."}},"tr":{"stringUnit":{"state":"translated","value":"Hazır olduğunuzda Bağlantı penceresinde Yerel veya Uzak seçeneğini belirleyin."}},"uk":{"stringUnit":{"state":"translated","value":"Коли будете готові, виберіть «Локальне» або «Віддалене» у вікні «Підключення»."}},"id":{"stringUnit":{"state":"translated","value":"Pilih Lokal atau Jarak Jauh di jendela Koneksi kapan pun Anda siap."}},"pl":{"stringUnit":{"state":"translated","value":"W dowolnym momencie wybierz opcję Lokalne lub Zdalne w oknie Połączenie."}},"th":{"stringUnit":{"state":"translated","value":"เลือกในเครื่องหรือระยะไกล