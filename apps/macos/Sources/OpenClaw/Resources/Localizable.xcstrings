    "Detected, but not auto-tested": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Detected, but not auto-tested"}},"zh-CN":{"stringUnit":{"state":"translated","value":"已检测到，但未自动测试"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已偵測到，但尚未自動測試"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Detectado, mas não testado automaticamente"}},"de":{"stringUnit":{"state":"translated","value":"Erkannt, aber nicht automatisch getestet"}},"es":{"stringUnit":{"state":"translated","value":"Detectado, pero no probado automáticamente"}},"ja-JP":{"stringUnit":{"state":"translated","value":"検出済みですが、自動テストは未実施です"}},"ko":{"stringUnit":{"state":"translated","value":"감지되었지만 자동 테스트되지 않음"}},"fr":{"stringUnit":{"state":"translated","value":"Détecté, mais non testé automatiquement"}},"hi":{"stringUnit":{"state":"translated","value":"पता चला, लेकिन स्वचालित परीक्षण नहीं किया गया"}},"ar":{"stringUnit":{"state":"translated","value":"تم اكتشافه، لكن لم يُختبر تلقائيًا"}},"it":{"stringUnit":{"state":"translated","value":"Rilevato, ma non testato automaticamente"}},"tr":{"stringUnit":{"state":"translated","value":"Algılandı, ancak otomatik olarak test edilmedi"}},"uk":{"stringUnit":{"state":"translated","value":"Виявлено, але не перевірено автоматично"}},"id":{"stringUnit":{"state":"translated","value":"Terdeteksi, tetapi belum diuji otomatis"}},"pl":{"stringUnit":{"state":"translated","value":"Wykryto, ale nie przetestowano automatycznie"}},"th":{"stringUnit":{"state":"translated","value":"ตรวจพบแล้ว, แต่ยังไม่ได้ทดสอบอัตโนมัติ"}},"vi":{"stringUnit":{"state":"translated","value":"Đã phát hiện, nhưng chưa được kiểm tra tự động"}},"nl":{"stringUnit":{"state":"translated","value":"Gedetecteerd, maar niet automatisch getest"}},"fa":{"stringUnit":{"state":"translated","value":"شناسایی شده، اما به‌صورت خودکار آزمایش نشده است"}},"ru":{"stringUnit":{"state":"translated","value":"Обнаружено, но автоматическая проверка не выполнена"}},"sv":{"stringUnit":{"state":"transla