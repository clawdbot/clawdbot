    "Voice & Talk": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Voice & Talk"}},"zh-CN":{"stringUnit":{"state":"translated","value":"语音与对话"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語音與對話"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Voz e conversa"}},"de":{"stringUnit":{"state":"translated","value":"Sprache & Gespräch"}},"es":{"stringUnit":{"state":"translated","value":"Voz y conversación"}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声 & 会話"}},"ko":{"stringUnit":{"state":"translated","value":"음성 및 대화"}},"fr":{"stringUnit":{"state":"translated","value":"Voix & conversation"}},"hi":{"stringUnit":{"state":"translated","value":"आवाज़ और बातचीत"}},"ar":{"stringUnit":{"state":"translated","value":"الصوت والتحدث"}},"it":{"stringUnit":{"state":"translated","value":"Voce e conversazione"}},"tr":{"stringUnit":{"state":"translated","value":"Ses ve Konuşma"}},"uk":{"stringUnit":{"state":"translated","value":"Голос і розмова"}},"id":{"stringUnit":{"state":"translated","value":"Suara & Percakapan"}},"pl":{"stringUnit":{"state":"translated","value":"Głos i rozmowa"}},"th":{"stringUnit":{"state":"translated","value":"เสียงและการพูด"}},"vi":{"stringUnit":{"state":"translated","value":"Giọng nói & Trò chuyện"}},"nl":{"stringUnit":{"state":"translated","value":"Spraak & Gesprek"}},"fa":{"stringUnit":{"state":"translated","value":"صدا و گفتگو"}},"ru":{"stringUnit":{"state":"translated","value":"Голос и разговор"}},"sv":{"stringUnit":{"state":"translated","value":"Röst & samtal"}}}},
    "Voice Wake": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Voice Wake"}},"zh-CN":{"stringUnit":{"state":"translated","value":"语音唤醒"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語音喚醒"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ativação por Voz"}},"de":{"stringUnit":{"state":"translated","value":"Sprachaktivierung"}},"es":{"stringUnit":{"state":"translated","value":"Activación por voz"}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声起動"}},"ko":{"stringUnit":{"state":"translated","value":"음성 호출"}},"fr":{"stringUnit":{"state":"translated","value":"Activation vocale"}},"hi":{"stringUnit":{"state":"translated","value":"आवाज़ से सक्रियण"}},"ar":{"stringUnit":{"state":"translated","value":"تنبيه صوتي"}},"it":{"stringUnit":{"state":"translated","value":"Attivazione vocale"}},"tr":{"stringUnit":{"state":"translated","value":"Sesle Uyandırma"}},"uk":{"stringUnit":{"state":"translated","value":"Активація голосом"}},"id":{"stringUnit":{"state":"translated","value":"Aktivasi Suara"}},"pl":{"stringUnit":{"state":"translated","value":"Wybudzanie głosowe"}},"th":{"stringUnit":{"state":"translated","value":"การปลุกด้วยเสียง"}},"vi":{"stringUnit":{"state":"translated","value":"Đánh thức bằng giọng nói"}},"nl":{"stringUnit":{"state":"translated","value":"Spraakactivering"}},"fa":{"stringUnit":{"state":"translated","value":"بیدارباش صوتی"}},"ru":{"stringUnit":{"state":"translated","value":"Голосовая активация"}},"sv":{"stringUnit":{"state":"translated","value":"Röstaktivering"}}}},
    "Voice Wake needs on-device recognition for its selected language. Push-to-talk and Talk Mode remain available.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Voice Wake needs on-device recognition for its selected language. Push-to-talk and Talk Mode remain available."}},"zh-CN":{"stringUnit":{"state":"translated","value":"语音唤醒需要所选语言支持设备端识别。按住说话和对话模式仍然可用。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語音喚醒需要所選語言支援裝置端辨識。 按住說話和對話模式仍可使用。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A Ativação por Voz precisa de reconhecimento no dispositivo para o idioma selecionado. Pressionar para falar e o Modo de Conversa continuam disponíveis."}},"de":{"stringUnit":{"state":"translated","value":"Sprachaktivierung erfordert Spracherkennung auf dem Gerät für die ausgewählte Sprache. Push-to-Talk und Gesprächsmodus bleiben verfügbar."}},"es":{"stringUnit":{"state":"translated","value":"La activación por voz necesita reconocimiento en el dispositivo para el idioma seleccionado. Las funciones Pulsar para hablar y Modo de conversación siguen disponibles."}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声起動には、選択した言語のオンデバイス認識が必要です。プッシュツートークと会話モードは引き続き利用できます。"}},"ko":{"stringUnit":{"state":"translated","value":"음성 호출을 사용하려면 선택한 언어에 대한 온디바이스 음성 인식이 필요합니다. 눌러서 말하기와 대화 모드는 계속 사용할 수 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’activation vocale nécessite la reconnaissance sur l’appareil pour la langue sélectionnée. La fonction Appuyer pour parler et le mode conversation restent disponibles."}},"hi":{"stringUnit":{"state":"translated","value":"आवाज़ से सक्रियण के लिए चुनी गई भाषा की पहचान डिवाइस पर ही होनी चाहिए। दबाकर बोलने की सुविधा और बातचीत मोड उपलब्ध रहेंगे।"}},"ar":{"stringUnit":{"state":"translated","value":"يتطلب التنشيط بالصوت التعرف على الكلام على الجهاز للغة المحددة. يظل الضغط للتحدث ووضع التحدث متاحين."}},"it":{"stringUnit":{"state":"translated","value":"L’attivazione vocale richiede il riconoscimento sul dispositivo per la lingua selezionata. Premi per parlare e la modalità conversazione restano disponibili."}},"tr":{"stringUnit":{"state":"translated","value":"Sesle Uyandırma, seçili dil için cihaz üzerinde konuşma tanıma gerektirir. Bas-konuş ve Konuşma Modu kullanılabilir olmaya devam eder."}},"uk":{"stringUnit":{"state":"translated","value":"Для голосової активації потрібне розпізнавання на пристрої для вибраної мови. Режим розмови натисканням і режим розмови залишаються доступними."}},"id":{"stringUnit":{"state":"translated","value":"Aktivasi Suara memerlukan pengenalan di perangkat untuk bahasa yang dipilih. Tekan untuk bicara dan Mode Percakapan tetap tersedia."}},"pl":{"stringUnit":{"state":"translated","value":"Wybudzanie głosem wymaga rozpoznawania mowy na urządzeniu dla wybranego języka. Funkcja „Naciśnij i mów” oraz tryb rozmowy pozostają dostępne."}},"th":{"stringUnit":{"state":"translated","value":"การปลุกด้วยเสียงต้องใช้การรู้จำเสียงบนอุปกรณ์สำหรับภาษาที่เลือก โดยยังสามารถใช้การกดเพื่อพูดและโหมดพูดคุยได้"}},"vi":{"stringUnit":{"state":"translated","value":"Đánh thức bằng giọng nói cần tính năng nhận dạng trên thiết bị cho ngôn ngữ đã chọn. Nhấn để nói và Chế độ trò chuyện vẫn khả dụng."}},"nl":{"stringUnit":{"state":"translated","value":"Spraakactivering vereist spraakherkenning op het apparaat voor de geselecteerde taal. Indrukken om te praten en de gespreksmodus blijven beschikbaar."}},"fa":{"stringUnit":{"state":"translated","value":"بیدارباش صوتی برای زبان انتخاب‌شده به تشخیص گفتار روی دستگاه نیاز دارد. قابلیت فشار برای صحبت و حالت گفتگو همچنان در دسترس هستند."}},"ru":{"stringUnit":{"state":"translated","value":"Для голосовой активации требуется распознавание на устройстве для выбранного языка. Режимы разговора по нажатию и диалога остаются доступными."}},"sv":{"stringUnit":{"state":"translated","value":"Röstaktivering kräver taligenkänning på enheten för det valda språket. Tryck för att tala och samtalsläge är fortfarande tillgängliga."}}}},
    "Voice Wake requires macOS 26 or newer": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Voice Wake requires macOS 26 or newer"}},"zh-CN":{"stringUnit":{"state":"translated","value":"语音唤醒需要 macOS 26 或更新版本"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語音喚醒需要 macOS 26 或更新版本"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A Ativação por Voz requer macOS 26 ou posterior"}},"de":{"stringUnit":{"state":"translated","value":"Sprachaktivierung erfordert macOS 26 oder neuer"}},"es":{"stringUnit":{"state":"translated","value":"La activación por voz requiere macOS 26 o posterior"}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声起動には macOS 26 以降が必要です"}},"ko":{"stringUnit":{"state":"translated","value":"음성 호출을 사용하려면 macOS 26 이상이 필요합니다"}},"fr":{"stringUnit":{"state":"translated","value":"L’activation vocale nécessite macOS 26 ou une version ultérieure"}},"hi":{"stringUnit":{"state":"translated","value":"आवाज़ से सक्रियण के लिए macOS 26 या नया संस्करण आवश्यक है"}},"ar":{"stringUnit":{"state":"translated","value":"يتطلب التنشيط بالصوت macOS 26 أو أحدث"}},"it":{"stringUnit":{"state":"translated","value":"L’attivazione vocale richiede macOS 26 o versioni successive"}},"tr":{"stringUnit":{"state":"translated","value":"Sesle Uyandırma, macOS 26 veya daha yeni bir sürüm gerektirir"}},"uk":{"stringUnit":{"state":"translated","value":"Для голосової активації потрібна macOS 26 або новіша"}},"id":{"stringUnit":{"state":"translated","value":"Aktivasi Suara memerlukan macOS 26 atau yang lebih baru"}},"pl":{"stringUnit":{"state":"translated","value":"Wybudzanie głosem wymaga systemu macOS 26 lub nowszego"}},"th":{"stringUnit":{"state":"translated","value":"การปลุกด้วยเสียงต้องใช้ macOS 26 หรือใหม่กว่า"}},"vi":{"stringUnit":{"state":"translated","value":"Đánh thức bằng giọng nói yêu cầu macOS 26 trở lên"}},"nl":{"stringUnit":{"state":"translated","value":"Spraakactivering vereist macOS 26 of nieuwer"}},"fa":{"stringUnit":{"state":"translated","value":"بیدارباش صوتی به macOS 26 یا جدیدتر نیاز دارد"}},"ru":{"stringUnit":{"state":"translated","value":"Для голосовой активации требуется macOS 26 или новее"}},"sv":{"stringUnit":{"state":"translated","value":"Röstaktivering kräver macOS 26 eller senare"}}}},
    "Voice note": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Voice note"}},"zh-CN":{"stringUnit":{"state":"translated","value":"语音便笺"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語音訊息"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Mensagem de voz"}},"de":{"stringUnit":{"state":"translated","value":"Sprachnotiz"}},"es":{"stringUnit":{"state":"translated","value":"Nota de voz"}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声メモ"}},"ko":{"stringUnit":{"state":"translated","value":"음성 메모"}},"fr":{"stringUnit":{"state":"translated","value":"Note vocale"}},"hi":{"stringUnit":{"state":"translated","value":"वॉइस नोट"}},"ar":{"stringUnit":{"state":"translated","value":"ملاحظة صوتية"}},"it":{"stringUnit":{"state":"translated","value":"Nota vocale"}},"tr":{"stringUnit":{"state":"translated","value":"Sesli not"}},"uk":{"stringUnit":{"state":"translated","value":"Голосове повідомлення"}},"id":{"stringUnit":{"state":"translated","value":"Catatan suara"}},"pl":{"stringUnit":{"state":"translated","value":"Notatka głosowa"}},"th":{"stringUnit":{"state":"translated","value":"ข้อความเสียง"}},"vi":{"stringUnit":{"state":"translated","value":"Ghi chú thoại"}},"nl":{"stringUnit":{"state":"translated","value":"Spraaknotitie"}},"fa":{"stringUnit":{"state":"translated","value":"یادداشت صوتی"}},"ru":{"stringUnit":{"state":"translated","value":"Голосовая заметка"}},"sv":{"stringUnit":{"state":"translated","value":"Röstmeddelande"}}}},
    "Voice note exceeds the 5 MB attachment limit": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Voice note exceeds the 5 MB attachment limit"}},"zh-CN":{"stringUnit":{"state":"translated","value":"语音便笺超过 5 MB 附件大小限制"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語音訊息超過 5 MB 的附件大小限制"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A mensagem de voz excede o limite de 5 MB para anexos"}},"de":{"stringUnit":{"state":"translated","value":"Sprachnotiz überschreitet die Größenbeschränkung von 5 MB für Anhänge"}},"es":{"stringUnit":{"state":"translated","value":"La nota de voz supera el límite de 5 MB para archivos adjuntos"}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声メモが添付ファイルの上限 5 MB を超えています"}},"ko":{"stringUnit":{"state":"translated","value":"음성 메모가 첨부 파일 용량 제한인 5 MB를 초과합니다"}},"fr":{"stringUnit":{"state":"translated","value":"La note vocale dépasse la limite de 5 Mo pour les pièces jointes"}},"hi":{"stringUnit":{"state":"translated","value":"वॉइस नोट 5 MB की अटैचमेंट सीमा से बड़ा है"}},"ar":{"stringUnit":{"state":"translated","value":"تتجاوز الملاحظة الصوتية الحد الأقصى لحجم المرفقات البالغ 5 ميغابايت"}},"it":{"stringUnit":{"state":"translated","value":"La nota vocale supera il limite di 5 MB per gli allegati"}},"tr":{"stringUnit":{"state":"translated","value":"Sesli not, 5 MB ek sınırını aşıyor"}},"uk":{"stringUnit":{"state":"translated","value":"Голосова нотатка перевищує обмеження розміру вкладення в 5 МБ"}},"id":{"stringUnit":{"state":"translated","value":"Catatan suara melebihi batas lampiran 5 MB"}},"pl":{"stringUnit":{"state":"translated","value":"Notatka głosowa przekracza limit rozmiaru załącznika wynoszący 5 MB"}},"th":{"stringUnit":{"state":"translated","value":"ข้อความเสียงมีขนาดเกินขีดจำกัดไฟล์แนบ 5 MB"}},"vi":{"stringUnit":{"state":"translated","value":"Ghi chú thoại vượt quá giới hạn tệp đính kèm 5 MB"}},"nl":{"stringUnit":{"state":"translated","value":"Spraakbericht overschrijdt de bijlagelimiet van 5 