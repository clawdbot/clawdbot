    "Attach only (skip launchd install)": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Attach only (skip launchd install)"}},"zh-CN":{"stringUnit":{"state":"translated","value":"仅附加 (跳过 launchd 安装)"}},"zh-TW":{"stringUnit":{"state":"translated","value":"僅連接 (略過 launchd 安裝)"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Apenas conectar (ignorar instalação do launchd)"}},"de":{"stringUnit":{"state":"translated","value":"Nur verbinden (launchd-Installation überspringen)"}},"es":{"stringUnit":{"state":"translated","value":"Solo conectar (omitir instalación de launchd)"}},"ja-JP":{"stringUnit":{"state":"translated","value":"接続のみ (launchdのインストールをスキップ)"}},"ko":{"stringUnit":{"state":"translated","value":"연결만 (launchd 설치 건너뛰기)"}},"fr":{"stringUnit":{"state":"translated","value":"Se connecter uniquement (sans installer launchd)"}},"hi":{"stringUnit":{"state":"translated","value":"केवल अटैच करें (launchd इंस्टॉल छोड़ें)"}},"ar":{"stringUnit":{"state":"translated","value":"الاتصال فقط (تخطي تثبيت launchd)"}},"it":{"stringUnit":{"state":"translated","value":"Solo collegamento (salta l'installazione di launchd)"}},"tr":{"stringUnit":{"state":"translated","value":"Yalnızca bağlan (launchd kurulumunu atla)"}},"uk":{"stringUnit":{"state":"translated","value":"Лише підключитися (пропустити встановлення launchd)"}},"id":{"stringUnit":{"state":"translated","value":"Hubungkan saja (lewati instalasi launchd)"}},"pl":{"stringUnit":{"state":"translated","value":"Tylko podłącz (pomiń instalację launchd)"}},"th":{"stringUnit":{"state":"translated","value":"เชื่อมต่อเท่านั้น (ข้ามการติดตั้ง launchd)"}},"vi":{"stringUnit":{"state":"translated","value":"Chỉ gắn kết (bỏ qua cài đặt launchd)"}},"nl":{"stringUnit":{"state":"translated","value":"Alleen verbinden (installatie van launchd overslaan)"}},"fa":{"stringUnit":{"state":"translated","value":"فقط اتصال (صرف‌نظر از نصب launchd)"}},"ru":{"stringUnit":{"state":"translated","value":"Только подключиться (пропустит