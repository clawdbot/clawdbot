    "Saved Gateways": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Saved Gateways"}},"zh-CN":{"stringUnit":{"state":"translated","value":"已保存的 Gateways"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已儲存的 Gateways"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Gateways salvos"}},"de":{"stringUnit":{"state":"translated","value":"Gespeicherte Gateways"}},"es":{"stringUnit":{"state":"translated","value":"Gateways guardados"}},"ja-JP":{"stringUnit":{"state":"translated","value":"保存済みのGateways"}},"ko":{"stringUnit":{"state":"translated","value":"저장된 Gateway"}},"fr":{"stringUnit":{"state":"translated","value":"Gateways enregistrés"}},"hi":{"stringUnit":{"state":"translated","value":"सहेजे गए Gateways"}},"ar":{"stringUnit":{"state":"translated","value":"بوابات Gateway المحفوظة"}},"it":{"stringUnit":{"state":"translated","value":"Gateway salvati"}},"tr":{"stringUnit":{"state":"translated","value":"Kayıtlı Gateway'ler"}},"uk":{"stringUnit":{"state":"translated","value":"Збережені Gateway"}},"id":{"stringUnit":{"state":"translated","value":"Gateway Tersimpan"}},"pl":{"stringUnit":{"state":"translated","value":"Zapisane Gateway"}},"th":{"stringUnit":{"state":"translated","value":"Gateway ที่บันทึกไว้"}},"vi":{"stringUnit":{"state":"translated","value":"Gateway đã lưu"}},"nl":{"stringUnit":{"state":"translated","value":"Opgeslagen Gateways"}},"fa":{"stringUnit":{"state":"translated","value":"Gatewayهای ذخیره‌شده"}},"ru":{"stringUnit":{"state":"translated","value":"Сохранённые Gateways"}},"sv":{"stringUnit":{"state":"translated","value":"Sparade Gateways"}}}},
