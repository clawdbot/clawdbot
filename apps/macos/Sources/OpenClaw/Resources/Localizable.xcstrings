    "Voice & Talk": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Voice & Talk"}},"zh-CN":{"stringUnit":{"state":"translated","value":"语音与对话"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語音與對話"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Voz e conversa"}},"de":{"stringUnit":{"state":"translated","value":"Sprache & Sprechen"}},"es":{"stringUnit":{"state":"translated","value":"Voz y conversación"}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声とトーク"}},"ko":{"stringUnit":{"state":"translated","value":"음성 및 대화"}},"fr":{"stringUnit":{"state":"translated","value":"Voix et conversation"}},"hi":{"stringUnit":{"state":"translated","value":"वॉइस और टॉक"}},"ar":{"stringUnit":{"state":"translated","value":"الصوت والتحدث"}},"it":{"stringUnit":{"state":"translated","value":"Voce e conversazione"}},"tr":{"stringUnit":{"state":"translated","value":"Ses ve Konuşma"}},"uk":{"stringUnit":{"state":"translated","value":"Голос і розмова"}},"id":{"stringUnit":{"state":"translated","value":"Suara & Bicara"}},"pl":{"stringUnit":{"state":"translated","value":"Głos i rozmowa"}},"th":{"stringUnit":{"state":"translated","value":"เสียงและการพูด"}},"vi":{"stringUnit":{"state":"translated","value":"Giọng nói & Trò chuyện"}},"nl":{"stringUnit":{"state":"translated","value":"Spraak en praten"}},"fa":{"stringUnit":{"state":"translated","value":"صدا و صحبت"}},"ru":{"stringUnit":{"state":"translated","value":"Голос и разговор"}},"sv":{"stringUnit":{"state":"translated","value":"Röst och tal"}}}},
    "Voice Wake": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Voice Wake"}},"zh-CN":{"stringUnit":{"state":"translated","value":"语音唤醒"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語音喚醒"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ativação por voz"}},"de":{"stringUnit":{"state":"translated","value":"Sprachaktivierung"}},"es":{"stringUnit":{"state":"translated","value":"Activación por voz"}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声ウェイク"}},"ko":{"stringUnit":{"state":"translated","value":"음성 깨우기"}},"fr":{"stringUnit":{"state":"translated","value":"Réveil vocal"}},"hi":{"stringUnit":{"state":"translated","value":"वॉइस वेक"}},"ar":{"stringUnit":{"state":"translated","value":"تنبيه صوتي"}},"it":{"stringUnit":{"state":"translated","value":"Attivazione vocale"}},"tr":{"stringUnit":{"state":"translated","value":"Sesle Uyandırma"}},"uk":{"stringUnit":{"state":"translated","value":"Активація голосом"}},"id":{"stringUnit":{"state":"translated","value":"Bangun Suara"}},"pl":{"stringUnit":{"state":"translated","value":"Wybudzanie głosowe"}},"th":{"stringUnit":{"state":"translated","value":"ปลุกด้วยเสียง"}},"vi":{"stringUnit":{"state":"translated","value":"Đánh thức bằng giọng nói"}},"nl":{"stringUnit":{"state":"translated","value":"Spraakactivering"}},"fa":{"stringUnit":{"state":"translated","value":"بیدارباش صوتی"}},"ru":{"stringUnit":{"state":"translated","value":"Голосовая активация"}},"sv":{"stringUnit":{"state":"translated","value":"Röstväckning"}}}},
    "Voice Wake needs on-device recognition for its selected language. Push-to-talk and Talk Mode remain available.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Voice Wake needs on-device recognition for its selected language. Push-to-talk and Talk Mode remain available."}},"zh-CN":{"stringUnit":{"state":"translated","value":"语音唤醒需要为所选语言启用设备端识别。按键说话和对话模式仍然可用。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語音喚醒需要所選語言的裝置端辨識功能。按住通話和通話模式仍可使用。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Despertar por Voz precisa de reconhecimento no dispositivo para o idioma selecionado. Pressionar para falar e o Modo de Conversa continuam disponíveis."}},"de":{"stringUnit":{"state":"translated","value":"Voice Wake benötigt die geräteinterne Erkennung für die ausgewählte Sprache. Push-to-Talk und Talk-Modus bleiben verfügbar."}},"es":{"stringUnit":{"state":"translated","value":"Voice Wake necesita reconocimiento en el dispositivo para el idioma seleccionado. La función de pulsar para hablar y el modo de conversación siguen disponibles."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Voice Wakeには、選択した言語のオンデバイス認識が必要です。プッシュ・トゥ・トークとTalk Modeは引き続き利用できます。"}},"ko":{"stringUnit":{"state":"translated","value":"음성 깨우기는 선택한 언어에 대해 온디바이스 인식이 필요합니다. 푸시투토크와 대화 모드는 계속 사용할 수 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"L'activation vocale nécessite la reconnaissance sur l'appareil pour la langue sélectionnée. L'appui pour parler et le mode conversation restent disponibles."}},"hi":{"stringUnit":{"state":"translated","value":"Voice Wake को अपनी चयनित भाषा के लिए ऑन-डिवाइस पहचान की आवश्यकता है। Push-to-talk और Talk Mode उपलब्ध रहते हैं।"}},"ar":{"stringUnit":{"state":"translated","value":"يحتاج التنبيه الصوتي إلى التعرّف على الجهاز للغة المحددة. يبقى الضغط للتحدث ووضع التحدث متاحين."}},"it":{"stringUnit":{"state":"translated","value":"Voice Wake richiede il riconoscimento sul dispositivo per la lingua selezionata. Push-to-talk e Talk Mode restano disponibili."}},"tr":{"stringUnit":{"state":"translated","value":"Voice Wake, seçili dili için cihaz üzerinde tanıma gerektirir. Bas-konuş ve Konuşma Modu kullanılabilir olmaya devam eder."}},"uk":{"stringUnit":{"state":"translated","value":"Голосовому пробудженню потрібне розпізнавання на пристрої для вибраної мови. Функції push-to-talk та режим розмови залишаються доступними."}},"id":{"stringUnit":{"state":"translated","value":"Voice Wake memerlukan pengenalan pada perangkat untuk bahasa yang dipilih. Push-to-talk dan Talk Mode tetap tersedia."}},"pl":{"stringUnit":{"state":"translated","value":"Voice Wake wymaga rozpoznawania mowy na urządzeniu dla wybranego języka. Naciśnij i mów oraz Tryb rozmowy pozostają dostępne."}},"th":{"stringUnit":{"state":"translated","value":"Voice Wake ต้องใช้การจดจำบนอุปกรณ์สำหรับภาษาที่เลือก Push-to-talk และ Talk Mode ยังคงใช้งานได้"}},"vi":{"stringUnit":{"state":"translated","value":"Voice Wake cần nhận dạng trên thiết bị cho ngôn ngữ đã chọn. Push-to-talk và Talk Mode vẫn khả dụng."}},"nl":{"stringUnit":{"state":"translated","value":"Voice Wake heeft on-device herkenning nodig voor de geselecteerde taal. Push-to-talk en Talk Mode blijven beschikbaar."}},"fa":{"stringUnit":{"state":"translated","value":"بیداری صوتی برای زبان انتخاب‌شده‌اش به تشخیص روی دستگاه نیاز دارد. فشار برای صحبت و حالت گفت‌وگو همچنان در دسترس هستند."}},"ru":{"stringUnit":{"state":"translated","value":"Голосовая активация требует распознавания на устройстве для выбранного языка. Режимы «нажми и говори» и «Разговор» остаются доступными."}},"sv":{"stringUnit":{"state":"translated","value":"Röstväckning kräver igenkänning på enheten för det valda språket. Tryck-för-att-tala och samtalsläge är fortfarande tillgängliga."}}}},
    "Voice Wake requires macOS 26 or newer": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Voice Wake requires macOS 26 or newer"}},"zh-CN":{"stringUnit":{"state":"translated","value":"Voice Wake 需要 macOS 26 或更高版本"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Voice Wake 需要 macOS 26 或更新版本"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Voice Wake requer macOS 26 ou mais recente"}},"de":{"stringUnit":{"state":"translated","value":"Voice Wake erfordert macOS 26 oder neuer"}},"es":{"stringUnit":{"state":"translated","value":"Voice Wake requiere macOS 26 o posterior"}},"ja-JP":{"stringUnit":{"state":"translated","value":"Voice WakeにはmacOS 26以降が必要です"}},"ko":{"stringUnit":{"state":"translated","value":"Voice Wake에는 macOS 26 이상이 필요합니다"}},"fr":{"stringUnit":{"state":"translated","value":"Voice Wake nécessite macOS 26 ou une version plus récente"}},"hi":{"stringUnit":{"state":"translated","value":"Voice Wake के लिए macOS 26 या उससे नया आवश्यक है"}},"ar":{"stringUnit":{"state":"translated","value":"تتطلب ميزة Voice Wake نظام macOS 26 أو أحدث"}},"it":{"stringUnit":{"state":"translated","value":"Voice Wake richiede macOS 26 o versioni successive"}},"tr":{"stringUnit":{"state":"translated","value":"Voice Wake, macOS 26 veya daha yenisini gerektirir"}},"uk":{"stringUnit":{"state":"translated","value":"Voice Wake потребує macOS 26 або новішої версії"}},"id":{"stringUnit":{"state":"translated","value":"Voice Wake memerlukan macOS 26 atau yang lebih baru"}},"pl":{"stringUnit":{"state":"translated","value":"Voice Wake wymaga systemu macOS 26 lub nowszego"}},"th":{"stringUnit":{"state":"translated","value":"Voice Wake ต้องใช้ macOS 26 หรือใหม่กว่า"}},"vi":{"stringUnit":{"state":"translated","value":"Voice Wake yêu cầu macOS 26 trở lên"}},"nl":{"stringUnit":{"state":"translated","value":"Voice Wake vereist macOS 26 of nieuwer"}},"fa":{"stringUnit":{"state":"translated","value":"Voice Wake به macOS 26 یا جدیدتر نیاز دارد"}},"ru":{"stringUnit":{"state":"translated","value":"Voice Wake требует macOS 26 или новее"}},"sv":{"stringUnit":{"state":"translated","value":"Voice Wake kräver macOS 26 eller senare"}}}},
    "Voice note": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Voice note"}},"zh-CN":{"stringUnit":{"state":"translated","value":"语音消息"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語音留言"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Nota de voz"}},"de":{"stringUnit":{"state":"translated","value":"Sprachnachricht"}},"es":{"stringUnit":{"state":"translated","value":"Nota de voz"}},"ja-JP":{"stringUnit":{"state":"translated","value":"ボイスノート"}},"ko":{"stringUnit":{"state":"translated","value":"음성 메모"}},"fr":{"stringUnit":{"state":"translated","value":"Note vocale"}},"hi":{"stringUnit":{"state":"translated","value":"वॉइस नोट"}},"ar":{"stringUnit":{"state":"translated","value":"ملاحظة صوتية"}},"it":{"stringUnit":{"state":"translated","value":"Nota vocale"}},"tr":{"stringUnit":{"state":"translated","value":"Sesli not"}},"uk":{"stringUnit":{"state":"translated","value":"Голосове повідомлення"}},"id":{"stringUnit":{"state":"translated","value":"Catatan suara"}},"pl":{"stringUnit":{"state":"translated","value":"Notatka głosowa"}},"th":{"stringUnit":{"state":"translated","value":"ข้อความเสียง"}},"vi":{"stringUnit":{"state":"translated","value":"Ghi chú thoại"}},"nl":{"stringUnit":{"state":"translated","value":"Spraaknotitie"}},"fa":{"stringUnit":{"state":"translated","value":"یادداشت صوتی"}},"ru":{"stringUnit":{"state":"translated","value":"Голосовое сообщение"}},"sv":{"stringUnit":{"state":"translated","value":"Röstmeddelande"}}}},
    "Voice note exceeds the 5 MB attachment limit": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Voice note exceeds the 5 MB attachment limit"}},"zh-CN":{"stringUnit":{"state":"translated","value":"语音留言超过 5 MB 的附件限制"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語音留言超過 5 MB 附件上限"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A nota de voz excede o limite de anexo de 5 MB"}},"de":{"stringUnit":{"state":"translated","value":"Sprachnotiz überschreitet das Anhangslimit von 5 MB"}},"es":{"stringUnit":{"state":"translated","value":"La nota de voz supera el límite de adjuntos de 5 MB"}},"ja-JP":{"stringUnit":{"state":"translated","value":"ボイスメモが添付ファイルの上限5MBを超えています"}},"ko":{"stringUnit":{"state":"translated","value":"음성 메모가 5MB 첨부 제한을 초과합니다"}},"fr":{"stringUnit":{"state":"translated","value":"La note vocale dépasse la limite de pièce jointe de 5 Mo"}},"hi":{"stringUnit":{"state":"translated","value":"वॉइस नोट 5 MB की अटैचमेंट सीमा से अधिक है"}},"ar":{"stringUnit":{"state":"translated","value":"تتجاوز الملاحظة الصوتية حد المرفقات البالغ 5 ميغابايت"}},"it":{"stringUnit":{"state":"translated","value":"La nota vocale supera il limite di 5 MB per gli allegati"}},"tr":{"stringUnit":{"state":"translated","value":"Sesli not 5 MB ek boyut sınırını aşıyor"}},"uk":{"stringUnit":{"state":"translated","value":"Голосова нотатка перевищує ліміт вкладення 5 МБ"}},"id":{"stringUnit":{"state":"translated","value":"Catatan suara melebihi batas lampiran 5 MB"}},"pl":{"stringUnit":{"state":"translated","value":"Notatka głosowa przekracza limit załącznika wynoszący 5 MB"}},"th":{"stringUnit":{"state":"translated","value":"ข้อความเสียงเกินขีดจำกัดไฟล์แนบ 5 MB"}},"vi":{"stringUnit":{"state":"translated","value":"Ghi chú thoại vượt quá giới hạn đính kèm 5 MB"}},"nl":{"stringUnit":{"state":"translated","value":"Spraaknotitie overschrijdt de bijlagelimiet van 5 MB"}},"fa":{"stringUnit":{"state":"translated","value":"یادداشت صوتی از محدودیت پیوست ۵ مگابایت فرات