    "Peek at the stored conversation buckets the CLI reuses for context and rate limits.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Peek at the stored conversation buckets the CLI reuses for context and rate limits."}},"zh-CN":{"stringUnit":{"state":"translated","value":"查看 CLI 为上下文和速率限制而复用的已存储会话分组。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"查看 CLI 為上下文與速率限制而重複使用的已儲存對話分組。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Confira os agrupamentos de conversas armazenados que a CLI reutiliza para contexto e limites de requisições."}},"de":{"stringUnit":{"state":"translated","value":"Sieh dir die gespeicherten Konversationsgruppen an, die die CLI für Kontext und Ratenbegrenzungen wiederverwendet."}},"es":{"stringUnit":{"state":"translated","value":"Consulta los grupos de conversaciones almacenados que la CLI reutiliza para el contexto y los límites de frecuencia."}},"ja-JP":{"stringUnit":{"state":"translated","value":"CLIがコンテキストとレート制限のために再利用する、保存済みの会話バケットを確認します。"}},"ko":{"stringUnit":{"state":"translated","value":"CLI가 컨텍스트와 요청 속도 제한에 재사용하는 저장된 대화 버킷을 살펴보세요."}},"fr":{"stringUnit":{"state":"translated","value":"Consultez les groupes de conversations enregistrés que la CLI réutilise pour le contexte et les limites de débit."}},"hi":{"stringUnit":{"state":"translated","value":"संग्रहीत बातचीत बकेट देखें जिन्हें CLI संदर्भ और दर सीमाओं के लिए दोबारा इस्तेमाल करता है."}},"ar":{"stringUnit":{"state":"translated","value":"اطّلع على مجموعات المحادثات المخزّنة التي تعيد واجهة سطر الأوامر استخدامها للسياق وحدود المعدل."}},"it":{"stringUnit":{"state":"translated","value":"Esamina i raggruppamenti di conversazioni archiviati che la CLI riutilizza per il contesto e i limiti di frequenza."}},"tr":{"stringUnit":{"state":"translated","value":"CLI'nin bağlam ve hız sınırları için yeniden kullandığı kayıtlı konuşma gruplarına göz atın."}},"uk":{"stringUnit":{"state":"translated","value":"Перегляньте збережені групи розмов, які CLI повторно використовує для контексту та обмеження частоти запитів."}},"id":{"stringUnit":{"state":"translated","value":"Lihat kumpulan percakapan tersimpan yang digunakan kembali oleh CLI untuk konteks dan batas laju."}},"pl":{"stringUnit":{"state":"translated","value":"Przejrzyj zapisane zbiory rozmów, które CLI wykorzystuje ponownie do obsługi kontekstu i limitów częstotliwości."}},"th":{"stringUnit":{"state":"translated","value":"ดูชุดการสนทนาที่จัดเก็บไว้ซึ่ง CLI นำกลับมาใช้สำหรับบริบทและการจำกัดอัตราการใช้งาน."}},"vi":{"stringUnit":{"state":"translated","value":"Xem nhanh các nhóm hội thoại đã lưu mà CLI tái sử dụng cho ngữ cảnh và giới hạn tần suất."}},"nl":{"stringUnit":{"state":"translated","value":"Bekijk de opgeslagen gespreksgroepen die de CLI hergebruikt voor context en frequentielimieten."}},"fa":{"stringUnit":{"state":"translated","value":"نگاهی به دسته‌های ذخیره‌شدهٔ گفت‌وگو بیندازید که CLI برای زمینه و محدودیت‌های نرخ دوباره استفاده می‌کند."}},"ru":{"stringUnit":{"state":"translated","value":"Просмотрите сохранённые группы бесед, которые CLI повторно использует для контекста и ограничения частоты запросов."}},"sv":{"stringUnit":{"state":"translated","value":"Ta en titt på de lagrade konversationsgrupperna som CLI återanvänder för kontext och anropsgränser."}}}},
