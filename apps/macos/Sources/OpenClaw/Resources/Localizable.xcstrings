    "Session capability controls require a newer Gateway.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Session capability controls require a newer Gateway."}},"zh-CN":{"stringUnit":{"state":"translated","value":"会话能力控制需要更新版本的 Gateway。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"工作階段能力控制需要較新版本的 Gateway。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Os controles de recursos da sessão exigem um Gateway mais recente."}},"de":{"stringUnit":{"state":"translated","value":"Die Steuerung der Sitzungsfunktionen erfordert einen neueren Gateway."}},"es":{"stringUnit":{"state":"translated","value":"Los controles de capacidades de la sesión requieren una versión más reciente de Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"セッションの機能を制御するには、より新しいGatewayが必要です。"}},"ko":{"stringUnit":{"state":"translated","value":"세션 기능 제어에는 최신 버전의 Gateway가 필요합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les contrôles des capacités de la session nécessitent une version plus récente de Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"सत्र की क्षमता संबंधी नियंत्रणों के लिए Gateway का नया संस्करण आवश्यक है."}},"ar":{"stringUnit":{"state":"translated","value":"تتطلب عناصر التحكم في إمكانات الجلسة إصدارًا أحدث من Gateway."}},"it":{"stringUnit":{"state":"translated","value":"I controlli delle funzionalità della sessione richiedono un Gateway più recente."}},"tr":{"stringUnit":{"state":"translated","value":"Oturum yetenek denetimleri için daha yeni bir Gateway gerekir."}},"uk":{"stringUnit":{"state":"translated","value":"Для керування можливостями сеансу потрібна новіша версія Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Kontrol kapabilitas sesi memerlukan Gateway yang lebih baru."}},"pl":{"stringUnit":{"state":"translated","value":"Zarządzanie możliwościami sesji wymaga nowszej wersji Gateway."}},"th":{"stringUnit":{"state":"translated","value":"การควบคุมความสามารถของเซสชันต้องใช้ Gateway เวอร์ชันใหม