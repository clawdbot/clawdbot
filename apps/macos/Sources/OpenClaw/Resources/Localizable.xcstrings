    "Disconnected from your remote Gateway. Open Connection settings to fix it.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Disconnected from your remote Gateway. Open Connection settings to fix it."}},"zh-CN":{"stringUnit":{"state":"translated","value":"已与你的远程 Gateway 断开连接。打开连接设置进行修复。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已與您的遠端 Gateway 中斷連線。開啟連線設定以修復。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Desconectado do seu Gateway remoto. Abra as configurações de Conexão para corrigir."}},"de":{"stringUnit":{"state":"translated","value":"Verbindung zu deinem Remote-Gateway getrennt. Öffne die Verbindungseinstellungen, um das Problem zu beheben."}},"es":{"stringUnit":{"state":"translated","value":"Desconectado de tu Gateway remoto. Abre los ajustes de Conexión para solucionarlo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"リモート Gateway から切断されました。接続設定を開いて修正してください。"}},"ko":{"stringUnit":{"state":"translated","value":"원격 Gateway와의 연결이 끊겼습니다. 연결 설정을 열어 문제를 해결하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Déconnecté de votre Gateway distant. Ouvrez les réglages de connexion pour corriger le problème."}},"hi":{"stringUnit":{"state":"translated","value":"आपके remote Gateway से डिस्कनेक्ट हो गया। इसे ठीक करने के लिए Connection settings खोलें।"}},"ar":{"stringUnit":{"state":"translated","value":"انقطع الاتصال بالـ Gateway البعيد الخاص بك. افتح إعدادات الاتصال لإصلاح ذلك."}},"it":{"stringUnit":{"state":"translated","value":"Disconnesso dal Gateway remoto. Apri le impostazioni di Connessione per risolvere il problema."}},"tr":{"stringUnit":{"state":"translated","value":"Uzak Gateway'inizle bağlantı kesildi. Düzeltmek için Bağlantı ayarlarını açın."}},"uk":{"stringUnit":{"state":"translated","value":"Відключено від вашого віддаленого Gateway. Відкрийте налаштування підключення, щоб виправити це."}},"id":{"stringUnit":{"state":"translated","value":"Terputus dari Gateway jarak jauh Anda. Buka pengaturan Koneksi untuk memperbaikinya."}},"pl":{"stringUnit":{"state":"translated","value":"Rozłączono ze zdalnym Gateway. Otwórz ustawienia połączenia, aby to naprawić."}},"th":{"stringUnit":{"state":"translated","value":"ตัดการเชื่อมต่อจาก Gateway ระยะไกลของคุณแล้ว เปิดการตั้งค่าการเชื่อมต่อเพื่อแก้ไข"}},"vi":{"stringUnit":{"state":"translated","value":"Đã ngắt kết nối khỏi Gateway từ xa của bạn. Mở cài đặt Kết nối để khắc phục."}},"nl":{"stringUnit":{"state":"translated","value":"Verbinding met je externe Gateway verbroken. Open de verbindingsinstellingen om dit op te lossen."}},"fa":{"stringUnit":{"state":"translated","value":"اتصال به Gateway راه دور شما قطع شد. برای رفع آن تنظیمات اتصال را باز کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Отключено от вашего удалённого Gateway. Откройте настройки подключения, чтобы исправить это."}},"sv":{"stringUnit":{"state":"translated","value":"Frånkopplad från din fjärr-Gateway. Öppna anslutningsinställningarna för att åtgärda det."}}}},
