    "Gateway work is paused; incoming messages will wait.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Gateway work is paused; incoming messages will wait."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Gateway 工作已暂停；收到的消息将等待处理。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 工作已暫停；傳入的訊息將會等待。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O trabalho do Gateway está pausado; as mensagens recebidas aguardarão."}},"de":{"stringUnit":{"state":"translated","value":"Die Gateway-Verarbeitung ist pausiert; eingehende Nachrichten warten."}},"es":{"stringUnit":{"state":"translated","value":"El trabajo del Gateway está en pausa; los mensajes entrantes esperarán."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gateway の処理が一時停止しています。受信メッセージは待機します。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway 작업이 일시 중지되었습니다. 수신 메시지는 대기합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le travail du Gateway est en pause ; les messages entrants attendront."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway का काम रोका गया है; आने वाले संदेश प्रतीक्षा करेंगे।"}},"ar":{"stringUnit":{"state":"translated","value":"عمل الـ Gateway متوقف مؤقتًا؛ ستنتظر الرسائل الواردة."}},"it":{"stringUnit":{"state":"translated","value":"Il lavoro del Gateway è in pausa; i messaggi in arrivo attenderanno."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway işi duraklatıldı; gelen mesajlar bekleyecek."}},"uk":{"stringUnit":{"state":"translated","value":"Робота Gateway призупинена; вхідні повідомлення чекатимуть."}},"id":{"stringUnit":{"state":"translated","value":"Pekerjaan Gateway dijeda; pesan masuk akan menunggu."}},"pl":{"stringUnit":{"state":"translated","value":"Praca Gateway jest wstrzymana; przychodzące wiadomości będą oczekiwać."}},"th":{"stringUnit":{"state":"translated","value":"งานของ Gateway ถูกหยุดชั่วคราว ข้อความที่เข้ามาจะรอไว้"}},"vi":{"stringUnit":{"state":"translated","value":"Công việc của Gatew