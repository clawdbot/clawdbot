    "Global shortcut that opens a floating chat bar for the main thread.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Global shortcut that opens a floating chat bar for the main thread."}},"zh-CN":{"stringUnit":{"state":"translated","value":"用于打开主话题串浮动聊天栏的全局快捷键。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"開啟主要討論串浮動聊天列的全域快捷鍵。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Atalho global que abre uma barra de chat flutuante para a conversa principal."}},"de":{"stringUnit":{"state":"translated","value":"Globales Tastenkürzel, das eine schwebende Chatleiste für den Haupt-Thread öffnet."}},"es":{"stringUnit":{"state":"translated","value":"Atajo global que abre una barra de chat flotante para el hilo principal."}},"ja-JP":{"stringUnit":{"state":"translated","value":"メインスレッド用のフローティングチャットバーを開くグローバルショートカットです。"}},"ko":{"stringUnit":{"state":"translated","value":"메인 스레드의 플로팅 채팅 바를 여는 전역 단축키입니다."}},"fr":{"stringUnit":{"state":"translated","value":"Raccourci global qui ouvre une barre de chat flottante pour le fil de discussion principal."}},"hi":{"stringUnit":{"state":"translated","value":"मुख्य थ्रेड के लिए फ़्लोटिंग चैट बार खोलने वाला ग्लोबल शॉर्टकट।"}},"ar":{"stringUnit":{"state":"translated","value":"اختصار عام يفتح شريط دردشة عائمًا للمحادثة الرئيسية."}},"it":{"stringUnit":{"state":"translated","value":"Scorciatoia globale che apre una barra di chat mobile per il thread principale."}},"tr":{"stringUnit":{"state":"translated","value":"Ana dizi için yüzen bir sohbet çubuğu açan genel kısayol."}},"uk":{"stringUnit":{"state":"translated","value":"Глобальне сполучення клавіш, яке відкриває плавучу панель чату для основної гілки."}},"id":{"stringUnit":{"state":"translated","value":"Pintasan global yang membuka bilah chat mengambang untuk utas utama."}},"pl":{"stringUnit":{"state":"translated","value":"Globalny skrót otwierający pływający pasek czatu dla głównego wątku."}},"th":{"stringUnit":{"state":"translated","value":"ปุ่มลัดส่วนกล