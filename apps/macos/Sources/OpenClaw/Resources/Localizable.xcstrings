    "Latest presence beacons from OpenClaw nodes. Updated periodically.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Latest presence beacons from OpenClaw nodes. Updated periodically."}},"zh-CN":{"stringUnit":{"state":"translated","value":"来自 OpenClaw 节点的最新在线状态信标。定期更新。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"來自 OpenClaw 節點的最新上線狀態信標。 定期更新。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Sinais de presença mais recentes dos nós do OpenClaw. Atualizados periodicamente."}},"de":{"stringUnit":{"state":"translated","value":"Neueste Präsenzsignale von OpenClaw-Knoten. Wird regelmäßig aktualisiert."}},"es":{"stringUnit":{"state":"translated","value":"Últimas señales de presencia de los nodos de OpenClaw. Se actualizan periódicamente."}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClaw ノードからの最新のプレゼンスビーコン。定期的に更新されます。"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw 노드의 최신 접속 상태 신호입니다. 주기적으로 업데이트됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Dernières balises de présence des nœuds OpenClaw. Actualisées régulièrement."}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw नोड से नवीनतम उपस्थिति संकेत। समय-समय पर अपडेट किए जाते हैं।"}},"ar":{"stringUnit":{"state":"translated","value":"أحدث إشارات التواجد من عُقد OpenClaw. تُحدَّث دوريًا."}},"it":{"stringUnit":{"state":"translated","value":"Ultimi segnali di presenza dai nodi OpenClaw. Aggiornati periodicamente."}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw düğümlerinden gelen en son varlık sinyalleri. Düzenli aralıklarla güncellenir."}},"uk":{"stringUnit":{"state":"translated","value":"Останні сигнали присутності від вузлів OpenClaw. Оновлюються періодично."}},"id":{"stringUnit":{"state":"translated","value":"Sinyal kehadiran terbaru dari simpul OpenClaw. Diperbarui secara berkala."}},"pl":{"stringUnit":{"state":"translated","value":"Najnowsze sygnały obecności z węzłów OpenClaw. Aktualizowane okresowo."}},"th":{"stringUn