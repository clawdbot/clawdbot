    "Local (this Mac)": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Local (this Mac)"}},"zh-CN":{"stringUnit":{"state":"translated","value":"本地 (此 Mac)"}},"zh-TW":{"stringUnit":{"state":"translated","value":"本機 (這部 Mac)"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Local (este Mac)"}},"de":{"stringUnit":{"state":"translated","value":"Lokal (dieser Mac)"}},"es":{"stringUnit":{"state":"translated","value":"Local (este Mac)"}},"ja-JP":{"stringUnit":{"state":"translated","value":"ローカル (このMac)"}},"ko":{"stringUnit":{"state":"translated","value":"로컬 (이 Mac)"}},"fr":{"stringUnit":{"state":"translated","value":"Local (ce Mac)"}},"hi":{"stringUnit":{"state":"translated","value":"स्थानीय (यह Mac)"}},"ar":{"stringUnit":{"state":"translated","value":"محلي (جهاز Mac هذا)"}},"it":{"stringUnit":{"state":"translated","value":"Locale (questo Mac)"}},"tr":{"stringUnit":{"state":"translated","value":"Yerel (bu Mac)"}},"uk":{"stringUnit":{"state":"translated","value":"Локальний (цей Mac)"}},"id":{"stringUnit":{"state":"translated","value":"Lokal (Mac ini)"}},"pl":{"stringUnit":{"state":"translated","value":"Lokalnie (ten Mac)"}},"th":{"stringUnit":{"state":"translated","value":"ในเครื่อง (Mac เครื่องนี้)"}},"vi":{"stringUnit":{"state":"translated","value":"Cục bộ (máy Mac này)"}},"nl":{"stringUnit":{"state":"translated","value":"Lokaal (deze Mac)"}},"fa":{"stringUnit":{"state":"translated","value":"محلی (این Mac)"}},"ru":{"stringUnit":{"state":"translated","value":"Локальный (этот Mac)"}},"sv":{"stringUnit":{"state":"translated","value":"Lokal (denna Mac)"}}}},
    "Local Gateway": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Local Gateway"}},"zh-CN":{"stringUnit":{"state":"translated","value":"本地 Gateway"}},"zh-TW":{"stringUnit":{"state":"translated","value":"本機 Gateway"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Gateway local"}},"de":{"stringUnit":{"state":"translated","value":"Lokaler Gateway"}},"es":{"stringUnit":{"state":"translated","value":"Gateway local"}},"ja-JP":{"stringUnit":{"state":"translated","value":"ローカルGateway"}},"ko":{"stringUnit":{"state":"translated","value":"로컬 Gateway"}},"fr":{"stringUnit":{"state":"translated","value":"Gateway local"}},"hi":{"stringUnit":{"state":"translated","value":"स्थानीय Gateway"}},"ar":{"stringUnit":{"state":"translated","value":"Gateway محلي"}},"it":{"stringUnit":{"state":"translated","value":"Gateway locale"}},"tr":{"stringUnit":{"state":"translated","value":"Yerel Gateway"}},"uk":{"stringUnit":{"state":"translated","value":"Локальний Gateway"}},"id":{"stringUnit":{"state":"translated","value":"Gateway Lokal"}},"pl":{"stringUnit":{"state":"translated","value":"Lokalny Gateway"}},"th":{"stringUnit":{"state":"translated","value":"Gateway ในเครื่อง"}},"vi":{"stringUnit":{"state":"translated","value":"Gateway cục bộ"}},"nl":{"stringUnit":{"state":"translated","value":"Lokale Gateway"}},"fa":{"stringUnit":{"state":"translated","value":"Gateway محلی"}},"ru":{"stringUnit":{"state":"translated","value":"Локальный Gateway"}},"sv":{"stringUnit":{"state":"translated","value":"Lokal Gateway"}}}},
    "Local automation clients can use the Peekaboo bridge to capture your screen and control apps on this Mac using OpenClaw's macOS permissions.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Local automation clients can use the Peekaboo bridge to capture your screen and control apps on this Mac using OpenClaw's macOS permissions."}},"zh-CN":{"stringUnit":{"state":"translated","value":"本地自动化客户端可以通过 Peekaboo 桥接，使用 OpenClaw 的 macOS 权限截取屏幕并控制这台 Mac 上的应用。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"本機自動化用戶端可透過 Peekaboo 橋接器，使用 OpenClaw 的 macOS 權限擷取螢幕畫面並控制這部 Mac 上的 App。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Clientes de automação local podem usar a ponte Peekaboo para capturar sua tela e controlar apps neste Mac usando as permissões do OpenClaw no macOS."}},"de":{"stringUnit":{"state":"translated","value":"Lokale Automatisierungsclients können die Peekaboo-Bridge verwenden, um mit den macOS-Berechtigungen von OpenClaw Ihren Bildschirm aufzunehmen und Apps auf diesem Mac zu steuern."}},"es":{"stringUnit":{"state":"translated","value":"Los clientes de automatización local pueden usar el puente de Peekaboo para capturar la pantalla y controlar apps en este Mac con los permisos de macOS de OpenClaw."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ローカルの自動化クライアントは、Peekabooブリッジを通じてOpenClawのmacOS権限を使用し、このMacの画面をキャプチャしたり、アプリを操作したりできます。"}},"ko":{"stringUnit":{"state":"translated","value":"로컬 자동화 클라이언트는 Peekaboo 브리지를 통해 OpenClaw의 macOS 권한을 사용하여 이 Mac의 화면을 캡처하고 앱을 제어할 수 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les clients d’automatisation locaux peuvent utiliser le pont Peekaboo pour capturer votre écran et contrôler les apps sur ce Mac à l’aide des autorisations macOS d’OpenClaw."}},"hi":{"stringUnit":{"state":"translated","value":"स्थानीय ऑटोमेशन क्लाइंट, OpenClaw की macOS अनुमतियों का उपयोग करके इस Mac की स्क्रीन कैप्चर करने और ऐप्स को नियंत्रित करने के लिए Peekaboo ब्रिज का उपयोग कर सकते हैं।"}},"ar":{"stringUnit":{"state":"translated","value":"يمكن لعملاء الأتمتة المحليين استخدام جسر Peekaboo لالتقاط شاشتك والتحكم في التطبيقات على جهاز Mac هذا باستخدام أذونات macOS الممنوحة لـ OpenClaw."}},"it":{"stringUnit":{"state":"translated","value":"I client di automazione locali possono usare il bridge Peekaboo per acquisire lo schermo e controllare le app su questo Mac usando le autorizzazioni macOS di OpenClaw."}},"tr":{"stringUnit":{"state":"translated","value":"Yerel otomasyon istemcileri, OpenClaw'ın macOS izinlerini kullanarak bu Mac'in ekranını yakalamak ve uygulamaları kontrol etmek için Peekaboo köprüsünü kullanabilir."}},"uk":{"stringUnit":{"state":"translated","value":"Локальні клієнти автоматизації можуть використовувати міст Peekaboo для захоплення екрана та керування програмами на цьому Mac, використовуючи дозволи macOS, надані OpenClaw."}},"id":{"stringUnit":{"state":"translated","value":"Klien otomatisasi lokal dapat menggunakan bridge Peekaboo untuk menangkap layar Anda dan mengontrol aplikasi di Mac ini menggunakan izin macOS milik OpenClaw."}},"pl":{"stringUnit":{"state":"translated","value":"Lokalne klienty automatyzacji mogą używać mostu Peekaboo do przechwytywania ekranu i sterowania aplikacjami na tym Macu, korzystając z uprawnień macOS przyznanych OpenClaw."}},"th":{"stringUnit":{"state":"translated","value":"ไคลเอนต์ระบบอัตโนมัติในเครื่องสามารถใช้บริดจ์ Peekaboo เพื่อจับภาพหน้าจอและควบคุมแอปบน Mac เครื่องนี้ โดยใช้สิทธิ์ macOS ของ OpenClaw"}},"vi":{"stringUnit":{"state":"translated","value":"Các ứng dụng tự động hóa cục bộ có thể dùng cầu nối Peekaboo để chụp màn hình và điều khiển ứng dụng trên máy Mac này bằng các quyền macOS đã cấp cho OpenClaw."}},"nl":{"stringUnit":{"state":"translated","value":"Lokale automatiseringsclients kunnen de Peekaboo-bridge gebruiken om schermopnamen te maken en apps op deze Mac te bedienen met de macOS-machtigingen van OpenClaw."}},"fa":{"stringUnit":{"state":"translated","value":"کلاینت‌های اتوماسیون محلی می‌توانند با استفاده از پل Peekaboo و مجوزهای macOS متعلق به OpenClaw، از صفحه‌نمایش شما تصویر بگیرند و برنامه‌های این Mac را کنترل کنند."}},"ru":{"stringUnit":{"state":"translated","value":"Локальные клиенты автоматизации могут использовать мост Peekaboo для захвата экрана и управления приложениями на этом Mac с помощью разрешений macOS, предоставленных OpenClaw."}},"sv":{"stringUnit":{"state":"translated","value":"Lokala automationsklienter kan använda Peekaboo-bryggan för att ta skärmbilder och styra appar på den här Mac-datorn med OpenClaws macOS-behörigheter."}}}},
    "Local is best for this Mac. Remote is best when the Gateway already runs on a Mac Studio or server.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Local is best for this Mac. Remote is best when the Gateway already runs on a Mac Studio or server."}},"zh-CN":{"stringUnit":{"state":"translated","value":"本地模式最适合此 Mac. 如果 Gateway 已在 Mac Studio 或服务器上运行，则远程模式最合适。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"本機模式最適合這部 Mac. 若 Gateway 已在 Mac Studio 或伺服器上執行，則遠端模式最適合。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O modo local é ideal para este Mac. O modo remoto é ideal quando o Gateway já está em execução em um Mac Studio ou servidor."}},"de":{"stringUnit":{"state":"translated","value":"Lokal eignet sich am besten für diesen Mac. Remote eignet sich am besten, wenn der Gateway bereits auf einem Mac Studio oder Server läuft."}},"es":{"stringUnit":{"state":"translated","value":"El modo local es la mejor opción para este Mac. El modo remoto es la mejor opción cuando el Gateway ya se ejecuta en un Mac Studio o en un servidor."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このMacにはローカルが最適です。 GatewayがすでにMac Studioやサーバーで稼働している場合はリモートが最適です。"}},"ko":{"stringUnit":{"state":"translated","value":"이 Mac에서는 로컬 모드가 가장 적합합니다. Gateway가 이미 Mac Studio나 서버에서 실행 중인 경우 원격 모드가 가장 적합합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le mode local est recommandé pour ce Mac. Le mode distant est recommandé lorsque le Gateway fonctionne déjà sur un Mac Studio ou un serveur."}},"hi":{"stringUnit":{"state":"translated","value":"इस Mac के लिए स्थानीय मोड सबसे अच्छा है. जब Gateway पहले से किसी Mac Studio या सर्वर पर चल रहा हो, तो रिमोट मोड सबसे अच्छा है."}},"ar":{"stringUnit":{"state":"translated","value":"الوضع المحلي هو الأنسب لجهاز Mac هذا. والوضع البعيد هو الأنسب عندما يكون Gateway قيد التشغيل بالفعل على جهاز Mac Studio أو خادم."}},"it":{"stringUnit":{"state":"translated","value":"La modalità locale è ideale per questo Mac. La modalità remota è ideale quando il Gateway è già in esecuzione su un Mac Studio o un server."}},"tr":{"stringUnit":{"state":"translated","value":"Bu Mac için yerel mod en uygunudur. Gateway zaten bir Mac Studio veya sunucuda çalışıyorsa uzak mod en uygunudur."}},"uk":{"stringUnit":{"state":"translated","value":"Локальний режим найкраще підходить для цього Mac. Віддалений — коли Gateway вже працює на Mac Studio або сервері."}},"id":{"stringUnit":{"state":"translated","value":"Lokal paling cocok untuk Mac ini. Jarak jauh paling cocok jika Gateway sudah berjalan di Mac Studio atau server."}},"pl":{"stringUnit":{"state":"translated","value":"Tryb lokalny jest najlepszy dla tego Maca. Tryb zdalny jest najlepszy, gdy Gateway działa już na Mac Studio lub serwerze."}},"th":{"stringUnit":{"state":"translated","value":"โหมดในเครื่องเหมาะที่สุดสำหรับ Mac เครื่องนี้ โหมดระยะไกลเหมาะที่สุดเมื่อ Gateway ทำงานอยู่บน Mac Studio หรือเซิร์ฟเวอร์อยู่แล้ว"}},"vi":{"stringUnit":{"state":"translated","value":"Chế độ cục bộ phù hợp nhất cho máy Mac này. Chế độ từ xa phù hợp nhất khi Gateway đã chạy trên Mac Studio hoặc máy chủ."}},"nl":{"stringUnit":{"state":"translated","value":"Lokaal is het beste voor deze Mac. Extern is het beste wanneer de Gateway al op een Mac Studio of server draait."}},"fa":{"stringUnit":{"state":"translated","value":"حالت محلی برای این Mac مناسب‌تر است. حالت راه دور زمانی مناسب‌تر است که Gateway از قبل روی یک Mac Studio یا سرور اجرا می‌شود."}},"ru":{"stringUnit":{"state":"translated","value":"Локальный режим лучше подходит для этого Mac. Удалённый режим лучше подходит, если Gateway уже работает на Mac Studio или сервере."}},"sv":{"stringUnit":{"state":"translated","value":"Lokalt läge passar bäst för denna Mac. Fjärrläge passar bäst när Gateway redan körs på en Mac Studio eller server."}}}},
    "Local mode required. Update settings on the gateway host.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Local mode required. Update settings on the gateway host."}},"zh-CN":{"stringUnit":{"state":"translated","value":"需要本地模式。 请在网关主机上更新设置。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"需要本機模式。 請在 gateway 主機上更新設定。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Modo local necessário. Atualize as configurações no host do Gateway."}},"de":{"stringUnit":{"state":"translated","value":"Lokaler Modus erforderlich. Aktualisiere die Einstellungen auf dem Gateway-Host."}},"es":{"stringUnit":{"state":"translated","value":"Se requiere el modo local. Actualiza la configuración en el equipo que aloja el Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ローカルモードが必要です。 Gatewayホストで設定を更新してください。"}},"ko":{"stringUnit":{"state":"translated","value":"로컬 모드가 필요합니다. Gateway 호스트에서 설정을 업데이트하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Le mode local est requis. Mettez à jour les réglages sur l’hôte du Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"स्थानीय मोड आवश्यक है. Gateway होस्ट पर सेटिंग्स अपडेट करें."}},"ar":{"stringUnit":{"state":"translated","value":"الوضع المحلي مطلوب. حدّث الإعدادات على الجهاز المضيف لـ Gateway."}},"it":{"stringUnit":{"state":"translated","value":"È richiesta la modalità locale. Aggiorna le impostazioni sull'host del gateway."}},"tr":{"stringUnit":{"state":"translated","value":"Yerel mod gereklidir. Ayarları Gateway'in çalıştığı ana makinede güncelleyin."}},"uk":{"stringUnit":{"state":"translated","value":"Потрібен локальний режим. Оновіть налаштування на хості шлюзу."}},"id":{"stringUnit":{"state":"translated","value":"Mode lokal diperlukan. Perbarui pengaturan di host gateway."}},"pl":{"stringUnit":{"state":"translated","value":"Wymagany tryb lokalny. Zaktualizuj ustawienia na hoście Gateway."}},"th":{"stringUnit":{"state":"translated","value":"ต้องใช้โหมดในเครื่อง อัปเดตการตั้งค่าบนโฮสต์ของ Gateway"}},"vi":{"stringUnit":{"state":"translated","value":"Yêu cầu chế độ cục bộ. Cập nhật cài đặt trên máy chủ Gateway."}},"nl":{"stringUnit":{"state":"translated","value":"Lokale modus vereist. Werk de instellingen bij op de gatewayhost."}},"fa":{"stringUnit":{"state":"translated","value":"حالت محلی لازم است. تنظیمات را در میزبان Gateway به‌روزرسانی کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Требуется локальный режим. Обновите настройки на хосте Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Lokalt läge krävs. Uppdatera inställningarna på gateway-värden."}}}},
    "Local process": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Local process"}},"zh-CN":{"stringUnit":{"state":"translated","value":"本地进程"}},"zh-TW":{"stringUnit":{"state":"translated","value":"本機程序"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Processo local"}},"de":{"stringUnit":{"state":"translated","value":"Lokaler Prozess"}},"es":{"stringUnit":{"state":"translated","value":"Proceso local"}},"ja-JP":{"stringUnit":{"state":"translated","value":"ローカルプロセス"}},"ko":{"stringUnit":{"state":"translated","value":"로컬 프로세스"}},"fr":{"stringUnit":{"state":"translated","value":"Processus local"}},"hi":{"stringUnit":{"state":"translated","value":"स्थानीय प्रक्रिया"}},"ar":{"stringUnit":{"state":"translated","value":"عملية محلية"}},"it":{"stringUnit":{"state":"translated","value":"Processo locale"}},"tr":{"stringUnit":{"state":"translated","value":"Yerel süreç"}},"uk":{"stringUnit":{"state":"translated","value":"Локальний процес"}},"id":{"stringUnit":{"state":"translated","value":"Proses lokal"}},"pl":{"stringUnit":{"state":"translated","value":"Proces lokalny"}},"th":{"stringUnit":{"state":"translated","value":"กระบวนการในเครื่อง"}},"vi":{"stringUnit":{"state":"translated","value":"Tiến trình cục bộ"}},"nl":{"stringUnit":{"state":"translated","value":"Lokaal proces"}},"fa":{"stringUnit":{"state":"translated","value":"فرایند محلی"}},"ru":{"stringUnit":{"state":"translated","value":"Локальный процесс"}},"sv":{"stringUnit":{"state":"translated","value":"Lokal process"}}}},
    "Login required": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Login required"}},"zh-CN":{"stringUnit":{"state":"translated","value":"需要登录"}},"zh-TW":{"stringUnit":{"state":"translated","value":"需要登入"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Login necessário"}},"de":{"stringUnit":{"state":"translated","value":"Anmeldung erforderlich"}},"es":{"stringUnit":{"state":"translated","value":"Se requiere iniciar sesión"}},"ja-JP":{"stringUnit":{"state":"translated","value":"ログインが必要です"}},"ko":{"stringUnit":{"state":"translated","value":"로그인 필요"}},"fr":{"stringUnit":{"state":"translated","value":"Connexion requise"}},"hi":{"stringUnit":{"state":"translated","value":"लॉगिन आवश्यक है"}},"ar":{"stringUnit":{"state":"translated","value":"تسجيل الدخول مطلوب"}},"it":{"stringUnit":{"state":"translated","value":"Accesso richiesto"}},"tr":{"stringUnit":{"state":"translated","value":"Oturum açılması gerekiyor"}},"uk":{"stringUnit":{"state":"translated","value":"Потрібен вхід"}},"id":{"stringUnit":{"state":"translated","value":"Perlu masuk"}},"pl":{"stringUnit":{"state":"translated","value":"Wymagane logowanie"}},"th":{"stringUnit":{"state":"translated","value":"ต้องเข้าสู่ระบบ"}},"vi":{"stringUnit":{"state":"translated","value":"Yêu cầu đăng nhập"}},"nl":{"stringUnit":{"state":"translated","value":"Inloggen vereist"}},"fa":{"stringUnit":{"state":"translated","value":"ورود لازم است"}},"ru":{"stringUnit":{"state":"translated","value":"Требуется вход"}},"sv":{"stringUnit":{"state":"translated","value":"Inloggning krävs"}}}},
    "Login-agent restart is unavailable under a profile.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Login-agent restart is unavailable under a profile."}},"zh-CN":{"stringUnit":{"state":"translated","value":"使用配置文件时无法重启登录代理。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"使用設定檔時無法重新啟動登入代理程式。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A reinicialização do agente de login não está disponível ao usar um perfil."}},"de":{"stringUnit":{"state":"translated","value":"Der Neustart des Anmelde-Agenten ist unter einem Profil nicht verfügbar."}},"es":{"stringUnit":{"state":"translated","value":"El reinicio del agente de inicio de sesión no está disponible al usar un perfil."}},"ja-JP":{"stringUnit":{"state":"translated","value":"プロファイル使用時はログインエージェントを再起動できません。"}},"ko":{"stringUnit":{"state":"translated","value":"프로필 사용 중에는 로그인 에이전트를 다시 시작할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le redémarrage de l’agent de connexion n’est pas disponible avec un profil."}},"hi":{"stringUnit":{"state":"translated","value":"प्रोफ़ाइल के अंतर्गत लॉगिन-एजेंट को पुनः शुरू करना उपलब्ध नहीं है."}},"ar":{"stringUnit":{"state":"translated","value":"إعادة تشغيل وكيل تسجيل الدخول غير متاحة عند استخدام ملف تعريف."}},"it":{"stringUnit":{"state":"translated","value":"Il riavvio dell'agente di accesso non è disponibile quando si usa un profilo."}},"tr":{"stringUnit":{"state":"translated","value":"Bir profil altında oturum açma aracısını yeniden başlatma kullanılamaz."}},"uk":{"stringUnit":{"state":"translated","value":"Перезапуск агента входу недоступний під час використання профілю."}},"id":{"stringUnit":{"state":"translated","value":"Memulai ulang agen login tidak tersedia saat menggunakan profil."}},"pl":{"stringUnit":{"state":"translated","value":"Ponowne uruchomienie agenta logowania jest niedostępne w ramach profilu."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถเริ่มเอเจนต์การเข้าสู่ระบบใหม่ได้เมื่อใช้งานภายใต้โปรไฟล์"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể khởi động lại tác nhân đăng nhập khi dùng hồ sơ."}},"nl":{"stringUnit":{"state":"translated","value":"De inlogagent opnieuw starten is niet beschikbaar onder een profiel."}},"fa":{"stringUnit":{"state":"translated","value":"راه‌اندازی مجدد عامل ورود در حالت استفاده از نمایه در دسترس نیست."}},"ru":{"stringUnit":{"state":"translated","value":"Перезапуск агента входа недоступен при использовании профиля."}},"sv":{"stringUnit":{"state":"translated","value":"Omstart av inloggningsagenten är inte tillgänglig under en profil."}}}},
    "Logs": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Logs"}},"zh-CN":{"stringUnit":{"state":"translated","value":"日志"}},"zh-TW":{"stringUnit":{"state":"translated","value":"日誌"}},"pt-BR":{"stringUnit":{"state":"new","value":"Logs"}},"de":{"stringUnit":{"state":"translated","value":"Protokolle"}},"es":{"stringUnit":{"state":"translated","value":"Registros"}},"ja-JP":{"stringUnit":{"state":"translated","value":"ログ"}},"ko":{"stringUnit":{"state":"translated","value":"로그"}},"fr":{"stringUnit":{"state":"translated","value":"Journaux"}},"hi":{"stringUnit":{"state":"translated","value":"लॉग"}},"ar":{"stringUnit":{"state":"translated","value":"السجلات"}},"it":{"stringUnit":{"state":"translated","value":"Log"}},"tr":{"stringUnit":{"state":"translated","value":"Günlükler"}},"uk":{"stringUnit":{"state":"translated","value":"Журнали"}},"id":{"stringUnit":{"state":"translated","value":"Log"}},"pl":{"stringUnit":{"state":"translated","value":"Dzienniki"}},"th":{"stringUnit":{"state":"translated","value":"บันทึก"}},"vi":{"stringUnit":{"state":"translated","value":"Nhật ký"}},"nl":{"stringUnit":{"state":"translated","value":"Logboeken"}},"fa":{"stringUnit":{"state":"translated","value":"گزارش‌ها"}},"ru":{"stringUnit":{"state":"translated","value":"Журналы"}},"sv":{"stringUnit":{"state":"translated","value":"Loggar"}}}},
    "Look again": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Look again"}},"zh-CN":{"stringUnit":{"state":"translated","value":"重新查找"}},"zh-TW":{"stringUnit":{"state":"translated","value":"再次尋找"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Procurar novamente"}},"de":{"stringUnit":{"state":"translated","value":"Erneut suchen"}},"es":{"stringUnit":{"state":"translated","value":"Buscar de nuevo"}},"ja-JP":{"stringUnit":{"state":"translated","value":"もう一度探す"}},"ko":{"stringUnit":{"state":"translated","value":"다시 찾기"}},"fr":{"stringUnit":{"state":"translated","value":"Rechercher à nouveau"}},"hi":{"stringUnit":{"state":"translated","value":"फिर से खोजें"}},"ar":{"stringUnit":{"state":"translated","value":"البحث مجددًا"}},"it":{"stringUnit":{"state":"translated","value":"Cerca di nuovo"}},"tr":{"stringUnit":{"state":"translated","value":"Tekrar bak"}},"uk":{"stringUnit":{"state":"translated","value":"Шукати знову"}},"id":{"stringUnit":{"state":"translated","value":"Cari lagi"}},"pl":{"stringUnit":{"state":"translated","value":"Szukaj ponownie"}},"th":{"stringUnit":{"state":"translated","value":"ค้นหาอีกครั้ง"}},"vi":{"stringUnit":{"state":"translated","value":"Tìm lại"}},"nl":{"stringUnit":{"state":"translated","value":"Opnieuw zoeken"}},"fa":{"stringUnit":{"state":"translated","value":"جستجوی دوباره"}},"ru":{"stringUnit":{"state":"translated","value":"Искать снова"}},"sv":{"stringUnit":{"state":"translated","value":"Sök igen"}}}},
    "Looking for AI you already use…": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Looking for AI you already use…"}},"zh-CN":{"stringUnit":{"state":"translated","value":"正在查找你已在使用的 AI…"}},"zh-TW":{"stringUnit":{"state":"translated","value":"正在尋找您已在使用的 AI…"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Procurando a IA que você já usa…"}},"de":{"stringUnit":{"state":"translated","value":"Suche nach KI, die Sie bereits nutzen…"}},"es":{"stringUnit":{"state":"translated","value":"Buscando la IA que ya usas…"}},"ja-JP":{"stringUnit":{"state":"translated","value":"すでにお使いのAIを検索中…"}},"ko":{"stringUnit":{"state":"translated","value":"이미 사용 중인 AI를 찾는 중…"}},"fr":{"stringUnit":{"state":"translated","value":"Recherche des IA que vous utilisez déjà…"}},"hi":{"stringUnit":{"state":"translated","value":"आप जिस AI का पहले से उपयोग करते हैं, उसे खोजा जा रहा है…"}},"ar":{"stringUnit":{"state":"translated","value":"جارٍ البحث عن أدوات الذكاء الاصطناعي التي تستخدمها بالفعل…"}},"it":{"stringUnit":{"state":"translated","value":"Ricerca dell'IA che usi già…"}},"tr":{"stringUnit":{"state":"translated","value":"Zaten kullandığınız yapay zekâ aranıyor…"}},"uk":{"stringUnit":{"state":"translated","value":"Шукаємо ШІ, яким ви вже користуєтеся…"}},"id":{"stringUnit":{"state":"translated","value":"Mencari AI yang sudah Anda gunakan…"}},"pl":{"stringUnit":{"state":"translated","value":"Wyszukiwanie AI, z której już korzystasz…"}},"th":{"stringUnit":{"state":"translated","value":"กำลังค้นหา AI ที่คุณใช้อยู่แล้ว…"}},"vi":{"stringUnit":{"state":"translated","value":"Đang tìm AI bạn đang sử dụng…"}},"nl":{"stringUnit":{"state":"translated","value":"Zoeken naar AI die je al gebruikt…"}},"fa":{"stringUnit":{"state":"translated","value":"در حال جستجوی هوش مصنوعی‌ای که از قبل استفاده می‌کنید…"}},"ru":{"stringUnit":{"state":"translated","value":"Поиск ИИ, которым вы уже пользуетесь…"}},"sv":{"stringUnit":{"state":"translated","value":"Söker efter AI som du redan använder…"}}}},
