    "Command and script payloads are read-only in the macOS app": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Command and script payloads are read-only in the macOS app"}},"zh-CN":{"stringUnit":{"state":"translated","value":"命令和脚本负载在 macOS App 中为只读"}},"zh-TW":{"stringUnit":{"state":"translated","value":"在 macOS App 中，命令與指令碼承載內容為唯讀"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Os payloads de comandos e scripts são somente leitura no app para macOS"}},"de":{"stringUnit":{"state":"translated","value":"Befehls- und Skriptinhalte sind in der macOS-App schreibgeschützt"}},"es":{"stringUnit":{"state":"translated","value":"Las cargas de comandos y scripts son de solo lectura en la app de macOS"}},"ja-JP":{"stringUnit":{"state":"translated","value":"コマンドとスクリプトのペイロードはmacOSアプリでは読み取り専用です"}},"ko":{"stringUnit":{"state":"translated","value":"명령 및 스크립트 페이로드는 macOS 앱에서 읽기 전용입니다"}},"fr":{"stringUnit":{"state":"translated","value":"Les charges utiles des commandes et des scripts sont en lecture seule dans l’app macOS"}},"hi":{"stringUnit":{"state":"translated","value":"macOS ऐप में कमांड और स्क्रिप्ट पेलोड केवल पढ़ने योग्य हैं"}},"ar":{"stringUnit":{"state":"translated","value":"حِمل الأوامر والبرامج النصية للقراءة فقط في تطبيق macOS"}},"it":{"stringUnit":{"state":"translated","value":"I payload di comandi e script sono di sola lettura nell'app macOS"}},"tr":{"stringUnit":{"state":"translated","value":"Komut ve script yükleri macOS uygulamasında salt okunurdur"}},"uk":{"stringUnit":{"state":"translated","value":"Дані команд і скриптів доступні лише для читання в застосунку macOS"}},"id":{"stringUnit":{"state":"translated","value":"Payload perintah dan skrip bersifat hanya baca di aplikasi macOS"}},"pl":{"stringUnit":{"state":"translated","value":"Ładunki poleceń i skryptów są tylko do odczytu w aplikacji macOS"}},"th":{"stringUnit":{"state":"translated","value":"เพย์โหลดคำสั่งและสคริปต์เป็นแบบอ่านอย่างเดียวในแอป macOS"}},"vi":{"stringUnit":{"state":"translated","value":"Payload lệnh và tập lệnh chỉ có thể đọc trong ứng dụng macOS"}},"nl":{"stringUnit":{"state":"translated","value":"Opdrachten en scriptpayloads zijn alleen-lezen in de macOS-app"}},"fa":{"stringUnit":{"state":"translated","value":"محتوای فرمان‌ها و اسکریپت‌ها در برنامه macOS فقط‌خواندنی است"}},"ru":{"stringUnit":{"state":"translated","value":"Данные команд и скриптов доступны в приложении macOS только для чтения"}},"sv":{"stringUnit":{"state":"translated","value":"Kommando- och skriptinnehåll är skrivskyddat i macOS-appen"}}}},
