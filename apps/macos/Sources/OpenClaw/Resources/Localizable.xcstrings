    "Tools for diagnosing local issues (Gateway, ports, logs, Canvas).": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Tools for diagnosing local issues (Gateway, ports, logs, Canvas)."}},"zh-CN":{"stringUnit":{"state":"translated","value":"用于诊断本地问题的工具 (Gateway、端口、日志、Canvas)。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"用於診斷本機問題的工具 (Gateway, 連接埠, 記錄, Canvas)。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ferramentas para diagnosticar problemas locais (Gateway, portas, logs, Canvas)."}},"de":{"stringUnit":{"state":"translated","value":"Tools zur Diagnose lokaler Probleme (Gateway, Ports, Protokolle, Canvas)."}},"es":{"stringUnit":{"state":"translated","value":"Herramientas para diagnosticar problemas locales (Gateway, puertos, registros, Canvas)."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ローカルの問題を診断するツール (Gateway、ポート、ログ、Canvas)。"}},"ko":{"stringUnit":{"state":"translated","value":"로컬 문제 진단 도구(Gateway, 포트, 로그, Canvas)."}},"fr":{"stringUnit":{"state":"translated","value":"Outils de diagnostic des problèmes locaux (Gateway, ports, journaux, Canvas)."}},"hi":{"stringUnit":{"state":"translated","value":"स्थानीय समस्याओं के निदान के लिए टूल (Gateway, पोर्ट, लॉग, Canvas)."}},"ar":{"stringUnit":{"state":"translated","value":"أدوات لتشخيص المشكلات المحلية (Gateway، المنافذ، السجلات، Canvas)."}},"it":{"stringUnit":{"state":"translated","value":"Strumenti per diagnosticare problemi locali (Gateway, porte, log, Canvas)."}},"tr":{"stringUnit":{"state":"translated","value":"Yerel sorunları tanılamaya yönelik araçlar (Gateway, bağlantı noktaları, günlükler, Canvas)."}},"uk":{"stringUnit":{"state":"translated","value":"Інструменти для діагностики локальних проблем (Gateway, порти, журнали, Canvas)."}},"id":{"stringUnit":{"state":"translated","value":"Alat untuk mendiagnosis masalah lokal (Gateway, port, log, Canvas)."}},"pl":{"stringUnit":{"state":"translated","value":"Narzędzia do diagnozowania lokalnych problemów (Gateway, po