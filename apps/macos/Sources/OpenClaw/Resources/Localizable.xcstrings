    "The widget image could not be saved.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The widget image could not be saved."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法保存小组件图像。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法儲存小工具影像。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível salvar a imagem do widget."}},"de":{"stringUnit":{"state":"translated","value":"Das Widget-Bild konnte nicht gespeichert werden."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo guardar la imagen del widget."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ウィジェットの画像を保存できませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"위젯 이미지를 저장할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’image du widget n’a pas pu être enregistrée."}},"hi":{"stringUnit":{"state":"translated","value":"विजेट की छवि सहेजी नहीं जा सकी."}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر حفظ صورة الأداة."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile salvare l'immagine del widget."}},"tr":{"stringUnit":{"state":"translated","value":"Araç takımı görüntüsü kaydedilemedi."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося зберегти зображення віджета."}},"id":{"stringUnit":{"state":"translated","value":"Gambar widget tidak dapat disimpan."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się zapisać obrazu widżetu."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถบันทึกภาพวิดเจ็ตได้."}},"vi":{"stringUnit":{"state":"translated","value":"Không thể lưu ảnh tiện ích."}},"nl":{"stringUnit":{"state":"translated","value":"De widgetafbeelding kon niet worden opgeslagen."}},"fa":{"stringUnit":{"state":"translated","value":"ذخیره کردن تصویر ویجت ممکن نشد."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось сохранить изображение виджета."}},"sv":{"stringUnit":{"state":"translated","value":"Widgetbilden kunde inte sparas."}}}},
    "These settings changed outside the app while you were editing: %@. Choose which version to keep.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"These settings changed outside the app while you were editing: %@. Choose which version to keep."}},"zh-CN":{"stringUnit":{"state":"translated","value":"在您编辑期间, 以下设置在应用外被更改: %@. 请选择要保留的版本。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"您編輯期間，以下設定已在應用程式外部變更: %@。請選擇要保留的版本。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Estas configurações foram alteradas fora do aplicativo enquanto você as editava: %@. Escolha qual versão manter."}},"de":{"stringUnit":{"state":"translated","value":"Diese Einstellungen wurden während Ihrer Bearbeitung außerhalb der App geändert: %@. Wählen Sie aus, welche Version Sie behalten möchten."}},"es":{"stringUnit":{"state":"translated","value":"Estos ajustes cambiaron fuera de la aplicación mientras los editabas: %@. Elige qué versión conservar."}},"ja-JP":{"stringUnit":{"state":"translated","value":"編集中に次の設定がアプリ外で変更されました: %@. 保持するバージョンを選択してください。"}},"ko":{"stringUnit":{"state":"translated","value":"편집하는 동안 앱 외부에서 다음 설정이 변경되었습니다: %@. 유지할 버전을 선택하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Ces paramètres ont été modifiés en dehors de l’application pendant que vous les modifiiez : %@. Choisissez la version à conserver."}},"hi":{"stringUnit":{"state":"translated","value":"जब आप संपादन कर रहे थे, तब ये सेटिंग ऐप के बाहर बदल गईं: %@. चुनें कि कौन-सा संस्करण रखना है."}},"ar":{"stringUnit":{"state":"translated","value":"تغيّرت هذه الإعدادات خارج التطبيق أثناء تعديلك لها: %@. اختر النسخة التي تريد الاحتفاظ بها."}},"it":{"stringUnit":{"state":"translated","value":"Queste impostazioni sono state modificate al di fuori dell'app durante la modifica: %@. Scegli quale versione mantenere."}},"tr":{"stringUnit":{"state":"translated","value":"Siz düzenleme yaparken şu ayarlar uygulama dışında değiştirildi: %@. Hangi sürümün korunacağını seçin."}},"uk":{"stringUnit":{"state":"translated","value":"Поки ви редагували, ці налаштування змінилися поза застосунком: %@. Виберіть, яку версію зберегти."}},"id":{"stringUnit":{"state":"translated","value":"Pengaturan ini berubah di luar aplikasi saat Anda mengedit: %@. Pilih versi yang ingin dipertahankan."}},"pl":{"stringUnit":{"state":"translated","value":"Te ustawienia zostały zmienione poza aplikacją podczas edycji: %@. Wybierz wersję, którą chcesz zachować."}},"th":{"stringUnit":{"state":"translated","value":"การตั้งค่าเหล่านี้มีการเปลี่ยนแปลงจากภายนอกแอปขณะที่คุณกำลังแก้ไข: %@. เลือกเวอร์ชันที่ต้องการเก็บไว้."}},"vi":{"stringUnit":{"state":"translated","value":"Các cài đặt này đã thay đổi bên ngoài ứng dụng trong khi bạn đang chỉnh sửa: %@. Chọn phiên bản cần giữ."}},"nl":{"stringUnit":{"state":"translated","value":"Deze instellingen zijn buiten de app gewijzigd terwijl u ze bewerkte: %@. Kies welke versie u wilt behouden."}},"fa":{"stringUnit":{"state":"translated","value":"هنگام ویرایش شما، این تنظیمات خارج از برنامه تغییر کردند: %@. نسخه‌ای را که می‌خواهید نگه دارید انتخاب کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Эти настройки были изменены вне приложения, пока вы их редактировали: %@. Выберите, какую версию сохранить."}},"sv":{"stringUnit":{"state":"translated","value":"Dessa inställningar ändrades utanför appen medan du redigerade: %@. Välj vilken version du vill behålla."}}}},
    "Thinking": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Thinking"}},"zh-CN":{"stringUnit":{"state":"translated","value":"思考"}},"zh-TW":{"stringUnit":{"state":"translated","value":"思考"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Raciocínio"}},"de":{"stringUnit":{"state":"translated","value":"Nachdenken"}},"es":{"stringUnit":{"state":"translated","value":"Razonamiento"}},"ja-JP":{"stringUnit":{"state":"translated","value":"思考"}},"ko":{"stringUnit":{"state":"translated","value":"추론"}},"fr":{"stringUnit":{"state":"translated","value":"Réflexion"}},"hi":{"stringUnit":{"state":"translated","value":"चिंतन"}},"ar":{"stringUnit":{"state":"translated","value":"جارٍ التفكير"}},"it":{"stringUnit":{"state":"translated","value":"Ragionamento"}},"tr":{"stringUnit":{"state":"translated","value":"Düşünme"}},"uk":{"stringUnit":{"state":"translated","value":"Міркування"}},"id":{"stringUnit":{"state":"translated","value":"Berpikir"}},"pl":{"stringUnit":{"state":"translated","value":"Myślenie"}},"th":{"stringUnit":{"state":"translated","value":"การคิด"}},"vi":{"stringUnit":{"state":"translated","value":"Suy nghĩ"}},"nl":{"stringUnit":{"state":"translated","value":"Nadenken"}},"fa":{"stringUnit":{"state":"translated","value":"تفکر"}},"ru":{"stringUnit":{"state":"translated","value":"Размышление"}},"sv":{"stringUnit":{"state":"translated","value":"Tänkande"}}}},
    "Thinking and Fast controls require operator.admin access.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Thinking and Fast controls require operator.admin access."}},"zh-CN":{"stringUnit":{"state":"translated","value":"思考和快速控件需要 operator.admin 访问权限。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"思考與快速控制項需要 operator.admin 存取權限。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Os controles de Raciocínio e Rápido exigem acesso operator.admin."}},"de":{"stringUnit":{"state":"translated","value":"Die Steuerelemente für Nachdenken und Schnellmodus erfordern operator.admin-Zugriff."}},"es":{"stringUnit":{"state":"translated","value":"Los controles de Razonamiento y Rápido requieren acceso operator.admin."}},"ja-JP":{"stringUnit":{"state":"translated","value":"思考と高速モードの操作にはoperator.admin権限が必要です。"}},"ko":{"stringUnit":{"state":"translated","value":"추론 및 빠른 모드 제어에는 operator.admin 권한이 필요합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les commandes Réflexion et Rapide nécessitent l’accès operator.admin."}},"hi":{"stringUnit":{"state":"translated","value":"चिंतन और तेज़ नियंत्रणों के लिए operator.admin का ऐक्सेस आवश्यक है."}},"ar":{"stringUnit":{"state":"translated","value":"تتطلب عناصر التحكم في التفكير والوضع السريع صلاحية operator.admin."}},"it":{"stringUnit":{"state":"translated","value":"I controlli Ragionamento e Rapido richiedono l'accesso operator.admin."}},"tr":{"stringUnit":{"state":"translated","value":"Düşünme ve Hızlı denetimleri operator.admin erişimi gerektirir."}},"uk":{"stringUnit":{"state":"translated","value":"Елементи керування «Міркування» та «Швидкий режим» потребують доступу operator.admin."}},"id":{"stringUnit":{"state":"translated","value":"Kontrol Berpikir dan Cepat memerlukan akses operator.admin."}},"pl":{"stringUnit":{"state":"translated","value":"Opcje Myślenie i Szybko wymagają uprawnień operator.admin."}},"th":{"stringUnit":{"state":"translated","value":"ตัวควบคุมการคิดและโหมดเร็วต้องใช้สิทธิ์ operator.admin."}},"vi":{"stringUnit":{"state":"translated","value":"Các tùy chọn Suy nghĩ và Nhanh yêu cầu quyền truy cập operator.admin."}},"nl":{"stringUnit":{"state":"translated","value":"De bedieningselementen Nadenken en Snel vereisen operator.admin-toegang."}},"fa":{"stringUnit":{"state":"translated","value":"کنترل‌های تفکر و سریع به دسترسی operator.admin نیاز دارند."}},"ru":{"stringUnit":{"state":"translated","value":"Для управления размышлением и быстрым режимом требуется доступ operator.admin."}},"sv":{"stringUnit":{"state":"translated","value":"Kontrollerna för Tänkande och Snabb kräver behörigheten operator.admin."}}}},
    "This Watch message belongs to a retired Gateway route. Open OpenClaw on iPhone.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This Watch message belongs to a retired Gateway route. Open OpenClaw on iPhone."}},"zh-CN":{"stringUnit":{"state":"translated","value":"这条 Watch 消息属于已停用的 Gateway 路由。 请在 iPhone 上打开 OpenClaw."}},"zh-TW":{"stringUnit":{"state":"translated","value":"這則 Watch 訊息屬於已停用的 Gateway 路由。 請在 iPhone 上開啟 OpenClaw."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Esta mensagem do Watch pertence a uma rota do Gateway desativada. Abra o OpenClaw no iPhone."}},"de":{"stringUnit":{"state":"translated","value":"Diese Watch-Nachricht gehört zu einer stillgelegten Gateway-Route. Öffne OpenClaw auf dem iPhone."}},"es":{"stringUnit":{"state":"translated","value":"Este mensaje de Watch pertenece a una ruta de Gateway retirada. Abre OpenClaw en el iPhone."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このWatchメッセージは、廃止されたGatewayルートに属しています。iPhoneでOpenClawを開いてください。"}},"ko":{"stringUnit":{"state":"translated","value":"이 Watch 메시지는 더 이상 사용되지 않는 Gateway 경로에 속합니다. iPhone에서 OpenClaw를 여세요."}},"fr":{"stringUnit":{"state":"translated","value":"Ce message Watch appartient à une route Gateway désactivée. Ouvrez OpenClaw sur iPhone."}},"hi":{"stringUnit":{"state":"translated","value":"यह Watch संदेश अब उपयोग में न आने वाले Gateway रूट से जुड़ा है. iPhone पर OpenClaw खोलें."}},"ar":{"stringUnit":{"state":"translated","value":"تنتمي رسالة Watch هذه إلى مسار Gateway لم يعد مستخدمًا. افتح OpenClaw على iPhone."}},"it":{"stringUnit":{"state":"translated","value":"Questo messaggio di Watch appartiene a un percorso Gateway dismesso. Apri OpenClaw su iPhone."}},"tr":{"stringUnit":{"state":"translated","value":"Bu Watch mesajı, artık kullanılmayan bir Gateway rotasına ait. iPhone'da OpenClaw'u açın."}},"uk":{"stringUnit":{"state":"translated","value":"Це повідомлення з Watch належить до виведеного з експлуатації маршруту Gateway. Відкрийте OpenClaw на iPhone."}},"id":{"stringUnit":{"state":"translated","value":"Pesan Watch ini terkait dengan rute Gateway yang sudah dinonaktifkan. Buka OpenClaw di iPhone."}},"pl":{"stringUnit":{"state":"translated","value":"Ta wiadomość z zegarka Watch należy do wycofanej trasy Gateway. Otwórz OpenClaw na iPhonie."}},"th":{"stringUnit":{"state":"translated","value":"ข้อความจาก Watch นี้เป็นของเส้นทาง Gateway ที่เลิกใช้งานแล้ว. เปิด OpenClaw บน iPhone."}},"vi":{"stringUnit":{"state":"translated","value":"Tin nhắn Watch này thuộc về một tuyến Gateway đã ngừng hoạt động. Mở OpenClaw trên iPhone."}},"nl":{"stringUnit":{"state":"translated","value":"Dit Watch-bericht hoort bij een buiten gebruik gestelde Gateway-route. Open OpenClaw op iPhone."}},"fa":{"stringUnit":{"state":"translated","value":"این پیام Watch به یک مسیر از رده خارج‌شدهٔ Gateway تعلق دارد. OpenClaw را در iPhone باز کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Это сообщение с Watch относится к выведенному из эксплуатации маршруту Gateway. Откройте OpenClaw на iPhone."}},"sv":{"stringUnit":{"state":"translated","value":"Det här Watch-meddelandet tillhör en avvecklad Gateway-rutt. Öppna OpenClaw på iPhone."}}}},
    "This app connects without installing or updating its CLI runtime.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This app connects without installing or updating its CLI runtime."}},"zh-CN":{"stringUnit":{"state":"translated","value":"此应用无需安装或更新其 CLI 运行时即可连接。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此應用程式無需安裝或更新其 CLI 執行環境即可連線。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Este app se conecta sem instalar ou atualizar seu ambiente de execução da CLI."}},"de":{"stringUnit":{"state":"translated","value":"Diese App stellt eine Verbindung her, ohne ihre CLI-Laufzeitumgebung zu installieren oder zu aktualisieren."}},"es":{"stringUnit":{"state":"translated","value":"Esta aplicación se conecta sin instalar ni actualizar su entorno de ejecución de CLI."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このアプリは、CLIランタイムをインストールまたは更新せずに接続します。"}},"ko":{"stringUnit":{"state":"translated","value":"이 앱은 CLI 런타임을 설치하거나 업데이트하지 않고 연결합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Cette app se connecte sans installer ni mettre à jour son environnement d’exécution CLI."}},"hi":{"stringUnit":{"state":"translated","value":"यह ऐप अपने CLI रनटाइम को इंस्टॉल या अपडेट किए बिना कनेक्ट होता है."}},"ar":{"stringUnit":{"state":"translated","value":"يتصل هذا التطبيق دون تثبيت بيئة تشغيل CLI الخاصة به أو تحديثها."}},"it":{"stringUnit":{"state":"translated","value":"Questa app si connette senza installare o aggiornare il proprio runtime CLI."}},"tr":{"stringUnit":{"state":"translated","value":"Bu uygulama, CLI çalışma ortamını yüklemeden veya güncellemeden bağlanır."}},"uk":{"stringUnit":{"state":"translated","value":"Цей застосунок підключається без установлення чи оновлення свого середовища виконання CLI."}},"id":{"stringUnit":{"state":"translated","value":"Aplikasi ini terhubung tanpa menginstal atau memperbarui runtime CLI-nya."}},"pl":{"stringUnit":{"state":"translated","value":"Ta aplikacja łączy się bez instalowania ani aktualizowania swojego środowiska uruchomieniowego CLI."}},"th":{"stringUnit":{"state":"translated","value":"แอปนี้เชื่อมต่อได้โดยไม่ต้องติดตั้งหรืออัปเดตรันไทม์ CLI."}},"vi":{"stringUnit":{"state":"translated","value":"Ứng dụng này kết nối mà không cần cài đặt hay cập nhật môi trường chạy CLI của ứng dụng."}},"nl":{"stringUnit":{"state":"translated","value":"Deze app maakt verbinding zonder de CLI-runtime te installeren of bij te werken."}},"fa":{"stringUnit":{"state":"translated","value":"این برنامه بدون نصب یا به‌روزرسانی محیط اجرای CLI خود متصل می‌شود."}},"ru":{"stringUnit":{"state":"translated","value":"Это приложение подключается без установки или обновления среды выполнения CLI."}},"sv":{"stringUnit":{"state":"translated","value":"Den här appen ansluter utan att installera eller uppdatera sin CLI-körmiljö."}}}},
    "This app, WhatsApp, Telegram, Discord, Slack — your choice.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This app, WhatsApp, Telegram, Discord, Slack — your choice."}},"zh-CN":{"stringUnit":{"state":"translated","value":"此应用, WhatsApp, Telegram, Discord, Slack — 任您选择。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此應用程式, WhatsApp, Telegram, Discord, Slack — 由您選擇。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Este app, WhatsApp, Telegram, Discord, Slack — você escolhe."}},"de":{"stringUnit":{"state":"translated","value":"Diese App, WhatsApp, Telegram, Discord, Slack — du hast die Wahl."}},"es":{"stringUnit":{"state":"translated","value":"Esta aplicación, WhatsApp, Telegram, Discord, Slack — tú eliges."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このアプリ、WhatsApp、Telegram、Discord、Slack — お好きなものを選べます。"}},"ko":{"stringUnit":{"state":"translated","value":"이 앱, WhatsApp, Telegram, Discord, Slack — 원하는 것을 선택하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Cette app, WhatsApp, Telegram, Discord, Slack — à vous de choisir."}},"hi":{"stringUnit":{"state":"translated","value":"यह ऐप, WhatsApp, Telegram, Discord, Slack — आपकी पसंद."}},"ar":{"stringUnit":{"state":"translated","value":"هذا التطبيق، WhatsApp، Telegram، Discord، Slack — الخيار لك."}},"it":{"stringUnit":{"state":"translated","value":"Questa app, WhatsApp, Telegram, Discord, Slack — a te la scelta."}},"tr":{"stringUnit":{"state":"translated","value":"Bu uygulama, WhatsApp, Telegram, Discord, Slack — seçim sizin."}},"uk":{"stringUnit":{"state":"translated","value":"Цей застосунок, WhatsApp, Telegram, Discord, Slack — на ваш вибір."}},"id":{"stringUnit":{"state":"translated","value":"Aplikasi ini, WhatsApp, Telegram, Discord, Slack — pilihan Anda."}},"pl":{"stringUnit":{"state":"translated","value":"Ta aplikacja, WhatsApp, Telegram, Discord, Slack — wybór należy do Ciebie."}},"th":{"stringUnit":{"state":"translated","value":"แอปนี้, WhatsApp, Telegram, Discord, Slack — คุณเลือกได้."}},"vi":{"stringUnit":{"state":"translated","value":"Ứng dụng này, WhatsApp, Telegram, Discord, Slack — tùy bạn chọn."}},"nl":{"stringUnit":{"state":"translated","value":"Deze app, WhatsApp, Telegram, Discord, Slack — aan jou de keuze."}},"fa":{"stringUnit":{"state":"translated","value":"این برنامه، WhatsApp، Telegram، Discord، Slack — انتخاب با شماست."}},"ru":{"stringUnit":{"state":"translated","value":"Это приложение, WhatsApp, Telegram, Discord, Slack — выбор за вами."}},"sv":{"stringUnit":{"state":"translated","value":"Den här appen, WhatsApp, Telegram, Discord, Slack — du väljer."}}}},
    "This copy is newer than the installed app. OpenClaw will replace it and reopen from Applications.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This copy is newer than the installed app. OpenClaw will replace it and reopen from Applications."}},"zh-CN":{"stringUnit":{"state":"translated","value":"此副本比已安装的应用更新。 OpenClaw 将替换已安装的应用, 并从应用程序文件夹重新打开。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此副本比已安裝的應用程式更新。 OpenClaw 將取代已安裝的版本, 並從「應用程式」重新開啟。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Esta cópia é mais recente que o app instalado. O OpenClaw vai substituí-lo e reabrir a partir de Aplicativos."}},"de":{"stringUnit":{"state":"translated","value":"Diese Kopie ist neuer als die installierte App. OpenClaw ersetzt sie und öffnet sich erneut aus dem Ordner Programme."}},"es":{"stringUnit":{"state":"translated","value":"Esta copia es más reciente que la aplicación instalada. OpenClaw la reemplazará y volverá a abrirse desde Aplicaciones."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このコピーはインストール済みのアプリより新しいバージョンです。OpenClawはインストール済みのアプリを置き換え、「アプリケーション」から再度開きます。"}},"ko":{"stringUnit":{"state":"translated","value":"이 복사본은 설치된 앱보다 최신 버전입니다. OpenClaw가 설치된 앱을 교체하고 응용 프로그램 폴더에서 다시 열립니다."}},"fr":{"stringUnit":{"state":"translated","value":"Cette copie est plus récente que l’app installée. OpenClaw la remplacera et se rouvrira depuis Applications."}},"hi":{"stringUnit":{"state":"translated","value":"यह कॉपी इंस्टॉल किए गए ऐप से नई है. OpenClaw उसे बदल देगा और Applications से फिर से खुलेगा."}},"ar":{"stringUnit":{"state":"translated","value":"هذه النسخة أحدث من التطبيق المثبّت. سيستبدله OpenClaw ويُعاد فتحه من مجلد التطبيقات."}},"it":{"stringUnit":{"state":"translated","value":"Questa copia è più recente dell'app installata. OpenClaw la sostituirà e si riaprirà da Applicazioni."}},"tr":{"stringUnit":{"state":"translated","value":"Bu kopya, yüklü uygulamadan daha yeni. OpenClaw yüklü uygulamayı değiştirip Uygulamalar'dan yeniden açılacak."}},"uk":{"stringUnit":{"state":"translated","value":"Ця копія новіша за встановлений застосунок. OpenClaw замінить його та знову відкриється з папки «Програми»."}},"id":{"stringUnit":{"state":"translated","value":"Salinan ini lebih baru daripada aplikasi yang terinstal. OpenClaw akan menggantinya dan membuka kembali dari Applications."}},"pl":{"stringUnit":{"state":"translated","value":"Ta kopia jest nowsza niż zainstalowana aplikacja. OpenClaw zastąpi zainstalowaną aplikację i uruchomi się ponownie z folderu Aplikacje."}},"th":{"stringUnit":{"state":"translated","value":"สำเนานี้ใหม่กว่าแอปที่ติดตั้งไว้. OpenClaw จะแทนที่แอปนั้นและเปิดใหม่จาก Applications."}},"vi":{"stringUnit":{"state":"translated","value":"Bản sao này mới hơn ứng dụng đã cài đặt. OpenClaw sẽ thay thế ứng dụng đó và mở lại từ Applications."}},"nl":{"stringUnit":{"state":"translated","value":"Deze kopie is nieuwer dan de geïnstalleerde app. OpenClaw vervangt deze en opent opnieuw vanuit Apps."}},"fa":{"stringUnit":{"state":"translated","value":"این نسخه از برنامهٔ نصب‌شده جدیدتر است. OpenClaw آن را جایگزین می‌کند و دوباره از Applications باز می‌شود."}},"ru":{"stringUnit":{"state":"translated","value":"Эта копия новее установленного приложения. OpenClaw заменит его и снова откроется из папки «Программы»."}},"sv":{"stringUnit":{"state":"translated","value":"Den här kopian är nyare än den installerade appen. OpenClaw ersätter den och öppnas igen från Program."}}}},
    "This device ID is already paired. Approving replaces its access token.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This device ID is already paired. Approving replaces its access token."}},"zh-CN":{"stringUnit":{"state":"translated","value":"此设备 ID 已配对。批准后将替换其访问令牌。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此裝置 ID 已配對。核准後將取代其存取權杖。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Este ID de dispositivo já está pareado. A aprovação substitui seu token de acesso."}},"de":{"stringUnit":{"state":"translated","value":"Diese Geräte-ID ist bereits gekoppelt. Die Freigabe ersetzt ihr Zugriffstoken."}},"es":{"stringUnit":{"state":"translated","value":"Este ID de dispositivo ya está vinculado. Al aprobar, se reemplaza su token de acceso."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このデバイス ID はすでにペアリングされています。承認すると、アクセストークンが置き換えられます。"}},"ko":{"stringUnit":{"state":"translated","value":"이 기기 ID는 이미 페어링되어 있습니다. 승인하면 해당 접근 토큰이 교체됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Cet identifiant d’appareil est déjà appairé. L’approbation remplace son jeton d’accès."}},"hi":{"stringUnit":{"state":"translated","value":"यह डिवाइस ID पहले से पेयर है। स्वीकृति देने पर इसका ऐक्सेस टोकन बदल जाएगा।"}},"ar":{"stringUnit":{"state":"translated","value":"معرّف هذا الجهاز مقترن بالفعل. ستؤدي الموافقة إلى استبدال رمز الوصول الخاص به."}},"it":{"stringUnit":{"state":"translated","value":"Questo ID dispositivo è già abbinato. L'approvazione ne sostituisce il token di accesso."}},"tr":{"stringUnit":{"state":"translated","value":"Bu cihaz kimliği zaten eşleştirilmiş. Onay verildiğinde erişim belirteci değiştirilir."}},"uk":{"stringUnit":{"state":"translated","value":"Цей ідентифікатор пристрою вже сполучено. Схвалення замінить його токен доступу."}},"id":{"stringUnit":{"state":"translated","value":"ID perangkat ini sudah dipasangkan. Menyetujuinya akan mengganti token aksesnya."}},"pl":{"stringUnit":{"state":"translated","value":"Ten identyfikator urządzenia jest już sparowany. Zatwierdzenie spowoduje zastąpienie jego tokenu dostępu."}},"th":{"stringUnit":{"state":"translated","value":"ID อุปกรณ์นี้จับคู่แล้ว การอนุมัติจะแทนที่โทเค็นการเข้าถึงของอุปกรณ์"}},"vi":{"stringUnit":{"state":"translated","value":"ID thiết bị này đã được ghép nối. Việc phê duyệt sẽ thay thế mã truy cập của thiết bị."}},"nl":{"stringUnit":{"state":"translated","value":"Deze apparaat-ID is al gekoppeld. Goedkeuring vervangt het toegangstoken."}},"fa":{"stringUnit":{"state":"translated","value":"این شناسهٔ دستگاه قبلاً جفت شده است. با تأیید، توکن دسترسی آن جایگزین می‌شود."}},"ru":{"stringUnit":{"state":"translated","value":"Устройство с этим идентификатором уже сопряжено. При одобрении его токен доступа будет заменён."}},"sv":{"stringUnit":{"state":"translated","value":"Detta enhets-ID är redan parkopplat. Ett godkännande ersätter dess åtkomsttoken."}}}},
    "This device needs pairing approval": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This device needs pairing approval"}},"zh-CN":{"stringUnit":{"state":"translated","value":"此设备需要配对批准"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此裝置需要配對核准"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Este dispositivo precisa de aprovação de emparelhamento"}},"de":{"stringUnit":{"state":"translated","value":"Dieses Gerät benötigt eine Kopplungsgenehmigung"}},"es":{"stringUnit":{"state":"translated","value":"Este dispositivo necesita aprobación de vinculación"}},"ja-JP":{"stringUnit":{"state":"translated","value":"このデバイスにはペアリングの承認が必要です"}},"ko":{"stringUnit":{"state":"translated","value":"이 기기는 페어링 승인이 필요합니다"}},"fr":{"stringUnit":{"state":"translated","value":"Cet appareil nécessite une approbation d’appairage"}},"hi":{"stringUnit":{"state":"translated","value":"इस डिवाइस को पेयरिंग की स्वीकृति चाहिए"}},"ar":{"stringUnit":{"state":"translated","value":"يحتاج هذا الجهاز إلى الموافقة على الإقران"}},"it":{"stringUnit":{"state":"translated","value":"Questo dispositivo richiede l'approvazione dell'abbinamento"}},"tr":{"stringUnit":{"state":"translated","value":"Bu aygıt için eşleştirme onayı gerekiyor"}},"uk":{"stringUnit":{"state":"translated","value":"Цей пристрій потребує схвалення сполучення"}},"id":{"stringUnit":{"state":"translated","value":"Perangkat ini memerlukan persetujuan pemasangan"}},"pl":{"stringUnit":{"state":"translated","value":"To urządzenie wymaga zatwierdzenia parowania"}},"th":{"stringUnit":{"state":"translated","value":"อุปกรณ์นี้ต้องได้รับการอนุมัติการจับคู่"}},"vi":{"stringUnit":{"state":"translated","value":"Thiết bị này cần được phê duyệt ghép đôi"}},"nl":{"stringUnit":{"state":"translated","value":"Dit apparaat heeft goedkeuring nodig om te koppelen"}},"fa":{"stringUnit":{"state":"translated","value":"این دستگاه به تأیید جفت‌سازی نیاز دارد"}},"ru":{"stringUnit":{"state":"translated","value":"Для этого устройства требуется одобрение сопряжения"}},"sv":{"stringUnit":{"state":"translated","value":"Den här enheten behöver godkännande för parkoppling"}}}},
    "This gateway has token auth enabled, but no gateway.auth.token is configured on the host.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This gateway has token auth enabled, but no gateway.auth.token is configured on the host."}},"zh-CN":{"stringUnit":{"state":"translated","value":"此 Gateway 已启用令牌身份验证，但主机上未配置 gateway.auth.token。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此 Gateway 已啟用權杖驗證，但主機上尚未設定 gateway.auth.token。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Este Gateway tem a autenticação por token ativada, mas nenhum gateway.auth.token está configurado no host."}},"de":{"stringUnit":{"state":"translated","value":"Bei diesem Gateway ist die Token-Authentifizierung aktiviert, aber auf dem Host ist kein gateway.auth.token konfiguriert."}},"es":{"stringUnit":{"state":"translated","value":"Este Gateway tiene activada la autenticación por token, pero no se ha configurado gateway.auth.token en el host."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このGatewayではトークン認証が有効ですが、ホストにgateway.auth.tokenが設定されていません。"}},"ko":{"stringUnit":{"state":"translated","value":"이 Gateway는 토큰 인증이 활성화되어 있지만, 호스트에 gateway.auth.token이 설정되어 있지 않습니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’authentification par jeton est activée sur ce Gateway, mais aucun gateway.auth.token n’est configuré sur l’hôte."}},"hi":{"stringUnit":{"state":"translated","value":"इस Gateway में टोकन प्रमाणीकरण चालू है, लेकिन होस्ट पर gateway.auth.token कॉन्फ़िगर नहीं किया गया है."}},"ar":{"stringUnit":{"state":"translated","value":"المصادقة بالرمز مفعّلة في Gateway هذا، لكن gateway.auth.token غير مضبوط على المضيف."}},"it":{"stringUnit":{"state":"translated","value":"Questo gateway ha l'autenticazione tramite token abilitata, ma sull'host non è configurato gateway.auth.token."}},"tr":{"stringUnit":{"state":"translated","value":"Bu Gateway üzerinde belirteçle kimlik doğrulama etkin, ancak ana makinede gateway.auth.token yapılandırılmamış."}},"uk":{"stringUnit":{"state":"translated","value":"На цьому Gateway увімкнено автентифікацію за токеном, але на хості не налаштовано gateway.auth.token."}},"id":{"stringUnit":{"state":"translated","value":"Autentikasi token diaktifkan pada Gateway ini, tetapi gateway.auth.token belum dikonfigurasi pada host."}},"pl":{"stringUnit":{"state":"translated","value":"Ta brama ma włączone uwierzytelnianie tokenem, ale na hoście nie skonfigurowano gateway.auth.token."}},"th":{"stringUnit":{"state":"translated","value":"Gateway นี้เปิดใช้การยืนยันตัวตนด้วยโทเค็น แต่ยังไม่ได้กำหนดค่า gateway.auth.token บนโฮสต์."}},"vi":{"stringUnit":{"state":"translated","value":"Gateway này đã bật xác thực bằng token, nhưng chưa cấu hình gateway.auth.token trên máy chủ."}},"nl":{"stringUnit":{"state":"translated","value":"Voor deze gateway is tokenauthenticatie ingeschakeld, maar er is geen gateway.auth.token geconfigureerd op de host."}},"fa":{"stringUnit":{"state":"translated","value":"احراز هویت با توکن در این Gateway فعال است، اما gateway.auth.token روی میزبان پیکربندی نشده است."}},"ru":{"stringUnit":{"state":"translated","value":"На этом Gateway включена аутентификация по токену, но на хосте не настроен gateway.auth.token."}},"sv":{"stringUnit":{"state":"translated","value":"Den här Gateway har tokenautentisering aktiverad, men ingen gateway.auth.token har konfigurerats på värden."}}}},
    "This gateway host needs token setup": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This gateway host needs token setup"}},"zh-CN":{"stringUnit":{"state":"translated","value":"此 Gateway 主机需要设置令牌"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此 Gateway 主機需要設定權杖"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Este host do Gateway precisa de configuração de token"}},"de":{"stringUnit":{"state":"translated","value":"Für diesen Gateway-Host muss ein Token eingerichtet werden"}},"es":{"stringUnit":{"state":"translated","value":"Este host del Gateway necesita que se configure un token"}},"ja-JP":{"stringUnit":{"state":"translated","value":"このGatewayホストにはトークンの設定が必要です"}},"ko":{"stringUnit":{"state":"translated","value":"이 Gateway 호스트에는 토큰 설정이 필요합니다"}},"fr":{"stringUnit":{"state":"translated","value":"Un jeton doit être configuré sur l’hôte de ce Gateway"}},"hi":{"stringUnit":{"state":"translated","value":"इस Gateway होस्ट पर टोकन सेटअप की आवश्यकता है"}},"ar":{"stringUnit":{"state":"translated","value":"يحتاج مضيف Gateway هذا إلى إعداد الرمز"}},"it":{"stringUnit":{"state":"translated","value":"È necessario configurare un token sull'host di questo gateway"}},"tr":{"stringUnit":{"state":"translated","value":"Bu Gateway ana makinesinde belirteç kurulumu gerekiyor"}},"uk":{"stringUnit":{"state":"translated","value":"На цьому хості Gateway потрібно налаштувати токен"}},"id":{"stringUnit":{"state":"translated","value":"Host Gateway ini memerlukan penyiapan token"}},"pl":{"stringUnit":{"state":"translated","value":"Ten host bramy wymaga skonfigurowania tokenu"}},"th":{"stringUnit":{"state":"translated","value":"โฮสต์ Gateway นี้ต้องตั้งค่าโทเค็น"}},"vi":{"stringUnit":{"state":"translated","value":"Máy chủ Gateway này cần thiết lập token"}},"nl":{"stringUnit":{"state":"translated","value":"Voor deze gatewayhost moet een token worden ingesteld"}},"fa":{"stringUnit":{"state":"translated","value":"این میزبان Gateway به تنظیم توکن نیاز دارد"}},"ru":{"stringUnit":{"state":"translated","value":"На этом хосте Gateway нужно настроить токен"}},"sv":{"stringUnit":{"state":"translated","value":"Den här Gateway-värden behöver en token konfigurerad"}}}},
    "This gateway is set to token auth, but no `gateway.auth.token` is configured on the gateway host. If the gateway uses an environment variable instead, set `OPENCLAW_GATEWAY_TOKEN` before starting the gateway.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This gateway is set to token auth, but no `gateway.auth.token` is configured on the gateway host. If the gateway uses an environment variable instead, set `OPENCLAW_GATEWAY_TOKEN` before starting the gateway."}},"zh-CN":{"stringUnit":{"state":"translated","value":"此 Gateway 已设置为使用令牌身份验证，但 Gateway 主机上未配置 `gateway.auth.token`。如果 Gateway 改用环境变量，请在启动 Gateway 前设置 `OPENCLAW_GATEWAY_TOKEN`。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此 Gateway 已設為使用權杖驗證，但 Gateway 主機上尚未設定 `gateway.auth.token`。如果 Gateway 改用環境變數，請在啟動 Gateway 前設定 `OPENCLAW_GATEWAY_TOKEN`。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Este Gateway está configurado para autenticação por token, mas nenhum `gateway.auth.token` está configurado no host do Gateway. Se o Gateway usar uma variável de ambiente, defina `OPENCLAW_GATEWAY_TOKEN` antes de iniciar o Gateway."}},"de":{"stringUnit":{"state":"translated","value":"Dieses Gateway ist auf Token-Authentifizierung eingestellt, aber auf dem Gateway-Host ist kein `gateway.auth.token` konfiguriert. Wenn das Gateway stattdessen eine Umgebungsvariable verwendet, setzen Sie `OPENCLAW_GATEWAY_TOKEN`, bevor Sie das Gateway starten."}},"es":{"stringUnit":{"state":"translated","value":"Este Gateway está configurado para usar autenticación por token, pero no se ha configurado `gateway.auth.token` en el host del Gateway. Si el Gateway utiliza una variable de entorno en su lugar, configura `OPENCLAW_GATEWAY_TOKEN` antes de iniciar el Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このGatewayはトークン認証に設定されていますが、Gatewayホストに`gateway.auth.token`が設定されていません。Gatewayが代わりに環境変数を使用する場合は、Gatewayを起動する前に`OPENCLAW_GATEWAY_TOKEN`を設定してください。"}},"ko":{"stringUnit":{"state":"translated","value":"이 Gateway는 토큰 인증을 사용하도록 설정되어 있지만, Gateway 호스트에 `gateway.auth.token`이 설정되어 있지 않습니다. Gateway가 대신 환경 변수를 사용하는 경우, Gateway를 시작하기 전에 `OPENCLAW_GATEWAY_TOKEN`을 설정하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Ce Gateway utilise l’authentification par jeton, mais aucun `gateway.auth.token` n’est configuré sur son hôte. Si le Gateway utilise plutôt une variable d’environnement, définissez `OPENCLAW_GATEWAY_TOKEN` avant de démarrer le Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"यह Gateway टोकन प्रमाणीकरण के लिए सेट है, लेकिन Gateway होस्ट पर `gateway.auth.token` कॉन्फ़िगर नहीं किया गया है. अगर Gateway इसके बजाय एनवायरनमेंट वेरिएबल का उपयोग करता है, तो Gateway शुरू करने से पहले `OPENCLAW_GATEWAY_TOKEN` सेट करें."}},"ar":{"stringUnit":{"state":"translated","value":"تم ضبط Gateway هذا لاستخدام المصادقة بالرمز، لكن `gateway.auth.token` غير مضبوط على مضيف Gateway. إذا كان Gateway يستخدم متغير بيئة بدلاً من ذلك، فاضبط `OPENCLAW_GATEWAY_TOKEN` قبل تشغيل Gateway."}},"it":{"stringUnit":{"state":"translated","value":"Questo gateway è impostato per l'autenticazione tramite token, ma sull'host del gateway non è configurato `gateway.auth.token`. Se il gateway utilizza invece una variabile d'ambiente, imposta `OPENCLAW_GATEWAY_TOKEN` prima di avviare il gateway."}},"tr":{"stringUnit":{"state":"translated","value":"Bu Gateway belirteçle kimlik doğrulama kullanacak şekilde ayarlanmış, ancak Gateway ana makinesinde `gateway.auth.token` yapılandırılmamış. Gateway bunun yerine bir ortam değişkeni kullanıyorsa Gateway'i başlatmadan önce `OPENCLAW_GATEWAY_TOKEN` değişkenini ayarlayın."}},"uk":{"stringUnit":{"state":"translated","value":"Цей Gateway налаштовано на автентифікацію за токеном, але на хості Gateway не налаштовано `gateway.auth.token`. Якщо Gateway натомість використовує змінну середовища, задайте `OPENCLAW_GATEWAY_TOKEN` перед запуском Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Gateway ini diatur untuk menggunakan autentikasi token, tetapi `gateway.auth.token` belum dikonfigurasi pada host Gateway. Jika Gateway menggunakan variabel lingkungan sebagai gantinya, atur `OPENCLAW_GATEWAY_TOKEN` sebelum memulai Gateway."}},"pl":{"stringUnit":{"state":"translated","value":"Ta brama jest ustawiona na uwierzytelnianie tokenem, ale na hoście bramy nie skonfigurowano `gateway.auth.token`. Jeśli brama korzysta zamiast tego ze zmiennej środowiskowej, ustaw `OPENCLAW_GATEWAY_TOKEN` przed uruchomieniem bramy."}},"th":{"stringUnit":{"state":"translated","value":"Gateway นี้ตั้งค่าให้ยืนยันตัวตนด้วยโทเค็น แต่ยังไม่ได้กำหนดค่า `gateway.auth.token` บนโฮสต์ Gateway หาก Gateway ใช้ตัวแปรสภาพแวดล้อมแทน ให้ตั้งค่า `OPENCLAW_GATEWAY_TOKEN` ก่อนเริ่ม Gateway."}},"vi":{"stringUnit":{"state":"translated","value":"Gateway này được thiết lập để xác thực bằng token, nhưng chưa cấu hình `gateway.auth.token` trên máy chủ Gateway. Nếu Gateway sử dụng biến môi trường thay thế, hãy đặt `OPENCLAW_GATEWAY_TOKEN` trước khi khởi động Gateway."}},"nl":{"stringUnit":{"state":"translated","value":"Deze gateway is ingesteld op tokenauthenticatie, maar er is geen `gateway.auth.token` geconfigureerd op de gatewayhost. Als de gateway in plaats daarvan een omgevingsvariabele gebruikt, stel dan `OPENCLAW_GATEWAY_TOKEN` in voordat je de gateway start."}},"fa":{"stringUnit":{"state":"translated","value":"این Gateway برای احراز هویت با توکن تنظیم شده است، اما `gateway.auth.token` روی میزبان Gateway پیکربندی نشده است. اگر Gateway به‌جای آن از متغیر محیطی استفاده می‌کند، پیش از شروع Gateway، متغیر `OPENCLAW_GATEWAY_TOKEN` را تنظیم کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Этот Gateway настроен на аутентификацию по токену, но на хосте Gateway не настроен `gateway.auth.token`. Если Gateway использует вместо него переменную окружения, задайте `OPENCLAW_GATEWAY_TOKEN` перед запуском Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Den här Gateway är inställd på tokenautentisering, men ingen `gateway.auth.token` har konfigurerats på Gateway-värden. Om Gateway använder en miljövariabel i stället anger du `OPENCLAW_GATEWAY_TOKEN` innan du startar Gateway."}}}},
    "This gateway requires an auth token": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This gateway requires an auth token"}},"zh-CN":{"stringUnit":{"state":"translated","value":"此 Gateway 需要身份验证令牌"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此 Gateway 需要驗證權杖"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Este Gateway exige um token de autenticação"}},"de":{"stringUnit":{"state":"translated","value":"Dieses Gateway benötigt ein Authentifizierungstoken"}},"es":{"stringUnit":{"state":"translated","value":"Este Gateway requiere un token de autenticación"}},"ja-JP":{"stringUnit":{"state":"translated","value":"このGatewayには認証トークンが必要です"}},"ko":{"stringUnit":{"state":"translated","value":"이 Gateway에는 인증 토큰이 필요합니다"}},"fr":{"stringUnit":{"state":"translated","value":"Ce Gateway nécessite un jeton d’authentification"}},"hi":{"stringUnit":{"state":"translated","value":"इस Gateway के लिए प्रमाणीकरण टोकन आवश्यक है"}},"ar":{"stringUnit":{"state":"translated","value":"يتطلب Gateway هذا رمز مصادقة"}},"it":{"stringUnit":{"state":"translated","value":"Questo gateway richiede un token di autenticazione"}},"tr":{"stringUnit":{"state":"translated","value":"Bu Gateway bir kimlik doğrulama belirteci gerektiriyor"}},"uk":{"stringUnit":{"state":"translated","value":"Цей Gateway потребує токена автентифікації"}},"id":{"stringUnit":{"state":"translated","value":"Gateway ini memerlukan token autentikasi"}},"pl":{"stringUnit":{"state":"translated","value":"Ta brama wymaga tokenu uwierzytelniającego"}},"th":{"stringUnit":{"state":"translated","value":"Gateway นี้ต้องใช้โทเค็นยืนยันตัวตน"}},"vi":{"stringUnit":{"state":"translated","value":"Gateway này yêu cầu token xác thực"}},"nl":{"stringUnit":{"state":"translated","value":"Deze gateway vereist een authenticatietoken"}},"fa":{"stringUnit":{"state":"translated","value":"این Gateway به توکن احراز هویت نیاز دارد"}},"ru":{"stringUnit":{"state":"translated","value":"Для этого Gateway требуется токен аутентификации"}},"sv":{"stringUnit":{"state":"translated","value":"Den här Gateway kräver en autentiseringstoken"}}}},
    "This gateway requires an auth token. Run openclaw gateway auth-token --show on the gateway host.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This gateway requires an auth token. Run openclaw gateway auth-token --show on the gateway host."}},"zh-CN":{"stringUnit":{"state":"translated","value":"此 Gateway 需要身份验证令牌。请在 Gateway 主机上运行 openclaw gateway auth-token --show。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此 Gateway 需要驗證權杖。請在 Gateway 主機上執行 openclaw gateway auth-token --show。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Este Gateway exige um token de autenticação. Execute openclaw gateway auth-token --show no host do Gateway."}},"de":{"stringUnit":{"state":"translated","value":"Dieses Gateway benötigt ein Authentifizierungstoken. Führen Sie openclaw gateway auth-token --show auf dem Gateway-Host aus."}},"es":{"stringUnit":{"state":"translated","value":"Este Gateway requiere un token de autenticación. Ejecuta openclaw gateway auth-token --show en el host del Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このGatewayには認証トークンが必要です。Gatewayホストでopenclaw gateway auth-token --showを実行してください。"}},"ko":{"stringUnit":{"state":"translated","value":"이 Gateway에는 인증 토큰이 필요합니다. Gateway 호스트에서 openclaw gateway auth-token --show를 실행하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Ce Gateway nécessite un jeton d’authentification. Exécutez openclaw gateway auth-token --show sur l’hôte du Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"इस Gateway के लिए प्रमाणीकरण टोकन आवश्यक है. Gateway होस्ट पर openclaw gateway auth-token --show चलाएँ."}},"ar":{"stringUnit":{"state":"translated","value":"يتطلب Gateway هذا رمز مصادقة. شغّل openclaw gateway auth-token --show على مضيف Gateway."}},"it":{"stringUnit":{"state":"translated","value":"Questo gateway richiede un token di autenticazione. Esegui openclaw gateway auth-token --show sull'host del gateway."}},"tr":{"stringUnit":{"state":"translated","value":"Bu Gateway bir kimlik doğrulama belirteci gerektiriyor. Gateway ana makinesinde openclaw gateway auth-token --show komutunu çalıştırın."}},"uk":{"stringUnit":{"state":"translated","value":"Цей Gateway потребує токена автентифікації. Виконайте openclaw gateway auth-token --show на хості Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Gateway ini memerlukan token autentikasi. Jalankan openclaw gateway auth-token --show pada host Gateway."}},"pl":{"stringUnit":{"state":"translated","value":"Ta brama wymaga tokenu uwierzytelniającego. Uruchom openclaw gateway auth-token --show na hoście bramy."}},"th":{"stringUnit":{"state":"translated","value":"Gateway นี้ต้องใช้โทเค็นยืนยันตัวตน เรียกใช้ openclaw gateway auth-token --show บนโฮสต์ Gateway."}},"vi":{"stringUnit":{"state":"translated","value":"Gateway này yêu cầu token xác thực. Chạy openclaw gateway auth-token --show trên máy chủ Gateway."}},"nl":{"stringUnit":{"state":"translated","value":"Deze gateway vereist een authenticatietoken. Voer openclaw gateway auth-token --show uit op de gatewayhost."}},"fa":{"stringUnit":{"state":"translated","value":"این Gateway به توکن احراز هویت نیاز دارد. دستور openclaw gateway auth-token --show را روی میزبان Gateway اجرا کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Для этого Gateway требуется токен аутентификации. Выполните openclaw gateway auth-token --show на хосте Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Den här Gateway kräver en autentiseringstoken. Kör openclaw gateway auth-token --show på Gateway-värden."}}}},
    "This message ID already belongs to different or older work. Start a new message.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This message ID already belongs to different or older work. Start a new message."}},"zh-CN":{"stringUnit":{"state":"translated","value":"此消息 ID 已属于其他或较早的任务。请新建一条消息。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此訊息 ID 已屬於其他或較舊的工作。請建立新訊息。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Este ID de mensagem já pertence a um trabalho diferente ou anterior. Inicie uma nova mensagem."}},"de":{"stringUnit":{"state":"translated","value":"Diese Nachrichten-ID gehört bereits zu einem anderen oder älteren Vorgang. Beginnen Sie eine neue Nachricht."}},"es":{"stringUnit":{"state":"translated","value":"Este ID de mensaje ya pertenece a un trabajo diferente o anterior. Inicia un mensaje nuevo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このメッセージIDは、すでに別の作業または以前の作業に属しています。新しいメッセージを開始してください。"}},"ko":{"stringUnit":{"state":"translated","value":"이 메시지 ID는 이미 다른 작업이나 이전 작업에 속해 있습니다. 새 메시지를 시작하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Cet identifiant de message appartient déjà à une tâche différente ou antérieure. Créez un nouveau message."}},"hi":{"stringUnit":{"state":"translated","value":"यह संदेश ID पहले से किसी दूसरे या पुराने कार्य से जुड़ी है. नया संदेश शुरू करें."}},"ar":{"stringUnit":{"state":"translated","value":"معرّف الرسالة هذا مرتبط بالفعل بعمل آخر أو أقدم. ابدأ رسالة جديدة."}},"it":{"stringUnit":{"state":"translated","value":"Questo ID messaggio appartiene già a un'attività diversa o precedente. Inizia un nuovo messaggio."}},"tr":{"stringUnit":{"state":"translated","value":"Bu mesaj kimliği zaten farklı veya daha eski bir işe ait. Yeni bir mesaj başlatın."}},"uk":{"stringUnit":{"state":"translated","value":"Цей ідентифікатор повідомлення вже належить іншому або попередньому завданню. Створіть нове повідомлення."}},"id":{"stringUnit":{"state":"translated","value":"ID pesan ini sudah digunakan untuk pekerjaan lain atau yang lebih lama. Mulai pesan baru."}},"pl":{"stringUnit":{"state":"translated","value":"Ten identyfikator wiadomości należy już do innego lub wcześniejszego zadania. Rozpocznij nową wiadomość."}},"th":{"stringUnit":{"state":"translated","value":"รหัสข้อความนี้เป็นของงานอื่นหรืองานก่อนหน้าแล้ว โปรดเริ่มข้อความใหม่."}},"vi":{"stringUnit":{"state":"translated","value":"ID tin nhắn này đã thuộc về công việc khác hoặc cũ hơn. Hãy bắt đầu một tin nhắn mới."}},"nl":{"stringUnit":{"state":"translated","value":"Deze bericht-ID hoort al bij ander of ouder werk. Begin een nieuw bericht."}},"fa":{"stringUnit":{"state":"translated","value":"این شناسهٔ پیام از قبل به کاری دیگر یا قدیمی‌تر تعلق دارد. پیام جدیدی شروع کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Этот идентификатор сообщения уже относится к другой или более ранней задаче. Создайте новое сообщение."}},"sv":{"stringUnit":{"state":"translated","value":"Det här meddelande-ID:t tillhör redan ett annat eller äldre arbete. Starta ett nytt meddelande."}}}},
    "This node is requesting updated capabilities.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This node is requesting updated capabilities."}},"zh-CN":{"stringUnit":{"state":"translated","value":"此节点正在请求更新能力。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此節點正要求更新功能權限。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Este nó está solicitando capacidades atualizadas."}},"de":{"stringUnit":{"state":"translated","value":"Dieser Knoten fordert aktualisierte Berechtigungen an."}},"es":{"stringUnit":{"state":"translated","value":"Este nodo solicita capacidades actualizadas."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このノードは権限の更新を要求しています。"}},"ko":{"stringUnit":{"state":"translated","value":"이 노드가 기능 업데이트를 요청하고 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Ce nœud demande une mise à jour de ses capacités."}},"hi":{"stringUnit":{"state":"translated","value":"यह नोड अपडेट की गई क्षमताओं का अनुरोध कर रहा है।"}},"ar":{"stringUnit":{"state":"translated","value":"تطلب هذه العقدة إمكانات محدّثة."}},"it":{"stringUnit":{"state":"translated","value":"Questo nodo richiede funzionalità aggiornate."}},"tr":{"stringUnit":{"state":"translated","value":"Bu düğüm, yeteneklerinin güncellenmesini talep ediyor."}},"uk":{"stringUnit":{"state":"translated","value":"Цей вузол запитує оновлені можливості."}},"id":{"stringUnit":{"state":"translated","value":"Simpul ini meminta pembaruan kemampuan."}},"pl":{"stringUnit":{"state":"translated","value":"Ten węzeł żąda aktualizacji uprawnień."}},"th":{"stringUnit":{"state":"translated","value":"โหนดนี้กำลังร้องขอการอัปเดตความสามารถ"}},"vi":{"stringUnit":{"state":"translated","value":"Nút này đang yêu cầu cập nhật các khả năng."}},"nl":{"stringUnit":{"state":"translated","value":"Dit knooppunt vraagt om bijgewerkte mogelijkheden."}},"fa":{"stringUnit":{"state":"translated","value":"این گره درخواست به‌روزرسانی قابلیت‌ها را دارد."}},"ru":{"stringUnit":{"state":"translated","value":"Этот узел запрашивает обновлённые возможности."}},"sv":{"stringUnit":{"state":"translated","value":"Den här noden begär uppdaterade funktioner."}}}},
    "This process looks expected for the current mode. Kill anyway?": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This process looks expected for the current mode. Kill anyway?"}},"zh-CN":{"stringUnit":{"state":"translated","value":"此进程看起来符合当前模式的预期。 仍要终止吗？"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此程序看起來符合目前模式的預期。 仍要終止嗎？"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Este processo parece ser esperado para o modo atual. Encerrar mesmo assim?"}},"de":{"stringUnit":{"state":"translated","value":"Dieser Prozess scheint für den aktuellen Modus vorgesehen zu sein. Trotzdem beenden?"}},"es":{"stringUnit":{"state":"translated","value":"Este proceso parece normal para el modo actual. ¿Finalizar de todos modos?"}},"ja-JP":{"stringUnit":{"state":"translated","value":"このプロセスは現在のモードでは正常と思われます。それでも強制終了しますか？"}},"ko":{"stringUnit":{"state":"translated","value":"이 프로세스는 현재 모드에서 정상적인 것으로 보입니다. 그래도 강제 종료하시겠습니까?"}},"fr":{"stringUnit":{"state":"translated","value":"Ce processus semble normal pour le mode actuel. Le terminer quand même ?"}},"hi":{"stringUnit":{"state":"translated","value":"यह प्रक्रिया मौजूदा मोड के लिए अपेक्षित लगती है। फिर भी समाप्त करें?"}},"ar":{"stringUnit":{"state":"translated","value":"تبدو هذه العملية متوقعة في الوضع الحالي. هل تريد إنهاءها على أي حال؟"}},"it":{"stringUnit":{"state":"translated","value":"Questo processo sembra previsto per la modalità corrente. Terminarlo comunque?"}},"tr":{"stringUnit":{"state":"translated","value":"Bu işlem mevcut mod için beklenen bir işlem gibi görünüyor. Yine de sonlandırılsın mı?"}},"uk":{"stringUnit":{"state":"translated","value":"Цей процес виглядає очікуваним для поточного режиму. Усе одно примусово завершити?"}},"id":{"stringUnit":{"state":"translated","value":"Proses ini tampaknya sesuai dengan mode saat ini. Tetap hentikan paksa?"}},"pl":{"stringUnit":{"state":"translated","value":"Ten proces wygląda na oczekiwany w bieżącym trybie. Zakończyć go mimo to?"}},"th":{"stringUnit":{"state":"translated","value":"กระบวนการนี้ดูเหมือนจะทำงานตามปกติสำหรับโหมดปัจจุบัน. ต้องการบังคับหยุดอยู่ดีหรือไม่?"}},"vi":{"stringUnit":{"state":"translated","value":"Tiến trình này có vẻ phù hợp với chế độ hiện tại. Vẫn buộc dừng?"}},"nl":{"stringUnit":{"state":"translated","value":"Dit proces lijkt normaal voor de huidige modus. Toch geforceerd stoppen?"}},"fa":{"stringUnit":{"state":"translated","value":"به نظر می‌رسد این فرایند برای حالت فعلی مورد انتظار است. با این حال متوقف شود؟"}},"ru":{"stringUnit":{"state":"translated","value":"Этот процесс выглядит ожидаемым для текущего режима. Всё равно завершить?"}},"sv":{"stringUnit":{"state":"translated","value":"Den här processen verkar vara förväntad i det aktuella läget. Tvångsavsluta ändå?"}}}},
    "This resets the conversation for %@. The session key stays the same.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This resets the conversation for %@. The session key stays the same."}},"zh-CN":{"stringUnit":{"state":"translated","value":"这将重置 %@ 的对话。 会话密钥保持不变。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"這會重設 %@ 的對話。 工作階段金鑰保持不變。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Isso reinicia a conversa de %@. A chave da sessão permanece a mesma."}},"de":{"stringUnit":{"state":"translated","value":"Dadurch wird die Unterhaltung für %@ zurückgesetzt. Der Sitzungsschlüssel bleibt unverändert."}},"es":{"stringUnit":{"state":"translated","value":"Esto restablece la conversación de %@. La clave de sesión sigue siendo la misma."}},"ja-JP":{"stringUnit":{"state":"translated","value":"%@の会話がリセットされます。セッションキーは変わりません。"}},"ko":{"stringUnit":{"state":"translated","value":"%@의 대화가 초기화됩니다. 세션 키는 그대로 유지됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Cette action réinitialise la conversation pour %@. La clé de session reste identique."}},"hi":{"stringUnit":{"state":"translated","value":"इससे %@ की बातचीत रीसेट हो जाएगी। सत्र कुंजी वही रहेगी।"}},"ar":{"stringUnit":{"state":"translated","value":"سيؤدي هذا إلى إعادة تعيين المحادثة لـ %@. سيبقى مفتاح الجلسة كما هو."}},"it":{"stringUnit":{"state":"translated","value":"Questa operazione reimposta la conversazione per %@. La chiave di sessione rimane la stessa."}},"tr":{"stringUnit":{"state":"translated","value":"Bu, %@ için konuşmayı sıfırlar. Oturum anahtarı aynı kalır."}},"uk":{"stringUnit":{"state":"translated","value":"Це скине розмову для %@. Ключ сеансу залишиться незмінним."}},"id":{"stringUnit":{"state":"translated","value":"Ini mengatur ulang percakapan untuk %@. Kunci sesi tetap sama."}},"pl":{"stringUnit":{"state":"translated","value":"Spowoduje to zresetowanie rozmowy dla %@. Klucz sesji pozostanie bez zmian."}},"th":{"stringUnit":{"state":"translated","value":"การดำเนินการนี้จะรีเซ็ตการสนทนาสำหรับ %@. คีย์เซสชันจะยังคงเดิม."}},"vi":{"stringUnit":{"state":"translated","value":"Thao tác này đặt lại cuộc trò chuyện cho %@. Khóa phiên vẫn giữ nguyên."}},"nl":{"stringUnit":{"state":"translated","value":"Dit stelt het gesprek voor %@ opnieuw in. De sessiesleutel blijft hetzelfde."}},"fa":{"stringUnit":{"state":"translated","value":"این کار گفتگوی %@ را بازنشانی می‌کند. کلید نشست بدون تغییر می‌ماند."}},"ru":{"stringUnit":{"state":"translated","value":"Это сбросит переписку для %@. Ключ сеанса останется прежним."}},"sv":{"stringUnit":{"state":"translated","value":"Detta återställer konversationen för %@. Sessionsnyckeln förblir densamma."}}}},
    "This setup code is no longer valid": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This setup code is no longer valid"}},"zh-CN":{"stringUnit":{"state":"translated","value":"此设置码已失效"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此設定代碼已失效"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Este código de configuração não é mais válido"}},"de":{"stringUnit":{"state":"translated","value":"Dieser Einrichtungscode ist nicht mehr gültig"}},"es":{"stringUnit":{"state":"translated","value":"Este código de configuración ya no es válido"}},"ja-JP":{"stringUnit":{"state":"translated","value":"このセットアップコードは無効になりました"}},"ko":{"stringUnit":{"state":"translated","value":"이 설정 코드는 더 이상 유효하지 않습니다"}},"fr":{"stringUnit":{"state":"translated","value":"Ce code de configuration n’est plus valide"}},"hi":{"stringUnit":{"state":"translated","value":"यह सेटअप कोड अब मान्य नहीं है"}},"ar":{"stringUnit":{"state":"translated","value":"لم يعد رمز الإعداد هذا صالحًا"}},"it":{"stringUnit":{"state":"translated","value":"Questo codice di configurazione non è più valido"}},"tr":{"stringUnit":{"state":"translated","value":"Bu kurulum kodu artık geçerli değil"}},"uk":{"stringUnit":{"state":"translated","value":"Цей код налаштування більше не дійсний"}},"id":{"stringUnit":{"state":"translated","value":"Kode penyiapan ini tidak lagi valid"}},"pl":{"stringUnit":{"state":"translated","value":"Ten kod konfiguracji nie jest już ważny"}},"th":{"stringUnit":{"state":"translated","value":"รหัสตั้งค่านี้ใช้ไม่ได้แล้ว"}},"vi":{"stringUnit":{"state":"translated","value":"Mã thiết lập này không còn hợp lệ"}},"nl":{"stringUnit":{"state":"translated","value":"Deze installatiecode is niet meer geldig"}},"fa":{"stringUnit":{"state":"translated","value":"این کد راه‌اندازی دیگر معتبر نیست"}},"ru":{"stringUnit":{"state":"translated","value":"Этот код настройки больше недействителен"}},"sv":{"stringUnit":{"state":"translated","value":"Den här konfigurationskoden är inte längre giltig"}}}},
    "This thread cannot be archived while it is active or running.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This thread cannot be archived while it is active or running."}},"zh-CN":{"stringUnit":{"state":"translated","value":"此话题处于活动或运行状态时无法归档。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此討論串處於作用中或執行中時無法封存。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Esta conversa não pode ser arquivada enquanto estiver ativa ou em execução."}},"de":{"stringUnit":{"state":"translated","value":"Dieser Thread kann nicht archiviert werden, solange er aktiv ist oder ausgeführt wird."}},"es":{"stringUnit":{"state":"translated","value":"Este hilo no se puede archivar mientras esté activo o en ejecución."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このスレッドはアクティブまたは実行中のため、アーカイブできません。"}},"ko":{"stringUnit":{"state":"translated","value":"이 스레드가 활성 상태이거나 실행 중일 때는 보관할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Ce fil ne peut pas être archivé tant qu’il est actif ou en cours d’exécution."}},"hi":{"stringUnit":{"state":"translated","value":"इस थ्रेड के सक्रिय या चल रहे होने पर इसे संग्रहित नहीं किया जा सकता।"}},"ar":{"stringUnit":{"state":"translated","value":"لا يمكن أرشفة سلسلة المحادثة هذه وهي نشطة أو قيد التشغيل."}},"it":{"stringUnit":{"state":"translated","value":"Questa discussione non può essere archiviata mentre è attiva o in esecuzione."}},"tr":{"stringUnit":{"state":"translated","value":"Bu konuşma etkin durumdayken veya çalışırken arşivlenemez."}},"uk":{"stringUnit":{"state":"translated","value":"Цю гілку не можна архівувати, поки вона активна або виконується."}},"id":{"stringUnit":{"state":"translated","value":"Utas ini tidak dapat diarsipkan saat aktif atau berjalan."}},"pl":{"stringUnit":{"state":"translated","value":"Nie można zarchiwizować tego wątku, gdy jest aktywny lub uruchomiony."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถเก็บถาวรเธรดนี้ได้ขณะที่ยังใช้งานอยู่หรือกำลังทำงาน."}},"vi":{"stringUnit":{"state":"translated","value":"Không thể lưu trữ luồng này khi nó đang hoạt động hoặc đang chạy."}},"nl":{"stringUnit":{"state":"translated","value":"Dit gesprek kan niet worden gearchiveerd zolang het actief is of wordt uitgevoerd."}},"fa":{"stringUnit":{"state":"translated","value":"تا زمانی که این رشته‌گفتگو فعال یا در حال اجرا باشد، نمی‌توان آن را بایگانی کرد."}},"ru":{"stringUnit":{"state":"translated","value":"Эту ветку нельзя архивировать, пока она активна или выполняется."}},"sv":{"stringUnit":{"state":"translated","value":"Den här tråden kan inte arkiveras medan den är aktiv eller körs."}}}},
