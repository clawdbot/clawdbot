    "Check which process owns %lld and suggest fixes.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Check which process owns %lld and suggest fixes."}},"zh-CN":{"stringUnit":{"state":"translated","value":"检查哪个进程占用了 %lld 并提供修复建议。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"檢查哪個程序佔用了 %lld，並建議修正方式。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Verifique qual processo está usando %lld e sugira correções."}},"de":{"stringUnit":{"state":"translated","value":"Prüfen Sie, welcher Prozess %lld belegt, und schlagen Sie Lösungen vor."}},"es":{"stringUnit":{"state":"translated","value":"Comprueba qué proceso utiliza %lld y sugiere soluciones."}},"ja-JP":{"stringUnit":{"state":"translated","value":"%lldを使用しているプロセスを確認し、解決策を提案します。"}},"ko":{"stringUnit":{"state":"translated","value":"%lld을(를) 점유한 프로세스를 확인하고 해결 방법을 제안하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Vérifier quel processus utilise %lld et suggérer des solutions."}},"hi":{"stringUnit":{"state":"translated","value":"जाँचें कि %lld किस प्रक्रिया के नियंत्रण में है और समाधान सुझाएँ."}},"ar":{"stringUnit":{"state":"translated","value":"تحقق من العملية التي تستخدم %lld واقترح حلولًا."}},"it":{"stringUnit":{"state":"translated","value":"Verifica quale processo occupa %lld e suggerisci soluzioni."}},"tr":{"stringUnit":{"state":"translated","value":"%lld bağlantı noktasını hangi işlemin kullandığını kontrol edin ve çözüm önerileri sunun."}},"uk":{"stringUnit":{"state":"translated","value":"Перевірити, який процес використовує %lld, і запропонувати способи виправлення."}},"id":{"stringUnit":{"state":"translated","value":"Periksa proses yang menggunakan %lld dan sarankan perbaikan."}},"pl":{"stringUnit":{"state":"translated","value":"Sprawdź, który proces zajmuje %lld, i zaproponuj rozwiązania."}},"th":{"stringUnit":{"state":"translated","value":"ตรวจสอบว่ากระบวนการใดเป็นเจ้าของ %lld และแนะนำวิธีแก้ไข."}},"vi":{"stringUnit":{"state":"translated","value":"Kiểm tra tiến trình nào đang sử dụng %lld và đề xuất cách khắc phục."}},"nl":{"stringUnit":{"state":"translated","value":"Controleer welk proces %lld gebruikt en stel oplossingen voor."}},"fa":{"stringUnit":{"state":"translated","value":"بررسی کنید کدام فرایند مالک %lld است و راهکارهایی پیشنهاد دهید."}},"ru":{"stringUnit":{"state":"translated","value":"Проверьте, какой процесс использует %lld, и предложите способы исправления."}},"sv":{"stringUnit":{"state":"translated","value":"Kontrollera vilken process som äger %lld och föreslå lösningar."}}}},
    "Checking CLI logins, saved API keys, and local model servers on the Gateway.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Checking CLI logins, saved API keys, and local model servers on the Gateway."}},"zh-CN":{"stringUnit":{"state":"translated","value":"正在检查 Gateway 上的 CLI 登录状态、已保存的 API 密钥和本地模型服务器。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"正在檢查 Gateway 上的 CLI 登入資訊、已儲存的 API 金鑰及本機模型伺服器。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Verificando logins da CLI, chaves de API salvas e servidores de modelos locais no Gateway."}},"de":{"stringUnit":{"state":"translated","value":"CLI-Anmeldungen, gespeicherte API-Schlüssel und lokale Modellserver auf dem Gateway werden geprüft."}},"es":{"stringUnit":{"state":"translated","value":"Comprobando los inicios de sesión de la CLI, las claves de API guardadas y los servidores de modelos locales en el Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gateway上のCLIログイン、保存済みAPIキー、ローカルモデルサーバーを確認中。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway에서 CLI 로그인, 저장된 API 키 및 로컬 모델 서버를 확인하는 중입니다."}},"fr":{"stringUnit":{"state":"translated","value":"Vérification des connexions CLI, des clés API enregistrées et des serveurs de modèles locaux sur le Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway पर CLI लॉगिन, सहेजी गई API कुंजियों और स्थानीय मॉडल सर्वरों की जाँच जारी है."}},"ar":{"stringUnit":{"state":"translated","value":"جارٍ التحقق من تسجيلات الدخول عبر CLI ومفاتيح API المحفوظة وخوادم النماذج المحلية على Gateway."}},"it":{"stringUnit":{"state":"translated","value":"Verifica degli accessi CLI, delle chiavi API salvate e dei server di modelli locali sul Gateway in corso."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway üzerindeki CLI oturumları, kayıtlı API anahtarları ve yerel model sunucuları kontrol ediliyor."}},"uk":{"stringUnit":{"state":"translated","value":"Перевірка авторизацій у CLI, збережених ключів API та локальних серверів моделей на Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Memeriksa login CLI, kunci API yang tersimpan, dan server model lokal di Gateway."}},"pl":{"stringUnit":{"state":"translated","value":"Sprawdzanie logowań CLI, zapisanych kluczy API i lokalnych serwerów modeli na Gateway."}},"th":{"stringUnit":{"state":"translated","value":"กำลังตรวจสอบการเข้าสู่ระบบ CLI, คีย์ API ที่บันทึกไว้ และเซิร์ฟเวอร์โมเดลภายในเครื่องบน Gateway."}},"vi":{"stringUnit":{"state":"translated","value":"Đang kiểm tra thông tin đăng nhập CLI, khóa API đã lưu và máy chủ mô hình cục bộ trên Gateway."}},"nl":{"stringUnit":{"state":"translated","value":"CLI-aanmeldingen, opgeslagen API-sleutels en lokale modelservers op de Gateway worden gecontroleerd."}},"fa":{"stringUnit":{"state":"translated","value":"در حال بررسی ورودهای CLI، کلیدهای API ذخیره‌شده و سرورهای مدل محلی در Gateway."}},"ru":{"stringUnit":{"state":"translated","value":"Проверка авторизации в CLI, сохранённых ключей API и локальных серверов моделей на Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Kontrollerar CLI-inloggningar, sparade API-nycklar och lokala modellservrar på Gateway."}}}},
    "Checking remote gateway…": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Checking remote gateway…"}},"zh-CN":{"stringUnit":{"state":"translated","value":"正在检查远程 Gateway…"}},"zh-TW":{"stringUnit":{"state":"translated","value":"正在檢查遠端 Gateway…"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Verificando o Gateway remoto…"}},"de":{"stringUnit":{"state":"translated","value":"Entferntes Gateway wird geprüft…"}},"es":{"stringUnit":{"state":"translated","value":"Comprobando el Gateway remoto…"}},"ja-JP":{"stringUnit":{"state":"translated","value":"リモートGatewayを確認中…"}},"ko":{"stringUnit":{"state":"translated","value":"원격 Gateway 확인 중…"}},"fr":{"stringUnit":{"state":"translated","value":"Vérification du Gateway distant…"}},"hi":{"stringUnit":{"state":"translated","value":"रिमोट Gateway जाँचा जा रहा है…"}},"ar":{"stringUnit":{"state":"translated","value":"جارٍ التحقق من Gateway البعيد…"}},"it":{"stringUnit":{"state":"translated","value":"Verifica del Gateway remoto…"}},"tr":{"stringUnit":{"state":"translated","value":"Uzak Gateway kontrol ediliyor…"}},"uk":{"stringUnit":{"state":"translated","value":"Перевірка віддаленого Gateway…"}},"id":{"stringUnit":{"state":"translated","value":"Memeriksa Gateway jarak jauh…"}},"pl":{"stringUnit":{"state":"translated","value":"Sprawdzanie zdalnego Gateway…"}},"th":{"stringUnit":{"state":"translated","value":"กำลังตรวจสอบ Gateway ระยะไกล…"}},"vi":{"stringUnit":{"state":"translated","value":"Đang kiểm tra Gateway từ xa…"}},"nl":{"stringUnit":{"state":"translated","value":"Externe Gateway controleren…"}},"fa":{"stringUnit":{"state":"translated","value":"در حال بررسی Gateway راه دور…"}},"ru":{"stringUnit":{"state":"translated","value":"Проверка удалённого Gateway…"}},"sv":{"stringUnit":{"state":"translated","value":"Kontrollerar fjärransluten Gateway…"}}}},
    "Checking the Mac app and Gateway…": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Checking the Mac app and Gateway…"}},"zh-CN":{"stringUnit":{"state":"translated","value":"正在检查 Mac 应用和 Gateway…"}},"zh-TW":{"stringUnit":{"state":"translated","value":"正在檢查 Mac 應用程式與 Gateway…"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Verificando o app para Mac e o Gateway…"}},"de":{"stringUnit":{"state":"translated","value":"Mac-App und Gateway werden geprüft…"}},"es":{"stringUnit":{"state":"translated","value":"Comprobando la app para Mac y el Gateway…"}},"ja-JP":{"stringUnit":{"state":"translated","value":"MacアプリとGatewayを確認中…"}},"ko":{"stringUnit":{"state":"translated","value":"Mac 앱과 Gateway 확인 중…"}},"fr":{"stringUnit":{"state":"translated","value":"Vérification de l’app Mac et du Gateway…"}},"hi":{"stringUnit":{"state":"translated","value":"Mac ऐप और Gateway जाँचे जा रहे हैं…"}},"ar":{"stringUnit":{"state":"translated","value":"جارٍ التحقق من تطبيق Mac وGateway…"}},"it":{"stringUnit":{"state":"translated","value":"Verifica dell'app per Mac e del Gateway…"}},"tr":{"stringUnit":{"state":"translated","value":"Mac uygulaması ve Gateway kontrol ediliyor…"}},"uk":{"stringUnit":{"state":"translated","value":"Перевірка застосунку для Mac і Gateway…"}},"id":{"stringUnit":{"state":"translated","value":"Memeriksa aplikasi Mac dan Gateway…"}},"pl":{"stringUnit":{"state":"translated","value":"Sprawdzanie aplikacji na Maca i Gateway…"}},"th":{"stringUnit":{"state":"translated","value":"กำลังตรวจสอบแอป Mac และ Gateway…"}},"vi":{"stringUnit":{"state":"translated","value":"Đang kiểm tra ứng dụng Mac và Gateway…"}},"nl":{"stringUnit":{"state":"translated","value":"De Mac-app en Gateway controleren…"}},"fa":{"stringUnit":{"state":"translated","value":"در حال بررسی برنامهٔ Mac و Gateway…"}},"ru":{"stringUnit":{"state":"translated","value":"Проверка приложения для Mac и Gateway…"}},"sv":{"stringUnit":{"state":"translated","value":"Kontrollerar Mac-appen och Gateway…"}}}},
    "Choose Media File": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose Media File"}},"zh-CN":{"stringUnit":{"state":"translated","value":"选择媒体文件"}},"zh-TW":{"stringUnit":{"state":"translated","value":"選擇媒體檔案"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolher Arquivo de Mídia"}},"de":{"stringUnit":{"state":"translated","value":"Mediendatei auswählen"}},"es":{"stringUnit":{"state":"translated","value":"Elegir archivo multimedia"}},"ja-JP":{"stringUnit":{"state":"translated","value":"メディアファイルを選択"}},"ko":{"stringUnit":{"state":"translated","value":"미디어 파일 선택"}},"fr":{"stringUnit":{"state":"translated","value":"Choisir un fichier multimédia"}},"hi":{"stringUnit":{"state":"translated","value":"मीडिया फ़ाइल चुनें"}},"ar":{"stringUnit":{"state":"translated","value":"اختيار ملف وسائط"}},"it":{"stringUnit":{"state":"translated","value":"Scegli file multimediale"}},"tr":{"stringUnit":{"state":"translated","value":"Medya Dosyası Seç"}},"uk":{"stringUnit":{"state":"translated","value":"Вибрати медіафайл"}},"id":{"stringUnit":{"state":"translated","value":"Pilih File Media"}},"pl":{"stringUnit":{"state":"translated","value":"Wybierz plik multimedialny"}},"th":{"stringUnit":{"state":"translated","value":"เลือกไฟล์สื่อ"}},"vi":{"stringUnit":{"state":"translated","value":"Chọn tệp đa phương tiện"}},"nl":{"stringUnit":{"state":"translated","value":"Mediabestand kiezen"}},"fa":{"stringUnit":{"state":"translated","value":"انتخاب فایل رسانه‌ای"}},"ru":{"stringUnit":{"state":"translated","value":"Выбрать медиафайл"}},"sv":{"stringUnit":{"state":"translated","value":"Välj mediefil"}}}},
    "Choose another app before pasting.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose another app before pasting."}},"zh-CN":{"stringUnit":{"state":"translated","value":"粘贴前请选择另一个应用。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"貼上前請先選擇另一個應用程式。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolha outro app antes de colar."}},"de":{"stringUnit":{"state":"translated","value":"Wählen Sie vor dem Einfügen eine andere App."}},"es":{"stringUnit":{"state":"translated","value":"Elige otra app antes de pegar."}},"ja-JP":{"stringUnit":{"state":"translated","value":"貼り付ける前に別のアプリを選択してください。"}},"ko":{"stringUnit":{"state":"translated","value":"붙여넣기 전에 다른 앱을 선택하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez une autre app avant de coller."}},"hi":{"stringUnit":{"state":"translated","value":"पेस्ट करने से पहले कोई दूसरा ऐप चुनें."}},"ar":{"stringUnit":{"state":"translated","value":"اختر تطبيقًا آخر قبل اللصق."}},"it":{"stringUnit":{"state":"translated","value":"Scegli un'altra app prima di incollare."}},"tr":{"stringUnit":{"state":"translated","value":"Yapıştırmadan önce başka bir uygulama seçin."}},"uk":{"stringUnit":{"state":"translated","value":"Перед вставленням виберіть інший застосунок."}},"id":{"stringUnit":{"state":"translated","value":"Pilih aplikasi lain sebelum menempelkan."}},"pl":{"stringUnit":{"state":"translated","value":"Przed wklejeniem wybierz inną aplikację."}},"th":{"stringUnit":{"state":"translated","value":"เลือกแอปอื่นก่อนวาง."}},"vi":{"stringUnit":{"state":"translated","value":"Chọn ứng dụng khác trước khi dán."}},"nl":{"stringUnit":{"state":"translated","value":"Kies een andere app voordat je plakt."}},"fa":{"stringUnit":{"state":"translated","value":"پیش از جای‌گذاری، برنامهٔ دیگری انتخاب کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Выберите другое приложение перед вставкой."}},"sv":{"stringUnit":{"state":"translated","value":"Välj en annan app innan du klistrar in."}}}},
    "Choose any supported provider. OpenClaw asks before installing a provider plugin, then continues into its own sign-in or API-key flow and verifies a real reply.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose any supported provider. OpenClaw asks before installing a provider plugin, then continues into its own sign-in or API-key flow and verifies a real reply."}},"zh-CN":{"stringUnit":{"state":"translated","value":"选择任意受支持的提供商。OpenClaw 会在安装提供商插件前征求你的同意，然后继续完成该提供商的登录或 API 密钥配置流程，并验证能否收到真实回复。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"選擇任一支援的供應商。OpenClaw 會在安裝供應商外掛程式前徵求您的同意，接著進入該供應商的登入或 API 金鑰設定流程，並驗證實際回覆。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolha qualquer provedor compatível. O OpenClaw pede confirmação antes de instalar um plugin de provedor, depois segue para o fluxo de login ou de chave de API do próprio provedor e verifica uma resposta real."}},"de":{"stringUnit":{"state":"translated","value":"Wählen Sie einen beliebigen unterstützten Anbieter. OpenClaw fragt vor der Installation eines Anbieter-Plugins nach, führt dann durch die Anmeldung oder die Eingabe des API-Schlüssels beim Anbieter und überprüft eine tatsächliche Antwort."}},"es":{"stringUnit":{"state":"translated","value":"Elige cualquier proveedor compatible. OpenClaw te pide confirmación antes de instalar un plugin del proveedor, luego continúa con el proceso de inicio de sesión o de configuración de la clave de API de ese proveedor y verifica una respuesta real."}},"ja-JP":{"stringUnit":{"state":"translated","value":"対応しているプロバイダーを選択してください。OpenClawはプロバイダーのプラグインをインストールする前に確認し、その後、プロバイダー固有のサインインまたはAPIキーの設定手順に進み、実際の応答を検証します。"}},"ko":{"stringUnit":{"state":"translated","value":"지원되는 제공업체를 선택하세요. OpenClaw는 제공업체 플러그인을 설치하기 전에 확인을 요청한 다음, 해당 제공업체의 로그인 또는 API 키 설정 절차를 진행하고 실제 응답을 확인합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez un fournisseur pris en charge. OpenClaw vous demande confirmation avant d’installer un plugin de fournisseur, puis poursuit avec le parcours de connexion ou de saisie de clé API propre à ce fournisseur et vérifie qu’une réponse réelle est obtenue."}},"hi":{"stringUnit":{"state":"translated","value":"कोई भी समर्थित प्रदाता चुनें। OpenClaw प्रदाता का प्लगइन इंस्टॉल करने से पहले आपकी अनुमति माँगता है, फिर उस प्रदाता की साइन-इन या API कुंजी प्रक्रिया पर आगे बढ़ता है और वास्तविक उत्तर की पुष्टि करता है।"}},"ar":{"stringUnit":{"state":"translated","value":"اختر أي مزوّد مدعوم. يطلب OpenClaw موافقتك قبل تثبيت إضافة المزوّد، ثم يتابع خطوات تسجيل الدخول أو إدخال مفتاح API الخاصة بالمزوّد ويتحقق من تلقي رد فعلي."}},"it":{"stringUnit":{"state":"translated","value":"Scegli un fornitore supportato. OpenClaw chiede conferma prima di installare un plugin del fornitore, quindi prosegue con la relativa procedura di accesso o configurazione della chiave API e verifica una risposta effettiva."}},"tr":{"stringUnit":{"state":"translated","value":"Desteklenen herhangi bir sağlayıcıyı seçin. OpenClaw, sağlayıcı eklentisini yüklemeden önce onayınızı ister, ardından sağlayıcının kendi oturum açma veya API anahtarı akışına geçer ve gerçek bir yanıt alındığını doğrular."}},"uk":{"stringUnit":{"state":"translated","value":"Виберіть будь-якого підтримуваного постачальника. OpenClaw запитає дозвіл перед установленням плагіна постачальника, потім продовжить власну процедуру входу або введення ключа API та перевірить отримання справжньої відповіді."}},"id":{"stringUnit":{"state":"translated","value":"Pilih penyedia mana pun yang didukung. OpenClaw meminta izin sebelum menginstal plugin penyedia, lalu melanjutkan ke alur masuk atau kunci API milik penyedia tersebut dan memverifikasi balasan nyata."}},"pl":{"stringUnit":{"state":"translated","value":"Wybierz dowolnego obsługiwanego dostawcę. OpenClaw pyta o zgodę przed zainstalowaniem wtyczki dostawcy, a następnie przechodzi do logowania lub konfiguracji klucza API i weryfikuje rzeczywistą odpowiedź."}},"th":{"stringUnit":{"state":"translated","value":"เลือกผู้ให้บริการรายใดก็ได้ที่รองรับ OpenClaw จะขออนุญาตก่อนติดตั้งปลั๊กอินของผู้ให้บริการ จากนั้นจะดำเนินการต่อในขั้นตอนการลงชื่อเข้าหรือใช้คีย์ API ของผู้ให้บริการนั้น และตรวจสอบว่าได้รับคำตอบจริง"}},"vi":{"stringUnit":{"state":"translated","value":"Chọn bất kỳ nhà cung cấp nào được hỗ trợ. OpenClaw sẽ hỏi trước khi cài đặt plugin của nhà cung cấp, sau đó tiếp tục quy trình đăng nhập hoặc nhập khóa API của nhà cung cấp đó và xác minh bằng một phản hồi thực tế."}},"nl":{"stringUnit":{"state":"translated","value":"Kies een ondersteunde aanbieder. OpenClaw vraagt toestemming voordat het een plug-in voor de aanbieder installeert, gaat vervolgens verder met de aanmeldings- of API-sleutelprocedure van die aanbieder en controleert of er daadwerkelijk een antwoord komt."}},"fa":{"stringUnit":{"state":"translated","value":"یکی از ارائه‌دهندگان پشتیبانی‌شده را انتخاب کنید. OpenClaw پیش از نصب افزونهٔ ارائه‌دهنده از شما اجازه می‌گیرد، سپس روند ورود به حساب یا وارد کردن کلید API آن ارائه‌دهنده را ادامه می‌دهد و دریافت یک پاسخ واقعی را بررسی می‌کند."}},"ru":{"stringUnit":{"state":"translated","value":"Выберите любого поддерживаемого провайдера. OpenClaw запросит разрешение перед установкой плагина провайдера, затем предложит войти в аккаунт или указать API-ключ и проверит получение реального ответа."}},"sv":{"stringUnit":{"state":"translated","value":"Välj valfri leverantör som stöds. OpenClaw frågar innan ett leverantörstillägg installeras, fortsätter sedan med leverantörens eget flöde för inloggning eller API-nyckel och verifierar ett faktiskt svar."}}}},
    "Choose local or remote before the app can attach to a Gateway.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose local or remote before the app can attach to a Gateway."}},"zh-CN":{"stringUnit":{"state":"translated","value":"请选择本地或远程模式, 应用才能连接到 Gateway."}},"zh-TW":{"stringUnit":{"state":"translated","value":"請先選擇本機或遠端，應用程式才能連接至 Gateway."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolha local ou remoto para que o app possa se conectar a um Gateway."}},"de":{"stringUnit":{"state":"translated","value":"Wählen Sie lokal oder entfernt, bevor sich die App mit einem Gateway verbinden kann."}},"es":{"stringUnit":{"state":"translated","value":"Elige el modo local o remoto para que la app pueda conectarse a un Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"アプリをGatewayに接続するには、ローカルまたはリモートを選択してください。"}},"ko":{"stringUnit":{"state":"translated","value":"앱을 Gateway에 연결하려면 먼저 로컬 또는 원격을 선택하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez le mode local ou distant pour que l’app puisse se connecter à un Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"ऐप को Gateway से जोड़ने से पहले लोकल या रिमोट चुनें."}},"ar":{"stringUnit":{"state":"translated","value":"اختر الوضع المحلي أو البعيد قبل أن يتمكن التطبيق من الاتصال بـ Gateway."}},"it":{"stringUnit":{"state":"translated","value":"Scegli la modalità locale o remota prima che l'app possa connettersi a un Gateway."}},"tr":{"stringUnit":{"state":"translated","value":"Uygulamanın bir Gateway'e bağlanabilmesi için önce yerel veya uzak seçeneğini belirleyin."}},"uk":{"stringUnit":{"state":"translated","value":"Виберіть локальний або віддалений режим, перш ніж застосунок зможе підключитися до Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Pilih lokal atau jarak jauh sebelum aplikasi dapat terhubung ke Gateway."}},"pl":{"stringUnit":{"state":"translated","value":"Wybierz tryb lokalny lub zdalny, aby aplikacja mogła połączyć się z Gateway."}},"th":{"stringUnit":{"state":"translated","value":"เลือกแบบในเครื่องหรือระยะไกลก่อนที่แอปจะเชื่อมต่อกับ Gateway ได้."}},"vi":{"stringUnit":{"state":"translated","value":"Chọn cục bộ hoặc từ xa trước khi ứng dụng có thể kết nối với Gateway."}},"nl":{"stringUnit":{"state":"translated","value":"Kies lokaal of extern voordat de app verbinding kan maken met een Gateway."}},"fa":{"stringUnit":{"state":"translated","value":"پیش از اینکه برنامه بتواند به Gateway متصل شود، حالت محلی یا راه دور را انتخاب کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Выберите локальный или удалённый режим, чтобы приложение могло подключиться к Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Välj lokalt eller fjärranslutet läge innan appen kan ansluta till en Gateway."}}}},
    "Choose model and reasoning": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose model and reasoning"}},"zh-CN":{"stringUnit":{"state":"translated","value":"选择模型和推理设置"}},"zh-TW":{"stringUnit":{"state":"translated","value":"選擇模型與推理設定"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolher modelo e raciocínio"}},"de":{"stringUnit":{"state":"translated","value":"Modell und Denktiefe auswählen"}},"es":{"stringUnit":{"state":"translated","value":"Elegir modelo y razonamiento"}},"ja-JP":{"stringUnit":{"state":"translated","value":"モデルと推論を選択"}},"ko":{"stringUnit":{"state":"translated","value":"모델 및 추론 선택"}},"fr":{"stringUnit":{"state":"translated","value":"Choisir le modèle et le raisonnement"}},"hi":{"stringUnit":{"state":"translated","value":"मॉडल और तर्क-विचार चुनें"}},"ar":{"stringUnit":{"state":"translated","value":"اختيار النموذج والاستدلال"}},"it":{"stringUnit":{"state":"translated","value":"Scegli modello e ragionamento"}},"tr":{"stringUnit":{"state":"translated","value":"Model ve akıl yürütme seçin"}},"uk":{"stringUnit":{"state":"translated","value":"Вибрати модель і міркування"}},"id":{"stringUnit":{"state":"translated","value":"Pilih model dan penalaran"}},"pl":{"stringUnit":{"state":"translated","value":"Wybierz model i poziom rozumowania"}},"th":{"stringUnit":{"state":"translated","value":"เลือกโมเดลและการใช้เหตุผล"}},"vi":{"stringUnit":{"state":"translated","value":"Chọn mô hình và chế độ suy luận"}},"nl":{"stringUnit":{"state":"translated","value":"Model en redeneermodus kiezen"}},"fa":{"stringUnit":{"state":"translated","value":"انتخاب مدل و استدلال"}},"ru":{"stringUnit":{"state":"translated","value":"Выбрать модель и режим рассуждения"}},"sv":{"stringUnit":{"state":"translated","value":"Välj modell och resonemang"}}}},
