    "%lld gateways found on your network — click to choose one.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%lld gateways found on your network — click to choose one."}},"zh-CN":{"stringUnit":{"state":"translated","value":"在你的网络中发现 %lld 个 Gateway — 点击选择一个。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"在您的網路上找到 %lld 個 Gateway — 點擊以選擇一個。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"%lld gateways encontrados na sua rede — clique para escolher um."}},"de":{"stringUnit":{"state":"translated","value":"%lld Gateways in Ihrem Netzwerk gefunden — klicken Sie, um eines auszuwählen."}},"es":{"stringUnit":{"state":"translated","value":"Se encontraron %lld gateways en tu red — haz clic para elegir uno."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ネットワーク上に%lld個のGatewayが見つかりました — クリックして選択してください。"}},"ko":{"stringUnit":{"state":"translated","value":"네트워크에서 Gateway %lld개 발견 — 클릭하여 하나를 선택하세요."}},"fr":{"stringUnit":{"state":"translated","value":"%lld Gateway trouvés sur votre réseau — cliquez pour en choisir un."}},"hi":{"stringUnit":{"state":"translated","value":"आपके नेटवर्क पर %lld Gateway मिले — किसी एक को चुनने के लिए क्लिक करें."}},"ar":{"stringUnit":{"state":"translated","value":"تم العثور على %lld من بوابات Gateway على شبكتك — انقر لاختيار إحداها."}},"it":{"stringUnit":{"state":"translated","value":"%lld Gateway trovati sulla tua rete — fai clic per sceglierne uno."}},"tr":{"stringUnit":{"state":"translated","value":"Ağınızda %lld Gateway bulundu — birini seçmek için tıklayın."}},"uk":{"stringUnit":{"state":"translated","value":"У вашій мережі знайдено %lld Gateway — натисніть, щоб вибрати один."}},"id":{"stringUnit":{"state":"translated","value":"%lld Gateway ditemukan di jaringan Anda — klik untuk memilih salah satu."}},"pl":{"stringUnit":{"state":"translated","value":"Znaleziono %lld instancji Gateway w Twojej sieci — kliknij, aby wybrać jedną."}},"th":{"stringUnit":{"state":"translated","value":"พบ Gateway %lld รายกา