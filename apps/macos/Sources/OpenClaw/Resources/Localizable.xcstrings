    "system.run requests are denied unless the policy changes.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"system.run requests are denied unless the policy changes."}},"zh-CN":{"stringUnit":{"state":"translated","value":"除非策略更改，否则 system.run 请求将被拒绝。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"除非政策變更，否則 system.run requests 會遭拒絕。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Solicitações system.run são negadas, a menos que a política seja alterada."}},"de":{"stringUnit":{"state":"translated","value":"system.run-Anfragen werden abgelehnt, sofern sich die Richtlinie nicht ändert."}},"es":{"stringUnit":{"state":"translated","value":"Las solicitudes system.run se deniegan a menos que cambie la política."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ポリシーが変更されない限り、system.run リクエストは拒否されます。"}},"ko":{"stringUnit":{"state":"translated","value":"정책이 변경되지 않는 한 system.run 요청은 거부됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les requêtes system.run sont refusées sauf si la politique change."}},"hi":{"stringUnit":{"state":"translated","value":"जब तक नीति नहीं बदलती, system.run अनुरोध अस्वीकार किए जाते हैं।"}},"ar":{"stringUnit":{"state":"translated","value":"طلبات system.run مرفوضة ما لم تتغير السياسة."}},"it":{"stringUnit":{"state":"translated","value":"Le richieste system.run vengono rifiutate a meno che la policy non cambi."}},"tr":{"stringUnit":{"state":"translated","value":"İlke değişmediği sürece system.run istekleri reddedilir."}},"uk":{"stringUnit":{"state":"translated","value":"Запити system.run відхиляються, доки політика не зміниться."}},"id":{"stringUnit":{"state":"translated","value":"Permintaan system.run ditolak kecuali kebijakan berubah."}},"pl":{"stringUnit":{"state":"translated","value":"Żądania system.run są odrzucane, dopóki zasady się nie zmienią."}},"th":{"stringUnit":{"state":"translated","value":"คำขอ system.run จะถูกปฏิเสธ เว้นแต่นโยบายจะเปลี่ยนแปลง"}},"vi":{"stringUnit":{"state":"translate