    "Ask, create, and automate": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Ask, create, and automate"}},"zh-CN":{"stringUnit":{"state":"translated","value":"提问、创作和自动化"}},"zh-TW":{"stringUnit":{"state":"translated","value":"提問、創作與自動化"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Pergunte, crie e automatize"}},"de":{"stringUnit":{"state":"translated","value":"Fragen, erstellen und automatisieren"}},"es":{"stringUnit":{"state":"translated","value":"Pregunta, crea y automatiza"}},"ja-JP":{"stringUnit":{"state":"translated","value":"質問、作成、自動化"}},"ko":{"stringUnit":{"state":"translated","value":"질문하고, 만들고, 자동화하기"}},"fr":{"stringUnit":{"state":"translated","value":"Demandez, créez et automatisez"}},"hi":{"stringUnit":{"state":"translated","value":"पूछें, बनाएँ और ऑटोमेट करें"}},"ar":{"stringUnit":{"state":"translated","value":"اسأل وأنشئ وأتمت"}},"it":{"stringUnit":{"state":"translated","value":"Chiedi, crea e automatizza"}},"tr":{"stringUnit":{"state":"translated","value":"Sorun, oluşturun ve otomatikleştirin"}},"uk":{"stringUnit":{"state":"translated","value":"Запитуйте, створюйте й автоматизуйте"}},"id":{"stringUnit":{"state":"translated","value":"Bertanya, membuat, dan mengotomatiskan"}},"pl":{"stringUnit":{"state":"translated","value":"Pytaj, twórz i automatyzuj"}},"th":{"stringUnit":{"state":"translated","value":"ถาม สร้าง และทำงานอัตโนมัติ"}},"vi":{"stringUnit":{"state":"translated","value":"Hỏi, tạo và tự động hóa"}},"nl":{"stringUnit":{"state":"translated","value":"Vraag, creëer en automatiseer"}},"fa":{"stringUnit":{"state":"translated","value":"بپرسید، خلق کنید و خودکارسازی کنید"}},"ru":{"stringUnit":{"state":"translated","value":"Задавайте вопросы, создавайте и автоматизируйте"}},"sv":{"stringUnit":{"state":"translated","value":"Fråga, skapa och automatisera"}}}},
