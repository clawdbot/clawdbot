    "Gateway changed before the thread operation started.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Gateway changed before the thread operation started."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Gateway 在对话操作开始前已发生更改。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 在對話串操作開始前已變更。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Gateway foi alterado antes do início da operação da conversa."}},"de":{"stringUnit":{"state":"translated","value":"Das Gateway wurde geändert, bevor der Thread-Vorgang gestartet wurde."}},"es":{"stringUnit":{"state":"translated","value":"El Gateway cambió antes de que comenzara la operación del hilo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"スレッド操作の開始前にGatewayが変更されました。"}},"ko":{"stringUnit":{"state":"translated","value":"스레드 작업이 시작되기 전에 Gateway가 변경되었습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le Gateway a changé avant le début de l’opération sur le fil de discussion."}},"hi":{"stringUnit":{"state":"translated","value":"थ्रेड की कार्रवाई शुरू होने से पहले Gateway बदल गया।"}},"ar":{"stringUnit":{"state":"translated","value":"تغيّر Gateway قبل بدء عملية المحادثة."}},"it":{"stringUnit":{"state":"translated","value":"Il Gateway è cambiato prima dell'inizio dell'operazione sulla conversazione."}},"tr":{"stringUnit":{"state":"translated","value":"İş parçacığı işlemi başlamadan önce Gateway değişti."}},"uk":{"stringUnit":{"state":"translated","value":"Gateway змінився до початку операції з гілкою."}},"id":{"stringUnit":{"state":"translated","value":"Gateway berubah sebelum operasi utas dimulai."}},"pl":{"stringUnit":{"state":"translated","value":"Gateway zmienił się przed rozpoczęciem operacji na wątku."}},"th":{"stringUnit":{"state":"translated","value":"Gateway มีการเปลี่ยนแปลงก่อนเริ่มดำเนินการกับเธรด"}},"vi":{"stringUnit":{"state":"translated","value":"Gateway đã thay đổi trước khi thao tác với luồng bắt đầu."}},"nl":{"stringUnit":{"state":"translated","