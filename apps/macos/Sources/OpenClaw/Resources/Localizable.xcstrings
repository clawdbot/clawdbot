    "Bare names match PATH commands. Use a path glob for a specific binary.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Bare names match PATH commands. Use a path glob for a specific binary."}},"zh-CN":{"stringUnit":{"state":"translated","value":"裸名称匹配 PATH 命令。使用路径 glob 匹配特定二进制文件。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"裸名稱會比對 PATH 命令。請使用路徑 glob 指定特定二進位檔。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Nomes simples correspondem a comandos em PATH. Use um glob de caminho para um binário específico."}},"de":{"stringUnit":{"state":"translated","value":"Reine Namen entsprechen PATH-Befehlen. Verwenden Sie ein Pfad-Glob für eine bestimmte Binärdatei."}},"es":{"stringUnit":{"state":"translated","value":"Los nombres sin ruta coinciden con comandos de PATH. Usa un glob de ruta para un binario específico."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ベア名は PATH コマンドに一致します。特定のバイナリにはパス glob を使用してください。"}},"ko":{"stringUnit":{"state":"translated","value":"단순 이름은 PATH 명령과 일치합니다. 특정 바이너리에는 경로 glob을 사용하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Les noms simples correspondent aux commandes PATH. Utilisez un glob de chemin pour un binaire spécifique."}},"hi":{"stringUnit":{"state":"translated","value":"सादे नाम PATH कमांड्स से मेल खाते हैं। किसी विशिष्ट बाइनरी के लिए path glob का उपयोग करें।"}},"ar":{"stringUnit":{"state":"translated","value":"تطابق الأسماء المجردة أوامر PATH. استخدم نمط مسار شامل لملف تنفيذي محدد."}},"it":{"stringUnit":{"state":"translated","value":"I nomi semplici corrispondono ai comandi PATH. Usa un glob di percorso per un binario specifico."}},"tr":{"stringUnit":{"state":"translated","value":"Yalın adlar PATH komutlarıyla eşleşir. Belirli bir ikili dosya için yol glob'u kullanın."}},"uk":{"stringUnit":{"state":"translated","value":"Голі назви відповідають командам PATH. Використовуйте глоб шляху для конкретного двійкового файлу."}},"id":{"stringUnit":{"state":"translated","value":"Nama polos cocok dengan perintah PATH. Gunakan glob jalur untuk biner tertentu."}},"pl":{"stringUnit":{"state":"translated","value":"Same nazwy pasują do poleceń PATH. Użyj globu ścieżki dla konkretnego pliku binarnego."}},"th":{"stringUnit":{"state":"translated","value":"ชื่อแบบไม่ระบุพาธจะตรงกับคำสั่งใน PATH ใช้ path glob สำหรับไบนารีเฉพาะ"}},"vi":{"stringUnit":{"state":"translated","value":"Tên trần khớp với các lệnh trong PATH. Dùng glob đường dẫn cho một tệp nhị phân cụ thể."}},"nl":{"stringUnit":{"state":"translated","value":"Kale namen komen overeen met PATH-commando's. Gebruik een pad-glob voor een specifieke binary."}},"fa":{"stringUnit":{"state":"translated","value":"نام‌های ساده با فرمان‌های PATH مطابقت دارند. برای یک باینری مشخص از glob مسیر استفاده کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Простые имена соответствуют командам в PATH. Используйте глоб пути для конкретного бинарного файла."}},"sv":{"stringUnit":{"state":"translated","value":"Rena namn matchar PATH-kommandon. Använd ett sökvägs-glob för en specifik binär."}}}},
