    "Attach text from %@": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Attach text from %@"}},"zh-CN":{"stringUnit":{"state":"translated","value":"附加来自 %@ 的文本"}},"zh-TW":{"stringUnit":{"state":"translated","value":"附加來自 %@ 的文字"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Anexar texto de %@"}},"de":{"stringUnit":{"state":"translated","value":"Text aus %@ anhängen"}},"es":{"stringUnit":{"state":"translated","value":"Adjuntar texto de %@"}},"ja-JP":{"stringUnit":{"state":"translated","value":"%@のテキストを添付"}},"ko":{"stringUnit":{"state":"translated","value":"%@의 텍스트 첨부"}},"fr":{"stringUnit":{"state":"translated","value":"Joindre le texte de %@"}},"hi":{"stringUnit":{"state":"translated","value":"%@ से टेक्स्ट अटैच करें"}},"ar":{"stringUnit":{"state":"translated","value":"إرفاق نص من %@"}},"it":{"stringUnit":{"state":"translated","value":"Allega testo da %@"}},"tr":{"stringUnit":{"state":"translated","value":"%@ kaynağından metin ekle"}},"uk":{"stringUnit":{"state":"translated","value":"Додати текст із %@"}},"id":{"stringUnit":{"state":"translated","value":"Lampirkan teks dari %@"}},"pl":{"stringUnit":{"state":"translated","value":"Dołącz tekst z %@"}},"th":{"stringUnit":{"state":"translated","value":"แนบข้อความจาก %@"}},"vi":{"stringUnit":{"state":"translated","value":"Đính kèm văn bản từ %@"}},"nl":{"stringUnit":{"state":"translated","value":"Tekst uit %@ bijvoegen"}},"fa":{"stringUnit":{"state":"translated","value":"پیوست کردن متن از %@"}},"ru":{"stringUnit":{"state":"translated","value":"Прикрепить текст из %@"}},"sv":{"stringUnit":{"state":"translated","value":"Bifoga text från %@"}}}},
    "Attaching focused-window text uses macOS Accessibility access.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Attaching focused-window text uses macOS Accessibility access."}},"zh-CN":{"stringUnit":{"state":"translated","value":"附加当前聚焦窗口的文本需要 macOS 辅助功能访问权限。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"附加焦點視窗中的文字需要 macOS 輔助使用權限。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Anexar texto da janela em foco usa a permissão de Acessibilidade do macOS."}},"de":{"stringUnit":{"state":"translated","value":"Das Anhängen von Text aus dem fokussierten Fenster verwendet den macOS-Zugriff auf Bedienungshilfen."}},"es":{"stringUnit":{"state":"translated","value":"Adjuntar texto de la ventana activa requiere acceso a Accesibilidad de macOS."}},"ja-JP":{"stringUnit":{"state":"translated","value":"フォーカス中のウィンドウのテキストを添付するには、macOSのアクセシビリティ権限を使用します。"}},"ko":{"stringUnit":{"state":"translated","value":"현재 활성 창의 텍스트를 첨부하려면 macOS 손쉬운 사용 접근 권한이 필요합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Joindre le texte de la fenêtre active nécessite l’accès aux fonctionnalités d’accessibilité de macOS."}},"hi":{"stringUnit":{"state":"translated","value":"फ़ोकस की गई विंडो का टेक्स्ट अटैच करने के लिए macOS की सुलभता ऐक्सेस का उपयोग होता है।"}},"ar":{"stringUnit":{"state":"translated","value":"يستخدم إرفاق نص النافذة النشطة صلاحية تسهيلات الاستخدام في macOS."}},"it":{"stringUnit":{"state":"translated","value":"Per allegare il testo della finestra attiva viene utilizzato l'accesso ad Accessibilità di macOS."}},"tr":{"stringUnit":{"state":"translated","value":"Odaklanılan pencerenin metnini eklemek, macOS Erişilebilirlik erişimini kullanır."}},"uk":{"stringUnit":{"state":"translated","value":"Для додавання тексту з активного вікна потрібен доступ до функцій доступності macOS."}},"id":{"stringUnit":{"state":"translated","value":"Melampirkan teks dari jendela yang sedang aktif menggunakan akses Aksesibilitas macOS."}},"pl":{"stringUnit":{"state":"translated","value":"Dołączanie tekstu z aktywnego okna korzysta z uprawnień dostępności macOS."}},"th":{"stringUnit":{"state":"translated","value":"การแนบข้อความจากหน้าต่างที่กำลังโฟกัสต้องใช้สิทธิ์การช่วยการเข้าถึงของ macOS."}},"vi":{"stringUnit":{"state":"translated","value":"Việc đính kèm văn bản từ cửa sổ đang được chọn sử dụng quyền truy cập Trợ năng của macOS."}},"nl":{"stringUnit":{"state":"translated","value":"Voor het bijvoegen van tekst uit het actieve venster is toegang tot macOS-toegankelijkheid vereist."}},"fa":{"stringUnit":{"state":"translated","value":"پیوست کردن متن پنجرهٔ فعال از دسترسی دسترس‌پذیری macOS استفاده می‌کند."}},"ru":{"stringUnit":{"state":"translated","value":"Для прикрепления текста из активного окна используется доступ к функциям универсального доступа macOS."}},"sv":{"stringUnit":{"state":"translated","value":"För att bifoga text från det aktiva fönstret används tillgänglighetsbehörighet i macOS."}}}},
