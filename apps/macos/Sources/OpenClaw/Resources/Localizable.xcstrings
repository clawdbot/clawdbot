    "Verifying the Mac node runtime…": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Verifying the Mac node runtime…"}},"zh-CN":{"stringUnit":{"state":"translated","value":"正在验证 Mac 节点运行时…"}},"zh-TW":{"stringUnit":{"state":"translated","value":"正在驗證 Mac 節點執行環境…"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Verificando o runtime do nó do Mac…"}},"de":{"stringUnit":{"state":"translated","value":"Die Mac-Knotenlaufzeit wird überprüft…"}},"es":{"stringUnit":{"state":"translated","value":"Verificando el entorno de ejecución del nodo de Mac…"}},"ja-JP":{"stringUnit":{"state":"translated","value":"Macノードランタイムを確認中…"}},"ko":{"stringUnit":{"state":"translated","value":"Mac 노드 런타임을 확인하는 중…"}},"fr":{"stringUnit":{"state":"translated","value":"Vérification de l’environnement d’exécution du nœud Mac…"}},"hi":{"stringUnit":{"state":"translated","value":"Mac नोड रनटाइम सत्यापित किया जा रहा है…"}},"ar":{"stringUnit":{"state":"translated","value":"جارٍ التحقق من بيئة تشغيل عقدة Mac…"}},"it":{"stringUnit":{"state":"translated","value":"Verifica del runtime del nodo Mac…"}},"tr":{"stringUnit":{"state":"translated","value":"Mac düğümü çalışma zamanı doğrulanıyor…"}},"uk":{"stringUnit":{"state":"translated","value":"Перевірка середовища виконання вузла Mac…"}},"id":{"stringUnit":{"state":"translated","value":"Memverifikasi runtime node Mac…"}},"pl":{"stringUnit":{"state":"translated","value":"Weryfikowanie środowiska uruchomieniowego węzła Mac…"}},"th":{"stringUnit":{"state":"translated","value":"กำลังตรวจสอบรันไทม์โหนด Mac…"}},"vi":{"stringUnit":{"state":"translated","value":"Đang xác minh môi trường chạy của nút Mac…"}},"nl":{"stringUnit":{"state":"translated","value":"De runtime van het Mac-knooppunt wordt geverifieerd…"}},"fa":{"stringUnit":{"state":"translated","value":"در حال تأیید محیط اجرای گره Mac…"}},"ru":{"stringUnit":{"state":"translated","value":"Проверка среды выполнения узла Mac…"}},"sv":{"stringUnit":{"state":"translated","value":"Verifierar Mac-nodens körningsmiljö…"}}}},
