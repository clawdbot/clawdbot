    "Saved Gateways": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Saved Gateways"}},"zh-CN":{"stringUnit":{"state":"translated","value":"已保存的 Gateway"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已儲存的 Gateway"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Gateways salvos"}},"de":{"stringUnit":{"state":"translated","value":"Gespeicherte Gateways"}},"es":{"stringUnit":{"state":"translated","value":"Gateways guardados"}},"ja-JP":{"stringUnit":{"state":"translated","value":"保存済みの Gateway"}},"ko":{"stringUnit":{"state":"translated","value":"저장된 Gateway"}},"fr":{"stringUnit":{"state":"translated","value":"Gateways enregistrés"}},"hi":{"stringUnit":{"state":"translated","value":"सहेजे गए Gateway"}},"ar":{"stringUnit":{"state":"translated","value":"اتصالات Gateway المحفوظة"}},"it":{"stringUnit":{"state":"translated","value":"Gateway salvati"}},"tr":{"stringUnit":{"state":"translated","value":"Kayıtlı Gateway'ler"}},"uk":{"stringUnit":{"state":"translated","value":"Збережені Gateway"}},"id":{"stringUnit":{"state":"translated","value":"Gateway Tersimpan"}},"pl":{"stringUnit":{"state":"translated","value":"Zapisane Gateway"}},"th":{"stringUnit":{"state":"translated","value":"Gateway ที่บันทึกไว้"}},"vi":{"stringUnit":{"state":"translated","value":"Các Gateway đã lưu"}},"nl":{"stringUnit":{"state":"translated","value":"Opgeslagen Gateways"}},"fa":{"stringUnit":{"state":"translated","value":"Gatewayهای ذخیره‌شده"}},"ru":{"stringUnit":{"state":"translated","value":"Сохранённые Gateway"}},"sv":{"stringUnit":{"state":"translated","value":"Sparade Gateways"}}}},
    "Saving session settings.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Saving session settings."}},"zh-CN":{"stringUnit":{"state":"translated","value":"正在保存会话设置。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"正在儲存工作階段設定。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Salvando configurações da sessão."}},"de":{"stringUnit":{"state":"translated","value":"Sitzungseinstellungen werden gespeichert."}},"es":{"stringUnit":{"state":"translated","value":"Guardando la configuración de la sesión."}},"ja-JP":{"stringUnit":{"state":"translated","value":"セッション設定を保存中。"}},"ko":{"stringUnit":{"state":"translated","value":"세션 설정 저장 중."}},"fr":{"stringUnit":{"state":"translated","value":"Enregistrement des paramètres de session."}},"hi":{"stringUnit":{"state":"translated","value":"सत्र की सेटिंग्स सहेजी जा रही हैं."}},"ar":{"stringUnit":{"state":"translated","value":"جارٍ حفظ إعدادات الجلسة."}},"it":{"stringUnit":{"state":"translated","value":"Salvataggio delle impostazioni della sessione."}},"tr":{"stringUnit":{"state":"translated","value":"Oturum ayarları kaydediliyor."}},"uk":{"stringUnit":{"state":"translated","value":"Збереження налаштувань сеансу."}},"id":{"stringUnit":{"state":"translated","value":"Menyimpan pengaturan sesi."}},"pl":{"stringUnit":{"state":"translated","value":"Zapisywanie ustawień sesji."}},"th":{"stringUnit":{"state":"translated","value":"กำลังบันทึกการตั้งค่าเซสชัน."}},"vi":{"stringUnit":{"state":"translated","value":"Đang lưu cài đặt phiên."}},"nl":{"stringUnit":{"state":"translated","value":"Sessie-instellingen opslaan."}},"fa":{"stringUnit":{"state":"translated","value":"در حال ذخیرهٔ تنظیمات نشست."}},"ru":{"stringUnit":{"state":"translated","value":"Сохранение настроек сеанса."}},"sv":{"stringUnit":{"state":"translated","value":"Sparar sessionsinställningar."}}}},
    "Scan or paste a fresh setup code from an already-paired OpenClaw client, then try again.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Scan or paste a fresh setup code from an already-paired OpenClaw client, then try again."}},"zh-CN":{"stringUnit":{"state":"translated","value":"扫描或粘贴来自已配对 OpenClaw 客户端的新设置码, 然后重试。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"從已配對的 OpenClaw 用戶端掃描或貼上新的設定碼，然後再試一次。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escaneie ou cole um novo código de configuração de um cliente OpenClaw já pareado e tente novamente."}},"de":{"stringUnit":{"state":"translated","value":"Scannen Sie einen neuen Einrichtungscode von einem bereits gekoppelten OpenClaw-Client oder fügen Sie ihn ein und versuchen Sie es dann erneut."}},"es":{"stringUnit":{"state":"translated","value":"Escanea o pega un código de configuración nuevo de un cliente OpenClaw ya vinculado y vuelve a intentarlo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ペアリング済みの OpenClaw クライアントから新しいセットアップコードをスキャンまたは貼り付けて、もう一度お試しください。"}},"ko":{"stringUnit":{"state":"translated","value":"이미 페어링된 OpenClaw 클라이언트에서 새 설정 코드를 스캔하거나 붙여넣은 후 다시 시도하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Scannez ou collez un nouveau code de configuration provenant d’un client OpenClaw déjà associé, puis réessayez."}},"hi":{"stringUnit":{"state":"translated","value":"पहले से पेयर किए गए OpenClaw क्लाइंट से नया सेटअप कोड स्कैन या पेस्ट करें, फिर दोबारा कोशिश करें."}},"ar":{"stringUnit":{"state":"translated","value":"امسح رمز إعداد جديدًا من عميل OpenClaw مقترن بالفعل أو الصقه، ثم حاول مجددًا."}},"it":{"stringUnit":{"state":"translated","value":"Scansiona o incolla un nuovo codice di configurazione da un client OpenClaw già abbinato, quindi riprova."}},"tr":{"stringUnit":{"state":"translated","value":"Zaten eşleştirilmiş bir OpenClaw istemcisinden yeni bir kurulum kodu tarayın veya yapıştırın, ardından tekrar deneyin."}},"uk":{"stringUnit":{"state":"translated","value":"Скануйте або вставте новий код налаштування з уже сполученого клієнта OpenClaw, а потім спробуйте ще раз."}},"id":{"stringUnit":{"state":"translated","value":"Pindai atau tempel kode penyiapan baru dari klien OpenClaw yang sudah dipasangkan, lalu coba lagi."}},"pl":{"stringUnit":{"state":"translated","value":"Zeskanuj lub wklej nowy kod konfiguracji z już sparowanego klienta OpenClaw, a następnie spróbuj ponownie."}},"th":{"stringUnit":{"state":"translated","value":"สแกนหรือวางรหัสตั้งค่าใหม่จากไคลเอนต์ OpenClaw ที่จับคู่แล้ว จากนั้นลองอีกครั้ง."}},"vi":{"stringUnit":{"state":"translated","value":"Quét hoặc dán mã thiết lập mới từ một ứng dụng khách OpenClaw đã được ghép đôi, rồi thử lại."}},"nl":{"stringUnit":{"state":"translated","value":"Scan of plak een nieuwe configuratiecode van een al gekoppelde OpenClaw-client en probeer het opnieuw."}},"fa":{"stringUnit":{"state":"translated","value":"یک کد راه‌اندازی تازه از یک کلاینت OpenClaw که قبلاً جفت‌سازی شده است اسکن یا جای‌گذاری کنید، سپس دوباره تلاش کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Отсканируйте или вставьте новый код настройки из уже сопряжённого клиента OpenClaw, затем повторите попытку."}},"sv":{"stringUnit":{"state":"translated","value":"Skanna eller klistra in en ny konfigurationskod från en redan parkopplad OpenClaw-klient och försök sedan igen."}}}},
