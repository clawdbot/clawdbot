    "Disconnected from your remote Gateway. Open Connection settings to fix it.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Disconnected from your remote Gateway. Open Connection settings to fix it."}},"zh-CN":{"stringUnit":{"state":"translated","value":"已与远程 Gateway 断开连接。 请打开连接设置以修复。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已與您的遠端 Gateway 中斷連線。請開啟連線設定以修復問題。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Desconectado do seu Gateway remoto. Abra as configurações de Conexão para corrigir."}},"de":{"stringUnit":{"state":"translated","value":"Die Verbindung zu Ihrem entfernten Gateway wurde getrennt. Öffnen Sie die Verbindungseinstellungen, um das Problem zu beheben."}},"es":{"stringUnit":{"state":"translated","value":"Desconectado de tu Gateway remoto. Abre los ajustes de conexión para solucionarlo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"リモートGatewayとの接続が切断されました。 接続設定を開いて修正してください。"}},"ko":{"stringUnit":{"state":"translated","value":"원격 Gateway와의 연결이 끊어졌습니다. 연결 설정을 열어 문제를 해결하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Déconnecté de votre Gateway distant. Ouvrez les paramètres de connexion pour résoudre le problème."}},"hi":{"stringUnit":{"state":"translated","value":"आपके रिमोट Gateway से कनेक्शन टूट गया है. इसे ठीक करने के लिए कनेक्शन सेटिंग्स खोलें."}},"ar":{"stringUnit":{"state":"translated","value":"انقطع الاتصال بـ Gateway البعيد. افتح إعدادات الاتصال لإصلاح ذلك."}},"it":{"stringUnit":{"state":"translated","value":"Disconnesso dal Gateway remoto. Apri le impostazioni di connessione per risolvere il problema."}},"tr":{"stringUnit":{"state":"translated","value":"Uzak Gateway bağlantınız kesildi. Düzeltmek için Bağlantı ayarlarını açın."}},"uk":{"stringUnit":{"state":"translated","value":"З’єднання з вашим віддаленим Gateway розірвано. Відкрийте налаштування підключення, щоб виправити це."}},"id":{"stringUnit":{"state":"translated","value":"Terputus dari Gateway jarak jauh Anda. Buka pengaturan Koneksi untuk memperbaikinya."}},"pl":{"stringUnit":{"state":"translated","value":"Utracono połączenie ze zdalnym Gateway. Otwórz ustawienia połączenia, aby je przywrócić."}},"th":{"stringUnit":{"state":"translated","value":"การเชื่อมต่อกับ Gateway ระยะไกลของคุณถูกตัด. เปิดการตั้งค่าการเชื่อมต่อเพื่อแก้ไข."}},"vi":{"stringUnit":{"state":"translated","value":"Đã ngắt kết nối với Gateway từ xa của bạn. Mở cài đặt Kết nối để khắc phục."}},"nl":{"stringUnit":{"state":"translated","value":"De verbinding met je externe Gateway is verbroken. Open de verbindingsinstellingen om dit te verhelpen."}},"fa":{"stringUnit":{"state":"translated","value":"اتصال به Gateway راه دور شما قطع شده است. برای رفع مشکل، تنظیمات اتصال را باز کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Соединение с удалённым Gateway потеряно. Откройте настройки подключения, чтобы устранить проблему."}},"sv":{"stringUnit":{"state":"translated","value":"Frånkopplad från din fjärranslutna Gateway. Öppna anslutningsinställningarna för att åtgärda det."}}}},
