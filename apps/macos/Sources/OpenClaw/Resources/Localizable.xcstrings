    "Menu bar companion for notifications, screenshots, and privileged agent actions.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Menu bar companion for notifications, screenshots, and privileged agent actions."}},"zh-CN":{"stringUnit":{"state":"translated","value":"用于通知、屏幕截图和特权智能体操作的菜单栏助手。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"選單列輔助工具，提供通知、螢幕截圖及需特殊權限的代理程式操作。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Aplicativo auxiliar na barra de menus para notificações, capturas de tela e ações privilegiadas do agente."}},"de":{"stringUnit":{"state":"translated","value":"Menüleisten-App für Benachrichtigungen, Screenshots und privilegierte Agentenaktionen."}},"es":{"stringUnit":{"state":"translated","value":"Aplicación complementaria en la barra de menús para notificaciones, capturas de pantalla y acciones del agente con privilegios."}},"ja-JP":{"stringUnit":{"state":"translated","value":"通知、スクリーンショット、特権エージェント操作のためのメニューバー常駐アプリ。"}},"ko":{"stringUnit":{"state":"translated","value":"알림, 스크린샷, 관리자 권한이 필요한 에이전트 작업을 위한 메뉴 막대 도우미입니다."}},"fr":{"stringUnit":{"state":"translated","value":"Application de barre de menus pour les notifications, les captures d’écran et les actions privilégiées de l’agent."}},"hi":{"stringUnit":{"state":"translated","value":"सूचनाओं, स्क्रीनशॉट और विशेषाधिकार प्राप्त एजेंट कार्रवाइयों के लिए मेनू बार सहायक।"}},"ar":{"stringUnit":{"state":"translated","value":"تطبيق مرافق في شريط القوائم للإشعارات ولقطات الشاشة وإجراءات الوكيل ذات الصلاحيات المرتفعة."}},"it":{"stringUnit":{"state":"translated","value":"App di supporto nella barra dei menu per notifiche, screenshot e azioni privilegiate dell'agente."}},"tr":{"stringUnit":{"state":"translated","value":"Bildirimler, ekran görüntüleri ve ayrıcalıklı aracı işlemleri için menü çubuğu yardımcısı."}},"uk":{"stringUnit":{"state":"translated","value":"Допоміжний застосунок у смузі меню для сповіщень, знімків екрана та привілейованих дій агента."}},"id":{"stringUnit":{"state":"translated","value":"Aplikasi pendamping di bar menu untuk notifikasi, tangkapan layar, dan tindakan agen dengan hak istimewa."}},"pl":{"stringUnit":{"state":"translated","value":"Aplikacja pomocnicza na pasku menu do obsługi powiadomień, zrzutów ekranu i uprzywilejowanych działań agenta."}},"th":{"stringUnit":{"state":"translated","value":"แอปผู้ช่วยบนแถบเมนูสำหรับการแจ้งเตือน ภาพหน้าจอ และการดำเนินการของเอเจนต์ที่ต้องใช้สิทธิ์พิเศษ"}},"vi":{"stringUnit":{"state":"translated","value":"Ứng dụng hỗ trợ trên thanh menu cho thông báo, ảnh chụp màn hình và các thao tác đặc quyền của tác nhân."}},"nl":{"stringUnit":{"state":"translated","value":"Menubalkhulp voor meldingen, schermafbeeldingen en agentacties met verhoogde rechten."}},"fa":{"stringUnit":{"state":"translated","value":"برنامهٔ همراه در نوار منو برای اعلان‌ها، تصاویر صفحه و اقدامات عامل با دسترسی ویژه."}},"ru":{"stringUnit":{"state":"translated","value":"Вспомогательное приложение в строке меню для уведомлений, снимков экрана и привилегированных действий агента."}},"sv":{"stringUnit":{"state":"translated","value":"Hjälpapp i menyraden för notiser, skärmbilder och agentåtgärder med utökade behörigheter."}}}},
