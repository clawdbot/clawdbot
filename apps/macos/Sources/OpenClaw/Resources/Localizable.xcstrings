    "Setup code expired or already used. Scan a fresh setup code, then try again.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Setup code expired or already used. Scan a fresh setup code, then try again."}},"zh-CN":{"stringUnit":{"state":"translated","value":"设置代码已过期或已使用。请扫描新的设置代码，然后重试。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"設定碼已過期或已使用。請掃描新的設定碼，然後再試一次。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Código de configuração expirado ou já usado. Escaneie um novo código de configuração e tente novamente."}},"de":{"stringUnit":{"state":"translated","value":"Einrichtungscode abgelaufen oder bereits verwendet. Scanne einen neuen Einrichtungscode und versuche es dann erneut."}},"es":{"stringUnit":{"state":"translated","value":"El código de configuración caducó o ya se usó. Escanea un código de configuración nuevo y vuelve a intentarlo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"セットアップコードの有効期限が切れているか、すでに使用されています。新しいセットアップコードをスキャンしてから、もう一度お試しください。"}},"ko":{"stringUnit":{"state":"translated","value":"설정 코드가 만료되었거나 이미 사용되었습니다. 새 설정 코드를 스캔한 다음 다시 시도하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Code de configuration expiré ou déjà utilisé. Scannez un nouveau code de configuration, puis réessayez."}},"hi":{"stringUnit":{"state":"translated","value":"Setup code expired हो गया है या पहले ही used हो चुका है। नया setup code स्कैन करें, फिर दोबारा प्रयास करें।"}},"ar":{"stringUnit":{"state":"translated","value":"انتهت صلاحية رمز الإعداد أو تم استخدامه بالفعل. امسح ضوئيًا رمز إعداد جديدًا، ثم حاول مرة أخرى."}},"it":{"stringUnit":{"state":"translated","value":"Codice di configurazione scaduto o già usato. Scansiona un nuovo codice di configurazione, quindi riprova."}},"tr":{"stringUnit":{"state":"translated","value":"Kurulum kodunun süresi dolmuş veya zaten kullanılmış. Yeni bir kurulum kodu tarayın, ardından tekrar deneyin."}},"uk":{"stringUnit":{"state":"translated","value":"Термін дії коду налаштування минув або його вже використано. Відскануйте новий код налаштування, а потім повторіть спробу."}},"id":{"stringUnit":{"state":"translated","value":"Kode penyiapan kedaluwarsa atau sudah digunakan. Pindai kode penyiapan baru, lalu coba lagi."}},"pl":{"stringUnit":{"state":"translated","value":"Kod konfiguracji wygasł lub został już użyty. Zeskanuj nowy kod konfiguracji, a następnie spróbuj ponownie."}},"th":{"stringUnit":{"state":"translated","value":"รหัสตั้งค่าหมดอายุหรือถูกใช้ไปแล้ว สแกนรหัสตั้งค่าใหม่ จากนั้นลองอีกครั้ง"}},"vi":{"stringUnit":{"state":"translated","value":"Mã thiết lập đã hết hạn hoặc đã được sử dụng. Quét mã thiết lập mới, rồi thử lại."}},"nl":{"stringUnit":{"state":"translated","value":"Instelcode verlopen of al gebruikt. Scan een nieuwe instelcode en probeer het opnieuw."}},"fa":{"stringUnit":{"state":"translated","value":"کد راه‌اندازی منقضی شده یا قبلاً استفاده شده است. یک کد راه‌اندازی تازه را اسکن کنید، سپس دوباره تلاش کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Срок действия кода настройки истек или он уже использован. Отсканируйте новый код настройки, затем повторите попытку."}},"sv":{"stringUnit":{"state":"translated","value":"Konfigurationskoden har upphört att gälla eller har redan använts. Skanna en ny konfigurationskod och försök sedan igen."}}}},
    "Setup needed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Setup needed"}},"zh-CN":{"stringUnit":{"state":"translated","value":"需要设置"}},"zh-TW":{"stringUnit":{"state":"translated","value":"需要設定"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Configuração necessária"}},"de":{"stringUnit":{"state":"translated","value":"Einrichtung erforderlich"}},"es":{"stringUnit":{"state":"translated","value":"Configuración necesaria"}},"ja-JP":{"stringUnit":{"state":"translated","value":"セットアップが必要です"}},"ko":{"stringUnit":{"state":"translated","value":"설정 필요"}},"fr":{"stringUnit":{"state":"translated","value":"Configuration nécessaire"}},"hi":{"stringUnit":{"state":"translated","value":"सेटअप आवश्यक"}},"ar":{"stringUnit":{"state":"translated","value":"يلزم الإعداد"}},"it":{"stringUnit":{"state":"translated","value":"Configurazione necessaria"}},"tr":{"stringUnit":{"state":"translated","value":"Kurulum gerekli"}},"uk":{"stringUnit":{"state":"translated","value":"Потрібне налаштування"}},"id":{"stringUnit":{"state":"translated","value":"Penyiapan diperlukan"}},"pl":{"stringUnit":{"state":"translated","value":"Wymagana konfiguracja"}},"th":{"stringUnit":{"state":"translated","value":"จำเป็นต้องตั้งค่า"}},"vi":{"stringUnit":{"state":"translated","value":"Cần thiết lập"}},"nl":{"stringUnit":{"state":"translated","value":"Configuratie nodig"}},"fa":{"stringUnit":{"state":"translated","value":"نیاز به راه‌اندازی"}},"ru":{"stringUnit":{"state":"translated","value":"Требуется настройка"}},"sv":{"stringUnit":{"state":"translated","value":"Konfiguration krävs"}}}},
    "Share location when requested by the agent": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Share location when requested by the agent"}},"zh-CN":{"stringUnit":{"state":"translated","value":"在代理请求时共享位置"}},"zh-TW":{"stringUnit":{"state":"translated","value":"在代理程式要求時分享位置"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Compartilhar localização quando solicitado pelo agente"}},"de":{"stringUnit":{"state":"translated","value":"Standort teilen, wenn vom Agent angefordert"}},"es":{"stringUnit":{"state":"translated","value":"Compartir la ubicación cuando lo solicite el agente"}},"ja-JP":{"stringUnit":{"state":"translated","value":"エージェントから要求された場合に位置情報を共有"}},"ko":{"stringUnit":{"state":"translated","value":"에이전트가 요청할 때 위치 공유"}},"fr":{"stringUnit":{"state":"translated","value":"Partager la position lorsque l’agent le demande"}},"hi":{"stringUnit":{"state":"translated","value":"एजेंट द्वारा अनुरोध किए जाने पर स्थान साझा करें"}},"ar":{"stringUnit":{"state":"translated","value":"مشاركة الموقع عندما يطلبه الوكيل"}},"it":{"stringUnit":{"state":"translated","value":"Condividi la posizione quando richiesto dall'agente"}},"tr":{"stringUnit":{"state":"translated","value":"Ajan tarafından istendiğinde konumu paylaş"}},"uk":{"stringUnit":{"state":"translated","value":"Надсилати місцезнаходження на запит агента"}},"id":{"stringUnit":{"state":"translated","value":"Bagikan lokasi saat diminta oleh agen"}},"pl":{"stringUnit":{"state":"translated","value":"Udostępnij lokalizację na żądanie agenta"}},"th":{"stringUnit":{"state":"translated","value":"แชร์ตำแหน่งเมื่อเอเจนต์ร้องขอ"}},"vi":{"stringUnit":{"state":"translated","value":"Chia sẻ vị trí khi tác nhân yêu cầu"}},"nl":{"stringUnit":{"state":"translated","value":"Deel locatie wanneer de agent daarom vraagt"}},"fa":{"stringUnit":{"state":"translated","value":"اشتراک‌گذاری موقعیت مکانی هنگام درخواست عامل"}},"ru":{"stringUnit":{"state":"translated","value":"Передавать местоположение по запросу агента"}},"sv":{"stringUnit":{"state":"translated","value":"Dela plats när agenten begär det"}}}},
    "Share this Mac's idle duration so OpenClaw can identify the Mac you used most recently and route node alerts. Never sends keys, pointer positions, app names, or window titles. Requires Accessibility.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Share this Mac's idle duration so OpenClaw can identify the Mac you used most recently and route node alerts. Never sends keys, pointer positions, app names, or window titles. Requires Accessibility."}},"zh-CN":{"stringUnit":{"state":"translated","value":"分享此 Mac 的空闲时长，以便 OpenClaw 识别您最近使用的 Mac 并路由节点提醒。绝不发送按键、指针位置、应用名称或窗口标题。需要“辅助功能”权限。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"分享此 Mac 的閒置時間，讓 OpenClaw 能識別您最近使用的 Mac 並路由節點警示。絕不傳送按鍵、指標位置、應用程式名稱或視窗標題。需要「輔助使用」權限。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Compartilhe o tempo de inatividade deste Mac para que o OpenClaw possa identificar o Mac que você usou mais recentemente e rotear alertas de nó. Nunca envia teclas, posições do ponteiro, nomes de apps ou títulos de janelas. Requer Acessibilidade."}},"de":{"stringUnit":{"state":"translated","value":"Teile die Leerlaufdauer dieses Macs, damit OpenClaw den zuletzt genutzten Mac identifizieren und Knoten-Benachrichtigungen weiterleiten kann. Es werden niemals Tastenanschläge, Zeigerpositionen, App-Namen oder Fenstertitel gesendet. Erfordert Bedienungshilfen."}},"es":{"stringUnit":{"state":"translated","value":"Comparte el tiempo de inactividad de este Mac para que OpenClaw pueda identificar el Mac que usaste más recientemente y enrutar alertas de nodo. Nunca envía teclas, posiciones del puntero, nombres de apps ni títulos de ventana. Requiere Accesibilidad."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このMacのアイドル時間を共有すると、OpenClawが最近使用したMacを識別し、ノードアラートをルーティングできます。キー入力、ポインター位置、アプリ名、ウィンドウタイトルは送信されません。アクセシビリティが必要です。"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw이 가장 최근에 사용한 Mac을 식별하고 노드 알림을 라우팅할 수 있도록 이 Mac의 유휴 시간을 공유합니다. 키 입력, 포인터 위치, 앱 이름, 창 제목은 절대 전송하지 않습니다. 손쉬운 사용 권한이 필요합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Partagez la durée d'inactivité de ce Mac afin qu'OpenClaw puisse identifier le Mac que vous avez utilisé le plus récemment et acheminer les alertes de nœud. N'envoie jamais les touches, les positions du pointeur, les noms d'applications ni les titres de fenêtres. Nécessite l'Accessibilité."}},"hi":{"stringUnit":{"state":"translated","value":"इस Mac की निष्क्रियता अवधि साझा करें ताकि OpenClaw उस Mac की पहचान कर सके जिसे आपने हाल ही में सबसे अधिक उपयोग किया और नोड अलर्ट रूट कर सके। कभी भी कीज़, पॉइंटर स्थिति, ऐप नाम, या विंडो शीर्षक नहीं भेजता। Accessibility आवश्यक है।"}},"ar":{"stringUnit":{"state":"translated","value":"شارك مدة خمول هذا الـ Mac حتى يتمكن OpenClaw من تحديد الـ Mac الذي استخدمته مؤخرًا وتوجيه تنبيهات العُقد. لا يرسل أبدًا المفاتيح أو مواضع المؤشر أو أسماء التطبيقات أو عناوين النوافذ. يتطلب إمكانية الوصول."}},"it":{"stringUnit":{"state":"translated","value":"Condividi la durata di inattività di questo Mac così OpenClaw può identificare il Mac usato più di recente e instradare gli avvisi dei nodi. Non invia mai tasti, posizioni del puntatore, nomi di app o titoli delle finestre. Richiede Accessibilità."}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw'un en son kullandığınız Mac'i belirleyip düğüm uyarılarını yönlendirebilmesi için bu Mac'in boşta kalma süresini paylaşın. Tuşları, işaretçi konumlarını, uygulama adlarını veya pencere başlıklarını asla göndermez. Erişilebilirlik gerektirir."}},"uk":{"stringUnit":{"state":"translated","value":"Діліться тривалістю простою цього Mac, щоб OpenClaw міг визначити Mac, який ви використовували останнім, і спрямовувати сповіщення вузлів. Ніколи не надсилає клавіші, позиції вказівника, назви застосунків чи заголовки вікон. Потребує Спеціальні можливості."}},"id":{"stringUnit":{"state":"translated","value":"Bagikan durasi idle Mac ini agar OpenClaw dapat mengidentifikasi Mac yang terakhir Anda gunakan dan merutekan peringatan node. Tidak pernah mengirim tombol, posisi penunjuk, nama aplikasi, atau judul jendela. Memerlukan Accessibility."}},"pl":{"stringUnit":{"state":"translated","value":"Udostępniaj czas bezczynności tego Maca, aby OpenClaw mógł zidentyfikować Maca, którego użyto ostatnio, i kierować alerty węzła. Nigdy nie wysyła klawiszy, pozycji wskaźnika, nazw aplikacji ani tytułów okien. Wymaga Ułatwień dostępu."}},"th":{"stringUnit":{"state":"translated","value":"แชร์ระยะเวลาที่ Mac เครื่องนี้ไม่ได้ใช้งาน เพื่อให้ OpenClaw ระบุ Mac ที่คุณใช้ล่าสุดและกำหนดเส้นทางการแจ้งเตือนโหนดได้ ไม่มีการส่งคีย์ ตำแหน่งตัวชี้ ชื่อแอป หรือชื่อหน้าต่าง ต้องใช้การช่วยการเข้าถึง"}},"vi":{"stringUnit":{"state":"translated","value":"Chia sẻ thời gian nhàn rỗi của máy Mac này để OpenClaw có thể xác định máy Mac bạn đã dùng gần đây nhất và định tuyến cảnh báo nút. Không bao giờ gửi phím, vị trí con trỏ, tên ứng dụng hay tiêu đề cửa sổ. Yêu cầu Trợ năng."}},"nl":{"stringUnit":{"state":"translated","value":"Deel de inactiviteitsduur van deze Mac zodat OpenClaw de Mac kan identificeren die je het meest recent hebt gebruikt en knooppuntwaarschuwingen kan routeren. Verstuurt nooit toetsen, aanwijzerposities, app-namen of venstertitels. Vereist Toegankelijkheid."}},"fa":{"stringUnit":{"state":"translated","value":"مدت زمان بیکاری این Mac را به اشتراک بگذارید تا OpenClaw بتواند Mac که اخیراً استفاده کرده‌اید را شناسایی کرده و هشدارهای نود را مسیریابی کند. هرگز کلیدها، موقعیت اشاره‌گر، نام برنامه‌ها یا عنوان پنجره‌ها ارسال نمی‌شود. به دسترسی‌پذیری نیاز دارد."}},"ru":{"stringUnit":{"state":"translated","value":"Делитесь временем простоя этого Mac, чтобы OpenClaw мог определить Mac, который вы использовали последним, и направлять оповещения узла. Никогда не отправляет клавиши, положения указателя, названия приложений или заголовки окон. Требуется Универсальный доступ."}},"sv":{"stringUnit":{"state":"translated","value":"Dela denna Macs inaktivitetstid så att OpenClaw kan identifiera vilken Mac du använde senast och dirigera nodaviseringar. Skickar aldrig tangenttryckningar, pekarpositioner, appnamn eller fönstertitlar. Kräver Hjälpmedel."}}}},
    "Shell commands allowed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Shell commands allowed"}},"zh-CN":{"stringUnit":{"state":"translated","value":"Shell 命令已允许"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Shell commands 已允許"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Comandos de shell permitidos"}},"de":{"stringUnit":{"state":"translated","value":"Shell-Befehle erlaubt"}},"es":{"stringUnit":{"state":"translated","value":"Comandos de shell permitidos"}},"ja-JP":{"stringUnit":{"state":"translated","value":"シェルコマンドは許可されています"}},"ko":{"stringUnit":{"state":"translated","value":"셸 명령 허용됨"}},"fr":{"stringUnit":{"state":"translated","value":"Commandes shell autorisées"}},"hi":{"stringUnit":{"state":"translated","value":"Shell कमांड की अनुमति है"}},"ar":{"stringUnit":{"state":"translated","value":"أوامر Shell مسموح بها"}},"it":{"stringUnit":{"state":"translated","value":"Comandi shell consentiti"}},"tr":{"stringUnit":{"state":"translated","value":"Shell komutlarına izin verildi"}},"uk":{"stringUnit":{"state":"translated","value":"Команди оболонки дозволено"}},"id":{"stringUnit":{"state":"translated","value":"Perintah shell diizinkan"}},"pl":{"stringUnit":{"state":"translated","value":"Polecenia powłoki dozwolone"}},"th":{"stringUnit":{"state":"translated","value":"อนุญาตคำสั่งเชลล์แล้ว"}},"vi":{"stringUnit":{"state":"translated","value":"Lệnh shell được phép"}},"nl":{"stringUnit":{"state":"translated","value":"Shell-opdrachten toegestaan"}},"fa":{"stringUnit":{"state":"translated","value":"فرمان‌های Shell مجاز هستند"}},"ru":{"stringUnit":{"state":"translated","value":"Команды оболочки разрешены"}},"sv":{"stringUnit":{"state":"translated","value":"Skalkommandon tillåtna"}}}},
    "Shell commands blocked": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Shell commands blocked"}},"zh-CN":{"stringUnit":{"state":"translated","value":"Shell 命令已被阻止"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Shell commands 已封鎖"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Comandos de shell bloqueados"}},"de":{"stringUnit":{"state":"translated","value":"Shell-Befehle blockiert"}},"es":{"stringUnit":{"state":"translated","value":"Comandos de shell bloqueados"}},"ja-JP":{"stringUnit":{"state":"translated","value":"シェルコマンドはブロックされています"}},"ko":{"stringUnit":{"state":"translated","value":"셸 명령 차단됨"}},"fr":{"stringUnit":{"state":"translated","value":"Commandes shell bloquées"}},"hi":{"stringUnit":{"state":"translated","value":"Shell कमांड अवरुद्ध हैं"}},"ar":{"stringUnit":{"state":"translated","value":"تم حظر أوامر Shell"}},"it":{"stringUnit":{"state":"translated","value":"Comandi shell bloccati"}},"tr":{"stringUnit":{"state":"translated","value":"Shell komutları engellendi"}},"uk":{"stringUnit":{"state":"translated","value":"Команди оболонки заблоковано"}},"id":{"stringUnit":{"state":"translated","value":"Perintah shell diblokir"}},"pl":{"stringUnit":{"state":"translated","value":"Polecenia powłoki zablokowane"}},"th":{"stringUnit":{"state":"translated","value":"คำสั่งเชลล์ถูกบล็อก"}},"vi":{"stringUnit":{"state":"translated","value":"Lệnh shell bị chặn"}},"nl":{"stringUnit":{"state":"translated","value":"Shell-opdrachten geblokkeerd"}},"fa":{"stringUnit":{"state":"translated","value":"فرمان‌های Shell مسدود شده‌اند"}},"ru":{"stringUnit":{"state":"translated","value":"Команды оболочки заблокированы"}},"sv":{"stringUnit":{"state":"translated","value":"Skalkommandon blockerade"}}}},
    "Shelling": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Shelling"}},"zh-CN":{"stringUnit":{"state":"translated","value":"披甲中"}},"zh-TW":{"stringUnit":{"state":"translated","value":"換殼中"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Criando concha"}},"de":{"stringUnit":{"state":"translated","value":"Schalen"}},"es":{"stringUnit":{"state":"translated","value":"Descascarando"}},"ja-JP":{"stringUnit":{"state":"translated","value":"殻づくり中"}},"ko":{"stringUnit":{"state":"translated","value":"껍데기 다듬는 중"}},"fr":{"stringUnit":{"state":"translated","value":"Formation de carapace"}},"hi":{"stringUnit":{"state":"translated","value":"कवच बनाना"}},"ar":{"stringUnit":{"state":"translated","value":"يتقشّر"}},"it":{"stringUnit":{"state":"translated","value":"Sgusciando"}},"tr":{"stringUnit":{"state":"translated","value":"Kabuklanıyor"}},"uk":{"stringUnit":{"state":"translated","value":"Панцирування"}},"id":{"stringUnit":{"state":"translated","value":"Mengupas cangkang"}},"pl":{"stringUnit":{"state":"translated","value":"Chowanie się w skorupie"}},"th":{"stringUnit":{"state":"translated","value":"กำลังสร้างเปลือก"}},"vi":{"stringUnit":{"state":"translated","value":"Đang bóc vỏ"}},"nl":{"stringUnit":{"state":"translated","value":"Pellen"}},"fa":{"stringUnit":{"state":"translated","value":"پوسته‌سازی"}},"ru":{"stringUnit":{"state":"translated","value":"Сбрасываем панцирь"}},"sv":{"stringUnit":{"state":"translated","value":"Skalar"}}}},
    "Short phrases that start voice wake detection.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Short phrases that start voice wake detection."}},"zh-CN":{"stringUnit":{"state":"translated","value":"用于开始语音唤醒检测的短短语。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"用於開始語音喚醒偵測的短詞組。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Frases curtas que iniciam a detecção de ativação por voz."}},"de":{"stringUnit":{"state":"translated","value":"Kurze Phrasen, die die Sprachaktivierungserkennung starten."}},"es":{"stringUnit":{"state":"translated","value":"Frases cortas que inician la detección de activación por voz."}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声ウェイク検出を開始する短いフレーズです。"}},"ko":{"stringUnit":{"state":"translated","value":"음성 깨우기 감지를 시작하는 짧은 문구입니다."}},"fr":{"stringUnit":{"state":"translated","value":"Phrases courtes qui lancent la détection d’activation vocale."}},"hi":{"stringUnit":{"state":"translated","value":"छोटे वाक्यांश जो वॉइस वेक डिटेक्शन शुरू करते हैं।"}},"ar":{"stringUnit":{"state":"translated","value":"عبارات قصيرة تبدأ اكتشاف التنبيه الصوتي."}},"it":{"stringUnit":{"state":"translated","value":"Brevi frasi che avviano il rilevamento vocale per il risveglio."}},"tr":{"stringUnit":{"state":"translated","value":"Sesli uyandırma algılamasını başlatan kısa ifadeler."}},"uk":{"stringUnit":{"state":"translated","value":"Короткі фрази, які запускають виявлення голосового пробудження."}},"id":{"stringUnit":{"state":"translated","value":"Frasa pendek yang memulai deteksi bangun suara."}},"pl":{"stringUnit":{"state":"translated","value":"Krótkie frazy uruchamiające wykrywanie wybudzania głosowego."}},"th":{"stringUnit":{"state":"translated","value":"วลีสั้น ๆ ที่เริ่มการตรวจจับการปลุกด้วยเสียง"}},"vi":{"stringUnit":{"state":"translated","value":"Các cụm từ ngắn bắt đầu phát hiện đánh thức bằng giọng nói."}},"nl":{"stringUnit":{"state":"translated","value":"Korte zinnen die spraakwekdetectie starten."}},"fa":{"st