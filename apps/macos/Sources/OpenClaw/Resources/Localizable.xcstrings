    "Start Tailscale": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Start Tailscale"}},"zh-CN":{"stringUnit":{"state":"translated","value":"启动 Tailscale"}},"zh-TW":{"stringUnit":{"state":"translated","value":"啟動 Tailscale"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Iniciar Tailscale"}},"de":{"stringUnit":{"state":"translated","value":"Tailscale starten"}},"es":{"stringUnit":{"state":"translated","value":"Iniciar Tailscale"}},"ja-JP":{"stringUnit":{"state":"translated","value":"Tailscale を開始"}},"ko":{"stringUnit":{"state":"translated","value":"Tailscale 시작"}},"fr":{"stringUnit":{"state":"translated","value":"Démarrer Tailscale"}},"hi":{"stringUnit":{"state":"translated","value":"Tailscale शुरू करें"}},"ar":{"stringUnit":{"state":"translated","value":"ابدأ Tailscale"}},"it":{"stringUnit":{"state":"translated","value":"Avvia Tailscale"}},"tr":{"stringUnit":{"state":"translated","value":"Tailscale'i Başlat"}},"uk":{"stringUnit":{"state":"translated","value":"Запустити Tailscale"}},"id":{"stringUnit":{"state":"translated","value":"Mulai Tailscale"}},"pl":{"stringUnit":{"state":"translated","value":"Uruchom Tailscale"}},"th":{"stringUnit":{"state":"translated","value":"เริ่ม Tailscale"}},"vi":{"stringUnit":{"state":"translated","value":"Khởi động Tailscale"}},"nl":{"stringUnit":{"state":"translated","value":"Tailscale starten"}},"fa":{"stringUnit":{"state":"translated","value":"شروع Tailscale"}},"ru":{"stringUnit":{"state":"translated","value":"Запустить Tailscale"}},"sv":{"stringUnit":{"state":"translated","value":"Starta Tailscale"}}}},
    "Start Tailscale to get your tailnet hostname.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Start Tailscale to get your tailnet hostname."}},"zh-CN":{"stringUnit":{"state":"translated","value":"启动 Tailscale 以获取你的 tailnet 主机名。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"啟動 Tailscale 以取得你的 tailnet 主機名稱。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Inicie o Tailscale para obter o nome de host do seu tailnet."}},"de":{"stringUnit":{"state":"translated","value":"Starten Sie Tailscale, um Ihren Tailnet-Hostnamen zu erhalten."}},"es":{"stringUnit":{"state":"translated","value":"Inicia Tailscale para obtener el nombre de host de tu tailnet."}},"ja-JP":{"stringUnit":{"state":"translated","value":"tailnet ホスト名を取得するには Tailscale を開始してください。"}},"ko":{"stringUnit":{"state":"translated","value":"tailnet 호스트 이름을 받으려면 Tailscale을 시작하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Démarrez Tailscale pour obtenir le nom d’hôte de votre tailnet."}},"hi":{"stringUnit":{"state":"translated","value":"अपना tailnet होस्टनेम पाने के लिए Tailscale शुरू करें।"}},"ar":{"stringUnit":{"state":"translated","value":"ابدأ Tailscale للحصول على اسم مضيف tailnet الخاص بك."}},"it":{"stringUnit":{"state":"translated","value":"Avvia Tailscale per ottenere il nome host della tua tailnet."}},"tr":{"stringUnit":{"state":"translated","value":"Tailnet ana makine adınızı almak için Tailscale'i başlatın."}},"uk":{"stringUnit":{"state":"translated","value":"Запустіть Tailscale, щоб отримати ім’я хоста tailnet."}},"id":{"stringUnit":{"state":"translated","value":"Mulai Tailscale untuk mendapatkan nama host tailnet Anda."}},"pl":{"stringUnit":{"state":"translated","value":"Uruchom Tailscale, aby uzyskać nazwę hosta tailnet."}},"th":{"stringUnit":{"state":"translated","value":"เริ่ม Tailscale เพื่อรับชื่อโฮสต์ tailnet ของคุณ"}},"vi":{"stringUnit":{"state":"translated","value":"Khởi động Tailscale để lấy tên máy chủ tailnet của bạn."}},"nl":{"stringUnit":{"state":"translated","value":"Start Tailscale om je tailnet-hostnaam te krijgen."}},"fa":{"stringUnit":{"state":"translated","value":"Tailscale را شروع کنید تا نام میزبان tailnet خود را دریافت کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Запустите Tailscale, чтобы получить имя хоста tailnet."}},"sv":{"stringUnit":{"state":"translated","value":"Starta Tailscale för att få ditt tailnet-värdnamn."}}}},
    "Start Talk Mode": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Start Talk Mode"}},"zh-CN":{"stringUnit":{"state":"translated","value":"启动语音模式"}},"zh-TW":{"stringUnit":{"state":"translated","value":"開始語音模式"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Iniciar Modo de Conversa"}},"de":{"stringUnit":{"state":"translated","value":"Sprachmodus starten"}},"es":{"stringUnit":{"state":"translated","value":"Iniciar modo de conversación"}},"ja-JP":{"stringUnit":{"state":"translated","value":"トークモードを開始"}},"ko":{"stringUnit":{"state":"translated","value":"토크 모드 시작"}},"fr":{"stringUnit":{"state":"translated","value":"Démarrer le mode Talk"}},"hi":{"stringUnit":{"state":"translated","value":"Talk Mode शुरू करें"}},"ar":{"stringUnit":{"state":"translated","value":"بدء وضع المحادثة"}},"it":{"stringUnit":{"state":"translated","value":"Avvia modalità conversazione"}},"tr":{"stringUnit":{"state":"translated","value":"Konuşma Modunu Başlat"}},"uk":{"stringUnit":{"state":"translated","value":"Почати режим розмови"}},"id":{"stringUnit":{"state":"translated","value":"Mulai Mode Bicara"}},"pl":{"stringUnit":{"state":"translated","value":"Rozpocznij tryb rozmowy"}},"th":{"stringUnit":{"state":"translated","value":"เริ่มโหมดสนทนา"}},"vi":{"stringUnit":{"state":"translated","value":"Bắt đầu chế độ nói"}},"nl":{"stringUnit":{"state":"translated","value":"Praatmodus starten"}},"fa":{"stringUnit":{"state":"translated","value":"شروع حالت گفتگو"}},"ru":{"stringUnit":{"state":"translated","value":"Начать режим разговора"}},"sv":{"stringUnit":{"state":"translated","value":"Starta talläge"}}}},
    "Start a full voice conversation when a wake phrase is detected.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Start a full voice conversation when a wake phrase is detected."}},"zh-CN":{"stringUnit":{"state":"translated","value":"检测到唤醒短语时，开始完整的语音对话。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"偵測到喚醒詞時，開始完整的語音對話。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Inicie uma conversa por voz completa quando uma frase de ativação for detectada."}},"de":{"stringUnit":{"state":"translated","value":"Eine vollständige Sprachunterhaltung starten, wenn eine Weckphrase erkannt wird."}},"es":{"stringUnit":{"state":"translated","value":"Inicia una conversación de voz completa cuando se detecta una frase de activación."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ウェイクフレーズが検出されたら、完全な音声会話を開始します。"}},"ko":{"stringUnit":{"state":"translated","value":"깨우기 문구가 감지되면 전체 음성 대화를 시작합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Démarrer une conversation vocale complète lorsqu’une phrase de réveil est détectée."}},"hi":{"stringUnit":{"state":"translated","value":"वेक वाक्यांश पहचाने जाने पर पूरी वॉइस बातचीत शुरू करें।"}},"ar":{"stringUnit":{"state":"translated","value":"بدء محادثة صوتية كاملة عند اكتشاف عبارة تنبيه."}},"it":{"stringUnit":{"state":"translated","value":"Avvia una conversazione vocale completa quando viene rilevata una frase di attivazione."}},"tr":{"stringUnit":{"state":"translated","value":"Bir uyandırma ifadesi algılandığında tam bir sesli konuşma başlatın."}},"uk":{"stringUnit":{"state":"translated","value":"Почати повну голосову розмову, коли виявлено фразу пробудження."}},"id":{"stringUnit":{"state":"translated","value":"Mulai percakapan suara penuh saat frasa bangun terdeteksi."}},"pl":{"stringUnit":{"state":"translated","value":"Rozpocznij pełną rozmowę głosową po wykryciu frazy wybudzania."}},"th":{"stringUnit":{"state":"translated","value":"เริ่มการสนทนาด้วยเสียงแบบเต็มเมื่อมีการตรวจพบวลีปลุก"}},"vi":{"stringUnit":{"state":"translated","value":"Bắt đầu một cuộc trò chuyện bằng giọng nói đầy đủ khi phát hiện cụm từ đánh thức."}},"nl":{"stringUnit":{"state":"translated","value":"Start een volledig spraakgesprek wanneer een wake-zin wordt gedetecteerd."}},"fa":{"stringUnit":{"state":"translated","value":"وقتی عبارت بیدارسازی تشخیص داده شد، یک مکالمه صوتی کامل را شروع کند."}},"ru":{"stringUnit":{"state":"translated","value":"Начинать полноценный голосовой разговор при обнаружении фразы активации."}},"sv":{"stringUnit":{"state":"translated","value":"Starta en fullständig röstkonversation när en väckningsfras identifieras."}}}},
    "Start dictation": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Start dictation"}},"zh-CN":{"stringUnit":{"state":"translated","value":"开始听写"}},"zh-TW":{"stringUnit":{"state":"translated","value":"開始聽寫"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Iniciar ditado"}},"de":{"stringUnit":{"state":"translated","value":"Diktat starten"}},"es":{"stringUnit":{"state":"translated","value":"Iniciar dictado"}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声入力を開始"}},"ko":{"stringUnit":{"state":"translated","value":"받아쓰기 시작"}},"fr":{"stringUnit":{"state":"translated","value":"Démarrer la dictée"}},"hi":{"stringUnit":{"state":"translated","value":"डिक्टेशन शुरू करें"}},"ar":{"stringUnit":{"state":"translated","value":"بدء الإملاء"}},"it":{"stringUnit":{"state":"translated","value":"Avvia dettatura"}},"tr":{"stringUnit":{"state":"translated","value":"Dikteyi başlat"}},"uk":{"stringUnit":{"state":"translated","value":"Почати диктування"}},"id":{"stringUnit":{"state":"translated","value":"Mulai dikte"}},"pl":{"stringUnit":{"state":"translated","value":"Rozpocznij dyktowanie"}},"th":{"stringUnit":{"state":"translated","value":"เริ่มการป้อนตามคำบอก"}},"vi":{"stringUnit":{"state":"translated","value":"Bắt đầu đọc chính tả"}},"nl":{"stringUnit":{"state":"translated","value":"Start dicteren"}},"fa":{"stringUnit":{"state":"translated","value":"شروع دیکته"}},"ru":{"stringUnit":{"state":"translated","value":"Начать диктовку"}},"sv":{"stringUnit":{"state":"translated","value":"Starta diktering"}}}},
    "Start listening while you hold the key and show the preview overlay.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Start listening while you hold the key and show the preview overlay."}},"zh-CN":{"stringUnit":{"state":"translated","value":"按住该按键时开始监听，并显示预览浮层。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"按住按鍵時開始聆聽，並顯示預覽覆蓋層。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Comece a ouvir enquanto você segura a tecla e mostre a sobreposição de pré-visualização."}},"de":{"stringUnit":{"state":"translated","value":"Mit dem Zuhören beginnen, während Sie die Taste gedrückt halten, und die Vorschau-Überlagerung anzeigen."}},"es":{"stringUnit":{"state":"translated","value":"Empieza a escuchar mientras mantienes pulsada la tecla y muestra la superposición de vista previa."}},"ja-JP":{"stringUnit":{"state":"translated","value":"キーを押している間リスニングを開始し、プレビューオーバーレイを表示します。"}},"ko":{"stringUnit":{"state":"translated","value":"키를 누르고 있는 동안 듣기를 시작하고 미리보기 오버레이를 표시합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Commencer l’écoute pendant que vous maintenez la touche enfoncée et afficher l’aperçu superposé."}},"hi":{"stringUnit":{"state":"translated","value":"कुंजी दबाए रखने के दौरान सुनना शुरू करें और प्रीव्यू ओवरले दिखाएँ।"}},"ar":{"stringUnit":{"state":"translated","value":"بدء الاستماع أثناء الضغط باستمرار على المفتاح وعرض طبقة المعاينة."}},"it":{"stringUnit":{"state":"translated","value":"Inizia ad ascoltare mentre tieni premuto il tasto e mostra la sovrapposizione di anteprima."}},"tr":{"stringUnit":{"state":"translated","value":"Tuşu basılı tuttuğunuz süre boyunca dinlemeye başlayın ve önizleme katmanını gösterin."}},"uk":{"stringUnit":{"state":"translated","value":"Почати слухати, поки ви утримуєте клавішу, і показати накладку попереднього перегляду."}},"id":{"stringUnit":{"state":"translated","value":"Mulai mendengarkan saat Anda menahan tombol dan tampilkan overlay pratinjau."}},"pl":{"stringUnit":{"state":"translated","value":"Rozpocznij nasłuchiwanie podczas przytrzymywania klawisza i pokaż nakładkę podglądu."}},"th":{"stringUnit":{"state":"translated","value":"เริ่มฟังขณะที่คุณกดปุ่มค้างไว้และแสดงโอเวอร์เลย์แสดงตัวอย่าง"}},"vi":{"stringUnit":{"state":"translated","value":"Bắt đầu nghe khi bạn giữ phím và hiển thị lớp phủ xem trước."}},"nl":{"stringUnit":{"state":"translated","value":"Begin met luisteren terwijl je de toets ingedrukt houdt en toon de voorvertoningsoverlay."}},"fa":{"stringUnit":{"state":"translated","value":"تا زمانی که کلید را نگه داشته‌اید، گوش دادن شروع شود و پوشش پیش‌نمایش نمایش داده شود."}},"ru":{"stringUnit":{"state":"translated","value":"Начать прослушивание, пока вы удерживаете клавишу, и показать оверлей предпросмотра."}},"sv":{"stringUnit":{"state":"translated","value":"Börja lyssna medan du håller ned tangenten och visa förhandsvisningsöverlägget."}}}},
