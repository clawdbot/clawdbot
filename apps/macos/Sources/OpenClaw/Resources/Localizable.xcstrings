    "Only needed when the gateway requires token auth.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Only needed when the gateway requires token auth."}},"zh-CN":{"stringUnit":{"state":"translated","value":"仅在 Gateway 要求令牌认证时需要。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"僅在 Gateway 需要權杖驗證時才需填寫。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Necessário apenas quando o Gateway exige autenticação por token."}},"de":{"stringUnit":{"state":"translated","value":"Nur erforderlich, wenn der Gateway eine Token-Authentifizierung verlangt."}},"es":{"stringUnit":{"state":"translated","value":"Solo es necesario cuando el Gateway requiere autenticación mediante token."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gateway がトークン認証を要求する場合にのみ必要です。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway에서 토큰 인증을 요구하는 경우에만 필요합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Nécessaire uniquement lorsque le Gateway exige une authentification par jeton."}},"hi":{"stringUnit":{"state":"translated","value":"केवल तभी आवश्यक है जब Gateway को टोकन प्रमाणीकरण की आवश्यकता हो."}},"ar":{"stringUnit":{"state":"translated","value":"مطلوب فقط عندما يتطلب Gateway المصادقة باستخدام رمز."}},"it":{"stringUnit":{"state":"translated","value":"Necessario solo quando il Gateway richiede l'autenticazione tramite token."}},"tr":{"stringUnit":{"state":"translated","value":"Yalnızca Gateway, belirteçle kimlik doğrulaması gerektirdiğinde gereklidir."}},"uk":{"stringUnit":{"state":"translated","value":"Потрібно лише тоді, коли Gateway вимагає автентифікації за токеном."}},"id":{"stringUnit":{"state":"translated","value":"Hanya diperlukan jika Gateway memerlukan autentikasi token."}},"pl":{"stringUnit":{"state":"translated","value":"Wymagane tylko wtedy, gdy Gateway wymaga uwierzytelniania tokenem."}},"th":{"stringUnit":{"state":"translated","value":"จำเป็นเฉพาะเมื่อ Gateway ต้องใช้การยืนยันตัวตนด้วยโทเค็น."}},"vi":{"stringUnit":{"state":"transla