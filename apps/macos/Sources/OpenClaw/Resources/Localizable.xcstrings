    "Note: macOS may require restarting OpenClaw after enabling Accessibility or Screen Recording.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Note: macOS may require restarting OpenClaw after enabling Accessibility or Screen Recording."}},"zh-CN":{"stringUnit":{"state":"translated","value":"注意：启用辅助功能或屏幕录制后，macOS 可能需要重启 OpenClaw。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"注意：macOS 可能需要在啟用輔助使用或螢幕錄製後重新啟動 OpenClaw。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Observação: o macOS pode exigir reiniciar o OpenClaw após ativar Acessibilidade ou Gravação de Tela."}},"de":{"stringUnit":{"state":"translated","value":"Hinweis: macOS erfordert möglicherweise einen Neustart von OpenClaw, nachdem Bedienungshilfen oder Bildschirmaufnahme aktiviert wurden."}},"es":{"stringUnit":{"state":"translated","value":"Nota: macOS puede requerir reiniciar OpenClaw después de activar Accesibilidad o Grabación de pantalla."}},"ja-JP":{"stringUnit":{"state":"translated","value":"注: macOS では、Accessibility または Screen Recording を有効にした後、OpenClaw の再起動が必要になる場合があります。"}},"ko":{"stringUnit":{"state":"translated","value":"참고: macOS에서는 손쉬운 사용 또는 화면 기록을 활성화한 후 OpenClaw를 다시 시작해야 할 수 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Remarque : macOS peut nécessiter le redémarrage d’OpenClaw après l’activation de l’accessibilité ou de l’enregistrement de l’écran."}},"hi":{"stringUnit":{"state":"translated","value":"नोट: Accessibility या Screen Recording सक्षम करने के बाद macOS को OpenClaw रीस्टार्ट करने की आवश्यकता हो सकती है।"}},"ar":{"stringUnit":{"state":"translated","value":"ملاحظة: قد يتطلب macOS إعادة تشغيل OpenClaw بعد تمكين إمكانية الوصول أو تسجيل الشاشة."}},"it":{"stringUnit":{"state":"translated","value":"Nota: macOS potrebbe richiedere il riavvio di OpenClaw dopo l'abilitazione di Accessibilità o Registrazione schermo."}},"tr":{"stringUnit":{"state":"translated","value":"Not: macOS, Erişilebilirlik veya Ekran Kaydı etkinleştirildikten sonra OpenClaw’ın yeniden başlatılmasını gerektirebilir."}},"uk":{"stringUnit":{"state":"translated","value":"Примітка: macOS може потребувати перезапуску OpenClaw після ввімкнення Accessibility або Screen Recording."}},"id":{"stringUnit":{"state":"translated","value":"Catatan: macOS mungkin perlu memulai ulang OpenClaw setelah mengaktifkan Accessibility atau Screen Recording."}},"pl":{"stringUnit":{"state":"translated","value":"Uwaga: macOS może wymagać ponownego uruchomienia OpenClaw po włączeniu Dostępności lub Nagrywania ekranu."}},"th":{"stringUnit":{"state":"translated","value":"หมายเหตุ: macOS อาจต้องรีสตาร์ท OpenClaw หลังจากเปิดใช้งาน Accessibility หรือ Screen Recording"}},"vi":{"stringUnit":{"state":"translated","value":"Lưu ý: macOS có thể yêu cầu khởi động lại OpenClaw sau khi bật Trợ năng hoặc Ghi màn hình."}},"nl":{"stringUnit":{"state":"translated","value":"Opmerking: macOS kan vereisen dat OpenClaw opnieuw wordt gestart nadat Toegankelijkheid of Schermopname is ingeschakeld."}},"fa":{"stringUnit":{"state":"translated","value":"توجه: macOS ممکن است پس از فعال کردن Accessibility یا Screen Recording به راه‌اندازی مجدد OpenClaw نیاز داشته باشد."}},"ru":{"stringUnit":{"state":"translated","value":"Примечание: macOS может потребовать перезапустить OpenClaw после включения Универсального доступа или записи экрана."}},"sv":{"stringUnit":{"state":"translated","value":"Obs! macOS kan kräva att OpenClaw startas om efter att Hjälpmedel eller Skärminspelning har aktiverats."}}}},
    "Notice": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Notice"}},"zh-CN":{"stringUnit":{"state":"translated","value":"通知"}},"zh-TW":{"stringUnit":{"state":"translated","value":"通知"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Aviso"}},"de":{"stringUnit":{"state":"translated","value":"Hinweis"}},"es":{"stringUnit":{"state":"translated","value":"Aviso"}},"ja-JP":{"stringUnit":{"state":"new","value":"Notice"}},"ko":{"stringUnit":{"state":"translated","value":"알림"}},"fr":{"stringUnit":{"state":"translated","value":"Avis"}},"hi":{"stringUnit":{"state":"translated","value":"सूचना"}},"ar":{"stringUnit":{"state":"translated","value":"إشعار"}},"it":{"stringUnit":{"state":"translated","value":"Avviso"}},"tr":{"stringUnit":{"state":"translated","value":"Bildirim"}},"uk":{"stringUnit":{"state":"translated","value":"Сповіщення"}},"id":{"stringUnit":{"state":"translated","value":"Pemberitahuan"}},"pl":{"stringUnit":{"state":"translated","value":"Powiadomienie"}},"th":{"stringUnit":{"state":"translated","value":"ประกาศ"}},"vi":{"stringUnit":{"state":"translated","value":"Thông báo"}},"nl":{"stringUnit":{"state":"translated","value":"Kennisgeving"}},"fa":{"stringUnit":{"state":"translated","value":"اعلان"}},"ru":{"stringUnit":{"state":"translated","value":"Уведомление"}},"sv":{"stringUnit":{"state":"translated","value":"Meddelande"}}}},
    "OK": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OK"}},"zh-CN":{"stringUnit":{"state":"translated","value":"好"}},"zh-TW":{"stringUnit":{"state":"translated","value":"好"}},"pt-BR":{"stringUnit":{"state":"new","value":"OK"}},"de":{"stringUnit":{"state":"new","value":"OK"}},"es":{"stringUnit":{"state":"translated","value":"Aceptar"}},"ja-JP":{"stringUnit":{"state":"new","value":"OK"}},"ko":{"stringUnit":{"state":"translated","value":"확인"}},"fr":{"stringUnit":{"state":"new","value":"OK"}},"hi":{"stringUnit":{"state":"translated","value":"ठीक है"}},"ar":{"stringUnit":{"state":"translated","value":"موافق"}},"it":{"stringUnit":{"state":"new","value":"OK"}},"tr":{"stringUnit":{"state":"translated","value":"Tamam"}},"uk":{"stringUnit":{"state":"translated","value":"Гаразд"}},"id":{"stringUnit":{"state":"new","value":"OK"}},"pl":{"stringUnit":{"state":"new","value":"OK"}},"th":{"stringUnit":{"state":"translated","value":"ตกลง"}},"vi":{"stringUnit":{"state":"new","value":"OK"}},"nl":{"stringUnit":{"state":"new","value":"OK"}},"fa":{"stringUnit":{"state":"translated","value":"تأیید"}},"ru":{"stringUnit":{"state":"translated","value":"ОК"}},"sv":{"stringUnit":{"state":"new","value":"OK"}}}},
    "OK — OpenClaw won’t start anything yet. Pick Local or Remote later in Settings → General.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OK — OpenClaw won’t start anything yet. Pick Local or Remote later in Settings → General."}},"zh-CN":{"stringUnit":{"state":"translated","value":"好的 — OpenClaw 还不会启动任何内容。稍后可在 Settings → General 中选择 Local 或 Remote。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OK — OpenClaw 還不會啟動任何項目。稍後可在設定 → 一般中選擇本機或遠端。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"OK — o OpenClaw ainda não vai iniciar nada. Escolha Local ou Remoto depois em Ajustes → Geral."}},"de":{"stringUnit":{"state":"translated","value":"OK — OpenClaw startet noch nichts. Wählen Sie später in Einstellungen → Allgemein „Lokal“ oder „Remote“ aus."}},"es":{"stringUnit":{"state":"translated","value":"OK — OpenClaw no iniciará nada todavía. Elige Local o Remoto más tarde en Ajustes → General."}},"ja-JP":{"stringUnit":{"state":"translated","value":"OK — OpenClaw はまだ何も開始しません。後で Settings → General で Local または Remote を選択してください。"}},"ko":{"stringUnit":{"state":"translated","value":"확인 — OpenClaw는 아직 아무것도 시작하지 않습니다. 나중에 설정 → 일반에서 로컬 또는 원격을 선택하세요."}},"fr":{"stringUnit":{"state":"translated","value":"OK — OpenClaw ne démarrera encore rien. Choisissez Local ou Remote plus tard dans Réglages → Général."}},"hi":{"stringUnit":{"state":"translated","value":"OK — OpenClaw अभी कुछ भी शुरू नहीं करेगा। बाद में Settings → General में Local या Remote चुनें।"}},"ar":{"stringUnit":{"state":"translated","value":"حسنًا — لن يبدأ OpenClaw أي شيء بعد. اختر محليًا أو عن بُعد لاحقًا من الإعدادات → عام."}},"it":{"stringUnit":{"state":"translated","value":"OK — OpenClaw non avvierà ancora nulla. Scegli Locale o Remoto più tardi in Impostazioni → Generali."}},"tr":{"stringUnit":{"state":"translated","value":"Tamam — OpenClaw henüz hiçbir şey başlatmayacak. Daha sonra Ayarlar → Genel bölümünde Yerel veya Uzak seçeneğini belirleyin."}},"uk":{"stringUnit":{"state":"translated","value":"OK — OpenClaw поки нічого не запускатиме. Виберіть Local або Remote пізніше в Settings → General."}},"id":{"stringUnit":{"state":"translated","value":"OK — OpenClaw belum akan memulai apa pun. Pilih Lokal atau Jarak Jauh nanti di Pengaturan → Umum."}},"pl":{"stringUnit":{"state":"translated","value":"OK — OpenClaw jeszcze niczego nie uruchomi. Wybierz Local lub Remote później w Settings → General."}},"th":{"stringUnit":{"state":"translated","value":"ตกลง — OpenClaw จะยังไม่เริ่มอะไรตอนนี้ เลือก Local หรือ Remote ภายหลังได้ใน Settings → General"}},"vi":{"stringUnit":{"state":"translated","value":"OK — OpenClaw sẽ chưa khởi động gì cả. Chọn Cục bộ hoặc Từ xa sau trong Cài đặt → Chung."}},"nl":{"stringUnit":{"state":"translated","value":"OK — OpenClaw start nog niets. Kies later Lokaal of Extern in Instellingen → Algemeen."}},"fa":{"stringUnit":{"state":"translated","value":"باشه — OpenClaw هنوز چیزی را شروع نمی‌کند. بعداً در Settings → General گزینهٔ Local یا Remote را انتخاب کنید."}},"ru":{"stringUnit":{"state":"translated","value":"OK — OpenClaw пока ничего не запустит. Выберите Local или Remote позже в Settings → General."}},"sv":{"stringUnit":{"state":"translated","value":"OK — OpenClaw startar inget än. Välj Lokal eller Fjärransluten senare i Inställningar → Allmänt."}}}},
    "Off": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Off"}},"zh-CN":{"stringUnit":{"state":"translated","value":"关闭"}},"zh-TW":{"stringUnit":{"state":"translated","value":"關閉"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Desativado"}},"de":{"stringUnit":{"state":"translated","value":"Aus"}},"es":{"stringUnit":{"state":"translated","value":"Desactivado"}},"ja-JP":{"stringUnit":{"state":"translated","value":"オフ"}},"ko":{"stringUnit":{"state":"translated","value":"끔"}},"fr":{"stringUnit":{"state":"translated","value":"Désactivé"}},"hi":{"stringUnit":{"state":"translated","value":"बंद"}},"ar":{"stringUnit":{"state":"translated","value":"إيقاف"}},"it":{"stringUnit":{"state":"translated","value":"Disattivato"}},"tr":{"stringUnit":{"state":"translated","value":"Kapalı"}},"uk":{"stringUnit":{"state":"translated","value":"Вимкнено"}},"id":{"stringUnit":{"state":"translated","value":"Nonaktif"}},"pl":{"stringUnit":{"state":"translated","value":"Wył."}},"th":{"stringUnit":{"state":"translated","value":"ปิด"}},"vi":{"stringUnit":{"state":"translated","value":"Tắt"}},"nl":{"stringUnit":{"state":"translated","value":"Uit"}},"fa":{"stringUnit":{"state":"translated","value":"خاموش"}},"ru":{"stringUnit":{"state":"translated","value":"Выкл."}},"sv":{"stringUnit":{"state":"translated","value":"Av"}}}},
    "Older generated approvals are inactive because they were not tied to a working directory. Manual rules are unchanged.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Older generated approvals are inactive because they were not tied to a working directory. Manual rules are unchanged."}},"zh-CN":{"stringUnit":{"state":"translated","value":"旧的生成审批已停用，因为它们未绑定到工作目录。手动规则保持不变。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"較舊的自動產生核准已停用，因為它們未綁定至工作目錄。手動規則不受影響。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Aprovações geradas mais antigas estão inativas porque não foram vinculadas a um diretório de trabalho. As regras manuais permanecem inalteradas."}},"de":{"stringUnit":{"state":"translated","value":"Ältere generierte Freigaben sind inaktiv, da sie nicht an ein Arbeitsverzeichnis gebunden waren. Manuelle Regeln bleiben unverändert."}},"es":{"stringUnit":{"state":"translated","value":"Las aprobaciones generadas más antiguas están inactivas porque no estaban vinculadas a un directorio de trabajo. Las reglas manuales no se modifican."}},"ja-JP":{"stringUnit":{"state":"translated","value":"以前に生成された承認は、作業ディレクトリに紐づいていないため無効です。手動ルールは変更されません。"}},"ko":{"stringUnit":{"state":"translated","value":"이전에 생성된 승인은 작업 디렉터리에 연결되지 않았기 때문에 비활성화되었습니다. 수동 규칙은 변경되지 않습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les approbations générées plus anciennes sont inactives car elles n'étaient pas liées à un répertoire de travail. Les règles manuelles sont inchangées."}},"hi":{"stringUnit":{"state":"translated","value":"पुरानी जनरेट की गई स्वीकृतियाँ निष्क्रिय हैं क्योंकि वे किसी कार्यशील डायरेक्टरी से जुड़ी नहीं थीं। मैन्युअल नियम अपरिवर्तित हैं।"}},"ar":{"stringUnit":{"state":"translated","value":"الموافقات المُنشأة الأقدم غير نشطة لأنها لم تكن مرتبطة بدليل عمل. القواعد اليدوية لم تتغير."}},"it":{"stringUnit":{"state":"translated","value":"Le approvazioni generate più vecchie sono inattive perché non erano associate a una directory di lavoro. Le regole manuali sono invariate."}},"tr":{"stringUnit":{"state":"translated","value":"Daha eski oluşturulan onaylar, bir çalışma diziniyle ilişkilendirilmediği için etkin değildir. Manuel kurallar değişmez."}},"uk":{"stringUnit":{"state":"translated","value":"Старіші згенеровані дозволи неактивні, оскільки вони не були прив'язані до робочого каталогу. Ручні правила без змін."}},"id":{"stringUnit":{"state":"translated","value":"Persetujuan yang dihasilkan lebih lama tidak aktif karena tidak terkait dengan direktori kerja. Aturan manual tidak berubah."}},"pl":{"stringUnit":{"state":"translated","value":"Starsze wygenerowane zatwierdzenia są nieaktywne, ponieważ nie były powiązane z katalogiem roboczym. Reguły ręczne pozostają bez zmian."}},"th":{"stringUnit":{"state":"translated","value":"การอนุมัติที่สร้างขึ้นก่อนหน้านี้จะไม่ทำงานเนื่องจากไม่ได้ผูกกับไดเรกทอรีทำงาน กฎที่กำหนดด้วยตนเองยังคงเดิม"}},"vi":{"stringUnit":{"state":"translated","value":"Các phê duyệt được tạo trước đây đang không hoạt động vì chúng không gắn với một thư mục làm việc. Các quy tắc thủ công không thay đổi."}},"nl":{"stringUnit":{"state":"translated","value":"Oudere gegenereerde goedkeuringen zijn inactief omdat ze niet aan een werkmap waren gekoppeld. Handmatige regels zijn ongewijzigd."}},"fa":{"stringUnit":{"state":"translated","value":"تأییدهای تولیدشده قدیمی‌تر غیرفعال هستند زیرا به یک دایرکتوری کاری متصل نبودند. قوانین دستی بدون تغییر باقی مانده‌اند."}},"ru":{"stringUnit":{"state":"translated","value":"Старые сгенерированные разрешения неактивны, потому что не были привязаны к рабочему каталогу. Ручные правила не изменены."}},"sv":{"stringUnit":{"state":"translated","value":"Äldre genererade godkännanden är inaktiva eftersom de inte var kopplade till en arbetskatalog. Manuella regler är oförändrade."}}}},
    "On": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"On"}},"zh-CN":{"stringUnit":{"state":"translated","value":"开启"}},"zh-TW":{"stringUnit":{"state":"translated","value":"開啟"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ativado"}},"de":{"stringUnit":{"state":"translated","value":"Ein"}},"es":{"stringUnit":{"state":"translated","value":"Activado"}},"ja-JP":{"stringUnit":{"state":"translated","value":"オン"}},"ko":{"stringUnit":{"state":"translated","value":"켬"}},"fr":{"stringUnit":{"state":"translated","value":"Activé"}},"hi":{"stringUnit":{"state":"translated","value":"चालू"}},"ar":{"stringUnit":{"state":"translated","value":"تشغيل"}},"it":{"stringUnit":{"state":"translated","value":"Attivato"}},"tr":{"stringUnit":{"state":"translated","value":"Açık"}},"uk":{"stringUnit":{"state":"translated","value":"Увімкнено"}},"id":{"stringUnit":{"state":"translated","value":"Aktif"}},"pl":{"stringUnit":{"state":"translated","value":"Włączone"}},"th":{"stringUnit":{"state":"translated","value":"เปิด"}},"vi":{"stringUnit":{"state":"translated","value":"Bật"}},"nl":{"stringUnit":{"state":"translated","value":"Aan"}},"fa":{"stringUnit":{"state":"translated","value":"روشن"}},"ru":{"stringUnit":{"state":"translated","value":"Вкл."}},"sv":{"stringUnit":{"state":"translated","value":"På"}}}},
    "On another computer": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"On another computer"}},"zh-CN":{"stringUnit":{"state":"translated","value":"在另一台电脑上"}},"zh-TW":{"stringUnit":{"state":"translated","value":"在另一台電腦上"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Em outro computador"}},"de":{"stringUnit":{"state":"translated","value":"Auf einem anderen Computer"}},"es":{"stringUnit":{"state":"translated","value":"En otro ordenador"}},"ja-JP":{"stringUnit":{"state":"translated","value":"別のコンピューター上"}},"ko":{"stringUnit":{"state":"translated","value":"다른 컴퓨터에서"}},"fr":{"stringUnit":{"state":"translated","value":"Sur un autre ordinateur"}},"hi":{"stringUnit":{"state":"translated","value":"किसी दूसरे कंप्यूटर पर"}},"ar":{"stringUnit":{"state":"translated","value":"على كمبيوتر آخر"}},"it":{"stringUnit":{"state":"translated","value":"Su un altro computer"}},"tr":{"stringUnit":{"state":"translated","value":"Başka bir bilgisayarda"}},"uk":{"stringUnit":{"state":"translated","value":"На іншому комп’ютері"}},"id":{"stringUnit":{"state":"translated","value":"Di komputer lain"}},"pl":{"stringUnit":{"state":"translated","value":"Na innym komputerze"}},"th":{"stringUnit":{"state":"translated","value":"บนคอมพิวเตอร์เครื่องอื่น"}},"vi":{"stringUnit":{"state":"translated","value":"Trên máy tính khác"}},"nl":{"stringUnit":{"state":"translated","value":"Op een andere computer"}},"fa":{"stringUnit":{"state":"translated","value":"روی یک رایانه دیگر"}},"ru":{"stringUnit":{"state":"translated","value":"На другом компьютере"}},"sv":{"stringUnit":{"state":"translated","value":"På en annan dator"}}}},
    "On the gateway host, run `openclaw gateway auth-token --show` in an interactive terminal, then replace the token and try again.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"On the gateway host, run `openclaw gateway auth-token --show` in an interactive terminal, then replace the token and try again."}},"zh-CN":{"stringUnit":{"state":"translated","value":"在 gateway 主机上，于交互式终端中运行 `openclaw gateway auth-token --show`，然后替换令牌并重试。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"在 gateway 主機上，於互動式終端機中執行 `openclaw gateway auth-token --show`，然後替換權杖並再試一次。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"No host do gateway, execute `openclaw gateway auth-token --show` em um terminal interativo, substitua o token e tente novamente."}},"de":{"stringUnit":{"state":"translated","value":"Führen Sie auf dem Gateway-Host `openclaw gateway auth-token --show` in einem interaktiven Terminal aus, ersetzen Sie dann das Token und versuchen Sie es erneut."}},"es":{"stringUnit":{"state":"translated","value":"En el host del Gateway, ejecuta `openclaw gateway auth-token --show` en una terminal interactiva, luego reemplaza el token e inténtalo de nuevo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayホストで、対話型ターミナルで `openclaw gateway auth-token --show` を実行し、トークンを置き換えてから再試行してください。"}},"ko":{"stringUnit":{"state":"translated","value":"gateway 호스트에서 대화형 터미널로 `openclaw gateway auth-token --show`를 실행한 다음 토큰을 교체하고 다시 시도하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Sur l'hôte du gateway, exécutez `openclaw gateway auth-token --show` dans un terminal interactif, puis remplacez le jeton et réessayez."}},"hi":{"stringUnit":{"state":"translated","value":"gateway host पर, एक इंटरैक्टिव टर्मिनल में `openclaw gateway auth-token --show` चलाएँ, फिर token बदलें और पुनः प्रयास करें।"}},"ar":{"stringUnit":{"state":"translated","value":"على مضيف Gateway، شغّل `openclaw gateway auth-token --show` في طرفية تفاعلية، ثم استبدل الرمز وأعد المحاولة."}},"it":{"stringUnit":{"state":"translated","value":"Sull'host del gateway, esegui `openclaw gateway auth-token --show` in un terminale interattivo, quindi sostituisci il token e riprova."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway ana bilgisayarında, etkileşimli bir terminalde `openclaw gateway auth-token --show` komutunu çalıştırın, ardından belirteci değiştirip yeniden deneyin."}},"uk":{"stringUnit":{"state":"translated","value":"На хості Gateway виконайте `openclaw gateway auth-token --show` в інтерактивному терміналі, потім замініть токен і спробуйте ще раз."}},"id":{"stringUnit":{"state":"translated","value":"Di host gateway, jalankan `openclaw gateway auth-token --show` di terminal interaktif, lalu ganti token dan coba lagi."}},"pl":{"stringUnit":{"state":"translated","value":"Na hoście gateway uruchom `openclaw gateway auth-token --show` w interaktywnym terminalu, następnie zastąp token i spróbuj ponownie."}},"th":{"stringUnit":{"state":"translated","value":"บนโฮสต์ Gateway ให้รัน `openclaw gateway auth-token --show` ในเทอร์มินัลแบบโต้ตอบ จากนั้นแทนที่โทเคนแล้วลองอีกครั้ง"}},"vi":{"stringUnit":{"state":"translated","value":"Trên máy chủ gateway, chạy `openclaw gateway auth-token --show` trong terminal tương tác, sau đó thay thế token và thử lại."}},"nl":{"stringUnit":{"state":"translated","value":"Voer op de gateway-host `openclaw gateway auth-token --show` uit in een interactieve terminal, vervang vervolgens het token en probeer het opnieuw."}},"fa":{"stringUnit":{"state":"translated","value":"روی میزبان Gateway، دستور `openclaw gateway auth-token --show` را در یک ترمینال تعاملی اجرا کنید، سپس توکن را جایگزین کرده و دوباره تلاش کنید."}},"ru":{"stringUnit":{"state":"translated","value":"На хосте Gateway выполните `openclaw gateway auth-token --show` в интерактивном терминале, затем замените токен и повторите попытку."}},"sv":{"stringUnit":{"state":"translated","value":"På gateway-värden kör du `openclaw gateway auth-token --show` i en interaktiv terminal, ersätter sedan token och försöker igen."}}}},
    "On this Mac": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"On this Mac"}},"zh-CN":{"stringUnit":{"state":"translated","value":"在这台 Mac 上"}},"zh-TW":{"stringUnit":{"state":"translated","value":"在這台 Mac 上"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Neste Mac"}},"de":{"stringUnit":{"state":"translated","value":"Auf diesem Mac"}},"es":{"stringUnit":{"state":"translated","value":"En este Mac"}},"ja-JP":{"stringUnit":{"state":"translated","value":"この Mac 上"}},"ko":{"stringUnit":{"state":"translated","value":"이 Mac에서"}},"fr":{"stringUnit":{"state":"translated","value":"Sur ce Mac"}},"hi":{"stringUnit":{"state":"translated","value":"इस Mac पर"}},"ar":{"stringUnit":{"state":"translated","value":"على جهاز Mac هذا"}},"it":{"stringUnit":{"state":"translated","value":"Su questo Mac"}},"tr":{"stringUnit":{"state":"translated","value":"Bu Mac’te"}},"uk":{"stringUnit":{"state":"translated","value":"На цьому Mac"}},"id":{"stringUnit":{"state":"translated","value":"Di Mac ini"}},"pl":{"stringUnit":{"state":"translated","value":"Na tym Macu"}},"th":{"stringUnit":{"state":"translated","value":"บน Mac เครื่องนี้"}},"vi":{"stringUnit":{"state":"translated","value":"Trên máy Mac này"}},"nl":{"stringUnit":{"state":"translated","value":"Op deze Mac"}},"fa":{"stringUnit":{"state":"translated","value":"روی این Mac"}},"ru":{"stringUnit":{"state":"translated","value":"На этом Mac"}},"sv":{"stringUnit":{"state":"translated","value":"På den här Mac-datorn"}}}},
    "On-device recognition is unavailable for the selected language on this Mac.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"On-device recognition is unavailable for the selected language on this Mac."}},"zh-CN":{"stringUnit":{"state":"translated","value":"此 Mac 上所选语言不支持设备端识别。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此 Mac 上所選語言無法使用裝置端辨識。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O reconhecimento no dispositivo não está disponível para o idioma selecionado neste Mac."}},"de":{"stringUnit":{"state":"translated","value":"Die Erkennung auf dem Gerät ist für die ausgewählte Sprache auf diesem Mac nicht verfügbar."}},"es":{"stringUnit":{"state":"translated","value":"El reconocimiento en el dispositivo no está disponible para el idioma seleccionado en este Mac."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このMacでは、選択した言語のデバイス上での認識を利用できません。"}},"ko":{"stringUnit":{"state":"translated","value":"이 Mac에서는 선택한 언어의 기기 내 인식을 사용할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"La reconnaissance sur l'appareil n'est pas disponible pour la langue sélectionnée sur ce Mac."}},"hi":{"stringUnit":{"state":"translated","value":"इस Mac पर चयनित भाषा के लिए ऑन-डिवाइस पहचान अनुपलब्ध है।"}},"ar":{"stringUnit":{"state":"translated","value":"التعرف على الجهاز غير متوفر للغة المحددة على هذا الـ Mac."}},"it":{"stringUnit":{"state":"translated","value":"Il riconoscimento sul dispositivo non è disponibile per la lingua selezionata su questo Mac."}},"tr":{"stringUnit":{"state":"translated","value":"Seçili dil için bu Mac'te cihaz üzerinde tanıma kullanılamıyor."}},"uk":{"stringUnit":{"state":"translated","value":"Розпізнавання на пристрої недоступне для вибраної мови на цьому Mac."}},"id":{"stringUnit":{"state":"translated","value":"Pengenalan di perangkat tidak tersedia untuk bahasa yang dipilih di Mac ini."}},"pl":{"stringUnit":{"state":"translated","value":"Rozpoznawanie na urządzeniu jest niedostępne dla wybranego języka na tym Macu."}},"th":{"stringUnit":{"state":"translated","value":"การจดจำบนอุปกรณ์ไม่พร้อมใช้งานสำหรับภาษาที่เลือกบน Mac เครื่องนี้"}},"vi":{"stringUnit":{"state":"translated","value":"Nhận dạng trên thiết bị không khả dụng cho ngôn ngữ đã chọn trên máy Mac này."}},"nl":{"stringUnit":{"state":"translated","value":"Herkenning op het apparaat is niet beschikbaar voor de geselecteerde taal op deze Mac."}},"fa":{"stringUnit":{"state":"translated","value":"تشخیص روی دستگاه برای زبان انتخاب‌شده روی این Mac در دسترس نیست."}},"ru":{"stringUnit":{"state":"translated","value":"Распознавание на устройстве недоступно для выбранного языка на этом Mac."}},"sv":{"stringUnit":{"state":"translated","value":"Igenkänning på enheten är inte tillgänglig för det valda språket på denna Mac."}}}},
    "Onboarding walkthrough": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Onboarding walkthrough"}},"zh-CN":{"stringUnit":{"state":"translated","value":"引导演示"}},"zh-TW":{"stringUnit":{"state":"translated","value":"入門導覽"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Passo a passo de integração"}},"de":{"stringUnit":{"state":"translated","value":"Onboarding-Einführung"}},"es":{"stringUnit":{"state":"translated","value":"Recorrido de incorporación"}},"ja-JP":{"stringUnit":{"state":"translated","value":"オンボーディングのウォークスルー"}},"ko":{"stringUnit":{"state":"translated","value":"온보딩 안내"}},"fr":{"stringUnit":{"state":"translated","value":"Parcours d’intégration"}},"hi":{"stringUnit":{"state":"translated","value":"ऑनबोर्डिंग वॉकथ्रू"}},"ar":{"stringUnit":{"state":"translated","value":"جولة الإعداد الأولي"}},"it":{"stringUnit":{"state":"translated","value":"Procedura guidata introduttiva"}},"tr":{"stringUnit":{"state":"translated","value":"İlk kurulum adım adım kılavuzu"}},"uk":{"stringUnit":{"state":"translated","value":"Ознайомчий тур"}},"id":{"stringUnit":{"state":"translated","value":"Panduan orientasi"}},"pl":{"stringUnit":{"state":"translated","value":"Przewodnik wdrożeniowy"}},"th":{"stringUnit":{"state":"translated","value":"คำแนะนำการเริ่มต้นใช้งาน"}},"vi":{"stringUnit":{"state":"translated","value":"Hướng dẫn làm quen"}},"nl":{"stringUnit":{"state":"translated","value":"Onboarding-walkthrough"}},"fa":{"stringUnit":{"state":"translated","value":"راهنمای مرحله‌به‌مرحلهٔ شروع"}},"ru":{"stringUnit":{"state":"translated","value":"Пошаговое ознакомление"}},"sv":{"stringUnit":{"state":"translated","value":"Introduktionsgenomgång"}}}},
    "Once the service answers, you’ll connect your AI.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Once the service answers, you’ll connect your AI."}},"zh-CN":{"stringUnit":{"state":"translated","value":"服务响应后，你将连接你的 AI。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"服務回應後，你就可以連接你的 AI。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Quando o serviço responder, você conectará sua IA."}},"de":{"stringUnit":{"state":"translated","value":"Sobald der Dienst antwortet, verbinden Sie Ihre KI."}},"es":{"stringUnit":{"state":"translated","value":"Cuando el servicio responda, conectarás tu IA."}},"ja-JP":{"stringUnit":{"state":"translated","value":"サービスが応答したら、AI に接続します。"}},"ko":{"stringUnit":{"state":"translated","value":"서비스가 응답하면 AI를 연결하게 됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Une fois que le service répond, vous connecterez votre IA."}},"hi":{"stringUnit":{"state":"translated","value":"जब service जवाब देगी, तब आप अपना AI कनेक्ट करेंगे।"}},"ar":{"stringUnit":{"state":"translated","value":"بمجرد أن تستجيب الخدمة، ستتمكن من توصيل الذكاء الاصطناعي الخاص بك."}},"it":{"stringUnit":{"state":"translated","value":"Quando il servizio risponde, collegherai la tua AI."}},"tr":{"stringUnit":{"state":"translated","value":"Hizmet yanıt verdiğinde, yapay zekanızı bağlayacaksınız."}},"uk":{"stringUnit":{"state":"translated","value":"Коли служба відповість, ви підключите свій AI."}},"id":{"stringUnit":{"state":"translated","value":"Setelah layanan merespons, Anda akan menghubungkan AI Anda."}},"pl":{"stringUnit":{"state":"translated","value":"Gdy usługa odpowie, połączysz swoją AI."}},"th":{"stringUnit":{"state":"translated","value":"เมื่อบริการตอบสนองแล้ว คุณจะเชื่อมต่อ AI ของคุณ"}},"vi":{"stringUnit":{"state":"translated","value":"Khi dịch vụ phản hồi, bạn sẽ kết nối AI của mình."}},"nl":{"stringUnit":{"state":"translated","value":"Zodra de service reageert, verbind je je AI."}},"fa":{"stringUnit":{"state":"translated","value":"وقتی سرویس پاسخ دهد، هوش مصنوعی خود را متصل می‌کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Когда служба ответит, вы подключите свой ИИ."}},"sv":{"stringUnit":{"state":"translated","value":"När tjänsten svarar ansluter du din AI."}}}},
    "Only image and video attachments are supported right now": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Only image and video attachments are supported right now"}},"zh-CN":{"stringUnit":{"state":"translated","value":"目前仅支持图片和视频附件"}},"zh-TW":{"stringUnit":{"state":"translated","value":"目前僅支援圖片與影片附件"}},"pt-BR":{"stringUnit":{"state":"translated","value":"No momento, apenas anexos de imagem e vídeo são suportados"}},"de":{"stringUnit":{"state":"translated","value":"Derzeit werden nur Bild- und Videoanhänge unterstützt"}},"es":{"stringUnit":{"state":"translated","value":"Por ahora solo se admiten adjuntos de imagen y video"}},"ja-JP":{"stringUnit":{"state":"translated","value":"現在サポートされているのは画像と動画の添付ファイルのみです"}},"ko":{"stringUnit":{"state":"translated","value":"현재 이미지 및 비디오 첨부 파일만 지원됩니다"}},"fr":{"stringUnit":{"state":"translated","value":"Seules les pièces jointes image et vidéo sont prises en charge pour le moment"}},"hi":{"stringUnit":{"state":"translated","value":"अभी केवल इमेज और वीडियो अटैचमेंट समर्थित हैं"}},"ar":{"stringUnit":{"state":"translated","value":"يتم دعم مرفقات الصور والفيديو فقط في الوقت الحالي"}},"it":{"stringUnit":{"state":"translated","value":"Al momento sono supportati solo allegati di immagini e video"}},"tr":{"stringUnit":{"state":"translated","value":"Şu anda yalnızca görüntü ve video ekleri destekleniyor"}},"uk":{"stringUnit":{"state":"translated","value":"Наразі підтримуються лише вкладення зображень і відео"}},"id":{"stringUnit":{"state":"translated","value":"Hanya lampiran gambar dan video yang didukung saat ini"}},"pl":{"stringUnit":{"state":"translated","value":"Obecnie obsługiwane są tylko załączniki obrazów i wideo"}},"th":{"stringUnit":{"state":"translated","value":"ขณะนี้รองรับเฉพาะไฟล์แนบรูปภาพและวิดีโอเท่านั้น"}},"vi":{"stringUnit":{"state":"translated","value":"Hiện chỉ hỗ trợ tệp đính kèm hình ảnh và video"}},"nl":{"stringUnit":{"state":"translated","value":"Momenteel worden alleen afbeeldings- en videobijlagen ondersteund"}},"fa":{"stringUnit":{"state":"translated","value":"در حال حاضر فقط پیوست‌های تصویری و ویدیویی پشتیبانی می‌شوند"}},"ru":{"stringUnit":{"state":"translated","value":"Сейчас поддерживаются только вложения с изображениями и видео"}},"sv":{"stringUnit":{"state":"translated","value":"Endast bild- och videobilagor stöds för närvarande"}}}},
    "Only image attachments are supported right now": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Only image attachments are supported right now"}},"zh-CN":{"stringUnit":{"state":"translated","value":"目前仅支持图片附件"}},"zh-TW":{"stringUnit":{"state":"translated","value":"目前僅支援圖片附件"}},"pt-BR":{"stringUnit":{"state":"translated","value":"No momento, apenas anexos de imagem são compatíveis"}},"de":{"stringUnit":{"state":"translated","value":"Derzeit werden nur Bildanhänge unterstützt"}},"es":{"stringUnit":{"state":"translated","value":"Por ahora, solo se admiten archivos adjuntos de imagen"}},"ja-JP":{"stringUnit":{"state":"translated","value":"現在サポートされているのは画像の添付ファイルのみです"}},"ko":{"stringUnit":{"state":"translated","value":"현재는 이미지 첨부 파일만 지원됩니다"}},"fr":{"stringUnit":{"state":"translated","value":"Seules les pièces jointes de type image sont actuellement prises en charge"}},"hi":{"stringUnit":{"state":"translated","value":"फ़िलहाल केवल इमेज अटैचमेंट समर्थित हैं"}},"ar":{"stringUnit":{"state":"translated","value":"لا تُدعم حاليًا سوى مرفقات الصور"}},"it":{"stringUnit":{"state":"translated","value":"Al momento sono supportati solo gli allegati immagine"}},"tr":{"stringUnit":{"state":"translated","value":"Şu anda yalnızca görsel ekleri destekleniyor"}},"uk":{"stringUnit":{"state":"translated","value":"Наразі підтримуються лише вкладення із зображеннями"}},"id":{"stringUnit":{"state":"translated","value":"Saat ini hanya lampiran gambar yang didukung"}},"pl":{"stringUnit":{"state":"translated","value":"Obecnie obsługiwane są tylko załączniki graficzne"}},"th":{"stringUnit":{"state":"translated","value":"ขณะนี้รองรับเฉพาะไฟล์แนบรูปภาพเท่านั้น"}},"vi":{"stringUnit":{"state":"translated","value":"Hiện tại chỉ hỗ trợ tệp đính kèm hình ảnh"}},"nl":{"stringUnit":{"state":"translated","value":"Momenteel worden alleen afbeeldingsbijlagen ondersteund"}},"fa":{"stringUnit":{"state":"translated","value":"در حال حاضر فقط پیوست‌های تصویری پشتیبانی می‌شوند"}},"ru":{"stringUnit":{"state":"translated","value":"Сейчас поддерживаются только изображения"}},"sv":{"stringUnit":{"state":"translated","value":"Endast bildbilagor stöds just nu"}}}},
    "Only needed when the gateway requires token auth.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Only needed when the gateway requires token auth."}},"zh-CN":{"stringUnit":{"state":"translated","value":"仅在 gateway 需要令牌认证时才需要。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"僅在 gateway 需要權杖驗證時才需要。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Necessário apenas quando o gateway exige autenticação por token."}},"de":{"stringUnit":{"state":"translated","value":"Nur erforderlich, wenn das Gateway eine Token-Authentifizierung verlangt."}},"es":{"stringUnit":{"state":"translated","value":"Solo es necesario cuando el gateway requiere autenticación por token."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gateway がトークン認証を必要とする場合のみ必要です。"}},"ko":{"stringUnit":{"state":"translated","value":"게이트웨이에서 토큰 인증이 필요한 경우에만 필요합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Nécessaire uniquement lorsque le gateway requiert une authentification par jeton."}},"hi":{"stringUnit":{"state":"translated","value":"केवल तभी आवश्यक जब gateway को टोकन प्रमाणीकरण चाहिए।"}},"ar":{"stringUnit":{"state":"translated","value":"مطلوب فقط عندما يتطلب الـ gateway مصادقة برمز مميز."}},"it":{"stringUnit":{"state":"translated","value":"Necessario solo quando il gateway richiede l'autenticazione con token."}},"tr":{"stringUnit":{"state":"translated","value":"Yalnızca gateway belirteç kimlik doğrulaması gerektirdiğinde gereklidir."}},"uk":{"stringUnit":{"state":"translated","value":"Потрібно лише коли gateway вимагає автентифікації за токеном."}},"id":{"stringUnit":{"state":"translated","value":"Hanya diperlukan saat gateway membutuhkan autentikasi token."}},"pl":{"stringUnit":{"state":"translated","value":"Wymagane tylko, gdy gateway wymaga uwierzytelniania tokenem."}},"th":{"stringUnit":{"state":"translated","value":"จำเป็นเฉพาะเมื่อ gateway ต้องการการยืนยันตัวตนด้วยโทเค็นเท่านั้น"}},"vi":{"stringUnit":{"state":"translated","value":"Chỉ cần thiết khi gateway yêu cầu xác thực bằng token."}},"nl":{"stringUnit":{"state":"translated","value":"Alleen nodig wanneer de gateway tokenauthenticatie vereist."}},"fa":{"stringUnit":{"state":"translated","value":"فقط زمانی لازم است که gateway به احراز هویت با توکن نیاز دارد."}},"ru":{"stringUnit":{"state":"translated","value":"Требуется только когда gateway использует авторизацию по токену."}},"sv":{"stringUnit":{"state":"translated","value":"Behövs bara när gatewayen kräver token-autentisering."}}}},
