    "Controls": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Controls"}},"zh-CN":{"stringUnit":{"state":"translated","value":"控制项"}},"zh-TW":{"stringUnit":{"state":"translated","value":"控制項"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Controles"}},"de":{"stringUnit":{"state":"translated","value":"Steuerelemente"}},"es":{"stringUnit":{"state":"translated","value":"Controles"}},"ja-JP":{"stringUnit":{"state":"translated","value":"コントロール"}},"ko":{"stringUnit":{"state":"translated","value":"제어"}},"fr":{"stringUnit":{"state":"translated","value":"Commandes"}},"hi":{"stringUnit":{"state":"translated","value":"नियंत्रण"}},"ar":{"stringUnit":{"state":"translated","value":"عناصر التحكم"}},"it":{"stringUnit":{"state":"translated","value":"Controlli"}},"tr":{"stringUnit":{"state":"translated","value":"Denetimler"}},"uk":{"stringUnit":{"state":"translated","value":"Елементи керування"}},"id":{"stringUnit":{"state":"translated","value":"Kontrol"}},"pl":{"stringUnit":{"state":"translated","value":"Elementy sterujące"}},"th":{"stringUnit":{"state":"translated","value":"การควบคุม"}},"vi":{"stringUnit":{"state":"translated","value":"Các tùy chọn điều khiển"}},"nl":{"stringUnit":{"state":"translated","value":"Bediening"}},"fa":{"stringUnit":{"state":"translated","value":"کنترل‌ها"}},"ru":{"stringUnit":{"state":"translated","value":"Элементы управления"}},"sv":{"stringUnit":{"state":"translated","value":"Kontroller"}}}},
    "Controls the macOS app log verbosity.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Controls the macOS app log verbosity."}},"zh-CN":{"stringUnit":{"state":"translated","value":"控制 macOS 应用日志的详细程度。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"控制 macOS 應用程式日誌的詳細程度。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Controla o nível de detalhamento dos logs do app para macOS."}},"de":{"stringUnit":{"state":"translated","value":"Legt den Detailgrad der Protokollierung der macOS-App fest."}},"es":{"stringUnit":{"state":"translated","value":"Controla el nivel de detalle de los registros de la aplicación de macOS."}},"ja-JP":{"stringUnit":{"state":"translated","value":"macOSアプリのログの詳細度を設定します。"}},"ko":{"stringUnit":{"state":"translated","value":"macOS 앱 로그의 상세 수준을 설정합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Définit le niveau de détail des journaux de l’application macOS."}},"hi":{"stringUnit":{"state":"translated","value":"macOS ऐप के लॉग में विवरण का स्तर नियंत्रित करता है."}},"ar":{"stringUnit":{"state":"translated","value":"يتحكم في مستوى تفصيل سجل تطبيق macOS."}},"it":{"stringUnit":{"state":"translated","value":"Regola il livello di dettaglio dei log dell'app macOS."}},"tr":{"stringUnit":{"state":"translated","value":"macOS uygulamasının günlük ayrıntı düzeyini denetler."}},"uk":{"stringUnit":{"state":"translated","value":"Визначає рівень деталізації журналу програми для macOS."}},"id":{"stringUnit":{"state":"translated","value":"Mengatur tingkat detail log aplikasi macOS."}},"pl":{"stringUnit":{"state":"translated","value":"Określa poziom szczegółowości dzienników aplikacji macOS."}},"th":{"stringUnit":{"state":"translated","value":"ควบคุมระดับความละเอียดของบันทึกแอป macOS."}},"vi":{"stringUnit":{"state":"translated","value":"Kiểm soát mức độ chi tiết của nhật ký ứng dụng macOS."}},"nl":{"stringUnit":{"state":"translated","value":"Bepaalt het detailniveau van de logboeken van de macOS-app."}},"fa":{"stringUni