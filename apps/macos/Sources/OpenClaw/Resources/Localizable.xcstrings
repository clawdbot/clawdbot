    "Choose Media File": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose Media File"}},"zh-CN":{"stringUnit":{"state":"translated","value":"选择媒体文件"}},"zh-TW":{"stringUnit":{"state":"translated","value":"選擇媒體檔案"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolher Arquivo de Mídia"}},"de":{"stringUnit":{"state":"translated","value":"Mediendatei auswählen"}},"es":{"stringUnit":{"state":"translated","value":"Elegir archivo multimedia"}},"ja-JP":{"stringUnit":{"state":"translated","value":"メディアファイルを選択"}},"ko":{"stringUnit":{"state":"translated","value":"미디어 파일 선택"}},"fr":{"stringUnit":{"state":"translated","value":"Choisir un fichier multimédia"}},"hi":{"stringUnit":{"state":"translated","value":"मीडिया फ़ाइल चुनें"}},"ar":{"stringUnit":{"state":"translated","value":"اختيار ملف وسائط"}},"it":{"stringUnit":{"state":"translated","value":"Scegli file multimediale"}},"tr":{"stringUnit":{"state":"translated","value":"Medya Dosyası Seç"}},"uk":{"stringUnit":{"state":"translated","value":"Вибрати медіафайл"}},"id":{"stringUnit":{"state":"translated","value":"Pilih File Media"}},"pl":{"stringUnit":{"state":"translated","value":"Wybierz plik multimedialny"}},"th":{"stringUnit":{"state":"translated","value":"เลือกไฟล์สื่อ"}},"vi":{"stringUnit":{"state":"translated","value":"Chọn tệp đa phương tiện"}},"nl":{"stringUnit":{"state":"translated","value":"Mediabestand kiezen"}},"fa":{"stringUnit":{"state":"translated","value":"انتخاب فایل رسانه‌ای"}},"ru":{"stringUnit":{"state":"translated","value":"Выбрать медиафайл"}},"sv":{"stringUnit":{"state":"translated","value":"Välj mediefil"}}}},
    "Choose another app before pasting.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose another app before pasting."}},"zh-CN":{"stringUnit":{"state":"translated","value":"粘贴前请选择另一个应用。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"貼上前請先選擇另一個應用程式。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolha outro app antes de colar."}},"de":{"stringUnit":{"state":"translated","value":"Wählen Sie vor dem Einfügen eine andere App."}},"es":{"stringUnit":{"state":"translated","value":"Elige otra app antes de pegar."}},"ja-JP":{"stringUnit":{"state":"translated","value":"貼り付ける前に別のアプリを選択してください。"}},"ko":{"stringUnit":{"state":"translated","value":"붙여넣기 전에 다른 앱을 선택하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez une autre app avant de coller."}},"hi":{"stringUnit":{"state":"translated","value":"पेस्ट करने से पहले कोई दूसरा ऐप चुनें."}},"ar":{"stringUnit":{"state":"translated","value":"اختر تطبيقًا آخر قبل اللصق."}},"it":{"stringUnit":{"state":"translated","value":"Scegli un'altra app prima di incollare."}},"tr":{"stringUnit":{"state":"translated","value":"Yapıştırmadan önce başka bir uygulama seçin."}},"uk":{"stringUnit":{"state":"translated","value":"Перед вставленням виберіть інший застосунок."}},"id":{"stringUnit":{"state":"translated","value":"Pilih aplikasi lain sebelum menempelkan."}},"pl":{"stringUnit":{"state":"translated","value":"Przed wklejeniem wybierz inną aplikację."}},"th":{"stringUnit":{"state":"translated","value":"เลือกแอปอื่นก่อนวาง."}},"vi":{"stringUnit":{"state":"translated","value":"Chọn ứng dụng khác trước khi dán."}},"nl":{"stringUnit":{"state":"translated","value":"Kies een andere app voordat je plakt."}},"fa":{"stringUnit":{"state":"translated","value":"پیش از جای‌گذاری، برنامهٔ دیگری انتخاب کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Выберите другое приложение перед вставкой."}},"sv":{"stringUnit":{"state":"translated","value":"Välj en annan app innan du klistrar in."}}}},
    "Choose file…": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose file…"}},"zh-CN":{"stringUnit":{"state":"translated","value":"选择文件…"}},"zh-TW":{"stringUnit":{"state":"translated","value":"選擇檔案…"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolher arquivo…"}},"de":{"stringUnit":{"state":"translated","value":"Datei auswählen…"}},"es":{"stringUnit":{"state":"translated","value":"Elegir archivo…"}},"ja-JP":{"stringUnit":{"state":"translated","value":"ファイルを選択…"}},"ko":{"stringUnit":{"state":"translated","value":"파일 선택…"}},"fr":{"stringUnit":{"state":"translated","value":"Choisir un fichier…"}},"hi":{"stringUnit":{"state":"translated","value":"फ़ाइल चुनें…"}},"ar":{"stringUnit":{"state":"translated","value":"اختيار ملف…"}},"it":{"stringUnit":{"state":"translated","value":"Scegli file…"}},"tr":{"stringUnit":{"state":"translated","value":"Dosya seç…"}},"uk":{"stringUnit":{"state":"translated","value":"Вибрати файл…"}},"id":{"stringUnit":{"state":"translated","value":"Pilih file…"}},"pl":{"stringUnit":{"state":"translated","value":"Wybierz plik…"}},"th":{"stringUnit":{"state":"translated","value":"เลือกไฟล์…"}},"vi":{"stringUnit":{"state":"translated","value":"Chọn tệp…"}},"nl":{"stringUnit":{"state":"translated","value":"Bestand kiezen…"}},"fa":{"stringUnit":{"state":"translated","value":"انتخاب فایل…"}},"ru":{"stringUnit":{"state":"translated","value":"Выбрать файл…"}},"sv":{"stringUnit":{"state":"translated","value":"Välj fil…"}}}},
    "Choose local or remote before the app can attach to a Gateway.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose local or remote before the app can attach to a Gateway."}},"zh-CN":{"stringUnit":{"state":"translated","value":"请选择本地或远程模式, 应用才能连接到 Gateway."}},"zh-TW":{"stringUnit":{"state":"translated","value":"請先選擇本機或遠端，應用程式才能連接至 Gateway."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolha local ou remoto para que o app possa se conectar a um Gateway."}},"de":{"stringUnit":{"state":"translated","value":"Wählen Sie lokal oder entfernt, bevor sich die App mit einem Gateway verbinden kann."}},"es":{"stringUnit":{"state":"translated","value":"Elige el modo local o remoto para que la app pueda conectarse a un Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"アプリをGatewayに接続するには、ローカルまたはリモートを選択してください。"}},"ko":{"stringUnit":{"state":"translated","value":"앱을 Gateway에 연결하려면 먼저 로컬 또는 원격을 선택하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez le mode local ou distant pour que l’app puisse se connecter à un Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"ऐप को Gateway से जोड़ने से पहले लोकल या रिमोट चुनें."}},"ar":{"stringUnit":{"state":"translated","value":"اختر الوضع المحلي أو البعيد قبل أن يتمكن التطبيق من الاتصال بـ Gateway."}},"it":{"stringUnit":{"state":"translated","value":"Scegli la modalità locale o remota prima che l'app possa connettersi a un Gateway."}},"tr":{"stringUnit":{"state":"translated","value":"Uygulamanın bir Gateway'e bağlanabilmesi için önce yerel veya uzak seçeneğini belirleyin."}},"uk":{"stringUnit":{"state":"translated","value":"Виберіть локальний або віддалений режим, перш ніж застосунок зможе підключитися до Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Pilih lokal atau jarak jauh sebelum aplikasi dapat terhubung ke Gateway."}},"pl":{"stringUnit":{"state":"translated","value":"Wybierz tryb lokalny lub zdalny, aby aplikacja mogła połączyć się z Gateway."}},"th":{"stringUnit":{"state":"translated","value":"เลือกแบบในเครื่องหรือระยะไกลก่อนที่แอปจะเชื่อมต่อกับ Gateway ได้."}},"vi":{"stringUnit":{"state":"translated","value":"Chọn cục bộ hoặc từ xa trước khi ứng dụng có thể kết nối với Gateway."}},"nl":{"stringUnit":{"state":"translated","value":"Kies lokaal of extern voordat de app verbinding kan maken met een Gateway."}},"fa":{"stringUnit":{"state":"translated","value":"پیش از اینکه برنامه بتواند به Gateway متصل شود، حالت محلی یا راه دور را انتخاب کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Выберите локальный или удалённый режим, чтобы приложение могло подключиться к Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Välj lokalt eller fjärranslutet läge innan appen kan ansluta till en Gateway."}}}},
    "Choose model and reasoning": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose model and reasoning"}},"zh-CN":{"stringUnit":{"state":"translated","value":"选择模型和推理设置"}},"zh-TW":{"stringUnit":{"state":"translated","value":"選擇模型與推理設定"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolher modelo e raciocínio"}},"de":{"stringUnit":{"state":"translated","value":"Modell und Denktiefe auswählen"}},"es":{"stringUnit":{"state":"translated","value":"Elegir modelo y razonamiento"}},"ja-JP":{"stringUnit":{"state":"translated","value":"モデルと推論を選択"}},"ko":{"stringUnit":{"state":"translated","value":"모델 및 추론 선택"}},"fr":{"stringUnit":{"state":"translated","value":"Choisir le modèle et le raisonnement"}},"hi":{"stringUnit":{"state":"translated","value":"मॉडल और तर्क-विचार चुनें"}},"ar":{"stringUnit":{"state":"translated","value":"اختيار النموذج والاستدلال"}},"it":{"stringUnit":{"state":"translated","value":"Scegli modello e ragionamento"}},"tr":{"stringUnit":{"state":"translated","value":"Model ve akıl yürütme seçin"}},"uk":{"stringUnit":{"state":"translated","value":"Вибрати модель і міркування"}},"id":{"stringUnit":{"state":"translated","value":"Pilih model dan penalaran"}},"pl":{"stringUnit":{"state":"translated","value":"Wybierz model i poziom rozumowania"}},"th":{"stringUnit":{"state":"translated","value":"เลือกโมเดลและการใช้เหตุผล"}},"vi":{"stringUnit":{"state":"translated","value":"Chọn mô hình và chế độ suy luận"}},"nl":{"stringUnit":{"state":"translated","value":"Model en redeneermodus kiezen"}},"fa":{"stringUnit":{"state":"translated","value":"انتخاب مدل و استدلال"}},"ru":{"stringUnit":{"state":"translated","value":"Выбрать модель и режим рассуждения"}},"sv":{"stringUnit":{"state":"translated","value":"Välj modell och resonemang"}}}},
    "Choose the node-local automation backend for snapshots and actions.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose the node-local automation backend for snapshots and actions."}},"zh-CN":{"stringUnit":{"state":"translated","value":"选择用于快照和操作的节点本地自动化后端。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"選擇用於快照與動作的節點本機自動化後端。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolha o backend de automação local do nó para capturas e ações."}},"de":{"stringUnit":{"state":"translated","value":"Wählen Sie das knotenlokale Automatisierungs-Backend für Momentaufnahmen und Aktionen."}},"es":{"stringUnit":{"state":"translated","value":"Elige el backend de automatización local del nodo para las capturas y las acciones."}},"ja-JP":{"stringUnit":{"state":"translated","value":"スナップショットとアクションに使用するノードローカルの自動化バックエンドを選択してください。"}},"ko":{"stringUnit":{"state":"translated","value":"스냅샷과 작업에 사용할 노드 로컬 자동화 백엔드를 선택하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez le moteur d’automatisation local au nœud pour les instantanés et les actions."}},"hi":{"stringUnit":{"state":"translated","value":"स्नैपशॉट और कार्रवाइयों के लिए नोड-लोकल ऑटोमेशन बैकएंड चुनें."}},"ar":{"stringUnit":{"state":"translated","value":"اختر الواجهة الخلفية للأتمتة المحلية على العقدة للقطات والإجراءات."}},"it":{"stringUnit":{"state":"translated","value":"Scegli il backend di automazione locale del nodo per istantanee e azioni."}},"tr":{"stringUnit":{"state":"translated","value":"Anlık görüntüler ve eylemler için düğümde yerel olarak çalışan otomasyon arka ucunu seçin."}},"uk":{"stringUnit":{"state":"translated","value":"Виберіть локальний для вузла бекенд автоматизації для знімків і дій."}},"id":{"stringUnit":{"state":"translated","value":"Pilih backend otomatisasi lokal node untuk snapshot dan tindakan."}},"pl":{"stringUnit":{"state":"translated","value":"Wybierz lokalny dla węzła backend automatyzacji do migawek i działań."}},"th":{"stringUnit":{"state":"translated","value":"เลือกระบบเบื้องหลังสำหรับงานอัตโนมัติที่ทำงานภายในโหนดเพื่อใช้กับสแนปช็อตและการดำเนินการ."}},"vi":{"stringUnit":{"state":"translated","value":"Chọn hệ thống tự động hóa cục bộ trên nút để chụp ảnh trạng thái và thực hiện thao tác."}},"nl":{"stringUnit":{"state":"translated","value":"Kies de automatiseringsbackend die lokaal op het knooppunt draait voor momentopnamen en acties."}},"fa":{"stringUnit":{"state":"translated","value":"بک‌اند اتوماسیون محلی گره را برای نماهای لحظه‌ای و اقدامات انتخاب کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Выберите локальный для узла механизм автоматизации для снимков и действий."}},"sv":{"stringUnit":{"state":"translated","value":"Välj nodens lokala automationsbackend för ögonblicksbilder och åtgärder."}}}},
    "Choose the realtime provider, model, voice, and transport in the Control UI.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose the realtime provider, model, voice, and transport in the Control UI."}},"zh-CN":{"stringUnit":{"state":"translated","value":"在 Control UI 中选择实时服务提供商、模型、语音和传输方式。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"在 Control UI 中選擇即時服務供應商、模型、語音與傳輸方式。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolha o provedor em tempo real, o modelo, a voz e o transporte na Control UI."}},"de":{"stringUnit":{"state":"translated","value":"Wählen Sie Echtzeitanbieter, Modell, Stimme und Transport in der Control UI."}},"es":{"stringUnit":{"state":"translated","value":"Elige el proveedor en tiempo real, el modelo, la voz y el transporte en la Control UI."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Control UIでリアルタイムプロバイダー、モデル、音声、トランスポートを選択してください。"}},"ko":{"stringUnit":{"state":"translated","value":"Control UI에서 실시간 제공업체, 모델, 음성 및 전송 방식을 선택하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez le fournisseur en temps réel, le modèle, la voix et le transport dans la Control UI."}},"hi":{"stringUnit":{"state":"translated","value":"Control UI में रीयलटाइम प्रदाता, मॉडल, आवाज़ और ट्रांसपोर्ट चुनें."}},"ar":{"stringUnit":{"state":"translated","value":"اختر مزوّد الخدمة في الوقت الفعلي والنموذج والصوت ووسيلة النقل في Control UI."}},"it":{"stringUnit":{"state":"translated","value":"Scegli il provider in tempo reale, il modello, la voce e il trasporto nella Control UI."}},"tr":{"stringUnit":{"state":"translated","value":"Control UI üzerinden gerçek zamanlı sağlayıcıyı, modeli, sesi ve aktarım yöntemini seçin."}},"uk":{"stringUnit":{"state":"translated","value":"Виберіть постачальника послуг реального часу, модель, голос і транспорт у Control UI."}},"id":{"stringUnit":{"state":"translated","value":"Pilih penyedia realtime, model, suara, dan transport di Control UI."}},"pl":{"stringUnit":{"state":"translated","value":"Wybierz dostawcę usług czasu rzeczywistego, model, głos i transport w Control UI."}},"th":{"stringUnit":{"state":"translated","value":"เลือกผู้ให้บริการแบบเรียลไทม์ โมเดล เสียง และวิธีรับส่งข้อมูลใน Control UI."}},"vi":{"stringUnit":{"state":"translated","value":"Chọn nhà cung cấp thời gian thực, mô hình, giọng nói và phương thức truyền tải trong Control UI."}},"nl":{"stringUnit":{"state":"translated","value":"Kies de realtimeprovider, het model, de stem en het transport in de Control UI."}},"fa":{"stringUnit":{"state":"translated","value":"ارائه‌دهندهٔ بلادرنگ، مدل، صدا و روش انتقال را در Control UI انتخاب کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Выберите поставщика услуг реального времени, модель, голос и транспорт в Control UI."}},"sv":{"stringUnit":{"state":"translated","value":"Välj realtidsleverantör, modell, röst och transport i Control UI."}}}},
    "Choose where the Gateway runs and how this Mac app reaches it.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose where the Gateway runs and how this Mac app reaches it."}},"zh-CN":{"stringUnit":{"state":"translated","value":"选择 Gateway 的运行位置以及此 Mac 应用连接它的方式。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"選擇 Gateway 的執行位置，以及此 Mac 應用程式連線至 Gateway 的方式。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolha onde o Gateway é executado e como este app para Mac se conecta a ele."}},"de":{"stringUnit":{"state":"translated","value":"Wählen Sie, wo das Gateway ausgeführt wird und wie diese Mac-App es erreicht."}},"es":{"stringUnit":{"state":"translated","value":"Elige dónde se ejecuta el Gateway y cómo se conecta a él esta app para Mac."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayの実行場所と、このMacアプリからの接続方法を選択してください。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway 실행 위치와 이 Mac 앱의 연결 방식을 선택하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez où s’exécute le Gateway et comment cette app Mac s’y connecte."}},"hi":{"stringUnit":{"state":"translated","value":"चुनें कि Gateway कहाँ चलता है और यह Mac ऐप उससे कैसे जुड़ता है."}},"ar":{"stringUnit":{"state":"translated","value":"اختر مكان تشغيل Gateway وكيفية وصول تطبيق Mac هذا إليه."}},"it":{"stringUnit":{"state":"translated","value":"Scegli dove viene eseguito il Gateway e come questa app per Mac vi si connette."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway'in nerede çalışacağını ve bu Mac uygulamasının ona nasıl erişeceğini seçin."}},"uk":{"stringUnit":{"state":"translated","value":"Виберіть, де працює Gateway і як цей застосунок для Mac підключається до нього."}},"id":{"stringUnit":{"state":"translated","value":"Pilih tempat Gateway berjalan dan cara aplikasi Mac ini mengaksesnya."}},"pl":{"stringUnit":{"state":"translated","value":"Wybierz, gdzie działa Gateway i jak ta aplikacja na Maca się z nim łączy."}},"th":{"stringUnit":{"state":"translated","value":"เลือกตำแหน่งที่ Gateway ทำงานและวิธีที่แอป Mac นี้ใช้เข้าถึง."}},"vi":{"stringUnit":{"state":"translated","value":"Chọn nơi chạy Gateway và cách ứng dụng Mac này kết nối tới đó."}},"nl":{"stringUnit":{"state":"translated","value":"Kies waar de Gateway draait en hoe deze Mac-app er verbinding mee maakt."}},"fa":{"stringUnit":{"state":"translated","value":"محل اجرای Gateway و نحوهٔ اتصال این برنامهٔ Mac به آن را انتخاب کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Выберите, где работает Gateway и как это приложение для Mac подключается к нему."}},"sv":{"stringUnit":{"state":"translated","value":"Välj var Gateway körs och hur denna Mac-app når den."}}}},
