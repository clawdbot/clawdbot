    "Wake phrases, push-to-talk, microphone input, and Talk Mode feedback.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Wake phrases, push-to-talk, microphone input, and Talk Mode feedback."}},"zh-CN":{"stringUnit":{"state":"translated","value":"唤醒短语、按住说话、麦克风输入和对话模式反馈。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"喚醒短語、按住說話、麥克風輸入，以及對話模式回饋。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Frases de ativação, pressionar para falar, entrada do microfone e feedback do Modo de Conversa."}},"de":{"stringUnit":{"state":"translated","value":"Aktivierungsphrasen, Drücken zum Sprechen, Mikrofoneingabe und Rückmeldungen im Sprachmodus."}},"es":{"stringUnit":{"state":"translated","value":"Frases de activación, pulsar para hablar, entrada de micrófono e indicaciones del modo de conversación."}},"ja-JP":{"stringUnit":{"state":"translated","value":"起動フレーズ、プッシュツートーク、マイク入力、トークモードのフィードバック。"}},"ko":{"stringUnit":{"state":"translated","value":"호출 문구, 눌러서 말하기, 마이크 입력 및 대화 모드 피드백."}},"fr":{"stringUnit":{"state":"translated","value":"Phrases d’activation, appuyer pour parler, entrée microphone et retours du mode vocal."}},"hi":{"stringUnit":{"state":"translated","value":"जगाने वाले वाक्यांश, दबाकर बोलना, माइक्रोफ़ोन इनपुट, और बातचीत मोड की प्रतिक्रिया."}},"ar":{"stringUnit":{"state":"translated","value":"عبارات التنشيط، والضغط للتحدث، وإدخال الميكروفون، وملاحظات وضع التحدث."}},"it":{"stringUnit":{"state":"translated","value":"Frasi di attivazione, premi per parlare, ingresso microfono e feedback della modalità conversazione."}},"tr":{"stringUnit":{"state":"translated","value":"Uyandırma ifadeleri, bas-konuş, mikrofon girişi ve Konuşma Modu geri bildirimi."}},"uk":{"stringUnit":{"state":"translated","value":"Фрази активації, розмова натисканням кнопки, введення з мікрофона та зворотний зв’язок у режимі розмови."}},"id":{"stringUnit":{"state":"translated","value":"Frasa pemicu, tekan untuk bicara, input mikrofon, dan umpan balik Mode Bicara."}},"pl":{"stringUnit":{"state":"translated","value":"Frazy wybudzające, funkcja „naciśnij i mów”, wejście mikrofonowe i sygnalizacja w trybie rozmowy."}},"th":{"stringUnit":{"state":"translated","value":"วลีปลุก, การกดเพื่อพูด, อินพุตจากไมโครโฟน, และการตอบสนองในโหมดสนทนา."}},"vi":{"stringUnit":{"state":"translated","value":"Các cụm từ đánh thức, nhấn để nói, đầu vào micrô và phản hồi của Chế độ trò chuyện."}},"nl":{"stringUnit":{"state":"translated","value":"Activeringszinnen, push-to-talk, microfooninvoer en feedback van de gespreksmodus."}},"fa":{"stringUnit":{"state":"translated","value":"عبارت‌های بیدارسازی، فشردن برای صحبت، ورودی میکروفون، و بازخورد حالت مکالمه."}},"ru":{"stringUnit":{"state":"translated","value":"Фразы активации, разговор по нажатию кнопки, ввод с микрофона и обратная связь в режиме разговора."}},"sv":{"stringUnit":{"state":"translated","value":"Aktiveringsfraser, tryck för att prata, mikrofoninmatning och återkoppling i samtalsläge."}}}},
    "Wake up, my friend!": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Wake up, my friend!"}},"zh-CN":{"stringUnit":{"state":"translated","value":"醒醒，我的朋友！"}},"zh-TW":{"stringUnit":{"state":"translated","value":"醒醒吧，我的朋友！"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Acorde, meu amigo!"}},"de":{"stringUnit":{"state":"translated","value":"Wach auf, mein Freund!"}},"es":{"stringUnit":{"state":"translated","value":"¡Despierta, amigo mío!"}},"ja-JP":{"stringUnit":{"state":"translated","value":"起きて、友よ！"}},"ko":{"stringUnit":{"state":"translated","value":"일어나, 친구야!"}},"fr":{"stringUnit":{"state":"translated","value":"Réveille-toi, mon ami!"}},"hi":{"stringUnit":{"state":"translated","value":"जागो, मेरे दोस्त!"}},"ar":{"stringUnit":{"state":"translated","value":"استيقظ، يا صديقي!"}},"it":{"stringUnit":{"state":"translated","value":"Svegliati, amico mio!"}},"tr":{"stringUnit":{"state":"translated","value":"Uyan, dostum!"}},"uk":{"stringUnit":{"state":"translated","value":"Прокидайся, мій друже!"}},"id":{"stringUnit":{"state":"translated","value":"Bangun, temanku!"}},"pl":{"stringUnit":{"state":"translated","value":"Obudź się, przyjacielu!"}},"th":{"stringUnit":{"state":"translated","value":"ตื่นได้แล้ว เพื่อน!"}},"vi":{"stringUnit":{"state":"translated","value":"Dậy nào, bạn ơi!"}},"nl":{"stringUnit":{"state":"translated","value":"Word wakker, mijn vriend!"}},"fa":{"stringUnit":{"state":"translated","value":"بیدار شو، دوست من!"}},"ru":{"stringUnit":{"state":"translated","value":"Просыпайся, мой друг!"}},"sv":{"stringUnit":{"state":"translated","value":"Vakna, min vän!"}}}},
    "Warning": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Warning"}},"zh-CN":{"stringUnit":{"state":"translated","value":"警告"}},"zh-TW":{"stringUnit":{"state":"translated","value":"警告"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Aviso"}},"de":{"stringUnit":{"state":"translated","value":"Warnung"}},"es":{"stringUnit":{"state":"translated","value":"Advertencia"}},"ja-JP":{"stringUnit":{"state":"translated","value":"警告"}},"ko":{"stringUnit":{"state":"translated","value":"경고"}},"fr":{"stringUnit":{"state":"translated","value":"Avertissement"}},"hi":{"stringUnit":{"state":"translated","value":"चेतावनी"}},"ar":{"stringUnit":{"state":"translated","value":"تحذير"}},"it":{"stringUnit":{"state":"translated","value":"Avviso"}},"tr":{"stringUnit":{"state":"translated","value":"Uyarı"}},"uk":{"stringUnit":{"state":"translated","value":"Попередження"}},"id":{"stringUnit":{"state":"translated","value":"Peringatan"}},"pl":{"stringUnit":{"state":"translated","value":"Ostrzeżenie"}},"th":{"stringUnit":{"state":"translated","value":"คำเตือน"}},"vi":{"stringUnit":{"state":"translated","value":"Cảnh báo"}},"nl":{"stringUnit":{"state":"translated","value":"Waarschuwing"}},"fa":{"stringUnit":{"state":"translated","value":"هشدار"}},"ru":{"stringUnit":{"state":"translated","value":"Предупреждение"}},"sv":{"stringUnit":{"state":"translated","value":"Varning"}}}},
    "Warning: %@ percent of context used": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Warning: %@ percent of context used"}},"zh-CN":{"stringUnit":{"state":"translated","value":"警告：已使用 %@% 的上下文"}},"zh-TW":{"stringUnit":{"state":"translated","value":"警告: 已使用百分之 %@ 的上下文"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Aviso: %@ por cento do contexto utilizado"}},"de":{"stringUnit":{"state":"translated","value":"Warnung: %@ Prozent des Kontexts verwendet"}},"es":{"stringUnit":{"state":"translated","value":"Advertencia: se ha usado el %@ por ciento del contexto"}},"ja-JP":{"stringUnit":{"state":"translated","value":"警告: コンテキストの%@パーセントを使用中"}},"ko":{"stringUnit":{"state":"translated","value":"경고: 컨텍스트의 %@ 퍼센트 사용됨"}},"fr":{"stringUnit":{"state":"translated","value":"Avertissement: %@ pour cent du contexte utilisé"}},"hi":{"stringUnit":{"state":"translated","value":"चेतावनी: संदर्भ का %@ प्रतिशत उपयोग हो चुका है"}},"ar":{"stringUnit":{"state":"translated","value":"تحذير: تم استخدام %@ بالمئة من السياق"}},"it":{"stringUnit":{"state":"translated","value":"Avviso: utilizzato il %@ percento del contesto"}},"tr":{"stringUnit":{"state":"translated","value":"Uyarı: Bağlamın yüzde %@ kadarı kullanıldı"}},"uk":{"stringUnit":{"state":"translated","value":"Попередження: використано %@ відсотків контексту"}},"id":{"stringUnit":{"state":"translated","value":"Peringatan: %@ persen konteks terpakai"}},"pl":{"stringUnit":{"state":"translated","value":"Ostrzeżenie: wykorzystano %@ procent kontekstu"}},"th":{"stringUnit":{"state":"translated","value":"คำเตือน: ใช้บริบทไปแล้ว %@ เปอร์เซ็นต์"}},"vi":{"stringUnit":{"state":"translated","value":"Cảnh báo: Đã sử dụng %@ phần trăm ngữ cảnh"}},"nl":{"stringUnit":{"state":"translated","value":"Waarschuwing: %@ procent van de context gebruikt"}},"fa":{"stringUnit":{"state":"translated","value":"هشدار: %@ درصد از ظرفیت زمینه استفاده شده است"}},"ru":{"stringUnit":{"state":"translated","value":"Предупреждение: использовано %@ процентов контекста"}},"sv":{"stringUnit":{"state":"translated","value":"Varning: %@ procent av kontexten har använts"}}}},
    "Watch messages need recovery. Contact support; Reset Onboarding erases all local data.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Watch messages need recovery. Contact support; Reset Onboarding erases all local data."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Apple Watch 消息需要恢复。请联系支持人员；重置初始设置将清除所有本地数据。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"手錶訊息需要復原。 請聯絡支援人員; 重設初始設定會清除所有本機資料。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"As mensagens do Apple Watch precisam ser recuperadas. Entre em contato com o suporte; Redefinir Configuração Inicial apaga todos os dados locais."}},"de":{"stringUnit":{"state":"translated","value":"Watch-Nachrichten müssen wiederhergestellt werden. Wenden Sie sich an den Support; das Zurücksetzen der Ersteinrichtung löscht alle lokalen Daten."}},"es":{"stringUnit":{"state":"translated","value":"Es necesario recuperar los mensajes del Apple Watch. Contacta con soporte; Restablecer configuración inicial borra todos los datos locales."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Apple Watchのメッセージを復旧する必要があります。 サポートにお問い合わせください; オンボーディングをリセットすると、すべてのローカルデータが消去されます。"}},"ko":{"stringUnit":{"state":"translated","value":"Watch 메시지를 복구해야 합니다. 지원팀에 문의하세요; 온보딩 초기화는 모든 로컬 데이터를 삭제합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les messages de la montre doivent être récupérés. Contactez l’assistance; Réinitialiser la configuration initiale efface toutes les données locales."}},"hi":{"stringUnit":{"state":"translated","value":"Apple Watch के संदेशों को पुनर्प्राप्त करना ज़रूरी है. सहायता से संपर्क करें; ऑनबोर्डिंग रीसेट करने से सभी स्थानीय डेटा मिट जाता है."}},"ar":{"stringUnit":{"state":"translated","value":"تحتاج رسائل الساعة إلى الاسترداد. تواصل مع الدعم؛ تؤدي إعادة تعيين الإعداد الأولي إلى مسح جميع البيانات المحلية."}},"it":{"stringUnit":{"state":"translated","value":"I messaggi di Apple Watch devono essere recuperati. Contatta l'assistenza; Reimposta configurazione iniziale cancella tutti i dati locali."}},"tr":{"stringUnit":{"state":"translated","value":"Saat mesajlarının kurtarılması gerekiyor. Destek ekibiyle iletişime geçin; İlk Kurulumu Sıfırla tüm yerel verileri siler."}},"uk":{"stringUnit":{"state":"translated","value":"Повідомлення на годиннику потребують відновлення. Зверніться до служби підтримки; скидання початкового налаштування видаляє всі локальні дані."}},"id":{"stringUnit":{"state":"translated","value":"Pesan Watch perlu dipulihkan. Hubungi dukungan; Atur Ulang Penyiapan Awal menghapus semua data lokal."}},"pl":{"stringUnit":{"state":"translated","value":"Wiadomości na zegarku wymagają odzyskania. Skontaktuj się z pomocą techniczną; zresetowanie konfiguracji początkowej usuwa wszystkie dane lokalne."}},"th":{"stringUnit":{"state":"translated","value":"จำเป็นต้องกู้คืนข้อความบน Apple Watch. ติดต่อฝ่ายสนับสนุน; การรีเซ็ตการตั้งค่าเริ่มต้นจะลบข้อมูลทั้งหมดในเครื่อง."}},"vi":{"stringUnit":{"state":"translated","value":"Tin nhắn trên đồng hồ cần được khôi phục. Liên hệ bộ phận hỗ trợ; Đặt lại thiết lập ban đầu sẽ xóa toàn bộ dữ liệu cục bộ."}},"nl":{"stringUnit":{"state":"translated","value":"Watch-berichten moeten worden hersteld. Neem contact op met de ondersteuning; met Introductie resetten worden alle lokale gegevens gewist."}},"fa":{"stringUnit":{"state":"translated","value":"پیام‌های ساعت نیاز به بازیابی دارند. با پشتیبانی تماس بگیرید؛ بازنشانی راه‌اندازی اولیه، تمام داده‌های محلی را پاک می‌کند."}},"ru":{"stringUnit":{"state":"translated","value":"Сообщения на часах требуют восстановления. Обратитесь в службу поддержки; сброс первоначальной настройки удаляет все локальные данные."}},"sv":{"stringUnit":{"state":"translated","value":"Meddelanden på klockan behöver återställas. Kontakta supporten; Återställ introduktionen raderar alla lokala data."}}}},
    "Web Search": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Web Search"}},"zh-CN":{"stringUnit":{"state":"translated","value":"网页搜索"}},"zh-TW":{"stringUnit":{"state":"translated","value":"網頁搜尋"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Pesquisa na Web"}},"de":{"stringUnit":{"state":"translated","value":"Websuche"}},"es":{"stringUnit":{"state":"translated","value":"Búsqueda web"}},"ja-JP":{"stringUnit":{"state":"translated","value":"Web検索"}},"ko":{"stringUnit":{"state":"translated","value":"웹 검색"}},"fr":{"stringUnit":{"state":"translated","value":"Recherche Web"}},"hi":{"stringUnit":{"state":"translated","value":"वेब खोज"}},"ar":{"stringUnit":{"state":"translated","value":"البحث على الويب"}},"it":{"stringUnit":{"state":"translated","value":"Ricerca web"}},"tr":{"stringUnit":{"state":"translated","value":"Web Araması"}},"uk":{"stringUnit":{"state":"translated","value":"Пошук в інтернеті"}},"id":{"stringUnit":{"state":"translated","value":"Pencarian Web"}},"pl":{"stringUnit":{"state":"translated","value":"Wyszukiwanie w internecie"}},"th":{"stringUnit":{"state":"translated","value":"ค้นหาเว็บ"}},"vi":{"stringUnit":{"state":"translated","value":"Tìm kiếm trên web"}},"nl":{"stringUnit":{"state":"translated","value":"Zoeken op het web"}},"fa":{"stringUnit":{"state":"translated","value":"جستجوی وب"}},"ru":{"stringUnit":{"state":"translated","value":"Поиск в интернете"}},"sv":{"stringUnit":{"state":"translated","value":"Webbsökning"}}}},
    "Web Search is disabled in the Gateway configuration.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Web Search is disabled in the Gateway configuration."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Gateway 配置中已禁用网页搜索。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 設定中已停用網頁搜尋。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A Pesquisa na Web está desativada na configuração do Gateway."}},"de":{"stringUnit":{"state":"translated","value":"Die Websuche ist in der Gateway-Konfiguration deaktiviert."}},"es":{"stringUnit":{"state":"translated","value":"La búsqueda web está desactivada en la configuración del Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayの設定でWeb検索が無効になっています。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway 설정에서 웹 검색이 비활성화되어 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"La recherche Web est désactivée dans la configuration du Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway कॉन्फ़िगरेशन में वेब खोज बंद है."}},"ar":{"stringUnit":{"state":"translated","value":"البحث على الويب معطّل في إعدادات Gateway."}},"it":{"stringUnit":{"state":"translated","value":"La ricerca web è disabilitata nella configurazione del Gateway."}},"tr":{"stringUnit":{"state":"translated","value":"Web Araması, Gateway yapılandırmasında devre dışı."}},"uk":{"stringUnit":{"state":"translated","value":"Пошук в інтернеті вимкнено в конфігурації Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Pencarian Web dinonaktifkan dalam konfigurasi Gateway."}},"pl":{"stringUnit":{"state":"translated","value":"Wyszukiwanie w internecie jest wyłączone w konfiguracji Gateway."}},"th":{"stringUnit":{"state":"translated","value":"การค้นหาเว็บถูกปิดใช้งานในการกำหนดค่า Gateway."}},"vi":{"stringUnit":{"state":"translated","value":"Tìm kiếm trên web bị tắt trong cấu hình Gateway."}},"nl":{"stringUnit":{"state":"translated","value":"Zoeken op het web is uitgeschakeld in de Gateway-configuratie."}},"fa":{"stringUnit":{"state":"translated","value":"جستجوی وب در پیکربندی Gateway غیرفعال است."}},"ru":{"stringUnit":{"state":"translated","value":"Поиск в интернете отключён в конфигурации Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Webbsökning är inaktiverad i Gateway-konfigurationen."}}}},
    "Web Search is unavailable on this Gateway.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Web Search is unavailable on this Gateway."}},"zh-CN":{"stringUnit":{"state":"translated","value":"此 Gateway 不支持网页搜索。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此 Gateway 無法使用網頁搜尋。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A Pesquisa na Web não está disponível neste Gateway."}},"de":{"stringUnit":{"state":"translated","value":"Die Websuche ist auf diesem Gateway nicht verfügbar."}},"es":{"stringUnit":{"state":"translated","value":"La búsqueda web no está disponible en este Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このGatewayではWeb検索を利用できません。"}},"ko":{"stringUnit":{"state":"translated","value":"이 Gateway에서는 웹 검색을 사용할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"La recherche Web n’est pas disponible sur ce Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"इस Gateway पर वेब खोज उपलब्ध नहीं है."}},"ar":{"stringUnit":{"state":"translated","value":"البحث على الويب غير متاح على Gateway هذا."}},"it":{"stringUnit":{"state":"translated","value":"La ricerca web non è disponibile su questo Gateway."}},"tr":{"stringUnit":{"state":"translated","value":"Web Araması bu Gateway üzerinde kullanılamıyor."}},"uk":{"stringUnit":{"state":"translated","value":"Пошук в інтернеті недоступний на цьому Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Pencarian Web tidak tersedia di Gateway ini."}},"pl":{"stringUnit":{"state":"translated","value":"Wyszukiwanie w internecie jest niedostępne w tym Gateway."}},"th":{"stringUnit":{"state":"translated","value":"การค้นหาเว็บไม่พร้อมใช้งานบน Gateway นี้."}},"vi":{"stringUnit":{"state":"translated","value":"Tìm kiếm trên web không khả dụng trên Gateway này."}},"nl":{"stringUnit":{"state":"translated","value":"Zoeken op het web is niet beschikbaar op deze Gateway."}},"fa":{"stringUnit":{"state":"translated","value":"جستجوی وب در این Gateway در دسترس نیست."}},"ru":{"stringUnit":{"state":"translated","value":"Поиск в интернете недоступен на этом Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Webbsökning är inte tillgänglig på denna Gateway."}}}},
