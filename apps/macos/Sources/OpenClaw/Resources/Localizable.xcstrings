    "Command and script payloads are read-only in the macOS app": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Command and script payloads are read-only in the macOS app"}},"zh-CN":{"stringUnit":{"state":"translated","value":"命令和脚本载荷在 macOS 应用中为只读"}},"zh-TW":{"stringUnit":{"state":"translated","value":"指令與指令碼的酬載在 macOS 應用程式中為唯讀"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Os conteúdos de comandos e scripts são somente leitura no app para macOS"}},"de":{"stringUnit":{"state":"translated","value":"Befehls- und Skriptinhalte sind in der macOS-App schreibgeschützt"}},"es":{"stringUnit":{"state":"translated","value":"El contenido de los comandos y scripts es de solo lectura en la app de macOS"}},"ja-JP":{"stringUnit":{"state":"translated","value":"macOSアプリではコマンドとスクリプトのペイロードは読み取り専用です"}},"ko":{"stringUnit":{"state":"translated","value":"macOS 앱에서 명령어 및 스크립트 페이로드는 읽기 전용입니다"}},"fr":{"stringUnit":{"state":"translated","value":"Le contenu des commandes et des scripts est en lecture seule dans l’application macOS"}},"hi":{"stringUnit":{"state":"translated","value":"macOS ऐप में कमांड और स्क्रिप्ट पेलोड केवल पढ़े जा सकते हैं"}},"ar":{"stringUnit":{"state":"translated","value":"محتوى الأوامر والبرامج النصية للقراءة فقط في تطبيق macOS"}},"it":{"stringUnit":{"state":"translated","value":"I payload dei comandi e degli script sono di sola lettura nell’app macOS"}},"tr":{"stringUnit":{"state":"translated","value":"Komut ve betik içerikleri macOS uygulamasında salt okunurdur"}},"uk":{"stringUnit":{"state":"translated","value":"Вміст команд і скриптів у застосунку macOS доступний лише для читання"}},"id":{"stringUnit":{"state":"translated","value":"Payload perintah dan skrip hanya dapat dibaca di aplikasi macOS"}},"pl":{"stringUnit":{"state":"translated","value":"Treść poleceń i skryptów jest tylko do odczytu w aplikacji macOS"}},"th":{"stringUnit":{"state":"translated","value":"เพย์โหลดของคำสั่งและสคริปต์เป็นแบบอ่านอย่างเดียวในแอป macOS"}},"vi":{"stringUnit":{"state":"translated","value":"Nội dung lệnh và tập lệnh chỉ có thể đọc trong ứng dụng macOS"}},"nl":{"stringUnit":{"state":"translated","value":"De inhoud van opdrachten en scripts is alleen-lezen in de macOS-app"}},"fa":{"stringUnit":{"state":"translated","value":"محتوای فرمان‌ها و اسکریپت‌ها در برنامهٔ macOS فقط خواندنی است"}},"ru":{"stringUnit":{"state":"translated","value":"Содержимое команд и скриптов в приложении macOS доступно только для чтения"}},"sv":{"stringUnit":{"state":"translated","value":"Kommando- och skriptdata är skrivskyddade i macOS-appen"}}}},
    "Commands": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Commands"}},"zh-CN":{"stringUnit":{"state":"translated","value":"命令"}},"zh-TW":{"stringUnit":{"state":"translated","value":"指令"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Comandos"}},"de":{"stringUnit":{"state":"translated","value":"Befehle"}},"es":{"stringUnit":{"state":"translated","value":"Comandos"}},"ja-JP":{"stringUnit":{"state":"translated","value":"コマンド"}},"ko":{"stringUnit":{"state":"translated","value":"명령어"}},"fr":{"stringUnit":{"state":"translated","value":"Commandes"}},"hi":{"stringUnit":{"state":"translated","value":"कमांड"}},"ar":{"stringUnit":{"state":"translated","value":"الأوامر"}},"it":{"stringUnit":{"state":"translated","value":"Comandi"}},"tr":{"stringUnit":{"state":"translated","value":"Komutlar"}},"uk":{"stringUnit":{"state":"translated","value":"Команди"}},"id":{"stringUnit":{"state":"translated","value":"Perintah"}},"pl":{"stringUnit":{"state":"translated","value":"Polecenia"}},"th":{"stringUnit":{"state":"translated","value":"คำสั่ง"}},"vi":{"stringUnit":{"state":"translated","value":"Các lệnh"}},"nl":{"stringUnit":{"state":"translated","value":"Opdrachten"}},"fa":{"stringUnit":{"state":"translated","value":"فرمان‌ها"}},"ru":{"stringUnit":{"state":"translated","value":"Команды"}},"sv":{"stringUnit":{"state":"translated","value":"Kommandon"}}}},
    "Commands that miss the allowlist follow the prompt and fallback policy above.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Commands that miss the allowlist follow the prompt and fallback policy above."}},"zh-CN":{"stringUnit":{"state":"translated","value":"未匹配允许列表的命令遵循上述提示和回退策略。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"不在允許清單中的指令會遵循上述提示與備援政策。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Os comandos que não constam na lista de permissões seguem a política de solicitação de confirmação e de contingência acima."}},"de":{"stringUnit":{"state":"translated","value":"Für Befehle, die nicht auf der Zulassungsliste stehen, gelten die oben genannten Richtlinien für Rückfragen und Ausweichverhalten."}},"es":{"stringUnit":{"state":"translated","value":"Los comandos que no figuren en la lista de permitidos siguen la política de solicitud de confirmación y de respaldo indicada arriba."}},"ja-JP":{"stringUnit":{"state":"translated","value":"許可リストに一致しないコマンドには、上記のプロンプトとフォールバックのポリシーが適用されます。"}},"ko":{"stringUnit":{"state":"translated","value":"허용 목록에 없는 명령어에는 위의 확인 요청 및 대체 정책이 적용됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les commandes absentes de la liste d’autorisation suivent la politique de demande de confirmation et de repli ci-dessus."}},"hi":{"stringUnit":{"state":"translated","value":"अनुमति सूची में शामिल न होने वाले कमांड ऊपर दी गई प्रॉम्प्ट और फ़ॉलबैक नीति का पालन करते हैं."}},"ar":{"stringUnit":{"state":"translated","value":"تخضع الأوامر غير المدرجة في قائمة السماح لسياسة طلب التأكيد والإجراء البديل الموضحة أعلاه."}},"it":{"stringUnit":{"state":"translated","value":"I comandi non presenti nell’elenco consentiti seguono i criteri di richiesta di conferma e di ripiego indicati sopra."}},"tr":{"stringUnit":{"state":"translated","value":"İzin listesinde bulunmayan komutlar, yukarıdaki onay isteme ve yedek politikaya tabidir."}},"uk":{"stringUnit":{"state":"translated","value":"До команд, яких немає в списку дозволених, застосовуються наведені вище правила запиту підтвердження та резервної поведінки."}},"id":{"stringUnit":{"state":"translated","value":"Perintah yang tidak tercantum dalam daftar izin mengikuti kebijakan permintaan konfirmasi dan cadangan di atas."}},"pl":{"stringUnit":{"state":"translated","value":"Polecenia spoza listy dozwolonych podlegają powyższym zasadom pytania o zgodę i postępowania awaryjnego."}},"th":{"stringUnit":{"state":"translated","value":"คำสั่งที่ไม่อยู่ในรายการที่อนุญาตจะเป็นไปตามนโยบายการขออนุมัติและนโยบายสำรองข้างต้น"}},"vi":{"stringUnit":{"state":"translated","value":"Các lệnh không nằm trong danh sách cho phép sẽ tuân theo chính sách nhắc xác nhận và dự phòng ở trên."}},"nl":{"stringUnit":{"state":"translated","value":"Opdrachten die niet op de toestemmingslijst staan, volgen het bovenstaande beleid voor bevestigingsvragen en terugval."}},"fa":{"stringUnit":{"state":"translated","value":"فرمان‌هایی که در فهرست مجاز نیستند، از سیاست درخواست تأیید و سیاست جایگزینِ بالا پیروی می‌کنند."}},"ru":{"stringUnit":{"state":"translated","value":"К командам, не входящим в список разрешённых, применяется указанная выше политика запроса подтверждения и резервного поведения."}},"sv":{"stringUnit":{"state":"translated","value":"Kommandon som inte finns i tillåtelselistan följer policyn för bekräftelse och reservåtgärder ovan."}}}},
