    "Warning: %@ percent of context used": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Warning: %@ percent of context used"}},"zh-CN":{"stringUnit":{"state":"translated","value":"警告：已使用 %@% 的上下文"}},"zh-TW":{"stringUnit":{"state":"translated","value":"警告: 已使用百分之 %@ 的上下文"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Aviso: %@ por cento do contexto utilizado"}},"de":{"stringUnit":{"state":"translated","value":"Warnung: %@ Prozent des Kontexts verwendet"}},"es":{"stringUnit":{"state":"translated","value":"Advertencia: se ha usado el %@ por ciento del contexto"}},"ja-JP":{"stringUnit":{"state":"translated","value":"警告: コンテキストの%@パーセントを使用中"}},"ko":{"stringUnit":{"state":"translated","value":"경고: 컨텍스트의 %@ 퍼센트 사용됨"}},"fr":{"stringUnit":{"state":"translated","value":"Avertissement: %@ pour cent du contexte utilisé"}},"hi":{"stringUnit":{"state":"translated","value":"चेतावनी: संदर्भ का %@ प्रतिशत उपयोग हो चुका है"}},"ar":{"stringUnit":{"state":"translated","value":"تحذير: تم استخدام %@ بالمئة من السياق"}},"it":{"stringUnit":{"state":"translated","value":"Avviso: utilizzato il %@ percento del contesto"}},"tr":{"stringUnit":{"state":"translated","value":"Uyarı: Bağlamın yüzde %@ kadarı kullanıldı"}},"uk":{"stringUnit":{"state":"translated","value":"Попередження: використано %@ відсотків контексту"}},"id":{"stringUnit":{"state":"translated","value":"Peringatan: %@ persen konteks terpakai"}},"pl":{"stringUnit":{"state":"translated","value":"Ostrzeżenie: wykorzystano %@ procent kontekstu"}},"th":{"stringUnit":{"state":"translated","value":"คำเตือน: ใช้บริบทไปแล้ว %@ เปอร์เซ็นต์"}},"vi":{"stringUnit":{"state":"translated","value":"Cảnh báo: Đã sử dụng %@ phần trăm ngữ cảnh"}},"nl":{"stringUnit":{"state":"translated","value":"Waarschuwing: %@ procent van de context gebruikt"}},"fa":{"stringUnit":{"state":"translated","value":"هشدار: %@ درصد از ظرفیت زمینه استفاده شده است"}},"ru":{"stringUnit":{"state":"translated","value":"Предупреждение: использован