    "Launch at login": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Launch at login"}},"zh-CN":{"stringUnit":{"state":"translated","value":"登录时启动"}},"zh-TW":{"stringUnit":{"state":"translated","value":"登入時啟動"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Iniciar ao fazer login"}},"de":{"stringUnit":{"state":"translated","value":"Bei der Anmeldung starten"}},"es":{"stringUnit":{"state":"translated","value":"Abrir al iniciar sesión"}},"ja-JP":{"stringUnit":{"state":"translated","value":"ログイン時に起動"}},"ko":{"stringUnit":{"state":"translated","value":"로그인 시 실행"}},"fr":{"stringUnit":{"state":"translated","value":"Lancer à l’ouverture de session"}},"hi":{"stringUnit":{"state":"translated","value":"लॉगिन पर लॉन्च करें"}},"ar":{"stringUnit":{"state":"translated","value":"التشغيل عند تسجيل الدخول"}},"it":{"stringUnit":{"state":"translated","value":"Avvia all'accesso"}},"tr":{"stringUnit":{"state":"translated","value":"Oturum açıldığında başlat"}},"uk":{"stringUnit":{"state":"translated","value":"Запускати під час входу в систему"}},"id":{"stringUnit":{"state":"translated","value":"Jalankan saat masuk"}},"pl":{"stringUnit":{"state":"translated","value":"Uruchamiaj przy logowaniu"}},"th":{"stringUnit":{"state":"translated","value":"เปิดเมื่อเข้าสู่ระบบ"}},"vi":{"stringUnit":{"state":"translated","value":"Khởi chạy khi đăng nhập"}},"nl":{"stringUnit":{"state":"translated","value":"Starten bij inloggen"}},"fa":{"stringUnit":{"state":"translated","value":"اجرا هنگام ورود به سیستم"}},"ru":{"stringUnit":{"state":"translated","value":"Запускать при входе в систему"}},"sv":{"stringUnit":{"state":"translated","value":"Starta vid inloggning"}}}},
    "Launch at login is unavailable while an app profile is active.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Launch at login is unavailable while an app profile is active."}},"zh-CN":{"stringUnit":{"state":"translated","value":"应用配置文件处于启用状态时，无法使用登录时启动功能。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"應用程式設定檔啟用時, 無法使用登入時啟動功能。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A inicialização ao fazer login não está disponível enquanto um perfil do app estiver ativo."}},"de":{"stringUnit":{"state":"translated","value":"Der Start bei der Anmeldung ist nicht verfügbar, solange ein App-Profil aktiv ist."}},"es":{"stringUnit":{"state":"translated","value":"La opción de abrir al iniciar sesión no está disponible mientras haya un perfil de la aplicación activo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"アプリプロファイルが有効な間は、ログイン時の起動を利用できません。"}},"ko":{"stringUnit":{"state":"translated","value":"앱 프로필이 활성화된 동안에는 로그인 시 실행을 사용할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le lancement à l’ouverture de session est indisponible lorsqu’un profil d’application est actif."}},"hi":{"stringUnit":{"state":"translated","value":"ऐप प्रोफ़ाइल सक्रिय होने पर लॉगिन पर लॉन्च करना उपलब्ध नहीं है।"}},"ar":{"stringUnit":{"state":"translated","value":"التشغيل عند تسجيل الدخول غير متاح أثناء تفعيل ملف تعريف للتطبيق."}},"it":{"stringUnit":{"state":"translated","value":"L'avvio all'accesso non è disponibile mentre è attivo un profilo dell'app."}},"tr":{"stringUnit":{"state":"translated","value":"Bir uygulama profili etkinken oturum açıldığında başlatma kullanılamaz."}},"uk":{"stringUnit":{"state":"translated","value":"Запуск під час входу в систему недоступний, доки активний профіль програми."}},"id":{"stringUnit":{"state":"translated","value":"Opsi jalankan saat masuk tidak tersedia selama profil aplikasi aktif."}},"pl":{"stringUnit":{"state":"translated","value":"Uruchamianie przy logowaniu jest niedostępne, gdy profil aplikacji jest aktywny."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถเปิดเมื่อเข้าสู่ระบบได้ขณะที่โปรไฟล์แอปทำงานอยู่."}},"vi":{"stringUnit":{"state":"translated","value":"Không thể khởi chạy khi đăng nhập khi một hồ sơ ứng dụng đang hoạt động."}},"nl":{"stringUnit":{"state":"translated","value":"Starten bij inloggen is niet beschikbaar wanneer een app-profiel actief is."}},"fa":{"stringUnit":{"state":"translated","value":"تا زمانی که پروفایل برنامه فعال است، اجرا هنگام ورود به سیستم در دسترس نیست."}},"ru":{"stringUnit":{"state":"translated","value":"Запуск при входе в систему недоступен, пока активен профиль приложения."}},"sv":{"stringUnit":{"state":"translated","value":"Start vid inloggning är inte tillgängligt när en app-profil är aktiv."}}}},
    "Legacy pane — this now lives in the Dashboard": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Legacy pane — this now lives in the Dashboard"}},"zh-CN":{"stringUnit":{"state":"translated","value":"旧版面板 — 此功能现已移至仪表盘"}},"zh-TW":{"stringUnit":{"state":"translated","value":"舊版面板 — 此功能現已移至儀表板"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Painel legado — agora disponível no Painel de controle"}},"de":{"stringUnit":{"state":"translated","value":"Veralteter Bereich — jetzt im Dashboard zu finden"}},"es":{"stringUnit":{"state":"translated","value":"Panel antiguo — ahora se encuentra en el Panel de control"}},"ja-JP":{"stringUnit":{"state":"translated","value":"旧ペイン — この機能はダッシュボードに移動しました"}},"ko":{"stringUnit":{"state":"translated","value":"이전 패널 — 이제 대시보드로 이동했습니다"}},"fr":{"stringUnit":{"state":"translated","value":"Ancien volet — désormais disponible dans le tableau de bord"}},"hi":{"stringUnit":{"state":"translated","value":"पुराना पैनल — यह अब डैशबोर्ड में है"}},"ar":{"stringUnit":{"state":"translated","value":"لوحة قديمة — انتقل محتواها الآن إلى لوحة المعلومات"}},"it":{"stringUnit":{"state":"translated","value":"Pannello precedente — ora si trova nella Dashboard"}},"tr":{"stringUnit":{"state":"translated","value":"Eski panel — artık Gösterge Panelinde"}},"uk":{"stringUnit":{"state":"translated","value":"Застаріла панель — тепер це на панелі керування"}},"id":{"stringUnit":{"state":"translated","value":"Panel lama — kini tersedia di Dasbor"}},"pl":{"stringUnit":{"state":"translated","value":"Przestarzały panel — teraz znajduje się w Pulpicie"}},"th":{"stringUnit":{"state":"translated","value":"แผงแบบเดิม — ตอนนี้ย้ายไปอยู่ในแดชบอร์ดแล้ว"}},"vi":{"stringUnit":{"state":"translated","value":"Bảng cũ — nội dung này hiện nằm trong Bảng điều khiển"}},"nl":{"stringUnit":{"state":"translated","value":"Verouderd paneel — dit staat nu in het Dashboard"}},"fa":{"stringUnit":{"state":"translated","value":"بخش قدیمی — اکنون به داشبورد منتقل شده است"}}