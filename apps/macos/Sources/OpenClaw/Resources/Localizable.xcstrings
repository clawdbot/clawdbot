    "Reconnect to the Gateway to verify its dashboard sign-in address.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reconnect to the Gateway to verify its dashboard sign-in address."}},"zh-CN":{"stringUnit":{"state":"translated","value":"重新连接到 Gateway，以验证其仪表板登录地址。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"重新連線至 Gateway，以驗證其儀表板登入位址。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Reconecte-se ao Gateway para verificar o endereço de login do painel."}},"de":{"stringUnit":{"state":"translated","value":"Stellen Sie die Verbindung zum Gateway erneut her, um dessen Dashboard-Anmeldeadresse zu überprüfen."}},"es":{"stringUnit":{"state":"translated","value":"Vuelve a conectarte al Gateway para verificar la dirección de inicio de sesión de su panel de control."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gateway に再接続して、ダッシュボードのサインインアドレスを確認してください。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway에 다시 연결하여 대시보드 로그인 주소를 확인하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Reconnectez-vous au Gateway pour vérifier l’adresse de connexion à son tableau de bord."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway के डैशबोर्ड साइन-इन पते की पुष्टि करने के लिए उससे फिर से कनेक्ट करें।"}},"ar":{"stringUnit":{"state":"translated","value":"أعِد الاتصال بـ Gateway للتحقق من عنوان تسجيل الدخول إلى لوحة التحكم الخاصة به."}},"it":{"stringUnit":{"state":"translated","value":"Riconnettiti al Gateway per verificare l'indirizzo di accesso alla sua dashboard."}},"tr":{"stringUnit":{"state":"translated","value":"Kontrol panelinin oturum açma adresini doğrulamak için Gateway'e yeniden bağlanın."}},"uk":{"stringUnit":{"state":"translated","value":"Повторно підключіться до Gateway, щоб перевірити адресу входу до його панелі керування."}},"id":{"stringUnit":{"state":"translated","value":"Hubungkan kembali ke Gateway untuk memverifikasi alamat masuk dasbornya."}},"pl":{"stringUnit":{"state":"translated","value":"Połącz się ponownie z Gateway, aby zweryfikować adres logowania do jego panelu."}},"th":{"stringUnit":{"state":"translated","value":"เชื่อมต่อกับ Gateway อีกครั้งเพื่อยืนยันที่อยู่สำหรับลงชื่อเข้าใช้แดชบอร์ด"}},"vi":{"stringUnit":{"state":"translated","value":"Kết nối lại với Gateway để xác minh địa chỉ đăng nhập bảng điều khiển của Gateway."}},"nl":{"stringUnit":{"state":"translated","value":"Maak opnieuw verbinding met de Gateway om het aanmeldadres van het dashboard te verifiëren."}},"fa":{"stringUnit":{"state":"translated","value":"برای تأیید نشانی ورود به داشبورد Gateway، دوباره به آن متصل شوید."}},"ru":{"stringUnit":{"state":"translated","value":"Подключитесь к Gateway повторно, чтобы проверить адрес входа в его панель управления."}},"sv":{"stringUnit":{"state":"translated","value":"Återanslut till Gateway för att verifiera inloggningsadressen till dess instrumentpanel."}}}},
