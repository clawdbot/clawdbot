    "Sending a screenshot uses macOS Screen Recording access.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Sending a screenshot uses macOS Screen Recording access."}},"zh-CN":{"stringUnit":{"state":"translated","value":"发送屏幕截图需要使用 macOS 屏幕录制权限。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"傳送螢幕截圖會使用 macOS 螢幕錄製權限。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O envio de uma captura de tela usa a permissão de Gravação de Tela do macOS."}},"de":{"stringUnit":{"state":"translated","value":"Zum Senden eines Screenshots wird die macOS-Berechtigung zur Bildschirmaufnahme verwendet."}},"es":{"stringUnit":{"state":"translated","value":"Enviar una captura de pantalla utiliza el permiso de grabación de pantalla de macOS."}},"ja-JP":{"stringUnit":{"state":"translated","value":"スクリーンショットの送信にはmacOSの画面収録へのアクセス権を使用します。"}},"ko":{"stringUnit":{"state":"translated","value":"스크린샷을 보내려면 macOS 화면 기록 접근 권한이 필요합니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’envoi d’une capture d’écran utilise l’autorisation d’enregistrement de l’écran de macOS."}},"hi":{"stringUnit":{"state":"translated","value":"स्क्रीनशॉट भेजने के लिए macOS की स्क्रीन रिकॉर्डिंग अनुमति का उपयोग होता है."}},"ar":{"stringUnit":{"state":"translated","value":"يستخدم إرسال لقطة شاشة إذن تسجيل الشاشة في macOS."}},"it":{"stringUnit":{"state":"translated","value":"L'invio di uno screenshot utilizza l'autorizzazione alla registrazione dello schermo di macOS."}},"tr":{"stringUnit":{"state":"translated","value":"Ekran görüntüsü göndermek için macOS Ekran Kaydı erişimi kullanılır."}},"uk":{"stringUnit":{"state":"translated","value":"Для надсилання знімка екрана використовується дозвіл macOS на запис екрана."}},"id":{"stringUnit":{"state":"translated","value":"Mengirim tangkapan layar menggunakan akses Perekaman Layar macOS."}},"pl":{"stringUnit":{"state":"translated","value":"Wysyłanie zrzutu ekranu wymaga uprawnienia do nagrywania ekranu w macOS."}},"th":{"stringUnit":{"state