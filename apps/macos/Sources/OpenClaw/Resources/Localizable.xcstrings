    "Ready to run after you choose a Gateway connection.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Ready to run after you choose a Gateway connection."}},"zh-CN":{"stringUnit":{"state":"translated","value":"选择 Gateway 连接后即可运行。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"選擇 Gateway 連線後即可執行。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Pronto para executar após você escolher uma conexão com o Gateway."}},"de":{"stringUnit":{"state":"translated","value":"Bereit zur Ausführung, nachdem Sie eine Gateway-Verbindung ausgewählt haben."}},"es":{"stringUnit":{"state":"translated","value":"Listo para ejecutarse después de elegir una conexión de Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gateway 接続を選択すると実行できる状態になります。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway 연결을 선택하면 실행할 준비가 됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Prêt à s’exécuter après le choix d’une connexion Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"आपके Gateway कनेक्शन चुनने के बाद चलाने के लिए तैयार।"}},"ar":{"stringUnit":{"state":"translated","value":"جاهز للتشغيل بعد اختيار اتصال Gateway."}},"it":{"stringUnit":{"state":"translated","value":"Pronto per l'esecuzione dopo aver scelto una connessione Gateway."}},"tr":{"stringUnit":{"state":"translated","value":"Bir Gateway bağlantısı seçtikten sonra çalışmaya hazır."}},"uk":{"stringUnit":{"state":"translated","value":"Готово до запуску після вибору підключення Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Siap dijalankan setelah Anda memilih koneksi Gateway."}},"pl":{"stringUnit":{"state":"translated","value":"Gotowe do uruchomienia po wybraniu połączenia z Gateway."}},"th":{"stringUnit":{"state":"translated","value":"พร้อมทำงานหลังจากคุณเลือกการเชื่อมต่อ Gateway."}},"vi":{"stringUnit":{"state":"translated","value":"Sẵn sàng chạy sau khi bạn chọn một kết nối Gateway."}},"nl":{"stringUnit":{"state":"translated","value":"Klaar om te starten nadat je een Gateway-verbinding hebt gekozen."}},"fa":{"stringUnit":{"state":"translated","value":"پس از انتخاب اتصال Gateway آماده اجرا است."}},"ru":{"stringUnit":{"state":"translated","value":"Готово к запуску после выбора подключения к Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Redo att köras när du har valt en Gateway-anslutning."}}}},
    "Realtime Talk requested an invalid audio sample rate": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Realtime Talk requested an invalid audio sample rate"}},"zh-CN":{"stringUnit":{"state":"translated","value":"实时对话请求了无效的音频采样率"}},"zh-TW":{"stringUnit":{"state":"translated","value":"即時對話要求的音訊取樣率無效"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Talk em tempo real solicitou uma taxa de amostragem de áudio inválida"}},"de":{"stringUnit":{"state":"translated","value":"Echtzeitgespräch hat eine ungültige Audio-Abtastrate angefordert"}},"es":{"stringUnit":{"state":"translated","value":"La conversación en tiempo real solicitó una frecuencia de muestreo de audio no válida"}},"ja-JP":{"stringUnit":{"state":"translated","value":"リアルタイム通話が無効な音声サンプルレートを要求しました"}},"ko":{"stringUnit":{"state":"translated","value":"실시간 대화가 유효하지 않은 오디오 샘플링 레이트를 요청했습니다"}},"fr":{"stringUnit":{"state":"translated","value":"La conversation en temps réel a demandé une fréquence d’échantillonnage audio non valide"}},"hi":{"stringUnit":{"state":"translated","value":"Realtime Talk ने अमान्य ऑडियो सैंपल दर का अनुरोध किया"}},"ar":{"stringUnit":{"state":"translated","value":"طلب التحدث في الوقت الفعلي معدل عينات صوتية غير صالح"}},"it":{"stringUnit":{"state":"translated","value":"Realtime Talk ha richiesto una frequenza di campionamento audio non valida"}},"tr":{"stringUnit":{"state":"translated","value":"Gerçek zamanlı konuşma, geçersiz bir ses örnekleme hızı istedi"}},"uk":{"stringUnit":{"state":"translated","value":"Розмова в реальному часі запросила недопустиму частоту дискретизації аудіо"}},"id":{"stringUnit":{"state":"translated","value":"Percakapan waktu nyata meminta laju sampel audio yang tidak valid"}},"pl":{"stringUnit":{"state":"translated","value":"Rozmowa w czasie rzeczywistym zażądała nieprawidłowej częstotliwości próbkowania dźwięku"}},"th":{"stringUnit":{"state":"translated","value":"การสนทนาแบบเรียลไทม์ร้องขออัตราการสุ่มตัวอย่างเสียงที่ไม่ถูกต้อง"}},"vi":{"s