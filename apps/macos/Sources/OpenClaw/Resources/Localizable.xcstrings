    "Ask before every shell command.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Ask before every shell command."}},"zh-CN":{"stringUnit":{"state":"translated","value":"每次执行 shell 命令前都询问。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"每次執行 Shell 命令前皆詢問。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Perguntar antes de cada comando de shell."}},"de":{"stringUnit":{"state":"translated","value":"Vor jedem Shell-Befehl fragen."}},"es":{"stringUnit":{"state":"translated","value":"Preguntar antes de cada comando de shell."}},"ja-JP":{"stringUnit":{"state":"translated","value":"すべてのシェルコマンドの実行前に確認します。"}},"ko":{"stringUnit":{"state":"translated","value":"모든 셸 명령을 실행하기 전에 묻습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Demander avant chaque commande shell."}},"hi":{"stringUnit":{"state":"translated","value":"हर शेल कमांड से पहले पूछें।"}},"ar":{"stringUnit":{"state":"translated","value":"السؤال قبل كل أمر shell."}},"it":{"stringUnit":{"state":"translated","value":"Chiedi prima di ogni comando shell."}},"tr":{"stringUnit":{"state":"translated","value":"Her kabuk komutundan önce sor."}},"uk":{"stringUnit":{"state":"translated","value":"Запитувати перед кожною командою оболонки."}},"id":{"stringUnit":{"state":"translated","value":"Tanyakan sebelum setiap perintah shell."}},"pl":{"stringUnit":{"state":"translated","value":"Pytaj przed każdym poleceniem powłoki."}},"th":{"stringUnit":{"state":"translated","value":"ถามก่อนเรียกใช้คำสั่งเชลล์ทุกครั้ง"}},"vi":{"stringUnit":{"state":"translated","value":"Hỏi trước mỗi lệnh shell."}},"nl":{"stringUnit":{"state":"translated","value":"Vraag vóór elke shellopdracht om bevestiging."}},"fa":{"stringUnit":{"state":"translated","value":"پیش از هر فرمان پوسته بپرس."}},"ru":{"stringUnit":{"state":"translated","value":"Запрашивать подтверждение перед каждой командой оболочки."}},"sv":{"stringUnit":{"state":"translated","value":"Fråga före varje skalkommando."}}}},
    "Ask on Allowlist Miss": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Ask on Allowlist Miss"}},"zh-CN":{"stringUnit":{"state":"translated","value":"允许列表未命中时询问"}},"zh-TW":{"stringUnit":{"state":"translated","value":"允許清單未命中時詢問"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Perguntar em caso de ausência na lista de permissões"}},"de":{"stringUnit":{"state":"translated","value":"Bei Allowlist-Fehlschlag fragen"}},"es":{"stringUnit":{"state":"translated","value":"Preguntar si no está en la lista de permitidos"}},"ja-JP":{"stringUnit":{"state":"translated","value":"許可リストにない場合に確認"}},"ko":{"stringUnit":{"state":"translated","value":"허용 목록에 없으면 묻기"}},"fr":{"stringUnit":{"state":"translated","value":"Demander en cas d’absence dans la liste d’autorisation"}},"hi":{"stringUnit":{"state":"translated","value":"Allowlist में न मिलने पर पूछें"}},"ar":{"stringUnit":{"state":"translated","value":"السؤال عند عدم المطابقة في قائمة السماح"}},"it":{"stringUnit":{"state":"translated","value":"Chiedi in caso di mancata corrispondenza nell'elenco consentiti"}},"tr":{"stringUnit":{"state":"translated","value":"İzin Listesinde Bulunmadığında Sor"}},"uk":{"stringUnit":{"state":"translated","value":"Запитувати, якщо немає в allowlist"}},"id":{"stringUnit":{"state":"translated","value":"Tanya saat Tidak Ada di Allowlist"}},"pl":{"stringUnit":{"state":"translated","value":"Pytaj przy braku na liście dozwolonych"}},"th":{"stringUnit":{"state":"translated","value":"ถามเมื่อไม่พบใน Allowlist"}},"vi":{"stringUnit":{"state":"translated","value":"Hỏi khi không khớp danh sách cho phép"}},"nl":{"stringUnit":{"state":"translated","value":"Vragen bij ontbrekende allowlist-match"}},"fa":{"stringUnit":{"state":"translated","value":"در صورت نبود در Allowlist بپرس"}},"ru":{"stringUnit":{"state":"translated","value":"Спрашивать при отсутствии в списке разрешений"}},"sv":{"stringUnit":{"state":"translated","value":"Fråga vid miss i tillåtelselistan"}}}},
    "Ask only when a command is not trusted yet.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Ask only when a command is not trusted yet."}},"zh-CN":{"stringUnit":{"state":"translated","value":"仅当命令尚未受信任时询问。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"僅在命令尚未受信任時詢問。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Perguntar apenas quando um comando ainda não for confiável."}},"de":{"stringUnit":{"state":"translated","value":"Nur fragen, wenn ein Befehl noch nicht vertrauenswürdig ist."}},"es":{"stringUnit":{"state":"translated","value":"Preguntar solo cuando un comando aún no sea de confianza."}},"ja-JP":{"stringUnit":{"state":"translated","value":"コマンドがまだ信頼されていない場合のみ確認します。"}},"ko":{"stringUnit":{"state":"translated","value":"명령이 아직 신뢰되지 않은 경우에만 묻습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Demander uniquement lorsqu’une commande n’est pas encore approuvée."}},"hi":{"stringUnit":{"state":"translated","value":"केवल तभी पूछें, जब कोई कमांड अभी तक विश्वसनीय न हो।"}},"ar":{"stringUnit":{"state":"translated","value":"السؤال فقط عندما لا يكون الأمر موثوقًا بعد."}},"it":{"stringUnit":{"state":"translated","value":"Chiedi solo quando un comando non è ancora attendibile."}},"tr":{"stringUnit":{"state":"translated","value":"Yalnızca bir komut henüz güvenilir değilse sor."}},"uk":{"stringUnit":{"state":"translated","value":"Запитувати, лише якщо команда ще не є довіреною."}},"id":{"stringUnit":{"state":"translated","value":"Tanyakan hanya jika perintah belum tepercaya."}},"pl":{"stringUnit":{"state":"translated","value":"Pytaj tylko wtedy, gdy polecenie nie jest jeszcze zaufane."}},"th":{"stringUnit":{"state":"translated","value":"ถามเฉพาะเมื่อคำสั่งยังไม่ได้รับความเชื่อถือ"}},"vi":{"stringUnit":{"state":"translated","value":"Chỉ hỏi khi một lệnh chưa được tin cậy."}},"nl":{"stringUnit":{"state":"translated","value":"Vraag alleen wanneer een opdracht nog niet wordt vertrouwd."}},"fa":{"stringUnit":{"state":"translated","v