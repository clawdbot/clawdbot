    "Connect Discord, Slack, Telegram, WhatsApp, …": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connect Discord, Slack, Telegram, WhatsApp, …"}},"zh-CN":{"stringUnit":{"state":"translated","value":"连接 Discord, Slack, Telegram, WhatsApp, …"}},"zh-TW":{"stringUnit":{"state":"translated","value":"連接 Discord, Slack, Telegram, WhatsApp, …"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Conectar Discord, Slack, Telegram, WhatsApp, …"}},"de":{"stringUnit":{"state":"translated","value":"Discord, Slack, Telegram, WhatsApp, … verbinden"}},"es":{"stringUnit":{"state":"translated","value":"Conectar Discord, Slack, Telegram, WhatsApp, …"}},"ja-JP":{"stringUnit":{"state":"translated","value":"Discord, Slack, Telegram, WhatsApp, … に接続"}},"ko":{"stringUnit":{"state":"translated","value":"Discord, Slack, Telegram, WhatsApp, … 연결"}},"fr":{"stringUnit":{"state":"translated","value":"Connecter Discord, Slack, Telegram, WhatsApp, …"}},"hi":{"stringUnit":{"state":"translated","value":"Discord, Slack, Telegram, WhatsApp, … कनेक्ट करें"}},"ar":{"stringUnit":{"state":"translated","value":"ربط Discord, Slack, Telegram, WhatsApp, …"}},"it":{"stringUnit":{"state":"translated","value":"Connetti Discord, Slack, Telegram, WhatsApp, …"}},"tr":{"stringUnit":{"state":"translated","value":"Discord, Slack, Telegram, WhatsApp, … bağlayın"}},"uk":{"stringUnit":{"state":"translated","value":"Підключіть Discord, Slack, Telegram, WhatsApp, …"}},"id":{"stringUnit":{"state":"translated","value":"Hubungkan Discord, Slack, Telegram, WhatsApp, …"}},"pl":{"stringUnit":{"state":"translated","value":"Połącz Discord, Slack, Telegram, WhatsApp, …"}},"th":{"stringUnit":{"state":"translated","value":"เชื่อมต่อ Discord, Slack, Telegram, WhatsApp, …"}},"vi":{"stringUnit":{"state":"translated","value":"Kết nối Discord, Slack, Telegram, WhatsApp, …"}},"nl":{"stringUnit":{"state":"translated","value":"Verbind Discord, Slack, Telegram, WhatsApp, …"}},"fa":{"stringUnit":{"state":"translated",