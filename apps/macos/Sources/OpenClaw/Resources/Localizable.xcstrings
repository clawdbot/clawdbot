    "Open the compact chat panel; the agent can show previews and richer visuals in Canvas.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open the compact chat panel; the agent can show previews and richer visuals in Canvas."}},"zh-CN":{"stringUnit":{"state":"translated","value":"打开紧凑聊天面板；智能体可以在 Canvas 中展示预览和更丰富的视觉内容。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"開啟精簡聊天面板；代理程式可在 Canvas 中顯示預覽及更豐富的視覺內容。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Abra o painel de chat compacto; o agente pode mostrar prévias e elementos visuais mais elaborados no Canvas."}},"de":{"stringUnit":{"state":"translated","value":"Öffnen Sie das kompakte Chatfenster; der Agent kann in Canvas Vorschauen und umfangreichere Visualisierungen anzeigen."}},"es":{"stringUnit":{"state":"translated","value":"Abre el panel de chat compacto; el agente puede mostrar vistas previas y elementos visuales más completos en Canvas."}},"ja-JP":{"stringUnit":{"state":"translated","value":"コンパクトなチャットパネルを開きます; エージェントはCanvasでプレビューや、より豊かなビジュアルを表示できます。"}},"ko":{"stringUnit":{"state":"translated","value":"간소한 채팅 패널을 여세요; 에이전트가 Canvas에서 미리보기와 더욱 풍부한 시각 자료를 표시할 수 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Ouvrir le panneau de discussion compact ; l’agent peut afficher des aperçus et des visuels enrichis dans Canvas."}},"hi":{"stringUnit":{"state":"translated","value":"कॉम्पैक्ट चैट पैनल खोलें; एजेंट Canvas में पूर्वावलोकन और अधिक समृद्ध दृश्य दिखा सकता है."}},"ar":{"stringUnit":{"state":"translated","value":"افتح لوحة الدردشة المصغّرة; يمكن للوكيل عرض معاينات وعناصر مرئية أكثر ثراءً في Canvas."}},"it":{"stringUnit":{"state":"translated","value":"Apri il pannello compatto della chat; l'agente può mostrare anteprime e contenuti visivi più ricchi in Canvas."}},"tr":{"stringUnit":{"state":"translated","value":"Kompakt sohbet panelini açın; aracı, Canvas'ta önizlemeler ve daha zengin görseller gösterebilir."}},"uk":{"stringUnit":{"state":"translated","value":"Відкрийте компактну панель чату; агент може показувати попередні перегляди та розширені візуалізації в Canvas."}},"id":{"stringUnit":{"state":"translated","value":"Buka panel obrolan ringkas; agen dapat menampilkan pratinjau dan visual yang lebih kaya di Canvas."}},"pl":{"stringUnit":{"state":"translated","value":"Otwórz kompaktowy panel czatu; agent może wyświetlać podglądy i bardziej rozbudowane wizualizacje w Canvas."}},"th":{"stringUnit":{"state":"translated","value":"เปิดแผงแชทแบบกะทัดรัด; เอเจนต์สามารถแสดงตัวอย่างและภาพที่มีรายละเอียดมากขึ้นใน Canvas."}},"vi":{"stringUnit":{"state":"translated","value":"Mở bảng trò chuyện thu gọn; tác nhân có thể hiển thị bản xem trước và nội dung trực quan phong phú hơn trong Canvas."}},"nl":{"stringUnit":{"state":"translated","value":"Open het compacte chatpaneel; de agent kan voorbeelden en uitgebreidere visuele weergaven tonen in Canvas."}},"fa":{"stringUnit":{"state":"translated","value":"پنل فشردهٔ گفتگو را باز کنید؛ عامل می‌تواند پیش‌نمایش‌ها و محتوای بصری غنی‌تری را در Canvas نمایش دهد."}},"ru":{"stringUnit":{"state":"translated","value":"Открыть компактную панель чата; агент может показывать предварительный просмотр и расширенные визуализации в Canvas."}},"sv":{"stringUnit":{"state":"translated","value":"Öppna den kompakta chattpanelen; agenten kan visa förhandsvisningar och mer avancerat visuellt innehåll i Canvas."}}}},
    "Open the menu bar panel": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open the menu bar panel"}},"zh-CN":{"stringUnit":{"state":"translated","value":"打开菜单栏面板"}},"zh-TW":{"stringUnit":{"state":"translated","value":"開啟選單列面板"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Abrir o painel da barra de menus"}},"de":{"stringUnit":{"state":"translated","value":"Menüleistenfenster öffnen"}},"es":{"stringUnit":{"state":"translated","value":"Abrir el panel de la barra de menús"}},"ja-JP":{"stringUnit":{"state":"translated","value":"メニューバーパネルを開く"}},"ko":{"stringUnit":{"state":"translated","value":"메뉴 막대 패널 열기"}},"fr":{"stringUnit":{"state":"translated","value":"Ouvrir le panneau de la barre des menus"}},"hi":{"stringUnit":{"state":"translated","value":"मेनू बार पैनल खोलें"}},"ar":{"stringUnit":{"state":"translated","value":"فتح لوحة شريط القوائم"}},"it":{"stringUnit":{"state":"translated","value":"Apri il pannello della barra dei menu"}},"tr":{"stringUnit":{"state":"translated","value":"Menü çubuğu panelini aç"}},"uk":{"stringUnit":{"state":"translated","value":"Відкрити панель у рядку меню"}},"id":{"stringUnit":{"state":"translated","value":"Buka panel bar menu"}},"pl":{"stringUnit":{"state":"translated","value":"Otwórz panel paska menu"}},"th":{"stringUnit":{"state":"translated","value":"เปิดแผงแถบเมนู"}},"vi":{"stringUnit":{"state":"translated","value":"Mở bảng trên thanh menu"}},"nl":{"stringUnit":{"state":"translated","value":"Het menubalkpaneel openen"}},"fa":{"stringUnit":{"state":"translated","value":"باز کردن پنل نوار منو"}},"ru":{"stringUnit":{"state":"translated","value":"Открыть панель в строке меню"}},"sv":{"stringUnit":{"state":"translated","value":"Öppna menyradspanelen"}}}},
