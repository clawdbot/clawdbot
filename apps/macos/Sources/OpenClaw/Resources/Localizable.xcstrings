    "Credentials are stored with this profile in your Mac Keychain.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Credentials are stored with this profile in your Mac Keychain."}},"zh-CN":{"stringUnit":{"state":"translated","value":"凭据将随此配置文件存储在你的 Mac 钥匙串中。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"憑證會隨此設定檔儲存在您的 Mac 鑰匙圈中。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"As credenciais são armazenadas com este perfil nas Chaves do seu Mac."}},"de":{"stringUnit":{"state":"translated","value":"Die Anmeldedaten werden mit diesem Profil in deinem Mac-Schlüsselbund gespeichert."}},"es":{"stringUnit":{"state":"translated","value":"Las credenciales se almacenan con este perfil en el llavero de tu Mac."}},"ja-JP":{"stringUnit":{"state":"translated","value":"認証情報は、このプロファイルとともにMacのキーチェーンに保存されます。"}},"ko":{"stringUnit":{"state":"translated","value":"자격 증명은 이 프로필과 함께 Mac 키체인에 저장됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les identifiants sont stockés avec ce profil dans le trousseau de votre Mac."}},"hi":{"stringUnit":{"state":"translated","value":"क्रेडेंशियल इस प्रोफ़ाइल के साथ आपके Mac Keychain में संग्रहीत किए जाते हैं।"}},"ar":{"stringUnit":{"state":"translated","value":"تُخزَّن بيانات الاعتماد مع ملف التعريف هذا في سلسلة مفاتيح Mac."}},"it":{"stringUnit":{"state":"translated","value":"Le credenziali vengono archiviate con questo profilo nel Portachiavi del Mac."}},"tr":{"stringUnit":{"state":"translated","value":"Kimlik bilgileri bu profille birlikte Mac Anahtar Zinciri'nizde saklanır."}},"uk":{"stringUnit":{"state":"translated","value":"Облікові дані зберігаються разом із цим профілем у в’язці ключів Mac."}},"id":{"stringUnit":{"state":"translated","value":"Kredensial disimpan bersama profil ini di Rantai Kunci Mac Anda."}},"pl":{"stringUnit":{"state":"translated","value":"Dane uwierzytelniające są przechowywane wraz z tym profilem w pęku kluczy na Macu."}},"th":{"stringUnit":{"state":"translated","value":"ข้อมูลประจำตัวจะถูกจัดเก็บไว้กับโปรไฟล์นี้ในพวงกุญแจ Mac ของคุณ"}},"vi":{"stringUnit":{"state":"translated","value":"Thông tin xác thực được lưu cùng hồ sơ này trong Chuỗi khóa trên máy Mac của bạn."}},"nl":{"stringUnit":{"state":"translated","value":"Inloggegevens worden met dit profiel bewaard in je Mac-sleutelhanger."}},"fa":{"stringUnit":{"state":"translated","value":"اطلاعات ورود همراه با این نمایه در Keychain مک شما ذخیره می‌شود."}},"ru":{"stringUnit":{"state":"translated","value":"Учётные данные хранятся вместе с этим профилем в Связке ключей Mac."}},"sv":{"stringUnit":{"state":"translated","value":"Inloggningsuppgifterna lagras med den här profilen i din Mac-nyckelring."}}}},
    "Credentials stay on this Gateway and are saved only after the live test succeeds.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Credentials stay on this Gateway and are saved only after the live test succeeds."}},"zh-CN":{"stringUnit":{"state":"translated","value":"凭据仅保留在此 Gateway 上，且仅在实时测试成功后才会保存。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"認證資訊會保留在此 Gateway 上，且僅在即時測試成功後才會儲存。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"As credenciais permanecem neste Gateway e são salvas apenas após o teste ao vivo ser bem-sucedido."}},"de":{"stringUnit":{"state":"translated","value":"Die Anmeldedaten verbleiben auf diesem Gateway und werden erst gespeichert, wenn der Live-Test erfolgreich war."}},"es":{"stringUnit":{"state":"translated","value":"Las credenciales permanecen en este Gateway y solo se guardan tras superar la prueba en vivo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"認証情報はこの Gateway 上に留まり、ライブテストが成功した後にのみ保存されます。"}},"ko":{"stringUnit":{"state":"translated","value":"자격 증명은 이 Gateway에만 유지되며 라이브 테스트가 성공한 후에만 저장됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les identifiants restent sur ce Gateway et ne sont enregistrés qu'après la réussite du test en direct."}},"hi":{"stringUnit":{"state":"translated","value":"क्रेडेंशियल इस Gateway पर ही रहते हैं और लाइव टेस्ट सफल होने के बाद ही सहेजे जाते हैं।"}},"ar":{"stringUnit":{"state":"translated","value":"تبقى بيانات الاعتماد على هذا الـ Gateway ولا يتم حفظها إلا بعد نجاح الاختبار المباشر."}},"it":{"stringUnit":{"state":"translated","value":"Le credenziali rimangono su questo Gateway e vengono salvate solo dopo che il test in tempo reale ha esito positivo."}},"tr":{"stringUnit":{"state":"translated","value":"Kimlik bilgileri bu Gateway'de kalır ve yalnızca canlı test başarılı olduktan sonra kaydedilir."}},"uk":{"stringUnit":{"state":"translated","value":"Облікові дані залишаються на цьому Gateway і зберігаються лише після успішного онлайн-тесту."}},"id":{"stringUnit":{"state":"translated","value":"Kredensial tetap berada di Gateway ini dan hanya disimpan setelah tes langsung berhasil."}},"pl":{"stringUnit":{"state":"translated","value":"Dane uwierzytelniające pozostają na tym Gateway i są zapisywane dopiero po pomyślnym teście na żywo."}},"th":{"stringUnit":{"state":"translated","value":"ข้อมูลรับรองจะอยู่บน Gateway นี้และจะถูกบันทึกก็ต่อเมื่อการทดสอบแบบสดสำเร็จเท่านั้น"}},"vi":{"stringUnit":{"state":"translated","value":"Thông tin đăng nhập được giữ trên Gateway này và chỉ được lưu sau khi kiểm tra trực tiếp thành công."}},"nl":{"stringUnit":{"state":"translated","value":"Inloggegevens blijven op deze Gateway en worden pas opgeslagen nadat de live test is geslaagd."}},"fa":{"stringUnit":{"state":"translated","value":"اعتبارنامه‌ها روی همین Gateway باقی می‌مانند و تنها پس از موفقیت آزمایش زنده ذخیره می‌شوند."}},"ru":{"stringUnit":{"state":"translated","value":"Учётные данные остаются на этом Gateway и сохраняются только после успешной проверки в реальном времени."}},"sv":{"stringUnit":{"state":"translated","value":"Autentiseringsuppgifterna stannar på denna Gateway och sparas endast efter att livetestet har lyckats."}}}},
