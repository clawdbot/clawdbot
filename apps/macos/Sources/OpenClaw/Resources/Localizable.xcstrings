    "Tip: keep Tailscale enabled so your gateway stays reachable.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Tip: keep Tailscale enabled so your gateway stays reachable."}},"zh-CN":{"stringUnit":{"state":"translated","value":"提示：保持 Tailscale 启用，以便你的 gateway 保持可访问。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"提示：保持 Tailscale 啟用，讓你的 gateway 持續可連線。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Dica: mantenha o Tailscale ativado para que seu gateway permaneça acessível."}},"de":{"stringUnit":{"state":"translated","value":"Tipp: Lassen Sie Tailscale aktiviert, damit Ihre Gateway erreichbar bleibt."}},"es":{"stringUnit":{"state":"translated","value":"Consejo: mantén Tailscale activado para que tu gateway siga siendo accesible."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ヒント: Gateway に到達できる状態を保つため、Tailscale を有効にしておいてください。"}},"ko":{"stringUnit":{"state":"translated","value":"팁: Gateway에 계속 접근할 수 있도록 Tailscale을 활성화해 두세요."}},"fr":{"stringUnit":{"state":"translated","value":"Conseil : gardez Tailscale activé afin que votre gateway reste joignable."}},"hi":{"stringUnit":{"state":"translated","value":"सुझाव: Tailscale सक्षम रखें ताकि आपका gateway पहुँच योग्य बना रहे."}},"ar":{"stringUnit":{"state":"translated","value":"تلميح: أبقِ Tailscale مفعّلًا حتى يظل gateway لديك قابلاً للوصول."}},"it":{"stringUnit":{"state":"translated","value":"Suggerimento: tieni Tailscale abilitato affinché il tuo gateway rimanga raggiungibile."}},"tr":{"stringUnit":{"state":"translated","value":"İpucu: Gateway'inizin erişilebilir kalması için Tailscale'i etkin tutun."}},"uk":{"stringUnit":{"state":"translated","value":"Порада: тримайте Tailscale увімкненим, щоб ваш gateway залишався доступним."}},"id":{"stringUnit":{"state":"translated","value":"Tips: tetap aktifkan Tailscale agar gateway Anda tetap dapat dijangkau."}},"pl":{"stringUnit":{"state":"translated","value":"Wskazówka: pozostaw Tailscale włączone, aby gateway był dostępny."}},"th":{"stringUnit":{"state":"translated","value":"เคล็ดลับ: เปิดใช้งาน Tailscale ไว้เสมอเพื่อให้ gateway ของคุณเข้าถึงได้"}},"vi":{"stringUnit":{"state":"translated","value":"Mẹo: luôn bật Tailscale để gateway của bạn vẫn có thể truy cập được."}},"nl":{"stringUnit":{"state":"translated","value":"Tip: houd Tailscale ingeschakeld zodat je gateway bereikbaar blijft."}},"fa":{"stringUnit":{"state":"translated","value":"نکته: Tailscale را فعال نگه دارید تا gateway شما در دسترس بماند."}},"ru":{"stringUnit":{"state":"translated","value":"Совет: держите Tailscale включенным, чтобы ваш gateway оставался доступен."}},"sv":{"stringUnit":{"state":"translated","value":"Tips: håll Tailscale aktiverat så att din gateway förblir nåbar."}}}},
    "Tip: the session directory is returned by “Show panel”.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Tip: the session directory is returned by “Show panel”."}},"zh-CN":{"stringUnit":{"state":"translated","value":"提示：会话目录由“Show panel”返回。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"提示：工作階段目錄會由「顯示面板」傳回。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Dica: o diretório da sessão é retornado por “Mostrar painel”."}},"de":{"stringUnit":{"state":"translated","value":"Tipp: Das Sitzungsverzeichnis wird von „Panel anzeigen“ zurückgegeben."}},"es":{"stringUnit":{"state":"translated","value":"Consejo: el directorio de la sesión lo devuelve “Mostrar panel”."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ヒント: セッションディレクトリは “パネルを表示” によって返されます。"}},"ko":{"stringUnit":{"state":"translated","value":"팁: 세션 디렉터리는 “패널 표시”에서 반환됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Astuce : le répertoire de session est renvoyé par « Afficher le panneau »."}},"hi":{"stringUnit":{"state":"translated","value":"सुझाव: सत्र डायरेक्टरी “Show panel” द्वारा लौटाई जाती है।"}},"ar":{"stringUnit":{"state":"translated","value":"تلميح: يتم إرجاع دليل الجلسة بواسطة “إظهار اللوحة”."}},"it":{"stringUnit":{"state":"translated","value":"Suggerimento: la directory della sessione viene restituita da “Mostra pannello”."}},"tr":{"stringUnit":{"state":"translated","value":"İpucu: oturum dizini “Paneli göster” tarafından döndürülür."}},"uk":{"stringUnit":{"state":"translated","value":"Порада: каталог сесії повертається командою «Показати панель»."}},"id":{"stringUnit":{"state":"translated","value":"Tips: direktori sesi dikembalikan oleh “Tampilkan panel”."}},"pl":{"stringUnit":{"state":"translated","value":"Wskazówka: katalog sesji jest zwracany przez „Pokaż panel”."}},"th":{"stringUnit":{"state":"translated","value":"เคล็ดลับ: ไดเรกทอรีเซสชันจะถูกส่งคืนโดย “แสดงแผง”"}},"vi":{"stringUnit":{"state":"translated","value":"Mẹo: thư mục phiên được “Show panel” trả về."}},"nl":{"stringUnit":{"state":"translated","value":"Tip: de sessiemap wordt geretourneerd door “Paneel tonen”."}},"fa":{"stringUnit":{"state":"translated","value":"نکته: پوشه جلسه توسط «نمایش پنل» برگردانده می‌شود."}},"ru":{"stringUnit":{"state":"translated","value":"Совет: каталог сеанса возвращается командой «Показать панель»."}},"sv":{"stringUnit":{"state":"translated","value":"Tips: sessionskatalogen returneras av ”Visa panel”."}}}},
    "Tip: try “status”, “doctor”, “set default model …”, or “connect telegram”.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Tip: try “status”, “doctor”, “set default model …”, or “connect telegram”."}},"zh-CN":{"stringUnit":{"state":"translated","value":"提示：试试“status”、“doctor”、“set default model …”或“connect telegram”。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"提示：試試「status」、「doctor」、「set default model …」或「connect telegram」。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Dica: tente “status”, “doctor”, “set default model …” ou “connect telegram”."}},"de":{"stringUnit":{"state":"translated","value":"Tipp: Probieren Sie „status“, „doctor“, „set default model …“ oder „connect telegram“."}},"es":{"stringUnit":{"state":"translated","value":"Consejo: prueba «status», «doctor», «set default model …» o «connect telegram»."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ヒント：「status」、「doctor」、「set default model …」、「connect telegram」などをお試しください。"}},"ko":{"stringUnit":{"state":"translated","value":"팁: “status”, “doctor”, “set default model …” 또는 “connect telegram”을 사용해 보세요."}},"fr":{"stringUnit":{"state":"translated","value":"Conseil : essayez « status », « doctor », « set default model … » ou « connect telegram »."}},"hi":{"stringUnit":{"state":"translated","value":"सुझाव: “status”, “doctor”, “set default model …” या “connect telegram” आज़माएँ।"}},"ar":{"stringUnit":{"state":"translated","value":"تلميح: جرّب “status” أو “doctor” أو “set default model …” أو “connect telegram”."}},"it":{"stringUnit":{"state":"translated","value":"Suggerimento: prova “status”, “doctor”, “set default model …” o “connect telegram”."}},"tr":{"stringUnit":{"state":"translated","value":"İpucu: “durum”, “doktor”, “varsayılan modeli ayarla …” veya “telegram'a bağlan” ifadelerini deneyin."}},"uk":{"stringUnit":{"state":"translated","value":"Порада: спробуйте “status”, “doctor”, “set default model …” або “connect telegram”."}},"id":{"stringUnit":{"state":"translated","value":"Tips: coba “status”, “doctor”, “set default model …”, atau “connect telegram”."}},"pl":{"stringUnit":{"state":"translated","value":"Wskazówka: wypróbuj „status”, „doctor”, „set default model …” lub „connect telegram”."}},"th":{"stringUnit":{"state":"translated","value":"เคล็ดลับ: ลองใช้ “status”, “doctor”, “set default model …” หรือ “connect telegram”"}},"vi":{"stringUnit":{"state":"translated","value":"Mẹo: hãy thử “status”, “doctor”, “set default model …” hoặc “connect telegram”."}},"nl":{"stringUnit":{"state":"translated","value":"Tip: probeer “status”, “doctor”, “set default model …” of “connect telegram”."}},"fa":{"stringUnit":{"state":"translated","value":"نکته: «status»، «doctor»، «set default model …» یا «connect telegram» را امتحان کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Совет: попробуйте «status», «doctor», «set default model …» или «connect telegram»."}},"sv":{"stringUnit":{"state":"translated","value":"Tips: prova ”status”, ”doctor”, ”set default model …” eller ”connect telegram”."}}}},
    "Tip: use Tailscale Serve so the gateway has a valid HTTPS cert.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Tip: use Tailscale Serve so the gateway has a valid HTTPS cert."}},"zh-CN":{"stringUnit":{"state":"translated","value":"提示：使用 Tailscale Serve，让 gateway 拥有有效的 HTTPS 证书。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"提示：使用 Tailscale Serve，讓 gateway 具備有效的 HTTPS 憑證。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Dica: use o Tailscale Serve para que o gateway tenha um certificado HTTPS válido."}},"de":{"stringUnit":{"state":"translated","value":"Tipp: Verwenden Sie Tailscale Serve, damit das Gateway ein gültiges HTTPS-Zertifikat hat."}},"es":{"stringUnit":{"state":"translated","value":"Consejo: usa Tailscale Serve para que el gateway tenga un certificado HTTPS válido."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ヒント: Gateway が有効な HTTPS 証明書を持つように、Tailscale Serve を使用してください。"}},"ko":{"stringUnit":{"state":"translated","value":"팁: Gateway에 유효한 HTTPS 인증서가 있도록 Tailscale Serve를 사용하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Conseil : utilisez Tailscale Serve afin que la gateway dispose d’un certificat HTTPS valide."}},"hi":{"stringUnit":{"state":"translated","value":"सुझाव: Tailscale Serve का उपयोग करें ताकि gateway के पास मान्य HTTPS cert हो."}},"ar":{"stringUnit":{"state":"translated","value":"تلميح: استخدم Tailscale Serve حتى يحصل gateway على شهادة HTTPS صالحة."}},"it":{"stringUnit":{"state":"translated","value":"Suggerimento: usa Tailscale Serve affinché il gateway abbia un certificato HTTPS valido."}},"tr":{"stringUnit":{"state":"translated","value":"İpucu: Gateway'in geçerli bir HTTPS sertifikasına sahip olması için Tailscale Serve kullanın."}},"uk":{"stringUnit":{"state":"translated","value":"Порада: використовуйте Tailscale Serve, щоб gateway мав дійсний HTTPS-сертифікат."}},"id":{"stringUnit":{"state":"translated","value":"Tips: gunakan Tailscale Serve agar gateway memiliki sertifikat HTTPS yang valid."}},"pl":{"stringUnit":{"state":"translated","value":"Wskazówka: użyj Tailscale Serve, aby gateway miał prawidłowy certyfikat HTTPS."}},"th":{"stringUnit":{"state":"translated","value":"เคล็ดลับ: ใช้ Tailscale Serve เพื่อให้ gateway มีใบรับรอง HTTPS ที่ถูกต้อง"}},"vi":{"stringUnit":{"state":"translated","value":"Mẹo: sử dụng Tailscale Serve để gateway có chứng chỉ HTTPS hợp lệ."}},"nl":{"stringUnit":{"state":"translated","value":"Tip: gebruik Tailscale Serve zodat de gateway een geldig HTTPS-certificaat heeft."}},"fa":{"stringUnit":{"state":"translated","value":"نکته: از Tailscale Serve استفاده کنید تا gateway گواهی HTTPS معتبر داشته باشد."}},"ru":{"stringUnit":{"state":"translated","value":"Совет: используйте Tailscale Serve, чтобы у gateway был действительный HTTPS-сертификат."}},"sv":{"stringUnit":{"state":"translated","value":"Tips: använd Tailscale Serve så att gatewayen har ett giltigt HTTPS-certifikat."}}}},
    "Tip: use ‘New Job’ to add one, or enable cron in your gateway config.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Tip: use ‘New Job’ to add one, or enable cron in your gateway config."}},"zh-CN":{"stringUnit":{"state":"translated","value":"提示：使用“新建任务”添加任务，或在你的 gateway 配置中启用 cron。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"提示：使用「New Job」新增，或在您的 gateway config 中啟用 cron。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Dica: use ‘Novo trabalho’ para adicionar um, ou ative o cron na configuração do seu gateway."}},"de":{"stringUnit":{"state":"translated","value":"Tipp: Verwenden Sie „Neuer Job“, um einen hinzuzufügen, oder aktivieren Sie Cron in Ihrer Gateway-Konfiguration."}},"es":{"stringUnit":{"state":"translated","value":"Consejo: usa ‘Nueva tarea’ para añadir una, o activa cron en la configuración de tu gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ヒント: 「新規ジョブ」を使用して追加するか、Gateway 設定で cron を有効にしてください。"}},"ko":{"stringUnit":{"state":"translated","value":"팁: ‘새 작업’을 사용하여 추가하거나 게이트웨이 구성에서 cron을 활성화하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Astuce : utilisez « Nouvelle tâche » pour en ajouter une, ou activez cron dans la configuration de votre gateway."}},"hi":{"stringUnit":{"state":"translated","value":"सुझाव: एक जोड़ने के लिए ‘New Job’ का उपयोग करें, या अपने gateway config में cron सक्षम करें।"}},"ar":{"stringUnit":{"state":"translated","value":"تلميح: استخدم ‘مهمة جديدة’ لإضافة مهمة، أو فعّل Cron في إعدادات gateway."}},"it":{"stringUnit":{"state":"translated","value":"Suggerimento: usa “Nuovo job” per aggiungerne uno, oppure abilita cron nella configurazione del gateway."}},"tr":{"stringUnit":{"state":"translated","value":"İpucu: bir tane eklemek için ‘Yeni İş’i kullanın veya gateway yapılandırmanızda cron’u etkinleştirin."}},"uk":{"stringUnit":{"state":"translated","value":"Порада: скористайтеся «Нове завдання», щоб додати його, або ввімкніть cron у конфігурації gateway."}},"id":{"stringUnit":{"state":"translated","value":"Tips: gunakan ‘Job Baru’ untuk menambahkannya, atau aktifkan cron di konfigurasi gateway Anda."}},"pl":{"stringUnit":{"state":"translated","value":"Wskazówka: użyj „Nowe zadanie”, aby je dodać, albo włącz cron w konfiguracji gateway."}},"th":{"stringUnit":{"state":"translated","value":"เคล็ดลับ: ใช้ ‘งานใหม่’ เพื่อเพิ่มงาน หรือเปิดใช้งาน cron ในการกำหนดค่า gateway ของคุณ"}},"vi":{"stringUnit":{"state":"translated","value":"Mẹo: dùng ‘Tác vụ mới’ để thêm một tác vụ, hoặc bật cron trong cấu hình gateway của bạn."}},"nl":{"stringUnit":{"state":"translated","value":"Tip: gebruik ‘Nieuwe taak’ om er een toe te voegen, of schakel cron in je gateway-configuratie in."}},"fa":{"stringUnit":{"state":"translated","value":"نکته: برای افزودن یکی، از «کار جدید» استفاده کنید، یا cron را در پیکربندی gateway خود فعال کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Совет: используйте «Новое задание», чтобы добавить его, или включите cron в конфигурации вашего gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Tips: använd ”Nytt jobb” för att lägga till ett, eller aktivera cron i din gateway-konfiguration."}}}},
