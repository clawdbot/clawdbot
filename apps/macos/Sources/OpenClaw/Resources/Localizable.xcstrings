    "Attaching focused-window text uses macOS Accessibility access.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Attaching focused-window text uses macOS Accessibility access."}},"zh-CN":{"stringUnit":{"state":"translated","value":"附加当前聚焦窗口中的文本需要 macOS 辅助功能访问权限。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"附加聚焦視窗中的文字需要 macOS 輔助使用權限。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Anexar o texto da janela em foco usa o acesso de Acessibilidade do macOS."}},"de":{"stringUnit":{"state":"translated","value":"Zum Anhängen von Text aus dem fokussierten Fenster ist macOS-Bedienungshilfenzugriff erforderlich."}},"es":{"stringUnit":{"state":"translated","value":"Para adjuntar el texto de la ventana enfocada se requiere acceso de Accesibilidad de macOS."}},"ja-JP":{"stringUnit":{"state":"translated","value":"フォーカス中のウインドウのテキストを添付するには、macOSのアクセシビリティへのアクセスが必要です。"}},"ko":{"stringUnit":{"state":"translated","value":"포커스된 윈도우의 텍스트를 첨부하려면 macOS 손쉬운 사용 권한이 필요합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Joindre le texte de la fenêtre active nécessite l’accès aux fonctionnalités d’accessibilité de macOS."}},"hi":{"stringUnit":{"state":"translated","value":"फ़ोकस की गई विंडो का टेक्स्ट अटैच करने के लिए macOS Accessibility एक्सेस का उपयोग होता है।"}},"ar":{"stringUnit":{"state":"translated","value":"يتطلب إرفاق نص النافذة النشطة إذن تسهيلات الاستخدام في macOS."}},"it":{"stringUnit":{"state":"translated","value":"Per allegare il testo della finestra in primo piano è necessario l'accesso ad Accessibilità di macOS."}},"tr":{"stringUnit":{"state":"translated","value":"Odaktaki pencerenin metnini eklemek için macOS Erişilebilirlik erişimi kullanılır."}},"uk":{"stringUnit":{"state":"translated","value":"Для прикріплення тексту з активного вікна потрібен доступ до універсального доступу macOS."}},"id":{"stringUnit":{"state":"translated","value":"Melampirkan teks dari jendela yang difokuskan menggunakan akses Aksesibilitas macOS."}},"pl":{"stringUnit":{"state":"translated","value":"Załączanie tekstu z aktywnego okna wymaga dostępu do funkcji Dostępność w systemie macOS."}},"th":{"stringUnit":{"state":"translated","value":"การแนบข้อความจากหน้าต่างที่โฟกัสอยู่ต้องใช้สิทธิ์การช่วยการเข้าถึงของ macOS"}},"vi":{"stringUnit":{"state":"translated","value":"Việc đính kèm văn bản từ cửa sổ đang được chọn sử dụng quyền Trợ năng của macOS."}},"nl":{"stringUnit":{"state":"translated","value":"Voor het bijvoegen van tekst uit het actieve venster is toegang tot macOS-toegankelijkheid vereist."}},"fa":{"stringUnit":{"state":"translated","value":"پیوست‌کردن متن پنجرهٔ فعال از دسترسی Accessibility در macOS استفاده می‌کند."}},"ru":{"stringUnit":{"state":"translated","value":"Для прикрепления текста активного окна требуется доступ macOS к Универсальному доступу."}},"sv":{"stringUnit":{"state":"translated","value":"För att bifoga text från det fokuserade fönstret krävs åtkomst till Hjälpmedel i macOS."}}}},
