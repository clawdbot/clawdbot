    "Show me what you can help with on this Mac right now.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Show me what you can help with on this Mac right now."}},"zh-CN":{"stringUnit":{"state":"translated","value":"告诉我你现在能在这台 Mac 上帮我做什么。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"告訴我你現在能在這部 Mac 上提供哪些協助。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Mostre em que você pode ajudar neste Mac agora."}},"de":{"stringUnit":{"state":"translated","value":"Zeig mir, wobei du mir gerade auf diesem Mac helfen kannst."}},"es":{"stringUnit":{"state":"translated","value":"Muéstrame con qué puedes ayudarme en este Mac ahora mismo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このMacで今どのようなサポートができるか教えてください。"}},"ko":{"stringUnit":{"state":"translated","value":"지금 이 Mac에서 어떤 도움을 줄 수 있는지 보여 주세요."}},"fr":{"stringUnit":{"state":"translated","value":"Montrez-moi ce que vous pouvez m’aider à faire sur ce Mac en ce moment."}},"hi":{"stringUnit":{"state":"translated","value":"मुझे दिखाएँ कि आप अभी इस Mac पर किन कामों में मदद कर सकते हैं।"}},"ar":{"stringUnit":{"state":"translated","value":"أرني ما يمكنك مساعدتي فيه على جهاز Mac هذا الآن."}},"it":{"stringUnit":{"state":"translated","value":"Mostrami in cosa puoi aiutarmi su questo Mac in questo momento."}},"tr":{"stringUnit":{"state":"translated","value":"Şu anda bu Mac'te neler konusunda yardımcı olabileceğini göster."}},"uk":{"stringUnit":{"state":"translated","value":"Покажи, з чим ти можеш допомогти на цьому Mac просто зараз."}},"id":{"stringUnit":{"state":"translated","value":"Tunjukkan bantuan apa yang dapat Anda berikan di Mac ini sekarang."}},"pl":{"stringUnit":{"state":"translated","value":"Pokaż mi, w czym możesz teraz pomóc na tym Macu."}},"th":{"stringUnit":{"state":"translated","value":"แสดงให้ฉันเห็นว่าคุณช่วยอะไรได้บ้างบน Mac เครื่องนี้ในตอนนี้."}},"vi":{"stringUnit":{"state":"translated","value":"Cho tôi biết bạn có thể hỗ trợ những gì trên máy Mac này ngay lúc này."}},"