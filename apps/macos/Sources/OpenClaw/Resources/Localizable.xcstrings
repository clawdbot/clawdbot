    "Enable Voice Wake in Settings for hands-free commands with a live transcript overlay.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enable Voice Wake in Settings for hands-free commands with a live transcript overlay."}},"zh-CN":{"stringUnit":{"state":"translated","value":"在设置中启用语音唤醒，即可免手动发出指令，并在浮层中查看实时转写。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"在設定中啟用語音喚醒, 即可透過免持語音指令操作, 並顯示即時轉錄浮層。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ative o acionamento por voz em Ajustes para usar comandos sem as mãos com uma sobreposição de transcrição ao vivo."}},"de":{"stringUnit":{"state":"translated","value":"Aktivieren Sie die Sprachaktivierung in den Einstellungen, um freihändig Befehle mit eingeblendetem Live-Transkript zu geben."}},"es":{"stringUnit":{"state":"translated","value":"Activa la activación por voz en Ajustes para usar comandos manos libres con una transcripción en directo superpuesta."}},"ja-JP":{"stringUnit":{"state":"translated","value":"リアルタイムの文字起こしオーバーレイ付きでハンズフリーのコマンド操作を行うには、設定で音声起動を有効にしてください。"}},"ko":{"stringUnit":{"state":"translated","value":"실시간 음성 인식 텍스트 오버레이와 함께 핸즈프리 명령을 사용하려면 설정에서 음성 깨우기를 활성화하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Activez le réveil vocal dans les réglages pour utiliser les commandes mains libres avec une transcription en direct en surimpression."}},"hi":{"stringUnit":{"state":"translated","value":"लाइव ट्रांसक्रिप्ट ओवरले के साथ हैंड्स-फ़्री कमांड देने के लिए सेटिंग्स में वॉइस वेक सक्षम करें."}},"ar":{"stringUnit":{"state":"translated","value":"قم بتمكين التنشيط الصوتي في الإعدادات لإصدار الأوامر دون استخدام اليدين مع عرض نص الكلام مباشرةً في طبقة متراكبة."}},"it":{"stringUnit":{"state":"translated","value":"Abilita l'attivazione vocale in Impostazioni per usare i comandi a mani libere con una trascrizione in tempo reale in sovrimpressione."}},"tr":{"stringUnit":{"state":"translated","value":"Canlı konuşma dökümü katmanıyla eller serbest komutlar vermek için Ayarlar'da Sesle Uyandırmayı etkinleştirin."}},"uk":{"stringUnit":{"state":"translated","value":"Увімкніть голосову активацію в налаштуваннях, щоб подавати команди без допомоги рук із накладеною транскрипцією в реальному часі."}},"id":{"stringUnit":{"state":"translated","value":"Aktifkan Pengaktifan Suara di Pengaturan untuk perintah tanpa sentuhan dengan overlay transkrip langsung."}},"pl":{"stringUnit":{"state":"translated","value":"Włącz wybudzanie głosem w ustawieniach, aby wydawać polecenia bez użycia rąk i wyświetlać transkrypcję na żywo w nakładce."}},"th":{"stringUnit":{"state":"translated","value":"เปิดใช้งานการปลุกด้วยเสียงในการตั้งค่าเพื่อสั่งงานแบบแฮนด์ฟรีพร้อมข้อความถอดเสียงแบบเรียลไทม์ที่แสดงซ้อนบนหน้าจอ."}},"vi":{"stringUnit":{"state":"translated","value":"Bật kích hoạt bằng giọng nói trong Cài đặt để ra lệnh rảnh tay với lớp phủ hiển thị bản chép lời trực tiếp."}},"nl":{"stringUnit":{"state":"translated","value":"Schakel Spraakactivering in bij Instellingen voor handsfree opdrachten met een live transcriptie-overlay."}},"fa":{"stringUnit":{"state":"translated","value":"بیدارباش صوتی را در تنظیمات فعال کنید تا فرمان‌ها را بدون استفاده از دست و با نمایش رو‌صفحه‌ای متن زنده صادر کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Включите голосовую активацию в настройках, чтобы подавать команды без помощи рук и видеть их расшифровку в реальном времени поверх экрана."}},"sv":{"stringUnit":{"state":"translated","value":"Aktivera röstväckning i Inställningar för handsfree-kommandon med transkribering i realtid som överlägg."}}}},
    "Enable debug tools": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enable debug tools"}},"zh-CN":{"stringUnit":{"state":"translated","value":"启用调试工具"}},"zh-TW":{"stringUnit":{"state":"translated","value":"啟用偵錯工具"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ativar ferramentas de depuração"}},"de":{"stringUnit":{"state":"translated","value":"Debug-Werkzeuge aktivieren"}},"es":{"stringUnit":{"state":"translated","value":"Activar herramientas de depuración"}},"ja-JP":{"stringUnit":{"state":"translated","value":"デバッグツールを有効にする"}},"ko":{"stringUnit":{"state":"translated","value":"디버그 도구 활성화"}},"fr":{"stringUnit":{"state":"translated","value":"Activer les outils de débogage"}},"hi":{"stringUnit":{"state":"translated","value":"डीबग टूल सक्षम करें"}},"ar":{"stringUnit":{"state":"translated","value":"تمكين أدوات تصحيح الأخطاء"}},"it":{"stringUnit":{"state":"translated","value":"Abilita gli strumenti di debug"}},"tr":{"stringUnit":{"state":"translated","value":"Hata ayıklama araçlarını etkinleştir"}},"uk":{"stringUnit":{"state":"translated","value":"Увімкнути інструменти налагодження"}},"id":{"stringUnit":{"state":"translated","value":"Aktifkan alat debug"}},"pl":{"stringUnit":{"state":"translated","value":"Włącz narzędzia debugowania"}},"th":{"stringUnit":{"state":"translated","value":"เปิดใช้งานเครื่องมือแก้จุดบกพร่อง"}},"vi":{"stringUnit":{"state":"translated","value":"Bật công cụ gỡ lỗi"}},"nl":{"stringUnit":{"state":"translated","value":"Debugtools inschakelen"}},"fa":{"stringUnit":{"state":"translated","value":"فعال‌سازی ابزارهای اشکال‌زدایی"}},"ru":{"stringUnit":{"state":"translated","value":"Включить инструменты отладки"}},"sv":{"stringUnit":{"state":"translated","value":"Aktivera felsökningsverktyg"}}}},
    "Enable idle blinks and wiggles on the status icon.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enable idle blinks and wiggles on the status icon."}},"zh-CN":{"stringUnit":{"state":"translated","value":"启用状态图标在空闲时的眨眼和晃动效果。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"啟用狀態圖示閒置時的眨眼與晃動效果。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ativar piscadas e pequenos movimentos no ícone de status quando ocioso."}},"de":{"stringUnit":{"state":"translated","value":"Blink- und Wackelanimationen des Statussymbols im Leerlauf aktivieren."}},"es":{"stringUnit":{"state":"translated","value":"Activar parpadeos y movimientos del icono de estado cuando esté inactivo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"待機中のステータスアイコンのまばたきや揺れる動きを有効にします。"}},"ko":{"stringUnit":{"state":"translated","value":"유휴 상태에서 상태 아이콘의 깜박임 및 흔들림 효과를 활성화합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Activer les clignotements et les petits mouvements de l’icône d’état au repos."}},"hi":{"stringUnit":{"state":"translated","value":"निष्क्रिय अवस्था में स्थिति आइकन का झपकना और हिलना सक्षम करें."}},"ar":{"stringUnit":{"state":"translated","value":"تمكين الومضات والاهتزازات على أيقونة الحالة أثناء الخمول."}},"it":{"stringUnit":{"state":"translated","value":"Abilita ammiccamenti e oscillazioni dell'icona di stato durante l'inattività."}},"tr":{"stringUnit":{"state":"translated","value":"Boştayken durum simgesinde göz kırpma ve kıpırdama animasyonlarını etkinleştirin."}},"uk":{"stringUnit":{"state":"translated","value":"Увімкнути блимання та погойдування значка стану під час очікування."}},"id":{"stringUnit":{"state":"translated","value":"Aktifkan kedipan dan goyangan pada ikon status saat tidak aktif."}},"pl":{"stringUnit":{"state":"translated","value":"Włącz mruganie i poruszanie się ikony statusu w stanie bezczynności."}},"th":{"stringUnit":{"state":"translated","value":"เปิดใช้งานการกะพริบและการขยับของไอคอนสถานะขณะไม่ได้ใช้งาน."}},"vi":{"stringUnit":{"state":"translated","value":"Bật hiệu ứng chớp mắt và lắc lư trên biểu tượng trạng thái khi nhàn rỗi."}},"nl":{"stringUnit":{"state":"translated","value":"Laat het statuspictogram knipperen en wiebelen wanneer het inactief is."}},"fa":{"stringUnit":{"state":"translated","value":"چشمک‌ها و تکان‌های نماد وضعیت را در حالت بی‌کاری فعال کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Включить мигание и покачивание значка состояния в режиме ожидания."}},"sv":{"stringUnit":{"state":"translated","value":"Aktivera blinkningar och vickningar på statusikonen vid inaktivitet."}}}},
    "Enable optional skills (Peekaboo, oracle, camsnap, …) from Settings → Skills.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enable optional skills (Peekaboo, oracle, camsnap, …) from Settings → Skills."}},"zh-CN":{"stringUnit":{"state":"translated","value":"在设置 → Skills 中启用可选技能 (Peekaboo, oracle, camsnap, …)。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"從設定 → Skills 啟用選用技能 (Peekaboo, oracle, camsnap, …)."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ative skills opcionais (Peekaboo, oracle, camsnap, …) em Ajustes → Skills."}},"de":{"stringUnit":{"state":"translated","value":"Aktivieren Sie optionale Skills (Peekaboo, oracle, camsnap, …) unter Einstellungen → Skills."}},"es":{"stringUnit":{"state":"translated","value":"Activa las habilidades opcionales (Peekaboo, oracle, camsnap, …) desde Ajustes → Skills."}},"ja-JP":{"stringUnit":{"state":"translated","value":"設定 → Skillsからオプションのスキル (Peekaboo, oracle, camsnap, …) を有効にしてください。"}},"ko":{"stringUnit":{"state":"translated","value":"설정 → Skills에서 선택적 스킬(Peekaboo, oracle, camsnap, …)을 활성화하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Activez les compétences facultatives (Peekaboo, oracle, camsnap, …) dans Réglages → Skills."}},"hi":{"stringUnit":{"state":"translated","value":"सेटिंग्स → Skills से वैकल्पिक कौशल (Peekaboo, oracle, camsnap, …) सक्षम करें."}},"ar":{"stringUnit":{"state":"translated","value":"قم بتمكين المهارات الاختيارية (Peekaboo, oracle, camsnap, …) من الإعدادات → Skills."}},"it":{"stringUnit":{"state":"translated","value":"Abilita le funzionalità opzionali (Peekaboo, oracle, camsnap, …) da Impostazioni → Skills."}},"tr":{"stringUnit":{"state":"translated","value":"Ayarlar → Skills bölümünden isteğe bağlı becerileri (Peekaboo, oracle, camsnap, …) etkinleştirin."}},"uk":{"stringUnit":{"state":"translated","value":"Увімкніть додаткові навички (Peekaboo, oracle, camsnap, …) у розділі Налаштування → Skills."}},"id":{"stringUnit":{"state":"translated","value":"Aktifkan keterampilan opsional (Peekaboo, oracle, camsnap, …) dari Pengaturan → Skills."}},"pl":{"stringUnit":{"state":"translated","value":"Włącz opcjonalne umiejętności (Peekaboo, oracle, camsnap, …) w Ustawienia → Skills."}},"th":{"stringUnit":{"state":"translated","value":"เปิดใช้งานทักษะเสริม (Peekaboo, oracle, camsnap, …) จากการตั้งค่า → Skills."}},"vi":{"stringUnit":{"state":"translated","value":"Bật các kỹ năng tùy chọn (Peekaboo, oracle, camsnap, …) từ Cài đặt → Skills."}},"nl":{"stringUnit":{"state":"translated","value":"Schakel optionele vaardigheden (Peekaboo, oracle, camsnap, …) in via Instellingen → Skills."}},"fa":{"stringUnit":{"state":"translated","value":"مهارت‌های اختیاری (Peekaboo, oracle, camsnap, …) را از تنظیمات → Skills فعال کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Включите дополнительные навыки (Peekaboo, oracle, camsnap, …) в разделе Настройки → Skills."}},"sv":{"stringUnit":{"state":"translated","value":"Aktivera valfria färdigheter (Peekaboo, oracle, camsnap, …) via Inställningar → Skills."}}}},
    "Enable or install a text-inference provider plugin on this Gateway, then check again.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enable or install a text-inference provider plugin on this Gateway, then check again."}},"zh-CN":{"stringUnit":{"state":"translated","value":"在此 Gateway 上启用或安装文本推理提供商插件，然后重新检查。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"在此 Gateway 上啟用或安裝文字推論供應商外掛, 然後再次檢查。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ative ou instale um plugin de provedor de inferência de texto neste Gateway e verifique novamente."}},"de":{"stringUnit":{"state":"translated","value":"Aktivieren oder installieren Sie ein Plugin für einen Textinferenz-Anbieter auf diesem Gateway und prüfen Sie dann erneut."}},"es":{"stringUnit":{"state":"translated","value":"Activa o instala un complemento de proveedor de inferencia de texto en este Gateway, y vuelve a comprobarlo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このGatewayでテキスト推論プロバイダープラグインを有効にするかインストールしてから、もう一度確認してください。"}},"ko":{"stringUnit":{"state":"translated","value":"이 Gateway에서 텍스트 추론 제공업체 플러그인을 활성화하거나 설치한 후 다시 확인하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Activez ou installez un plugin de fournisseur d’inférence textuelle sur ce Gateway, puis vérifiez à nouveau."}},"hi":{"stringUnit":{"state":"translated","value":"इस Gateway पर टेक्स्ट-इन्फ़रेंस प्रदाता प्लगइन सक्षम या इंस्टॉल करें, फिर दोबारा जाँचें."}},"ar":{"stringUnit":{"state":"translated","value":"قم بتمكين إضافة موفر للاستدلال النصي أو تثبيتها على Gateway هذا، ثم تحقق مرة أخرى."}},"it":{"stringUnit":{"state":"translated","value":"Abilita o installa un plugin di un provider di inferenza testuale su questo Gateway, quindi verifica di nuovo."}},"tr":{"stringUnit":{"state":"translated","value":"Bu Gateway üzerinde bir metin çıkarımı sağlayıcı eklentisini etkinleştirin veya yükleyin, ardından tekrar kontrol edin."}},"uk":{"stringUnit":{"state":"translated","value":"Увімкніть або встановіть плагін постачальника текстового інференсу на цьому Gateway, а потім перевірте ще раз."}},"id":{"stringUnit":{"state":"translated","value":"Aktifkan atau instal plugin penyedia inferensi teks di Gateway ini, lalu periksa lagi."}},"pl":{"stringUnit":{"state":"translated","value":"Włącz lub zainstaluj wtyczkę dostawcy inferencji tekstowej na tym Gateway, a następnie sprawdź ponownie."}},"th":{"stringUnit":{"state":"translated","value":"เปิดใช้งานหรือติดตั้งปลั๊กอินผู้ให้บริการอนุมานข้อความบน Gateway นี้ แล้วตรวจสอบอีกครั้ง."}},"vi":{"stringUnit":{"state":"translated","value":"Bật hoặc cài đặt plugin nhà cung cấp suy luận văn bản trên Gateway này, rồi kiểm tra lại."}},"nl":{"stringUnit":{"state":"translated","value":"Schakel een providerplug-in voor tekstinferentie in op deze Gateway of installeer er een, en controleer het vervolgens opnieuw."}},"fa":{"stringUnit":{"state":"translated","value":"یک افزونهٔ ارائه‌دهندهٔ استنتاج متنی را در این Gateway فعال یا نصب کنید، سپس دوباره بررسی کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Включите или установите плагин провайдера генерации текста на этом Gateway, затем проверьте снова."}},"sv":{"stringUnit":{"state":"translated","value":"Aktivera eller installera ett leverantörsinsticksprogram för textinferens på denna Gateway och kontrollera sedan igen."}}}},
    "Enable ready skills, or install missing tools on the Gateway or this Mac.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enable ready skills, or install missing tools on the Gateway or this Mac."}},"zh-CN":{"stringUnit":{"state":"translated","value":"启用已就绪的技能，或在 Gateway 或此 Mac 上安装缺失的工具。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"啟用已就緒的技能, 或在 Gateway 或這台 Mac 上安裝缺少的工具。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ative as skills prontas para uso ou instale as ferramentas ausentes no Gateway ou neste Mac."}},"de":{"stringUnit":{"state":"translated","value":"Aktivieren Sie einsatzbereite Skills oder installieren Sie fehlende Werkzeuge auf dem Gateway oder diesem Mac."}},"es":{"stringUnit":{"state":"translated","value":"Activa las habilidades listas para usar, o instala las herramientas que faltan en el Gateway o en este Mac."}},"ja-JP":{"stringUnit":{"state":"translated","value":"準備済みのスキルを有効にするか、不足しているツールをGatewayまたはこのMacにインストールしてください。"}},"ko":{"stringUnit":{"state":"translated","value":"준비된 스킬을 활성화하거나 Gateway 또는 이 Mac에 누락된 도구를 설치하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Activez les compétences prêtes à l’emploi, ou installez les outils manquants sur le Gateway ou ce Mac."}},"hi":{"stringUnit":{"state":"translated","value":"तैयार कौशल सक्षम करें, या Gateway अथवा इस Mac पर अनुपलब्ध टूल इंस्टॉल करें."}},"ar":{"stringUnit":{"state":"translated","value":"قم بتمكين المهارات الجاهزة، أو تثبيت الأدوات المفقودة على Gateway أو جهاز Mac هذا."}},"it":{"stringUnit":{"state":"translated","value":"Abilita le funzionalità pronte all'uso, oppure installa gli strumenti mancanti sul Gateway o su questo Mac."}},"tr":{"stringUnit":{"state":"translated","value":"Hazır becerileri etkinleştirin veya eksik araçları Gateway ya da bu Mac üzerine yükleyin."}},"uk":{"stringUnit":{"state":"translated","value":"Увімкніть готові до використання навички або встановіть відсутні інструменти на Gateway чи цьому Mac."}},"id":{"stringUnit":{"state":"translated","value":"Aktifkan keterampilan yang siap digunakan, atau instal alat yang belum tersedia di Gateway atau Mac ini."}},"pl":{"stringUnit":{"state":"translated","value":"Włącz gotowe umiejętności lub zainstaluj brakujące narzędzia na Gateway lub tym Macu."}},"th":{"stringUnit":{"state":"translated","value":"เปิดใช้งานทักษะที่พร้อมใช้งาน หรือติดตั้งเครื่องมือที่ขาดอยู่บน Gateway หรือ Mac เครื่องนี้."}},"vi":{"stringUnit":{"state":"translated","value":"Bật các kỹ năng đã sẵn sàng, hoặc cài đặt các công cụ còn thiếu trên Gateway hoặc máy Mac này."}},"nl":{"stringUnit":{"state":"translated","value":"Schakel beschikbare vaardigheden in, of installeer ontbrekende tools op de Gateway of deze Mac."}},"fa":{"stringUnit":{"state":"translated","value":"مهارت‌های آماده را فعال کنید، یا ابزارهای موجود‌نبوده را روی Gateway یا این Mac نصب کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Включите готовые к использованию навыки или установите недостающие инструменты на Gateway или этот Mac."}},"sv":{"stringUnit":{"state":"translated","value":"Aktivera färdiga färdigheter, eller installera verktyg som saknas på Gateway eller den här Mac-datorn."}}}},
    "Enable/disable Canvas in General settings.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enable/disable Canvas in General settings."}},"zh-CN":{"stringUnit":{"state":"translated","value":"在通用设置中启用/禁用 Canvas。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"在一般設定中啟用/停用 Canvas."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ative/desative o Canvas nos ajustes gerais."}},"de":{"stringUnit":{"state":"translated","value":"Canvas unter „Allgemein“ in den Einstellungen aktivieren/deaktivieren."}},"es":{"stringUnit":{"state":"translated","value":"Activar/desactivar Canvas en los ajustes generales."}},"ja-JP":{"stringUnit":{"state":"translated","value":"一般設定でCanvasを有効/無効にします."}},"ko":{"stringUnit":{"state":"translated","value":"일반 설정에서 Canvas를 활성화/비활성화하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Activer/désactiver Canvas dans les réglages généraux."}},"hi":{"stringUnit":{"state":"translated","value":"सामान्य सेटिंग्स में Canvas सक्षम/अक्षम करें."}},"ar":{"stringUnit":{"state":"translated","value":"تمكين/تعطيل Canvas في الإعدادات العامة."}},"it":{"stringUnit":{"state":"translated","value":"Abilita/disabilita Canvas nelle impostazioni generali."}},"tr":{"stringUnit":{"state":"translated","value":"Genel ayarlarda Canvas'ı etkinleştirin/devre dışı bırakın."}},"uk":{"stringUnit":{"state":"translated","value":"Увімкніть/вимкніть Canvas у загальних налаштуваннях."}},"id":{"stringUnit":{"state":"translated","value":"Aktifkan/nonaktifkan Canvas di pengaturan Umum."}},"pl":{"stringUnit":{"state":"translated","value":"Włącz/wyłącz Canvas w ustawieniach ogólnych."}},"th":{"stringUnit":{"state":"translated","value":"เปิด/ปิดใช้งาน Canvas ในการตั้งค่าทั่วไป."}},"vi":{"stringUnit":{"state":"translated","value":"Bật/tắt Canvas trong cài đặt Chung."}},"nl":{"stringUnit":{"state":"translated","value":"Schakel Canvas in/uit bij Algemene instellingen."}},"fa":{"stringUnit":{"state":"translated","value":"Canvas را در تنظیمات عمومی فعال/غی