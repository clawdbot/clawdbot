    "Switch this Mac app to a local Gateway before importing browser cookies.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Switch this Mac app to a local Gateway before importing browser cookies."}},"zh-CN":{"stringUnit":{"state":"translated","value":"在导入浏览器 cookie 之前，请将此 Mac 应用切换到本地 Gateway。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"匯入瀏覽器 cookie 前，請先將此 Mac 應用程式切換為本機 Gateway。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Alterne este app do Mac para um Gateway local antes de importar os cookies do navegador."}},"de":{"stringUnit":{"state":"translated","value":"Wechseln Sie diese Mac-App zu einem lokalen Gateway, bevor Sie Browser-Cookies importieren."}},"es":{"stringUnit":{"state":"translated","value":"Cambia esta app de Mac a un Gateway local antes de importar las cookies del navegador."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ブラウザの Cookie をインポートする前に、この Mac アプリをローカル Gateway に切り替えてください。"}},"ko":{"stringUnit":{"state":"translated","value":"브라우저 쿠키를 가져오기 전에 이 Mac 앱을 로컬 Gateway로 전환하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Basculez cette application Mac vers un Gateway local avant d'importer les cookies du navigateur."}},"hi":{"stringUnit":{"state":"translated","value":"ब्राउज़र कुकीज़ आयात करने से पहले इस Mac ऐप को लोकल Gateway पर स्विच करें।"}},"ar":{"stringUnit":{"state":"translated","value":"بدّل تطبيق Mac هذا إلى Gateway محلي قبل استيراد ملفات تعريف الارتباط الخاصة بالمتصفح."}},"it":{"stringUnit":{"state":"translated","value":"Passa questa app Mac a un Gateway locale prima di importare i cookie del browser."}},"tr":{"stringUnit":{"state":"translated","value":"Tarayıcı çerezlerini içe aktarmadan önce bu Mac uygulamasını yerel bir Gateway'e geçirin."}},"uk":{"stringUnit":{"state":"translated","value":"Перемкніть цей застосунок Mac на локальний Gateway перед імпортом файлів cookie браузера."}},"id":{"stringUnit":{"state":"translated","value":"Alihkan aplikasi Mac ini ke Gateway lokal sebelum mengimpor cookie browser."}},"pl":{"stringUnit":{"state":"translated","value":"Przełącz tę aplikację Mac na lokalny Gateway przed zaimportowaniem plików cookie przeglądarki."}},"th":{"stringUnit":{"state":"translated","value":"เปลี่ยนแอป Mac นี้เป็น Gateway ในเครื่องก่อนนำเข้าคุกกี้ของเบราว์เซอร์"}},"vi":{"stringUnit":{"state":"translated","value":"Chuyển ứng dụng Mac này sang Gateway cục bộ trước khi nhập cookie trình duyệt."}},"nl":{"stringUnit":{"state":"translated","value":"Schakel deze Mac-app over naar een lokale Gateway voordat je browsercookies importeert."}},"fa":{"stringUnit":{"state":"translated","value":"پیش از درون‌ریزی کوکی‌های مرورگر، این برنامه مک را به یک Gateway محلی تغییر دهید."}},"ru":{"stringUnit":{"state":"translated","value":"Переключите это приложение Mac на локальный Gateway перед импортом cookie браузера."}},"sv":{"stringUnit":{"state":"translated","value":"Växla den här Mac-appen till en lokal Gateway innan du importerar webbläsarcookies."}}}},
