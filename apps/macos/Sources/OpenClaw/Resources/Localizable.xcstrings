    "OpenClaw %@ and its Mac node runtime are ready.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenClaw %@ and its Mac node runtime are ready."}},"zh-CN":{"stringUnit":{"state":"translated","value":"OpenClaw %@ 及其 Mac 节点运行时已就绪。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw %@ 及其 Mac 節點執行環境已就緒。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O OpenClaw %@ e seu ambiente de execução de nó no Mac estão prontos."}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw %@ und seine Mac-Knotenlaufzeit sind bereit."}},"es":{"stringUnit":{"state":"translated","value":"OpenClaw %@ y su entorno de ejecución de nodos para Mac están listos."}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClaw %@ とその Mac ノードランタイムの準備ができました。"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw %@ 및 해당 Mac 노드 런타임이 준비되었습니다."}},"fr":{"stringUnit":{"state":"translated","value":"OpenClaw %@ et son environnement d’exécution de nœud Mac sont prêts."}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw %@ और उसका Mac नोड रनटाइम तैयार हैं."}},"ar":{"stringUnit":{"state":"translated","value":"OpenClaw %@ وبيئة تشغيل عقدته على Mac جاهزان."}},"it":{"stringUnit":{"state":"translated","value":"OpenClaw %@ e il runtime del suo nodo Mac sono pronti."}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw %@ ve Mac düğümü çalışma ortamı hazır."}},"uk":{"stringUnit":{"state":"translated","value":"OpenClaw %@ і його середовище виконання вузла Mac готові."}},"id":{"stringUnit":{"state":"translated","value":"OpenClaw %@ dan runtime node Mac-nya siap."}},"pl":{"stringUnit":{"state":"translated","value":"OpenClaw %@ i jego środowisko uruchomieniowe węzła na Macu są gotowe."}},"th":{"stringUnit":{"state":"translated","value":"OpenClaw %@ และรันไทม์โหนด Mac พร้อมใช้งานแล้ว."}},"vi":{"stringUnit":{"state":"translated","value":"OpenClaw %@ và môi trường chạy nút Mac của ứng dụng đã sẵn sàng."}},"nl":{"stringUnit":{"state":"transla