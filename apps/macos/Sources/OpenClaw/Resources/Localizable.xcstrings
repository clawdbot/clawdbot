    "Choose another app before pasting.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose another app before pasting."}},"zh-CN":{"stringUnit":{"state":"translated","value":"请先选择其他应用再粘贴。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"請先選擇其他 App，再進行貼上。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolha outro app antes de colar."}},"de":{"stringUnit":{"state":"translated","value":"Wähle vor dem Einfügen eine andere App aus."}},"es":{"stringUnit":{"state":"translated","value":"Elige otra app antes de pegar."}},"ja-JP":{"stringUnit":{"state":"translated","value":"貼り付ける前に別のアプリを選択してください。"}},"ko":{"stringUnit":{"state":"translated","value":"붙여넣기 전에 다른 앱을 선택하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez une autre app avant de coller."}},"hi":{"stringUnit":{"state":"translated","value":"पेस्ट करने से पहले कोई दूसरा ऐप चुनें।"}},"ar":{"stringUnit":{"state":"translated","value":"اختر تطبيقًا آخر قبل اللصق."}},"it":{"stringUnit":{"state":"translated","value":"Scegli un'altra app prima di incollare."}},"tr":{"stringUnit":{"state":"translated","value":"Yapıştırmadan önce başka bir uygulama seçin."}},"uk":{"stringUnit":{"state":"translated","value":"Перед вставленням виберіть іншу програму."}},"id":{"stringUnit":{"state":"translated","value":"Pilih aplikasi lain sebelum menempelkan."}},"pl":{"stringUnit":{"state":"translated","value":"Przed wklejeniem wybierz inną aplikację."}},"th":{"stringUnit":{"state":"translated","value":"เลือกแอปอื่นก่อนวาง"}},"vi":{"stringUnit":{"state":"translated","value":"Chọn một ứng dụng khác trước khi dán."}},"nl":{"stringUnit":{"state":"translated","value":"Kies een andere app voordat je plakt."}},"fa":{"stringUnit":{"state":"translated","value":"پیش از جای‌گذاری، برنامه دیگری را انتخاب کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Перед вставкой выберите другое приложение."}},"sv":{"stringUnit":{"state":"translated","value":"Välj en annan app innan du klistrar in."}}}},
    "Choose file…": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose file…"}},"zh-CN":{"stringUnit":{"state":"translated","value":"选择文件…"}},"zh-TW":{"stringUnit":{"state":"translated","value":"選擇檔案…"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolher arquivo…"}},"de":{"stringUnit":{"state":"translated","value":"Datei auswählen…"}},"es":{"stringUnit":{"state":"translated","value":"Elegir archivo…"}},"ja-JP":{"stringUnit":{"state":"translated","value":"ファイルを選択…"}},"ko":{"stringUnit":{"state":"translated","value":"파일 선택…"}},"fr":{"stringUnit":{"state":"translated","value":"Choisir un fichier…"}},"hi":{"stringUnit":{"state":"translated","value":"फ़ाइल चुनें…"}},"ar":{"stringUnit":{"state":"translated","value":"اختر ملفًا…"}},"it":{"stringUnit":{"state":"translated","value":"Scegli file…"}},"tr":{"stringUnit":{"state":"translated","value":"Dosya seç…"}},"uk":{"stringUnit":{"state":"translated","value":"Вибрати файл…"}},"id":{"stringUnit":{"state":"translated","value":"Pilih file…"}},"pl":{"stringUnit":{"state":"translated","value":"Wybierz plik…"}},"th":{"stringUnit":{"state":"translated","value":"เลือกไฟล์…"}},"vi":{"stringUnit":{"state":"translated","value":"Chọn tệp…"}},"nl":{"stringUnit":{"state":"translated","value":"Kies bestand…"}},"fa":{"stringUnit":{"state":"translated","value":"انتخاب فایل…"}},"ru":{"stringUnit":{"state":"translated","value":"Выбрать файл…"}},"sv":{"stringUnit":{"state":"translated","value":"Välj fil…"}}}},
    "Choose local or remote before the app can attach to a Gateway.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose local or remote before the app can attach to a Gateway."}},"zh-CN":{"stringUnit":{"state":"translated","value":"应用需要先选择本地或远程，才能连接到 Gateway。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"app 必須先選擇本機或遠端，才能連接至 Gateway。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolha local ou remoto antes que o app possa se conectar a um Gateway."}},"de":{"stringUnit":{"state":"translated","value":"Wählen Sie lokal oder remote aus, bevor die App eine Verbindung zu einer Gateway herstellen kann."}},"es":{"stringUnit":{"state":"translated","value":"Elige local o remoto antes de que la app pueda conectarse a un Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"アプリを Gateway に接続するには、先にローカルまたはリモートを選択してください。"}},"ko":{"stringUnit":{"state":"translated","value":"앱이 Gateway에 연결하려면 먼저 로컬 또는 원격을 선택하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez local ou distant avant que l’app puisse se connecter à un Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"ऐप के Gateway से जुड़ने से पहले लोकल या रिमोट चुनें।"}},"ar":{"stringUnit":{"state":"translated","value":"اختر محليًا أو بعيدًا قبل أن يتمكن التطبيق من الاتصال بـ Gateway."}},"it":{"stringUnit":{"state":"translated","value":"Scegli locale o remoto prima che l'app possa collegarsi a un Gateway."}},"tr":{"stringUnit":{"state":"translated","value":"Uygulama bir Gateway’e bağlanabilmeden önce yerel veya uzak seçeneğini seçin."}},"uk":{"stringUnit":{"state":"translated","value":"Виберіть локальний або віддалений режим, перш ніж програма зможе підключитися до Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Pilih lokal atau jarak jauh sebelum app dapat terhubung ke Gateway."}},"pl":{"stringUnit":{"state":"translated","value":"Wybierz tryb lokalny lub zdalny, zanim aplikacja będzie mogła połączyć się z Gateway."}},"th":{"stringUnit":{"state":"translated","value":"เลือกในเครื่องหรือระยะไกลก่อนที่แอปจะเชื่อมต่อกับ Gateway ได้"}},"vi":{"stringUnit":{"state":"translated","value":"Chọn cục bộ hoặc từ xa trước khi ứng dụng có thể gắn vào Gateway."}},"nl":{"stringUnit":{"state":"translated","value":"Kies lokaal of extern voordat de app verbinding kan maken met een Gateway."}},"fa":{"stringUnit":{"state":"translated","value":"پیش از آنکه برنامه بتواند به Gateway متصل شود، گزینه محلی یا راه‌دور را انتخاب کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Выберите локальный или удаленный вариант, прежде чем приложение сможет подключиться к Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Välj lokalt eller fjärr innan appen kan ansluta till en Gateway."}}}},
    "Choose model and reasoning": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose model and reasoning"}},"zh-CN":{"stringUnit":{"state":"translated","value":"选择模型和推理模式"}},"zh-TW":{"stringUnit":{"state":"translated","value":"選擇模型與推理模式"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolher modelo e raciocínio"}},"de":{"stringUnit":{"state":"translated","value":"Modell und Schlussfolgerung auswählen"}},"es":{"stringUnit":{"state":"translated","value":"Elegir modelo y razonamiento"}},"ja-JP":{"stringUnit":{"state":"translated","value":"モデルと推論を選択"}},"ko":{"stringUnit":{"state":"translated","value":"모델 및 추론 선택"}},"fr":{"stringUnit":{"state":"translated","value":"Choisir le modèle et le raisonnement"}},"hi":{"stringUnit":{"state":"translated","value":"मॉडल और तर्क चुनें"}},"ar":{"stringUnit":{"state":"translated","value":"اختر النموذج والاستدلال"}},"it":{"stringUnit":{"state":"translated","value":"Scegli modello e ragionamento"}},"tr":{"stringUnit":{"state":"translated","value":"Model ve akıl yürütme seçin"}},"uk":{"stringUnit":{"state":"translated","value":"Виберіть модель і режим міркування"}},"id":{"stringUnit":{"state":"translated","value":"Pilih model dan penalaran"}},"pl":{"stringUnit":{"state":"translated","value":"Wybierz model i tryb rozumowania"}},"th":{"stringUnit":{"state":"translated","value":"เลือกโมเดลและการใช้เหตุผล"}},"vi":{"stringUnit":{"state":"translated","value":"Chọn mô hình và chế độ suy luận"}},"nl":{"stringUnit":{"state":"translated","value":"Kies model en redeneermethode"}},"fa":{"stringUnit":{"state":"translated","value":"انتخاب مدل و استدلال"}},"ru":{"stringUnit":{"state":"translated","value":"Выбрать модель и режим рассуждений"}},"sv":{"stringUnit":{"state":"translated","value":"Välj modell och resonemang"}}}},
    "Choose the node-local automation backend for snapshots and actions.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose the node-local automation backend for snapshots and actions."}},"zh-CN":{"stringUnit":{"state":"translated","value":"选择用于快照和操作的节点本地自动化后端。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"為快照與動作選擇節點本機的自動化後端。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolha o backend de automação local do nó para instantâneos e ações."}},"de":{"stringUnit":{"state":"translated","value":"Wählen Sie das knotenlokale Automatisierungs-Backend für Snapshots und Aktionen."}},"es":{"stringUnit":{"state":"translated","value":"Elige el backend de automatización local del nodo para instantáneas y acciones."}},"ja-JP":{"stringUnit":{"state":"translated","value":"スナップショットとアクションのためのノードローカルな自動化バックエンドを選択します。"}},"ko":{"stringUnit":{"state":"translated","value":"스냅샷 및 작업을 위한 노드 로컬 자동화 백엔드를 선택하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez le backend d'automatisation local au nœud pour les instantanés et les actions."}},"hi":{"stringUnit":{"state":"translated","value":"स्नैपशॉट और क्रियाओं के लिए नोड-लोकल ऑटोमेशन बैकएंड चुनें।"}},"ar":{"stringUnit":{"state":"translated","value":"اختر الخلفية المحلية للعقدة لأتمتة اللقطات والإجراءات."}},"it":{"stringUnit":{"state":"translated","value":"Scegli il backend di automazione locale del nodo per snapshot e azioni."}},"tr":{"stringUnit":{"state":"translated","value":"Anlık görüntüler ve eylemler için düğüm yerel otomasyon arka ucunu seçin."}},"uk":{"stringUnit":{"state":"translated","value":"Виберіть локальний для вузла бекенд автоматизації для знімків і дій."}},"id":{"stringUnit":{"state":"translated","value":"Pilih backend otomatisasi node-local untuk snapshot dan aksi."}},"pl":{"stringUnit":{"state":"translated","value":"Wybierz lokalny backend automatyzacji węzła dla migawek i akcji."}},"th":{"stringUnit":{"state":"translated","value":"เลือกแบ็กเอนด์การทำงานอัตโนมัติแบบ node-local สำหรับสแนปช็อตและการดำเนินการ"}},"vi":{"stringUnit":{"state":"translated","value":"Chọn backend tự động hóa cục bộ trên node cho ảnh chụp và hành động."}},"nl":{"stringUnit":{"state":"translated","value":"Kies de node-lokale automatiseringsbackend voor momentopnamen en acties."}},"fa":{"stringUnit":{"state":"translated","value":"بک‌اند خودکارسازی محلی گره را برای عکس‌های فوری و اقدامات انتخاب کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Выберите локальный на узле бэкенд автоматизации для снимков и действий."}},"sv":{"stringUnit":{"state":"translated","value":"Välj den nodlokala automatiseringsbackend för ögonblicksbilder och åtgärder."}}}},
    "Choose the realtime provider, model, voice, and transport in the Control UI.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose the realtime provider, model, voice, and transport in the Control UI."}},"zh-CN":{"stringUnit":{"state":"translated","value":"在 Control UI 中选择实时提供方、模型、语音和传输方式。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"在 Control UI 中選擇即時服務供應商、模型、語音與傳輸方式。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolha o provedor de tempo real, o modelo, a voz e o transporte na Control UI."}},"de":{"stringUnit":{"state":"translated","value":"Wählen Sie den Realtime-Anbieter, das Modell, die Stimme und den Transport in der Control UI aus."}},"es":{"stringUnit":{"state":"translated","value":"Elige el proveedor en tiempo real, el modelo, la voz y el transporte en el Control UI."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Control UI でリアルタイムプロバイダー、モデル、音声、トランスポートを選択します。"}},"ko":{"stringUnit":{"state":"translated","value":"Control UI에서 실시간 제공업체, 모델, 음성 및 전송 방식을 선택하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez le fournisseur temps réel, le modèle, la voix et le transport dans le Control UI."}},"hi":{"stringUnit":{"state":"translated","value":"Control UI में रियलटाइम प्रदाता, मॉडल, वॉइस और ट्रांसपोर्ट चुनें।"}},"ar":{"stringUnit":{"state":"translated","value":"اختر مزوّد الوقت الفعلي والنموذج والصوت والنقل في Control UI."}},"it":{"stringUnit":{"state":"translated","value":"Scegli il provider realtime, il modello, la voce e il trasporto nella Control UI."}},"tr":{"stringUnit":{"state":"translated","value":"Control UI'de gerçek zamanlı sağlayıcıyı, modeli, sesi ve aktarımı seçin."}},"uk":{"stringUnit":{"state":"translated","value":"Виберіть постачальника реального часу, модель, голос і транспорт у Control UI."}},"id":{"stringUnit":{"state":"translated","value":"Pilih penyedia realtime, model, suara, dan transport di Control UI."}},"pl":{"stringUnit":{"state":"translated","value":"Wybierz dostawcę czasu rzeczywistego, model, głos i transport w Control UI."}},"th":{"stringUnit":{"state":"translated","value":"เลือกผู้ให้บริการเรียลไทม์ โมเดล เสียง และการส่งข้อมูลใน Control UI"}},"vi":{"stringUnit":{"state":"translated","value":"Chọn nhà cung cấp realtime, mô hình, giọng nói và phương thức truyền tải trong Control UI."}},"nl":{"stringUnit":{"state":"translated","value":"Kies de realtime-provider, het model, de stem en het transport in de Control UI."}},"fa":{"stringUnit":{"state":"translated","value":"ارائه‌دهنده بلادرنگ، مدل، صدا و انتقال را در Control UI انتخاب کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Выберите провайдера реального времени, модель, голос и транспорт в Control UI."}},"sv":{"stringUnit":{"state":"translated","value":"Välj realtidsleverantör, modell, röst och transport i Control UI."}}}},
    "Choose where the Gateway runs and how this Mac app reaches it.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose where the Gateway runs and how this Mac app reaches it."}},"zh-CN":{"stringUnit":{"state":"translated","value":"选择 Gateway 的运行位置以及此 Mac App 如何连接到它。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"選擇 Gateway 的執行位置，以及此 Mac app 如何連線至它。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolha onde o Gateway é executado e como este app para Mac o acessa."}},"de":{"stringUnit":{"state":"translated","value":"Wählen Sie aus, wo die Gateway ausgeführt wird und wie diese Mac-App sie erreicht."}},"es":{"stringUnit":{"state":"translated","value":"Elige dónde se ejecuta el Gateway y cómo esta app para Mac se conecta a él."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gateway を実行する場所と、この Mac アプリからの接続方法を選択します。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway가 실행되는 위치와 이 Mac 앱이 Gateway에 연결하는 방법을 선택하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez où s’exécute le Gateway et comment cette app Mac y accède."}},"hi":{"stringUnit":{"state":"translated","value":"चुनें कि Gateway कहाँ चलता है और यह Mac ऐप उस तक कैसे पहुँचता है।"}},"ar":{"stringUnit":{"state":"translated","value":"اختر أين يعمل Gateway وكيف يصل إليه تطبيق Mac هذا."}},"it":{"stringUnit":{"state":"translated","value":"Scegli dove viene eseguito il Gateway e in che modo questa app per Mac lo raggiunge."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway’in nerede çalışacağını ve bu Mac uygulamasının ona nasıl ulaşacağını seçin."}},"uk":{"stringUnit":{"state":"translated","value":"Виберіть, де працює Gateway і як ця програма для Mac підключається до нього."}},"id":{"stringUnit":{"state":"translated","value":"Pilih tempat Gateway berjalan dan cara app Mac ini menjangkaunya."}},"pl":{"stringUnit":{"state":"translated","value":"Wybierz, gdzie działa Gateway i jak ta aplikacja na Maca ma się z nim łączyć."}},"th":{"stringUnit":{"state":"translated","value":"เลือกตำแหน่งที่ Gateway ทำงานและวิธีที่แอป Mac นี้เข้าถึง"}},"vi":{"stringUnit":{"state":"translated","value":"Chọn nơi Gateway chạy và cách ứng dụng Mac này truy cập Gateway."}},"nl":{"stringUnit":{"state":"translated","value":"Kies waar de Gateway draait en hoe deze Mac-app deze bereikt."}},"fa":{"stringUnit":{"state":"translated","value":"انتخاب کنید Gateway کجا اجرا شود و این برنامه Mac چگونه به آن دسترسی پیدا کند."}},"ru":{"stringUnit":{"state":"translated","value":"Выберите, где работает Gateway и как это приложение для Mac подключается к нему."}},"sv":{"stringUnit":{"state":"translated","value":"Välj var Gateway körs och hur den här Mac-appen når den."}}}},
