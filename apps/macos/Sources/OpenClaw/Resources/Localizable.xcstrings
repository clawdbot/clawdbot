    "Click a discovered gateway to fill the SSH target.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Click a discovered gateway to fill the SSH target."}},"zh-CN":{"stringUnit":{"state":"translated","value":"点击已发现的 Gateway 以填入 SSH 目标。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"按一下已探索到的 Gateway 以填入 SSH 目標。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Clique em um gateway descoberto para preencher o destino SSH."}},"de":{"stringUnit":{"state":"translated","value":"Klicken Sie auf ein erkanntes Gateway, um das SSH-Ziel einzutragen."}},"es":{"stringUnit":{"state":"translated","value":"Haz clic en un Gateway detectado para completar el destino SSH."}},"ja-JP":{"stringUnit":{"state":"translated","value":"検出された Gateway をクリックすると SSH 接続先が入力されます。"}},"ko":{"stringUnit":{"state":"translated","value":"검색된 Gateway를 클릭하여 SSH 대상을 입력하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Cliquez sur un Gateway détecté pour renseigner la cible SSH."}},"hi":{"stringUnit":{"state":"translated","value":"SSH लक्ष्य भरने के लिए खोजे गए Gateway पर क्लिक करें."}},"ar":{"stringUnit":{"state":"translated","value":"انقر على بوابة مكتشفة لملء حقل وجهة SSH."}},"it":{"stringUnit":{"state":"translated","value":"Fai clic su un gateway rilevato per compilare la destinazione SSH."}},"tr":{"stringUnit":{"state":"translated","value":"SSH hedefini doldurmak için keşfedilen bir Gateway'e tıklayın."}},"uk":{"stringUnit":{"state":"translated","value":"Натисніть знайдений шлюз, щоб заповнити ціль SSH."}},"id":{"stringUnit":{"state":"translated","value":"Klik Gateway yang ditemukan untuk mengisi target SSH."}},"pl":{"stringUnit":{"state":"translated","value":"Kliknij wykryty Gateway, aby uzupełnić adres docelowy SSH."}},"th":{"stringUnit":{"state":"translated","value":"คลิก Gateway ที่ค้นพบเพื่อกรอกปลายทาง SSH."}},"vi":{"stringUnit":{"state":"translated","value":"Nhấp vào một Gateway đã phát hiện để điền đích SSH."}},"nl":{"stringUnit":{"state":"translated",