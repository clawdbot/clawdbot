    "Recheck macOS after approving access in System Settings.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recheck macOS after approving access in System Settings."}},"zh-CN":{"stringUnit":{"state":"translated","value":"在系统设置中批准访问后，重新检查 macOS。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"在「系統設定」中核准存取權限後，重新檢查 macOS。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Verifique novamente o macOS após aprovar o acesso nos Ajustes do Sistema."}},"de":{"stringUnit":{"state":"translated","value":"macOS erneut prüfen, nachdem der Zugriff in den Systemeinstellungen genehmigt wurde."}},"es":{"stringUnit":{"state":"translated","value":"Vuelve a comprobar macOS después de autorizar el acceso en Ajustes del Sistema."}},"ja-JP":{"stringUnit":{"state":"translated","value":"システム設定でアクセスを許可した後、macOSを再確認してください。"}},"ko":{"stringUnit":{"state":"translated","value":"시스템 설정에서 접근을 허용한 후 macOS를 다시 확인하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Vérifiez à nouveau macOS après avoir autorisé l’accès dans les Réglages Système."}},"hi":{"stringUnit":{"state":"translated","value":"सिस्टम सेटिंग्स में ऐक्सेस की अनुमति देने के बाद macOS की दोबारा जाँच करें."}},"ar":{"stringUnit":{"state":"translated","value":"أعِد التحقق من macOS بعد الموافقة على الوصول في إعدادات النظام."}},"it":{"stringUnit":{"state":"translated","value":"Verifica di nuovo macOS dopo aver autorizzato l'accesso nelle Impostazioni di Sistema."}},"tr":{"stringUnit":{"state":"translated","value":"Sistem Ayarları'nda erişimi onayladıktan sonra macOS'i yeniden kontrol edin."}},"uk":{"stringUnit":{"state":"translated","value":"Повторно перевірте macOS після надання доступу в Системних параметрах."}},"id":{"stringUnit":{"state":"translated","value":"Periksa ulang macOS setelah menyetujui akses di Pengaturan Sistem."}},"pl":{"stringUnit":{"state":"translated","value":"Sprawdź ponownie macOS po zatwierdzeniu dostępu w Ustawieniach systemowych."}},"th":{"stringUnit":{"state":"translated"