    "No Chrome, Brave, Edge, or Chromium profile with cookies was found on this Mac.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No Chrome, Brave, Edge, or Chromium profile with cookies was found on this Mac."}},"zh-CN":{"stringUnit":{"state":"translated","value":"在此 Mac 上未找到包含 Cookie 的 Chrome、Brave、Edge 或 Chromium 配置文件。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"在這台 Mac 上找不到含有 Cookie 的 Chrome, Brave, Edge 或 Chromium 設定檔。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Nenhum perfil do Chrome, Brave, Edge ou Chromium com cookies foi encontrado neste Mac."}},"de":{"stringUnit":{"state":"translated","value":"Auf diesem Mac wurde kein Chrome-, Brave-, Edge- oder Chromium-Profil mit Cookies gefunden."}},"es":{"stringUnit":{"state":"translated","value":"No se encontró ningún perfil de Chrome, Brave, Edge o Chromium con cookies en este Mac."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このMacには、Cookieを含むChrome、Brave、Edge、Chromiumのプロファイルが見つかりませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"이 Mac에서 쿠키가 있는 Chrome, Brave, Edge 또는 Chromium 프로필을 찾을 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Aucun profil Chrome, Brave, Edge ou Chromium contenant des cookies n’a été trouvé sur ce Mac."}},"hi":{"stringUnit":{"state":"translated","value":"इस Mac पर कुकीज़ वाली कोई Chrome, Brave, Edge, या Chromium प्रोफ़ाइल नहीं मिली."}},"ar":{"stringUnit":{"state":"translated","value":"لم يُعثر على ملف شخصي في Chrome أو Brave أو Edge أو Chromium يحتوي على ملفات تعريف ارتباط على جهاز Mac هذا."}},"it":{"stringUnit":{"state":"translated","value":"Su questo Mac non è stato trovato alcun profilo Chrome, Brave, Edge o Chromium con cookie."}},"tr":{"stringUnit":{"state":"translated","value":"Bu Mac'te çerez içeren Chrome, Brave, Edge veya Chromium profili bulunamadı."}},"uk":{"stringUnit":{"state":"translated","value":"На цьому Mac не знайдено профілю Chrome, Brave, Edge або Chromium із файлами cookie."}},"id":{"stringUn