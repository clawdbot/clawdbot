    "Allow OpenClaw to read text from %@": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allow OpenClaw to read text from %@"}},"zh-CN":{"stringUnit":{"state":"translated","value":"允许 OpenClaw 从 %@ 读取文本"}},"zh-TW":{"stringUnit":{"state":"translated","value":"允許 OpenClaw 讀取 %@ 中的文字"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Permitir que o OpenClaw leia texto de %@"}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw erlauben, Text aus %@ zu lesen"}},"es":{"stringUnit":{"state":"translated","value":"Permitir que OpenClaw lea texto de %@"}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClawによる%@からのテキストの読み取りを許可"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw가 %@에서 텍스트를 읽도록 허용"}},"fr":{"stringUnit":{"state":"translated","value":"Autoriser OpenClaw à lire le texte de %@"}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw को %@ से टेक्स्ट पढ़ने की अनुमति दें"}},"ar":{"stringUnit":{"state":"translated","value":"السماح لـ OpenClaw بقراءة النص من %@"}},"it":{"stringUnit":{"state":"translated","value":"Consenti a OpenClaw di leggere il testo da %@"}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw'un %@ kaynağından metin okumasına izin ver"}},"uk":{"stringUnit":{"state":"translated","value":"Дозволити OpenClaw читати текст із %@"}},"id":{"stringUnit":{"state":"translated","value":"Izinkan OpenClaw membaca teks dari %@"}},"pl":{"stringUnit":{"state":"translated","value":"Zezwól OpenClaw na odczytywanie tekstu z %@"}},"th":{"stringUnit":{"state":"translated","value":"อนุญาตให้ OpenClaw อ่านข้อความจาก %@"}},"vi":{"stringUnit":{"state":"translated","value":"Cho phép OpenClaw đọc văn bản từ %@"}},"nl":{"stringUnit":{"state":"translated","value":"OpenClaw toestaan tekst uit %@ te lezen"}},"fa":{"stringUnit":{"state":"translated","value":"به OpenClaw اجازه بده متن را از %@ بخواند"}},"ru":{"stringUnit":{"state":"translated","value":"Разрешить OpenClaw читать текст из %@"}},"sv":{"stringUnit":{"state":"translated","value":"Tillåt OpenClaw att läsa text från %@"}}}},
    "Allow Voice Wake, push-to-talk, Talk Mode, and Quick Chat dictation": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allow Voice Wake, push-to-talk, Talk Mode, and Quick Chat dictation"}},"zh-CN":{"stringUnit":{"state":"translated","value":"允许使用语音唤醒、按住说话、对话模式和快捷聊天听写"}},"zh-TW":{"stringUnit":{"state":"translated","value":"允許語音喚醒、按住說話、對話模式及快速聊天聽寫"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Permitir ativação por voz, pressionar para falar, modo de conversa e ditado no chat rápido"}},"de":{"stringUnit":{"state":"translated","value":"Sprachaktivierung, Push-to-Talk, Sprachmodus und Diktieren im Schnellchat erlauben"}},"es":{"stringUnit":{"state":"translated","value":"Permitir la activación por voz, pulsar para hablar, el modo de conversación y el dictado en el chat rápido"}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声起動、プッシュトゥトーク、トークモード、クイックチャットの音声入力を許可"}},"ko":{"stringUnit":{"state":"translated","value":"음성 깨우기, 눌러서 말하기, 대화 모드 및 빠른 채팅 받아쓰기 허용"}},"fr":{"stringUnit":{"state":"translated","value":"Autoriser l’activation vocale, l’appui pour parler, le mode conversation et la dictée dans le chat rapide"}},"hi":{"stringUnit":{"state":"translated","value":"आवाज़ से सक्रिय करने, पुश-टू-टॉक, बातचीत मोड, और त्वरित चैट में बोलकर लिखने की अनुमति दें"}},"ar":{"stringUnit":{"state":"translated","value":"السماح بالتنشيط الصوتي، والضغط للتحدث، ووضع التحدث، والإملاء في الدردشة السريعة"}},"it":{"stringUnit":{"state":"translated","value":"Consenti l'attivazione vocale, la funzione premi per parlare, la modalità conversazione e la dettatura nella chat rapida"}},"tr":{"stringUnit":{"state":"translated","value":"Sesle Uyandırma, bas-konuş, Konuşma Modu ve Hızlı Sohbet diktesine izin ver"}},"uk":{"stringUnit":{"state":"translated","value":"Дозволити голосову активацію, розмову після натискання, режим розмови та диктування у швидкому чаті"}},"id":{"stringUnit":{"state":"translated","value":"Izinkan Aktivasi Suara, tekan-untuk-bicara, Mode Bicara, dan dikte Obrolan Cepat"}},"pl":{"stringUnit":{"state":"translated","value":"Zezwól na wybudzanie głosem, mówienie po naciśnięciu przycisku, tryb rozmowy i dyktowanie w szybkim czacie"}},"th":{"stringUnit":{"state":"translated","value":"อนุญาตให้ใช้การปลุกด้วยเสียง การกดเพื่อพูด โหมดสนทนา และการป้อนข้อความด้วยเสียงในแชตด่วน"}},"vi":{"stringUnit":{"state":"translated","value":"Cho phép đánh thức bằng giọng nói, nhấn để nói, chế độ trò chuyện bằng giọng nói và nhập bằng giọng nói trong trò chuyện nhanh"}},"nl":{"stringUnit":{"state":"translated","value":"Spraakactivering, indrukken om te praten, Praatmodus en dicteren in Snelle Chat toestaan"}},"fa":{"stringUnit":{"state":"translated","value":"اجازهٔ فعال‌سازی با صدا، فشردن برای صحبت، حالت مکالمه و دیکته در گفتگوی سریع"}},"ru":{"stringUnit":{"state":"translated","value":"Разрешить голосовую активацию, передачу голоса по нажатию, режим разговора и диктовку в быстром чате"}},"sv":{"stringUnit":{"state":"translated","value":"Tillåt röstaktivering, tryck-för-att-tala, samtalsläge och diktering i snabbchatten"}}}},
    "Allow agents to use device location when a tool asks for it.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allow agents to use device location when a tool asks for it."}},"zh-CN":{"stringUnit":{"state":"translated","value":"允许智能体在工具请求时使用设备位置。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"允許代理程式在工具要求時使用裝置位置。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Permitir que os agentes usem a localização do dispositivo quando uma ferramenta a solicitar."}},"de":{"stringUnit":{"state":"translated","value":"Agenten erlauben, den Gerätestandort zu verwenden, wenn ein Tool ihn anfordert."}},"es":{"stringUnit":{"state":"translated","value":"Permitir que los agentes usen la ubicación del dispositivo cuando una herramienta la solicite."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ツールから要求があったときに、エージェントがデバイスの位置情報を使用することを許可します。"}},"ko":{"stringUnit":{"state":"translated","value":"도구에서 요청할 때 에이전트가 기기 위치를 사용하도록 허용합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Autoriser les agents à utiliser la localisation de l’appareil lorsqu’un outil la demande."}},"hi":{"stringUnit":{"state":"translated","value":"किसी टूल के अनुरोध करने पर एजेंटों को डिवाइस की लोकेशन इस्तेमाल करने की अनुमति दें."}},"ar":{"stringUnit":{"state":"translated","value":"السماح للوكلاء باستخدام موقع الجهاز عندما تطلبه إحدى الأدوات."}},"it":{"stringUnit":{"state":"translated","value":"Consenti agli agenti di usare la posizione del dispositivo quando uno strumento la richiede."}},"tr":{"stringUnit":{"state":"translated","value":"Bir araç istediğinde ajanların cihaz konumunu kullanmasına izin ver."}},"uk":{"stringUnit":{"state":"translated","value":"Дозволити агентам використовувати розташування пристрою, коли інструмент запитує його."}},"id":{"stringUnit":{"state":"translated","value":"Izinkan agen menggunakan lokasi perangkat saat alat memintanya."}},"pl":{"stringUnit":{"state":"translated","value":"Zezwól agentom na korzystanie z lokalizacji urządzenia, gdy narzędzie o nią poprosi."}},"th":{"stringUnit":{"state":"translated","value":"อนุญาตให้เอเจนต์ใช้ตำแหน่งของอุปกรณ์เมื่อเครื่องมือร้องขอ."}},"vi":{"stringUnit":{"state":"translated","value":"Cho phép tác nhân sử dụng vị trí thiết bị khi một công cụ yêu cầu."}},"nl":{"stringUnit":{"state":"translated","value":"Agents toestaan de apparaatlocatie te gebruiken wanneer een tool daarom vraagt."}},"fa":{"stringUnit":{"state":"translated","value":"به عامل‌ها اجازه بده وقتی ابزاری موقعیت مکانی دستگاه را درخواست می‌کند، از آن استفاده کنند."}},"ru":{"stringUnit":{"state":"translated","value":"Разрешить агентам использовать местоположение устройства по запросу инструмента."}},"sv":{"stringUnit":{"state":"translated","value":"Tillåt agenter att använda enhetens plats när ett verktyg begär det."}}}},
    "Allow once": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allow once"}},"zh-CN":{"stringUnit":{"state":"translated","value":"允许一次"}},"zh-TW":{"stringUnit":{"state":"translated","value":"允許一次"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Permitir uma vez"}},"de":{"stringUnit":{"state":"translated","value":"Einmal erlauben"}},"es":{"stringUnit":{"state":"translated","value":"Permitir una vez"}},"ja-JP":{"stringUnit":{"state":"translated","value":"今回のみ許可"}},"ko":{"stringUnit":{"state":"translated","value":"한 번 허용"}},"fr":{"stringUnit":{"state":"translated","value":"Autoriser une fois"}},"hi":{"stringUnit":{"state":"translated","value":"एक बार अनुमति दें"}},"ar":{"stringUnit":{"state":"translated","value":"السماح مرة واحدة"}},"it":{"stringUnit":{"state":"translated","value":"Consenti una volta"}},"tr":{"stringUnit":{"state":"translated","value":"Bir kez izin ver"}},"uk":{"stringUnit":{"state":"translated","value":"Дозволити один раз"}},"id":{"stringUnit":{"state":"translated","value":"Izinkan sekali"}},"pl":{"stringUnit":{"state":"translated","value":"Zezwól raz"}},"th":{"stringUnit":{"state":"translated","value":"อนุญาตครั้งเดียว"}},"vi":{"stringUnit":{"state":"translated","value":"Cho phép một lần"}},"nl":{"stringUnit":{"state":"translated","value":"Eenmalig toestaan"}},"fa":{"stringUnit":{"state":"translated","value":"یک بار اجازه بده"}},"ru":{"stringUnit":{"state":"translated","value":"Разрешить один раз"}},"sv":{"stringUnit":{"state":"translated","value":"Tillåt en gång"}}}},
    "Allow only this request (⌘Return)": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allow only this request (⌘Return)"}},"zh-CN":{"stringUnit":{"state":"translated","value":"仅允许此次请求（⌘Return）"}},"zh-TW":{"stringUnit":{"state":"translated","value":"僅允許此次請求（⌘Return）"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Permitir apenas esta solicitação (⌘Return)"}},"de":{"stringUnit":{"state":"translated","value":"Nur diese Anfrage erlauben (⌘Return)"}},"es":{"stringUnit":{"state":"translated","value":"Permitir solo esta solicitud (⌘Return)"}},"ja-JP":{"stringUnit":{"state":"translated","value":"このリクエストのみ許可（⌘Return）"}},"ko":{"stringUnit":{"state":"translated","value":"이번 요청만 허용 (⌘Return)"}},"fr":{"stringUnit":{"state":"translated","value":"Autoriser uniquement cette requête (⌘Retour)"}},"hi":{"stringUnit":{"state":"translated","value":"केवल इस अनुरोध की अनुमति दें (⌘Return)"}},"ar":{"stringUnit":{"state":"translated","value":"السماح بهذا الطلب فقط (⌘Return)"}},"it":{"stringUnit":{"state":"translated","value":"Consenti solo questa richiesta (⌘Invio)"}},"tr":{"stringUnit":{"state":"translated","value":"Yalnızca bu isteğe izin ver (⌘Return)"}},"uk":{"stringUnit":{"state":"translated","value":"Дозволити лише цей запит (⌘Return)"}},"id":{"stringUnit":{"state":"translated","value":"Izinkan hanya permintaan ini (⌘Return)"}},"pl":{"stringUnit":{"state":"translated","value":"Zezwól tylko na to żądanie (⌘Return)"}},"th":{"stringUnit":{"state":"translated","value":"อนุญาตเฉพาะคำขอนี้ (⌘Return)"}},"vi":{"stringUnit":{"state":"translated","value":"Chỉ cho phép yêu cầu này (⌘Return)"}},"nl":{"stringUnit":{"state":"translated","value":"Alleen dit verzoek toestaan (⌘Return)"}},"fa":{"stringUnit":{"state":"translated","value":"اجازه فقط برای این درخواست (⌘Return)"}},"ru":{"stringUnit":{"state":"translated","value":"Разрешить только этот запрос (⌘Return)"}},"sv":{"stringUnit":{"state":"translated","value":"Tillåt endast denna begäran (⌘Return)"}}}},
    "Allow shell commands without checking the allowlist.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allow shell commands without checking the allowlist."}},"zh-CN":{"stringUnit":{"state":"translated","value":"允许执行 shell 命令，无需检查允许列表。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"允許執行 shell 命令而不檢查允許清單。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Permitir comandos de shell sem verificar a lista de permissões."}},"de":{"stringUnit":{"state":"translated","value":"Shell-Befehle ohne Prüfung der Zulassungsliste erlauben."}},"es":{"stringUnit":{"state":"translated","value":"Permitir comandos de shell sin comprobar la lista de permitidos."}},"ja-JP":{"stringUnit":{"state":"translated","value":"許可リストを確認せずにシェルコマンドを実行することを許可します。"}},"ko":{"stringUnit":{"state":"translated","value":"허용 목록을 확인하지 않고 셸 명령어를 허용합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Autoriser les commandes shell sans vérifier la liste d’autorisation."}},"hi":{"stringUnit":{"state":"translated","value":"अनुमति सूची की जाँच किए बिना शेल कमांड चलाने की अनुमति दें."}},"ar":{"stringUnit":{"state":"translated","value":"السماح بأوامر الصدفة دون التحقق من قائمة السماح."}},"it":{"stringUnit":{"state":"translated","value":"Consenti i comandi shell senza verificare l'elenco di quelli consentiti."}},"tr":{"stringUnit":{"state":"translated","value":"İzin listesini kontrol etmeden kabuk komutlarına izin ver."}},"uk":{"stringUnit":{"state":"translated","value":"Дозволити команди оболонки без перевірки списку дозволених."}},"id":{"stringUnit":{"state":"translated","value":"Izinkan perintah shell tanpa memeriksa daftar izin."}},"pl":{"stringUnit":{"state":"translated","value":"Zezwól na polecenia powłoki bez sprawdzania listy dozwolonych."}},"th":{"stringUnit":{"state":"translated","value":"อนุญาตคำสั่งเชลล์โดยไม่ตรวจสอบรายการที่อนุญาต."}},"vi":{"stringUnit":{"state":"translated","value":"Cho phép các lệnh shell mà không kiểm tra danh sách cho phép."}},"nl":{"stringUnit":{"state":"translated","value":"Shellopdrachten toestaan zonder de lijst met toegestane opdrachten te controleren."}},"fa":{"stringUnit":{"state":"translated","value":"اجازهٔ اجرای فرمان‌های پوسته بدون بررسی فهرست مجاز."}},"ru":{"stringUnit":{"state":"translated","value":"Разрешить команды оболочки без проверки списка разрешённых."}},"sv":{"stringUnit":{"state":"translated","value":"Tillåt skalkommandon utan att kontrollera tillåtelselistan."}}}},
    "Allow signed tools (e.g. `peekaboo`) to drive UI automation via PeekabooBridge. Requires Computer Control; otherwise run Peekaboo's own Mac app.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allow signed tools (e.g. `peekaboo`) to drive UI automation via PeekabooBridge. Requires Computer Control; otherwise run Peekaboo's own Mac app."}},"zh-CN":{"stringUnit":{"state":"translated","value":"允许已签名的工具（例如 `peekaboo`）通过 PeekabooBridge 驱动 UI 自动化。需要电脑控制权限；否则请运行 Peekaboo 自己的 Mac 应用。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"允許已簽署的工具（例如 `peekaboo`）透過 PeekabooBridge 執行 UI 自動化。需要電腦控制權限；否則請執行 Peekaboo 自己的 Mac 應用程式。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Permitir que ferramentas assinadas (por exemplo, `peekaboo`) executem automação da interface via PeekabooBridge. Requer Controle do Computador; caso contrário, execute o próprio app do Peekaboo para Mac."}},"de":{"stringUnit":{"state":"translated","value":"Signierten Tools (z. B. `peekaboo`) erlauben, die UI-Automatisierung über PeekabooBridge zu steuern. Erfordert Computersteuerung; andernfalls die eigene Mac-App von Peekaboo ausführen."}},"es":{"stringUnit":{"state":"translated","value":"Permitir que las herramientas firmadas (p. ej. `peekaboo`) automaticen la interfaz mediante PeekabooBridge. Requiere Control del Ordenador; de lo contrario, ejecuta la aplicación de Peekaboo para Mac."}},"ja-JP":{"stringUnit":{"state":"translated","value":"署名済みツール（例: `peekaboo`）がPeekabooBridge経由でUIを自動操作することを許可します。コンピュータの操作権限が必要です。権限がない場合は、Peekaboo自体のMacアプリを実行してください。"}},"ko":{"stringUnit":{"state":"translated","value":"서명된 도구(예: `peekaboo`)가 PeekabooBridge를 통해 UI 자동화를 수행하도록 허용합니다. 컴퓨터 제어 권한이 필요하며, 권한이 없으면 Peekaboo의 자체 Mac 앱을 실행하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Autoriser les outils signés (par exemple `peekaboo`) à piloter l’automatisation de l’interface via PeekabooBridge. Nécessite le contrôle de l’ordinateur ; sinon, utilisez l’application Mac de Peekaboo."}},"hi":{"stringUnit":{"state":"translated","value":"हस्ताक्षरित टूल (जैसे `peekaboo`) को PeekabooBridge के ज़रिए UI ऑटोमेशन संचालित करने की अनुमति दें. कंप्यूटर नियंत्रण आवश्यक है; अन्यथा Peekaboo का अपना Mac ऐप चलाएँ."}},"ar":{"stringUnit":{"state":"translated","value":"السماح للأدوات الموقّعة (مثل `peekaboo`) بأتمتة واجهة المستخدم عبر PeekabooBridge. يتطلب ذلك التحكم في الكمبيوتر؛ وإلا فشغّل تطبيق Peekaboo الخاص على Mac."}},"it":{"stringUnit":{"state":"translated","value":"Consenti agli strumenti firmati (ad es. `peekaboo`) di gestire l'automazione dell'interfaccia tramite PeekabooBridge. Richiede il controllo del computer; in alternativa, esegui l'app Mac di Peekaboo."}},"tr":{"stringUnit":{"state":"translated","value":"İmzalı araçların (ör. `peekaboo`) PeekabooBridge üzerinden kullanıcı arayüzü otomasyonunu yönetmesine izin ver. Bilgisayar Denetimi gerektirir; aksi takdirde Peekaboo'nun kendi Mac uygulamasını çalıştırın."}},"uk":{"stringUnit":{"state":"translated","value":"Дозволити підписаним інструментам (наприклад, `peekaboo`) автоматизувати дії в інтерфейсі через PeekabooBridge. Потрібен дозвіл на керування комп’ютером; інакше запустіть власний застосунок Peekaboo для Mac."}},"id":{"stringUnit":{"state":"translated","value":"Izinkan alat yang ditandatangani (mis. `peekaboo`) menjalankan otomatisasi UI melalui PeekabooBridge. Memerlukan Kontrol Komputer; jika tidak, jalankan aplikasi Mac milik Peekaboo."}},"pl":{"stringUnit":{"state":"translated","value":"Zezwól podpisanym narzędziom (np. `peekaboo`) na automatyzację interfejsu za pośrednictwem PeekabooBridge. Wymaga uprawnienia do sterowania komputerem; w przeciwnym razie uruchom aplikację Peekaboo na Maca."}},"th":{"stringUnit":{"state":"translated","value":"อนุญาตให้เครื่องมือที่ลงลายเซ็นแล้ว (เช่น `peekaboo`) ควบคุม UI โดยอัตโนมัติผ่าน PeekabooBridge. ต้องได้รับอนุญาตให้ควบคุมคอมพิวเตอร์; หากไม่ได้รับอนุญาต ให้เรียกใช้แอป Mac ของ Peekaboo เอง."}},"vi":{"stringUnit":{"state":"translated","value":"Cho phép các công cụ đã ký (ví dụ: `peekaboo`) tự động hóa giao diện qua PeekabooBridge. Yêu cầu quyền điều khiển máy tính; nếu không, hãy chạy ứng dụng Mac riêng của Peekaboo."}},"nl":{"stringUnit":{"state":"translated","value":"Ondertekende tools (bijv. `peekaboo`) toestaan UI-automatisering aan te sturen via PeekabooBridge. Vereist Computerbesturing; gebruik anders de eigen Mac-app van Peekaboo."}},"fa":{"stringUnit":{"state":"translated","value":"به ابزارهای امضاشده (مثلاً `peekaboo`) اجازه بده خودکارسازی رابط کاربری را از طریق PeekabooBridge کنترل کنند. به مجوز کنترل رایانه نیاز دارد؛ در غیر این صورت، برنامهٔ Mac خود Peekaboo را اجرا کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Разрешить подписанным инструментам (например, `peekaboo`) автоматизировать работу с интерфейсом через PeekabooBridge. Требуется разрешение на управление компьютером; в противном случае запустите собственное приложение Peekaboo для Mac."}},"sv":{"stringUnit":{"state":"translated","value":"Tillåt signerade verktyg (t.ex. `peekaboo`) att automatisera användargränssnittet via PeekabooBridge. Kräver datorstyrning; kör annars Peekaboos egen Mac-app."}}}},
    "Allow the agent to capture a photo or short video via the built-in camera.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allow the agent to capture a photo or short video via the built-in camera."}},"zh-CN":{"stringUnit":{"state":"translated","value":"允许智能体通过内置摄像头拍摄照片或短视频。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"允許代理程式透過內建相機拍攝照片或短片。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Permitir que o agente capture uma foto ou um vídeo curto usando a câmera integrada."}},"de":{"stringUnit":{"state":"translated","value":"Dem Agenten erlauben, mit der integrierten Kamera ein Foto oder ein kurzes Video aufzunehmen."}},"es":{"stringUnit":{"state":"translated","value":"Permitir que el agente tome una foto o grabe un vídeo corto con la cámara integrada."}},"ja-JP":{"stringUnit":{"state":"translated","value":"エージェントが内蔵カメラで写真や短い動画を撮影することを許可します。"}},"ko":{"stringUnit":{"state":"translated","value":"에이전트가 내장 카메라로 사진이나 짧은 동영상을 촬영하도록 허용합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Autoriser l’agent à prendre une photo ou à enregistrer une courte vidéo avec la caméra intégrée."}},"hi":{"stringUnit":{"state":"translated","value":"एजेंट को बिल्ट-इन कैमरे से फ़ोटो लेने या छोटा वीडियो रिकॉर्ड करने की अनुमति दें."}},"ar":{"stringUnit":{"state":"translated","value":"السماح للوكيل بالتقاط صورة أو فيديو قصير باستخدام الكاميرا المدمجة."}},"it":{"stringUnit":{"state":"translated","value":"Consenti all'agente di scattare una foto o registrare un breve video tramite la fotocamera integrata."}},"tr":{"stringUnit":{"state":"translated","value":"Ajanın dahili kamerayla fotoğraf veya kısa video çekmesine izin ver."}},"uk":{"stringUnit":{"state":"translated","value":"Дозволити агенту робити фото або записувати коротке відео за допомогою вбудованої камери."}},"id":{"stringUnit":{"state":"translated","value":"Izinkan agen mengambil foto atau video singkat melalui kamera bawaan."}},"pl":{"stringUnit":{"state":"translated","value":"Zezwól agentowi na robienie zdjęć lub nagrywanie krótkich filmów za pomocą wbudowanego aparatu."}},"th":{"stringUnit":{"state":"translated","value":"อนุญาตให้เอเจนต์ถ่ายภาพหรือวิดีโอสั้นผ่านกล้องในตัว."}},"vi":{"stringUnit":{"state":"translated","value":"Cho phép tác nhân chụp ảnh hoặc quay video ngắn bằng camera tích hợp."}},"nl":{"stringUnit":{"state":"translated","value":"De agent toestaan een foto of korte video te maken met de ingebouwde camera."}},"fa":{"stringUnit":{"state":"translated","value":"به عامل اجازه بده با دوربین داخلی عکس یا ویدیوی کوتاه بگیرد."}},"ru":{"stringUnit":{"state":"translated","value":"Разрешить агенту делать фотографии или снимать короткие видео с помощью встроенной камеры."}},"sv":{"stringUnit":{"state":"translated","value":"Tillåt agenten att ta ett foto eller spela in en kort video med den inbyggda kameran."}}}},
    "Allow the agent to show and control the Canvas panel.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allow the agent to show and control the Canvas panel."}},"zh-CN":{"stringUnit":{"state":"translated","value":"允许智能体显示并控制 Canvas 面板。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"允許代理程式顯示及控制 Canvas 面板。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Permitir que o agente exiba e controle o painel Canvas."}},"de":{"stringUnit":{"state":"translated","value":"Dem Agenten erlauben, das Canvas-Panel anzuzeigen und zu steuern."}},"es":{"stringUnit":{"state":"translated","value":"Permitir que el agente muestre y controle el panel Canvas."}},"ja-JP":{"stringUnit":{"state":"translated","value":"エージェントによるCanvasパネルの表示と操作を許可します。"}},"ko":{"stringUnit":{"state":"translated","value":"에이전트가 Canvas 패널을 표시하고 제어하도록 허용합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Autoriser l’agent à afficher et à contrôler le panneau Canvas."}},"hi":{"stringUnit":{"state":"translated","value":"एजेंट को Canvas पैनल दिखाने और नियंत्रित करने की अनुमति दें."}},"ar":{"stringUnit":{"state":"translated","value":"السماح للوكيل بعرض لوحة Canvas والتحكم فيها."}},"it":{"stringUnit":{"state":"translated","value":"Consenti all'agente di mostrare e controllare il pannello Canvas."}},"tr":{"stringUnit":{"state":"translated","value":"Ajanın Canvas panelini göstermesine ve kontrol etmesine izin verin."}},"uk":{"stringUnit":{"state":"translated","value":"Дозволити агенту показувати панель Canvas і керувати нею."}},"id":{"stringUnit":{"state":"translated","value":"Izinkan agen menampilkan dan mengontrol panel Canvas."}},"pl":{"stringUnit":{"state":"translated","value":"Zezwól agentowi na wyświetlanie i sterowanie panelem Canvas."}},"th":{"stringUnit":{"state":"translated","value":"อนุญาตให้เอเจนต์แสดงและควบคุมแผง Canvas."}},"vi":{"stringUnit":{"state":"translated","value":"Cho phép tác nhân hiển thị và điều khiển bảng Canvas."}},"nl":{"stringUnit":{"state":"translated","value":"Sta de agent toe het Canvas-paneel weer te geven en te bedienen."}},"fa":{"stringUnit":{"state":"translated","value":"به عامل اجازه دهید پنل Canvas را نمایش دهد و کنترل کند."}},"ru":{"stringUnit":{"state":"translated","value":"Разрешить агенту отображать панель Canvas и управлять ею."}},"sv":{"stringUnit":{"state":"translated","value":"Tillåt agenten att visa och styra Canvas-panelen."}}}},
    "Allow this command?": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allow this command?"}},"zh-CN":{"stringUnit":{"state":"translated","value":"允许此命令？"}},"zh-TW":{"stringUnit":{"state":"translated","value":"允許此命令？"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Permitir este comando?"}},"de":{"stringUnit":{"state":"translated","value":"Diesen Befehl erlauben?"}},"es":{"stringUnit":{"state":"translated","value":"¿Permitir este comando?"}},"ja-JP":{"stringUnit":{"state":"translated","value":"このコマンドを許可しますか？"}},"ko":{"stringUnit":{"state":"translated","value":"이 명령을 허용할까요?"}},"fr":{"stringUnit":{"state":"translated","value":"Autoriser cette commande ?"}},"hi":{"stringUnit":{"state":"translated","value":"इस कमांड की अनुमति दें?"}},"ar":{"stringUnit":{"state":"translated","value":"هل تريد السماح بهذا الأمر؟"}},"it":{"stringUnit":{"state":"translated","value":"Consentire questo comando?"}},"tr":{"stringUnit":{"state":"translated","value":"Bu komuta izin verilsin mi?"}},"uk":{"stringUnit":{"state":"translated","value":"Дозволити цю команду?"}},"id":{"stringUnit":{"state":"translated","value":"Izinkan perintah ini?"}},"pl":{"stringUnit":{"state":"translated","value":"Zezwolić na to polecenie?"}},"th":{"stringUnit":{"state":"translated","value":"อนุญาตคำสั่งนี้หรือไม่?"}},"vi":{"stringUnit":{"state":"translated","value":"Cho phép lệnh này?"}},"nl":{"stringUnit":{"state":"translated","value":"Deze opdracht toestaan?"}},"fa":{"stringUnit":{"state":"translated","value":"اجازه اجرای این فرمان داده شود؟"}},"ru":{"stringUnit":{"state":"translated","value":"Разрешить эту команду?"}},"sv":{"stringUnit":{"state":"translated","value":"Tillåt det här kommandot?"}}}},
