    "Give your assistant tasks and let it help across your Mac.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Give your assistant tasks and let it help across your Mac."}},"zh-CN":{"stringUnit":{"state":"translated","value":"向你的助手分配任务，让它在 Mac 上为你提供全方位帮助。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"將任務交給您的助理，讓它在您的 Mac 上提供各種協助。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Dê tarefas ao seu assistente e deixe que ele ajude em todo o seu Mac."}},"de":{"stringUnit":{"state":"translated","value":"Geben Sie Ihrem Assistenten Aufgaben und lassen Sie sich auf Ihrem gesamten Mac unterstützen."}},"es":{"stringUnit":{"state":"translated","value":"Asigna tareas a tu asistente y deja que te ayude en todo tu Mac."}},"ja-JP":{"stringUnit":{"state":"translated","value":"アシスタントにタスクを割り当て、Mac全体で作業をサポートしてもらいましょう。"}},"ko":{"stringUnit":{"state":"translated","value":"어시스턴트에게 작업을 맡기고 Mac 전반에서 도움을 받아 보세요."}},"fr":{"stringUnit":{"state":"translated","value":"Confiez des tâches à votre assistant et laissez-le vous aider sur votre Mac."}},"hi":{"stringUnit":{"state":"translated","value":"अपने सहायक को काम सौंपें और उसे अपने Mac पर आपकी मदद करने दें."}},"ar":{"stringUnit":{"state":"translated","value":"كلّف مساعدك بمهام ودعه يساعدك على جهاز Mac الخاص بك."}},"it":{"stringUnit":{"state":"translated","value":"Assegna attività al tuo assistente e lascia che ti aiuti in tutto il Mac."}},"tr":{"stringUnit":{"state":"translated","value":"Asistanınıza görevler verin ve Mac'inizin her yerinde size yardımcı olmasına izin verin."}},"uk":{"stringUnit":{"state":"translated","value":"Давайте своєму помічнику завдання, і він допомагатиме вам у роботі на Mac."}},"id":{"stringUnit":{"state":"translated","value":"Berikan tugas kepada asisten Anda dan biarkan asisten membantu berbagai aktivitas di Mac Anda."}},"pl":{"stringUnit":{"state":"translated","value":"Zlecaj zadania swojemu asystentowi i pozwól mu pomagać na całym Macu."}},"th":{"stringUnit":{"state":"transla