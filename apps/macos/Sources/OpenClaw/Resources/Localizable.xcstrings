    "SSH command details": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"SSH command details"}},"zh-CN":{"stringUnit":{"state":"translated","value":"SSH 命令详情"}},"zh-TW":{"stringUnit":{"state":"translated","value":"SSH 指令詳細資訊"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Detalhes do comando SSH"}},"de":{"stringUnit":{"state":"translated","value":"SSH-Befehlsdetails"}},"es":{"stringUnit":{"state":"translated","value":"Detalles del comando SSH"}},"ja-JP":{"stringUnit":{"state":"translated","value":"SSH コマンドの詳細"}},"ko":{"stringUnit":{"state":"translated","value":"SSH 명령어 세부 정보"}},"fr":{"stringUnit":{"state":"translated","value":"Détails de la commande SSH"}},"hi":{"stringUnit":{"state":"translated","value":"SSH कमांड का विवरण"}},"ar":{"stringUnit":{"state":"translated","value":"تفاصيل أمر SSH"}},"it":{"stringUnit":{"state":"translated","value":"Dettagli del comando SSH"}},"tr":{"stringUnit":{"state":"translated","value":"SSH komut ayrıntıları"}},"uk":{"stringUnit":{"state":"translated","value":"Подробиці команди SSH"}},"id":{"stringUnit":{"state":"translated","value":"Detail perintah SSH"}},"pl":{"stringUnit":{"state":"translated","value":"Szczegóły polecenia SSH"}},"th":{"stringUnit":{"state":"translated","value":"รายละเอียดคำสั่ง SSH"}},"vi":{"stringUnit":{"state":"translated","value":"Chi tiết lệnh SSH"}},"nl":{"stringUnit":{"state":"translated","value":"Details van SSH-opdracht"}},"fa":{"stringUnit":{"state":"translated","value":"جزئیات فرمان SSH"}},"ru":{"stringUnit":{"state":"translated","value":"Сведения о команде SSH"}},"sv":{"stringUnit":{"state":"translated","value":"Detaljer om SSH-kommandot"}}}},
    "SSH host key policy": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"SSH host key policy"}},"zh-CN":{"stringUnit":{"state":"translated","value":"SSH 主机密钥策略"}},"zh-TW":{"stringUnit":{"state":"translated","value":"SSH 主機金鑰政策"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Política de chave do host SSH"}},"de":{"stringUnit":{"state":"translated","value":"SSH-Hostschlüsselrichtlinie"}},"es":{"stringUnit":{"state":"translated","value":"Política de claves de host SSH"}},"ja-JP":{"stringUnit":{"state":"translated","value":"SSH ホストキーポリシー"}},"ko":{"stringUnit":{"state":"translated","value":"SSH 호스트 키 정책"}},"fr":{"stringUnit":{"state":"translated","value":"Politique relative aux clés d’hôte SSH"}},"hi":{"stringUnit":{"state":"translated","value":"SSH होस्ट कुंजी नीति"}},"ar":{"stringUnit":{"state":"translated","value":"سياسة مفتاح مضيف SSH"}},"it":{"stringUnit":{"state":"translated","value":"Criterio per le chiavi host SSH"}},"tr":{"stringUnit":{"state":"translated","value":"SSH ana makine anahtarı ilkesi"}},"uk":{"stringUnit":{"state":"translated","value":"Політика ключів хоста SSH"}},"id":{"stringUnit":{"state":"translated","value":"Kebijakan kunci host SSH"}},"pl":{"stringUnit":{"state":"translated","value":"Zasady dotyczące klucza hosta SSH"}},"th":{"stringUnit":{"state":"translated","value":"นโยบายคีย์โฮสต์ SSH"}},"vi":{"stringUnit":{"state":"translated","value":"Chính sách khóa máy chủ SSH"}},"nl":{"stringUnit":{"state":"translated","value":"Beleid voor SSH-hostsleutels"}},"fa":{"stringUnit":{"state":"translated","value":"خط‌مشی کلید میزبان SSH"}},"ru":{"stringUnit":{"state":"translated","value":"Политика ключей хоста SSH"}},"sv":{"stringUnit":{"state":"translated","value":"Policy för SSH-värdnycklar"}}}},
    "SSH keeps the Gateway private. Tailscale plus an SSH tunnel gives stable private access.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"SSH keeps the Gateway private. Tailscale plus an SSH tunnel gives stable private access."}},"zh-CN":{"stringUnit":{"state":"translated","value":"SSH 可让 Gateway 保持私密。Tailscale 配合 SSH 隧道可提供稳定的私密访问。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"SSH 可讓 Gateway 保持私密。Tailscale 搭配 SSH 通道可提供穩定的私密存取。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O SSH mantém o Gateway privado. O Tailscale com um túnel SSH oferece acesso privado estável."}},"de":{"stringUnit":{"state":"translated","value":"Mit SSH bleibt das Gateway privat. Tailscale bietet zusammen mit einem SSH-Tunnel einen stabilen privaten Zugriff."}},"es":{"stringUnit":{"state":"translated","value":"SSH mantiene el Gateway privado. Tailscale junto con un túnel SSH proporciona un acceso privado estable."}},"ja-JP":{"stringUnit":{"state":"translated","value":"SSHを使うとGatewayを非公開に保てます。TailscaleとSSHトンネルを組み合わせることで、安定したプライベートアクセスが可能になります。"}},"ko":{"stringUnit":{"state":"translated","value":"SSH는 Gateway를 비공개로 유지합니다. Tailscale과 SSH 터널을 함께 사용하면 안정적인 비공개 액세스가 가능합니다."}},"fr":{"stringUnit":{"state":"translated","value":"SSH maintient l’accès au Gateway privé. Tailscale associé à un tunnel SSH offre un accès privé stable."}},"hi":{"stringUnit":{"state":"translated","value":"SSH, Gateway को निजी रखता है। SSH टनल के साथ Tailscale स्थिर निजी पहुँच प्रदान करता है।"}},"ar":{"stringUnit":{"state":"translated","value":"يحافظ SSH على خصوصية Gateway. ويوفر Tailscale مع نفق SSH وصولًا خاصًا ومستقرًا."}},"it":{"stringUnit":{"state":"translated","value":"SSH mantiene privato il Gateway. Tailscale insieme a un tunnel SSH offre un accesso privato stabile."}},"tr":{"stringUnit":{"state":"translated","value":"SSH, Gateway'i dış erişime kapalı tutar. Tailscale ile bir SSH tüneli, kararlı ve özel erişim sağlar."}},"uk":{"stringUnit":{"state":"translated","value":"SSH забезпечує приватність Gateway. Tailscale разом із тунелем SSH забезпечує стабільний приватний доступ."}},"id":{"stringUnit":{"state":"translated","value":"SSH menjaga Gateway tetap privat. Tailscale yang dipadukan dengan terowongan SSH memberikan akses privat yang stabil."}},"pl":{"stringUnit":{"state":"translated","value":"SSH zapewnia prywatność Gateway. Tailscale wraz z tunelem SSH zapewnia stabilny, prywatny dostęp."}},"th":{"stringUnit":{"state":"translated","value":"SSH ช่วยให้ Gateway เป็นส่วนตัว การใช้ Tailscale ร่วมกับอุโมงค์ SSH ช่วยให้เข้าถึงแบบส่วนตัวได้อย่างเสถียร"}},"vi":{"stringUnit":{"state":"translated","value":"SSH giữ Gateway ở chế độ riêng tư. Tailscale kết hợp với đường hầm SSH cung cấp quyền truy cập riêng tư ổn định."}},"nl":{"stringUnit":{"state":"translated","value":"SSH houdt de Gateway privé. Tailscale in combinatie met een SSH-tunnel biedt stabiele privétoegang."}},"fa":{"stringUnit":{"state":"translated","value":"SSH، Gateway را خصوصی نگه می‌دارد. Tailscale به‌همراه یک تونل SSH، دسترسی خصوصی و پایدار فراهم می‌کند."}},"ru":{"stringUnit":{"state":"translated","value":"SSH защищает Gateway от публичного доступа. Tailscale в сочетании с SSH-туннелем обеспечивает стабильный приватный доступ."}},"sv":{"stringUnit":{"state":"translated","value":"SSH håller Gateway privat. Tailscale tillsammans med en SSH-tunnel ger stabil privat åtkomst."}}}},
    "SSH target": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"SSH target"}},"zh-CN":{"stringUnit":{"state":"translated","value":"SSH 目标"}},"zh-TW":{"stringUnit":{"state":"translated","value":"SSH 目標"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Destino SSH"}},"de":{"stringUnit":{"state":"translated","value":"SSH-Ziel"}},"es":{"stringUnit":{"state":"translated","value":"Destino SSH"}},"ja-JP":{"stringUnit":{"state":"translated","value":"SSH 接続先"}},"ko":{"stringUnit":{"state":"translated","value":"SSH 대상"}},"fr":{"stringUnit":{"state":"translated","value":"Cible SSH"}},"hi":{"stringUnit":{"state":"translated","value":"SSH लक्ष्य"}},"ar":{"stringUnit":{"state":"translated","value":"هدف SSH"}},"it":{"stringUnit":{"state":"translated","value":"Destinazione SSH"}},"tr":{"stringUnit":{"state":"translated","value":"SSH hedefi"}},"uk":{"stringUnit":{"state":"translated","value":"Ціль SSH"}},"id":{"stringUnit":{"state":"translated","value":"Target SSH"}},"pl":{"stringUnit":{"state":"translated","value":"Host docelowy SSH"}},"th":{"stringUnit":{"state":"translated","value":"ปลายทาง SSH"}},"vi":{"stringUnit":{"state":"translated","value":"Đích SSH"}},"nl":{"stringUnit":{"state":"translated","value":"SSH-doel"}},"fa":{"stringUnit":{"state":"translated","value":"مقصد SSH"}},"ru":{"stringUnit":{"state":"translated","value":"Целевой SSH-узел"}},"sv":{"stringUnit":{"state":"translated","value":"SSH-mål"}}}},
    "SSH tunnel": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"SSH tunnel"}},"zh-CN":{"stringUnit":{"state":"translated","value":"SSH 隧道"}},"zh-TW":{"stringUnit":{"state":"translated","value":"SSH 通道"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Túnel SSH"}},"de":{"stringUnit":{"state":"translated","value":"SSH-Tunnel"}},"es":{"stringUnit":{"state":"translated","value":"Túnel SSH"}},"ja-JP":{"stringUnit":{"state":"translated","value":"SSH トンネル"}},"ko":{"stringUnit":{"state":"translated","value":"SSH 터널"}},"fr":{"stringUnit":{"state":"translated","value":"Tunnel SSH"}},"hi":{"stringUnit":{"state":"translated","value":"SSH टनल"}},"ar":{"stringUnit":{"state":"translated","value":"نفق SSH"}},"it":{"stringUnit":{"state":"translated","value":"Tunnel SSH"}},"tr":{"stringUnit":{"state":"translated","value":"SSH tüneli"}},"uk":{"stringUnit":{"state":"translated","value":"Тунель SSH"}},"id":{"stringUnit":{"state":"translated","value":"Terowongan SSH"}},"pl":{"stringUnit":{"state":"translated","value":"Tunel SSH"}},"th":{"stringUnit":{"state":"translated","value":"ทันเนล SSH"}},"vi":{"stringUnit":{"state":"translated","value":"Đường hầm SSH"}},"nl":{"stringUnit":{"state":"translated","value":"SSH-tunnel"}},"fa":{"stringUnit":{"state":"translated","value":"تونل SSH"}},"ru":{"stringUnit":{"state":"translated","value":"SSH-туннель"}},"sv":{"stringUnit":{"state":"translated","value":"SSH-tunnel"}}}},
    "Save": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Save"}},"zh-CN":{"stringUnit":{"state":"translated","value":"保存"}},"zh-TW":{"stringUnit":{"state":"translated","value":"儲存"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Salvar"}},"de":{"stringUnit":{"state":"translated","value":"Speichern"}},"es":{"stringUnit":{"state":"translated","value":"Guardar"}},"ja-JP":{"stringUnit":{"state":"translated","value":"保存"}},"ko":{"stringUnit":{"state":"translated","value":"저장"}},"fr":{"stringUnit":{"state":"translated","value":"Enregistrer"}},"hi":{"stringUnit":{"state":"translated","value":"सहेजें"}},"ar":{"stringUnit":{"state":"translated","value":"حفظ"}},"it":{"stringUnit":{"state":"translated","value":"Salva"}},"tr":{"stringUnit":{"state":"translated","value":"Kaydet"}},"uk":{"stringUnit":{"state":"translated","value":"Зберегти"}},"id":{"stringUnit":{"state":"translated","value":"Simpan"}},"pl":{"stringUnit":{"state":"translated","value":"Zapisz"}},"th":{"stringUnit":{"state":"translated","value":"บันทึก"}},"vi":{"stringUnit":{"state":"translated","value":"Lưu"}},"nl":{"stringUnit":{"state":"translated","value":"Opslaan"}},"fa":{"stringUnit":{"state":"translated","value":"ذخیره"}},"ru":{"stringUnit":{"state":"translated","value":"Сохранить"}},"sv":{"stringUnit":{"state":"translated","value":"Spara"}}}},
    "Save Gateway connections for chat windows. The primary Gateway under Connection still owns Mac integrations and Talk Mode.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Save Gateway connections for chat windows. The primary Gateway under Connection still owns Mac integrations and Talk Mode."}},"zh-CN":{"stringUnit":{"state":"translated","value":"保存供聊天窗口使用的 Gateway 连接。“连接”下的主 Gateway 仍负责 Mac 集成和对话模式。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"儲存聊天視窗使用的 Gateway 連線。「連線」下的主要 Gateway 仍負責 Mac 整合與對話模式。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Salve conexões do Gateway para janelas de chat. O Gateway principal em Conexão continua responsável pelas integrações do Mac e pelo Modo de Conversa."}},"de":{"stringUnit":{"state":"translated","value":"Gateway-Verbindungen für Chatfenster speichern. Der primäre Gateway unter Verbindung ist weiterhin für Mac-Integrationen und den Sprachmodus zuständig."}},"es":{"stringUnit":{"state":"translated","value":"Guarda conexiones de Gateway para las ventanas de chat. El Gateway principal en Conexión sigue gestionando las integraciones de Mac y el Modo de conversación."}},"ja-JP":{"stringUnit":{"state":"translated","value":"チャットウィンドウ用の Gateway 接続を保存します。「接続」で設定されたプライマリ Gateway が引き続き Mac 連携とトークモードを管理します。"}},"ko":{"stringUnit":{"state":"translated","value":"채팅 창에서 사용할 Gateway 연결을 저장합니다. 연결 설정의 기본 Gateway가 계속 Mac 통합 및 대화 모드를 담당합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Enregistrez des connexions Gateway pour les fenêtres de discussion. Le Gateway principal sous Connexion reste responsable des intégrations Mac et du mode vocal."}},"hi":{"stringUnit":{"state":"translated","value":"चैट विंडो के लिए Gateway कनेक्शन सहेजें। कनेक्शन के अंतर्गत मौजूद प्राथमिक Gateway ही अब भी Mac एकीकरण और बातचीत मोड को नियंत्रित करता है।"}},"ar":{"stringUnit":{"state":"translated","value":"احفظ اتصالات Gateway لنوافذ الدردشة. يظل Gateway الأساسي ضمن الاتصال مسؤولًا عن تكاملات Mac ووضع التحدث."}},"it":{"stringUnit":{"state":"translated","value":"Salva le connessioni Gateway per le finestre di chat. Il Gateway principale nella sezione Connessione continua a gestire le integrazioni Mac e la modalità vocale."}},"tr":{"stringUnit":{"state":"translated","value":"Sohbet pencereleri için Gateway bağlantılarını kaydedin. Bağlantı altındaki birincil Gateway, Mac entegrasyonlarını ve Konuşma Modunu yönetmeye devam eder."}},"uk":{"stringUnit":{"state":"translated","value":"Зберігайте підключення Gateway для вікон чату. Основний Gateway у розділі «Підключення» й надалі керує інтеграціями Mac і режимом розмови."}},"id":{"stringUnit":{"state":"translated","value":"Simpan koneksi Gateway untuk jendela percakapan. Gateway utama di bagian Koneksi tetap menangani integrasi Mac dan Mode Bicara."}},"pl":{"stringUnit":{"state":"translated","value":"Zapisuj połączenia z Gateway dla okien czatu. Główny Gateway w sekcji Połączenie nadal obsługuje integracje z komputerem Mac i tryb rozmowy."}},"th":{"stringUnit":{"state":"translated","value":"บันทึกการเชื่อมต่อ Gateway สำหรับหน้าต่างแชท. Gateway หลักในส่วนการเชื่อมต่อยังคงจัดการการผสานการทำงานกับ Mac และโหมดสนทนา."}},"vi":{"stringUnit":{"state":"translated","value":"Lưu các kết nối Gateway cho cửa sổ trò chuyện. Gateway chính trong mục Kết nối vẫn quản lý các tích hợp Mac và Chế độ trò chuyện bằng giọng nói."}},"nl":{"stringUnit":{"state":"translated","value":"Sla Gateway-verbindingen op voor chatvensters. De primaire Gateway onder Verbinding blijft verantwoordelijk voor Mac-integraties en de gespreksmodus."}},"fa":{"stringUnit":{"state":"translated","value":"اتصال‌های Gateway را برای پنجره‌های گفتگو ذخیره کنید. Gateway اصلی در بخش اتصال همچنان مسئول یکپارچه‌سازی‌های Mac و حالت مکالمه است."}},"ru":{"stringUnit":{"state":"translated","value":"Сохраняйте подключения к Gateway для окон чата. Основной Gateway в разделе «Подключение» по-прежнему управляет интеграциями Mac и режимом разговора."}},"sv":{"stringUnit":{"state":"translated","value":"Spara Gateway-anslutningar för chattfönster. Den primära Gateway under Anslutning hanterar fortfarande Mac-integrationer och talläge."}}}},
    "Save a reusable approval for this execution": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Save a reusable approval for this execution"}},"zh-CN":{"stringUnit":{"state":"translated","value":"为此次执行保存可重复使用的批准"}},"zh-TW":{"stringUnit":{"state":"translated","value":"儲存可重複使用的核准，以供執行此指令"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Salvar uma aprovação reutilizável para esta execução"}},"de":{"stringUnit":{"state":"translated","value":"Eine wiederverwendbare Freigabe für diese Ausführung speichern"}},"es":{"stringUnit":{"state":"translated","value":"Guardar una aprobación reutilizable para esta ejecución"}},"ja-JP":{"stringUnit":{"state":"translated","value":"この実行に対する承認を再利用できるように保存"}},"ko":{"stringUnit":{"state":"translated","value":"이 실행에 대해 재사용 가능한 승인 저장"}},"fr":{"stringUnit":{"state":"translated","value":"Enregistrer une approbation réutilisable pour cette exécution"}},"hi":{"stringUnit":{"state":"translated","value":"इस निष्पादन के लिए दोबारा इस्तेमाल की जा सकने वाली स्वीकृति सहेजें"}},"ar":{"stringUnit":{"state":"translated","value":"حفظ موافقة قابلة لإعادة الاستخدام لهذا التنفيذ"}},"it":{"stringUnit":{"state":"translated","value":"Salva un'approvazione riutilizzabile per questa esecuzione"}},"tr":{"stringUnit":{"state":"translated","value":"Bu çalıştırma için yeniden kullanılabilir bir onay kaydet"}},"uk":{"stringUnit":{"state":"translated","value":"Зберегти схвалення для повторного використання під час цього виконання"}},"id":{"stringUnit":{"state":"translated","value":"Simpan persetujuan yang dapat digunakan kembali untuk eksekusi ini"}},"pl":{"stringUnit":{"state":"translated","value":"Zapisz zgodę wielokrotnego użytku dla tego wykonania"}},"th":{"stringUnit":{"state":"translated","value":"บันทึกการอนุมัติที่ใช้ซ้ำได้สำหรับการเรียกใช้นี้"}},"vi":{"stringUnit":{"state":"translated","value":"Lưu phê duyệt có thể tái sử dụng cho lần thực thi này"}},"nl":{"stringUnit":{"state":"translated","value":"Een herbruikbare goedkeuring opslaan voor deze uitvoering"}},"fa":{"stringUnit":{"state":"translated","value":"ذخیرهٔ تأییدیه‌ای قابل استفادهٔ مجدد برای این اجرا"}},"ru":{"stringUnit":{"state":"translated","value":"Сохранить разрешение для повторного выполнения"}},"sv":{"stringUnit":{"state":"translated","value":"Spara ett återanvändbart godkännande för den här körningen"}}}},
