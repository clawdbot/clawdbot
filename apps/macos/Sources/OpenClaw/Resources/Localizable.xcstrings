    "Cookie sync": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cookie sync"}},"zh-CN":{"stringUnit":{"state":"translated","value":"Cookie 同步"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Cookie 同步"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Sincronização de cookies"}},"de":{"stringUnit":{"state":"translated","value":"Cookie-Synchronisierung"}},"es":{"stringUnit":{"state":"translated","value":"Sincronización de cookies"}},"ja-JP":{"stringUnit":{"state":"translated","value":"Cookie同期"}},"ko":{"stringUnit":{"state":"translated","value":"쿠키 동기화"}},"fr":{"stringUnit":{"state":"translated","value":"Synchronisation des cookies"}},"hi":{"stringUnit":{"state":"translated","value":"कुकी सिंक"}},"ar":{"stringUnit":{"state":"translated","value":"مزامنة ملفات تعريف الارتباط"}},"it":{"stringUnit":{"state":"translated","value":"Sincronizzazione dei cookie"}},"tr":{"stringUnit":{"state":"translated","value":"Çerez eşitleme"}},"uk":{"stringUnit":{"state":"translated","value":"Синхронізація файлів cookie"}},"id":{"stringUnit":{"state":"translated","value":"Sinkronisasi cookie"}},"pl":{"stringUnit":{"state":"translated","value":"Synchronizacja plików cookie"}},"th":{"stringUnit":{"state":"translated","value":"การซิงค์คุกกี้"}},"vi":{"stringUnit":{"state":"translated","value":"Đồng bộ cookie"}},"nl":{"stringUnit":{"state":"translated","value":"Cookiesynchronisatie"}},"fa":{"stringUnit":{"state":"translated","value":"همگام‌سازی کوکی‌ها"}},"ru":{"stringUnit":{"state":"translated","value":"Синхронизация файлов cookie"}},"sv":{"stringUnit":{"state":"translated","value":"Cookiesynkronisering"}}}},
    "Cookie sync applies when OpenClaw runs on another computer (remote mode).": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cookie sync applies when OpenClaw runs on another computer (remote mode)."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Cookie 同步适用于 OpenClaw 在另一台计算机上运行的情况 (远程模式)."}},"zh-TW":{"stringUnit":{"state":"translated","value":"Cookie 同步適用於 OpenClaw 在另一部電腦上執行時 (遠端模式)。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A sincronização de cookies se aplica quando o OpenClaw é executado em outro computador (modo remoto)."}},"de":{"stringUnit":{"state":"translated","value":"Die Cookie-Synchronisierung greift, wenn OpenClaw auf einem anderen Computer ausgeführt wird (Remote-Modus)."}},"es":{"stringUnit":{"state":"translated","value":"La sincronización de cookies se aplica cuando OpenClaw se ejecuta en otro equipo (modo remoto)."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Cookie同期は、OpenClawが別のコンピュータで実行されている場合（リモートモード）に適用されます。"}},"ko":{"stringUnit":{"state":"translated","value":"쿠키 동기화는 OpenClaw가 다른 컴퓨터에서 실행될 때(원격 모드) 적용됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"La synchronisation des cookies s’applique lorsque OpenClaw s’exécute sur un autre ordinateur (mode distant)."}},"hi":{"stringUnit":{"state":"translated","value":"कुकी सिंक तब लागू होता है जब OpenClaw किसी दूसरे कंप्यूटर पर चलता है (रिमोट मोड)."}},"ar":{"stringUnit":{"state":"translated","value":"تنطبق مزامنة ملفات تعريف الارتباط عندما يعمل OpenClaw على كمبيوتر آخر (الوضع البعيد)."}},"it":{"stringUnit":{"state":"translated","value":"La sincronizzazione dei cookie si applica quando OpenClaw viene eseguito su un altro computer (modalità remota)."}},"tr":{"stringUnit":{"state":"translated","value":"Çerez eşitleme, OpenClaw başka bir bilgisayarda çalışırken (uzak mod) geçerlidir."}},"uk":{"stringUnit":{"state":"translated","value":"Синхронізація файлів cookie застосовується, коли OpenClaw працює на іншому комп’ютері (віддалений режим)."}},"id":{"stringUnit":{"state":"translated","value":"Sinkronisasi cookie berlaku saat OpenClaw berjalan di komputer lain (mode jarak jauh)."}},"pl":{"stringUnit":{"state":"translated","value":"Synchronizacja plików cookie ma zastosowanie, gdy OpenClaw działa na innym komputerze (tryb zdalny)."}},"th":{"stringUnit":{"state":"translated","value":"การซิงค์คุกกี้จะมีผลเมื่อ OpenClaw ทำงานบนคอมพิวเตอร์เครื่องอื่น (โหมดระยะไกล)."}},"vi":{"stringUnit":{"state":"translated","value":"Đồng bộ cookie áp dụng khi OpenClaw chạy trên máy tính khác (chế độ từ xa)."}},"nl":{"stringUnit":{"state":"translated","value":"Cookiesynchronisatie is van toepassing wanneer OpenClaw op een andere computer draait (externe modus)."}},"fa":{"stringUnit":{"state":"translated","value":"همگام‌سازی کوکی‌ها زمانی اعمال می‌شود که OpenClaw روی رایانه‌ای دیگر اجرا شود (حالت راه‌دور)."}},"ru":{"stringUnit":{"state":"translated","value":"Синхронизация файлов cookie применяется, когда OpenClaw работает на другом компьютере (удалённый режим)."}},"sv":{"stringUnit":{"state":"translated","value":"Cookiesynkronisering gäller när OpenClaw körs på en annan dator (fjärrläge)."}}}},
    "Cookies are only synced for these domains; an empty list means nothing is synced.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cookies are only synced for these domains; an empty list means nothing is synced."}},"zh-CN":{"stringUnit":{"state":"translated","value":"仅同步这些域名的 Cookie; 列表为空表示不进行任何同步。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"僅同步這些網域的 Cookie; 清單為空表示不會同步任何內容。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Os cookies são sincronizados apenas para estes domínios; uma lista vazia significa que nada é sincronizado."}},"de":{"stringUnit":{"state":"translated","value":"Cookies werden nur für diese Domains synchronisiert; eine leere Liste bedeutet, dass nichts synchronisiert wird."}},"es":{"stringUnit":{"state":"translated","value":"Las cookies solo se sincronizan para estos dominios; una lista vacía significa que no se sincroniza nada."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Cookie はこれらのドメインでのみ同期されます; リストが空の場合は何も同期されません。"}},"ko":{"stringUnit":{"state":"translated","value":"이 도메인의 쿠키만 동기화됩니다; 목록이 비어 있으면 아무것도 동기화되지 않습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les cookies sont synchronisés uniquement pour ces domaines ; une liste vide signifie qu’aucun cookie n’est synchronisé."}},"hi":{"stringUnit":{"state":"translated","value":"कुकीज़ केवल इन डोमेन के लिए सिंक की जाती हैं; खाली सूची का मतलब है कि कुछ भी सिंक नहीं किया जाता है."}},"ar":{"stringUnit":{"state":"translated","value":"تُزامَن ملفات تعريف الارتباط لهذه النطاقات فقط؛ وتعني القائمة الفارغة عدم مزامنة أي شيء."}},"it":{"stringUnit":{"state":"translated","value":"I cookie vengono sincronizzati solo per questi domini; un elenco vuoto significa che non viene sincronizzato nulla."}},"tr":{"stringUnit":{"state":"translated","value":"Çerezler yalnızca bu alan adları için eşitlenir; liste boşsa hiçbir şey eşitlenmez."}},"uk":{"stringUnit":{"state":"translated","value":"Файли cookie синхронізуються лише для цих доменів; порожній список означає, що нічого не синхронізується."}},"id":{"stringUnit":{"state":"translated","value":"Cookie hanya disinkronkan untuk domain ini; daftar kosong berarti tidak ada yang disinkronkan."}},"pl":{"stringUnit":{"state":"translated","value":"Pliki cookie są synchronizowane tylko dla tych domen; pusta lista oznacza, że nic nie jest synchronizowane."}},"th":{"stringUnit":{"state":"translated","value":"คุกกี้จะซิงค์เฉพาะโดเมนเหล่านี้เท่านั้น; รายการว่างหมายถึงไม่มีการซิงค์ใดๆ"}},"vi":{"stringUnit":{"state":"translated","value":"Cookie chỉ được đồng bộ cho các miền này; danh sách trống nghĩa là không có gì được đồng bộ."}},"nl":{"stringUnit":{"state":"translated","value":"Cookies worden alleen voor deze domeinen gesynchroniseerd; een lege lijst betekent dat er niets wordt gesynchroniseerd."}},"fa":{"stringUnit":{"state":"translated","value":"کوکی‌ها فقط برای این دامنه‌ها همگام‌سازی می‌شوند؛ فهرست خالی به این معناست که هیچ‌چیز همگام‌سازی نمی‌شود."}},"ru":{"stringUnit":{"state":"translated","value":"Файлы cookie синхронизируются только для этих доменов; пустой список означает, что ничего не синхронизируется."}},"sv":{"stringUnit":{"state":"translated","value":"Cookies synkroniseras endast för dessa domäner; en tom lista innebär att inget synkroniseras."}}}},
