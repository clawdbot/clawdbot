    "Disconnected (using System default)": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Disconnected (using System default)"}},"zh-CN":{"stringUnit":{"state":"translated","value":"已断开连接 (使用系统默认设置)"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已中斷連線 (使用系統預設值)"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Desconectado (usando o padrão do Sistema)"}},"de":{"stringUnit":{"state":"translated","value":"Nicht verbunden (Systemstandard wird verwendet)"}},"es":{"stringUnit":{"state":"translated","value":"Desconectado (usando la opción predeterminada del sistema)"}},"ja-JP":{"stringUnit":{"state":"translated","value":"未接続 (システムのデフォルトを使用)"}},"ko":{"stringUnit":{"state":"translated","value":"연결 해제됨 (시스템 기본값 사용 중)"}},"fr":{"stringUnit":{"state":"translated","value":"Déconnecté (utilisation du réglage par défaut du système)"}},"hi":{"stringUnit":{"state":"translated","value":"डिस्कनेक्ट किया गया (सिस्टम डिफ़ॉल्ट का उपयोग हो रहा है)"}},"ar":{"stringUnit":{"state":"translated","value":"غير متصل (باستخدام الإعداد الافتراضي للنظام)"}},"it":{"stringUnit":{"state":"translated","value":"Disconnesso (in uso l'impostazione predefinita di sistema)"}},"tr":{"stringUnit":{"state":"translated","value":"Bağlantı Kesildi (Sistem varsayılanı kullanılıyor)"}},"uk":{"stringUnit":{"state":"translated","value":"Від’єднано (використовуються системні налаштування за замовчуванням)"}},"id":{"stringUnit":{"state":"translated","value":"Terputus (menggunakan pengaturan default Sistem)"}},"pl":{"stringUnit":{"state":"translated","value":"Rozłączono (używane są domyślne ustawienia systemowe)"}},"th":{"stringUnit":{"state":"translated","value":"ไม่ได้เชื่อมต่อ (ใช้ค่าเริ่มต้นของระบบ)"}},"vi":{"stringUnit":{"state":"translated","value":"Đã ngắt kết nối (sử dụng mặc định của hệ thống)"}},"nl":{"stringUnit":{"state":"translated","value":"Verbinding verbroken (gebruikt Systeemstandaard)"}},"fa":{"stringUnit":{"state":"translated","value":"اتصال قطع است (با استفاده از پی