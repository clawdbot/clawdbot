    "Let bundled skill command-line tools run without prompting.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Let bundled skill command-line tools run without prompting."}},"zh-CN":{"stringUnit":{"state":"translated","value":"允许内置技能命令行工具运行，无需提示。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"允許內附的技能命令列工具直接執行, 不顯示提示。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Permitir que as ferramentas de linha de comando das habilidades incluídas sejam executadas sem solicitar confirmação."}},"de":{"stringUnit":{"state":"translated","value":"Mitgelieferte Skill-Befehlszeilentools ohne Rückfrage ausführen lassen."}},"es":{"stringUnit":{"state":"translated","value":"Permitir que las herramientas de línea de comandos de las habilidades incluidas se ejecuten sin pedir confirmación."}},"ja-JP":{"stringUnit":{"state":"translated","value":"同梱のスキル用コマンドラインツールを確認なしで実行できるようにします。"}},"ko":{"stringUnit":{"state":"translated","value":"번들로 제공되는 스킬 명령줄 도구를 확인 없이 실행하도록 허용합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Autoriser l’exécution des outils en ligne de commande des compétences intégrées sans demander de confirmation."}},"hi":{"stringUnit":{"state":"translated","value":"साथ में दिए गए स्किल कमांड-लाइन टूल को बिना पूछे चलने दें।"}},"ar":{"stringUnit":{"state":"translated","value":"السماح بتشغيل أدوات سطر الأوامر المرفقة بالمهارات دون طلب تأكيد."}},"it":{"stringUnit":{"state":"translated","value":"Consenti l'esecuzione degli strumenti da riga di comando delle skill incluse senza richiedere conferma."}},"tr":{"stringUnit":{"state":"translated","value":"Birlikte sunulan beceri komut satırı araçlarının onay istemeden çalışmasına izin ver."}},"uk":{"stringUnit":{"state":"translated","value":"Дозволити запуск вбудованих інструментів командного рядка для навичок без запиту."}},"id":{"stringUnit":{"state":"translated","value":"Izinkan alat baris perintah keterampilan bawaan berjalan tanpa meminta konfirmasi."}},"pl":{"stringUnit":{"state":"tra