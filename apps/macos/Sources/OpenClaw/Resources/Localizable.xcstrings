    "Play phase-transition sounds": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Play phase-transition sounds"}},"zh-CN":{"stringUnit":{"state":"translated","value":"播放阶段切换音效"}},"zh-TW":{"stringUnit":{"state":"translated","value":"播放階段切換音效"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Reproduzir sons de transição de fase"}},"de":{"stringUnit":{"state":"translated","value":"Töne bei Phasenwechseln abspielen"}},"es":{"stringUnit":{"state":"translated","value":"Reproducir sonidos de transición entre fases"}},"ja-JP":{"stringUnit":{"state":"translated","value":"状態切り替え時の効果音を再生"}},"ko":{"stringUnit":{"state":"translated","value":"단계 전환 소리 재생"}},"fr":{"stringUnit":{"state":"translated","value":"Jouer des sons lors des transitions de phase"}},"hi":{"stringUnit":{"state":"translated","value":"चरण बदलने पर ध्वनियाँ बजाएँ"}},"ar":{"stringUnit":{"state":"translated","value":"تشغيل أصوات الانتقال بين المراحل"}},"it":{"stringUnit":{"state":"translated","value":"Riproduci suoni al cambio di fase"}},"tr":{"stringUnit":{"state":"translated","value":"Aşama geçiş seslerini çal"}},"uk":{"stringUnit":{"state":"translated","value":"Відтворювати звуки переходів між етапами"}},"id":{"stringUnit":{"state":"translated","value":"Putar suara transisi fase"}},"pl":{"stringUnit":{"state":"translated","value":"Odtwarzaj dźwięki przejścia między fazami"}},"th":{"stringUnit":{"state":"translated","value":"เล่นเสียงเมื่อเปลี่ยนสถานะ"}},"vi":{"stringUnit":{"state":"translated","value":"Phát âm thanh chuyển trạng thái"}},"nl":{"stringUnit":{"state":"translated","value":"Geluiden bij faseovergangen afspelen"}},"fa":{"stringUnit":{"state":"translated","value":"پخش صداهای تغییر مرحله"}},"ru":{"stringUnit":{"state":"translated","value":"Воспроизводить звуки смены этапов"}},"sv":{"stringUnit":{"state":"translated","value":"Spela upp ljud vid fasövergångar"}}}},
    "Play short sounds when Talk Mode switches between listening, thinking, and speaking.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Play short sounds when Talk Mode switches between listening, thinking, and speaking."}},"zh-CN":{"stringUnit":{"state":"translated","value":"当对话模式在聆听、思考和说话之间切换时播放简短音效。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"在對話模式於聆聽、思考和說話之間切換時播放簡短音效。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Reproduzir sons curtos quando o Modo de Conversa alternar entre ouvir, pensar e falar."}},"de":{"stringUnit":{"state":"translated","value":"Kurze Töne abspielen, wenn der Sprachmodus zwischen Zuhören, Nachdenken und Sprechen wechselt."}},"es":{"stringUnit":{"state":"translated","value":"Reproducir sonidos breves cuando el modo de conversación cambia entre escuchar, pensar y hablar."}},"ja-JP":{"stringUnit":{"state":"translated","value":"会話モードが聞き取り中、思考中、発話中の間で切り替わるときに短い効果音を再生します。"}},"ko":{"stringUnit":{"state":"translated","value":"대화 모드가 듣기, 생각하기, 말하기 사이를 전환할 때 짧은 소리를 재생합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Jouer des sons brefs lorsque le mode vocal passe de l’écoute à la réflexion ou à la parole."}},"hi":{"stringUnit":{"state":"translated","value":"जब बातचीत मोड सुनने, सोचने और बोलने के बीच बदलता है, तो छोटी ध्वनियाँ बजाएँ।"}},"ar":{"stringUnit":{"state":"translated","value":"تشغيل أصوات قصيرة عند انتقال وضع التحدث بين الاستماع والتفكير والتحدث."}},"it":{"stringUnit":{"state":"translated","value":"Riproduci brevi suoni quando la modalità conversazione passa tra ascolto, elaborazione e parlato."}},"tr":{"stringUnit":{"state":"translated","value":"Konuşma Modu dinleme, düşünme ve konuşma arasında geçiş yaptığında kısa sesler çal."}},"uk":{"stringUnit":{"state":"translated","value":"Відтворювати короткі звуки, коли режим розмови перемикається між слуханням, обмірковуванням і мовленням."}},"id":{"stringUnit":{"state":"translated","value":"Putar suara singkat saat Mode Bicara beralih antara mendengarkan, berpikir, dan berbicara."}},"pl":{"stringUnit":{"state":"translated","value":"Odtwarzaj krótkie dźwięki, gdy tryb rozmowy przełącza się między słuchaniem, myśleniem i mówieniem."}},"th":{"stringUnit":{"state":"translated","value":"เล่นเสียงสั้น ๆ เมื่อโหมดสนทนาสลับระหว่างการฟัง การคิด และการพูด"}},"vi":{"stringUnit":{"state":"translated","value":"Phát âm thanh ngắn khi Chế độ trò chuyện chuyển giữa các trạng thái nghe, suy nghĩ và nói."}},"nl":{"stringUnit":{"state":"translated","value":"Korte geluiden afspelen wanneer de gespreksmodus schakelt tussen luisteren, denken en spreken."}},"fa":{"stringUnit":{"state":"translated","value":"هنگام جابه‌جایی حالت گفت‌وگو بین گوش دادن، فکر کردن و صحبت کردن، صداهای کوتاه پخش شود."}},"ru":{"stringUnit":{"state":"translated","value":"Воспроизводить короткие звуки, когда режим разговора переключается между прослушиванием, обдумыванием и речью."}},"sv":{"stringUnit":{"state":"translated","value":"Spela upp korta ljud när talläget växlar mellan att lyssna, tänka och tala."}}}},
