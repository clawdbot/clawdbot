    "Attachment %@ exceeds 5 MB limit after resizing": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Attachment %@ exceeds 5 MB limit after resizing"}},"zh-CN":{"stringUnit":{"state":"translated","value":"附件 %@ 调整大小后仍超过 5 MB 限制"}},"zh-TW":{"stringUnit":{"state":"translated","value":"附件 %@ 調整大小後超過 5 MB 限制"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O anexo %@ excede o limite de 5 MB após o redimensionamento"}},"de":{"stringUnit":{"state":"translated","value":"Anhang %@ überschreitet nach der Größenanpassung das Limit von 5 MB"}},"es":{"stringUnit":{"state":"translated","value":"El archivo adjunto %@ supera el límite de 5 MB después de cambiar su tamaño"}},"ja-JP":{"stringUnit":{"state":"translated","value":"添付ファイル %@ はサイズ変更後も 5 MB の制限を超えています"}},"ko":{"stringUnit":{"state":"translated","value":"첨부 파일 %@이(가) 크기 조정 후 5 MB 제한을 초과합니다"}},"fr":{"stringUnit":{"state":"translated","value":"La pièce jointe %@ dépasse la limite de 5 Mo après redimensionnement"}},"hi":{"stringUnit":{"state":"translated","value":"आकार बदलने के बाद भी अटैचमेंट %@, 5 MB की सीमा से अधिक है"}},"ar":{"stringUnit":{"state":"translated","value":"يتجاوز المرفق %@ حد 5 ميغابايت بعد تغيير حجمه"}},"it":{"stringUnit":{"state":"translated","value":"L'allegato %@ supera il limite di 5 MB dopo il ridimensionamento"}},"tr":{"stringUnit":{"state":"translated","value":"%@ eki yeniden boyutlandırıldıktan sonra 5 MB sınırını aşıyor"}},"uk":{"stringUnit":{"state":"translated","value":"Вкладення %@ перевищує ліміт 5 МБ після зміни розміру"}},"id":{"stringUnit":{"state":"translated","value":"Lampiran %@ melebihi batas 5 MB setelah ukurannya diubah"}},"pl":{"stringUnit":{"state":"translated","value":"Załącznik %@ przekracza limit 5 MB po zmianie rozmiaru"}},"th":{"stringUnit":{"state":"translated","value":"ไฟล์แนบ %@ เกินขีดจำกัด 5 MB หลังปรับขนาด"}},"vi":{"stringUnit":{"state":"translated","value":"Tệp đính kèm %@ vượt quá giới hạn 5 MB sau khi đổi kích thước"}},"nl":{"stringUnit":{"st