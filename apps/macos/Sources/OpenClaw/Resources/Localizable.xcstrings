    "Latest presence beacons from OpenClaw nodes. Updated periodically.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Latest presence beacons from OpenClaw nodes. Updated periodically."}},"zh-CN":{"stringUnit":{"state":"translated","value":"来自 OpenClaw 节点的最新在线状态信标。定期更新。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"來自 OpenClaw 節點的最新存在信標。會定期更新。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Beacons de presença mais recentes dos nós OpenClaw. Atualizado periodicamente."}},"de":{"stringUnit":{"state":"translated","value":"Aktuelle Präsenz-Beacons von OpenClaw-Knoten. Wird regelmäßig aktualisiert."}},"es":{"stringUnit":{"state":"translated","value":"Últimas balizas de presencia de nodos de OpenClaw. Se actualiza periódicamente."}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClaw ノードからの最新のプレゼンスビーコン。定期的に更新されます。"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw 노드의 최신 presence beacon입니다. 주기적으로 업데이트됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Derniers signaux de présence des nœuds OpenClaw. Mis à jour périodiquement."}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw नोड्स से नवीनतम उपस्थिति बीकन। समय-समय पर अपडेट किए जाते हैं।"}},"ar":{"stringUnit":{"state":"translated","value":"أحدث إشارات الحضور من عُقد OpenClaw. يتم التحديث دوريًا."}},"it":{"stringUnit":{"state":"translated","value":"Beacon di presenza più recenti dai nodi OpenClaw. Aggiornati periodicamente."}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw düğümlerinden en son varlık sinyalleri. Düzenli aralıklarla güncellenir."}},"uk":{"stringUnit":{"state":"translated","value":"Останні сигнали присутності від вузлів OpenClaw. Оновлюється періодично."}},"id":{"stringUnit":{"state":"translated","value":"Beacon kehadiran terbaru dari node OpenClaw. Diperbarui secara berkala."}},"pl":{"stringUnit":{"state":"translated","value":"Najnowsze sygnały obecności z węzłów OpenClaw. Aktualizowane okresowo."}},"th":{"stringUnit":{"state":"translated","value":"สัญญาณแสดงสถานะล่าสุดจากโหนด OpenClaw อัปเดตเป็นระยะ"}},"vi":{"stringUnit":{"state":"translated","value":"Các tín hiệu hiện diện mới nhất từ các nút OpenClaw. Được cập nhật định kỳ."}},"nl":{"stringUnit":{"state":"translated","value":"Nieuwste aanwezigheidsbeacons van OpenClaw-nodes. Wordt periodiek bijgewerkt."}},"fa":{"stringUnit":{"state":"translated","value":"آخرین نشانک‌های حضور از گره‌های OpenClaw. به‌صورت دوره‌ای به‌روزرسانی می‌شود."}},"ru":{"stringUnit":{"state":"translated","value":"Последние сигналы присутствия от узлов OpenClaw. Обновляются периодически."}},"sv":{"stringUnit":{"state":"translated","value":"Senaste närvarosignaler från OpenClaw-noder. Uppdateras regelbundet."}}}},
    "Launch at login": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Launch at login"}},"zh-CN":{"stringUnit":{"state":"translated","value":"登录时启动"}},"zh-TW":{"stringUnit":{"state":"translated","value":"登入時啟動"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Iniciar ao fazer login"}},"de":{"stringUnit":{"state":"translated","value":"Beim Anmelden starten"}},"es":{"stringUnit":{"state":"translated","value":"Iniciar al iniciar sesión"}},"ja-JP":{"stringUnit":{"state":"translated","value":"ログイン時に起動"}},"ko":{"stringUnit":{"state":"translated","value":"로그인 시 실행"}},"fr":{"stringUnit":{"state":"translated","value":"Lancer à l’ouverture de session"}},"hi":{"stringUnit":{"state":"translated","value":"लॉगिन पर लॉन्च करें"}},"ar":{"stringUnit":{"state":"translated","value":"التشغيل عند تسجيل الدخول"}},"it":{"stringUnit":{"state":"translated","value":"Avvia al login"}},"tr":{"stringUnit":{"state":"translated","value":"Oturum açıldığında başlat"}},"uk":{"stringUnit":{"state":"translated","value":"Запускати під час входу"}},"id":{"stringUnit":{"state":"translated","value":"Luncurkan saat login"}},"pl":{"stringUnit":{"state":"translated","value":"Uruchamiaj przy logowaniu"}},"th":{"stringUnit":{"state":"translated","value":"เปิดเมื่อเข้าสู่ระบบ"}},"vi":{"stringUnit":{"state":"translated","value":"Khởi chạy khi đăng nhập"}},"nl":{"stringUnit":{"state":"translated","value":"Starten bij inloggen"}},"fa":{"stringUnit":{"state":"translated","value":"اجرا هنگام ورود"}},"ru":{"stringUnit":{"state":"translated","value":"Запускать при входе в систему"}},"sv":{"stringUnit":{"state":"translated","value":"Starta vid inloggning"}}}},
    "Launch at login is unavailable while an app profile is active.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Launch at login is unavailable while an app profile is active."}},"zh-CN":{"stringUnit":{"state":"translated","value":"应用配置文件处于活动状态时，无法开机自动启动。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"當應用程式設定檔啟用時，無法設定登入時啟動。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A inicialização ao entrar não está disponível enquanto um perfil do app está ativo."}},"de":{"stringUnit":{"state":"translated","value":"Beim Anmelden starten ist nicht verfügbar, während ein App-Profil aktiv ist."}},"es":{"stringUnit":{"state":"translated","value":"El inicio automático al iniciar sesión no está disponible mientras hay un perfil de aplicación activo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"アプリプロファイルがアクティブな間はログイン時の起動を利用できません。"}},"ko":{"stringUnit":{"state":"translated","value":"앱 프로필이 활성화된 동안에는 로그인 시 실행을 사용할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le lancement à la connexion n’est pas disponible lorsqu’un profil d’application est actif."}},"hi":{"stringUnit":{"state":"translated","value":"ऐप प्रोफ़ाइल सक्रिय होने पर लॉगिन पर लॉन्च उपलब्ध नहीं है।"}},"ar":{"stringUnit":{"state":"translated","value":"التشغيل عند تسجيل الدخول غير متوفر أثناء نشاط ملف تعريف التطبيق."}},"it":{"stringUnit":{"state":"translated","value":"L'avvio all'accesso non è disponibile mentre è attivo un profilo dell'app."}},"tr":{"stringUnit":{"state":"translated","value":"Bir uygulama profili etkinken oturum açıldığında başlatma kullanılamaz."}},"uk":{"stringUnit":{"state":"translated","value":"Запуск під час входу недоступний, поки активний профіль застосунку."}},"id":{"stringUnit":{"state":"translated","value":"Luncurkan saat login tidak tersedia saat profil aplikasi aktif."}},"pl":{"stringUnit":{"state":"translated","value":"Uruchamianie przy logowaniu jest niedostępne, gdy profil aplikacji jest aktywny."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถเปิดใช้งานตอนล็อกอินได้ในขณะที่โปรไฟล์แอปกำลังทำงานอยู่"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể khởi chạy khi đăng nhập khi hồ sơ ứng dụng đang hoạt động."}},"nl":{"stringUnit":{"state":"translated","value":"Starten bij inloggen is niet beschikbaar terwijl een app-profiel actief is."}},"fa":{"stringUnit":{"state":"translated","value":"اجرا هنگام ورود در زمان فعال بودن نمایه برنامه در دسترس نیست."}},"ru":{"stringUnit":{"state":"translated","value":"Запуск при входе недоступен, пока активен профиль приложения."}},"sv":{"stringUnit":{"state":"translated","value":"Starta vid inloggning är inte tillgängligt när en appprofil är aktiv."}}}},
    "Legacy pane — this now lives in the Dashboard": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Legacy pane — this now lives in the Dashboard"}},"zh-CN":{"stringUnit":{"state":"translated","value":"旧版面板——现已移至 Dashboard"}},"zh-TW":{"stringUnit":{"state":"translated","value":"舊版面板 — 現已移至 Dashboard"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Painel legado — agora fica no Dashboard"}},"de":{"stringUnit":{"state":"translated","value":"Veralteter Bereich — dieser befindet sich jetzt im Dashboard"}},"es":{"stringUnit":{"state":"translated","value":"Panel heredado: esto ahora reside en el Dashboard"}},"ja-JP":{"stringUnit":{"state":"translated","value":"従来のペイン — これは現在 Dashboard にあります"}},"ko":{"stringUnit":{"state":"translated","value":"레거시 창 — 이제 Dashboard에 있습니다"}},"fr":{"stringUnit":{"state":"translated","value":"Ancien panneau — désormais disponible dans le Dashboard"}},"hi":{"stringUnit":{"state":"translated","value":"लीगेसी पेन — यह अब Dashboard में रहता है"}},"ar":{"stringUnit":{"state":"translated","value":"جزء قديم — أصبح هذا الآن في Dashboard"}},"it":{"stringUnit":{"state":"translated","value":"Pannello legacy — ora risiede nella Dashboard"}},"tr":{"stringUnit":{"state":"translated","value":"Eski bölme — bu artık Dashboard'da bulunuyor"}},"uk":{"stringUnit":{"state":"translated","value":"Застаріла панель — тепер це є в Dashboard"}},"id":{"stringUnit":{"state":"translated","value":"Panel lama — ini sekarang berada di Dashboard"}},"pl":{"stringUnit":{"state":"translated","value":"Starszy panel — to teraz znajduje się w Dashboardzie"}},"th":{"stringUnit":{"state":"translated","value":"แผงรุ่นเก่า — ตอนนี้ย้ายไปอยู่ใน Dashboard แล้ว"}},"vi":{"stringUnit":{"state":"translated","value":"Bảng cũ — nội dung này hiện nằm trong Dashboard"}},"nl":{"stringUnit":{"state":"translated","value":"Verouderd venster — dit staat nu in het Dashboard"}},"fa":{"stringUnit":{"state":"translated","value":"پنجرهٔ قدیمی — این اکنون در Dashboard قرار دارد"}},"ru":{"stringUnit":{"state":"translated","value":"Устаревшая панель — теперь это в Dashboard"}},"sv":{"stringUnit":{"state":"translated","value":"Äldre panel — detta finns nu i Dashboard"}}}},
    "Let bundled skill command-line tools run without prompting.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Let bundled skill command-line tools run without prompting."}},"zh-CN":{"stringUnit":{"state":"translated","value":"允许捆绑的 skill 命令行工具无需提示即可运行。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"允許隨附的 skill 命令列工具執行而不提示。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Permita que ferramentas de linha de comando de Skills incluídas sejam executadas sem prompt."}},"de":{"stringUnit":{"state":"translated","value":"Gebündelte Skill-Befehlszeilentools ohne Rückfrage ausführen lassen."}},"es":{"stringUnit":{"state":"translated","value":"Permite que las herramientas de línea de comandos de skills incluidas se ejecuten sin solicitar confirmación."}},"ja-JP":{"stringUnit":{"state":"translated","value":"バンドルされた skill コマンドラインツールを、プロンプトなしで実行できるようにします。"}},"ko":{"stringUnit":{"state":"translated","value":"번들로 제공되는 skill 명령줄 도구가 프롬프트 없이 실행되도록 허용합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Autoriser l’exécution des outils en ligne de commande Skills intégrés sans invite."}},"hi":{"stringUnit":{"state":"translated","value":"बंडल किए गए स्किल कमांड-लाइन टूल्स को बिना प्रॉम्प्ट चलने दें।"}},"ar":{"stringUnit":{"state":"translated","value":"السماح بتشغيل أدوات سطر الأوامر المضمّنة الخاصة بـ Skills دون مطالبة."}},"it":{"stringUnit":{"state":"translated","value":"Consenti l'esecuzione degli strumenti a riga di comando delle Skills incluse senza richiesta di conferma."}},"tr":{"stringUnit":{"state":"translated","value":"Paketlenmiş skill komut satırı araçlarının istem göstermeden çalışmasına izin verin."}},"uk":{"stringUnit":{"state":"translated","value":"Дозволяти вбудованим інструментам командного рядка Skills запускатися без запиту."}},"id":{"stringUnit":{"state":"translated","value":"Izinkan alat baris perintah skill bawaan berjalan tanpa prompt."}},"pl":{"stringUnit":{"state":"translated","value":"Pozwól dołączonym narzędziom wiersza poleceń Skills działać bez monitowania."}},"th":{"stringUnit":{"state":"translated","value":"อนุญาตให้เครื่องมือบรรทัดคำสั่งของ Skill ที่รวมมาให้ทำงานได้โดยไม่ต้องแสดงพรอมป์"}},"vi":{"stringUnit":{"state":"translated","value":"Cho phép các công cụ dòng lệnh skill được đóng gói chạy mà không cần nhắc."}},"nl":{"stringUnit":{"state":"translated","value":"Laat meegeleverde commandoregeltools voor skills uitvoeren zonder prompt."}},"fa":{"stringUnit":{"state":"translated","value":"اجازه دهید ابزارهای خط فرمان skill همراه، بدون نمایش اعلان اجرا شوند."}},"ru":{"stringUnit":{"state":"translated","value":"Разрешить встроенным инструментам командной строки Skills запускаться без запроса."}},"sv":{"stringUnit":{"state":"translated","value":"Låt medföljande kommandoradsverktyg för skills köras utan prompt."}}}},
    "Letting your agent know you’re back…": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Letting your agent know you’re back…"}},"zh-CN":{"stringUnit":{"state":"translated","value":"正在通知你的智能体你已回来…"}},"zh-TW":{"stringUnit":{"state":"translated","value":"正在通知您的代理程式您已返回…"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Avisando ao seu agente que você voltou…"}},"de":{"stringUnit":{"state":"translated","value":"Ihr Agent wird informiert, dass Sie zurück sind…"}},"es":{"stringUnit":{"state":"translated","value":"Avisando a tu agente de que has vuelto…"}},"ja-JP":{"stringUnit":{"state":"translated","value":"戻ってきたことをエージェントに知らせています…"}},"ko":{"stringUnit":{"state":"translated","value":"에이전트에게 돌아왔음을 알리는 중…"}},"fr":{"stringUnit":{"state":"translated","value":"Nous informons votre agent de votre retour…"}},"hi":{"stringUnit":{"state":"translated","value":"आपके एजेंट को बताया जा रहा है कि आप वापस आ गए हैं…"}},"ar":{"stringUnit":{"state":"translated","value":"جارٍ إبلاغ وكيلك بعودتك…"}},"it":{"stringUnit":{"state":"translated","value":"Stiamo informando il tuo agente che sei tornato…"}},"tr":{"stringUnit":{"state":"translated","value":"Temsilcinize geri döndüğünüz bildiriliyor…"}},"uk":{"stringUnit":{"state":"translated","value":"Сповіщаємо вашого агента про ваше повернення…"}},"id":{"stringUnit":{"state":"translated","value":"Memberi tahu agen Anda bahwa Anda telah kembali…"}},"pl":{"stringUnit":{"state":"translated","value":"Informowanie agenta o Twoim powrocie…"}},"th":{"stringUnit":{"state":"translated","value":"กำลังแจ้งให้เอเจนต์ของคุณทราบว่าคุณกลับมาแล้ว…"}},"vi":{"stringUnit":{"state":"translated","value":"Đang thông báo cho tác nhân rằng bạn đã quay lại…"}},"nl":{"stringUnit":{"state":"translated","value":"Je agent laten weten dat je terug bent…"}},"fa":{"stringUnit":{"state":"translated","value":"در حال اطلاع دادن بازگشت شما به عاملتان…"}},"ru":{"stringUnit":{"state":"translated","value":"Сообщаем вашему агенту, что вы вернулись…"}},"sv":{"