    "Give your assistant tasks and let it help across your Mac.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Give your assistant tasks and let it help across your Mac."}},"zh-CN":{"stringUnit":{"state":"translated","value":"将任务交给你的助手，让它在你的 Mac 上协助你。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"將任務交給你的助理，讓它在你的 Mac 上協助你處理各種工作。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Dê tarefas ao seu assistente e deixe que ele ajude em todo o seu Mac."}},"de":{"stringUnit":{"state":"translated","value":"Geben Sie Ihrem Assistenten Aufgaben und lassen Sie ihn Ihnen auf Ihrem Mac helfen."}},"es":{"stringUnit":{"state":"translated","value":"Asigna tareas a tu asistente y deja que te ayude en tu Mac."}},"ja-JP":{"stringUnit":{"state":"translated","value":"アシスタントにタスクを任せて、Mac 全体でサポートを受けましょう。"}},"ko":{"stringUnit":{"state":"translated","value":"어시스턴트에게 작업을 맡기고 Mac 전반에서 도움을 받으세요."}},"fr":{"stringUnit":{"state":"translated","value":"Confiez des tâches à votre assistant et laissez-le vous aider sur votre Mac."}},"hi":{"stringUnit":{"state":"translated","value":"अपने सहायक को कार्य दें और उसे अपने Mac पर आपकी मदद करने दें।"}},"ar":{"stringUnit":{"state":"translated","value":"امنح مساعدك مهامًا ودعه يساعدك عبر Mac الخاص بك."}},"it":{"stringUnit":{"state":"translated","value":"Assegna attività al tuo assistente e lascia che ti aiuti sul tuo Mac."}},"tr":{"stringUnit":{"state":"translated","value":"Asistanınıza görevler verin ve Mac’inizin genelinde size yardımcı olmasını sağlayın."}},"uk":{"stringUnit":{"state":"translated","value":"Давайте своєму асистенту завдання й дозвольте йому допомагати на вашому Mac."}},"id":{"stringUnit":{"state":"translated","value":"Berikan tugas kepada asisten Anda dan biarkan asisten membantu di seluruh Mac Anda."}},"pl":{"stringUnit":{"state":"translated","value":"Przydzielaj asystentowi zadania i pozwól mu pomagać na całym Macu."}},"th":{"stringUnit":{"state":"translated","value":"มอบหมายงานให้ผู้ช่วยของคุณและให้ช่วยทำงานบน Mac ของคุณ"}},"vi":{"stringUnit":{"state":"translated","value":"Giao nhiệm vụ cho trợ lý của bạn và để trợ lý hỗ trợ trên máy Mac của bạn."}},"nl":{"stringUnit":{"state":"translated","value":"Geef je assistent taken en laat die je helpen op je Mac."}},"fa":{"stringUnit":{"state":"translated","value":"به دستیار خود وظایفی بدهید و بگذارید در سراسر Mac به شما کمک کند."}},"ru":{"stringUnit":{"state":"translated","value":"Давайте ассистенту задачи и позвольте ему помогать вам на Mac."}},"sv":{"stringUnit":{"state":"translated","value":"Ge din assistent uppgifter och låt den hjälpa till på din Mac."}}}},
