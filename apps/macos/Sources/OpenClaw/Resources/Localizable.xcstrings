    "Reopen OpenClaw to retry the embedded CUA daemon.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reopen OpenClaw to retry the embedded CUA daemon."}},"zh-CN":{"stringUnit":{"state":"translated","value":"重新打开 OpenClaw 以重试内嵌的 CUA 守护进程。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"重新開啟 OpenClaw 以重試內嵌的 CUA 常駐程式。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Reabra o OpenClaw para tentar executar novamente o daemon CUA integrado."}},"de":{"stringUnit":{"state":"translated","value":"Öffnen Sie OpenClaw erneut, um den eingebetteten CUA-Daemon erneut zu starten."}},"es":{"stringUnit":{"state":"translated","value":"Vuelve a abrir OpenClaw para reintentar el inicio del demonio CUA integrado."}},"ja-JP":{"stringUnit":{"state":"translated","value":"内蔵のCUAデーモンを再試行するには、OpenClawを開き直してください。"}},"ko":{"stringUnit":{"state":"translated","value":"내장 CUA 데몬을 다시 시도하려면 OpenClaw를 다시 여세요."}},"fr":{"stringUnit":{"state":"translated","value":"Rouvrez OpenClaw pour réessayer de lancer le démon CUA intégré."}},"hi":{"stringUnit":{"state":"translated","value":"एम्बेडेड CUA डेमन को फिर से चलाने का प्रयास करने के लिए OpenClaw दोबारा खोलें."}},"ar":{"stringUnit":{"state":"translated","value":"أعد فتح OpenClaw لإعادة محاولة تشغيل خدمة CUA المضمنة."}},"it":{"stringUnit":{"state":"translated","value":"Riapri OpenClaw per riprovare ad avviare il daemon CUA integrato."}},"tr":{"stringUnit":{"state":"translated","value":"Gömülü CUA arka plan hizmetini yeniden denemek için OpenClaw uygulamasını yeniden açın."}},"uk":{"stringUnit":{"state":"translated","value":"Знову відкрийте OpenClaw, щоб повторити спробу запуску вбудованого демона CUA."}},"id":{"stringUnit":{"state":"translated","value":"Buka kembali OpenClaw untuk mencoba lagi daemon CUA bawaan."}},"pl":{"stringUnit":{"state":"translated","value":"Otwórz ponownie OpenClaw, aby ponowić próbę uruchomienia wbudowanego demona CUA."}},"th":{"stringUnit":{"state":"translated","value":"เปิด OpenClaw อีกครั้งเพื