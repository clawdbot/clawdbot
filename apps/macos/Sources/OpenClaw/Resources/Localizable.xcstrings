    "Running": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Running"}},"zh-CN":{"stringUnit":{"state":"translated","value":"运行中"}},"zh-TW":{"stringUnit":{"state":"translated","value":"執行中"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Em execução"}},"de":{"stringUnit":{"state":"translated","value":"Wird ausgeführt"}},"es":{"stringUnit":{"state":"translated","value":"En ejecución"}},"ja-JP":{"stringUnit":{"state":"translated","value":"実行中"}},"ko":{"stringUnit":{"state":"translated","value":"실행 중"}},"fr":{"stringUnit":{"state":"translated","value":"En cours d’exécution"}},"hi":{"stringUnit":{"state":"translated","value":"चल रहा है"}},"ar":{"stringUnit":{"state":"translated","value":"قيد التشغيل"}},"it":{"stringUnit":{"state":"translated","value":"In esecuzione"}},"tr":{"stringUnit":{"state":"translated","value":"Çalışıyor"}},"uk":{"stringUnit":{"state":"translated","value":"Працює"}},"id":{"stringUnit":{"state":"translated","value":"Berjalan"}},"pl":{"stringUnit":{"state":"translated","value":"Uruchomiona"}},"th":{"stringUnit":{"state":"translated","value":"กำลังทำงาน"}},"vi":{"stringUnit":{"state":"translated","value":"Đang chạy"}},"nl":{"stringUnit":{"state":"translated","value":"Actief"}},"fa":{"stringUnit":{"state":"translated","value":"در حال اجرا"}},"ru":{"stringUnit":{"state":"translated","value":"Работает"}},"sv":{"stringUnit":{"state":"translated","value":"Körs"}}}},
    "Runs quietly and starts again after a restart.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Runs quietly and starts again after a restart."}},"zh-CN":{"stringUnit":{"state":"translated","value":"在后台静默运行，并在重启后自动启动。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"在背景安靜執行，並在重新啟動後再次啟動。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Funciona discretamente e inicia novamente após uma reinicialização."}},"de":{"stringUnit":{"state":"translated","value":"Läuft unauffällig im Hintergrund und startet nach einem Neustart erneut."}},"es":{"stringUnit":{"state":"translated","value":"Se ejecuta en segundo plano y vuelve a iniciarse después de un reinicio."}},"ja-JP":{"stringUnit":{"state":"translated","value":"バックグラウンドで動作し、再起動後に再び起動します。"}},"ko":{"stringUnit":{"state":"translated","value":"백그라운드에서 실행되며 재시작 후 다시 시작됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Fonctionne discrètement et se relance après un redémarrage."}},"hi":{"stringUnit":{"state":"translated","value":"पृष्ठभूमि में चलता है और रीस्टार्ट के बाद फिर से शुरू हो जाता है।"}},"ar":{"stringUnit":{"state":"translated","value":"يعمل بهدوء ويبدأ مجددًا بعد إعادة التشغيل."}},"it":{"stringUnit":{"state":"translated","value":"Funziona in background e riparte dopo un riavvio."}},"tr":{"stringUnit":{"state":"translated","value":"Sessizce çalışır ve yeniden başlatma sonrasında tekrar başlar."}},"uk":{"stringUnit":{"state":"translated","value":"Працює у фоновому режимі та знову запускається після перезапуску."}},"id":{"stringUnit":{"state":"translated","value":"Berjalan di latar belakang dan berjalan kembali setelah mulai ulang."}},"pl":{"stringUnit":{"state":"translated","value":"Działa w tle i uruchamia się ponownie po restarcie."}},"th":{"stringUnit":{"state":"translated","value":"ทำงานเบื้องหลังและเริ่มทำงานอีกครั้งหลังจากรีสตาร์ท."}},"vi":{"stringUnit":{"state":"translated","value":"Chạy ngầm và tự chạy lại sau khi khởi động lại."}},"nl":{"stringUnit":{"state":"translated","value":"Draait op de achtergrond en start opnieuw na een herstart."}},"fa":{"stringUnit":{"state":"translated","value":"بی‌سروصدا اجرا می‌شود و پس از راه‌اندازی مجدد، دوباره شروع به کار می‌کند."}},"ru":{"stringUnit":{"state":"translated","value":"Работает в фоновом режиме и запускается снова после перезагрузки."}},"sv":{"stringUnit":{"state":"translated","value":"Körs i bakgrunden och startar igen efter en omstart."}}}},
