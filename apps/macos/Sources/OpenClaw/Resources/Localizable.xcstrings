    "Click the OpenClaw menu bar icon for the compact chat panel and status.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Click the OpenClaw menu bar icon for the compact chat panel and status."}},"zh-CN":{"stringUnit":{"state":"translated","value":"点按 OpenClaw 菜单栏图标，打开紧凑型聊天面板并查看状态。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"按一下 OpenClaw 選單列圖示，即可查看精簡聊天面板和狀態。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Clique no ícone do OpenClaw na barra de menus para acessar o painel de chat compacto e o status."}},"de":{"stringUnit":{"state":"translated","value":"Klicke auf das OpenClaw-Symbol in der Menüleiste, um das kompakte Chatfenster und den Status anzuzeigen."}},"es":{"stringUnit":{"state":"translated","value":"Haz clic en el icono de OpenClaw de la barra de menús para acceder al panel de chat compacto y al estado."}},"ja-JP":{"stringUnit":{"state":"translated","value":"コンパクトなチャットパネルとステータスを表示するには、メニューバーのOpenClawアイコンをクリックします。"}},"ko":{"stringUnit":{"state":"translated","value":"간결한 채팅 패널과 상태를 보려면 OpenClaw 메뉴 막대 아이콘을 클릭하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Cliquez sur l’icône OpenClaw dans la barre des menus pour afficher le panneau de discussion compact et l’état."}},"hi":{"stringUnit":{"state":"translated","value":"कॉम्पैक्ट चैट पैनल और स्थिति के लिए OpenClaw मेनू बार आइकन पर क्लिक करें।"}},"ar":{"stringUnit":{"state":"translated","value":"انقر على أيقونة OpenClaw في شريط القوائم لعرض لوحة الدردشة المصغّرة والحالة."}},"it":{"stringUnit":{"state":"translated","value":"Fai clic sull'icona OpenClaw nella barra dei menu per visualizzare il pannello chat compatto e lo stato."}},"tr":{"stringUnit":{"state":"translated","value":"Kompakt sohbet paneli ve durum bilgisi için OpenClaw menü çubuğu simgesine tıklayın."}},"uk":{"stringUnit":{"state":"translated","value":"Натисніть піктограму OpenClaw у рядку меню, щоб відкрити компактну панель чату та переглянути стан."}},"id":{"stringUnit":{"state":"translated","value":"Klik ikon bilah menu OpenClaw untuk membuka panel obrolan ringkas dan melihat status."}},"pl":{"stringUnit":{"state":"translated","value":"Kliknij ikonę OpenClaw na pasku menu, aby wyświetlić kompaktowy panel czatu i stan."}},"th":{"stringUnit":{"state":"translated","value":"คลิกไอคอน OpenClaw บนแถบเมนูเพื่อเปิดแผงแชตขนาดกะทัดรัดและดูสถานะ"}},"vi":{"stringUnit":{"state":"translated","value":"Nhấp vào biểu tượng OpenClaw trên thanh menu để mở bảng trò chuyện thu gọn và xem trạng thái."}},"nl":{"stringUnit":{"state":"translated","value":"Klik op het OpenClaw-menubalkpictogram voor het compacte chatpaneel en de status."}},"fa":{"stringUnit":{"state":"translated","value":"برای مشاهده پنل فشرده گفت‌وگو و وضعیت، روی نماد OpenClaw در نوار منو کلیک کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Нажмите значок OpenClaw в строке меню, чтобы открыть компактную панель чата и просмотреть статус."}},"sv":{"stringUnit":{"state":"translated","value":"Klicka på OpenClaw-ikonen i menyraden för att visa den kompakta chattpanelen och statusen."}}}},
