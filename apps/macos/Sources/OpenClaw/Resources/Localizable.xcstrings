    "Accessibility": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Accessibility"}},"zh-CN":{"stringUnit":{"state":"translated","value":"辅助功能"}},"zh-TW":{"stringUnit":{"state":"translated","value":"輔助使用"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Acessibilidade"}},"de":{"stringUnit":{"state":"translated","value":"Barrierefreiheit"}},"es":{"stringUnit":{"state":"translated","value":"Accesibilidad"}},"ja-JP":{"stringUnit":{"state":"translated","value":"アクセシビリティ"}},"ko":{"stringUnit":{"state":"translated","value":"접근성"}},"fr":{"stringUnit":{"state":"translated","value":"Accessibilité"}},"hi":{"stringUnit":{"state":"translated","value":"सुगम्यता"}},"ar":{"stringUnit":{"state":"translated","value":"إمكانية الوصول"}},"it":{"stringUnit":{"state":"translated","value":"Accessibilità"}},"tr":{"stringUnit":{"state":"translated","value":"Erişilebilirlik"}},"uk":{"stringUnit":{"state":"translated","value":"Доступність"}},"id":{"stringUnit":{"state":"translated","value":"Aksesibilitas"}},"pl":{"stringUnit":{"state":"translated","value":"Dostępność"}},"th":{"stringUnit":{"state":"translated","value":"การช่วยเหลือการเข้าถึง"}},"vi":{"stringUnit":{"state":"translated","value":"Trợ năng"}},"nl":{"stringUnit":{"state":"translated","value":"Toegankelijkheid"}},"fa":{"stringUnit":{"state":"translated","value":"دسترسی‌پذیری"}},"ru":{"stringUnit":{"state":"translated","value":"Специальные возможности"}},"sv":{"stringUnit":{"state":"translated","value":"Tillgänglighet"}}}},
    "Accessibility permission is required to paste.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Accessibility permission is required to paste."}},"zh-CN":{"stringUnit":{"state":"translated","value":"需要辅助功能权限才能粘贴。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"需要輔助使用權限才能貼上。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"É necessário conceder permissão de acessibilidade para colar."}},"de":{"stringUnit":{"state":"translated","value":"Zum Einfügen ist die Bedienungshilfen-Berechtigung erforderlich."}},"es":{"stringUnit":{"state":"translated","value":"Se requiere el permiso de accesibilidad para pegar."}},"ja-JP":{"stringUnit":{"state":"translated","value":"貼り付けるにはアクセシビリティの権限が必要です。"}},"ko":{"stringUnit":{"state":"translated","value":"붙여넣으려면 손쉬운 사용 권한이 필요합니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’autorisation d’accessibilité est requise pour effectuer le collage."}},"hi":{"stringUnit":{"state":"translated","value":"पेस्ट करने के लिए ऐक्सेसिबिलिटी की अनुमति आवश्यक है।"}},"ar":{"stringUnit":{"state":"translated","value":"يلزم منح إذن تسهيلات الاستخدام للصق."}},"it":{"stringUnit":{"state":"translated","value":"È richiesta l'autorizzazione per l'accessibilità per incollare."}},"tr":{"stringUnit":{"state":"translated","value":"Yapıştırmak için Erişilebilirlik izni gerekiyor."}},"uk":{"stringUnit":{"state":"translated","value":"Для вставлення потрібен дозвіл на універсальний доступ."}},"id":{"stringUnit":{"state":"translated","value":"Izin Aksesibilitas diperlukan untuk menempelkan."}},"pl":{"stringUnit":{"state":"translated","value":"Do wklejania wymagane jest uprawnienie Dostępność."}},"th":{"stringUnit":{"state":"translated","value":"ต้องอนุญาตการช่วยการเข้าถึงเพื่อวางข้อความ"}},"vi":{"stringUnit":{"state":"translated","value":"Cần có quyền Trợ năng để dán."}},"nl":{"stringUnit":{"state":"translated","value":"Toestemming voor toegankelijkheid is vereist om te plakken."}},"fa":{"stringUnit":{"state":"translated","value":"برای جای‌گذاری، مجوز دسترس‌پذیری لازم است."}},"ru":{"stringUnit":{"state":"translated","value":"Для вставки требуется разрешение на универсальный доступ."}},"sv":{"stringUnit":{"state":"translated","value":"Behörighet för hjälpmedel krävs för att klistra in."}}}},
    "Accessibility, Event Posting, and Screen Recording are granted.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Accessibility, Event Posting, and Screen Recording are granted."}},"zh-CN":{"stringUnit":{"state":"translated","value":"已授予辅助功能、事件发布和屏幕录制权限。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已授予輔助使用、事件發送及螢幕錄製權限。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"As permissões de Acessibilidade, Envio de Eventos e Gravação de Tela foram concedidas."}},"de":{"stringUnit":{"state":"translated","value":"Bedienungshilfen, Ereignisübermittlung und Bildschirmaufnahme sind erlaubt."}},"es":{"stringUnit":{"state":"translated","value":"Los permisos de accesibilidad, publicación de eventos y grabación de pantalla están concedidos."}},"ja-JP":{"stringUnit":{"state":"translated","value":"アクセシビリティ、イベント送信、画面収録が許可されています。"}},"ko":{"stringUnit":{"state":"translated","value":"손쉬운 사용, 이벤트 게시 및 화면 기록 권한이 허용되었습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les autorisations d’accessibilité, de publication d’événements et d’enregistrement de l’écran sont accordées."}},"hi":{"stringUnit":{"state":"translated","value":"Accessibility, Event Posting और Screen Recording की अनुमतियाँ दी गई हैं।"}},"ar":{"stringUnit":{"state":"translated","value":"تم منح أذونات تسهيلات الاستخدام ونشر الأحداث وتسجيل الشاشة."}},"it":{"stringUnit":{"state":"translated","value":"Le autorizzazioni per Accessibilità, Pubblicazione eventi e Registrazione schermo sono state concesse."}},"tr":{"stringUnit":{"state":"translated","value":"Erişilebilirlik, Olay Gönderme ve Ekran Kaydı izinleri verildi."}},"uk":{"stringUnit":{"state":"translated","value":"Дозволи на універсальний доступ, надсилання подій і запис екрана надано."}},"id":{"stringUnit":{"state":"translated","value":"Aksesibilitas, Pengiriman Peristiwa, dan Perekaman Layar telah diizinkan."}},"pl":{"stringUnit":{"state":"translated","value":"Przyznano uprawnienia do Dostępności, wysyłania zdarzeń i nagrywania ekranu."}},"th":{"stringUnit":{"state":"translated","value":"อนุญาตสิทธิ์การช่วยการเข้าถึง การโพสต์เหตุการณ์ และการบันทึกหน้าจอแล้ว"}},"vi":{"stringUnit":{"state":"translated","value":"Đã cấp quyền Trợ năng, Đăng sự kiện và Ghi màn hình."}},"nl":{"stringUnit":{"state":"translated","value":"Toegankelijkheid, het plaatsen van gebeurtenissen en schermopname zijn toegestaan."}},"fa":{"stringUnit":{"state":"translated","value":"مجوزهای دسترس‌پذیری، ارسال رویداد و ضبط صفحه اعطا شده‌اند."}},"ru":{"stringUnit":{"state":"translated","value":"Предоставлены разрешения на универсальный доступ, отправку событий и запись экрана."}},"sv":{"stringUnit":{"state":"translated","value":"Behörigheter för hjälpmedelsfunktioner, händelsepublicering och skärminspelning har beviljats."}}}},
