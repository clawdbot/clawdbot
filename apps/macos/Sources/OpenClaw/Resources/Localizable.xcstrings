    "Allow OpenClaw to capture a screen area": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allow OpenClaw to capture a screen area"}},"zh-CN":{"stringUnit":{"state":"translated","value":"允许 OpenClaw 捕获屏幕区域"}},"zh-TW":{"stringUnit":{"state":"translated","value":"允許 OpenClaw 擷取螢幕區域"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Permitir que o OpenClaw capture uma área da tela"}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw das Aufnehmen eines Bildschirmbereichs erlauben"}},"es":{"stringUnit":{"state":"translated","value":"Permitir que OpenClaw capture un área de la pantalla"}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClawによる画面領域のキャプチャを許可"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw가 화면 영역을 캡처하도록 허용"}},"fr":{"stringUnit":{"state":"translated","value":"Autoriser OpenClaw à capturer une zone de l’écran"}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw को स्क्रीन का क्षेत्र कैप्चर करने की अनुमति दें"}},"ar":{"stringUnit":{"state":"translated","value":"السماح لـ OpenClaw بالتقاط منطقة من الشاشة"}},"it":{"stringUnit":{"state":"translated","value":"Consenti a OpenClaw di acquisire un'area dello schermo"}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw'un bir ekran alanını yakalamasına izin ver"}},"uk":{"stringUnit":{"state":"translated","value":"Дозволити OpenClaw захоплювати область екрана"}},"id":{"stringUnit":{"state":"translated","value":"Izinkan OpenClaw menangkap area layar"}},"pl":{"stringUnit":{"state":"translated","value":"Zezwól OpenClaw na przechwytywanie obszaru ekranu"}},"th":{"stringUnit":{"state":"translated","value":"อนุญาตให้ OpenClaw จับภาพพื้นที่หน้าจอ"}},"vi":{"stringUnit":{"state":"translated","value":"Cho phép OpenClaw chụp một vùng màn hình"}},"nl":{"stringUnit":{"state":"translated","value":"OpenClaw toestaan een schermgebied vast te leggen"}},"fa":{"stringUnit":{"state":"translated","value":"اجازه به OpenClaw برای ثبت بخشی از صفحه‌نمایش"}},"ru":{"stringUnit":{"state":"translated","value":"Разрешить OpenClaw захватывать область экрана"}},"sv":{"stringUnit":{"state":"translated","value":"Tillåt OpenClaw att ta en skärmbild av ett skärmområde"}}}},
    "Allow OpenClaw to capture windows": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allow OpenClaw to capture windows"}},"zh-CN":{"stringUnit":{"state":"translated","value":"允许 OpenClaw 捕获窗口"}},"zh-TW":{"stringUnit":{"state":"translated","value":"允許 OpenClaw 擷取視窗"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Permitir que o OpenClaw capture janelas"}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw das Aufnehmen von Fenstern erlauben"}},"es":{"stringUnit":{"state":"translated","value":"Permitir que OpenClaw capture ventanas"}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClawによるウインドウのキャプチャを許可"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw가 윈도우를 캡처하도록 허용"}},"fr":{"stringUnit":{"state":"translated","value":"Autoriser OpenClaw à capturer des fenêtres"}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw को विंडो कैप्चर करने की अनुमति दें"}},"ar":{"stringUnit":{"state":"translated","value":"السماح لـ OpenClaw بالتقاط النوافذ"}},"it":{"stringUnit":{"state":"translated","value":"Consenti a OpenClaw di acquisire le finestre"}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw'un pencereleri yakalamasına izin ver"}},"uk":{"stringUnit":{"state":"translated","value":"Дозволити OpenClaw захоплювати вікна"}},"id":{"stringUnit":{"state":"translated","value":"Izinkan OpenClaw menangkap jendela"}},"pl":{"stringUnit":{"state":"translated","value":"Zezwól OpenClaw na przechwytywanie okien"}},"th":{"stringUnit":{"state":"translated","value":"อนุญาตให้ OpenClaw จับภาพหน้าต่าง"}},"vi":{"stringUnit":{"state":"translated","value":"Cho phép OpenClaw chụp các cửa sổ"}},"nl":{"stringUnit":{"state":"translated","value":"OpenClaw toestaan vensters vast te leggen"}},"fa":{"stringUnit":{"state":"translated","value":"اجازه به OpenClaw برای ثبت پنجره‌ها"}},"ru":{"stringUnit":{"state":"translated","value":"Разрешить OpenClaw захватывать окна"}},"sv":{"stringUnit":{"state":"translated","value":"Tillåt OpenClaw att ta skärmbilder av fönster"}}}},
    "Allow Voice Wake, push-to-talk, Talk Mode, and Quick Chat dictation": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allow Voice Wake, push-to-talk, Talk Mode, and Quick Chat dictation"}},"zh-CN":{"stringUnit":{"state":"translated","value":"允许语音唤醒、按键说话、Talk Mode 和 Quick Chat 听写"}},"zh-TW":{"stringUnit":{"state":"translated","value":"允許語音喚醒、按住通話、Talk Mode 及 Quick Chat 聽寫"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Permitir Voice Wake, push-to-talk, Talk Mode e ditado do Quick Chat"}},"de":{"stringUnit":{"state":"translated","value":"Voice Wake, Push-to-Talk, Talk Mode und Quick-Chat-Diktat erlauben"}},"es":{"stringUnit":{"state":"translated","value":"Permitir Voice Wake, pulsar para hablar, Modo de conversación y dictado de Quick Chat"}},"ja-JP":{"stringUnit":{"state":"translated","value":"Voice Wake、プッシュトゥトーク、Talk Mode、Quick Chatのディクテーションを許可"}},"ko":{"stringUnit":{"state":"translated","value":"음성 깨우기, 푸시투토크, Talk Mode, 빠른 채팅 받아쓰기를 허용합니다"}},"fr":{"stringUnit":{"state":"translated","value":"Autoriser Voice Wake, la fonction push-to-talk, le mode Talk et la dictée Quick Chat"}},"hi":{"stringUnit":{"state":"translated","value":"Voice Wake, push-to-talk, Talk Mode, और Quick Chat डिक्टेशन की अनुमति दें"}},"ar":{"stringUnit":{"state":"translated","value":"السماح بالتنبيه الصوتي والضغط للتحدث ووضع التحدث والإملاء في Quick Chat"}},"it":{"stringUnit":{"state":"translated","value":"Consenti Voice Wake, push-to-talk, Modalità Conversazione e dettatura Quick Chat"}},"tr":{"stringUnit":{"state":"translated","value":"Voice Wake, bas-konuş, Talk Mode ve Quick Chat dikte özelliklerine izin ver"}},"uk":{"stringUnit":{"state":"translated","value":"Дозволити Voice Wake, push-to-talk, режим розмови та диктування Quick Chat"}},"id":{"stringUnit":{"state":"translated","value":"Izinkan Voice Wake, push-to-talk, Talk Mode, dan dikte Quick Chat"}},"pl":{"stringUnit":{"state":"translated","value":"Zezwól na Wybudzanie głosem, tryb push-to-talk, tryb rozmowy i dyktowanie Quick Chat"}},"th":{"stringUnit":{"state":"translated","value":"อนุญาต Voice Wake, push-to-talk, Talk Mode และการป้อนตามคำบอกของ Quick Chat"}},"vi":{"stringUnit":{"state":"translated","value":"Cho phép Voice Wake, nhấn-để-nói, Talk Mode và đọc chính tả Quick Chat"}},"nl":{"stringUnit":{"state":"translated","value":"Sta Voice Wake, push-to-talk, Talk Mode en Quick Chat-dictaat toe"}},"fa":{"stringUnit":{"state":"translated","value":"اجازه دادن به Voice Wake، فشار برای صحبت، حالت گفتگو و دیکته Quick Chat"}},"ru":{"stringUnit":{"state":"translated","value":"Разрешить Voice Wake, push-to-talk, Talk Mode и диктовку Quick Chat"}},"sv":{"stringUnit":{"state":"translated","value":"Tillåt röstväckning, tryck-och-prata, Talk Mode och diktering i Quick Chat"}}}},
    "Allow agents to use device location when a tool asks for it.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allow agents to use device location when a tool asks for it."}},"zh-CN":{"stringUnit":{"state":"translated","value":"当工具请求时，允许代理使用设备位置。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"允許代理在工具要求時使用裝置位置。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Permita que agentes usem a localização do dispositivo quando uma ferramenta solicitar."}},"de":{"stringUnit":{"state":"translated","value":"Agenten erlauben, den Gerätestandort zu verwenden, wenn ein Tool danach fragt."}},"es":{"stringUnit":{"state":"translated","value":"Permite que los agentes usen la ubicación del dispositivo cuando una herramienta la solicite."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ツールが要求した場合に、エージェントがデバイスの位置情報を使用できるようにします。"}},"ko":{"stringUnit":{"state":"translated","value":"도구에서 요청할 때 에이전트가 기기 위치를 사용할 수 있도록 허용합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Autoriser les agents à utiliser la localisation de l’appareil lorsqu’un outil la demande."}},"hi":{"stringUnit":{"state":"translated","value":"जब कोई टूल मांगता है, तो एजेंटों को डिवाइस स्थान का उपयोग करने दें।"}},"ar":{"stringUnit":{"state":"translated","value":"السماح للوكلاء باستخدام موقع الجهاز عندما تطلبه أداة."}},"it":{"stringUnit":{"state":"translated","value":"Consenti agli agenti di usare la posizione del dispositivo quando uno strumento la richiede."}},"tr":{"stringUnit":{"state":"translated","value":"Bir araç istediğinde aracıların aygıt konumunu kullanmasına izin verin."}},"uk":{"stringUnit":{"state":"translated","value":"Дозволити агентам використовувати місцезнаходження пристрою, коли інструмент запитує його."}},"id":{"stringUnit":{"state":"translated","value":"Izinkan agen menggunakan lokasi perangkat saat alat memintanya."}},"pl":{"stringUnit":{"state":"translated","value":"Zezwól agentom na używanie lokalizacji urządzenia, gdy narzędzie o nią poprosi."}},"th":{"stringUnit":{"state":"translated","value":"อนุญาตให้เอเจนต์ใช้ตำแหน่งที่ตั้งของอุปกรณ์เมื่อเครื่องมือร้องขอ"}},"vi":{"stringUnit":{"state":"translated","value":"Cho phép các agent sử dụng vị trí thiết bị khi một công cụ yêu cầu."}},"nl":{"stringUnit":{"state":"translated","value":"Sta agents toe de apparaatlocatie te gebruiken wanneer een tool daarom vraagt."}},"fa":{"stringUnit":{"state":"translated","value":"به عامل‌ها اجازه دهید وقتی ابزاری درخواست می‌کند، از موقعیت مکانی دستگاه استفاده کنند."}},"ru":{"stringUnit":{"state":"translated","value":"Разрешить агентам использовать геопозицию устройства, когда инструмент запрашивает ее."}},"sv":{"stringUnit":{"state":"translated","value":"Tillåt agenter att använda enhetens plats när ett verktyg ber om den."}}}},
    "Allow once": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allow once"}},"zh-CN":{"stringUnit":{"state":"translated","value":"允许一次"}},"zh-TW":{"stringUnit":{"state":"translated","value":"允許一次"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Permitir uma vez"}},"de":{"stringUnit":{"state":"translated","value":"Einmal zulassen"}},"es":{"stringUnit":{"state":"translated","value":"Permitir una vez"}},"ja-JP":{"stringUnit":{"state":"translated","value":"一度だけ許可"}},"ko":{"stringUnit":{"state":"translated","value":"한 번 허용"}},"fr":{"stringUnit":{"state":"translated","value":"Autoriser une fois"}},"hi":{"stringUnit":{"state":"translated","value":"एक बार अनुमति दें"}},"ar":{"stringUnit":{"state":"translated","value":"السماح مرة واحدة"}},"it":{"stringUnit":{"state":"translated","value":"Consenti una volta"}},"tr":{"stringUnit":{"state":"translated","value":"Bir kez izin ver"}},"uk":{"stringUnit":{"state":"translated","value":"Дозволити один раз"}},"id":{"stringUnit":{"state":"translated","value":"Izinkan sekali"}},"pl":{"stringUnit":{"state":"translated","value":"Zezwól raz"}},"th":{"stringUnit":{"state":"translated","value":"อนุญาตครั้งเดียว"}},"vi":{"stringUnit":{"state":"translated","value":"Cho phép một lần"}},"nl":{"stringUnit":{"state":"translated","value":"Eén keer toestaan"}},"fa":{"stringUnit":{"state":"translated","value":"یک‌بار اجازه بده"}},"ru":{"stringUnit":{"state":"translated","value":"Разрешить один раз"}},"sv":{"stringUnit":{"state":"translated","value":"Tillåt en gång"}}}},
    "Allow shell commands without checking the allowlist.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allow shell commands without checking the allowlist."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无需检查允许列表即可执行 shell 命令。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"允許 Shell 命令，無須檢查允許清單。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Permitir comandos de shell sem verificar a lista de permissões."}},"de":{"stringUnit":{"state":"translated","value":"Shell-Befehle zulassen, ohne die Zulassungsliste zu prüfen."}},"es":{"stringUnit":{"state":"translated","value":"Permitir comandos de shell sin comprobar la lista de permitidos."}},"ja-JP":{"stringUnit":{"state":"translated","value":"許可リストを確認せずにシェルコマンドを許可します。"}},"ko":{"stringUnit":{"state":"translated","value":"허용 목록을 확인하지 않고 셸 명령을 허용합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Autoriser les commandes shell sans vérifier la liste d’autorisation."}},"hi":{"stringUnit":{"state":"translated","value":"अनुमति-सूची की जाँच किए बिना शेल कमांड की अनुमति दें।"}},"ar":{"stringUnit":{"state":"translated","value":"السماح بأوامر shell من دون التحقق من قائمة السماح."}},"it":{"stringUnit":{"state":"translated","value":"Consenti i comandi shell senza verificare l'elenco dei comandi consentiti."}},"tr":{"stringUnit":{"state":"translated","value":"İzin verilenler listesini kontrol etmeden kabuk komutlarına izin ver."}},"uk":{"stringUnit":{"state":"translated","value":"Дозволяти команди оболонки без перевірки списку дозволених."}},"id":{"stringUnit":{"state":"translated","value":"Izinkan perintah shell tanpa memeriksa daftar izin."}},"pl":{"stringUnit":{"state":"translated","value":"Zezwalaj na polecenia powłoki bez sprawdzania listy dozwolonych."}},"th":{"stringUnit":{"state":"translated","value":"อนุญาตคำสั่งเชลล์โดยไม่ตรวจสอบรายการที่อนุญาต"}},"vi":{"stringUnit":{"state":"translated","value":"Cho phép các lệnh shell mà không cần kiểm tra danh sách cho phép."}},"nl":{"stringUnit":{"state":"translated","value":"Sta shellopdrachten toe zonder de toelatingslijst te controleren."}},"fa":{"stringUnit":{"state":"translated","value":"فرمان‌های پوسته را بدون بررسی فهرست مجاز اجرا کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Разрешать команды оболочки без проверки списка разрешений."}},"sv":{"stringUnit":{"state":"translated","value":"Tillåt skalkommandon utan att kontrollera listan över tillåtna kommandon."}}}},
    "Allow signed tools (e.g. `peekaboo`) to drive UI automation via PeekabooBridge. Requires Computer Control; otherwise run Peekaboo's own Mac app.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allow signed tools (e.g. `peekaboo`) to drive UI automation via PeekabooBridge. Requires Computer Control; otherwise run Peekaboo's own Mac app."}},"zh-CN":{"stringUnit":{"state":"translated","value":"允许已签名的工具（例如 `peekaboo`）通过 PeekabooBridge 驱动 UI 自动化。需要 Computer Control；否则请运行 Peekaboo 自己的 Mac 应用。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"允許已簽署的工具（例如 `peekaboo`）透過 PeekabooBridge 驅動 UI 自動化。需要 Computer Control；否則請執行 Peekaboo 自己的 Mac 應用程式。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Permitir que ferramentas assinadas (por exemplo, `peekaboo`) controlem a automação de UI via PeekabooBridge. Requer o Computer Control; caso contrário, execute o próprio app Mac do Peekaboo."}},"de":{"stringUnit":{"state":"translated","value":"Signierten Tools (z. B. `peekaboo`) erlauben, die UI-Automatisierung über PeekabooBridge zu steuern. Erfordert Computer Control; führen Sie andernfalls Peekaboos eigene Mac-App aus."}},"es":{"stringUnit":{"state":"translated","value":"Permite que herramientas firmadas (por ejemplo, `peekaboo`) controlen la automatización de UI mediante PeekabooBridge. Requiere Computer Control; de lo contrario, ejecuta la propia app para Mac de Peekaboo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"署名済みツール（例: `peekaboo`）が PeekabooBridge 経由で UI 自動化を実行できるようにします。Computer Control が必要です。それ以外の場合は Peekaboo 専用の Mac アプリを実行してください。"}},"ko":{"stringUnit":{"state":"translated","value":"서명된 도구(예: `peekaboo`)가 PeekabooBridge를 통해 UI 자동화를 구동하도록 허용합니다. Computer Control이 필요하며, 그렇지 않으면 Peekaboo 자체 Mac 앱을 실행하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Autoriser les outils signés (par ex. `peekaboo`) à piloter l'automatisation de l'interface via PeekabooBridge. Nécessite Computer Control ; sinon, utilisez l'application Mac de Peekaboo."}},"hi":{"stringUnit":{"state":"translated","value":"हस्ताक्षरित टूल (उदा. `peekaboo`) को PeekabooBridge के माध्यम से UI automation चलाने की अनुमति दें। इसके लिए Computer Control आवश्यक है; अन्यथा Peekaboo का अपना Mac app चलाएँ।"}},"ar":{"stringUnit":{"state":"translated","value":"السماح للأدوات الموقّعة (مثل `peekaboo`) بتشغيل أتمتة واجهة المستخدم عبر PeekabooBridge. يتطلب Computer Control؛ وإلا فشغّل تطبيق Mac الخاص بـ Peekaboo."}},"it":{"stringUnit":{"state":"translated","value":"Consenti agli strumenti firmati (ad es. `peekaboo`) di gestire l'automazione dell'interfaccia tramite PeekabooBridge. Richiede Computer Control; altrimenti esegui l'app Mac dedicata di Peekaboo."}},"tr":{"stringUnit":{"state":"translated","value":"İmzalı araçların (ör. `peekaboo`) PeekabooBridge aracılığıyla UI otomasyonunu yönetmesine izin verin. Computer Control gerektirir; aksi takdirde Peekaboo'nun kendi Mac uygulamasını çalıştırın."}},"uk":{"stringUnit":{"state":"translated","value":"Дозволити підписаним інструментам (напр. `peekaboo`) керувати автоматизацією UI через PeekabooBridge. Потрібен Computer Control; інакше запустіть власний Mac-застосунок Peekaboo."}},"id":{"stringUnit":{"state":"translated","value":"Izinkan alat bertanda tangan (mis. `peekaboo`) untuk menjalankan otomatisasi UI melalui PeekabooBridge. Memerlukan Computer Control; jika tidak, jalankan aplikasi Mac milik Peekaboo sendiri."}},"pl":{"stringUnit":{"state":"translated","value":"Zezwalaj podpisanym narzędziom (np. `peekaboo`) na sterowanie automatyzacją interfejsu za pomocą PeekabooBridge. Wymaga Computer Control; w przeciwnym razie uruchom własną aplikację Mac Peekaboo."}},"th":{"stringUnit":{"state":"translated","value":"อนุญาตให้เครื่องมือที่ลงนามแล้ว (เช่น `peekaboo`) ควบคุมการทำงานอัตโนมัติของ UI ผ่าน PeekabooBridge ต้องใช้ Computer Control มิฉะนั้นให้เรียกใช้แอป Mac ของ Peekaboo เอง"}},"vi":{"stringUnit":{"state":"translated","value":"Cho phép các công cụ đã ký (ví dụ `peekaboo`) điều khiển tự động hóa UI thông qua PeekabooBridge. Yêu cầu Computer Control; nếu không hãy chạy ứng dụng Mac riêng của Peekaboo."}},"nl":{"stringUnit":{"state":"translated","value":"Sta ondertekende tools (bijv. `peekaboo`) toe om UI-automatisering aan te sturen via PeekabooBridge. Vereist Computer Control; voer anders Peekaboo's eigen Mac-app uit."}},"fa":{"stringUnit":{"state":"translated","value":"به ابزارهای امضاشده (مثل `peekaboo`) اجازه می‌دهد تا خودکارسازی UI را از طریق PeekabooBridge هدایت کنند. به Computer Control نیاز دارد؛ در غیر این صورت اپلیکیشن Mac اختصاصی Peekaboo را اجرا کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Разрешить подписанным инструментам (например, `peekaboo`) управлять UI-автоматизацией через PeekabooBridge. Требуется Computer Control; иначе запустите собственное Mac-приложение Peekaboo."}},"sv":{"stringUnit":{"state":"translated","value":"Tillåt signerade verktyg (t.ex. `peekaboo`) att driva UI-automatisering via PeekabooBridge. Kräver Computer Control; kör annars Peekaboos egen Mac-app."}}}},
    "Allow the agent to capture a photo or short video via the built-in camera.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allow the agent to capture a photo or short video via the built-in camera."}},"zh-CN":{"stringUnit":{"state":"translated","value":"允许代理通过内置摄像头拍摄照片或短视频。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"允許代理程式透過內建相機拍攝照片或短片。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Permitir que o agente capture uma foto ou um vídeo curto pela câmera integrada."}},"de":{"stringUnit":{"state":"translated","value":"Dem Agenten erlauben, über die integrierte Kamera ein Foto oder ein kurzes Video aufzunehmen."}},"es":{"stringUnit":{"state":"translated","value":"Permitir que el agente capture una foto o un video corto mediante la cámara integrada."}},"ja-JP":{"stringUnit":{"state":"translated","value":"エージェントが内蔵カメラで写真または短い動画を撮影できるようにします。"}},"ko":{"stringUnit":{"state":"translated","value":"에이전트가 내장 카메라를 통해 사진 또는 짧은 동영상을 촬영하도록 허용합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Autoriser l’agent à capturer une photo ou une courte vidéo via la caméra intégrée."}},"hi":{"stringUnit":{"state":"translated","value":"एजेंट को बिल्ट-इन कैमरा के माध्यम से फ़ोटो या छोटा वीडियो कैप्चर करने की अनुमति दें।"}},"ar":{"stringUnit":{"state":"translated","value":"السماح للوكيل بالتقاط صورة أو فيديو قصير عبر الكاميرا المدمجة."}},"it":{"stringUnit":{"state":"translated","value":"Consenti all'agente di acquisire una foto o un breve video tramite la fotocamera integrata."}},"tr":{"stringUnit":{"state":"translated","value":"Aracının yerleşik kamera üzerinden fotoğraf veya kısa video çekmesine izin ver."}},"uk":{"stringUnit":{"state":"translated","value":"Дозволити агенту зробити фото або коротке відео за допомогою вбудованої камери."}},"id":{"stringUnit":{"state":"translated","value":"Izinkan agen mengambil foto atau video pendek melalui kamera bawaan."}},"pl":{"stringUnit":{"state":"translated","value":"Zezwalaj agentowi na zrobienie zdjęcia lub nagranie krótkiego wideo za pomocą wbudowanej kamery."}},"th":{"stringUnit":{"state":"translated","value":"อนุญาตให้เอเจนต์ถ่ายภาพหรือวิดีโอสั้นผ่านกล้องในตัว"}},"vi":{"stringUnit":{"state":"translated","value":"Cho phép tác nhân chụp ảnh hoặc quay video ngắn qua camera tích hợp."}},"nl":{"stringUnit":{"state":"translated","value":"Sta de agent toe een foto of korte video vast te leggen via de ingebouwde camera."}},"fa":{"stringUnit":{"state":"translated","value":"به عامل اجازه دهید از طریق دوربین داخلی عکس یا ویدیوی کوتاه بگیرد."}},"ru":{"stringUnit":{"state":"translated","value":"Разрешить агенту делать фото или короткое видео с помощью встроенной камеры."}},"sv":{"stringUnit":{"state":"translated","value":"Tillåt agenten att ta ett foto eller en kort video via den inbyggda kameran."}}}},
    "Allow the agent to show and control the Canvas panel.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allow the agent to show and control the Canvas panel."}},"zh-CN":{"stringUnit":{"state":"translated","value":"允许代理显示和控制 Canvas 面板。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"允許代理程式顯示並控制 Canvas 面板。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Permitir que o agente mostre e controle o painel Canvas."}},"de":{"stringUnit":{"state":"translated","value":"Dem Agenten erlauben, das Canvas-Panel anzuzeigen und zu steuern."}},"es":{"stringUnit":{"state":"translated","value":"Permitir que el agente muestre y controle el panel Canvas."}},"ja-JP":{"stringUnit":{"state":"translated","value":"エージェントが Canvas パネルを表示および操作できるようにします。"}},"ko":{"stringUnit":{"state":"translated","value":"에이전트가 Canvas 패널을 표시하고 제어하도록 허용합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Autoriser l’agent à afficher et contrôler le panneau Canvas."}},"hi":{"stringUnit":{"state":"translated","value":"एजेंट को Canvas पैनल दिखाने और नियंत्रित करने की अनुमति दें।"}},"ar":{"stringUnit":{"state":"translated","value":"السماح للوكيل بعرض لوحة Canvas والتحكم بها."}},"it":{"stringUnit":{"state":"translated","value":"Consenti all'agente di mostrare e controllare il pannello Canvas."}},"tr":{"stringUnit":{"state":"translated","value":"Aracının Canvas panelini göstermesine ve kontrol etmesine izin ver."}},"uk":{"stringUnit":{"state":"translated","value":"Дозволити агенту показувати панель Canvas і керувати нею."}},"id":{"stringUnit":{"state":"translated","value":"Izinkan agen menampilkan dan mengontrol panel Canvas."}},"pl":{"stringUnit":{"state":"translated","value":"Zezwalaj agentowi na wyświetlanie i kontrolowanie panelu Canvas."}},"th":{"stringUnit":{"state":"translated","value":"อนุญาตให้เอเจนต์แสดงและควบคุมแผง Canvas"}},"vi":{"stringUnit":{"state":"translated","value":"Cho phép tác nhân hiển thị và điều khiển bảng Canvas."}},"nl":{"stringUnit":{"state":"translated","value":"Sta de agent toe het Canvas-paneel te tonen en te bedienen."}},"fa":{"stringUnit":{"state":"translated","value":"به عامل اجازه دهید پنل Canvas را نمایش دهد و کنترل کند."}},"ru":{"stringUnit":{"state":"translated","value":"Разрешить агенту показывать панель Canvas и управлять ею."}},"sv":{"stringUnit":{"state":"translated","value":"Tillåt agenten att visa och styra Canvas-panelen."}}}},
    "Allow trusted command patterns and handle misses with prompts.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allow trusted command patterns and handle misses with prompts."}},"zh-CN":{"stringUnit":{"state":"translated","value":"允许受信任的命令模式，并在未匹配时提示确认。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"允許受信任的命令模式，並在不符合時提示確認。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Permitir padrões de comandos confiáveis e solicitar confirmação quando não houver correspondência."}},"de":{"stringUnit":{"state":"translated","value":"Vertrauenswürdige Befehlsmuster zulassen und bei Abweichungen nachfragen."}},"es":{"stringUnit":{"state":"translated","value":"Permitir patrones de comandos de confianza y solicitar confirmación para los demás."}},"ja-JP":{"stringUnit":{"state":"translated","value":"信頼済みのコマンドパターンを許可し、一致しない場合は確認を求めます。"}},"ko":{"stringUnit":{"state":"translated","value":"신뢰할 수 있는 명령 패턴을 허용하고 일치하지 않는 경우 메시지로 확인합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Autoriser les modèles de commandes fiables et demander confirmation pour les autres."}},"hi":{"stringUnit":{"state":"translated","value":"विश्वसनीय कमांड पैटर्न की अनुमति दें और मेल न मिलने पर संकेत दिखाएँ।"}},"ar":{"stringUnit":{"state":"translated","value":"السماح بأنماط الأوامر الموثوقة والتعامل مع الأوامر غير المطابقة عبر مطالبات."}},"it":{"stringUnit":{"state":"translated","value":"Consenti i modelli di comandi attendibili e, in caso di mancata corrispondenza, chiedi conferma."}},"tr":{"stringUnit":{"state":"translated","value":"Güvenilir komut kalıplarına izin ver ve eşleşmeyenleri istemlerle ele al."}},"uk":{"stringUnit":{"state":"translated","value":"Дозволяти довірені шаблони команд, а в інших випадках запитувати підтвердження."}},"id":{"stringUnit":{"state":"translated","value":"Izinkan pola perintah tepercaya dan tangani ketidakcocokan dengan permintaan konfirmasi."}},"pl":{"stringUnit":{"state":"translated","value":"Zezwalaj na zaufane wzorce poleceń, a w pozostałych przypadkach wyświetlaj monity."}},"th":{"stringUnit":{"state":"translated","value":"อนุญาตรูปแบบคำสั่งที่เชื่อถือได้ และแสดงข้อความแจ้งเมื่อไม่ตรงกับรูปแบบ"}},"vi":{"stringUnit":{"state":"translated","value":"Cho phép các mẫu lệnh đáng tin cậy và hiển thị lời nhắc khi không khớp."}},"nl":{"stringUnit":{"state":"translated","value":"Sta vertrouwde opdrachtpatronen toe en vraag om bevestiging bij niet-herkende opdrachten."}},"fa":{"stringUnit":{"state":"translated","value":"الگوهای فرمان مورد اعتماد را مجاز کنید و موارد نامطابق را با درخواست تأیید مدیریت کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Разрешать доверенные шаблоны команд, а в остальных случаях запрашивать подтверждение."}},"sv":{"stringUnit":{"state":"translated","value":"Tillåt betrodda kommandomönster och hantera avvikelser med uppmaningar."}}}},
    "Allowed Commands": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allowed Commands"}},"zh-CN":{"stringUnit":{"state":"translated","value":"允许的命令"}},"zh-TW":{"stringUnit":{"state":"translated","value":"允許的命令"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Comandos permitidos"}},"de":{"stringUnit":{"state":"translated","value":"Erlaubte Befehle"}},"es":{"stringUnit":{"state":"translated","value":"Comandos permitidos"}},"ja-JP":{"stringUnit":{"state":"translated","value":"許可済みコマンド"}},"ko":{"stringUnit":{"state":"translated","value":"허용된 명령"}},"fr":{"stringUnit":{"state":"translated","value":"Commandes autorisées"}},"hi":{"stringUnit":{"state":"translated","value":"अनुमत कमांड्स"}},"ar":{"stringUnit":{"state":"translated","value":"الأوامر المسموح بها"}},"it":{"stringUnit":{"state":"translated","value":"Comandi consentiti"}},"tr":{"stringUnit":{"state":"translated","value":"İzin Verilen Komutlar"}},"uk":{"stringUnit":{"state":"translated","value":"Дозволені команди"}},"id":{"stringUnit":{"state":"translated","value":"Perintah yang Diizinkan"}},"pl":{"stringUnit":{"state":"translated","value":"Dozwolone polecenia"}},"th":{"stringUnit":{"state":"translated","value":"คำสั่งที่อนุญาต"}},"vi":{"stringUnit":{"state":"translated","value":"Lệnh được phép"}},"nl":{"stringUnit":{"state":"translated","value":"Toegestane commando's"}},"fa":{"stringUnit":{"state":"translated","value":"فرمان‌های مجاز"}},"ru":{"stringUnit":{"state":"translated","value":"Разрешенные команды"}},"sv":{"stringUnit":{"state":"translated","value":"Tillåtna kommandon"}}}},
    "Allowed HTTPS hosts": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allowed HTTPS hosts"}},"zh-CN":{"stringUnit":{"state":"translated","value":"允许的 HTTPS 主机"}},"zh-TW":{"stringUnit":{"state":"translated","value":"允許的 HTTPS 主機"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Hosts HTTPS permitidos"}},"de":{"stringUnit":{"state":"translated","value":"Erlaubte HTTPS-Hosts"}},"es":{"stringUnit":{"state":"translated","value":"Hosts HTTPS permitidos"}},"ja-JP":{"stringUnit":{"state":"translated","value":"許可されたHTTPSホスト"}},"ko":{"stringUnit":{"state":"translated","value":"허용된 HTTPS 호스트"}},"fr":{"stringUnit":{"state":"translated","value":"Hôtes HTTPS autorisés"}},"hi":{"stringUnit":{"state":"translated","value":"अनुमत HTTPS होस्ट"}},"ar":{"stringUnit":{"state":"translated","value":"مضيفات HTTPS المسموح بها"}},"it":{"stringUnit":{"state":"translated","value":"Host HTTPS consentiti"}},"tr":{"stringUnit":{"state":"translated","value":"İzin verilen HTTPS ana bilgisayarları"}},"uk":{"stringUnit":{"state":"translated","value":"Дозволені HTTPS-хости"}},"id":{"stringUnit":{"state":"translated","value":"Host HTTPS yang diizinkan"}},"pl":{"stringUnit":{"state":"translated","value":"Dozwolone hosty HTTPS"}},"th":{"stringUnit":{"state":"translated","value":"โฮสต์ HTTPS ที่อนุญาต"}},"vi":{"stringUnit":{"state":"translated","value":"Các host HTTPS được phép"}},"nl":{"stringUnit":{"state":"translated","value":"Toegestane HTTPS-hosts"}},"fa":{"stringUnit":{"state":"translated","value":"میزبان‌های HTTPS مجاز"}},"ru":{"stringUnit":{"state":"translated","value":"Разрешённые HTTPS-хосты"}},"sv":{"stringUnit":{"state":"translated","value":"Tillåtna HTTPS-värdar"}}}},
    "Allowlist": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allowlist"}},"zh-CN":{"stringUnit":{"state":"translated","value":"允许列表"}},"zh-TW":{"stringUnit":{"state":"translated","value":"允許清單"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Lista de permissões"}},"de":{"stringUnit":{"state":"translated","value":"Zulassungsliste"}},"es":{"stringUnit":{"state":"translated","value":"Lista de permitidos"}},"ja-JP":{"stringUnit":{"state":"translated","value":"許可リスト"}},"ko":{"stringUnit":{"state":"translated","value":"허용 목록"}},"fr":{"stringUnit":{"state":"translated","value":"Liste d’autorisation"}},"hi":{"stringUnit":{"state":"translated","value":"अनुमति सूची"}},"ar":{"stringUnit":{"state":"translated","value":"قائمة السماح"}},"it":{"stringUnit":{"state":"translated","value":"Elenco consentiti"}},"tr":{"stringUnit":{"state":"translated","value":"İzin listesi"}},"uk":{"stringUnit":{"state":"translated","value":"Список дозволених"}},"id":{"stringUnit":{"state":"translated","value":"Daftar izin"}},"pl":{"stringUnit":{"state":"translated","value":"Lista dozwolonych"}},"th":{"stringUnit":{"state":"translated","value":"รายการที่อนุญาต"}},"vi":{"stringUnit":{"state":"translated","value":"Danh sách cho phép"}},"nl":{"stringUnit":{"state":"translated","value":"Toegestaan-lijst"}},"fa":{"stringUnit":{"state":"translated","value":"فهرست مجاز"}},"ru":{"stringUnit":{"state":"translated","value":"Список разрешений"}},"sv":{"stringUnit":{"state":"translated","value":"Tillåtelselista"}}}},
