    "Press start, say a trigger word, and wait for detection.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Press start, say a trigger word, and wait for detection."}},"zh-CN":{"stringUnit":{"state":"translated","value":"按下开始, 说出触发词, 然后等待检测。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"按下開始, 說出觸發詞, 然後等待偵測。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Pressione iniciar, diga uma palavra de ativação e aguarde a detecção."}},"de":{"stringUnit":{"state":"translated","value":"Drücke auf Start, sage ein Auslösewort und warte auf die Erkennung."}},"es":{"stringUnit":{"state":"translated","value":"Pulsa iniciar, di una palabra de activación y espera a que se detecte."}},"ja-JP":{"stringUnit":{"state":"translated","value":"開始を押し, トリガーワードを話して, 検出されるまでお待ちください。"}},"ko":{"stringUnit":{"state":"translated","value":"시작을 누르고 호출어를 말한 후 감지될 때까지 기다리세요."}},"fr":{"stringUnit":{"state":"translated","value":"Appuyez sur démarrer, prononcez un mot déclencheur et attendez la détection."}},"hi":{"stringUnit":{"state":"translated","value":"शुरू करें दबाएँ, कोई ट्रिगर शब्द बोलें, और उसका पता लगने की प्रतीक्षा करें."}},"ar":{"stringUnit":{"state":"translated","value":"اضغط على بدء، وقل كلمة تنشيط، وانتظر اكتشافها."}},"it":{"stringUnit":{"state":"translated","value":"Premi avvia, pronuncia una parola di attivazione e attendi il rilevamento."}},"tr":{"stringUnit":{"state":"translated","value":"Başlat'a basın, bir tetikleyici sözcük söyleyin ve algılanmasını bekleyin."}},"uk":{"stringUnit":{"state":"translated","value":"Натисніть «Почати», вимовте слово активації та зачекайте на його розпізнавання."}},"id":{"stringUnit":{"state":"translated","value":"Tekan mulai, ucapkan kata pemicu, dan tunggu hingga terdeteksi."}},"pl":{"stringUnit":{"state":"translated","value":"Naciśnij start, wypowiedz słowo wyzwalające i poczekaj na wykrycie."}},"th":{"stringUnit":{"state":"translated","value":"กดเริ่ม, พูดคำเรียกใช้งาน, แล้วรอการตรวจจับ."}},"vi":{"stringUnit":{"state":"translated","value":"Nhấn bắt đầu, nói một từ kích hoạt và chờ hệ thống phát hiện."}},"nl":{"stringUnit":{"state":"translated","value":"Druk op start, zeg een activeringswoord en wacht op detectie."}},"fa":{"stringUnit":{"state":"translated","value":"شروع را فشار دهید، یک واژهٔ فعال‌ساز بگویید و منتظر تشخیص آن بمانید."}},"ru":{"stringUnit":{"state":"translated","value":"Нажмите «Начать», произнесите слово активации и дождитесь обнаружения."}},"sv":{"stringUnit":{"state":"translated","value":"Tryck på start, säg ett aktiveringsord och vänta tills det upptäcks."}}}},
