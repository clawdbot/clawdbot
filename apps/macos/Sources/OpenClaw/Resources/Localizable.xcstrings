    "What can you do?": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"What can you do?"}},"zh-CN":{"stringUnit":{"state":"translated","value":"你能做什么？"}},"zh-TW":{"stringUnit":{"state":"translated","value":"你能做什麼？"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O que você pode fazer?"}},"de":{"stringUnit":{"state":"translated","value":"Was kannst du tun?"}},"es":{"stringUnit":{"state":"translated","value":"¿Qué puedes hacer?"}},"ja-JP":{"stringUnit":{"state":"translated","value":"何ができますか？"}},"ko":{"stringUnit":{"state":"translated","value":"어떤 일을 할 수 있나요?"}},"fr":{"stringUnit":{"state":"translated","value":"Que pouvez-vous faire ?"}},"hi":{"stringUnit":{"state":"translated","value":"आप क्या कर सकते हैं?"}},"ar":{"stringUnit":{"state":"translated","value":"ماذا يمكنك أن تفعل?"}},"it":{"stringUnit":{"state":"translated","value":"Cosa puoi fare?"}},"tr":{"stringUnit":{"state":"translated","value":"Neler yapabilirsin?"}},"uk":{"stringUnit":{"state":"translated","value":"Що ви вмієте?"}},"id":{"stringUnit":{"state":"translated","value":"Apa yang bisa Anda lakukan?"}},"pl":{"stringUnit":{"state":"translated","value":"Co potrafisz?"}},"th":{"stringUnit":{"state":"translated","value":"คุณทำอะไรได้บ้าง?"}},"vi":{"stringUnit":{"state":"translated","value":"Bạn có thể làm gì?"}},"nl":{"stringUnit":{"state":"translated","value":"Wat kun je doen?"}},"fa":{"stringUnit":{"state":"translated","value":"چه کارهایی می‌توانید انجام دهید؟"}},"ru":{"stringUnit":{"state":"translated","value":"Что ты умеешь?"}},"sv":{"stringUnit":{"state":"translated","value":"Vad kan du göra?"}}}},
    "What should OpenClaw do?": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"What should OpenClaw do?"}},"zh-CN":{"stringUnit":{"state":"translated","value":"OpenClaw 应该做什么？"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw 應該做什麼？"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O que o OpenClaw deve fazer?"}},"de":{"stringUnit":{"state":"translated","value":"Was soll OpenClaw tun?"}},"es":{"stringUnit":{"state":"translated","value":"¿Qué debería hacer OpenClaw?"}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClawに何をさせますか？"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw가 무엇을 하면 될까요?"}},"fr":{"stringUnit":{"state":"translated","value":"Que doit faire OpenClaw ?"}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw को क्या करना चाहिए?"}},"ar":{"stringUnit":{"state":"translated","value":"ما الذي ينبغي أن يفعله OpenClaw?"}},"it":{"stringUnit":{"state":"translated","value":"Cosa dovrebbe fare OpenClaw?"}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw ne yapmalı?"}},"uk":{"stringUnit":{"state":"translated","value":"Що має зробити OpenClaw?"}},"id":{"stringUnit":{"state":"translated","value":"Apa yang harus dilakukan OpenClaw?"}},"pl":{"stringUnit":{"state":"translated","value":"Co ma zrobić OpenClaw?"}},"th":{"stringUnit":{"state":"translated","value":"ต้องการให้ OpenClaw ทำอะไร?"}},"vi":{"stringUnit":{"state":"translated","value":"OpenClaw nên làm gì?"}},"nl":{"stringUnit":{"state":"translated","value":"Wat moet OpenClaw doen?"}},"fa":{"stringUnit":{"state":"translated","value":"OpenClaw باید چه کاری انجام دهد؟"}},"ru":{"stringUnit":{"state":"translated","value":"Что должен делать OpenClaw?"}},"sv":{"stringUnit":{"state":"translated","value":"Vad ska OpenClaw göra?"}}}},
    "What would you like to work on?": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"What would you like to work on?"}},"zh-CN":{"stringUnit":{"state":"translated","value":"你想处理什么？"}},"zh-TW":{"stringUnit":{"state":"translated","value":"你想處理什麼工作？"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Em que você gostaria de trabalhar?"}},"de":{"stringUnit":{"state":"translated","value":"Woran möchtest du arbeiten?"}},"es":{"stringUnit":{"state":"translated","value":"¿En qué te gustaría trabajar?"}},"ja-JP":{"stringUnit":{"state":"translated","value":"何に取り組みたいですか？"}},"ko":{"stringUnit":{"state":"translated","value":"어떤 작업을 하고 싶으신가요?"}},"fr":{"stringUnit":{"state":"translated","value":"Sur quoi souhaitez-vous travailler ?"}},"hi":{"stringUnit":{"state":"translated","value":"आप किस पर काम करना चाहेंगे?"}},"ar":{"stringUnit":{"state":"translated","value":"ما الذي تود العمل عليه؟"}},"it":{"stringUnit":{"state":"translated","value":"Su cosa vorresti lavorare?"}},"tr":{"stringUnit":{"state":"translated","value":"Ne üzerinde çalışmak istersiniz?"}},"uk":{"stringUnit":{"state":"translated","value":"Над чим ви хотіли б попрацювати?"}},"id":{"stringUnit":{"state":"translated","value":"Apa yang ingin Anda kerjakan?"}},"pl":{"stringUnit":{"state":"translated","value":"Nad czym chcesz pracować?"}},"th":{"stringUnit":{"state":"translated","value":"คุณต้องการทำอะไร?"}},"vi":{"stringUnit":{"state":"translated","value":"Bạn muốn làm việc gì?"}},"nl":{"stringUnit":{"state":"translated","value":"Waar wil je aan werken?"}},"fa":{"stringUnit":{"state":"translated","value":"مایلید روی چه چیزی کار کنید؟"}},"ru":{"stringUnit":{"state":"translated","value":"Над чем вы хотите поработать?"}},"sv":{"stringUnit":{"state":"translated","value":"Vad vill du arbeta med?"}}}},
    "When enabled, OpenClaw won't install or manage %@. It will only attach to an existing Gateway.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"When enabled, OpenClaw won't install or manage %@. It will only attach to an existing Gateway."}},"zh-CN":{"stringUnit":{"state":"translated","value":"启用后, OpenClaw 不会安装或管理 %@. 它只会连接到现有的 Gateway."}},"zh-TW":{"stringUnit":{"state":"translated","value":"啟用後, OpenClaw 不會安裝或管理 %@. 它只會連接至現有的 Gateway."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Quando ativado, o OpenClaw não instalará nem gerenciará %@. Ele apenas se conectará a um Gateway existente."}},"de":{"stringUnit":{"state":"translated","value":"Wenn diese Option aktiviert ist, installiert oder verwaltet OpenClaw %@ nicht. Es verbindet sich nur mit einem vorhandenen Gateway."}},"es":{"stringUnit":{"state":"translated","value":"Cuando esta opción esté activada, OpenClaw no instalará ni gestionará %@. Solo se conectará a un Gateway existente."}},"ja-JP":{"stringUnit":{"state":"translated","value":"有効にすると、OpenClawは%@のインストールや管理を行わず、既存のGatewayへの接続のみを行います."}},"ko":{"stringUnit":{"state":"translated","value":"활성화하면 OpenClaw는 %@ 설치나 관리를 하지 않습니다. 기존 Gateway에 연결만 합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Lorsque cette option est activée, OpenClaw n’installera ni ne gérera %@. Il se connectera uniquement à un Gateway existant."}},"hi":{"stringUnit":{"state":"translated","value":"यह चालू होने पर, OpenClaw %@ को इंस्टॉल या प्रबंधित नहीं करेगा. यह केवल मौजूदा Gateway से जुड़ेगा."}},"ar":{"stringUnit":{"state":"translated","value":"عند التمكين، لن يقوم OpenClaw بتثبيت %@ أو إدارته. وسيتصل فقط بـ Gateway موجود."}},"it":{"stringUnit":{"state":"translated","value":"Se abilitato, OpenClaw non installerà né gestirà %@. Si collegherà soltanto a un Gateway esistente."}},"tr":{"stringUnit":{"state":"translated","value":"Etkinleştirildiğinde OpenClaw, %@ kurulumunu veya yönetimini yapmaz. Yalnızca mevcut bir Gateway'e bağlanır."}},"uk":{"stringUnit":{"state":"translated","value":"Коли цей параметр увімкнено, OpenClaw не встановлюватиме %@ і не керуватиме ним. Він лише підключатиметься до наявного Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Saat diaktifkan, OpenClaw tidak akan menginstal atau mengelola %@. OpenClaw hanya akan terhubung ke Gateway yang sudah ada."}},"pl":{"stringUnit":{"state":"translated","value":"Po włączeniu tej opcji OpenClaw nie będzie instalować ani zarządzać %@. Będzie jedynie łączyć się z istniejącym Gateway."}},"th":{"stringUnit":{"state":"translated","value":"เมื่อเปิดใช้งาน OpenClaw จะไม่ติดตั้งหรือจัดการ %@ โดยจะเชื่อมต่อกับ Gateway ที่มีอยู่เท่านั้น."}},"vi":{"stringUnit":{"state":"translated","value":"Khi được bật, OpenClaw sẽ không cài đặt hoặc quản lý %@. Ứng dụng sẽ chỉ kết nối với một Gateway hiện có."}},"nl":{"stringUnit":{"state":"translated","value":"Als dit is ingeschakeld, zal OpenClaw %@ niet installeren of beheren. Het maakt alleen verbinding met een bestaande Gateway."}},"fa":{"stringUnit":{"state":"translated","value":"وقتی فعال باشد، OpenClaw دیگر %@ را نصب یا مدیریت نمی‌کند. فقط به یک Gateway موجود متصل می‌شود."}},"ru":{"stringUnit":{"state":"translated","value":"Если включено, OpenClaw не будет устанавливать %@ или управлять им. Он будет только подключаться к существующему Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"När detta är aktiverat kommer OpenClaw inte att installera eller hantera %@. Det ansluter endast till en befintlig Gateway."}}}},
    "Where should your assistant live?": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Where should your assistant live?"}},"zh-CN":{"stringUnit":{"state":"translated","value":"你的助手应该在哪里运行？"}},"zh-TW":{"stringUnit":{"state":"translated","value":"你的助理應該在哪裡執行？"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Onde seu assistente deve ficar?"}},"de":{"stringUnit":{"state":"translated","value":"Wo soll dein Assistent laufen?"}},"es":{"stringUnit":{"state":"translated","value":"¿Dónde debería residir tu asistente?"}},"ja-JP":{"stringUnit":{"state":"translated","value":"アシスタントをどこで実行しますか？"}},"ko":{"stringUnit":{"state":"translated","value":"어시스턴트를 어디에서 실행할까요?"}},"fr":{"stringUnit":{"state":"translated","value":"Où votre assistant doit-il être hébergé ?"}},"hi":{"stringUnit":{"state":"translated","value":"आपका सहायक कहाँ चलना चाहिए?"}},"ar":{"stringUnit":{"state":"translated","value":"أين ينبغي أن يعمل مساعدك?"}},"it":{"stringUnit":{"state":"translated","value":"Dove dovrebbe risiedere il tuo assistente?"}},"tr":{"stringUnit":{"state":"translated","value":"Asistanınız nerede çalışmalı?"}},"uk":{"stringUnit":{"state":"translated","value":"Де має працювати ваш асистент?"}},"id":{"stringUnit":{"state":"translated","value":"Di mana asisten Anda akan dijalankan?"}},"pl":{"stringUnit":{"state":"translated","value":"Gdzie ma działać Twój asystent?"}},"th":{"stringUnit":{"state":"translated","value":"ต้องการให้ผู้ช่วยของคุณทำงานที่ไหน?"}},"vi":{"stringUnit":{"state":"translated","value":"Bạn muốn trợ lý của mình chạy ở đâu?"}},"nl":{"stringUnit":{"state":"translated","value":"Waar moet je assistent draaien?"}},"fa":{"stringUnit":{"state":"translated","value":"دستیار شما باید کجا مستقر باشد؟"}},"ru":{"stringUnit":{"state":"translated","value":"Где разместить вашего ассистента?"}},"sv":{"stringUnit":{"state":"translated","value":"Var ska din assistent finnas?"}}}},
