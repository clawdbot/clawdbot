    "Do not fail the job if announce fails": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Do not fail the job if announce fails"}},"zh-CN":{"stringUnit":{"state":"translated","value":"如果播报失败，不要使任务失败"}},"zh-TW":{"stringUnit":{"state":"translated","value":"如果播報失敗，不要讓工作失敗"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não falhar a tarefa se o anúncio falhar"}},"de":{"stringUnit":{"state":"translated","value":"Job nicht fehlschlagen lassen, wenn die Ankündigung fehlschlägt"}},"es":{"stringUnit":{"state":"translated","value":"No fallar el trabajo si el anuncio falla"}},"ja-JP":{"stringUnit":{"state":"translated","value":"announce が失敗してもジョブを失敗にしない"}},"ko":{"stringUnit":{"state":"translated","value":"알림에 실패해도 작업을 실패로 처리하지 않음"}},"fr":{"stringUnit":{"state":"translated","value":"Ne pas faire échouer la tâche si l’annonce échoue"}},"hi":{"stringUnit":{"state":"translated","value":"यदि घोषणा विफल हो जाए तो जॉब को विफल न करें"}},"ar":{"stringUnit":{"state":"translated","value":"لا تُفشل المهمة إذا فشل الإعلان"}},"it":{"stringUnit":{"state":"translated","value":"Non far fallire il job se l'annuncio non riesce"}},"tr":{"stringUnit":{"state":"translated","value":"Duyuru başarısız olursa işi başarısız sayma"}},"uk":{"stringUnit":{"state":"translated","value":"Не завершувати завдання помилкою, якщо оголошення не вдасться"}},"id":{"stringUnit":{"state":"translated","value":"Jangan gagalkan tugas jika pengumuman gagal"}},"pl":{"stringUnit":{"state":"translated","value":"Nie oznaczaj zadania jako nieudanego, jeśli ogłoszenie się nie powiedzie"}},"th":{"stringUnit":{"state":"translated","value":"อย่าทำให้งานล้มเหลวหากการประกาศล้มเหลว"}},"vi":{"stringUnit":{"state":"translated","value":"Không làm tác vụ thất bại nếu thông báo thất bại"}},"nl":{"stringUnit":{"state":"translated","value":"Laat de taak niet mislukken als aankondigen mislukt"}},"fa":{"stringUnit":{"state":"translated","value":"اگر اعلام ناموفق بود، کار را ناموفق نکنید"}},"ru":{"stringUnit":{"s