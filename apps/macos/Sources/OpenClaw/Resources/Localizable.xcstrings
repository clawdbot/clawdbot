    "Sending a screenshot uses macOS Screen Recording access.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Sending a screenshot uses macOS Screen Recording access."}},"zh-CN":{"stringUnit":{"state":"translated","value":"发送屏幕截图需要 macOS 屏幕录制权限。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"傳送螢幕截圖需要 macOS 的螢幕錄製權限。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O envio de uma imagem da tela usa o acesso à Gravação de Tela do macOS."}},"de":{"stringUnit":{"state":"translated","value":"Zum Senden eines Bildschirmfotos ist der macOS-Zugriff für Bildschirmaufnahmen erforderlich."}},"es":{"stringUnit":{"state":"translated","value":"Para enviar una captura de pantalla, se requiere acceso a Grabación de pantalla de macOS."}},"ja-JP":{"stringUnit":{"state":"translated","value":"スクリーンショットを送信するには、macOSの画面収録へのアクセス権が必要です。"}},"ko":{"stringUnit":{"state":"translated","value":"스크린샷을 보내려면 macOS 화면 기록 접근 권한이 필요합니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’envoi d’une capture d’écran nécessite l’accès à l’enregistrement de l’écran de macOS."}},"hi":{"stringUnit":{"state":"translated","value":"स्क्रीनशॉट भेजने के लिए macOS Screen Recording एक्सेस का उपयोग किया जाता है।"}},"ar":{"stringUnit":{"state":"translated","value":"يتطلب إرسال لقطة شاشة إذن تسجيل الشاشة في macOS."}},"it":{"stringUnit":{"state":"translated","value":"L'invio di uno screenshot richiede l'accesso alla registrazione dello schermo di macOS."}},"tr":{"stringUnit":{"state":"translated","value":"Ekran görüntüsü göndermek için macOS Ekran Kaydı erişimi gerekir."}},"uk":{"stringUnit":{"state":"translated","value":"Для надсилання знімка екрана потрібен доступ до запису екрана в macOS."}},"id":{"stringUnit":{"state":"translated","value":"Mengirim tangkapan layar menggunakan akses Perekaman Layar macOS."}},"pl":{"stringUnit":{"state":"translated","value":"Wysyłanie zrzutu ekranu wymaga dostępu do nagrywania ekranu w macOS."}},"th":{"stringUnit":{"state":"translated","value