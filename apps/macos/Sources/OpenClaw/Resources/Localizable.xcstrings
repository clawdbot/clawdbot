    "Microphone and speech recognition permission required.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Microphone and speech recognition permission required."}},"zh-CN":{"stringUnit":{"state":"translated","value":"需要麦克风和语音识别权限。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"需要麥克風與語音辨識權限。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"É necessário permitir o acesso ao microfone e ao reconhecimento de fala."}},"de":{"stringUnit":{"state":"translated","value":"Berechtigung für Mikrofon und Spracherkennung erforderlich."}},"es":{"stringUnit":{"state":"translated","value":"Se requieren permisos para usar el micrófono y el reconocimiento de voz."}},"ja-JP":{"stringUnit":{"state":"translated","value":"マイクと音声認識の権限が必要です。"}},"ko":{"stringUnit":{"state":"translated","value":"마이크 및 음성 인식 권한이 필요합니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’autorisation d’accéder au microphone et à la reconnaissance vocale est requise."}},"hi":{"stringUnit":{"state":"translated","value":"माइक्रोफ़ोन और वाक् पहचान की अनुमति आवश्यक है।"}},"ar":{"stringUnit":{"state":"translated","value":"يلزم منح إذن استخدام الميكروفون والتعرّف على الكلام."}},"it":{"stringUnit":{"state":"translated","value":"È richiesta l'autorizzazione per il microfono e il riconoscimento vocale."}},"tr":{"stringUnit":{"state":"translated","value":"Mikrofon ve konuşma tanıma izni gerekiyor."}},"uk":{"stringUnit":{"state":"translated","value":"Потрібен дозвіл на використання мікрофона та розпізнавання мовлення."}},"id":{"stringUnit":{"state":"translated","value":"Izin mikrofon dan pengenalan ucapan diperlukan."}},"pl":{"stringUnit":{"state":"translated","value":"Wymagane są uprawnienia do mikrofonu i rozpoznawania mowy."}},"th":{"stringUnit":{"state":"translated","value":"ต้องอนุญาตการเข้าถึงไมโครโฟนและการรู้จำเสียงพูด"}},"vi":{"stringUnit":{"state":"translated","value":"Cần có quyền truy cập micrô và nhận dạng giọng nói."}},"nl":{"stringUnit":{"state":"translated","value":