    "Skip Gateway setup for now; pick Local or Remote later in Settings → General.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Skip Gateway setup for now; pick Local or Remote later in Settings → General."}},"zh-CN":{"stringUnit":{"state":"translated","value":"暂时跳过 Gateway 设置；稍后可在设置 → 通用中选择本地或远程。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"暫時略過 Gateway 設定；稍後可在「設定」→「一般」中選擇本機或遠端。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Pule a configuração do Gateway por enquanto; escolha Local ou Remoto depois em Ajustes → Geral."}},"de":{"stringUnit":{"state":"translated","value":"Gateway-Einrichtung vorerst überspringen; wählen Sie später in Einstellungen → Allgemein Lokal oder Remote aus."}},"es":{"stringUnit":{"state":"translated","value":"Omitir la configuración de Gateway por ahora; elige Local o Remote más tarde en Ajustes → General."}},"ja-JP":{"stringUnit":{"state":"translated","value":"今は Gateway のセットアップをスキップします。あとで設定 → 一般で Local または Remote を選択してください。"}},"ko":{"stringUnit":{"state":"translated","value":"지금은 Gateway 설정을 건너뛰고, 나중에 설정 → 일반에서 Local 또는 Remote를 선택하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Ignorer la configuration de Gateway pour le moment ; choisissez Local ou Remote plus tard dans Réglages → Général."}},"hi":{"stringUnit":{"state":"translated","value":"अभी के लिए Gateway सेटअप छोड़ें; बाद में Settings → General में Local या Remote चुनें।"}},"ar":{"stringUnit":{"state":"translated","value":"تخطَّ إعداد Gateway الآن؛ اختر Local أو Remote لاحقًا من الإعدادات → عام."}},"it":{"stringUnit":{"state":"translated","value":"Salta per ora la configurazione del Gateway; scegli Locale o Remoto più tardi in Impostazioni → Generali."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway kurulumunu şimdilik atlayın; daha sonra Ayarlar → Genel bölümünde Local veya Remote’u seçin."}},"uk":{"stringUnit":{"state":"translated","value":"Поки пропустити налаштування Gateway; виберіть Local або Remote пізніше в Налаштуваннях → General."}},"id":{"stringUnit":{"state":"translated","value":"Lewati penyiapan Gateway untuk saat ini; pilih Lokal atau Jarak Jauh nanti di Pengaturan → Umum."}},"pl":{"stringUnit":{"state":"translated","value":"Na razie pomiń konfigurację Gateway; wybierz Local lub Remote później w Ustawienia → Ogólne."}},"th":{"stringUnit":{"state":"translated","value":"ข้ามการตั้งค่า Gateway ไว้ก่อน เลือก Local หรือ Remote ภายหลังใน Settings → General"}},"vi":{"stringUnit":{"state":"translated","value":"Tạm thời bỏ qua thiết lập Gateway; chọn Local hoặc Remote sau trong Cài đặt → Cài đặt chung."}},"nl":{"stringUnit":{"state":"translated","value":"Sla de Gateway-installatie voorlopig over; kies later Lokaal of Extern in Instellingen → Algemeen."}},"fa":{"stringUnit":{"state":"translated","value":"فعلاً راه‌اندازی Gateway را رد کنید؛ بعداً در Settings → General، Local یا Remote را انتخاب کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Пока пропустить настройку Gateway; выберите Local или Remote позже в Настройках → Основные."}},"sv":{"stringUnit":{"state":"translated","value":"Hoppa över Gateway-konfigurationen tills vidare; välj Lokalt eller Fjärranslutet senare i Inställningar → Allmänt."}}}},
