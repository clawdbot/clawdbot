    "Stored in ~/.openclaw/openclaw.json. Prefer OPENCLAW_GATEWAY_PASSWORD for production.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Stored in ~/.openclaw/openclaw.json. Prefer OPENCLAW_GATEWAY_PASSWORD for production."}},"zh-CN":{"stringUnit":{"state":"translated","value":"存储在 ~/.openclaw/openclaw.json 中。 生产环境建议使用 OPENCLAW_GATEWAY_PASSWORD."}},"zh-TW":{"stringUnit":{"state":"translated","value":"儲存於 ~/.openclaw/openclaw.json. 正式環境建議使用 OPENCLAW_GATEWAY_PASSWORD."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Armazenado em ~/.openclaw/openclaw.json. Prefira OPENCLAW_GATEWAY_PASSWORD em produção."}},"de":{"stringUnit":{"state":"translated","value":"Gespeichert in ~/.openclaw/openclaw.json. Für den Produktivbetrieb bevorzugt OPENCLAW_GATEWAY_PASSWORD verwenden."}},"es":{"stringUnit":{"state":"translated","value":"Se almacena en ~/.openclaw/openclaw.json. Es preferible usar OPENCLAW_GATEWAY_PASSWORD en producción."}},"ja-JP":{"stringUnit":{"state":"translated","value":"~/.openclaw/openclaw.json に保存されます。 本番環境では OPENCLAW_GATEWAY_PASSWORD を推奨します。"}},"ko":{"stringUnit":{"state":"translated","value":"~/.openclaw/openclaw.json에 저장됩니다. 프로덕션 환경에서는 OPENCLAW_GATEWAY_PASSWORD 사용을 권장합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Stocké dans ~/.openclaw/openclaw.json. Privilégiez OPENCLAW_GATEWAY_PASSWORD en production."}},"hi":{"stringUnit":{"state":"translated","value":"~/.openclaw/openclaw.json में संग्रहीत. प्रोडक्शन के लिए OPENCLAW_GATEWAY_PASSWORD को प्राथमिकता दें."}},"ar":{"stringUnit":{"state":"translated","value":"يُخزَّن في ~/.openclaw/openclaw.json. يُفضَّل استخدام OPENCLAW_GATEWAY_PASSWORD في بيئة الإنتاج."}},"it":{"stringUnit":{"state":"translated","value":"Salvato in ~/.openclaw/openclaw.json. In produzione, preferisci OPENCLAW_GATEWAY_PASSWORD."}},"tr":{"stringUnit":{"state":"translated","value":"~/.openclaw/openclaw.json dosyasında saklanır. Üretim ortamı için OPENCLAW_GATEWAY_PASSWORD kullanmayı tercih edin."}},"uk":{