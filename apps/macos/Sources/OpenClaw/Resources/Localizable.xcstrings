    "Available after the current response finishes.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Available after the current response finishes."}},"zh-CN":{"stringUnit":{"state":"translated","value":"当前回复完成后可用。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"目前的回應完成後即可使用。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Disponível após a conclusão da resposta atual."}},"de":{"stringUnit":{"state":"translated","value":"Verfügbar, sobald die aktuelle Antwort abgeschlossen ist."}},"es":{"stringUnit":{"state":"translated","value":"Disponible cuando finalice la respuesta actual."}},"ja-JP":{"stringUnit":{"state":"translated","value":"現在の応答が完了すると利用できます。"}},"ko":{"stringUnit":{"state":"translated","value":"현재 응답이 완료되면 사용할 수 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Disponible une fois la réponse en cours terminée."}},"hi":{"stringUnit":{"state":"translated","value":"वर्तमान उत्तर पूरा होने के बाद उपलब्ध होगा."}},"ar":{"stringUnit":{"state":"translated","value":"متاح بعد اكتمال الرد الحالي."}},"it":{"stringUnit":{"state":"translated","value":"Disponibile al termine della risposta corrente."}},"tr":{"stringUnit":{"state":"translated","value":"Mevcut yanıt tamamlandıktan sonra kullanılabilir."}},"uk":{"stringUnit":{"state":"translated","value":"Буде доступно після завершення поточної відповіді."}},"id":{"stringUnit":{"state":"translated","value":"Tersedia setelah respons saat ini selesai."}},"pl":{"stringUnit":{"state":"translated","value":"Dostępne po zakończeniu bieżącej odpowiedzi."}},"th":{"stringUnit":{"state":"translated","value":"พร้อมใช้งานหลังจากการตอบกลับปัจจุบันเสร็จสิ้น."}},"vi":{"stringUnit":{"state":"translated","value":"Khả dụng sau khi phản hồi hiện tại hoàn tất."}},"nl":{"stringUnit":{"state":"translated","value":"Beschikbaar zodra het huidige antwoord is voltooid."}},"fa":{"stringUnit":{"state":"translated","value":"پس از پایان پاسخ فعلی در دسترس خواهد بود."}},"ru":{"stringUnit":{"state":"translated","