    "Agents can run shell commands on this Mac without allowlist checks.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Agents can run shell commands on this Mac without allowlist checks."}},"zh-CN":{"stringUnit":{"state":"translated","value":"智能体可以在此 Mac 上运行 shell 命令，无需进行允许列表检查。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"代理程式可在此 Mac 上執行 Shell 命令，無需經過允許清單檢查。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Os agentes podem executar comandos de shell neste Mac sem verificações da lista de permissões."}},"de":{"stringUnit":{"state":"translated","value":"Agenten können auf diesem Mac Shell-Befehle ohne Prüfung anhand einer Zulassungsliste ausführen."}},"es":{"stringUnit":{"state":"translated","value":"Los agentes pueden ejecutar comandos de shell en este Mac sin comprobaciones de la lista de permitidos."}},"ja-JP":{"stringUnit":{"state":"translated","value":"エージェントは許可リストのチェックなしで、このMac上でシェルコマンドを実行できます。"}},"ko":{"stringUnit":{"state":"translated","value":"에이전트는 허용 목록 확인 없이 이 Mac에서 셸 명령을 실행할 수 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les agents peuvent exécuter des commandes shell sur ce Mac sans vérification de la liste d’autorisation."}},"hi":{"stringUnit":{"state":"translated","value":"एजेंट इस Mac पर अनुमति-सूची की जाँच किए बिना शेल कमांड चला सकते हैं."}},"ar":{"stringUnit":{"state":"translated","value":"يمكن للوكلاء تشغيل أوامر الصدفة على جهاز Mac هذا دون التحقق من قائمة السماح."}},"it":{"stringUnit":{"state":"translated","value":"Gli agenti possono eseguire comandi shell su questo Mac senza controlli sull'elenco degli elementi consentiti."}},"tr":{"stringUnit":{"state":"translated","value":"Ajanlar bu Mac üzerinde izin listesi denetimleri olmadan kabuk komutları çalıştırabilir."}},"uk":{"stringUnit":{"state":"translated","value":"Агенти можуть виконувати команди оболонки на цьому Mac без перевірок за списком дозволених."}},"id":{"stringUnit":{"state":"translated","value":"Agen dapat menjalankan perintah shell di Mac ini tanpa pemeriksaan daftar izin."}},"pl":{"stringUnit":{"state":"translated","value":"Agenci mogą uruchamiać polecenia powłoki na tym Macu bez sprawdzania listy dozwolonych poleceń."}},"th":{"stringUnit":{"state":"translated","value":"เอเจนต์สามารถเรียกใช้คำสั่งเชลล์บน Mac เครื่องนี้ได้โดยไม่ต้องตรวจสอบรายการที่อนุญาต."}},"vi":{"stringUnit":{"state":"translated","value":"Các tác nhân có thể chạy lệnh shell trên máy Mac này mà không cần kiểm tra danh sách cho phép."}},"nl":{"stringUnit":{"state":"translated","value":"Agents kunnen shellopdrachten uitvoeren op deze Mac zonder controles aan de hand van de toelatingslijst."}},"fa":{"stringUnit":{"state":"translated","value":"عامل‌ها می‌توانند فرمان‌های پوسته را در این Mac بدون بررسی فهرست مجاز اجرا کنند."}},"ru":{"stringUnit":{"state":"translated","value":"Агенты могут выполнять команды оболочки на этом Mac без проверки по списку разрешённых команд."}},"sv":{"stringUnit":{"state":"translated","value":"Agenter kan köra skalkommandon på den här Mac-datorn utan kontroller mot tillåtelselistan."}}}},
