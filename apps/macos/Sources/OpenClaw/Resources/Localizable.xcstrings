    "Verify OpenClaw can reach this gateway.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Verify OpenClaw can reach this gateway."}},"zh-CN":{"stringUnit":{"state":"translated","value":"验证 OpenClaw 能否访问此 Gateway."}},"zh-TW":{"stringUnit":{"state":"translated","value":"確認 OpenClaw 可以連線至此 Gateway."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Verifique se o OpenClaw consegue acessar este Gateway."}},"de":{"stringUnit":{"state":"translated","value":"Prüfen Sie, ob OpenClaw dieses Gateway erreichen kann."}},"es":{"stringUnit":{"state":"translated","value":"Verifica que OpenClaw pueda conectarse a este Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClaw がこの Gateway に接続できることを確認してください。"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw가 이 Gateway에 연결할 수 있는지 확인하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Vérifiez qu’OpenClaw peut accéder à ce Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"सत्यापित करें कि OpenClaw इस Gateway तक पहुँच सकता है."}},"ar":{"stringUnit":{"state":"translated","value":"تحقّق من قدرة OpenClaw على الوصول إلى هذه البوابة."}},"it":{"stringUnit":{"state":"translated","value":"Verifica che OpenClaw possa raggiungere questo gateway."}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw'un bu Gateway'e erişebildiğini doğrulayın."}},"uk":{"stringUnit":{"state":"translated","value":"Перевірте, чи може OpenClaw підключитися до цього Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Pastikan OpenClaw dapat menjangkau gateway ini."}},"pl":{"stringUnit":{"state":"translated","value":"Sprawdź, czy OpenClaw może połączyć się z tą bramą."}},"th":{"stringUnit":{"state":"translated","value":"ตรวจสอบว่า OpenClaw สามารถเข้าถึง Gateway นี้ได้."}},"vi":{"stringUnit":{"state":"translated","value":"Xác minh OpenClaw có thể kết nối đến gateway này."}},"nl":{"stringUnit":{"state":"translated","value":"Controleer of OpenClaw deze gateway kan bereiken."}},"fa":{"