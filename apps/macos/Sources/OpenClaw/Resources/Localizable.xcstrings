    "Gateway changed before the thread operation started.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Gateway changed before the thread operation started."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Gateway 在线程操作开始前已更改。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 在討論串操作開始前已變更。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Gateway mudou antes do início da operação na conversa."}},"de":{"stringUnit":{"state":"translated","value":"Das Gateway wurde vor dem Start des Thread-Vorgangs geändert."}},"es":{"stringUnit":{"state":"translated","value":"Gateway cambió antes de que se iniciara la operación del hilo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"スレッド操作の開始前に Gateway が変更されました。"}},"ko":{"stringUnit":{"state":"translated","value":"스레드 작업이 시작되기 전에 Gateway가 변경되었습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Gateway a changé avant le début de l’opération sur le fil de discussion."}},"hi":{"stringUnit":{"state":"translated","value":"थ्रेड कार्रवाई शुरू होने से पहले Gateway बदल गया।"}},"ar":{"stringUnit":{"state":"translated","value":"تغيّر Gateway قبل بدء العملية على سلسلة المحادثة."}},"it":{"stringUnit":{"state":"translated","value":"Gateway è cambiato prima dell'avvio dell'operazione sul thread."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway, konuşma işlemi başlamadan önce değişti."}},"uk":{"stringUnit":{"state":"translated","value":"Gateway змінився до початку операції з гілкою."}},"id":{"stringUnit":{"state":"translated","value":"Gateway berubah sebelum operasi utas dimulai."}},"pl":{"stringUnit":{"state":"translated","value":"Gateway zmienił się przed rozpoczęciem operacji na wątku."}},"th":{"stringUnit":{"state":"translated","value":"Gateway เปลี่ยนแปลงก่อนเริ่มดำเนินการกับเธรด."}},"vi":{"stringUnit":{"state":"translated","value":"Gateway đã thay đổi trước khi thao tác với luồng bắt đầu."}},"nl":{"stringUnit":{"state":"translated","value":"Gateway is gewijzigd vo