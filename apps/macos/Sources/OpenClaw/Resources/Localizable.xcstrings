    "Setup code expired or already used. Scan a fresh setup code, then try again.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Setup code expired or already used. Scan a fresh setup code, then try again."}},"zh-CN":{"stringUnit":{"state":"translated","value":"设置码已过期或已被使用。 请扫描新的设置码, 然后重试。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"設定碼已過期或已使用。請掃描新的設定碼，然後再試一次。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O código de configuração expirou ou já foi usado. Escaneie um novo código de configuração e tente novamente."}},"de":{"stringUnit":{"state":"translated","value":"Einrichtungscode abgelaufen oder bereits verwendet. Scanne einen neuen Einrichtungscode und versuche es erneut."}},"es":{"stringUnit":{"state":"translated","value":"El código de configuración ha caducado o ya se ha utilizado. Escanea un nuevo código de configuración y vuelve a intentarlo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"セットアップコードは有効期限が切れているか、すでに使用されています。 新しいセットアップコードをスキャンして、もう一度お試しください。"}},"ko":{"stringUnit":{"state":"translated","value":"설정 코드가 만료되었거나 이미 사용되었습니다. 새 설정 코드를 스캔한 후 다시 시도하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Code de configuration expiré ou déjà utilisé. Scannez un nouveau code de configuration, puis réessayez."}},"hi":{"stringUnit":{"state":"translated","value":"सेटअप कोड की समय-सीमा समाप्त हो गई है या इसका पहले ही उपयोग हो चुका है. नया सेटअप कोड स्कैन करें, फिर दोबारा कोशिश करें."}},"ar":{"stringUnit":{"state":"translated","value":"انتهت صلاحية رمز الإعداد أو استُخدم بالفعل. امسح رمز إعداد جديدًا، ثم حاول مرة أخرى."}},"it":{"stringUnit":{"state":"translated","value":"Codice di configurazione scaduto o già utilizzato. Scansiona un nuovo codice di configurazione, poi riprova."}},"tr":{"stringUnit":{"state":"translated","value":"Kurulum kodunun süresi dolmuş veya kod zaten kullanılmış. Yeni bir kurulum kodu tarayın, ardından tekrar deneyin."}},"uk":{"stringUnit":{"state":"translated","value":"Термін дії коду налаштування минув або його вже використано. Відскануйте новий код налаштування та спробуйте ще раз."}},"id":{"stringUnit":{"state":"translated","value":"Kode penyiapan kedaluwarsa atau sudah digunakan. Pindai kode penyiapan baru, lalu coba lagi."}},"pl":{"stringUnit":{"state":"translated","value":"Kod konfiguracji wygasł lub został już użyty. Zeskanuj nowy kod konfiguracji, a następnie spróbuj ponownie."}},"th":{"stringUnit":{"state":"translated","value":"รหัสตั้งค่าหมดอายุหรือถูกใช้ไปแล้ว สแกนรหัสตั้งค่าใหม่ แล้วลองอีกครั้ง"}},"vi":{"stringUnit":{"state":"translated","value":"Mã thiết lập đã hết hạn hoặc đã được sử dụng. Quét mã thiết lập mới, rồi thử lại."}},"nl":{"stringUnit":{"state":"translated","value":"Configuratiecode verlopen of al gebruikt. Scan een nieuwe configuratiecode en probeer het opnieuw."}},"fa":{"stringUnit":{"state":"translated","value":"کد راه‌اندازی منقضی شده یا قبلاً استفاده شده است. یک کد راه‌اندازی تازه را اسکن کنید، سپس دوباره امتحان کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Срок действия кода настройки истёк или код уже использован. Отсканируйте новый код настройки, затем повторите попытку."}},"sv":{"stringUnit":{"state":"translated","value":"Konfigurationskoden har gått ut eller har redan använts. Skanna en ny konfigurationskod och försök igen."}}}},
    "Setup needed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Setup needed"}},"zh-CN":{"stringUnit":{"state":"translated","value":"需要设置"}},"zh-TW":{"stringUnit":{"state":"translated","value":"需要設定"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Configuração necessária"}},"de":{"stringUnit":{"state":"translated","value":"Einrichtung erforderlich"}},"es":{"stringUnit":{"state":"translated","value":"Se requiere configuración"}},"ja-JP":{"stringUnit":{"state":"translated","value":"セットアップが必要です"}},"ko":{"stringUnit":{"state":"translated","value":"설정 필요"}},"fr":{"stringUnit":{"state":"translated","value":"Configuration requise"}},"hi":{"stringUnit":{"state":"translated","value":"सेटअप आवश्यक है"}},"ar":{"stringUnit":{"state":"translated","value":"الإعداد مطلوب"}},"it":{"stringUnit":{"state":"translated","value":"Configurazione necessaria"}},"tr":{"stringUnit":{"state":"translated","value":"Kurulum gerekli"}},"uk":{"stringUnit":{"state":"translated","value":"Потрібне налаштування"}},"id":{"stringUnit":{"state":"translated","value":"Penyiapan diperlukan"}},"pl":{"stringUnit":{"state":"translated","value":"Wymagana konfiguracja"}},"th":{"stringUnit":{"state":"translated","value":"ต้องตั้งค่า"}},"vi":{"stringUnit":{"state":"translated","value":"Cần thiết lập"}},"nl":{"stringUnit":{"state":"translated","value":"Configuratie vereist"}},"fa":{"stringUnit":{"state":"translated","value":"راه‌اندازی لازم است"}},"ru":{"stringUnit":{"state":"translated","value":"Требуется настройка"}},"sv":{"stringUnit":{"state":"translated","value":"Konfiguration krävs"}}}},
    "Share location when requested by the agent": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Share location when requested by the agent"}},"zh-CN":{"stringUnit":{"state":"translated","value":"在智能体请求时共享位置"}},"zh-TW":{"stringUnit":{"state":"translated","value":"在代理程式要求時分享位置"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Compartilhar localização quando solicitado pelo agente"}},"de":{"stringUnit":{"state":"translated","value":"Standort auf Anfrage des Agenten teilen"}},"es":{"stringUnit":{"state":"translated","value":"Compartir ubicación cuando lo solicite el agente"}},"ja-JP":{"stringUnit":{"state":"translated","value":"エージェントから要求されたときに位置情報を共有"}},"ko":{"stringUnit":{"state":"translated","value":"에이전트가 요청할 때 위치 공유"}},"fr":{"stringUnit":{"state":"translated","value":"Partager la position à la demande de l’agent"}},"hi":{"stringUnit":{"state":"translated","value":"एजेंट के अनुरोध करने पर स्थान साझा करें"}},"ar":{"stringUnit":{"state":"translated","value":"مشاركة الموقع عندما يطلبه الوكيل"}},"it":{"stringUnit":{"state":"translated","value":"Condividi la posizione quando richiesto dall'agente"}},"tr":{"stringUnit":{"state":"translated","value":"Ajan istediğinde konumu paylaş"}},"uk":{"stringUnit":{"state":"translated","value":"Надавати геопозицію на запит агента"}},"id":{"stringUnit":{"state":"translated","value":"Bagikan lokasi saat diminta oleh agen"}},"pl":{"stringUnit":{"state":"translated","value":"Udostępniaj lokalizację na żądanie agenta"}},"th":{"stringUnit":{"state":"translated","value":"แชร์ตำแหน่งเมื่อเอเจนต์ร้องขอ"}},"vi":{"stringUnit":{"state":"translated","value":"Chia sẻ vị trí khi tác nhân yêu cầu"}},"nl":{"stringUnit":{"state":"translated","value":"Locatie delen wanneer de agent daarom vraagt"}},"fa":{"stringUnit":{"state":"translated","value":"اشتراک‌گذاری موقعیت مکانی هنگام درخواست عامل"}},"ru":{"stringUnit":{"state":"translated","value":"Передавать местоположение по запросу агента"}},"sv":{"stringUnit":{"state":"translated","value":"Dela plats när agenten begär det"}}}},
    "Share this Mac's idle duration so OpenClaw can identify the Mac you used most recently and route node alerts. Never sends keys, pointer positions, app names, or window titles. Requires Accessibility.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Share this Mac's idle duration so OpenClaw can identify the Mac you used most recently and route node alerts. Never sends keys, pointer positions, app names, or window titles. Requires Accessibility."}},"zh-CN":{"stringUnit":{"state":"translated","value":"共享此 Mac 的空闲时长, 以便 OpenClaw 识别你最近使用的 Mac 并路由节点提醒。 绝不会发送按键、指针位置、应用名称或窗口标题。 需要辅助功能权限。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"分享這部 Mac 的閒置時間，讓 OpenClaw 能辨識您最近使用的 Mac 並轉送節點通知。絕不傳送按鍵、指標位置、App 名稱或視窗標題。需要「輔助使用」權限。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Compartilhe o tempo de inatividade deste Mac para que o OpenClaw possa identificar o Mac que você usou mais recentemente e encaminhar alertas dos nós. Nunca envia teclas, posições do ponteiro, nomes de apps ou títulos de janelas. Requer Acessibilidade."}},"de":{"stringUnit":{"state":"translated","value":"Teile die Inaktivitätsdauer dieses Mac, damit OpenClaw den zuletzt verwendeten Mac identifizieren und Knotenwarnungen weiterleiten kann. Tasteneingaben, Zeigerpositionen, App-Namen oder Fenstertitel werden niemals gesendet. Erfordert Zugriff auf Bedienungshilfen."}},"es":{"stringUnit":{"state":"translated","value":"Comparte el tiempo de inactividad de este Mac para que OpenClaw pueda identificar el Mac que has usado más recientemente y dirigir las alertas de los nodos. Nunca envía pulsaciones de teclas, posiciones del puntero, nombres de aplicaciones ni títulos de ventanas. Requiere Accesibilidad."}},"ja-JP":{"stringUnit":{"state":"translated","value":"この Mac のアイドル時間を共有し、OpenClaw が最後に使用した Mac を特定してノード通知の送信先を決定できるようにします。 キー入力、ポインタの位置、アプリ名、ウィンドウのタイトルは一切送信しません。 アクセシビリティ権限が必要です。"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw가 가장 최근에 사용한 Mac을 식별하고 노드 알림을 전달할 수 있도록 이 Mac의 유휴 시간을 공유합니다. 키 입력, 포인터 위치, 앱 이름 또는 윈도우 제목은 절대 전송하지 않습니다. 손쉬운 사용 권한이 필요합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Partagez la durée d’inactivité de ce Mac afin qu’OpenClaw puisse identifier le Mac que vous avez utilisé le plus récemment et acheminer les alertes des nœuds. Aucune touche, position du pointeur, nom d’application ni titre de fenêtre n’est jamais envoyé. Nécessite l’autorisation d’accessibilité."}},"hi":{"stringUnit":{"state":"translated","value":"इस Mac की निष्क्रियता की अवधि साझा करें ताकि OpenClaw आपके सबसे हाल में उपयोग किए गए Mac की पहचान कर सके और नोड अलर्ट भेज सके. कभी भी कुंजियाँ, पॉइंटर की स्थितियाँ, ऐप के नाम या विंडो के शीर्षक नहीं भेजता. सुलभता की अनुमति आवश्यक है."}},"ar":{"stringUnit":{"state":"translated","value":"شارك مدة خمول جهاز Mac هذا ليتمكن OpenClaw من تحديد جهاز Mac الذي استخدمته مؤخرًا وتوجيه تنبيهات العُقد. لا يرسل مطلقًا ضغطات المفاتيح أو مواضع المؤشر أو أسماء التطبيقات أو عناوين النوافذ. يتطلب إذن تسهيلات الاستخدام."}},"it":{"stringUnit":{"state":"translated","value":"Condividi la durata di inattività di questo Mac per consentire a OpenClaw di identificare il Mac utilizzato più di recente e indirizzare gli avvisi dei nodi. Non invia mai tasti premuti, posizioni del puntatore, nomi delle app o titoli delle finestre. Richiede Accessibilità."}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw'un en son kullandığınız Mac'i belirleyebilmesi ve düğüm uyarılarını yönlendirebilmesi için bu Mac'in boşta kalma süresini paylaşın. Tuşları, işaretçi konumlarını, uygulama adlarını veya pencere başlıklarını asla göndermez. Erişilebilirlik izni gerektirir."}},"uk":{"stringUnit":{"state":"translated","value":"Надавайте дані про тривалість бездіяльності цього Mac, щоб OpenClaw міг визначити Mac, яким ви користувалися востаннє, і спрямовувати сповіщення вузлів. Натискання клавіш, положення вказівника, назви програм і заголовки вікон ніколи не надсилаються. Потрібен дозвіл у розділі «Доступність»."}},"id":{"stringUnit":{"state":"translated","value":"Bagikan durasi tidak aktif Mac ini agar OpenClaw dapat mengidentifikasi Mac yang terakhir Anda gunakan dan mengarahkan peringatan node. Tidak pernah mengirim tombol yang ditekan, posisi penunjuk, nama aplikasi, atau judul jendela. Memerlukan Aksesibilitas."}},"pl":{"stringUnit":{"state":"translated","value":"Udostępniaj czas bezczynności tego Maca, aby OpenClaw mógł rozpoznać ostatnio używanego Maca i kierować do niego alerty węzłów. Nigdy nie wysyła informacji o naciskanych klawiszach, pozycji wskaźnika, nazwach aplikacji ani tytułach okien. Wymaga uprawnień dostępności."}},"th":{"stringUnit":{"state":"translated","value":"แชร์ระยะเวลาที่ไม่ได้ใช้งาน Mac เครื่องนี้ เพื่อให้ OpenClaw ระบุ Mac ที่คุณใช้ล่าสุดและส่งการแจ้งเตือนโหนดไปยังเครื่องนั้น จะไม่ส่งข้อมูลปุ่มที่กด ตำแหน่งตัวชี้ ชื่อแอป หรือชื่อหน้าต่าง ต้องได้รับสิทธิ์การช่วยการเข้าถึง"}},"vi":{"stringUnit":{"state":"translated","value":"Chia sẻ thời gian không hoạt động của máy Mac này để OpenClaw có thể xác định máy Mac bạn sử dụng gần đây nhất và định tuyến cảnh báo của nút. Không bao giờ gửi phím đã nhấn, vị trí con trỏ, tên ứng dụng hoặc tiêu đề cửa sổ. Yêu cầu quyền Trợ năng."}},"nl":{"stringUnit":{"state":"translated","value":"Deel hoelang deze Mac inactief is, zodat OpenClaw kan bepalen welke Mac je het laatst hebt gebruikt en nodemeldingen kan doorsturen. Verstuurt nooit toetsaanslagen, aanwijzerposities, appnamen of venstertitels. Vereist Toegankelijkheid."}},"fa":{"stringUnit":{"state":"translated","value":"مدت بی‌کاری این Mac را به اشتراک بگذارید تا OpenClaw بتواند Mac مورد استفاده اخیر شما را شناسایی کند و هشدارهای گره را هدایت کند. کلیدهای فشرده‌شده، موقعیت نشانگر، نام برنامه‌ها یا عنوان پنجره‌ها هرگز ارسال نمی‌شوند. به مجوز دسترس‌پذیری نیاز دارد."}},"ru":{"stringUnit":{"state":"translated","value":"Передавать время бездействия этого Mac, чтобы OpenClaw мог определить, каким Mac вы пользовались последним, и направлять уведомления узлов. Нажатия клавиш, положение указателя, названия приложений и заголовки окон никогда не передаются. Требуется доступ к функциям универсального доступа."}},"sv":{"stringUnit":{"state":"translated","value":"Dela hur länge den här Mac-datorn har varit inaktiv så att OpenClaw kan identifiera den Mac du använde senast och dirigera nodaviseringar. Skickar aldrig tangenttryckningar, pekarpositioner, appnamn eller fönstertitlar. Kräver Hjälpmedel."}}}},
    "Shell commands allowed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Shell commands allowed"}},"zh-CN":{"stringUnit":{"state":"translated","value":"已允许 Shell 命令"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已允許 Shell 指令"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Comandos de shell permitidos"}},"de":{"stringUnit":{"state":"translated","value":"Shell-Befehle erlaubt"}},"es":{"stringUnit":{"state":"translated","value":"Comandos de shell permitidos"}},"ja-JP":{"stringUnit":{"state":"translated","value":"シェルコマンドが許可されています"}},"ko":{"stringUnit":{"state":"translated","value":"셸 명령 허용됨"}},"fr":{"stringUnit":{"state":"translated","value":"Commandes shell autorisées"}},"hi":{"stringUnit":{"state":"translated","value":"शेल कमांड की अनुमति है"}},"ar":{"stringUnit":{"state":"translated","value":"أوامر الصدفة مسموح بها"}},"it":{"stringUnit":{"state":"translated","value":"Comandi shell consentiti"}},"tr":{"stringUnit":{"state":"translated","value":"Kabuk komutlarına izin veriliyor"}},"uk":{"stringUnit":{"state":"translated","value":"Команди оболонки дозволено"}},"id":{"stringUnit":{"state":"translated","value":"Perintah shell diizinkan"}},"pl":{"stringUnit":{"state":"translated","value":"Polecenia powłoki dozwolone"}},"th":{"stringUnit":{"state":"translated","value":"อนุญาตคำสั่งเชลล์แล้ว"}},"vi":{"stringUnit":{"state":"translated","value":"Đã cho phép lệnh shell"}},"nl":{"stringUnit":{"state":"translated","value":"Shellcommando's toegestaan"}},"fa":{"stringUnit":{"state":"translated","value":"فرمان‌های پوسته مجاز هستند"}},"ru":{"stringUnit":{"state":"translated","value":"Команды оболочки разрешены"}},"sv":{"stringUnit":{"state":"translated","value":"Skalkommandon tillåtna"}}}},
    "Shell commands blocked": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Shell commands blocked"}},"zh-CN":{"stringUnit":{"state":"translated","value":"已阻止 Shell 命令"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已封鎖 Shell 指令"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Comandos de shell bloqueados"}},"de":{"stringUnit":{"state":"translated","value":"Shell-Befehle blockiert"}},"es":{"stringUnit":{"state":"translated","value":"Comandos de shell bloqueados"}},"ja-JP":{"stringUnit":{"state":"translated","value":"シェルコマンドがブロックされています"}},"ko":{"stringUnit":{"state":"translated","value":"셸 명령 차단됨"}},"fr":{"stringUnit":{"state":"translated","value":"Commandes shell bloquées"}},"hi":{"stringUnit":{"state":"translated","value":"शेल कमांड अवरुद्ध हैं"}},"ar":{"stringUnit":{"state":"translated","value":"أوامر الصدفة محظورة"}},"it":{"stringUnit":{"state":"translated","value":"Comandi shell bloccati"}},"tr":{"stringUnit":{"state":"translated","value":"Kabuk komutları engellendi"}},"uk":{"stringUnit":{"state":"translated","value":"Команди оболонки заблоковано"}},"id":{"stringUnit":{"state":"translated","value":"Perintah shell diblokir"}},"pl":{"stringUnit":{"state":"translated","value":"Polecenia powłoki zablokowane"}},"th":{"stringUnit":{"state":"translated","value":"บล็อกคำสั่งเชลล์แล้ว"}},"vi":{"stringUnit":{"state":"translated","value":"Đã chặn lệnh shell"}},"nl":{"stringUnit":{"state":"translated","value":"Shellcommando's geblokkeerd"}},"fa":{"stringUnit":{"state":"translated","value":"فرمان‌های پوسته مسدود هستند"}},"ru":{"stringUnit":{"state":"translated","value":"Команды оболочки заблокированы"}},"sv":{"stringUnit":{"state":"translated","value":"Skalkommandon blockerade"}}}},
    "Shelling": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Shelling"}},"zh-CN":{"stringUnit":{"state":"translated","value":"正在执行 Shell 命令"}},"zh-TW":{"stringUnit":{"state":"translated","value":"正在執行 Shell 指令"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Executando no shell"}},"de":{"stringUnit":{"state":"translated","value":"Shell-Befehl wird ausgeführt"}},"es":{"stringUnit":{"state":"translated","value":"Ejecutando comandos de shell"}},"ja-JP":{"stringUnit":{"state":"translated","value":"シェル実行中"}},"ko":{"stringUnit":{"state":"translated","value":"셸 실행 중"}},"fr":{"stringUnit":{"state":"translated","value":"Exécution de commandes shell"}},"hi":{"stringUnit":{"state":"translated","value":"शेल कमांड चल रहे हैं"}},"ar":{"stringUnit":{"state":"translated","value":"جارٍ تنفيذ أوامر الصدفة"}},"it":{"stringUnit":{"state":"translated","value":"Esecuzione nella shell"}},"tr":{"stringUnit":{"state":"translated","value":"Kabuk komutları çalıştırılıyor"}},"uk":{"stringUnit":{"state":"translated","value":"Виконання команд оболонки"}},"id":{"stringUnit":{"state":"translated","value":"Menjalankan shell"}},"pl":{"stringUnit":{"state":"translated","value":"Wykonywanie poleceń powłoki"}},"th":{"stringUnit":{"state":"translated","value":"กำลังเรียกใช้เชลล์"}},"vi":{"stringUnit":{"state":"translated","value":"Đang chạy lệnh shell"}},"nl":{"stringUnit":{"state":"translated","value":"Shellcommando's uitvoeren"}},"fa":{"stringUnit":{"state":"translated","value":"در حال اجرای فرمان پوسته"}},"ru":{"stringUnit":{"state":"translated","value":"Выполнение команд оболочки"}},"sv":{"stringUnit":{"state":"translated","value":"Kör skalkommandon"}}}},
    "Short phrases that start voice wake detection.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Short phrases that start voice wake detection."}},"zh-CN":{"stringUnit":{"state":"translated","value":"用于触发语音唤醒检测的短语。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"用來啟動語音喚醒偵測的簡短片語。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Frases curtas que acionam a detecção de ativação por voz."}},"de":{"stringUnit":{"state":"translated","value":"Kurze Ausdrücke, die die Sprachaktivierung auslösen."}},"es":{"stringUnit":{"state":"translated","value":"Frases cortas que inician la detección de activación por voz."}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声起動の検出を開始する短いフレーズ。"}},"ko":{"stringUnit":{"state":"translated","value":"음성 호출 감지를 시작하는 짧은 문구입니다."}},"fr":{"stringUnit":{"state":"translated","value":"Courtes phrases qui déclenchent la détection de l’activation vocale."}},"hi":{"stringUnit":{"state":"translated","value":"आवाज़ से सक्रिय करने की पहचान शुरू करने वाले छोटे वाक्यांश."}},"ar":{"stringUnit":{"state":"translated","value":"عبارات قصيرة تُفعّل التنبيه بالصوت عند اكتشافها."}},"it":{"stringUnit":{"state":"translated","value":"Brevi frasi che avviano il rilevamento dell'attivazione vocale."}},"tr":{"stringUnit":{"state":"translated","value":"Sesle uyandırma algılamasını başlatan kısa ifadeler."}},"uk":{"stringUnit":{"state":"translated","value":"Короткі фрази, які запускають виявлення голосової активації."}},"id":{"stringUnit":{"state":"translated","value":"Frasa pendek yang memulai deteksi aktivasi suara."}},"pl":{"stringUnit":{"state":"translated","value":"Krótkie frazy uruchamiające wybudzanie głosowe."}},"th":{"stringUnit":{"state":"translated","value":"วลีสั้นๆ ที่ใช้เรียกให้เริ่มทำงานด้วยเสียง"}},"vi":{"stringUnit":{"state":"translated","value":"Các cụm từ ngắn để kích hoạt tính năng đánh thức bằng giọng nói."}},"nl":{"stringUnit":{"state":"translated","value":"Korte zinnen die spraakactivering starten."}},"fa":{"