    "Gateway token mismatch. Run openclaw gateway auth-token --show on the gateway host.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Gateway token mismatch. Run openclaw gateway auth-token --show on the gateway host."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Gateway 令牌不匹配。请在 Gateway 主机上运行 openclaw gateway auth-token --show。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 權杖不符。 請在 Gateway 主機上執行 openclaw gateway auth-token --show."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O token do Gateway não corresponde. Execute openclaw gateway auth-token --show no host do Gateway."}},"de":{"stringUnit":{"state":"translated","value":"Gateway-Token stimmt nicht überein. Führen Sie openclaw gateway auth-token --show auf dem Gateway-Host aus."}},"es":{"stringUnit":{"state":"translated","value":"El token de Gateway no coincide. Ejecuta openclaw gateway auth-token --show en el host de Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayトークンが一致しません。 Gatewayホストでopenclaw gateway auth-token --showを実行してください。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway 토큰이 일치하지 않습니다. Gateway 호스트에서 openclaw gateway auth-token --show를 실행하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Le jeton du Gateway ne correspond pas. Exécutez openclaw gateway auth-token --show sur l’hôte du Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway टोकन मेल नहीं खाता. Gateway होस्ट पर openclaw gateway auth-token --show चलाएँ."}},"ar":{"stringUnit":{"state":"translated","value":"رمز Gateway غير متطابق. شغّل openclaw gateway auth-token --show على مضيف Gateway."}},"it":{"stringUnit":{"state":"translated","value":"Il token del Gateway non corrisponde. Esegui openclaw gateway auth-token --show sull'host del Gateway."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway belirteci uyuşmuyor. Gateway ana makinesinde openclaw gateway auth-token --show komutunu çalıştırın."}},"uk":{"stringUnit":{"state":"translated","value":"Токен Gateway не збігається. Виконайте openclaw gateway auth-token --show на хості Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Token Gateway tidak cocok. Jalankan openclaw gateway auth-token --show di host gateway."}},"pl":{"stringUnit":{"state":"translated","value":"Niezgodność tokenu Gateway. Uruchom openclaw gateway auth-token --show na hoście Gateway."}},"th":{"stringUnit":{"state":"translated","value":"โทเค็น Gateway ไม่ตรงกัน. เรียกใช้ openclaw gateway auth-token --show บนโฮสต์ Gateway."}},"vi":{"stringUnit":{"state":"translated","value":"Token Gateway không khớp. Chạy openclaw gateway auth-token --show trên máy chủ Gateway."}},"nl":{"stringUnit":{"state":"translated","value":"Gateway-token komt niet overeen. Voer openclaw gateway auth-token --show uit op de Gateway-host."}},"fa":{"stringUnit":{"state":"translated","value":"توکن Gateway مطابقت ندارد. دستور openclaw gateway auth-token --show را روی میزبان Gateway اجرا کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Токен Gateway не совпадает. Выполните openclaw gateway auth-token --show на хосте Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Gateway-token stämmer inte överens. Kör openclaw gateway auth-token --show på Gateway-värden."}}}},
