    "Credentials are stored with this profile in your Mac Keychain.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Credentials are stored with this profile in your Mac Keychain."}},"zh-CN":{"stringUnit":{"state":"translated","value":"凭据随此配置文件一起存储在你的 Mac 钥匙串中。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"憑證會與此設定檔一同儲存在您的 Mac 鑰匙圈中。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"As credenciais são armazenadas com este perfil no Keychain do seu Mac."}},"de":{"stringUnit":{"state":"translated","value":"Die Zugangsdaten werden mit diesem Profil in Ihrem Mac-Schlüsselbund gespeichert."}},"es":{"stringUnit":{"state":"translated","value":"Las credenciales se guardan con este perfil en el llavero de tu Mac."}},"ja-JP":{"stringUnit":{"state":"translated","value":"認証情報は、このプロファイルとともにMacのキーチェーンに保存されます。"}},"ko":{"stringUnit":{"state":"translated","value":"인증 정보는 이 프로필과 함께 Mac 키체인에 저장됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les identifiants sont stockés avec ce profil dans le trousseau de votre Mac."}},"hi":{"stringUnit":{"state":"translated","value":"क्रेडेंशियल इस प्रोफ़ाइल के साथ आपके Mac Keychain में संग्रहीत किए जाते हैं."}},"ar":{"stringUnit":{"state":"translated","value":"تُخزَّن بيانات الاعتماد مع هذا الملف الشخصي في سلسلة مفاتيح Mac."}},"it":{"stringUnit":{"state":"translated","value":"Le credenziali vengono archiviate con questo profilo nel Portachiavi del Mac."}},"tr":{"stringUnit":{"state":"translated","value":"Kimlik bilgileri, Mac Anahtar Zincirinizde bu profille birlikte saklanır."}},"uk":{"stringUnit":{"state":"translated","value":"Облікові дані зберігаються разом із цим профілем у В’язці ключів вашого Mac."}},"id":{"stringUnit":{"state":"translated","value":"Kredensial disimpan bersama profil ini di Keychain Mac Anda."}},"pl":{"stringUnit":{"state":"translated","value":"Dane uwierzytelniające są przechowywane wraz z tym profilem w pęku kluczy na Macu."}},"th":{"stringUnit":{"state":"translated","value":"ข้อ