    "Write sample page": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Write sample page"}},"zh-CN":{"stringUnit":{"state":"translated","value":"写入示例页面"}},"zh-TW":{"stringUnit":{"state":"translated","value":"寫入範例頁面"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escrever página de exemplo"}},"de":{"stringUnit":{"state":"translated","value":"Beispielseite schreiben"}},"es":{"stringUnit":{"state":"translated","value":"Escribir página de ejemplo"}},"ja-JP":{"stringUnit":{"state":"translated","value":"サンプルページを書き込む"}},"ko":{"stringUnit":{"state":"translated","value":"샘플 페이지 작성"}},"fr":{"stringUnit":{"state":"translated","value":"Écrire une page d’exemple"}},"hi":{"stringUnit":{"state":"translated","value":"नमूना पृष्ठ लिखें"}},"ar":{"stringUnit":{"state":"translated","value":"كتابة صفحة نموذجية"}},"it":{"stringUnit":{"state":"translated","value":"Scrivi pagina di esempio"}},"tr":{"stringUnit":{"state":"translated","value":"Örnek sayfa yaz"}},"uk":{"stringUnit":{"state":"translated","value":"Записати зразок сторінки"}},"id":{"stringUnit":{"state":"translated","value":"Tulis halaman contoh"}},"pl":{"stringUnit":{"state":"translated","value":"Zapisz przykładową stronę"}},"th":{"stringUnit":{"state":"translated","value":"เขียนหน้าตัวอย่าง"}},"vi":{"stringUnit":{"state":"translated","value":"Ghi trang mẫu"}},"nl":{"stringUnit":{"state":"translated","value":"Voorbeeldpagina schrijven"}},"fa":{"stringUnit":{"state":"translated","value":"نوشتن صفحه نمونه"}},"ru":{"stringUnit":{"state":"translated","value":"Записать пример страницы"}},"sv":{"stringUnit":{"state":"translated","value":"Skriv exempelsida"}}}},
    "Writes a rotating, local-only log under ~/Library/Logs/OpenClaw/. Enable only while actively debugging.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Writes a rotating, local-only log under ~/Library/Logs/OpenClaw/. Enable only while actively debugging."}},"zh-CN":{"stringUnit":{"state":"translated","value":"在 ~/Library/Logs/OpenClaw/ 下写入仅保存在本地的轮转日志。请仅在调试期间启用。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"在 ~/Library/Logs/OpenClaw/ 下寫入僅儲存於本機的輪替日誌。請僅在進行偵錯時啟用。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Grava um log rotativo, apenas local, em ~/Library/Logs/OpenClaw/. Ative apenas durante a depuração."}},"de":{"stringUnit":{"state":"translated","value":"Schreibt ein rotierendes, ausschließlich lokales Protokoll unter ~/Library/Logs/OpenClaw/. Nur während der aktiven Fehlersuche aktivieren."}},"es":{"stringUnit":{"state":"translated","value":"Escribe un registro rotativo, exclusivamente local, en ~/Library/Logs/OpenClaw/. Actívalo solo mientras estés depurando."}},"ja-JP":{"stringUnit":{"state":"translated","value":"~/Library/Logs/OpenClaw/ に、ローカル限定のローテーション式ログを書き込みます。デバッグ中のみ有効にしてください。"}},"ko":{"stringUnit":{"state":"translated","value":"~/Library/Logs/OpenClaw/ 아래에 로컬 전용 순환 로그를 기록합니다. 디버깅 중에만 활성화하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Écrit un journal avec rotation, uniquement en local, dans ~/Library/Logs/OpenClaw/. À activer uniquement pendant le débogage."}},"hi":{"stringUnit":{"state":"translated","value":"~/Library/Logs/OpenClaw/ में केवल स्थानीय रूप से संग्रहीत, रोटेट होने वाला लॉग लिखता है. केवल सक्रिय रूप से डीबग करते समय ही सक्षम करें."}},"ar":{"stringUnit":{"state":"translated","value":"يكتب سجلًا دوريًا محليًا فقط ضمن ~/Library/Logs/OpenClaw/. لا تُفعّله إلا أثناء تصحيح الأخطاء فعليًا."}},"it":{"stringUnit":{"state":"translated","value":"Scrive un log a rotazione, solo in locale, in ~/Library/Logs/OpenClaw/. Abilita solo durante il debug attivo."}},"tr":{"stringUnit":{"state":"translated","value":"~/Library/Logs/OpenClaw/ altında yalnızca yerel olarak tutulan döngüsel bir günlük yazar. Yalnızca etkin olarak hata ayıklarken etkinleştirin."}},"uk":{"stringUnit":{"state":"translated","value":"Записує журнал із ротацією лише локально в ~/Library/Logs/OpenClaw/. Увімкніть лише на час активного налагодження."}},"id":{"stringUnit":{"state":"translated","value":"Menulis log berotasi yang hanya disimpan secara lokal di ~/Library/Logs/OpenClaw/. Aktifkan hanya saat sedang melakukan debug."}},"pl":{"stringUnit":{"state":"translated","value":"Zapisuje rotacyjny dziennik wyłącznie lokalnie w ~/Library/Logs/OpenClaw/. Włączaj tylko podczas aktywnego debugowania."}},"th":{"stringUnit":{"state":"translated","value":"เขียนบันทึกแบบหมุนเวียนที่จัดเก็บเฉพาะในเครื่องไว้ที่ ~/Library/Logs/OpenClaw/. เปิดใช้เฉพาะขณะกำลังแก้ไขข้อบกพร่องเท่านั้น."}},"vi":{"stringUnit":{"state":"translated","value":"Ghi nhật ký luân phiên, chỉ lưu cục bộ trong ~/Library/Logs/OpenClaw/. Chỉ bật khi đang gỡ lỗi."}},"nl":{"stringUnit":{"state":"translated","value":"Schrijft een roterend, uitsluitend lokaal logboek in ~/Library/Logs/OpenClaw/. Schakel dit alleen in tijdens actief debuggen."}},"fa":{"stringUnit":{"state":"translated","value":"یک گزارش چرخشی و صرفاً محلی در مسیر ~/Library/Logs/OpenClaw/ می‌نویسد. فقط هنگام عیب‌یابی فعال، آن را فعال کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Записывает журнал с ротацией только локально в ~/Library/Logs/OpenClaw/. Включайте только на время активной отладки."}},"sv":{"stringUnit":{"state":"translated","value":"Skriver en roterande logg som endast lagras lokalt under ~/Library/Logs/OpenClaw/. Aktivera endast vid aktiv felsökning."}}}},
    "Writing": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Writing"}},"zh-CN":{"stringUnit":{"state":"translated","value":"正在写入"}},"zh-TW":{"stringUnit":{"state":"translated","value":"寫入中"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escrevendo"}},"de":{"stringUnit":{"state":"translated","value":"Schreiben"}},"es":{"stringUnit":{"state":"translated","value":"Escribiendo"}},"ja-JP":{"stringUnit":{"state":"translated","value":"書き込み中"}},"ko":{"stringUnit":{"state":"translated","value":"작성 중"}},"fr":{"stringUnit":{"state":"translated","value":"Écriture"}},"hi":{"stringUnit":{"state":"translated","value":"लेखन"}},"ar":{"stringUnit":{"state":"translated","value":"جارٍ الكتابة"}},"it":{"stringUnit":{"state":"translated","value":"Scrittura in corso"}},"tr":{"stringUnit":{"state":"translated","value":"Yazılıyor"}},"uk":{"stringUnit":{"state":"translated","value":"Записування"}},"id":{"stringUnit":{"state":"translated","value":"Menulis"}},"pl":{"stringUnit":{"state":"translated","value":"Zapisywanie"}},"th":{"stringUnit":{"state":"translated","value":"กำลังเขียน"}},"vi":{"stringUnit":{"state":"translated","value":"Đang ghi"}},"nl":{"stringUnit":{"state":"translated","value":"Schrijven"}},"fa":{"stringUnit":{"state":"translated","value":"در حال نوشتن"}},"ru":{"stringUnit":{"state":"translated","value":"Запись"}},"sv":{"stringUnit":{"state":"translated","value":"Skriver"}}}},
    "Yellow": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Yellow"}},"zh-CN":{"stringUnit":{"state":"translated","value":"黄色"}},"zh-TW":{"stringUnit":{"state":"translated","value":"黃色"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Amarelo"}},"de":{"stringUnit":{"state":"translated","value":"Gelb"}},"es":{"stringUnit":{"state":"translated","value":"Amarillo"}},"ja-JP":{"stringUnit":{"state":"translated","value":"黄色"}},"ko":{"stringUnit":{"state":"translated","value":"노란색"}},"fr":{"stringUnit":{"state":"translated","value":"Jaune"}},"hi":{"stringUnit":{"state":"translated","value":"पीला"}},"ar":{"stringUnit":{"state":"translated","value":"أصفر"}},"it":{"stringUnit":{"state":"translated","value":"Giallo"}},"tr":{"stringUnit":{"state":"translated","value":"Sarı"}},"uk":{"stringUnit":{"state":"translated","value":"Жовтий"}},"id":{"stringUnit":{"state":"translated","value":"Kuning"}},"pl":{"stringUnit":{"state":"translated","value":"Żółty"}},"th":{"stringUnit":{"state":"translated","value":"สีเหลือง"}},"vi":{"stringUnit":{"state":"translated","value":"Vàng"}},"nl":{"stringUnit":{"state":"translated","value":"Geel"}},"fa":{"stringUnit":{"state":"translated","value":"زرد"}},"ru":{"stringUnit":{"state":"translated","value":"Жёлтый"}},"sv":{"stringUnit":{"state":"translated","value":"Gul"}}}},
    "You": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"You"}},"zh-CN":{"stringUnit":{"state":"translated","value":"你"}},"zh-TW":{"stringUnit":{"state":"translated","value":"你"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Você"}},"de":{"stringUnit":{"state":"translated","value":"Du"}},"es":{"stringUnit":{"state":"translated","value":"Tú"}},"ja-JP":{"stringUnit":{"state":"translated","value":"あなた"}},"ko":{"stringUnit":{"state":"translated","value":"나"}},"fr":{"stringUnit":{"state":"translated","value":"Vous"}},"hi":{"stringUnit":{"state":"translated","value":"आप"}},"ar":{"stringUnit":{"state":"translated","value":"أنت"}},"it":{"stringUnit":{"state":"translated","value":"Tu"}},"tr":{"stringUnit":{"state":"translated","value":"Siz"}},"uk":{"stringUnit":{"state":"translated","value":"Ви"}},"id":{"stringUnit":{"state":"translated","value":"Anda"}},"pl":{"stringUnit":{"state":"translated","value":"Ty"}},"th":{"stringUnit":{"state":"translated","value":"คุณ"}},"vi":{"stringUnit":{"state":"translated","value":"Bạn"}},"nl":{"stringUnit":{"state":"translated","value":"U"}},"fa":{"stringUnit":{"state":"translated","value":"شما"}},"ru":{"stringUnit":{"state":"translated","value":"Вы"}},"sv":{"stringUnit":{"state":"translated","value":"Du"}}}},
    "Your agent could not be notified yet. OpenClaw will retry after the next app launch.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your agent could not be notified yet. OpenClaw will retry after the next app launch."}},"zh-CN":{"stringUnit":{"state":"translated","value":"暂时无法通知你的智能体。OpenClaw 将在下次启动应用后重试。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"目前尚無法通知你的代理。OpenClaw 將在下次啟動應用程式後重試。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ainda não foi possível notificar seu agente. O OpenClaw tentará novamente na próxima inicialização do aplicativo."}},"de":{"stringUnit":{"state":"translated","value":"Dein Agent konnte noch nicht benachrichtigt werden. OpenClaw versucht es nach dem nächsten App-Start erneut."}},"es":{"stringUnit":{"state":"translated","value":"Aún no se ha podido notificar a tu agente. OpenClaw lo volverá a intentar la próxima vez que se inicie la aplicación."}},"ja-JP":{"stringUnit":{"state":"translated","value":"エージェントにまだ通知できていません。OpenClaw は次回のアプリ起動後に再試行します。"}},"ko":{"stringUnit":{"state":"translated","value":"아직 에이전트에 알리지 못했습니다. 다음 앱 실행 후 OpenClaw가 다시 시도합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Votre agent n’a pas encore pu être averti. OpenClaw réessaiera au prochain lancement de l’application."}},"hi":{"stringUnit":{"state":"translated","value":"आपके एजेंट को अभी सूचित नहीं किया जा सका. अगली बार ऐप लॉन्च होने के बाद OpenClaw फिर से प्रयास करेगा."}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر إخطار وكيلك حتى الآن. سيعيد OpenClaw المحاولة عند تشغيل التطبيق في المرة القادمة."}},"it":{"stringUnit":{"state":"translated","value":"Non è stato ancora possibile avvisare il tuo agente. OpenClaw riproverà al prossimo avvio dell'app."}},"tr":{"stringUnit":{"state":"translated","value":"Ajanınıza henüz bildirim gönderilemedi. OpenClaw, uygulamanın bir sonraki açılışında yeniden deneyecek."}},"uk":{"stringUnit":{"state":"translated","value":"Поки що не вдалося сповістити вашого агента. OpenClaw повторить спробу після наступного запуску застосунку."}},"id":{"stringUnit":{"state":"translated","value":"Agen Anda belum dapat diberi tahu. OpenClaw akan mencoba lagi setelah aplikasi diluncurkan berikutnya."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się jeszcze powiadomić Twojego agenta. OpenClaw spróbuje ponownie po następnym uruchomieniu aplikacji."}},"th":{"stringUnit":{"state":"translated","value":"ยังไม่สามารถแจ้งเอเจนต์ของคุณได้ OpenClaw จะลองอีกครั้งหลังจากเปิดแอปครั้งถัดไป."}},"vi":{"stringUnit":{"state":"translated","value":"Chưa thể thông báo cho tác nhân của bạn. OpenClaw sẽ thử lại sau lần khởi chạy ứng dụng tiếp theo."}},"nl":{"stringUnit":{"state":"translated","value":"Je agent kon nog niet op de hoogte worden gebracht. OpenClaw probeert het opnieuw nadat de app de volgende keer is gestart."}},"fa":{"stringUnit":{"state":"translated","value":"هنوز امکان اطلاع‌رسانی به عامل شما فراهم نشده است. OpenClaw پس از اجرای بعدی برنامه دوباره تلاش می‌کند."}},"ru":{"stringUnit":{"state":"translated","value":"Пока не удалось уведомить вашего агента. OpenClaw повторит попытку после следующего запуска приложения."}},"sv":{"stringUnit":{"state":"translated","value":"Din agent kunde inte meddelas ännu. OpenClaw försöker igen nästa gång appen startas."}}}},
    "Your personal AI assistant, living on your own Mac.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your personal AI assistant, living on your own Mac."}},"zh-CN":{"stringUnit":{"state":"translated","value":"你的个人 AI 助手，运行在你自己的 Mac 上。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"你的個人 AI 助理，就在你自己的 Mac 上。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Seu assistente pessoal de IA, no seu próprio Mac."}},"de":{"stringUnit":{"state":"translated","value":"Dein persönlicher KI-Assistent, direkt auf deinem eigenen Mac."}},"es":{"stringUnit":{"state":"translated","value":"Tu asistente personal de IA, en tu propio Mac."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ご自身の Mac 上で動作する、あなた専用の AI アシスタント。"}},"ko":{"stringUnit":{"state":"translated","value":"내 Mac에서 실행되는 나만의 AI 어시스턴트."}},"fr":{"stringUnit":{"state":"translated","value":"Votre assistant IA personnel, installé sur votre propre Mac."}},"hi":{"stringUnit":{"state":"translated","value":"आपका निजी AI सहायक, आपके अपने Mac पर."}},"ar":{"stringUnit":{"state":"translated","value":"مساعدك الشخصي بالذكاء الاصطناعي، على جهاز Mac الخاص بك."}},"it":{"stringUnit":{"state":"translated","value":"Il tuo assistente IA personale, sul tuo Mac."}},"tr":{"stringUnit":{"state":"translated","value":"Kendi Mac'inizde yaşayan kişisel yapay zeka asistanınız."}},"uk":{"stringUnit":{"state":"translated","value":"Ваш персональний ШІ-помічник, що живе на вашому власному Mac."}},"id":{"stringUnit":{"state":"translated","value":"Asisten AI pribadi Anda, yang berada di Mac Anda sendiri."}},"pl":{"stringUnit":{"state":"translated","value":"Twój osobisty asystent AI, działający na Twoim własnym Macu."}},"th":{"stringUnit":{"state":"translated","value":"ผู้ช่วย AI ส่วนตัวของคุณที่อยู่บน Mac ของคุณเอง."}},"vi":{"stringUnit":{"state":"translated","value":"Trợ lý AI cá nhân của bạn, ngay trên máy Mac của chính bạn."}},"nl":{"stringUnit":{"state":"translated","value":"Je persoonlijke AI-assistent, op je eigen Mac."}},"fa":{"stringUnit":{"state":"translated","value":"دستیار شخصی هوش مصنوعی شما، روی Mac خودتان."}},"ru":{"stringUnit":{"state":"translated","value":"Ваш персональный ИИ-помощник, работающий на вашем Mac."}},"sv":{"stringUnit":{"state":"translated","value":"Din personliga AI-assistent som finns på din egen Mac."}}}},
    "Your sign-in is saved in Mac Keychain. Removing this Gateway signs you out of the app.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your sign-in is saved in Mac Keychain. Removing this Gateway signs you out of the app."}},"zh-CN":{"stringUnit":{"state":"translated","value":"你的登录信息已保存在 Mac 钥匙串中。移除此 Gateway 将使你退出此应用的登录。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"您的登入資訊已儲存在 Mac 鑰匙圈中。移除此 Gateway 會將您登出此 App。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Seu login está salvo no Mac Keychain. Ao remover este Gateway, você sai da sua conta no app."}},"de":{"stringUnit":{"state":"translated","value":"Ihre Anmeldedaten sind im Mac-Schlüsselbund gespeichert. Wenn Sie dieses Gateway entfernen, werden Sie von der App abgemeldet."}},"es":{"stringUnit":{"state":"translated","value":"Tus credenciales de inicio de sesión están guardadas en el llavero del Mac. Si eliminas este Gateway, se cerrará tu sesión en la aplicación."}},"ja-JP":{"stringUnit":{"state":"translated","value":"サインイン情報はMacのキーチェーンに保存されています。このGatewayを削除すると、アプリからサインアウトします。"}},"ko":{"stringUnit":{"state":"translated","value":"로그인 정보가 Mac 키체인에 저장되어 있습니다. 이 Gateway를 제거하면 앱에서 로그아웃됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Vos identifiants de connexion sont enregistrés dans le trousseau du Mac. La suppression de ce Gateway vous déconnecte de l’application."}},"hi":{"stringUnit":{"state":"translated","value":"आपकी साइन-इन जानकारी Mac Keychain में सहेजी गई है। इस Gateway को हटाने पर आप ऐप से साइन आउट हो जाएँगे।"}},"ar":{"stringUnit":{"state":"translated","value":"بيانات تسجيل دخولك محفوظة في سلسلة مفاتيح Mac. ستؤدي إزالة Gateway هذا إلى تسجيل خروجك من التطبيق."}},"it":{"stringUnit":{"state":"translated","value":"Le tue credenziali di accesso sono salvate nel Portachiavi del Mac. Rimuovendo questo Gateway, uscirai dall'account nell'app."}},"tr":{"stringUnit":{"state":"translated","value":"Oturum açma bilgileriniz Mac Anahtar Zinciri'nde kayıtlı. Bu Gateway'i kaldırmak, uygulamadaki oturumunuzu kapatır."}},"uk":{"stringUnit":{"state":"translated","value":"Ваші дані входу збережено у В’язці ключів Mac. Видалення цього Gateway призведе до виходу з облікового запису в застосунку."}},"id":{"stringUnit":{"state":"translated","value":"Informasi masuk Anda disimpan di Mac Keychain. Menghapus Gateway ini akan mengeluarkan Anda dari aplikasi."}},"pl":{"stringUnit":{"state":"translated","value":"Twoje dane logowania są zapisane w pęku kluczy na Macu. Usunięcie tego Gateway spowoduje wylogowanie z aplikacji."}},"th":{"stringUnit":{"state":"translated","value":"ข้อมูลการลงชื่อเข้าของคุณถูกบันทึกไว้ใน Mac Keychain การนำ Gateway นี้ออกจะทำให้คุณออกจากระบบแอป"}},"vi":{"stringUnit":{"state":"translated","value":"Thông tin đăng nhập của bạn được lưu trong Mac Keychain. Việc xóa Gateway này sẽ đăng xuất bạn khỏi ứng dụng."}},"nl":{"stringUnit":{"state":"translated","value":"Je aanmeldgegevens zijn opgeslagen in de sleutelhanger van je Mac. Als je deze Gateway verwijdert, word je afgemeld bij de app."}},"fa":{"stringUnit":{"state":"translated","value":"اطلاعات ورود شما در Mac Keychain ذخیره شده است. حذف این Gateway شما را از حساب کاربری در برنامه خارج می‌کند."}},"ru":{"stringUnit":{"state":"translated","value":"Ваши данные для входа сохранены в связке ключей Mac. При удалении этого Gateway будет выполнен выход из приложения."}},"sv":{"stringUnit":{"state":"translated","value":"Din inloggning sparas i nyckelringen på din Mac. Om du tar bort denna Gateway loggas du ut ur appen."}}}},
    "You’re all set!": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"You’re all set!"}},"zh-CN":{"stringUnit":{"state":"translated","value":"一切就绪！"}},"zh-TW":{"stringUnit":{"state":"translated","value":"一切就緒！"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Tudo pronto!"}},"de":{"stringUnit":{"state":"translated","value":"Alles ist bereit!"}},"es":{"stringUnit":{"state":"translated","value":"¡Todo listo!"}},"ja-JP":{"stringUnit":{"state":"translated","value":"準備が整いました！"}},"ko":{"stringUnit":{"state":"translated","value":"모든 준비가 완료되었습니다!"}},"fr":{"stringUnit":{"state":"translated","value":"Tout est prêt!"}},"hi":{"stringUnit":{"state":"translated","value":"सब तैयार है!"}},"ar":{"stringUnit":{"state":"translated","value":"أنت جاهز تمامًا!"}},"it":{"stringUnit":{"state":"translated","value":"È tutto pronto!"}},"tr":{"stringUnit":{"state":"translated","value":"Her şey hazır!"}},"uk":{"stringUnit":{"state":"translated","value":"Усе готово!"}},"id":{"stringUnit":{"state":"translated","value":"Semuanya sudah siap!"}},"pl":{"stringUnit":{"state":"translated","value":"Wszystko gotowe!"}},"th":{"stringUnit":{"state":"translated","value":"พร้อมใช้งานแล้ว!"}},"vi":{"stringUnit":{"state":"translated","value":"Bạn đã sẵn sàng!"}},"nl":{"stringUnit":{"state":"translated","value":"Je bent er helemaal klaar voor!"}},"fa":{"stringUnit":{"state":"translated","value":"همه‌چیز آماده است!"}},"ru":{"stringUnit":{"state":"translated","value":"Всё готово!"}},"sv":{"stringUnit":{"state":"translated","value":"Allt är klart!"}}}},
