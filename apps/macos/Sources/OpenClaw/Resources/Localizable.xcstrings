    "Letting your agent know you’re back…": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Letting your agent know you’re back…"}},"zh-CN":{"stringUnit":{"state":"translated","value":"正在通知你的智能体你已回来…"}},"zh-TW":{"stringUnit":{"state":"translated","value":"正在通知你的代理程式你回來了…"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Avisando seu agente que você voltou…"}},"de":{"stringUnit":{"state":"translated","value":"Dein Agent wird informiert, dass du zurück bist…"}},"es":{"stringUnit":{"state":"translated","value":"Avisando a tu agente de que has vuelto…"}},"ja-JP":{"stringUnit":{"state":"translated","value":"戻ったことをエージェントに通知しています…"}},"ko":{"stringUnit":{"state":"translated","value":"에이전트에게 돌아오셨음을 알리는 중…"}},"fr":{"stringUnit":{"state":"translated","value":"Votre agent est informé de votre retour…"}},"hi":{"stringUnit":{"state":"translated","value":"आपके एजेंट को बता रहे हैं कि आप वापस आ गए हैं…"}},"ar":{"stringUnit":{"state":"translated","value":"جارٍ إبلاغ وكيلك بعودتك…"}},"it":{"stringUnit":{"state":"translated","value":"Sto avvisando il tuo agente del tuo ritorno…"}},"tr":{"stringUnit":{"state":"translated","value":"Geri döndüğünüz ajanınıza bildiriliyor…"}},"uk":{"stringUnit":{"state":"translated","value":"Повідомляємо вашому агенту, що ви повернулися…"}},"id":{"stringUnit":{"state":"translated","value":"Memberi tahu agen Anda bahwa Anda sudah kembali…"}},"pl":{"stringUnit":{"state":"translated","value":"Informowanie agenta o Twoim powrocie…"}},"th":{"stringUnit":{"state":"translated","value":"กำลังแจ้งให้เอเจนต์ของคุณทราบว่าคุณกลับมาแล้ว…"}},"vi":{"stringUnit":{"state":"translated","value":"Đang báo cho tác nhân của bạn biết bạn đã quay lại…"}},"nl":{"stringUnit":{"state":"translated","value":"Je agent laten weten dat je terug bent…"}},"fa":{"stringUnit":{"state":"translated","value":"در حال اطلاع دادن بازگشت شما به عامل…"}},"ru":{"stringUnit":{"state":"translated","value":"Сообщаем вашему агенту, что вы вернулись…"}},"sv":{"stringUnit":{"stat