    "Enabled for this session": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enabled for this session"}},"zh-CN":{"stringUnit":{"state":"translated","value":"已为此会话启用"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已為此工作階段啟用"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ativado para esta sessão"}},"de":{"stringUnit":{"state":"translated","value":"Für diese Sitzung aktiviert"}},"es":{"stringUnit":{"state":"translated","value":"Activado para esta sesión"}},"ja-JP":{"stringUnit":{"state":"translated","value":"このセッションで有効"}},"ko":{"stringUnit":{"state":"translated","value":"이 세션에서 활성화됨"}},"fr":{"stringUnit":{"state":"translated","value":"Activé pour cette session"}},"hi":{"stringUnit":{"state":"translated","value":"इस सत्र के लिए सक्षम"}},"ar":{"stringUnit":{"state":"translated","value":"مفعّل لهذه الجلسة"}},"it":{"stringUnit":{"state":"translated","value":"Abilitato per questa sessione"}},"tr":{"stringUnit":{"state":"translated","value":"Bu oturum için etkin"}},"uk":{"stringUnit":{"state":"translated","value":"Увімкнено для цього сеансу"}},"id":{"stringUnit":{"state":"translated","value":"Diaktifkan untuk sesi ini"}},"pl":{"stringUnit":{"state":"translated","value":"Włączone w tej sesji"}},"th":{"stringUnit":{"state":"translated","value":"เปิดใช้งานสำหรับเซสชันนี้"}},"vi":{"stringUnit":{"state":"translated","value":"Đã bật cho phiên này"}},"nl":{"stringUnit":{"state":"translated","value":"Ingeschakeld voor deze sessie"}},"fa":{"stringUnit":{"state":"translated","value":"برای این نشست فعال است"}},"ru":{"stringUnit":{"state":"translated","value":"Включено для этого сеанса"}},"sv":{"stringUnit":{"state":"translated","value":"Aktiverat för den här sessionen"}}}},
    "Enter secret…": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter secret…"}},"zh-CN":{"stringUnit":{"state":"translated","value":"输入密钥…"}},"zh-TW":{"stringUnit":{"state":"translated","value":"輸入密鑰…"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Insira o segredo…"}},"de":{"stringUnit":{"state":"translated","value":"Secret eingeben…"}},"es":{"stringUnit":{"state":"translated","value":"Introduce el secreto…"}},"ja-JP":{"stringUnit":{"state":"translated","value":"シークレットを入力…"}},"ko":{"stringUnit":{"state":"translated","value":"시크릿 입력…"}},"fr":{"stringUnit":{"state":"translated","value":"Saisissez le secret…"}},"hi":{"stringUnit":{"state":"translated","value":"सीक्रेट दर्ज करें…"}},"ar":{"stringUnit":{"state":"translated","value":"أدخل السر…"}},"it":{"stringUnit":{"state":"translated","value":"Inserisci il segreto…"}},"tr":{"stringUnit":{"state":"translated","value":"Gizli bilgiyi girin…"}},"uk":{"stringUnit":{"state":"translated","value":"Введіть секрет…"}},"id":{"stringUnit":{"state":"translated","value":"Masukkan rahasia…"}},"pl":{"stringUnit":{"state":"translated","value":"Wpisz sekret…"}},"th":{"stringUnit":{"state":"translated","value":"ป้อนข้อมูลลับ…"}},"vi":{"stringUnit":{"state":"translated","value":"Nhập giá trị bí mật…"}},"nl":{"stringUnit":{"state":"translated","value":"Geheim invoeren…"}},"fa":{"stringUnit":{"state":"translated","value":"رمز محرمانه را وارد کنید…"}},"ru":{"stringUnit":{"state":"translated","value":"Введите секрет…"}},"sv":{"stringUnit":{"state":"translated","value":"Ange hemlighet…"}}}},
    "Enter this one-time code on the provider's sign-in page.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter this one-time code on the provider's sign-in page."}},"zh-CN":{"stringUnit":{"state":"translated","value":"在提供商的登录页面输入此一次性代码。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"在供應商的登入頁面輸入此一次性代碼。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Digite este código de uso único na página de login do provedor."}},"de":{"stringUnit":{"state":"translated","value":"Geben Sie diesen Einmalcode auf der Anmeldeseite des Anbieters ein."}},"es":{"stringUnit":{"state":"translated","value":"Introduce este código de un solo uso en la página de inicio de sesión del proveedor."}},"ja-JP":{"stringUnit":{"state":"translated","value":"プロバイダーのサインインページでこのワンタイムコードを入力してください。"}},"ko":{"stringUnit":{"state":"translated","value":"제공업체의 로그인 페이지에 이 일회용 코드를 입력하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Saisissez ce code à usage unique sur la page de connexion du fournisseur."}},"hi":{"stringUnit":{"state":"translated","value":"प्रदाता के साइन-इन पेज पर यह एक बार इस्तेमाल होने वाला कोड दर्ज करें।"}},"ar":{"stringUnit":{"state":"translated","value":"أدخل هذا الرمز المخصّص للاستخدام مرة واحدة في صفحة تسجيل الدخول لدى المزوّد."}},"it":{"stringUnit":{"state":"translated","value":"Inserisci questo codice monouso nella pagina di accesso del provider."}},"tr":{"stringUnit":{"state":"translated","value":"Bu tek kullanımlık kodu sağlayıcının oturum açma sayfasına girin."}},"uk":{"stringUnit":{"state":"translated","value":"Введіть цей одноразовий код на сторінці входу постачальника."}},"id":{"stringUnit":{"state":"translated","value":"Masukkan kode sekali pakai ini di halaman masuk penyedia."}},"pl":{"stringUnit":{"state":"translated","value":"Wpisz ten jednorazowy kod na stronie logowania dostawcy."}},"th":{"stringUnit":{"state":"translated","value":"ป้อนรหัสแบบใช้ครั้งเดียวนี้ในหน้าลงชื่อเข้าใช้ของผู้ให้บริการ."}},"vi":{"stringUnit":{"state":