    "after success": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"after success"}},"zh-CN":{"stringUnit":{"state":"translated","value":"成功后"}},"zh-TW":{"stringUnit":{"state":"translated","value":"成功後"}},"pt-BR":{"stringUnit":{"state":"translated","value":"após o sucesso"}},"de":{"stringUnit":{"state":"translated","value":"nach Erfolg"}},"es":{"stringUnit":{"state":"translated","value":"tras completarse correctamente"}},"ja-JP":{"stringUnit":{"state":"translated","value":"成功後"}},"ko":{"stringUnit":{"state":"translated","value":"성공 후"}},"fr":{"stringUnit":{"state":"translated","value":"après réussite"}},"hi":{"stringUnit":{"state":"translated","value":"सफलता के बाद"}},"ar":{"stringUnit":{"state":"translated","value":"بعد النجاح"}},"it":{"stringUnit":{"state":"translated","value":"dopo il completamento riuscito"}},"tr":{"stringUnit":{"state":"translated","value":"başarıdan sonra"}},"uk":{"stringUnit":{"state":"translated","value":"після успішного виконання"}},"id":{"stringUnit":{"state":"translated","value":"setelah berhasil"}},"pl":{"stringUnit":{"state":"translated","value":"po powodzeniu"}},"th":{"stringUnit":{"state":"translated","value":"หลังจากสำเร็จ"}},"vi":{"stringUnit":{"state":"translated","value":"sau khi thành công"}},"nl":{"stringUnit":{"state":"translated","value":"na succes"}},"fa":{"stringUnit":{"state":"translated","value":"پس از موفقیت"}},"ru":{"stringUnit":{"state":"translated","value":"после успешного выполнения"}},"sv":{"stringUnit":{"state":"translated","value":"efter lyckat resultat"}}}},
    "agentTurn": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"agentTurn"}},"zh-CN":{"stringUnit":{"state":"new","value":"agentTurn"}},"zh-TW":{"stringUnit":{"state":"new","value":"agentTurn"}},"pt-BR":{"stringUnit":{"state":"new","value":"agentTurn"}},"de":{"stringUnit":{"state":"new","value":"agentTurn"}},"es":{"stringUnit":{"state":"new","value":"agentTurn"}},"ja-JP":{"stringUnit":{"state":"new","value":"agentTurn"}},"ko":{"stringUnit":{"state":"new","value":"agentTurn"}},"fr":{"stringUnit":{"state":"new","value":"agentTurn"}},"hi":{"stringUnit":{"state":"new","value":"agentTurn"}},"ar":{"stringUnit":{"state":"new","value":"agentTurn"}},"it":{"stringUnit":{"state":"new","value":"agentTurn"}},"tr":{"stringUnit":{"state":"new","value":"agentTurn"}},"uk":{"stringUnit":{"state":"new","value":"agentTurn"}},"id":{"stringUnit":{"state":"new","value":"agentTurn"}},"pl":{"stringUnit":{"state":"new","value":"agentTurn"}},"th":{"stringUnit":{"state":"new","value":"agentTurn"}},"vi":{"stringUnit":{"state":"new","value":"agentTurn"}},"nl":{"stringUnit":{"state":"new","value":"agentTurn"}},"fa":{"stringUnit":{"state":"new","value":"agentTurn"}},"ru":{"stringUnit":{"state":"new","value":"agentTurn"}},"sv":{"stringUnit":{"state":"new","value":"agentTurn"}}}},
    "an unencrypted private-network connection": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"an unencrypted private-network connection"}},"zh-CN":{"stringUnit":{"state":"translated","value":"未加密的私有网络连接"}},"zh-TW":{"stringUnit":{"state":"translated","value":"未加密的私人網路連線"}},"pt-BR":{"stringUnit":{"state":"translated","value":"uma conexão de rede privada não criptografada"}},"de":{"stringUnit":{"state":"translated","value":"eine unverschlüsselte Verbindung im privaten Netzwerk"}},"es":{"stringUnit":{"state":"translated","value":"una conexión de red privada sin cifrar"}},"ja-JP":{"stringUnit":{"state":"translated","value":"暗号化されていないプライベートネットワーク接続"}},"ko":{"stringUnit":{"state":"translated","value":"암호화되지 않은 사설 네트워크 연결"}},"fr":{"stringUnit":{"state":"translated","value":"une connexion non chiffrée sur un réseau privé"}},"hi":{"stringUnit":{"state":"translated","value":"एक अनएन्क्रिप्टेड निजी-नेटवर्क कनेक्शन"}},"ar":{"stringUnit":{"state":"translated","value":"اتصال غير مشفّر عبر شبكة خاصة"}},"it":{"stringUnit":{"state":"translated","value":"una connessione non crittografata su rete privata"}},"tr":{"stringUnit":{"state":"translated","value":"şifrelenmemiş bir özel ağ bağlantısı"}},"uk":{"stringUnit":{"state":"translated","value":"незашифроване з’єднання в приватній мережі"}},"id":{"stringUnit":{"state":"translated","value":"koneksi jaringan privat yang tidak terenkripsi"}},"pl":{"stringUnit":{"state":"translated","value":"nieszyfrowane połączenie w sieci prywatnej"}},"th":{"stringUnit":{"state":"translated","value":"การเชื่อมต่อเครือข่ายส่วนตัวที่ไม่ได้เข้ารหัส"}},"vi":{"stringUnit":{"state":"translated","value":"kết nối mạng riêng không được mã hóa"}},"nl":{"stringUnit":{"state":"translated","value":"een onversleutelde verbinding via een privénetwerk"}},"fa":{"stringUnit":{"state":"translated","value":"یک اتصال رمزگذاری‌نشده در شبکهٔ خصوصی"}},"ru":{"stringUnit":{"state":"translated","value":"незашифрованное соединение в частной сети"}},"sv":{"stri