    "Attach only (skip launchd install)": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Attach only (skip launchd install)"}},"zh-CN":{"stringUnit":{"state":"translated","value":"仅附加（跳过 launchd 安装）"}},"zh-TW":{"stringUnit":{"state":"translated","value":"僅附加（略過 launchd 安裝）"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Apenas anexar (ignorar instalação do launchd)"}},"de":{"stringUnit":{"state":"translated","value":"Nur anhängen (launchd-Installation überspringen)"}},"es":{"stringUnit":{"state":"translated","value":"Solo adjuntar (omitir instalación de launchd)"}},"ja-JP":{"stringUnit":{"state":"translated","value":"アタッチのみ（launchd のインストールをスキップ）"}},"ko":{"stringUnit":{"state":"translated","value":"첨부만(launchd 설치 건너뛰기)"}},"fr":{"stringUnit":{"state":"translated","value":"Joindre uniquement (ignorer l’installation de launchd)"}},"hi":{"stringUnit":{"state":"translated","value":"केवल अटैच करें (launchd इंस्टॉल छोड़ें)"}},"ar":{"stringUnit":{"state":"translated","value":"إرفاق فقط (تخطي تثبيت launchd)"}},"it":{"stringUnit":{"state":"translated","value":"Solo collegamento (salta l'installazione di launchd)"}},"tr":{"stringUnit":{"state":"translated","value":"Yalnızca ekle (launchd kurulumunu atla)"}},"uk":{"stringUnit":{"state":"translated","value":"Лише приєднатися (пропустити встановлення launchd)"}},"id":{"stringUnit":{"state":"translated","value":"Hanya lampirkan (lewati instalasi launchd)"}},"pl":{"stringUnit":{"state":"translated","value":"Tylko dołącz (pomiń instalację launchd)"}},"th":{"stringUnit":{"state":"translated","value":"แนบเท่านั้น (ข้ามการติดตั้ง launchd)"}},"vi":{"stringUnit":{"state":"translated","value":"Chỉ đính kèm (bỏ qua cài đặt launchd)"}},"nl":{"stringUnit":{"state":"translated","value":"Alleen koppelen (launchd-installatie overslaan)"}},"fa":{"stringUnit":{"state":"translated","value":"فقط اتصال (رد کردن نصب launchd)"}},"ru":{"stringUnit":{"state":"translated","value":"Только подключиться (пропустить установку laun