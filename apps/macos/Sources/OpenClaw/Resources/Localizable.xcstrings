    "Gateway changed. Close and reopen Groups to continue.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Gateway changed. Close and reopen Groups to continue."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Gateway 已更改。请关闭并重新打开“群组”以继续。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 已變更。請關閉並重新開啟「群組」以繼續。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Gateway foi alterado. Feche e reabra Grupos para continuar."}},"de":{"stringUnit":{"state":"translated","value":"Gateway wurde geändert. Schließen und öffnen Sie „Gruppen“ erneut, um fortzufahren."}},"es":{"stringUnit":{"state":"translated","value":"El Gateway ha cambiado. Cierra y vuelve a abrir Grupos para continuar."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayが変更されました。続行するには「グループ」を閉じて再度開いてください。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway가 변경되었습니다. 계속하려면 그룹을 닫았다가 다시 여세요."}},"fr":{"stringUnit":{"state":"translated","value":"Le Gateway a changé. Fermez et rouvrez Groupes pour continuer."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway बदल गया है। जारी रखने के लिए Groups को बंद करके फिर से खोलें।"}},"ar":{"stringUnit":{"state":"translated","value":"تغيّر Gateway. أغلق المجموعات وأعد فتحها للمتابعة."}},"it":{"stringUnit":{"state":"translated","value":"Il Gateway è cambiato. Chiudi e riapri Gruppi per continuare."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway değişti. Devam etmek için Gruplar'ı kapatıp yeniden açın."}},"uk":{"stringUnit":{"state":"translated","value":"Gateway змінено. Закрийте й знову відкрийте розділ «Групи», щоб продовжити."}},"id":{"stringUnit":{"state":"translated","value":"Gateway berubah. Tutup dan buka kembali Grup untuk melanjutkan."}},"pl":{"stringUnit":{"state":"translated","value":"Gateway został zmieniony. Zamknij i ponownie otwórz Grupy, aby kontynuować."}},"th":{"stringUnit":{"state":"translated","value":"Gateway มีการเปลี่ยนแปลง ปิดแล้วเปิดกลุ่มอีกครั้งเพื่อดำเนินการต่อ"}},