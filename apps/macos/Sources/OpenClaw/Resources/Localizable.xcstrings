    "Grant OpenClaw in System Settings → Privacy & Security → Accessibility, then reopen it.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Grant OpenClaw in System Settings → Privacy & Security → Accessibility, then reopen it."}},"zh-CN":{"stringUnit":{"state":"translated","value":"在系统设置 → 隐私与安全性 → 辅助功能中授予 OpenClaw 权限，然后重新打开它。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"在「系統設定 → 隱私權與安全性 → 輔助使用」中授權 OpenClaw，然後重新開啟。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Conceda ao OpenClaw em Ajustes do Sistema → Privacidade e Segurança → Acessibilidade e reabra-o."}},"de":{"stringUnit":{"state":"translated","value":"Erteile OpenClaw die Berechtigung unter Systemeinstellungen → Datenschutz & Sicherheit → Bedienungshilfen und öffne es dann erneut."}},"es":{"stringUnit":{"state":"translated","value":"Concede acceso a OpenClaw en Ajustes del Sistema → Privacidad y seguridad → Accesibilidad y luego vuelve a abrirlo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"システム設定 → プライバシーとセキュリティ → アクセシビリティ でOpenClawを許可し、再度開いてください。"}},"ko":{"stringUnit":{"state":"translated","value":"시스템 설정 → 개인정보 보호 및 보안 → 손쉬운 사용에서 OpenClaw에 권한을 부여한 후 다시 여세요."}},"fr":{"stringUnit":{"state":"translated","value":"Autorisez OpenClaw dans Réglages Système → Confidentialité et sécurité → Accessibilité, puis rouvrez-le."}},"hi":{"stringUnit":{"state":"translated","value":"System Settings → Privacy & Security → Accessibility में OpenClaw को अनुमति दें, फिर इसे फिर से खोलें।"}},"ar":{"stringUnit":{"state":"translated","value":"امنح OpenClaw الإذن في إعدادات النظام ← الخصوصية والأمان ← إمكانية الوصول، ثم أعد فتحه."}},"it":{"stringUnit":{"state":"translated","value":"Concedi l'autorizzazione a OpenClaw in Impostazioni di sistema → Privacy e sicurezza → Accessibilità, quindi riaprilo."}},"tr":{"stringUnit":{"state":"translated","value":"System Settings → Privacy & Security → Accessibility bölümünden OpenClaw'a izin verin, ardından yeniden açın."}},"uk":{"stringUnit":{"state":"translated","value":"Надайте дозвіл OpenClaw у Системних параметрах → Конфіденційність і безпека → Доступність, потім перезапустіть його."}},"id":{"stringUnit":{"state":"translated","value":"Berikan izin OpenClaw di System Settings → Privacy & Security → Accessibility, lalu buka kembali."}},"pl":{"stringUnit":{"state":"translated","value":"Przyznaj OpenClaw w Ustawieniach systemowych → Prywatność i bezpieczeństwo → Dostępność, a następnie otwórz ponownie."}},"th":{"stringUnit":{"state":"translated","value":"อนุญาต OpenClaw ใน System Settings → Privacy & Security → Accessibility จากนั้นเปิดใหม่"}},"vi":{"stringUnit":{"state":"translated","value":"Cấp quyền cho OpenClaw trong System Settings → Privacy & Security → Accessibility, sau đó mở lại."}},"nl":{"stringUnit":{"state":"translated","value":"Geef OpenClaw toegang in Systeeminstellingen → Privacy en beveiliging → Toegankelijkheid en open het opnieuw."}},"fa":{"stringUnit":{"state":"translated","value":"دسترسی OpenClaw را در System Settings → Privacy & Security → Accessibility بدهید، سپس آن را دوباره باز کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Предоставьте доступ OpenClaw в «Системные настройки → Конфиденциальность и безопасность → Универсальный доступ», затем откройте приложение заново."}},"sv":{"stringUnit":{"state":"translated","value":"Bevilja OpenClaw i Systeminställningar → Integritet och säkerhet → Hjälpmedel och öppna det sedan igen."}}}},
    "Grant OpenClaw in System Settings → Privacy & Security → Screen Recording, then reopen it.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Grant OpenClaw in System Settings → Privacy & Security → Screen Recording, then reopen it."}},"zh-CN":{"stringUnit":{"state":"translated","value":"在系统设置 → 隐私与安全性 → 屏幕录制中授予 OpenClaw 权限，然后重新打开它。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"在「系統設定 → 隱私權與安全性 → 螢幕錄製」中授權 OpenClaw，然後重新開啟。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Conceda ao OpenClaw em Ajustes do Sistema → Privacidade e Segurança → Gravação de Tela e reabra-o."}},"de":{"stringUnit":{"state":"translated","value":"Erteile OpenClaw die Berechtigung unter Systemeinstellungen → Datenschutz & Sicherheit → Bildschirmaufnahme und öffne es dann erneut."}},"es":{"stringUnit":{"state":"translated","value":"Concede acceso a OpenClaw en Ajustes del Sistema → Privacidad y seguridad → Grabación de pantalla y luego vuelve a abrirlo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"システム設定 → プライバシーとセキュリティ → 画面収録 でOpenClawを許可し、再度開いてください。"}},"ko":{"stringUnit":{"state":"translated","value":"시스템 설정 → 개인정보 보호 및 보안 → 화면 기록에서 OpenClaw에 권한을 부여한 후 다시 여세요."}},"fr":{"stringUnit":{"state":"translated","value":"Autorisez OpenClaw dans Réglages Système → Confidentialité et sécurité → Enregistrement de l'écran, puis rouvrez-le."}},"hi":{"stringUnit":{"state":"translated","value":"System Settings → Privacy & Security → Screen Recording में OpenClaw को अनुमति दें, फिर इसे फिर से खोलें।"}},"ar":{"stringUnit":{"state":"translated","value":"امنح OpenClaw الإذن في إعدادات النظام ← الخصوصية والأمان ← تسجيل الشاشة، ثم أعد فتحه."}},"it":{"stringUnit":{"state":"translated","value":"Concedi l'autorizzazione a OpenClaw in Impostazioni di sistema → Privacy e sicurezza → Registrazione schermo, quindi riaprilo."}},"tr":{"stringUnit":{"state":"translated","value":"System Settings → Privacy & Security → Screen Recording bölümünden OpenClaw'a izin verin, ardınd