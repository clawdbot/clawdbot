    "Waiting for a fresh authenticated connection.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Waiting for a fresh authenticated connection."}},"zh-CN":{"stringUnit":{"state":"translated","value":"正在等待新的已认证连接。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"正在等待新的已驗證連線。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Aguardando uma nova conexão autenticada."}},"de":{"stringUnit":{"state":"translated","value":"Warten auf eine neue authentifizierte Verbindung."}},"es":{"stringUnit":{"state":"translated","value":"Esperando una nueva conexión autenticada."}},"ja-JP":{"stringUnit":{"state":"translated","value":"新しい認証済み接続を待機しています。"}},"ko":{"stringUnit":{"state":"translated","value":"새 인증된 연결을 기다리는 중입니다."}},"fr":{"stringUnit":{"state":"translated","value":"En attente d'une nouvelle connexion authentifiée."}},"hi":{"stringUnit":{"state":"translated","value":"एक नए प्रमाणित कनेक्शन की प्रतीक्षा है।"}},"ar":{"stringUnit":{"state":"translated","value":"في انتظار اتصال مصادق جديد."}},"it":{"stringUnit":{"state":"translated","value":"In attesa di una nuova connessione autenticata."}},"tr":{"stringUnit":{"state":"translated","value":"Yeni bir kimliği doğrulanmış bağlantı bekleniyor."}},"uk":{"stringUnit":{"state":"translated","value":"Очікування нового автентифікованого підключення."}},"id":{"stringUnit":{"state":"translated","value":"Menunggu koneksi terautentikasi yang baru."}},"pl":{"stringUnit":{"state":"translated","value":"Oczekiwanie na nowe uwierzytelnione połączenie."}},"th":{"stringUnit":{"state":"translated","value":"กำลังรอการเชื่อมต่อที่ยืนยันตัวตนใหม่"}},"vi":{"stringUnit":{"state":"translated","value":"Đang chờ kết nối xác thực mới."}},"nl":{"stringUnit":{"state":"translated","value":"Wachten op een nieuwe geverifieerde verbinding."}},"fa":{"stringUnit":{"state":"translated","value":"در انتظار یک اتصال احرازهویت‌شده تازه."}},"ru":{"stringUnit":{"state":"translated","value":"Ожидание нового аутентифицированного подключения."