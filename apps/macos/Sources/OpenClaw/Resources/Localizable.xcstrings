    "Sign in again in Connection → Gateways.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Sign in again in Connection → Gateways."}},"zh-CN":{"stringUnit":{"state":"translated","value":"在“连接 → Gateway”中重新登录。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"在「連線」→「Gateway」中重新登入。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Entre novamente em Conexão → Gateways."}},"de":{"stringUnit":{"state":"translated","value":"Melden Sie sich unter Verbindung → Gateways erneut an."}},"es":{"stringUnit":{"state":"translated","value":"Vuelve a iniciar sesión en Conexión → Gateways."}},"ja-JP":{"stringUnit":{"state":"translated","value":"接続 → Gatewayでもう一度サインインしてください。"}},"ko":{"stringUnit":{"state":"translated","value":"연결 → Gateway에서 다시 로그인하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Identifiez-vous à nouveau dans Connexion → Gateways."}},"hi":{"stringUnit":{"state":"translated","value":"कनेक्शन → Gateway में दोबारा साइन इन करें।"}},"ar":{"stringUnit":{"state":"translated","value":"سجّل الدخول مجددًا من الاتصال → بوابات Gateway."}},"it":{"stringUnit":{"state":"translated","value":"Accedi di nuovo in Connessione → Gateway."}},"tr":{"stringUnit":{"state":"translated","value":"Bağlantı → Gateway'ler bölümünden tekrar oturum açın."}},"uk":{"stringUnit":{"state":"translated","value":"Увійдіть знову в розділі «Підключення» → «Gateway»."}},"id":{"stringUnit":{"state":"translated","value":"Masuk lagi di Koneksi → Gateway."}},"pl":{"stringUnit":{"state":"translated","value":"Zaloguj się ponownie w sekcji Połączenie → Gateway."}},"th":{"stringUnit":{"state":"translated","value":"ลงชื่อเข้าใช้อีกครั้งใน การเชื่อมต่อ → Gateway"}},"vi":{"stringUnit":{"state":"translated","value":"Đăng nhập lại trong Kết nối → Gateway."}},"nl":{"stringUnit":{"state":"translated","value":"Meld je opnieuw aan via Verbinding → Gateways."}},"fa":{"stringUnit":{"state":"translated","value":"در اتصال → Gatewayها دوباره وارد حساب شوید."}},"ru":{"stringUnit":{"state"