    "%lld of %lld cookies copied into “%@” — now the default profile for agent browsing.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%lld of %lld cookies copied into “%@” — now the default profile for agent browsing."}},"zh-CN":{"stringUnit":{"state":"translated","value":"已将 %lld 个 cookie（共 %lld 个）复制到“%@” — 现已设为智能体浏览的默认配置文件。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已將 %lld / %lld 個 Cookie 複製到「%@」— 現已設為代理程式瀏覽的預設設定檔。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"%lld de %lld cookies copiados para “%@” — agora o perfil padrão para navegação do agente."}},"de":{"stringUnit":{"state":"translated","value":"%lld von %lld Cookies nach “%@” kopiert — jetzt das Standardprofil für das Browsen durch den Agenten."}},"es":{"stringUnit":{"state":"translated","value":"%lld de %lld cookies copiadas en “%@” — ahora es el perfil predeterminado para la navegación del agente."}},"ja-JP":{"stringUnit":{"state":"translated","value":"%lld件（全%lld件中）のCookieを“%@”にコピーしました — エージェントのブラウジング用のデフォルトプロファイルになりました。"}},"ko":{"stringUnit":{"state":"translated","value":"%lld / %lld개의 쿠키를 “%@”에 복사했습니다 — 이제 에이전트 탐색의 기본 프로필입니다."}},"fr":{"stringUnit":{"state":"translated","value":"%lld cookies sur %lld copiés dans “%@” — désormais le profil par défaut pour la navigation de l’agent."}},"hi":{"stringUnit":{"state":"translated","value":"%lld / %lld कुकीज़ “%@” में कॉपी की गईं — अब यह एजेंट ब्राउज़िंग के लिए डिफ़ॉल्ट प्रोफ़ाइल है."}},"ar":{"stringUnit":{"state":"translated","value":"تم نسخ %lld من %lld من ملفات تعريف الارتباط إلى “%@” — وهو الآن الملف الشخصي الافتراضي لتصفح الوكيل."}},"it":{"stringUnit":{"state":"translated","value":"%lld di %lld cookie copiati in “%@” — ora il profilo predefinito per la navigazione dell’agente."}},"tr":{"stringUnit":{"state":"translated","value":"%lld / %lld çerez “%@” profiline kopyalandı — artık ajanın web'de gezinmesi için varsayılan profil."}},"uk":{"stringUnit":{"state":"translated","value":"%lld із %lld файлів cookie скоп