    "A previous app version could not safely send this message. Review and retry it.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A previous app version could not safely send this message. Review and retry it."}},"zh-CN":{"stringUnit":{"state":"translated","value":"先前版本的应用无法安全发送此消息。请检查后重试。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"先前版本的 App 無法安全地傳送此訊息。請檢查後重試。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Uma versão anterior do app não conseguiu enviar esta mensagem com segurança. Revise e tente enviá-la novamente."}},"de":{"stringUnit":{"state":"translated","value":"Eine frühere App-Version konnte diese Nachricht nicht sicher senden. Prüfe sie und versuche es erneut."}},"es":{"stringUnit":{"state":"translated","value":"Una versión anterior de la aplicación no pudo enviar este mensaje de forma segura. Revísalo y vuelve a intentarlo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"以前のバージョンのアプリでは、このメッセージを安全に送信できませんでした。 内容を確認して再試行してください。"}},"ko":{"stringUnit":{"state":"translated","value":"이전 앱 버전에서 이 메시지를 안전하게 전송하지 못했습니다. 검토한 후 다시 시도하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Une version précédente de l’application n’a pas pu envoyer ce message en toute sécurité. Vérifiez-le et réessayez."}},"hi":{"stringUnit":{"state":"translated","value":"ऐप का पिछला संस्करण इस संदेश को सुरक्षित रूप से नहीं भेज सका. इसकी समीक्षा करें और फिर से भेजने का प्रयास करें."}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر على إصدار سابق من التطبيق إرسال هذه الرسالة بأمان. راجعها وأعد محاولة إرسالها."}},"it":{"stringUnit":{"state":"translated","value":"Una versione precedente dell'app non ha potuto inviare questo messaggio in modo sicuro. Controllalo e riprova."}},"tr":{"stringUnit":{"state":"translated","value":"Uygulamanın önceki bir sürümü bu mesajı güvenli bir şekilde gönderemedi. Gözden geçirip yeniden deneyin."}},"uk":{"stringUnit":{"state":"translated","value":"Попередня версія застосунку не змогла безпечно надіслати це повідомлення. Перегляньте його та повторіть спробу."}},"id":{"stringUnit":{"state":"translated","value":"Versi aplikasi sebelumnya tidak dapat mengirim pesan ini dengan aman. Tinjau dan coba kirim ulang."}},"pl":{"stringUnit":{"state":"translated","value":"Poprzednia wersja aplikacji nie mogła bezpiecznie wysłać tej wiadomości. Sprawdź ją i spróbuj ponownie."}},"th":{"stringUnit":{"state":"translated","value":"แอปเวอร์ชันก่อนหน้าไม่สามารถส่งข้อความนี้ได้อย่างปลอดภัย. โปรดตรวจสอบแล้วลองส่งอีกครั้ง."}},"vi":{"stringUnit":{"state":"translated","value":"Phiên bản ứng dụng trước không thể gửi tin nhắn này một cách an toàn. Hãy xem lại và thử gửi lại."}},"nl":{"stringUnit":{"state":"translated","value":"Een eerdere appversie kon dit bericht niet veilig verzenden. Controleer het en probeer het opnieuw."}},"fa":{"stringUnit":{"state":"translated","value":"نسخهٔ قبلی برنامه نتوانست این پیام را به‌طور ایمن ارسال کند. آن را بررسی کنید و دوباره تلاش کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Предыдущая версия приложения не смогла безопасно отправить это сообщение. Проверьте его и повторите отправку."}},"sv":{"stringUnit":{"state":"translated","value":"En tidigare appversion kunde inte skicka detta meddelande på ett säkert sätt. Granska det och försök igen."}}}},
    "AI setup didn’t complete": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"AI setup didn’t complete"}},"zh-CN":{"stringUnit":{"state":"translated","value":"AI 设置未完成"}},"zh-TW":{"stringUnit":{"state":"translated","value":"AI 設定未完成"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A configuração da IA não foi concluída"}},"de":{"stringUnit":{"state":"translated","value":"KI-Einrichtung wurde nicht abgeschlossen"}},"es":{"stringUnit":{"state":"translated","value":"La configuración de IA no se completó"}},"ja-JP":{"stringUnit":{"state":"translated","value":"AI のセットアップが完了しませんでした"}},"ko":{"stringUnit":{"state":"translated","value":"AI 설정이 완료되지 않았습니다"}},"fr":{"stringUnit":{"state":"translated","value":"La configuration de l’IA n’a pas abouti"}},"hi":{"stringUnit":{"state":"translated","value":"AI सेटअप पूरा नहीं हुआ"}},"ar":{"stringUnit":{"state":"translated","value":"لم يكتمل إعداد الذكاء الاصطناعي"}},"it":{"stringUnit":{"state":"translated","value":"La configurazione dell’IA non è stata completata"}},"tr":{"stringUnit":{"state":"translated","value":"Yapay zekâ kurulumu tamamlanmadı"}},"uk":{"stringUnit":{"state":"translated","value":"Налаштування ШІ не завершено"}},"id":{"stringUnit":{"state":"translated","value":"Penyiapan AI tidak selesai"}},"pl":{"stringUnit":{"state":"translated","value":"Konfiguracja AI nie została ukończona"}},"th":{"stringUnit":{"state":"translated","value":"การตั้งค่า AI ไม่เสร็จสมบูรณ์"}},"vi":{"stringUnit":{"state":"translated","value":"Thiết lập AI chưa hoàn tất"}},"nl":{"stringUnit":{"state":"translated","value":"AI-configuratie niet voltooid"}},"fa":{"stringUnit":{"state":"translated","value":"راه‌اندازی هوش مصنوعی کامل نشد"}},"ru":{"stringUnit":{"state":"translated","value":"Настройка ИИ не завершена"}},"sv":{"stringUnit":{"state":"translated","value":"AI-konfigurationen slutfördes inte"}}}},
    "AI setup needs verification": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"AI setup needs verification"}},"zh-CN":{"stringUnit":{"state":"translated","value":"AI 设置需要验证"}},"zh-TW":{"stringUnit":{"state":"translated","value":"AI 設定需要驗證"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A configuração de IA precisa de verificação"}},"de":{"stringUnit":{"state":"translated","value":"KI-Einrichtung muss überprüft werden"}},"es":{"stringUnit":{"state":"translated","value":"La configuración de IA requiere verificación"}},"ja-JP":{"stringUnit":{"state":"translated","value":"AIの設定を確認する必要があります"}},"ko":{"stringUnit":{"state":"translated","value":"AI 설정을 확인해야 합니다"}},"fr":{"stringUnit":{"state":"translated","value":"La configuration de l’IA doit être vérifiée"}},"hi":{"stringUnit":{"state":"translated","value":"AI सेटअप के लिए सत्यापन ज़रूरी है"}},"ar":{"stringUnit":{"state":"translated","value":"يتطلب إعداد الذكاء الاصطناعي التحقق"}},"it":{"stringUnit":{"state":"translated","value":"La configurazione dell'IA richiede una verifica"}},"tr":{"stringUnit":{"state":"translated","value":"Yapay zekâ kurulumu doğrulama gerektiriyor"}},"uk":{"stringUnit":{"state":"translated","value":"Налаштування ШІ потребує перевірки"}},"id":{"stringUnit":{"state":"translated","value":"Penyiapan AI memerlukan verifikasi"}},"pl":{"stringUnit":{"state":"translated","value":"Konfiguracja AI wymaga weryfikacji"}},"th":{"stringUnit":{"state":"translated","value":"ต้องยืนยันการตั้งค่า AI"}},"vi":{"stringUnit":{"state":"translated","value":"Thiết lập AI cần được xác minh"}},"nl":{"stringUnit":{"state":"translated","value":"AI-configuratie moet worden geverifieerd"}},"fa":{"stringUnit":{"state":"translated","value":"راه‌اندازی هوش مصنوعی به تأیید نیاز دارد"}},"ru":{"stringUnit":{"state":"translated","value":"Настройка ИИ требует проверки"}},"sv":{"stringUnit":{"state":"translated","value":"AI-konfigurationen behöver verifieras"}}}},
