    "Gateway token mismatch. Run openclaw gateway auth-token --show on the gateway host.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Gateway token mismatch. Run openclaw gateway auth-token --show on the gateway host."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Gateway 令牌不匹配。请在 Gateway 主机上运行 openclaw gateway auth-token --show。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 權杖不符。 請在 Gateway 主機上執行 openclaw gateway auth-token --show."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O token do Gateway não corresponde. Execute openclaw gateway auth-token --show no host do Gateway."}},"de":{"stringUnit":{"state":"translated","value":"Gateway-Token stimmt nicht überein. Führen Sie openclaw gateway auth-token --show auf dem Gateway-Host aus."}},"es":{"stringUnit":{"state":"translated","value":"El token de Gateway no coincide. Ejecuta openclaw gateway auth-token --show en el host de Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayトークンが一致しません。 Gatewayホストでopenclaw gateway auth-token --showを実行してください。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway 토큰이 일치하지 않습니다. Gateway 호스트에서 openclaw gateway auth-token --show를 실행하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Le jeton du Gateway ne correspond pas. Exécutez openclaw gateway auth-token --show sur l’hôte du Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway टोकन मेल नहीं खाता. Gateway होस्ट पर openclaw gateway auth-token --show चलाएँ."}},"ar":{"stringUnit":{"state":"translated","value":"رمز Gateway غير متطابق. شغّل openclaw gateway auth-token --show على مضيف Gateway."}},"it":{"stringUnit":{"state":"translated","value":"Il token del Gateway non corrisponde. Esegui openclaw gateway auth-token --show sull'host del Gateway."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway belirteci uyuşmuyor. Gateway ana makinesinde openclaw gateway auth-token --show komutunu çalıştırın."}},"uk":{"stringUnit":{"st