    "Local (this Mac)": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Local (this Mac)"}},"zh-CN":{"stringUnit":{"state":"translated","value":"本地 (此 Mac)"}},"zh-TW":{"stringUnit":{"state":"translated","value":"本機 (這部 Mac)"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Local (este Mac)"}},"de":{"stringUnit":{"state":"translated","value":"Lokal (dieser Mac)"}},"es":{"stringUnit":{"state":"translated","value":"Local (este Mac)"}},"ja-JP":{"stringUnit":{"state":"translated","value":"ローカル (このMac)"}},"ko":{"stringUnit":{"state":"translated","value":"로컬 (이 Mac)"}},"fr":{"stringUnit":{"state":"translated","value":"Local (ce Mac)"}},"hi":{"stringUnit":{"state":"translated","value":"स्थानीय (यह Mac)"}},"ar":{"stringUnit":{"state":"translated","value":"محلي (جهاز Mac هذا)"}},"it":{"stringUnit":{"state":"translated","value":"Locale (questo Mac)"}},"tr":{"stringUnit":{"state":"translated","value":"Yerel (bu Mac)"}},"uk":{"stringUnit":{"state":"translated","value":"Локальний (цей Mac)"}},"id":{"stringUnit":{"state":"translated","value":"Lokal (Mac ini)"}},"pl":{"stringUnit":{"state":"translated","value":"Lokalnie (ten Mac)"}},"th":{"stringUnit":{"state":"translated","value":"ในเครื่อง (Mac เครื่องนี้)"}},"vi":{"stringUnit":{"state":"translated","value":"Cục bộ (máy Mac này)"}},"nl":{"stringUnit":{"state":"translated","value":"Lokaal (deze Mac)"}},"fa":{"stringUnit":{"state":"translated","value":"محلی (این Mac)"}},"ru":{"stringUnit":{"state":"translated","value":"Локальный (этот Mac)"}},"sv":{"stringUnit":{"state":"translated","value":"Lokal (denna Mac)"}}}},
    "Local Gateway": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Local Gateway"}},"zh-CN":{"stringUnit":{"state":"translated","value":"本地 Gateway"}},"zh-TW":{"stringUnit":{"state":"translated","value":"本機 Gateway"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Gateway local"}},"de":{"stringUnit":{"state":"translated","value":"Lokaler Gateway"}},"es":{"stringUnit":{"state":"translated","value":"Gateway local"}},"ja-JP":{"stringUnit":{"state":"translated","value":"ローカルGateway"}},"ko":{"stringUnit":{"state":"translated","value":"로컬 Gateway"}},"fr":{"stringUnit":{"state":"translated","value":"Gateway local"}},"hi":{"stringUnit":{"state":"translated","value":"स्थानीय Gateway"}},"ar":{"stringUnit":{"state":"translated","value":"Gateway محلي"}},"it":{"stringUnit":{"state":"translated","value":"Gateway locale"}},"tr":{"stringUnit":{"state":"translated","value":"Yerel Gateway"}},"uk":{"stringUnit":{"state":"translated","value":"Локальний Gateway"}},"id":{"stringUnit":{"state":"translated","value":"Gateway Lokal"}},"pl":{"stringUnit":{"state":"translated","value":"Lokalny Gateway"}},"th":{"stringUnit":{"state":"translated","value":"Gateway ในเครื่อง"}},"vi":{"stringUnit":{"state":"translated","value":"Gateway cục bộ"}},"nl":{"stringUnit":{"state":"translated","value":"Lokale Gateway"}},"fa":{"stringUnit":{"state":"translated","value":"Gateway محلی"}},"ru":{"stringUnit":{"state":"translated","value":"Локальный Gateway"}},"sv":{"stringUnit":{"state":"translated","value":"Lokal Gateway"}}}},
    "Local is best for this Mac. Remote is best when the Gateway already runs on a Mac Studio or server.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Local is best for this Mac. Remote is best when the Gateway already runs on a Mac Studio or server."}},"zh-CN":{"stringUnit":{"state":"translated","value":"本地模式最适合此 Mac. 如果 Gateway 已在 Mac Studio 或服务器上运行，则远程模式最合适。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"本機模式最適合這部 Mac. 若 Gateway 已在 Mac Studio 或伺服器上執行，則遠端模式最適合。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O modo local é ideal para este Mac. O modo remoto é ideal quando o Gateway já está em execução em um Mac Studio ou servidor."}},"de":{"stringUnit":{"state":"translated","value":"Lokal eignet sich am besten für diesen Mac. Remote eignet sich am besten, wenn der Gateway bereits auf einem Mac Studio oder Server läuft."}},"es":{"stringUnit":{"state":"translated","value":"El modo local es la mejor opción para este Mac. El modo remoto es la mejor opción cuando el Gateway ya se ejecuta en un Mac Studio o en un servidor."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このMacにはローカルが最適です。 GatewayがすでにMac Studioやサーバーで稼働している場合はリモートが最適です。"}},"ko":{"stringUnit":{"state":"translated","value":"이 Mac에서는 로컬 모드가 가장 적합합니다. Gateway가 이미 Mac Studio나 서버에서 실행 중인 경우 원격 모드가 가장 적합합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le mode local est recommandé pour ce Mac. Le mode distant est recommandé lorsque le Gateway fonctionne déjà sur un Mac Studio ou un serveur."}},"hi":{"stringUnit":{"state":"translated","value":"इस Mac के लिए स्थानीय मोड सबसे अच्छा है. जब Gateway पहले से किसी Mac Studio या सर्वर पर चल रहा हो, तो रिमोट मोड सबसे अच्छा है."}},"ar":{"stringUnit":{"state":"translated","value":"الوضع المحلي هو الأنسب لجهاز Mac هذا. والوضع البعيد هو الأنسب عندما يكون Gateway قيد التشغيل بالفعل على جهاز Mac Studio أو خادم."}},"it":{"stringUnit":{"state":"translated","value":"La modalità locale è ideale per questo Mac. La modalità remota è ideale quando il Gateway è già in esecuzione su un Mac Studio o un server."}},"tr":{"stringUnit":{"state":"translated","value":"Bu Mac için yerel mod en uygunudur. Gateway zaten bir Mac Studio veya sunucuda çalışıyorsa uzak mod en uygunudur."}},"uk":{"stringUnit":{"state":"translated","value":"Локальний режим найкраще підходить для цього Mac. Віддалений — коли Gateway вже працює на Mac Studio або сервері."}},"id":{"stringUnit":{"state":"translated","value":"Lokal paling cocok untuk Mac ini. Jarak jauh paling cocok jika Gateway sudah berjalan di Mac Studio atau server."}},"pl":{"stringUnit":{"state":"translated","value":"Tryb lokalny jest najlepszy dla tego Maca. Tryb zdalny jest najlepszy, gdy Gateway działa już na Mac Studio lub serwerze."}},"th":{"stringUnit":{"state":"translated","value":"โหมดในเครื่องเหมาะที่สุดสำหรับ Mac เครื่องนี้ โหมดระยะไกลเหมาะที่สุดเมื่อ Gateway ทำงานอยู่บน Mac Studio หรือเซิร์ฟเวอร์อยู่แล้ว"}},"vi":{"stringUnit":{"state":"translated","value":"Chế độ cục bộ phù hợp nhất cho máy Mac này. Chế độ từ xa phù hợp nhất khi Gateway đã chạy trên Mac Studio hoặc máy chủ."}},"nl":{"stringUnit":{"state":"translated","value":"Lokaal is het beste voor deze Mac. Extern is het beste wanneer de Gateway al op een Mac Studio of server draait."}},"fa":{"stringUnit":{"state":"translated","value":"حالت محلی برای این Mac مناسب‌تر است. حالت راه دور زمانی مناسب‌تر است که Gateway از قبل روی یک Mac Studio یا سرور اجرا می‌شود."}},"ru":{"stringUnit":{"state":"translated","value":"Локальный режим лучше подходит для этого Mac. Удалённый режим лучше подходит, если Gateway уже работает на Mac Studio или сервере."}},"sv":{"stringUnit":{"state":"translated","value":"Lokalt läge passar bäst för denna Mac. Fjärrläge passar bäst när Gateway redan körs på en Mac Studio eller server."}}}},
    "Local mode required. Update settings on the gateway host.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Local mode required. Update settings on the gateway host."}},"zh-CN":{"stringUnit":{"state":"translated","value":"需要本地模式。 请在网关主机上更新设置。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"需要本機模式。 請在 gateway 主機上更新設定。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Modo local necessário. Atualize as configurações no host do Gateway."}},"de":{"stringUnit":{"state":"translated","value":"Lokaler Modus erforderlich. Aktualisiere die Einstellungen auf dem Gateway-Host."}},"es":{"stringUnit":{"state":"translated","value":"Se requiere el modo local. Actualiza la configuración en el equipo que aloja el Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ローカルモードが必要です。 Gatewayホストで設定を更新してください。"}},"ko":{"stringUnit":{"state":"translated","value":"로컬 모드가 필요합니다. Gateway 호스트에서 설정을 업데이트하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Le mode local est requis. Mettez à jour les réglages sur l’hôte du Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"स्थानीय मोड आवश्यक है. Gateway होस्ट पर सेटिंग्स अपडेट करें."}},"ar":{"stringUnit":{"state":"translated","value":"الوضع المحلي مطلوب. حدّث الإعدادات على الجهاز المضيف لـ Gateway."}},"it":{"stringUnit":{"state":"translated","value":"È richiesta la modalità locale. Aggiorna le impostazioni sull'host del gateway."}},"tr":{"stringUnit":{"state":"translated","value":"Yerel mod gereklidir. Ayarları Gateway'in çalıştığı ana makinede güncelleyin."}},"uk":{"stringUnit":{"state":"translated","value":"Потрібен локальний режим. Оновіть налаштування на хості шлюзу."}},"id":{"stringUnit":{"state":"translated","value":"Mode lokal diperlukan. Perbarui pengaturan di host gateway."}},"pl":{"stringUnit":{"state":"translated","value":"Wymagany tryb lokalny. Zaktualizuj ustawienia na hoście Gateway."}},"th":{"stringUnit":{"state":"translated","value":"ต้องใช้โหมดในเครื่อง อัปเดตการตั้งค่าบนโฮสต์ของ Gateway"}},"vi":{"stringUnit":{"state":"translated","value":"Yêu cầu chế độ cục bộ. Cập nhật cài đặt trên máy chủ Gateway."}},"nl":{"stringUnit":{"state":"translated","value":"Lokale modus vereist. Werk de instellingen bij op de gatewayhost."}},"fa":{"stringUnit":{"state":"translated","value":"حالت محلی لازم است. تنظیمات را در میزبان Gateway به‌روزرسانی کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Требуется локальный режим. Обновите настройки на хосте Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Lokalt läge krävs. Uppdatera inställningarna på gateway-värden."}}}},
