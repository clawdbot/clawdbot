    "Wildcard config entries are edited from their concrete key.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Wildcard config entries are edited from their concrete key."}},"zh-CN":{"stringUnit":{"state":"translated","value":"通配符配置条目需通过其具体键进行编辑。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"萬用字元設定項目須透過其具體索引鍵進行編輯。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"As entradas de configuração com curingas são editadas a partir de sua chave concreta."}},"de":{"stringUnit":{"state":"translated","value":"Konfigurationseinträge mit Platzhaltern werden über ihren konkreten Schlüssel bearbeitet."}},"es":{"stringUnit":{"state":"translated","value":"Las entradas de configuración con comodines se editan desde su clave concreta."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ワイルドカード設定の項目は、具体的なキーから編集します。"}},"ko":{"stringUnit":{"state":"translated","value":"와일드카드 구성 항목은 해당하는 구체적인 키에서 편집합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les entrées de configuration avec caractères génériques se modifient à partir de leur clé concrète."}},"hi":{"stringUnit":{"state":"translated","value":"वाइल्डकार्ड कॉन्फ़िगरेशन प्रविष्टियों को उनकी विशिष्ट कुंजी से संपादित किया जाता है।"}},"ar":{"stringUnit":{"state":"translated","value":"تُحرَّر إدخالات التكوين التي تحتوي على أحرف بدل من خلال مفتاحها المحدد."}},"it":{"stringUnit":{"state":"translated","value":"Le voci di configurazione con caratteri jolly si modificano tramite la rispettiva chiave concreta."}},"tr":{"stringUnit":{"state":"translated","value":"Joker karakterli yapılandırma girdileri, karşılık gelen somut anahtar üzerinden düzenlenir."}},"uk":{"stringUnit":{"state":"translated","value":"Записи конфігурації із символами підстановки редагуються за їхнім конкретним ключем."}},"id":{"stringUnit":{"state":"translated","value":"Entri konfigurasi wildcard diedit melalui kunci konkretnya."}},"pl":{"stringUnit":{"state":"translated","value":"Wpisy konfiguracji z symbolami wieloznacznym