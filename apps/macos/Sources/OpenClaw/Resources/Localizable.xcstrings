    "Selected audio input has no usable Float32 format": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Selected audio input has no usable Float32 format"}},"zh-CN":{"stringUnit":{"state":"translated","value":"所选音频输入没有可用的 Float32 格式"}},"zh-TW":{"stringUnit":{"state":"translated","value":"所選音訊輸入沒有可用的 Float32 格式"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A entrada de áudio selecionada não tem um formato Float32 utilizável"}},"de":{"stringUnit":{"state":"translated","value":"Der ausgewählte Audioeingang hat kein nutzbares Float32-Format"}},"es":{"stringUnit":{"state":"translated","value":"La entrada de audio seleccionada no tiene un formato Float32 utilizable"}},"ja-JP":{"stringUnit":{"state":"translated","value":"選択した音声入力には使用可能なFloat32形式がありません"}},"ko":{"stringUnit":{"state":"translated","value":"선택한 오디오 입력에 사용 가능한 Float32 형식이 없습니다"}},"fr":{"stringUnit":{"state":"translated","value":"L’entrée audio sélectionnée ne dispose d’aucun format Float32 utilisable"}},"hi":{"stringUnit":{"state":"translated","value":"चयनित ऑडियो इनपुट में कोई उपयोग योग्य Float32 फ़ॉर्मैट नहीं है"}},"ar":{"stringUnit":{"state":"translated","value":"لا يتوفر تنسيق Float32 قابل للاستخدام لإدخال الصوت المحدد"}},"it":{"stringUnit":{"state":"translated","value":"L'ingresso audio selezionato non dispone di un formato Float32 utilizzabile"}},"tr":{"stringUnit":{"state":"translated","value":"Seçilen ses girişinde kullanılabilir Float32 biçimi yok"}},"uk":{"stringUnit":{"state":"translated","value":"Вибраний аудіовхід не має придатного формату Float32"}},"id":{"stringUnit":{"state":"translated","value":"Input audio yang dipilih tidak memiliki format Float32 yang dapat digunakan"}},"pl":{"stringUnit":{"state":"translated","value":"Wybrane wejście audio nie obsługuje odpowiedniego formatu Float32"}},"th":{"stringUnit":{"state":"translated","value":"อินพุตเสียงที่เลือกไม่มีรูปแบบ Float32 ที่ใช้งานได้"}},"vi":{"stringUnit":{"state":"translated","value":"Đầu vào âm thanh đã chọn không có định dạng Float32 khả dụng"}},"nl":{"stringUnit":{"state":"translated","value":"De geselecteerde audio-invoer heeft geen bruikbaar Float32-formaat"}},"fa":{"stringUnit":{"state":"translated","value":"ورودی صوتی انتخاب‌شده قالب Float32 قابل استفاده‌ای ندارد"}},"ru":{"stringUnit":{"state":"translated","value":"У выбранного аудиовхода нет подходящего формата Float32"}},"sv":{"stringUnit":{"state":"translated","value":"Den valda ljudingången har inget användbart Float32-format"}}}},
    "Selected input and system default are unavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Selected input and system default are unavailable"}},"zh-CN":{"stringUnit":{"state":"translated","value":"所选输入和系统默认输入均不可用"}},"zh-TW":{"stringUnit":{"state":"translated","value":"所選輸入與系統預設輸入皆無法使用"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A entrada selecionada e a padrão do sistema estão indisponíveis"}},"de":{"stringUnit":{"state":"translated","value":"Der ausgewählte Eingang und der Systemstandard sind nicht verfügbar"}},"es":{"stringUnit":{"state":"translated","value":"La entrada seleccionada y la predeterminada del sistema no están disponibles"}},"ja-JP":{"stringUnit":{"state":"translated","value":"選択した入力とシステムのデフォルト入力は利用できません"}},"ko":{"stringUnit":{"state":"translated","value":"선택한 입력과 시스템 기본 입력을 사용할 수 없습니다"}},"fr":{"stringUnit":{"state":"translated","value":"L’entrée sélectionnée et l’entrée par défaut du système sont indisponibles"}},"hi":{"stringUnit":{"state":"translated","value":"चयनित इनपुट और सिस्टम डिफ़ॉल्ट उपलब्ध नहीं हैं"}},"ar":{"stringUnit":{"state":"translated","value":"الإدخال المحدد والإدخال الافتراضي للنظام غير متاحين"}},"it":{"stringUnit":{"state":"translated","value":"L'ingresso selezionato e quello predefinito di sistema non sono disponibili"}},"tr":{"stringUnit":{"state":"translated","value":"Seçilen giriş ve sistemin varsayılan girişi kullanılamıyor"}},"uk":{"stringUnit":{"state":"translated","value":"Вибраний вхід і стандартний системний вхід недоступні"}},"id":{"stringUnit":{"state":"translated","value":"Input yang dipilih dan input default sistem tidak tersedia"}},"pl":{"stringUnit":{"state":"translated","value":"Wybrane wejście i domyślne wejście systemowe są niedostępne"}},"th":{"stringUnit":{"state":"translated","value":"อินพุตที่เลือกและอินพุตเริ่มต้นของระบบไม่พร้อมใช้งาน"}},"vi":{"stringUnit":{"state":"translated","value":"Đầu vào đã chọn và đầu vào mặc định của hệ thống đều không khả dụng"}},"nl":{