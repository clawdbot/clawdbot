    "Always Allow": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Always Allow"}},"zh-CN":{"stringUnit":{"state":"translated","value":"始终允许"}},"zh-TW":{"stringUnit":{"state":"translated","value":"永遠允許"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Permitir Sempre"}},"de":{"stringUnit":{"state":"translated","value":"Immer erlauben"}},"es":{"stringUnit":{"state":"translated","value":"Permitir Siempre"}},"ja-JP":{"stringUnit":{"state":"translated","value":"常に許可"}},"ko":{"stringUnit":{"state":"translated","value":"항상 허용"}},"fr":{"stringUnit":{"state":"translated","value":"Toujours autoriser"}},"hi":{"stringUnit":{"state":"translated","value":"हमेशा अनुमति दें"}},"ar":{"stringUnit":{"state":"translated","value":"السماح دائمًا"}},"it":{"stringUnit":{"state":"translated","value":"Consenti sempre"}},"tr":{"stringUnit":{"state":"translated","value":"Her Zaman İzin Ver"}},"uk":{"stringUnit":{"state":"translated","value":"Завжди дозволяти"}},"id":{"stringUnit":{"state":"translated","value":"Selalu Izinkan"}},"pl":{"stringUnit":{"state":"translated","value":"Zawsze zezwalaj"}},"th":{"stringUnit":{"state":"translated","value":"อนุญาตเสมอ"}},"vi":{"stringUnit":{"state":"translated","value":"Luôn cho phép"}},"nl":{"stringUnit":{"state":"translated","value":"Altijd toestaan"}},"fa":{"stringUnit":{"state":"translated","value":"همیشه اجازه بده"}},"ru":{"stringUnit":{"state":"translated","value":"Всегда разрешать"}},"sv":{"stringUnit":{"state":"translated","value":"Tillåt alltid"}}}},
    "Always Allow Here": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Always Allow Here"}},"zh-CN":{"stringUnit":{"state":"translated","value":"在此始终允许"}},"zh-TW":{"stringUnit":{"state":"translated","value":"一律在此允許"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Sempre permitir aqui"}},"de":{"stringUnit":{"state":"translated","value":"Hier immer erlauben"}},"es":{"stringUnit":{"state":"translated","value":"Permitir siempre aquí"}},"ja-JP":{"stringUnit":{"state":"translated","value":"ここでは常に許可"}},"ko":{"stringUnit":{"state":"translated","value":"여기서 항상 허용"}},"fr":{"stringUnit":{"state":"translated","value":"Toujours autoriser ici"}},"hi":{"stringUnit":{"state":"translated","value":"यहाँ हमेशा अनुमति दें"}},"ar":{"stringUnit":{"state":"translated","value":"السماح دائمًا هنا"}},"it":{"stringUnit":{"state":"translated","value":"Consenti sempre qui"}},"tr":{"stringUnit":{"state":"translated","value":"Burada her zaman izin ver"}},"uk":{"stringUnit":{"state":"translated","value":"Завжди дозволяти тут"}},"id":{"stringUnit":{"state":"translated","value":"Selalu Izinkan di Sini"}},"pl":{"stringUnit":{"state":"translated","value":"Zawsze zezwalaj tutaj"}},"th":{"stringUnit":{"state":"translated","value":"อนุญาตที่นี่เสมอ"}},"vi":{"stringUnit":{"state":"translated","value":"Luôn cho phép tại đây"}},"nl":{"stringUnit":{"state":"translated","value":"Hier altijd toestaan"}},"fa":{"stringUnit":{"state":"translated","value":"همیشه در اینجا اجازه بده"}},"ru":{"stringUnit":{"state":"translated","value":"Всегда разрешать здесь"}},"sv":{"stringUnit":{"state":"translated","value":"Tillåt alltid här"}}}},
    "Always Allow Here saves approval for future matching requests.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Always Allow Here saves approval for future matching requests."}},"zh-CN":{"stringUnit":{"state":"translated","value":"“在此始终允许”会保存批准设置，以便今后自动批准匹配的请求。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"「一律在此允許」會儲存核准設定，以便日後自動核准相符的請求。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Sempre permitir aqui salva a aprovação para futuras solicitações correspondentes."}},"de":{"stringUnit":{"state":"translated","value":"„Hier immer erlauben“ speichert die Genehmigung für künftige passende Anfragen."}},"es":{"stringUnit":{"state":"translated","value":"Permitir siempre aquí guarda la aprobación para futuras solicitudes coincidentes."}},"ja-JP":{"stringUnit":{"state":"translated","value":"「ここでは常に許可」を選択すると、今後同じ条件に一致するリクエストにも適用されるよう、承認が保存されます。"}},"ko":{"stringUnit":{"state":"translated","value":"‘여기서 항상 허용’을 선택하면 이후 일치하는 요청에도 적용되도록 승인이 저장됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"« Toujours autoriser ici » enregistre l’approbation pour les futures requêtes correspondantes."}},"hi":{"stringUnit":{"state":"translated","value":"यहाँ हमेशा अनुमति दें विकल्प भविष्य में आने वाले मेल खाते अनुरोधों के लिए स्वीकृति सहेजता है।"}},"ar":{"stringUnit":{"state":"translated","value":"يحفظ خيار «السماح دائمًا هنا» الموافقة للطلبات المطابقة مستقبلًا."}},"it":{"stringUnit":{"state":"translated","value":"Consenti sempre qui salva l’approvazione per le future richieste corrispondenti."}},"tr":{"stringUnit":{"state":"translated","value":"Burada her zaman izin ver seçeneği, gelecekteki eşleşen istekler için onayı kaydeder."}},"uk":{"stringUnit":{"state":"translated","value":"«Завжди дозволяти тут» зберігає дозвіл для майбутніх відповідних запитів."}},"id":{"stringUnit":{"state":"translated","value":"Selalu Izinkan di Sini menyimpan persetujuan untuk permintaan serupa di masa mendatang."}},"pl":{"stringUnit":{"state":"translated","value":"Opcja „Zawsze zezwalaj tutaj” zapisuje zgodę na przyszłe pasujące żądania."}},"th":{"stringUnit":{"state":"translated","value":"อนุญาตที่นี่เสมอจะบันทึกการอนุมัติไว้สำหรับคำขอที่ตรงกันในอนาคต"}},"vi":{"stringUnit":{"state":"translated","value":"Luôn cho phép tại đây sẽ lưu phê duyệt cho các yêu cầu tương tự trong tương lai."}},"nl":{"stringUnit":{"state":"translated","value":"Hier altijd toestaan slaat de goedkeuring op voor toekomstige overeenkomende verzoeken."}},"fa":{"stringUnit":{"state":"translated","value":"گزینه «همیشه در اینجا اجازه بده» تأیید را برای درخواست‌های مشابه آینده ذخیره می‌کند."}},"ru":{"stringUnit":{"state":"translated","value":"«Всегда разрешать здесь» сохраняет разрешение для будущих запросов, соответствующих тем же условиям."}},"sv":{"stringUnit":{"state":"translated","value":"Tillåt alltid här sparar godkännandet för framtida matchande förfrågningar."}}}},
    "Always Ask": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Always Ask"}},"zh-CN":{"stringUnit":{"state":"translated","value":"始终询问"}},"zh-TW":{"stringUnit":{"state":"translated","value":"一律詢問"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Perguntar Sempre"}},"de":{"stringUnit":{"state":"translated","value":"Immer fragen"}},"es":{"stringUnit":{"state":"translated","value":"Preguntar Siempre"}},"ja-JP":{"stringUnit":{"state":"translated","value":"常に確認"}},"ko":{"stringUnit":{"state":"translated","value":"항상 묻기"}},"fr":{"stringUnit":{"state":"translated","value":"Toujours demander"}},"hi":{"stringUnit":{"state":"translated","value":"हमेशा पूछें"}},"ar":{"stringUnit":{"state":"translated","value":"السؤال دائمًا"}},"it":{"stringUnit":{"state":"translated","value":"Chiedi sempre"}},"tr":{"stringUnit":{"state":"translated","value":"Her Zaman Sor"}},"uk":{"stringUnit":{"state":"translated","value":"Завжди запитувати"}},"id":{"stringUnit":{"state":"translated","value":"Selalu Tanya"}},"pl":{"stringUnit":{"state":"translated","value":"Zawsze pytaj"}},"th":{"stringUnit":{"state":"translated","value":"ถามเสมอ"}},"vi":{"stringUnit":{"state":"translated","value":"Luôn hỏi"}},"nl":{"stringUnit":{"state":"translated","value":"Altijd vragen"}},"fa":{"stringUnit":{"state":"translated","value":"همیشه بپرس"}},"ru":{"stringUnit":{"state":"translated","value":"Всегда спрашивать"}},"sv":{"stringUnit":{"state":"translated","value":"Fråga alltid"}}}},
    "Always may require System Settings to approve background location.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Always may require System Settings to approve background location."}},"zh-CN":{"stringUnit":{"state":"translated","value":"选择始终可能需要在系统设置中批准后台位置访问。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"選取「永遠」可能需要在系統設定中核准背景位置存取權限。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A opção Sempre pode exigir aprovação nos Ajustes do Sistema para acessar a localização em segundo plano."}},"de":{"stringUnit":{"state":"translated","value":"Für Immer muss der Standortzugriff im Hintergrund möglicherweise in den Systemeinstellungen genehmigt werden."}},"es":{"stringUnit":{"state":"translated","value":"La opción Siempre puede requerir que se autorice el acceso a la ubicación en segundo plano en Ajustes del Sistema."}},"ja-JP":{"stringUnit":{"state":"translated","value":"「常に」を使用するには、システム設定でバックグラウンドでの位置情報へのアクセスを許可する必要がある場合があります。"}},"ko":{"stringUnit":{"state":"translated","value":"항상을 선택하면 시스템 설정에서 백그라운드 위치 접근을 승인해야 할 수 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’option Toujours peut nécessiter une autorisation de localisation en arrière-plan dans les Réglages système."}},"hi":{"stringUnit":{"state":"translated","value":"हमेशा के लिए पृष्ठभूमि में स्थान की अनुमति देने हेतु सिस्टम सेटिंग्स में स्वीकृति आवश्यक हो सकती है."}},"ar":{"stringUnit":{"state":"translated","value":"قد يتطلب خيار دائمًا الموافقة على الوصول إلى الموقع في الخلفية من إعدادات النظام."}},"it":{"stringUnit":{"state":"translated","value":"L'opzione Sempre potrebbe richiedere l'approvazione dell'accesso alla posizione in background nelle Impostazioni di sistema."}},"tr":{"stringUnit":{"state":"translated","value":"Her Zaman seçeneği, arka planda konum erişimi için Sistem Ayarları'ndan onay gerektirebilir."}},"uk":{"stringUnit":{"state":"translated","value":"Для режиму «Завжди» може знадобитися дозвіл на доступ до геопозиції у фоновому режимі в системних параметрах."}},"id":{"stringUnit":{"state":"translated","value":"Selalu mungkin memerlukan persetujuan akses lokasi di latar belakang melalui Pengaturan Sistem."}},"pl":{"stringUnit":{"state":"translated","value":"Opcja Zawsze może wymagać zatwierdzenia dostępu do lokalizacji w tle w ustawieniach systemowych."}},"th":{"stringUnit":{"state":"translated","value":"ตัวเลือกตลอดเวลาอาจต้องได้รับการอนุมัติให้เข้าถึงตำแหน่งที่ตั้งเบื้องหลังในการตั้งค่าระบบ."}},"vi":{"stringUnit":{"state":"translated","value":"Tùy chọn Luôn luôn có thể yêu cầu phê duyệt quyền truy cập vị trí trong nền tại Cài đặt hệ thống."}},"nl":{"stringUnit":{"state":"translated","value":"Voor Altijd moet locatietoegang op de achtergrond mogelijk worden goedgekeurd in Systeeminstellingen."}},"fa":{"stringUnit":{"state":"translated","value":"گزینهٔ همیشه ممکن است برای تأیید دسترسی به موقعیت مکانی در پس‌زمینه به تنظیمات سیستم نیاز داشته باشد."}},"ru":{"stringUnit":{"state":"translated","value":"Для режима «Всегда» может потребоваться разрешить доступ к геопозиции в фоновом режиме в системных настройках."}},"sv":{"stringUnit":{"state":"translated","value":"Alltid kan kräva godkännande av platsåtkomst i bakgrunden i Systeminställningar."}}}},
