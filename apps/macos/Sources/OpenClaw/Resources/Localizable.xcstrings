    "Recheck macOS after approving access in System Settings.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recheck macOS after approving access in System Settings."}},"zh-CN":{"stringUnit":{"state":"translated","value":"在系统设置中批准访问权限后，重新检查 macOS。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"在「系統設定」中核准存取權限後，重新檢查 macOS。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Verifique novamente o macOS após aprovar o acesso em Ajustes do Sistema."}},"de":{"stringUnit":{"state":"translated","value":"macOS erneut prüfen, nachdem der Zugriff in den Systemeinstellungen genehmigt wurde."}},"es":{"stringUnit":{"state":"translated","value":"Vuelve a comprobar macOS después de aprobar el acceso en Ajustes del Sistema."}},"ja-JP":{"stringUnit":{"state":"translated","value":"システム設定でアクセスを承認した後、macOS を再確認してください。"}},"ko":{"stringUnit":{"state":"translated","value":"시스템 설정에서 접근을 승인한 후 macOS를 다시 확인하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Revérifiez macOS après avoir approuvé l’accès dans Réglages Système."}},"hi":{"stringUnit":{"state":"translated","value":"System Settings में एक्सेस स्वीकृत करने के बाद macOS फिर से जाँचें।"}},"ar":{"stringUnit":{"state":"translated","value":"أعد فحص macOS بعد الموافقة على الوصول في إعدادات النظام."}},"it":{"stringUnit":{"state":"translated","value":"Ricontrolla macOS dopo aver approvato l’accesso in Impostazioni di Sistema."}},"tr":{"stringUnit":{"state":"translated","value":"Sistem Ayarları’nda erişimi onayladıktan sonra macOS’i yeniden kontrol edin."}},"uk":{"stringUnit":{"state":"translated","value":"Повторно перевірте macOS після схвалення доступу в System Settings."}},"id":{"stringUnit":{"state":"translated","value":"Periksa ulang macOS setelah menyetujui akses di Pengaturan Sistem."}},"pl":{"stringUnit":{"state":"translated","value":"Sprawdź ponownie macOS po zatwierdzeniu dostępu w Ustawieniach systemowych."}},"th":{"stringUnit":{"state":"translated","value":"ตรวจสอบ macOS อีกครั้งหลังจากอน