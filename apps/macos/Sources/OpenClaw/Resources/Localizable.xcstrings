    "Accessibility access is required to attach text from %@.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Accessibility access is required to attach text from %@."}},"zh-CN":{"stringUnit":{"state":"translated","value":"需要辅助功能访问权限才能附加来自 %@ 的文本。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"需要輔助使用權限才能附加來自 %@ 的文字。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"É necessário acesso à Acessibilidade para anexar texto de %@."}},"de":{"stringUnit":{"state":"translated","value":"Zugriff auf Bedienungshilfen ist erforderlich, um Text aus %@ anzuhängen."}},"es":{"stringUnit":{"state":"translated","value":"Se requiere acceso de accesibilidad para adjuntar texto de %@."}},"ja-JP":{"stringUnit":{"state":"translated","value":"%@ からテキストを添付するには、アクセシビリティのアクセス権が必要です。"}},"ko":{"stringUnit":{"state":"translated","value":"%@의 텍스트를 첨부하려면 손쉬운 사용 접근 권한이 필요합니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’autorisation d’accessibilité est requise pour joindre du texte provenant de %@."}},"hi":{"stringUnit":{"state":"translated","value":"%@ से टेक्स्ट संलग्न करने के लिए सुलभता की अनुमति आवश्यक है."}},"ar":{"stringUnit":{"state":"translated","value":"يلزم منح إذن تسهيلات الاستخدام لإرفاق نص من %@."}},"it":{"stringUnit":{"state":"translated","value":"È richiesta l’autorizzazione di accessibilità per allegare testo da %@."}},"tr":{"stringUnit":{"state":"translated","value":"%@ uygulamasından metin eklemek için erişilebilirlik izni gereklidir."}},"uk":{"stringUnit":{"state":"translated","value":"Для прикріплення тексту з %@ потрібен дозвіл на використання функцій доступності."}},"id":{"stringUnit":{"state":"translated","value":"Akses aksesibilitas diperlukan untuk melampirkan teks dari %@."}},"pl":{"stringUnit":{"state":"translated","value":"Do dołączenia tekstu z %@ wymagane jest uprawnienie do korzystania z funkcji dostępności."}},"th":{"stringUnit":{"state":"translated","value":"ต้องมีสิทธิ์การช่วยการเข้าถึงเพื่อแนบข้อความจาก %@."}},"vi":{"stringUnit":{"state":"translated","value":"Cần có quyền truy cập Trợ năng để đính kèm văn bản từ %@."}},"nl":{"stringUnit":{"state":"translated","value":"Toegang tot toegankelijkheidsfuncties is vereist om tekst uit %@ bij te voegen."}},"fa":{"stringUnit":{"state":"translated","value":"برای پیوست کردن متن از %@، مجوز دسترس‌پذیری لازم است."}},"ru":{"stringUnit":{"state":"translated","value":"Для прикрепления текста из %@ требуется разрешение на универсальный доступ."}},"sv":{"stringUnit":{"state":"translated","value":"Åtkomst till hjälpmedel krävs för att bifoga text från %@."}}}},
    "Accessibility permission is required to paste.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Accessibility permission is required to paste."}},"zh-CN":{"stringUnit":{"state":"translated","value":"需要辅助功能权限才能粘贴。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"需要輔助使用權限才能貼上。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"É necessária permissão de Acessibilidade para colar."}},"de":{"stringUnit":{"state":"translated","value":"Zum Einfügen ist die Berechtigung für Bedienungshilfen erforderlich."}},"es":{"stringUnit":{"state":"translated","value":"Se requiere permiso de accesibilidad para pegar."}},"ja-JP":{"stringUnit":{"state":"translated","value":"貼り付けるには、アクセシビリティの権限が必要です。"}},"ko":{"stringUnit":{"state":"translated","value":"붙여넣으려면 손쉬운 사용 권한이 필요합니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’autorisation d’accessibilité est requise pour coller."}},"hi":{"stringUnit":{"state":"translated","value":"पेस्ट करने के लिए सुलभता की अनुमति आवश्यक है."}},"ar":{"stringUnit":{"state":"translated","value":"يلزم منح إذن تسهيلات الاستخدام للصق."}},"it":{"stringUnit":{"state":"translated","value":"È richiesta l’autorizzazione di accessibilità per incollare."}},"tr":{"stringUnit":{"state":"translated","value":"Yapıştırmak için erişilebilirlik izni gereklidir."}},"uk":{"stringUnit":{"state":"translated","value":"Для вставлення потрібен дозвіл на використання функцій доступності."}},"id":{"stringUnit":{"state":"translated","value":"Izin aksesibilitas diperlukan untuk menempelkan."}},"pl":{"stringUnit":{"state":"translated","value":"Do wklejania wymagane jest uprawnienie do korzystania z funkcji dostępności."}},"th":{"stringUnit":{"state":"translated","value":"ต้องมีสิทธิ์การช่วยการเข้าถึงเพื่อวาง."}},"vi":{"stringUnit":{"state":"translated","value":"Cần có quyền Trợ năng để dán."}},"nl":{"stringUnit":{"state":"translated","value":"Toestemming voor toegankelijkheid is vereist om te plakken."}},"fa":{"stringUnit":{"state":"translated","value":"برای جای‌گذاری، مجوز دسترس‌پذیری لازم است."}},"ru":{"stringUnit":{"state":"translated","value":"Для вставки требуется разрешение на универсальный доступ."}},"sv":{"stringUnit":{"state":"translated","value":"Behörighet för hjälpmedel krävs för att klistra in."}}}},
    "Accessibility, Event Posting, and Screen Recording are granted.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Accessibility, Event Posting, and Screen Recording are granted."}},"zh-CN":{"stringUnit":{"state":"translated","value":"已授予辅助功能、事件发送和屏幕录制权限。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已授予輔助使用、事件傳送和螢幕錄製權限。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"As permissões de Acessibilidade, Envio de Eventos e Gravação de Tela foram concedidas."}},"de":{"stringUnit":{"state":"translated","value":"Die Berechtigungen für Bedienungshilfen, das Senden von Ereignissen und Bildschirmaufnahme wurden erteilt."}},"es":{"stringUnit":{"state":"translated","value":"Se han concedido los permisos de accesibilidad, envío de eventos y grabación de pantalla."}},"ja-JP":{"stringUnit":{"state":"translated","value":"アクセシビリティ、イベント送信、画面収録が許可されています。"}},"ko":{"stringUnit":{"state":"translated","value":"손쉬운 사용, 이벤트 전송 및 화면 기록 권한이 부여되었습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les autorisations d’accessibilité, d’envoi d’événements et d’enregistrement de l’écran sont accordées."}},"hi":{"stringUnit":{"state":"translated","value":"सुलभता, इवेंट पोस्टिंग, और स्क्रीन रिकॉर्डिंग की अनुमतियाँ दी गई हैं."}},"ar":{"stringUnit":{"state":"translated","value":"تم منح أذونات تسهيلات الاستخدام، وإرسال الأحداث، وتسجيل الشاشة."}},"it":{"stringUnit":{"state":"translated","value":"Le autorizzazioni per Accessibilità, Invio eventi e Registrazione schermo sono state concesse."}},"tr":{"stringUnit":{"state":"translated","value":"Erişilebilirlik, Olay Gönderme ve Ekran Kaydı izinleri verildi."}},"uk":{"stringUnit":{"state":"translated","value":"Надано дозволи на використання функцій доступності, надсилання подій і запис екрана."}},"id":{"stringUnit":{"state":"translated","value":"Izin Aksesibilitas, Pengiriman Peristiwa, dan Perekaman Layar telah diberikan."}},"pl":{"stringUnit":{"state":"translated","value":"Przyznano uprawnienia do korzystania z funkcji dostępności, wysyłania zdarzeń i nagrywania ekranu."}},"th":{"stringUnit":{"state":"translated","value":"ได้รับสิทธิ์การช่วยการเข้าถึง การส่งเหตุการณ์ และการบันทึกหน้าจอแล้ว."}},"vi":{"stringUnit":{"state":"translated","value":"Đã cấp quyền Trợ năng, Gửi sự kiện và Ghi màn hình."}},"nl":{"stringUnit":{"state":"translated","value":"Toestemming voor toegankelijkheid, het verzenden van gebeurtenissen en schermopname is verleend."}},"fa":{"stringUnit":{"state":"translated","value":"مجوزهای دسترس‌پذیری، ارسال رویداد و ضبط صفحه اعطا شده‌اند."}},"ru":{"stringUnit":{"state":"translated","value":"Разрешения на универсальный доступ, отправку событий и запись экрана предоставлены."}},"sv":{"stringUnit":{"state":"translated","value":"Behörigheter för hjälpmedel, händelsesändning och skärminspelning har beviljats."}}}},
