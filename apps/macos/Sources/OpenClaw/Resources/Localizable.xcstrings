    "Wake phrases, push-to-talk, microphone input, and Talk Mode feedback.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Wake phrases, push-to-talk, microphone input, and Talk Mode feedback."}},"zh-CN":{"stringUnit":{"state":"translated","value":"唤醒短语、一键通、麦克风输入和 Talk Mode 反馈。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"喚醒詞、隨按即說、麥克風輸入，以及 Talk Mode 回饋。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Frases de ativação, push-to-talk, entrada de microfone e feedback do Modo de fala."}},"de":{"stringUnit":{"state":"translated","value":"Weckphrasen, Push-to-Talk, Mikrofoneingabe und Feedback im Talk Mode."}},"es":{"stringUnit":{"state":"translated","value":"Frases de activación, pulsar para hablar, entrada de micrófono y respuestas del Modo Conversación."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ウェイクフレーズ、プッシュトゥトーク、マイク入力、Talk Modeのフィードバック。"}},"ko":{"stringUnit":{"state":"translated","value":"깨우기 문구, 푸시 투 토크, 마이크 입력 및 Talk Mode 피드백."}},"fr":{"stringUnit":{"state":"translated","value":"Phrases de réveil, push-to-talk, entrée microphone et retour du Mode conversation."}},"hi":{"stringUnit":{"state":"translated","value":"वेक वाक्यांश, push-to-talk, माइक्रोफ़ोन इनपुट, और Talk Mode फ़ीडबैक।"}},"ar":{"stringUnit":{"state":"translated","value":"عبارات التنبيه، والضغط للتحدث، وإدخال الميكروفون، وملاحظات وضع التحدث."}},"it":{"stringUnit":{"state":"translated","value":"Frasi di attivazione, push-to-talk, ingresso microfono e feedback della modalità Talk."}},"tr":{"stringUnit":{"state":"translated","value":"Uyandırma ifadeleri, bas-konuş, mikrofon girişi ve Talk Mode geri bildirimi."}},"uk":{"stringUnit":{"state":"translated","value":"Фрази пробудження, push-to-talk, вхід мікрофона та зворотний зв’язок Talk Mode."}},"id":{"stringUnit":{"state":"translated","value":"Frasa bangun, push-to-talk, input mikrofon, dan umpan balik Talk Mode."}},"pl":{"stringUnit":{"state":"translated","value":"Frazy wybudzania, push-to-talk, wejście m