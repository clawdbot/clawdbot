    "Realtime disconnected repeatedly — using native speech": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Realtime disconnected repeatedly — using native speech"}},"zh-CN":{"stringUnit":{"state":"translated","value":"实时连接反复断开 — 正在使用原生语音"}},"zh-TW":{"stringUnit":{"state":"translated","value":"即時連線多次中斷 — 正在使用原生語音"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Conexão em tempo real desconectada repetidamente — usando voz nativa"}},"de":{"stringUnit":{"state":"translated","value":"Echtzeitverbindung wiederholt getrennt — native Sprachfunktion wird verwendet"}},"es":{"stringUnit":{"state":"translated","value":"La conexión en tiempo real se desconectó repetidamente — usando voz nativa"}},"ja-JP":{"stringUnit":{"state":"translated","value":"リアルタイム接続が繰り返し切断されました — ネイティブ音声機能を使用中"}},"ko":{"stringUnit":{"state":"translated","value":"실시간 연결이 반복적으로 끊겼습니다 — 기본 음성 기능 사용 중"}},"fr":{"stringUnit":{"state":"translated","value":"Connexion en temps réel interrompue à plusieurs reprises — utilisation des fonctions vocales natives"}},"hi":{"stringUnit":{"state":"translated","value":"रीयलटाइम बार-बार डिस्कनेक्ट हुआ — डिवाइस की अंतर्निहित वाक् सुविधा का उपयोग किया जा रहा है"}},"ar":{"stringUnit":{"state":"translated","value":"انقطع الاتصال في الوقت الفعلي مرارًا — جارٍ استخدام الكلام المدمج في النظام"}},"it":{"stringUnit":{"state":"translated","value":"Connessione in tempo reale interrotta ripetutamente — utilizzo delle funzionalità vocali native"}},"tr":{"stringUnit":{"state":"translated","value":"Gerçek zamanlı bağlantı art arda kesildi — yerel konuşma özelliği kullanılıyor"}},"uk":{"stringUnit":{"state":"translated","value":"З’єднання в реальному часі неодноразово розривалося — використовується системна обробка мовлення"}},"id":{"stringUnit":{"state":"translated","value":"Koneksi waktu nyata berulang kali terputus — menggunakan fitur ucapan bawaan"}},"pl":{"stringUnit":{"state":"translated","value":"Połączenie w czasie rzeczywistym było wielokrotnie przer