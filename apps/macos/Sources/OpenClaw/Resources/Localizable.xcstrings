    "Connect a local model service, or prepare a model on this Gateway.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connect a local model service, or prepare a model on this Gateway."}},"zh-CN":{"stringUnit":{"state":"translated","value":"连接本地模型服务, 或在此 Gateway 上准备模型。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"連線至本機模型服務, 或在此 Gateway 上準備模型。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Conecte um serviço de modelos local ou prepare um modelo neste Gateway."}},"de":{"stringUnit":{"state":"translated","value":"Verbinden Sie einen lokalen Modelldienst, oder bereiten Sie ein Modell auf diesem Gateway vor."}},"es":{"stringUnit":{"state":"translated","value":"Conecta un servicio de modelos local, o prepara un modelo en este Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ローカルモデルサービスに接続するか、この Gateway でモデルを準備してください。"}},"ko":{"stringUnit":{"state":"translated","value":"로컬 모델 서비스에 연결하거나 이 Gateway에서 모델을 준비하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Connectez un service de modèles local, ou préparez un modèle sur ce Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"स्थानीय मॉडल सेवा कनेक्ट करें, या इस Gateway पर एक मॉडल तैयार करें."}},"ar":{"stringUnit":{"state":"translated","value":"اتصل بخدمة نماذج محلية، أو جهّز نموذجًا على Gateway هذا."}},"it":{"stringUnit":{"state":"translated","value":"Connetti un servizio di modelli locale, oppure prepara un modello su questo Gateway."}},"tr":{"stringUnit":{"state":"translated","value":"Yerel bir model hizmeti bağlayın veya bu Gateway üzerinde bir model hazırlayın."}},"uk":{"stringUnit":{"state":"translated","value":"Підключіть локальну службу моделей або підготуйте модель на цьому Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Hubungkan layanan model lokal, atau siapkan model di Gateway ini."}},"pl":{"stringUnit":{"state":"translated","value":"Podłącz lokalną usługę modeli lub przygotuj model na tym Gateway."}},"th":{"stringUnit":{"state":"translated","value":"เชื่อมต่อบริการโมเดลภายในเครื่อง, หรือเตรียมโมเดลบน Gateway นี้."}},"vi":{"stringUnit":{"state":"translated","value":"Kết nối một dịch vụ mô hình cục bộ, hoặc chuẩn bị một mô hình trên Gateway này."}},"nl":{"stringUnit":{"state":"translated","value":"Verbind een lokale modelservice, of bereid een model voor op deze Gateway."}},"fa":{"stringUnit":{"state":"translated","value":"به یک سرویس مدل محلی متصل شوید، یا مدلی را روی این Gateway آماده کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Подключите локальный сервис моделей или подготовьте модель на этом Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Anslut en lokal modelltjänst eller förbered en modell på denna Gateway."}}}},
    "Connect a provider below with an API key or token, then check again.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connect a provider below with an API key or token, then check again."}},"zh-CN":{"stringUnit":{"state":"translated","value":"使用 API 密钥或令牌连接下方的提供商, 然后重新检查。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"使用 API 金鑰或權杖連線至下方的供應商, 然後再次檢查。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Conecte um provedor abaixo com uma chave de API ou um token e verifique novamente."}},"de":{"stringUnit":{"state":"translated","value":"Verbinden Sie unten einen Anbieter mit einem API-Schlüssel oder Token, und prüfen Sie dann erneut."}},"es":{"stringUnit":{"state":"translated","value":"Conecta un proveedor a continuación con una clave de API o un token, y luego vuelve a comprobar."}},"ja-JP":{"stringUnit":{"state":"translated","value":"API キーまたはトークンを使用して以下のプロバイダーに接続し、再度確認してください。"}},"ko":{"stringUnit":{"state":"translated","value":"API 키 또는 토큰으로 아래 제공업체에 연결한 후 다시 확인하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Connectez un fournisseur ci-dessous avec une clé API ou un jeton, puis vérifiez à nouveau."}},"hi":{"stringUnit":{"state":"translated","value":"API कुंजी या टोकन का उपयोग करके नीचे किसी प्रदाता को कनेक्ट करें, फिर दोबारा जाँचें."}},"ar":{"stringUnit":{"state":"translated","value":"اتصل بأحد المزوّدين أدناه باستخدام مفتاح API أو رمز، ثم تحقق مجددًا."}},"it":{"stringUnit":{"state":"translated","value":"Connetti uno dei provider qui sotto con una chiave API o un token, poi verifica di nuovo."}},"tr":{"stringUnit":{"state":"translated","value":"Aşağıdaki sağlayıcılardan birini API anahtarı veya belirteç ile bağlayın, ardından tekrar kontrol edin."}},"uk":{"stringUnit":{"state":"translated","value":"Підключіть постачальника нижче за допомогою ключа API або токена, а потім перевірте ще раз."}},"id":{"stringUnit":{"state":"translated","value":"Hubungkan penyedia di bawah dengan kunci API atau token, lalu periksa lagi."}},"pl":{"stringUnit":{"state":"translated","value":"Połącz się z dostawcą poniżej za pomocą klucza API lub tokenu, a następnie sprawdź ponownie."}},"th":{"stringUnit":{"state":"translated","value":"เชื่อมต่อผู้ให้บริการด้านล่างด้วยคีย์ API หรือโทเค็น, แล้วตรวจสอบอีกครั้ง."}},"vi":{"stringUnit":{"state":"translated","value":"Kết nối một nhà cung cấp bên dưới bằng khóa API hoặc mã thông báo, rồi kiểm tra lại."}},"nl":{"stringUnit":{"state":"translated","value":"Verbind hieronder een provider met een API-sleutel of token en controleer het vervolgens opnieuw."}},"fa":{"stringUnit":{"state":"translated","value":"یکی از ارائه‌دهندگان زیر را با کلید API یا توکن متصل کنید، سپس دوباره بررسی کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Подключите провайдера ниже с помощью ключа API или токена, затем проверьте снова."}},"sv":{"stringUnit":{"state":"translated","value":"Anslut en leverantör nedan med en API-nyckel eller token och kontrollera sedan igen."}}}},
