    "Select a channel to view status and settings.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Select a channel to view status and settings."}},"zh-CN":{"stringUnit":{"state":"translated","value":"选择一个渠道以查看状态和设置。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"選取頻道以檢視狀態與設定。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Selecione um canal para ver o status e as configurações."}},"de":{"stringUnit":{"state":"translated","value":"Wählen Sie einen Kanal aus, um Status und Einstellungen anzuzeigen."}},"es":{"stringUnit":{"state":"translated","value":"Selecciona un canal para ver su estado y configuración."}},"ja-JP":{"stringUnit":{"state":"translated","value":"チャンネルを選択して、ステータスと設定を表示します。"}},"ko":{"stringUnit":{"state":"translated","value":"상태 및 설정을 보려면 채널을 선택하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Sélectionnez un canal pour afficher son état et ses paramètres."}},"hi":{"stringUnit":{"state":"translated","value":"स्थिति और सेटिंग्स देखने के लिए कोई चैनल चुनें."}},"ar":{"stringUnit":{"state":"translated","value":"حدد قناة لعرض الحالة والإعدادات."}},"it":{"stringUnit":{"state":"translated","value":"Seleziona un canale per visualizzare stato e impostazioni."}},"tr":{"stringUnit":{"state":"translated","value":"Durumu ve ayarları görüntülemek için bir kanal seçin."}},"uk":{"stringUnit":{"state":"translated","value":"Виберіть канал, щоб переглянути стан і налаштування."}},"id":{"stringUnit":{"state":"translated","value":"Pilih saluran untuk melihat status dan pengaturan."}},"pl":{"stringUnit":{"state":"translated","value":"Wybierz kanał, aby wyświetlić stan i ustawienia."}},"th":{"stringUnit":{"state":"translated","value":"เลือกช่องทางเพื่อดูสถานะและการตั้งค่า."}},"vi":{"stringUnit":{"state":"translated","value":"Chọn một kênh để xem trạng thái và cài đặt."}},"nl":{"stringUnit":{"state":"translated","value":"Selecteer een kanaal om de status en instellingen te bekijken."}},"fa":{"stringUnit":{"state":"translated","value":"برای مشاهدهٔ وضعیت و تنظیمات، یک کانال انتخاب کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Выберите канал для просмотра состояния и настроек."}},"sv":{"stringUnit":{"state":"translated","value":"Välj en kanal för att visa status och inställningar."}}}},
    "Select a config section to view settings.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Select a config section to view settings."}},"zh-CN":{"stringUnit":{"state":"translated","value":"选择一个配置部分以查看设置。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"選取設定區段以檢視設定。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Selecione uma seção de configuração para ver as configurações."}},"de":{"stringUnit":{"state":"translated","value":"Wählen Sie einen Konfigurationsabschnitt aus, um Einstellungen anzuzeigen."}},"es":{"stringUnit":{"state":"translated","value":"Selecciona una sección de configuración para ver los ajustes."}},"ja-JP":{"stringUnit":{"state":"translated","value":"構成セクションを選択して、設定を表示します。"}},"ko":{"stringUnit":{"state":"translated","value":"설정을 보려면 구성 섹션을 선택하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Sélectionnez une section de configuration pour afficher ses paramètres."}},"hi":{"stringUnit":{"state":"translated","value":"सेटिंग्स देखने के लिए कोई कॉन्फ़िगरेशन अनुभाग चुनें."}},"ar":{"stringUnit":{"state":"translated","value":"حدد قسم تهيئة لعرض الإعدادات."}},"it":{"stringUnit":{"state":"translated","value":"Seleziona una sezione della configurazione per visualizzare le impostazioni."}},"tr":{"stringUnit":{"state":"translated","value":"Ayarları görüntülemek için bir yapılandırma bölümü seçin."}},"uk":{"stringUnit":{"state":"translated","value":"Виберіть розділ конфігурації, щоб переглянути налаштування."}},"id":{"stringUnit":{"state":"translated","value":"Pilih bagian konfigurasi untuk melihat pengaturan."}},"pl":{"stringUnit":{"state":"translated","value":"Wybierz sekcję konfiguracji, aby wyświetlić ustawienia."}},"th":{"stringUnit":{"state":"translated","value":"เลือกส่วนการกำหนดค่าเพื่อดูการตั้งค่า."}},"vi":{"stringUnit":{"state":"translated","value":"Chọn một mục cấu hình để xem cài đặt."}},"nl":{"stringUnit":{"state":"translated","value":"Selecteer een configuratiesectie om de instellingen te bekijken."}},"fa":{"stringUnit":{"state":"translated","value":"برای مشاهدهٔ تنظیمات، یک بخش پیکربندی انتخاب کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Выберите раздел конфигурации для просмотра настроек."}},"sv":{"stringUnit":{"state":"translated","value":"Välj ett konfigurationsavsnitt för att visa inställningar."}}}},
    "Select a job to inspect details and run history.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Select a job to inspect details and run history."}},"zh-CN":{"stringUnit":{"state":"translated","value":"选择一个任务以查看详情和运行历史。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"選取工作以檢視詳細資料與執行記錄。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Selecione uma tarefa para examinar os detalhes e o histórico de execuções."}},"de":{"stringUnit":{"state":"translated","value":"Wählen Sie einen Auftrag aus, um Details und den Ausführungsverlauf einzusehen."}},"es":{"stringUnit":{"state":"translated","value":"Selecciona una tarea para ver sus detalles y el historial de ejecuciones."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ジョブを選択して、詳細と実行履歴を確認します。"}},"ko":{"stringUnit":{"state":"translated","value":"세부 정보와 실행 기록을 확인하려면 작업을 선택하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Sélectionnez une tâche pour consulter ses détails et son historique d’exécution."}},"hi":{"stringUnit":{"state":"translated","value":"विवरण और रन इतिहास देखने के लिए कोई जॉब चुनें."}},"ar":{"stringUnit":{"state":"translated","value":"حدد مهمة للاطلاع على التفاصيل وسجل التشغيل."}},"it":{"stringUnit":{"state":"translated","value":"Seleziona un'attività per esaminare i dettagli e la cronologia delle esecuzioni."}},"tr":{"stringUnit":{"state":"translated","value":"Ayrıntıları ve çalıştırma geçmişini incelemek için bir görev seçin."}},"uk":{"stringUnit":{"state":"translated","value":"Виберіть завдання, щоб переглянути подробиці та історію виконання."}},"id":{"stringUnit":{"state":"translated","value":"Pilih tugas untuk memeriksa detail dan riwayat eksekusi."}},"pl":{"stringUnit":{"state":"translated","value":"Wybierz zadanie, aby sprawdzić szczegóły i historię uruchomień."}},"th":{"stringUnit":{"state":"translated","value":"เลือกงานเพื่อตรวจสอบรายละเอียดและประวัติการทำงาน."}},"vi":{"stringUnit":{"state":"translated","value":"Chọn một tác vụ để xem chi tiết và lịch sử chạy."}},"nl":{"stringUnit":{"state":"translated","value":"Selecteer een taak om de details en uitvoeringsgeschiedenis te bekijken."}},"fa":{"stringUnit":{"state":"translated","value":"برای بررسی جزئیات و تاریخچهٔ اجرا، یک کار انتخاب کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Выберите задание для просмотра подробностей и истории запусков."}},"sv":{"stringUnit":{"state":"translated","value":"Välj ett jobb för att granska detaljer och körningshistorik."}}}},
    "Select an agent scope above to add trusted commands.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Select an agent scope above to add trusted commands."}},"zh-CN":{"stringUnit":{"state":"translated","value":"在上方选择一个智能体作用域以添加受信任的命令。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"在上方選取代理程式範圍以新增受信任的命令。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Selecione um escopo de agente acima para adicionar comandos confiáveis."}},"de":{"stringUnit":{"state":"translated","value":"Wählen Sie oben einen Agentenbereich aus, um vertrauenswürdige Befehle hinzuzufügen."}},"es":{"stringUnit":{"state":"translated","value":"Selecciona un ámbito de agente arriba para añadir comandos de confianza."}},"ja-JP":{"stringUnit":{"state":"translated","value":"上でエージェントのスコープを選択して、信頼済みコマンドを追加します。"}},"ko":{"stringUnit":{"state":"translated","value":"신뢰할 수 있는 명령을 추가하려면 위에서 에이전트 범위를 선택하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Sélectionnez un périmètre d’agent ci-dessus pour ajouter des commandes de confiance."}},"hi":{"stringUnit":{"state":"translated","value":"विश्वसनीय कमांड जोड़ने के लिए ऊपर कोई एजेंट स्कोप चुनें."}},"ar":{"stringUnit":{"state":"translated","value":"حدد نطاق وكيل أعلاه لإضافة أوامر موثوقة."}},"it":{"stringUnit":{"state":"translated","value":"Seleziona un ambito agente qui sopra per aggiungere comandi attendibili."}},"tr":{"stringUnit":{"state":"translated","value":"Güvenilen komutları eklemek için yukarıdan bir ajan kapsamı seçin."}},"uk":{"stringUnit":{"state":"translated","value":"Виберіть вище область дії агента, щоб додати довірені команди."}},"id":{"stringUnit":{"state":"translated","value":"Pilih cakupan agen di atas untuk menambahkan perintah tepercaya."}},"pl":{"stringUnit":{"state":"translated","value":"Wybierz powyżej zakres agenta, aby dodać zaufane polecenia."}},"th":{"stringUnit":{"state":"translated","value":"เลือกขอบเขตเอเจนต์ด้านบนเพื่อเพิ่มคำสั่งที่เชื่อถือได้."}},"vi":{"stringUnit":{"state":"translated","value":"Chọn phạm vi tác nhân ở trên để thêm các lệnh đáng tin cậy."}},"nl":{"stringUnit":{"state":"translated","value":"Selecteer hierboven een agentbereik om vertrouwde opdrachten toe te voegen."}},"fa":{"stringUnit":{"state":"translated","value":"برای افزودن فرمان‌های مورد اعتماد، یک محدودهٔ عامل در بالا انتخاب کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Выберите выше область действия агента, чтобы добавить доверенные команды."}},"sv":{"stringUnit":{"state":"translated","value":"Välj ett agentomfång ovan för att lägga till betrodda kommandon."}}}},
