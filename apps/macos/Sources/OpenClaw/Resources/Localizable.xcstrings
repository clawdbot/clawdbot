    "Open Config Folder": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open Config Folder"}},"zh-CN":{"stringUnit":{"state":"translated","value":"打开配置文件夹"}},"zh-TW":{"stringUnit":{"state":"translated","value":"開啟設定資料夾"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Abrir Pasta de Configuração"}},"de":{"stringUnit":{"state":"translated","value":"Konfigurationsordner öffnen"}},"es":{"stringUnit":{"state":"translated","value":"Abrir carpeta de configuración"}},"ja-JP":{"stringUnit":{"state":"translated","value":"設定フォルダを開く"}},"ko":{"stringUnit":{"state":"translated","value":"설정 폴더 열기"}},"fr":{"stringUnit":{"state":"translated","value":"Ouvrir le dossier de configuration"}},"hi":{"stringUnit":{"state":"translated","value":"कॉन्फ़िगरेशन फ़ोल्डर खोलें"}},"ar":{"stringUnit":{"state":"translated","value":"فتح مجلد التكوين"}},"it":{"stringUnit":{"state":"translated","value":"Apri cartella di configurazione"}},"tr":{"stringUnit":{"state":"translated","value":"Yapılandırma Klasörünü Aç"}},"uk":{"stringUnit":{"state":"translated","value":"Відкрити папку конфігурації"}},"id":{"stringUnit":{"state":"translated","value":"Buka Folder Konfigurasi"}},"pl":{"stringUnit":{"state":"translated","value":"Otwórz folder konfiguracji"}},"th":{"stringUnit":{"state":"translated","value":"เปิดโฟลเดอร์การกำหนดค่า"}},"vi":{"stringUnit":{"state":"translated","value":"Mở thư mục cấu hình"}},"nl":{"stringUnit":{"state":"translated","value":"Configuratiemap openen"}},"fa":{"stringUnit":{"state":"translated","value":"باز کردن پوشهٔ پیکربندی"}},"ru":{"stringUnit":{"state":"translated","value":"Открыть папку конфигурации"}},"sv":{"stringUnit":{"state":"translated","value":"Öppna konfigurationsmapp"}}}},
    "Open Connection or use Debug → Reset Remote Tunnel, then try again.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open Connection or use Debug → Reset Remote Tunnel, then try again."}},"zh-CN":{"stringUnit":{"state":"translated","value":"打开“连接”或使用“调试 → 重置远程隧道”，然后重试。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"開啟「連線」，或使用「偵錯」→「重設遠端通道」，然後再試一次。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Abra Conexão ou use Depuração → Redefinir túnel remoto e tente novamente."}},"de":{"stringUnit":{"state":"translated","value":"Öffnen Sie „Verbindung“ oder wählen Sie „Debug → Remote-Tunnel zurücksetzen“ und versuchen Sie es dann erneut."}},"es":{"stringUnit":{"state":"translated","value":"Abre Conexión o usa Depuración → Restablecer túnel remoto y vuelve a intentarlo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"接続を開くか、デバッグ → リモートトンネルをリセットを実行してから、もう一度お試しください。"}},"ko":{"stringUnit":{"state":"translated","value":"연결을 열거나 디버그 → 원격 터널 재설정을 사용한 후 다시 시도하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Ouvrez Connexion ou utilisez Débogage → Réinitialiser le tunnel distant, puis réessayez."}},"hi":{"stringUnit":{"state":"translated","value":"कनेक्शन खोलें या डीबग → रिमोट टनल रीसेट करें का उपयोग करें, फिर दोबारा कोशिश करें।"}},"ar":{"stringUnit":{"state":"translated","value":"افتح نافذة الاتصال أو استخدم تصحيح الأخطاء → إعادة تعيين النفق البعيد، ثم حاول مرة أخرى."}},"it":{"stringUnit":{"state":"translated","value":"Apri Connessione oppure usa Debug → Reimposta tunnel remoto, quindi riprova."}},"tr":{"stringUnit":{"state":"translated","value":"Bağlantı'yı açın veya Hata Ayıklama → Uzak Tüneli Sıfırla seçeneğini kullanın, ardından tekrar deneyin."}},"uk":{"stringUnit":{"state":"translated","value":"Відкрийте «Підключення» або скористайтеся пунктом «Налагодження» → «Скинути віддалений тунель», а потім спробуйте ще раз."}},"id":{"stringUnit":{"state":"translated","value":"Buka Koneksi atau gunakan Debug → Atur Ulang Tunnel Jarak Jauh, lalu coba lagi."}},"pl":{"stringUnit":{"state":"translated","value":"Otwórz okno Połączenie lub wybierz Debugowanie → Resetuj tunel zdalny, a następnie spróbuj ponownie."}},"th":{"stringUnit":{"state":"translated","value":"เปิดการเชื่อมต่อ หรือใช้แก้จุดบกพร่อง → รีเซ็ตทันเนลระยะไกล แล้วลองอีกครั้ง"}},"vi":{"stringUnit":{"state":"translated","value":"Mở Kết nối hoặc dùng Gỡ lỗi → Đặt lại đường hầm từ xa, rồi thử lại."}},"nl":{"stringUnit":{"state":"translated","value":"Open Verbinding of gebruik Debug → Externe tunnel resetten en probeer het opnieuw."}},"fa":{"stringUnit":{"state":"translated","value":"پنجرهٔ اتصال را باز کنید یا از اشکال‌زدایی → بازنشانی تونل راه دور استفاده کنید، سپس دوباره تلاش کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Откройте «Подключение» или выберите «Отладка» → «Сбросить удалённый туннель», затем повторите попытку."}},"sv":{"stringUnit":{"state":"translated","value":"Öppna Anslutning eller använd Felsökning → Återställ fjärrtunnel och försök sedan igen."}}}},
    "Open Connection settings to fix it.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open Connection settings to fix it."}},"zh-CN":{"stringUnit":{"state":"translated","value":"打开连接设置以修复此问题。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"開啟連線設定以修正此問題。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Abra as configurações de Conexão para corrigir o problema."}},"de":{"stringUnit":{"state":"translated","value":"Öffnen Sie die Verbindungseinstellungen, um das Problem zu beheben."}},"es":{"stringUnit":{"state":"translated","value":"Abre los ajustes de conexión para solucionarlo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"接続設定を開いて修正してください。"}},"ko":{"stringUnit":{"state":"translated","value":"연결 설정을 열어 문제를 해결하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Ouvrez les réglages de connexion pour résoudre le problème."}},"hi":{"stringUnit":{"state":"translated","value":"इसे ठीक करने के लिए कनेक्शन सेटिंग्स खोलें."}},"ar":{"stringUnit":{"state":"translated","value":"افتح إعدادات الاتصال لإصلاح المشكلة."}},"it":{"stringUnit":{"state":"translated","value":"Apri le impostazioni di connessione per risolvere il problema."}},"tr":{"stringUnit":{"state":"translated","value":"Düzeltmek için Bağlantı ayarlarını açın."}},"uk":{"stringUnit":{"state":"translated","value":"Відкрийте налаштування підключення, щоб виправити це."}},"id":{"stringUnit":{"state":"translated","value":"Buka pengaturan Koneksi untuk memperbaikinya."}},"pl":{"stringUnit":{"state":"translated","value":"Otwórz ustawienia połączenia, aby rozwiązać problem."}},"th":{"stringUnit":{"state":"translated","value":"เปิดการตั้งค่าการเชื่อมต่อเพื่อแก้ไขปัญหา."}},"vi":{"stringUnit":{"state":"translated","value":"Mở cài đặt kết nối để khắc phục."}},"nl":{"stringUnit":{"state":"translated","value":"Open de verbindingsinstellingen om dit op te lossen."}},"fa":{"stringUnit":{"state":"translated","value":"برای رفع مشکل، تنظیمات اتصال را باز کنید."}},"ru":{"stringUnit":{