    "App settings": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"App settings"}},"zh-CN":{"stringUnit":{"state":"translated","value":"应用设置"}},"zh-TW":{"stringUnit":{"state":"translated","value":"應用程式設定"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Configurações do aplicativo"}},"de":{"stringUnit":{"state":"translated","value":"App-Einstellungen"}},"es":{"stringUnit":{"state":"translated","value":"Configuración de la aplicación"}},"ja-JP":{"stringUnit":{"state":"translated","value":"アプリ設定"}},"ko":{"stringUnit":{"state":"translated","value":"앱 설정"}},"fr":{"stringUnit":{"state":"translated","value":"Paramètres de l’application"}},"hi":{"stringUnit":{"state":"translated","value":"ऐप सेटिंग्स"}},"ar":{"stringUnit":{"state":"translated","value":"إعدادات التطبيق"}},"it":{"stringUnit":{"state":"translated","value":"Impostazioni dell’app"}},"tr":{"stringUnit":{"state":"translated","value":"Uygulama ayarları"}},"uk":{"stringUnit":{"state":"translated","value":"Налаштування застосунку"}},"id":{"stringUnit":{"state":"translated","value":"Pengaturan aplikasi"}},"pl":{"stringUnit":{"state":"translated","value":"Ustawienia aplikacji"}},"th":{"stringUnit":{"state":"translated","value":"การตั้งค่าแอป"}},"vi":{"stringUnit":{"state":"translated","value":"Cài đặt ứng dụng"}},"nl":{"stringUnit":{"state":"translated","value":"App-instellingen"}},"fa":{"stringUnit":{"state":"translated","value":"تنظیمات برنامه"}},"ru":{"stringUnit":{"state":"translated","value":"Настройки приложения"}},"sv":{"stringUnit":{"state":"translated","value":"Appinställningar"}}}},
    "App updates are unavailable while a profile is active.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"App updates are unavailable while a profile is active."}},"zh-CN":{"stringUnit":{"state":"translated","value":"配置文件处于启用状态时，无法更新应用。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"設定檔啟用期間無法更新應用程式。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"As atualizações do app ficam indisponíveis enquanto um perfil está ativo."}},"de":{"stringUnit":{"state":"translated","value":"App-Updates sind nicht verfügbar, solange ein Profil aktiv ist."}},"es":{"stringUnit":{"state":"translated","value":"Las actualizaciones de la aplicación no están disponibles mientras haya un perfil activo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"プロファイルが有効な間はアプリを更新できません。"}},"ko":{"stringUnit":{"state":"translated","value":"프로필이 활성화된 동안에는 앱을 업데이트할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les mises à jour de l’application ne sont pas disponibles lorsqu’un profil est actif."}},"hi":{"stringUnit":{"state":"translated","value":"प्रोफ़ाइल सक्रिय होने पर ऐप अपडेट उपलब्ध नहीं होते हैं."}},"ar":{"stringUnit":{"state":"translated","value":"تحديثات التطبيق غير متاحة أثناء تنشيط ملف تعريف."}},"it":{"stringUnit":{"state":"translated","value":"Gli aggiornamenti dell'app non sono disponibili mentre un profilo è attivo."}},"tr":{"stringUnit":{"state":"translated","value":"Bir profil etkinken uygulama güncellemeleri kullanılamaz."}},"uk":{"stringUnit":{"state":"translated","value":"Оновлення застосунку недоступні, поки профіль активний."}},"id":{"stringUnit":{"state":"translated","value":"Pembaruan aplikasi tidak tersedia saat profil aktif."}},"pl":{"stringUnit":{"state":"translated","value":"Aktualizacje aplikacji są niedostępne, gdy profil jest aktywny."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถอัปเดตแอปได้ขณะใช้งานโปรไฟล์อยู่."}},"vi":{"stringUnit":{"state":"translated","value":"Không thể cập nhật ứng dụng khi một hồ sơ đang hoạt động."}},"nl":{"stringUnit":{"state":"translated","value":"App-updates zijn niet beschikbaar zolang er een profiel actief is."}},"fa":{"stringUnit":{"state":"translated","value":"تا زمانی که یک نمایه فعال است، به‌روزرسانی‌های برنامه در دسترس نیستند."}},"ru":{"stringUnit":{"state":"translated","value":"Обновления приложения недоступны, пока активен профиль."}},"sv":{"stringUnit":{"state":"translated","value":"Appuppdateringar är inte tillgängliga medan en profil är aktiv."}}}},
