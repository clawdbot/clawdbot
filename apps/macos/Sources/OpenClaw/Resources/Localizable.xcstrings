    "Usage did not finish loading. Close and reopen this menu to retry.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Usage did not finish loading. Close and reopen this menu to retry."}},"zh-CN":{"stringUnit":{"state":"translated","value":"用量未能完成加载。 请关闭并重新打开此菜单以重试。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"用量未能完成載入。 請關閉並重新開啟此選單以重試。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O uso não terminou de carregar. Feche e reabra este menu para tentar novamente."}},"de":{"stringUnit":{"state":"translated","value":"Die Nutzungsdaten wurden nicht vollständig geladen. Schließen Sie dieses Menü und öffnen Sie es erneut, um es noch einmal zu versuchen."}},"es":{"stringUnit":{"state":"translated","value":"Los datos de uso no terminaron de cargarse. Cierra y vuelve a abrir este menú para reintentarlo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"使用状況の読み込みが完了しませんでした。 このメニューを閉じて開き直すと再試行できます。"}},"ko":{"stringUnit":{"state":"translated","value":"사용량을 모두 불러오지 못했습니다. 이 메뉴를 닫았다가 다시 열어 재시도하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Le chargement des données d’utilisation n’a pas abouti. Fermez et rouvrez ce menu pour réessayer."}},"hi":{"stringUnit":{"state":"translated","value":"उपयोग की जानकारी पूरी तरह लोड नहीं हुई। फिर से कोशिश करने के लिए इस मेनू को बंद करके दोबारा खोलें।"}},"ar":{"stringUnit":{"state":"translated","value":"لم يكتمل تحميل بيانات الاستخدام. أغلق هذه القائمة وأعد فتحها للمحاولة مجددًا."}},"it":{"stringUnit":{"state":"translated","value":"Il caricamento dei dati di utilizzo non è stato completato. Chiudi e riapri questo menu per riprovare."}},"tr":{"stringUnit":{"state":"translated","value":"Kullanım bilgileri yüklenemedi. Yeniden denemek için bu menüyü kapatıp açın."}},"uk":{"stringUnit":{"state":"translated","value":"Завантаження даних про використання не завершено. Закрийте та знову відкрийте це меню, щоб повторити спробу."}},"id":{"stringUnit":{"state":"translated","value":"Data penggunaan belum selesai dimuat. Tutup dan buka kembali menu ini untuk mencoba lagi."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się w pełni załadować danych użycia. Zamknij i ponownie otwórz to menu, aby spróbować ponownie."}},"th":{"stringUnit":{"state":"translated","value":"โหลดข้อมูลการใช้งานไม่สำเร็จ ปิดแล้วเปิดเมนูนี้อีกครั้งเพื่อลองใหม่"}},"vi":{"stringUnit":{"state":"translated","value":"Chưa tải xong dữ liệu sử dụng. Đóng và mở lại menu này để thử lại."}},"nl":{"stringUnit":{"state":"translated","value":"De gebruiksgegevens zijn niet volledig geladen. Sluit dit menu en open het opnieuw om het nogmaals te proberen."}},"fa":{"stringUnit":{"state":"translated","value":"بارگذاری میزان مصرف کامل نشد. برای تلاش دوباره، این منو را ببندید و دوباره باز کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Данные об использовании не загрузились полностью. Закройте и снова откройте это меню, чтобы повторить попытку."}},"sv":{"stringUnit":{"state":"translated","value":"Användningsinformationen kunde inte laddas klart. Stäng och öppna den här menyn igen för att försöka på nytt."}}}},
    "Usage unavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Usage unavailable"}},"zh-CN":{"stringUnit":{"state":"translated","value":"用量不可用"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法取得用量"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Uso indisponível"}},"de":{"stringUnit":{"state":"translated","value":"Nutzungsdaten nicht verfügbar"}},"es":{"stringUnit":{"state":"translated","value":"Datos de uso no disponibles"}},"ja-JP":{"stringUnit":{"state":"translated","value":"使用状況を取得できません"}},"ko":{"stringUnit":{"state":"translated","value":"사용량을 확인할 수 없음"}},"fr":{"stringUnit":{"state":"translated","value":"Données d’utilisation indisponibles"}},"hi":{"stringUnit":{"state":"translated","value":"उपयोग की जानकारी उपलब्ध नहीं है"}},"ar":{"stringUnit":{"state":"translated","value":"بيانات الاستخدام غير متاحة"}},"it":{"stringUnit":{"state":"translated","value":"Dati di utilizzo non disponibili"}},"tr":{"stringUnit":{"state":"translated","value":"Kullanım bilgileri kullanılamıyor"}},"uk":{"stringUnit":{"state":"translated","value":"Дані про використання недоступні"}},"id":{"stringUnit":{"state":"translated","value":"Data penggunaan tidak tersedia"}},"pl":{"stringUnit":{"state":"translated","value":"Dane użycia niedostępne"}},"th":{"stringUnit":{"state":"translated","value":"ไม่มีข้อมูลการใช้งาน"}},"vi":{"stringUnit":{"state":"translated","value":"Không có dữ liệu sử dụng"}},"nl":{"stringUnit":{"state":"translated","value":"Gebruiksgegevens niet beschikbaar"}},"fa":{"stringUnit":{"state":"translated","value":"میزان مصرف در دسترس نیست"}},"ru":{"stringUnit":{"state":"translated","value":"Данные об использовании недоступны"}},"sv":{"stringUnit":{"state":"translated","value":"Användningsinformation är inte tillgänglig"}}}},
    "Use Apple Speech; passive Voice Wake stays on-device": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use Apple Speech; passive Voice Wake stays on-device"}},"zh-CN":{"stringUnit":{"state":"translated","value":"使用 Apple Speech; 被动语音唤醒始终在设备端处理"}},"zh-TW":{"stringUnit":{"state":"translated","value":"使用 Apple Speech; 被動語音喚醒仍在裝置端執行"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Usar Apple Speech; a ativação passiva por voz permanece no dispositivo"}},"de":{"stringUnit":{"state":"translated","value":"Apple Speech verwenden; die passive Sprachaktivierung bleibt auf dem Gerät"}},"es":{"stringUnit":{"state":"translated","value":"Usar Apple Speech; la activación pasiva por voz permanece en el dispositivo"}},"ja-JP":{"stringUnit":{"state":"translated","value":"Apple Speech を使用; 音声ウェイクの待機処理はデバイス上で実行されます"}},"ko":{"stringUnit":{"state":"translated","value":"Apple Speech 사용; 상시 음성 깨우기는 기기 내에서 처리됩니다"}},"fr":{"stringUnit":{"state":"translated","value":"Utiliser Apple Speech ; l’activation vocale passive reste sur l’appareil"}},"hi":{"stringUnit":{"state":"translated","value":"Apple Speech का उपयोग करें; निष्क्रिय Voice Wake डिवाइस पर ही रहता है"}},"ar":{"stringUnit":{"state":"translated","value":"استخدم Apple Speech; تبقى معالجة التنشيط الصوتي في وضع الاستماع السلبي على الجهاز"}},"it":{"stringUnit":{"state":"translated","value":"Usa Apple Speech; l’attivazione vocale passiva rimane sul dispositivo"}},"tr":{"stringUnit":{"state":"translated","value":"Apple Speech kullanın; pasif sesle uyandırma cihaz üzerinde kalır"}},"uk":{"stringUnit":{"state":"translated","value":"Використовувати Apple Speech; пасивна голосова активація залишається на пристрої"}},"id":{"stringUnit":{"state":"translated","value":"Gunakan Apple Speech; aktivasi suara pasif tetap diproses di perangkat"}},"pl":{"stringUnit":{"state":"translated","value":"Używaj Apple Speech; pasywne wybudzanie głosowe działa lokalnie na urządzeniu"}},"th":{"stringUnit":{"state":"translated","value":"ใช้ Apple Speech; การรอรับคำปลุกด้วยเสียงจะยังประมวลผลบนอุปกรณ์"}},"vi":{"stringUnit":{"state":"translated","value":"Sử dụng Apple Speech; tính năng đánh thức bằng giọng nói thụ động vẫn được xử lý trên thiết bị"}},"nl":{"stringUnit":{"state":"translated","value":"Gebruik Apple Speech; passieve spraakactivering blijft op het apparaat"}},"fa":{"stringUnit":{"state":"translated","value":"از Apple Speech استفاده کنید; فعال‌سازی صوتی غیرفعال روی دستگاه باقی می‌ماند"}},"ru":{"stringUnit":{"state":"translated","value":"Использовать Apple Speech; пассивная голосовая активация обрабатывается только на устройстве"}},"sv":{"stringUnit":{"state":"translated","value":"Använd Apple Speech; passiv röstaktivering sker lokalt på enheten"}}}},
    "Use Config for account, guild, action, and policy details.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use Config for account, guild, action, and policy details."}},"zh-CN":{"stringUnit":{"state":"translated","value":"使用配置查看账户、服务器、操作和策略详情。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"使用設定檢視帳號、伺服器、動作和政策的詳細資訊。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Use Configurações para ver detalhes de conta, servidor, ação e política."}},"de":{"stringUnit":{"state":"translated","value":"Verwenden Sie Config für Details zu Konto, Server, Aktionen und Richtlinien."}},"es":{"stringUnit":{"state":"translated","value":"Usa Config para consultar los detalles de la cuenta, el servidor, las acciones y las políticas."}},"ja-JP":{"stringUnit":{"state":"translated","value":"アカウント、ギルド、アクション、ポリシーの詳細は構成設定で指定してください。"}},"ko":{"stringUnit":{"state":"translated","value":"계정, 길드, 작업 및 정책의 세부 사항은 구성에서 설정하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Utilisez la configuration pour les détails du compte, de la guilde, des actions et des règles."}},"hi":{"stringUnit":{"state":"translated","value":"खाते, गिल्ड, कार्रवाई और नीति के विवरण के लिए कॉन्फ़िगरेशन का उपयोग करें।"}},"ar":{"stringUnit":{"state":"translated","value":"استخدم الإعدادات للاطلاع على تفاصيل الحساب والخادم والإجراءات والسياسات."}},"it":{"stringUnit":{"state":"translated","value":"Usa la configurazione per i dettagli su account, server, azioni e criteri."}},"tr":{"stringUnit":{"state":"translated","value":"Hesap, sunucu, eylem ve ilke ayrıntıları için yapılandırmayı kullanın."}},"uk":{"stringUnit":{"state":"translated","value":"Використовуйте Config для налаштування облікового запису, сервера, дій і політик."}},"id":{"stringUnit":{"state":"translated","value":"Gunakan Konfigurasi untuk detail akun, guild, tindakan, dan kebijakan."}},"pl":{"stringUnit":{"state":"translated","value":"Użyj konfiguracji, aby określić szczegóły konta, serwera, działań i zasad."}},"th":{"stringUnit":{"state":"translated","value":"ใช้การกำหนดค่าสำหรับรายละเอียดบัญชี กิลด์ การดำเนินการ และนโยบาย"}},"vi":{"stringUnit":{"state":"translated","value":"Sử dụng Cấu hình để xem chi tiết về tài khoản, máy chủ, hành động và chính sách."}},"nl":{"stringUnit":{"state":"translated","value":"Gebruik Config voor details over accounts, guilds, acties en beleid."}},"fa":{"stringUnit":{"state":"translated","value":"برای جزئیات حساب، گیلد، اقدام و خط‌مشی از پیکربندی استفاده کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Используйте конфигурацию для настройки учётной записи, сервера, действий и политик."}},"sv":{"stringUnit":{"state":"translated","value":"Använd Config för information om konto, guild, åtgärder och policyer."}}}},
    "Use Tailscale Serve so the gateway has a valid HTTPS certificate.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use Tailscale Serve so the gateway has a valid HTTPS certificate."}},"zh-CN":{"stringUnit":{"state":"translated","value":"使用 Tailscale Serve 为网关提供有效的 HTTPS 证书。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"使用 Tailscale Serve，讓閘道具備有效的 HTTPS 憑證。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Use Tailscale Serve para que o gateway tenha um certificado HTTPS válido."}},"de":{"stringUnit":{"state":"translated","value":"Verwenden Sie Tailscale Serve, damit der Gateway ein gültiges HTTPS-Zertifikat hat."}},"es":{"stringUnit":{"state":"translated","value":"Usa Tailscale Serve para que el Gateway tenga un certificado HTTPS válido."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gateway に有効な HTTPS 証明書を設定するには、Tailscale Serve を使用してください。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway에 유효한 HTTPS 인증서가 적용되도록 Tailscale Serve를 사용하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Utilisez Tailscale Serve pour que le Gateway dispose d’un certificat HTTPS valide."}},"hi":{"stringUnit":{"state":"translated","value":"Tailscale Serve का उपयोग करें ताकि गेटवे के पास मान्य HTTPS प्रमाणपत्र हो।"}},"ar":{"stringUnit":{"state":"translated","value":"استخدم Tailscale Serve ليكون لدى البوابة شهادة HTTPS صالحة."}},"it":{"stringUnit":{"state":"translated","value":"Usa Tailscale Serve affinché il gateway abbia un certificato HTTPS valido."}},"tr":{"stringUnit":{"state":"translated","value":"Ağ geçidinin geçerli bir HTTPS sertifikasına sahip olması için Tailscale Serve kullanın."}},"uk":{"stringUnit":{"state":"translated","value":"Використовуйте Tailscale Serve, щоб Gateway мав дійсний сертифікат HTTPS."}},"id":{"stringUnit":{"state":"translated","value":"Gunakan Tailscale Serve agar gateway memiliki sertifikat HTTPS yang valid."}},"pl":{"stringUnit":{"state":"translated","value":"Użyj Tailscale Serve, aby Gateway miał ważny certyfikat HTTPS."}},"th":{"stringUnit":{"state":"translated","value":"ใช้ Tailscale Serve เพื่อให้เกตเวย์มีใบรับรอง HTTPS ที่ถูกต้อง"}},"vi":{"stringUnit":{"state":"translated","value":"Sử dụng Tailscale Serve để gateway có chứng chỉ HTTPS hợp lệ."}},"nl":{"stringUnit":{"state":"translated","value":"Gebruik Tailscale Serve zodat de gateway een geldig HTTPS-certificaat heeft."}},"fa":{"stringUnit":{"state":"translated","value":"از Tailscale Serve استفاده کنید تا دروازه گواهی HTTPS معتبر داشته باشد."}},"ru":{"stringUnit":{"state":"translated","value":"Используйте Tailscale Serve, чтобы у шлюза был действительный HTTPS-сертификат."}},"sv":{"stringUnit":{"state":"translated","value":"Använd Tailscale Serve så att gatewayen har ett giltigt HTTPS-certifikat."}}}},
    "Use Tailscale plus an SSH tunnel for stable private access.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use Tailscale plus an SSH tunnel for stable private access."}},"zh-CN":{"stringUnit":{"state":"translated","value":"使用 Tailscale 配合 SSH 隧道，实现稳定的私有访问。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"搭配使用 Tailscale 與 SSH 通道，以取得穩定的私密存取。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Use Tailscale com um túnel SSH para obter acesso privado estável."}},"de":{"stringUnit":{"state":"translated","value":"Verwenden Sie Tailscale zusammen mit einem SSH-Tunnel für einen stabilen privaten Zugriff."}},"es":{"stringUnit":{"state":"translated","value":"Usa Tailscale junto con un túnel SSH para un acceso privado estable."}},"ja-JP":{"stringUnit":{"state":"translated","value":"安定したプライベートアクセスには、Tailscale と SSH トンネルを併用してください。"}},"ko":{"stringUnit":{"state":"translated","value":"안정적인 비공개 접속을 위해 Tailscale과 SSH 터널을 함께 사용하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Utilisez Tailscale avec un tunnel SSH pour un accès privé stable."}},"hi":{"stringUnit":{"state":"translated","value":"स्थिर निजी पहुँच के लिए Tailscale के साथ SSH टनल का उपयोग करें।"}},"ar":{"stringUnit":{"state":"translated","value":"استخدم Tailscale مع نفق SSH للحصول على وصول خاص مستقر."}},"it":{"stringUnit":{"state":"translated","value":"Usa Tailscale con un tunnel SSH per un accesso privato stabile."}},"tr":{"stringUnit":{"state":"translated","value":"Kararlı özel erişim için Tailscale ile birlikte bir SSH tüneli kullanın."}},"uk":{"stringUnit":{"state":"translated","value":"Використовуйте Tailscale разом із тунелем SSH для стабільного приватного доступу."}},"id":{"stringUnit":{"state":"translated","value":"Gunakan Tailscale serta terowongan SSH untuk akses privat yang stabil."}},"pl":{"stringUnit":{"state":"translated","value":"Użyj Tailscale wraz z tunelem SSH, aby uzyskać stabilny dostęp prywatny."}},"th":{"stringUnit":{"state":"translated","value":"ใช้ Tailscale ร่วมกับช่องทาง SSH เพื่อการเข้าถึงแบบส่วนตัวที่เสถียร"}},"vi":{"stringUnit":{"state":"translated","value":"Sử dụng Tailscale cùng với đường hầm SSH để truy cập riêng tư ổn định."}},"nl":{"stringUnit":{"state":"translated","value":"Gebruik Tailscale met een SSH-tunnel voor stabiele privétoegang."}},"fa":{"stringUnit":{"state":"translated","value":"برای دسترسی خصوصی پایدار، از Tailscale به‌همراه تونل SSH استفاده کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Используйте Tailscale вместе с SSH-туннелем для стабильного частного доступа."}},"sv":{"stringUnit":{"state":"translated","value":"Använd Tailscale tillsammans med en SSH-tunnel för stabil privat åtkomst."}}}},
    "Use a packaged OpenClaw build that includes the CUA driver.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use a packaged OpenClaw build that includes the CUA driver."}},"zh-CN":{"stringUnit":{"state":"translated","value":"使用包含 CUA 驱动程序的 OpenClaw 打包版本。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"使用包含 CUA 驅動程式的 OpenClaw 封裝版本。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Use uma versão empacotada do OpenClaw que inclua o driver CUA."}},"de":{"stringUnit":{"state":"translated","value":"Verwenden Sie einen paketierten OpenClaw-Build, der den CUA-Treiber enthält."}},"es":{"stringUnit":{"state":"translated","value":"Usa una compilación empaquetada de OpenClaw que incluya el controlador CUA."}},"ja-JP":{"stringUnit":{"state":"translated","value":"CUA ドライバーを含むパッケージ版の OpenClaw ビルドを使用してください。"}},"ko":{"stringUnit":{"state":"translated","value":"CUA 드라이버가 포함된 패키지형 OpenClaw 빌드를 사용하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Utilisez une version packagée d’OpenClaw incluant le pilote CUA."}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw के ऐसे पैकेज किए गए बिल्ड का उपयोग करें जिसमें CUA ड्राइवर शामिल हो।"}},"ar":{"stringUnit":{"state":"translated","value":"استخدم إصدارًا مُحزّمًا من OpenClaw يتضمن برنامج تشغيل CUA."}},"it":{"stringUnit":{"state":"translated","value":"Usa una build preconfezionata di OpenClaw che includa il driver CUA."}},"tr":{"stringUnit":{"state":"translated","value":"CUA sürücüsünü içeren paketlenmiş bir OpenClaw derlemesi kullanın."}},"uk":{"stringUnit":{"state":"translated","value":"Використовуйте готову збірку OpenClaw, що містить драйвер CUA."}},"id":{"stringUnit":{"state":"translated","value":"Gunakan paket build OpenClaw yang menyertakan driver CUA."}},"pl":{"stringUnit":{"state":"translated","value":"Użyj pakietowej wersji OpenClaw zawierającej sterownik CUA."}},"th":{"stringUnit":{"state":"translated","value":"ใช้ OpenClaw รุ่นแพ็กเกจที่มีไดรเวอร์ CUA รวมอยู่ด้วย"}},"vi":{"stringUnit":{"state":"translated","value":"Sử dụng bản dựng OpenClaw đóng gói có kèm trình điều khiển CUA."}},"nl":{"stringUnit":{"state":"translated","value":"Gebruik een verpakte OpenClaw-build die het CUA-stuurprogramma bevat."}},"fa":{"stringUnit":{"state":"translated","value":"از نسخهٔ بسته‌بندی‌شدهٔ OpenClaw که شامل درایور CUA است استفاده کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Используйте готовую сборку OpenClaw, включающую драйвер CUA."}},"sv":{"stringUnit":{"state":"translated","value":"Använd en paketerad version av OpenClaw som innehåller CUA-drivrutinen."}}}},
    "Use an existing subscription or provider account. OpenClaw opens the provider’s own sign-in flow, then verifies it with a real reply.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use an existing subscription or provider account. OpenClaw opens the provider’s own sign-in flow, then verifies it with a real reply."}},"zh-CN":{"stringUnit":{"state":"translated","value":"使用现有订阅或提供商账户。 OpenClaw 会打开提供商自己的登录流程，然后通过真实回复进行验证。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"使用現有訂閱或供應商帳號。 OpenClaw 會開啟供應商自己的登入流程，然後透過實際回覆進行驗證。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Use uma assinatura ou conta de provedor existente. O OpenClaw abre o fluxo de login do próprio provedor e depois o verifica com uma resposta real."}},"de":{"stringUnit":{"state":"translated","value":"Verwenden Sie ein bestehendes Abonnement oder Anbieterkonto. OpenClaw öffnet den Anmeldeprozess des Anbieters und überprüft die Anmeldung anschließend anhand einer echten Antwort."}},"es":{"stringUnit":{"state":"translated","value":"Usa una suscripción o cuenta de proveedor existente. OpenClaw abre el proceso de inicio de sesión del propio proveedor y luego lo verifica con una respuesta real."}},"ja-JP":{"stringUnit":{"state":"translated","value":"既存のサブスクリプションまたはプロバイダーアカウントを使用してください。 OpenClaw がプロバイダー独自のサインイン手順を開き、実際の応答で確認します。"}},"ko":{"stringUnit":{"state":"translated","value":"기존 구독 또는 제공업체 계정을 사용하세요. OpenClaw가 제공업체의 로그인 절차를 연 다음 실제 응답으로 인증을 확인합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Utilisez un abonnement ou un compte fournisseur existant. OpenClaw ouvre le parcours de connexion du fournisseur, puis vérifie la connexion à l’aide d’une réponse réelle."}},"hi":{"stringUnit":{"state":"translated","value":"मौजूदा सदस्यता या प्रदाता खाते का उपयोग करें। OpenClaw प्रदाता की अपनी साइन-इन प्रक्रिया खोलता है, फिर वास्तविक उत्तर से उसका सत्यापन करता है।"}},"ar":{"stringUnit":{"state":"translated","value":"استخدم اشتراكًا حاليًا أو حسابًا لدى مزوّد. يفتح OpenClaw عملية تسجيل الدخول الخاصة بالمزوّد، ثم يتحقق منها عبر رد فعلي."}},"it":{"stringUnit":{"state":"translated","value":"Usa un abbonamento o un account del fornitore esistente. OpenClaw apre la procedura di accesso del fornitore, quindi la verifica con una risposta reale."}},"tr":{"stringUnit":{"state":"translated","value":"Mevcut bir abonelik veya sağlayıcı hesabı kullanın. OpenClaw, sağlayıcının kendi oturum açma akışını başlatır, ardından gerçek bir yanıtla doğrular."}},"uk":{"stringUnit":{"state":"translated","value":"Використовуйте наявну підписку або обліковий запис постачальника. OpenClaw відкриє процедуру входу самого постачальника, а потім перевірить доступ за допомогою реальної відповіді."}},"id":{"stringUnit":{"state":"translated","value":"Gunakan langganan atau akun penyedia yang sudah ada. OpenClaw membuka alur masuk milik penyedia, lalu memverifikasinya dengan balasan nyata."}},"pl":{"stringUnit":{"state":"translated","value":"Użyj istniejącej subskrypcji lub konta u dostawcy. OpenClaw otworzy proces logowania dostawcy, a następnie zweryfikuje dostęp na podstawie rzeczywistej odpowiedzi."}},"th":{"stringUnit":{"state":"translated","value":"ใช้การสมัครสมาชิกหรือบัญชีผู้ให้บริการที่มีอยู่ OpenClaw จะเปิดขั้นตอนการลงชื่อเข้าใช้ของผู้ให้บริการ แล้วตรวจสอบด้วยการตอบกลับจริง"}},"vi":{"stringUnit":{"state":"translated","value":"Sử dụng gói đăng ký hoặc tài khoản nhà cung cấp hiện có. OpenClaw mở quy trình đăng nhập riêng của nhà cung cấp, sau đó xác minh bằng một phản hồi thực tế."}},"nl":{"stringUnit":{"state":"translated","value":"Gebruik een bestaand abonnement of provideraccount. OpenClaw opent het eigen aanmeldproces van de provider en verifieert dit vervolgens met een echt antwoord."}},"fa":{"stringUnit":{"state":"translated","value":"از اشتراک یا حساب ارائه‌دهندهٔ موجود استفاده کنید. OpenClaw فرایند ورود خود ارائه‌دهنده را باز می‌کند، سپس آن را با یک پاسخ واقعی تأیید می‌کند."}},"ru":{"stringUnit":{"state":"translated","value":"Используйте существующую подписку или учётную запись провайдера. OpenClaw откроет страницу входа самого провайдера, а затем проверит подключение, получив реальный ответ."}},"sv":{"stringUnit":{"state":"translated","value":"Använd en befintlig prenumeration eller ett leverantörskonto. OpenClaw öppnar leverantörens eget inloggningsflöde och verifierar det sedan med ett riktigt svar."}}}},
    "Use file version": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use file version"}},"zh-CN":{"stringUnit":{"state":"translated","value":"使用文件版本"}},"zh-TW":{"stringUnit":{"state":"translated","value":"使用檔案版本"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Usar versão do arquivo"}},"de":{"stringUnit":{"state":"translated","value":"Dateiversion verwenden"}},"es":{"stringUnit":{"state":"translated","value":"Usar versión del archivo"}},"ja-JP":{"stringUnit":{"state":"translated","value":"ファイルのバージョンを使用"}},"ko":{"stringUnit":{"state":"translated","value":"파일 버전 사용"}},"fr":{"stringUnit":{"state":"translated","value":"Utiliser la version du fichier"}},"hi":{"stringUnit":{"state":"translated","value":"फ़ाइल संस्करण का उपयोग करें"}},"ar":{"stringUnit":{"state":"translated","value":"استخدام نسخة الملف"}},"it":{"stringUnit":{"state":"translated","value":"Usa la versione del file"}},"tr":{"stringUnit":{"state":"translated","value":"Dosya sürümünü kullan"}},"uk":{"stringUnit":{"state":"translated","value":"Використовувати версію з файлу"}},"id":{"stringUnit":{"state":"translated","value":"Gunakan versi file"}},"pl":{"stringUnit":{"state":"translated","value":"Użyj wersji z pliku"}},"th":{"stringUnit":{"state":"translated","value":"ใช้เวอร์ชันของไฟล์"}},"vi":{"stringUnit":{"state":"translated","value":"Sử dụng phiên bản trong tệp"}},"nl":{"stringUnit":{"state":"translated","value":"Bestandsversie gebruiken"}},"fa":{"stringUnit":{"state":"translated","value":"استفاده از نسخهٔ فایل"}},"ru":{"stringUnit":{"state":"translated","value":"Использовать версию из файла"}},"sv":{"stringUnit":{"state":"translated","value":"Använd filversion"}}}},
    "Use realtime Gateway relay": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use realtime Gateway relay"}},"zh-CN":{"stringUnit":{"state":"translated","value":"使用实时 Gateway 中继"}},"zh-TW":{"stringUnit":{"state":"translated","value":"使用即時 Gateway 中繼"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Usar retransmissão do Gateway em tempo real"}},"de":{"stringUnit":{"state":"translated","value":"Echtzeit-Weiterleitung über den Gateway verwenden"}},"es":{"stringUnit":{"state":"translated","value":"Usar retransmisión del Gateway en tiempo real"}},"ja-JP":{"stringUnit":{"state":"translated","value":"リアルタイム Gateway リレーを使用"}},"ko":{"stringUnit":{"state":"translated","value":"실시간 Gateway 릴레이 사용"}},"fr":{"stringUnit":{"state":"translated","value":"Utiliser le relais Gateway en temps réel"}},"hi":{"stringUnit":{"state":"translated","value":"रीयलटाइम Gateway रिले का उपयोग करें"}},"ar":{"stringUnit":{"state":"translated","value":"استخدام ترحيل Gateway في الوقت الفعلي"}},"it":{"stringUnit":{"state":"translated","value":"Usa l’inoltro in tempo reale del Gateway"}},"tr":{"stringUnit":{"state":"translated","value":"Gerçek zamanlı Gateway aktarımını kullan"}},"uk":{"stringUnit":{"state":"translated","value":"Використовувати ретрансляцію Gateway у реальному часі"}},"id":{"stringUnit":{"state":"translated","value":"Gunakan relai Gateway waktu nyata"}},"pl":{"stringUnit":{"state":"translated","value":"Użyj przekazywania przez Gateway w czasie rzeczywistym"}},"th":{"stringUnit":{"state":"translated","value":"ใช้การส่งต่อผ่าน Gateway แบบเรียลไทม์"}},"vi":{"stringUnit":{"state":"translated","value":"Sử dụng chuyển tiếp qua Gateway theo thời gian thực"}},"nl":{"stringUnit":{"state":"translated","value":"Realtime Gateway-relay gebruiken"}},"fa":{"stringUnit":{"state":"translated","value":"استفاده از رلهٔ بلادرنگ Gateway"}},"ru":{"stringUnit":{"state":"translated","value":"Использовать ретрансляцию через Gateway в реальном времени"}},"sv":{"stringUnit":{"state":"translated","value":"Använd realtidsrelä via Gateway"}}}},
    "Use the Gateway's configured realtime voice session on this Mac. Requires realtime, gateway-relay, and agent-consult in Talk settings.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use the Gateway's configured realtime voice session on this Mac. Requires realtime, gateway-relay, and agent-consult in Talk settings."}},"zh-CN":{"stringUnit":{"state":"translated","value":"在这台 Mac 上使用 Gateway 配置的实时语音会话。需要在 Talk 设置中配置 realtime、gateway-relay 和 agent-consult。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"在這部 Mac 上使用 Gateway 已設定的即時語音工作階段。需要在 Talk 設定中啟用 realtime、gateway-relay 和 agent-consult。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Use a sessão de voz em tempo real configurada no Gateway neste Mac. Requer realtime, gateway-relay e agent-consult nas configurações do Talk."}},"de":{"stringUnit":{"state":"translated","value":"Die im Gateway konfigurierte Echtzeit-Sprachsitzung auf diesem Mac verwenden. Erfordert realtime, gateway-relay und agent-consult in den Talk-Einstellungen."}},"es":{"stringUnit":{"state":"translated","value":"Usa en este Mac la sesión de voz en tiempo real configurada en el Gateway. Requiere realtime, gateway-relay y agent-consult en los ajustes de Talk."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このMacでGatewayに設定されたリアルタイム音声セッションを使用します。 Talk設定でrealtime、gateway-relay、agent-consultが必要です。"}},"ko":{"stringUnit":{"state":"translated","value":"이 Mac에서 Gateway에 구성된 실시간 음성 세션을 사용합니다. Talk 설정에 realtime, gateway-relay, agent-consult가 필요합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Utilisez la session vocale en temps réel configurée sur le Gateway sur ce Mac. Nécessite realtime, gateway-relay et agent-consult dans les paramètres de Talk."}},"hi":{"stringUnit":{"state":"translated","value":"इस Mac पर Gateway के कॉन्फ़िगर किए गए रीयलटाइम वॉइस सत्र का उपयोग करें. Talk सेटिंग्स में realtime, gateway-relay, और agent-consult आवश्यक हैं."}},"ar":{"stringUnit":{"state":"translated","value":"استخدم جلسة الصوت في الوقت الفعلي المُهيّأة في Gateway على جهاز Mac هذا. يتطلب ذلك realtime وgateway-relay وagent-consult في إعدادات التحدث."}},"it":{"stringUnit":{"state":"translated","value":"Usa su questo Mac la sessione vocale in tempo reale configurata nel Gateway. Richiede realtime, gateway-relay e agent-consult nelle impostazioni di Talk."}},"tr":{"stringUnit":{"state":"translated","value":"Bu Mac'te Gateway'in yapılandırılmış gerçek zamanlı ses oturumunu kullanın. Talk ayarlarında realtime, gateway-relay ve agent-consult gerektirir."}},"uk":{"stringUnit":{"state":"translated","value":"Використовувати налаштований у Gateway голосовий сеанс у реальному часі на цьому Mac. Потрібні realtime, gateway-relay та agent-consult у налаштуваннях Talk."}},"id":{"stringUnit":{"state":"translated","value":"Gunakan sesi suara realtime yang dikonfigurasi di Gateway pada Mac ini. Memerlukan realtime, gateway-relay, dan agent-consult di pengaturan Talk."}},"pl":{"stringUnit":{"state":"translated","value":"Używaj na tym Macu sesji głosowej w czasie rzeczywistym skonfigurowanej w Gateway. Wymaga realtime, gateway-relay i agent-consult w ustawieniach Talk."}},"th":{"stringUnit":{"state":"translated","value":"ใช้เซสชันเสียงแบบเรียลไทม์ที่กำหนดค่าไว้ใน Gateway บน Mac เครื่องนี้ ต้องมี realtime, gateway-relay และ agent-consult ในการตั้งค่า Talk."}},"vi":{"stringUnit":{"state":"translated","value":"Sử dụng phiên thoại thời gian thực đã cấu hình của Gateway trên máy Mac này. Yêu cầu realtime, gateway-relay và agent-consult trong phần cài đặt Talk."}},"nl":{"stringUnit":{"state":"translated","value":"Gebruik de geconfigureerde realtime spraaksessie van de Gateway op deze Mac. Vereist realtime, gateway-relay en agent-consult in de Talk-instellingen."}},"fa":{"stringUnit":{"state":"translated","value":"از نشست صوتی بلادرنگ پیکربندی‌شدهٔ Gateway در این Mac استفاده کنید. به realtime، gateway-relay و agent-consult در تنظیمات Talk نیاز دارد."}},"ru":{"stringUnit":{"state":"translated","value":"Использовать настроенный в Gateway голосовой сеанс в реальном времени на этом Mac. Требуются realtime, gateway-relay и agent-consult в настройках Talk."}},"sv":{"stringUnit":{"state":"translated","value":"Använd den realtidsröstsession som konfigurerats för Gateway på denna Mac. Kräver realtime, gateway-relay och agent-consult i inställningarna för Talk."}}}},
    "Use the panel + Canvas": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use the panel + Canvas"}},"zh-CN":{"stringUnit":{"state":"translated","value":"使用面板 + Canvas"}},"zh-TW":{"stringUnit":{"state":"translated","value":"使用面板 + Canvas"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Usar o painel + Canvas"}},"de":{"stringUnit":{"state":"translated","value":"Das Panel + Canvas verwenden"}},"es":{"stringUnit":{"state":"translated","value":"Usar el panel + Canvas"}},"ja-JP":{"stringUnit":{"state":"translated","value":"パネル + Canvasを使用"}},"ko":{"stringUnit":{"state":"translated","value":"패널 + Canvas 사용"}},"fr":{"stringUnit":{"state":"translated","value":"Utiliser le panneau + Canvas"}},"hi":{"stringUnit":{"state":"translated","value":"पैनल + Canvas का उपयोग करें"}},"ar":{"stringUnit":{"state":"translated","value":"استخدم اللوحة + Canvas"}},"it":{"stringUnit":{"state":"translated","value":"Usa il pannello + Canvas"}},"tr":{"stringUnit":{"state":"translated","value":"Paneli + Canvas'ı kullanın"}},"uk":{"stringUnit":{"state":"translated","value":"Використовувати панель + Canvas"}},"id":{"stringUnit":{"state":"translated","value":"Gunakan panel + Canvas"}},"pl":{"stringUnit":{"state":"translated","value":"Używaj panelu + Canvas"}},"th":{"stringUnit":{"state":"translated","value":"ใช้แผง + Canvas"}},"vi":{"stringUnit":{"state":"translated","value":"Sử dụng bảng điều khiển + Canvas"}},"nl":{"stringUnit":{"state":"translated","value":"Gebruik het paneel + Canvas"}},"fa":{"stringUnit":{"state":"translated","value":"از پنل + Canvas استفاده کنید"}},"ru":{"stringUnit":{"state":"translated","value":"Использовать панель + Canvas"}},"sv":{"stringUnit":{"state":"translated","value":"Använd panelen + Canvas"}}}},
    "Use this if macOS prompts were skipped or permissions need a fresh walkthrough.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use this if macOS prompts were skipped or permissions need a fresh walkthrough."}},"zh-CN":{"stringUnit":{"state":"translated","value":"如果跳过了 macOS 提示，或需要重新引导设置权限，请使用此选项。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"如果先前略過了 macOS 提示，或需要重新進行權限設定導引，請使用此選項。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Use esta opção se as solicitações do macOS foram ignoradas ou se for necessário rever o passo a passo das permissões."}},"de":{"stringUnit":{"state":"translated","value":"Diese Option verwenden, wenn macOS-Abfragen übersprungen wurden oder Berechtigungen erneut Schritt für Schritt eingerichtet werden müssen."}},"es":{"stringUnit":{"state":"translated","value":"Usa esta opción si se omitieron los avisos de macOS o si necesitas volver a revisar los permisos paso a paso."}},"ja-JP":{"stringUnit":{"state":"translated","value":"macOSのプロンプトをスキップした場合や、権限の設定手順をやり直す必要がある場合に使用します。"}},"ko":{"stringUnit":{"state":"translated","value":"macOS 권한 요청을 건너뛰었거나 권한 안내를 다시 받아야 하는 경우 사용하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Utilisez cette option si les invites macOS ont été ignorées ou si vous devez reprendre la configuration des autorisations."}},"hi":{"stringUnit":{"state":"translated","value":"यदि macOS के प्रॉम्प्ट छोड़ दिए गए थे या अनुमतियों के लिए फिर से चरण-दर-चरण मार्गदर्शन चाहिए, तो इसका उपयोग करें."}},"ar":{"stringUnit":{"state":"translated","value":"استخدم هذا الخيار إذا تم تخطي مطالبات macOS أو إذا كنت بحاجة إلى مراجعة خطوات منح الأذونات من جديد."}},"it":{"stringUnit":{"state":"translated","value":"Usa questa opzione se hai saltato le richieste di macOS o se devi ripetere la procedura guidata per le autorizzazioni."}},"tr":{"stringUnit":{"state":"translated","value":"macOS istemleri atlandıysa veya izinlerin yeniden adım adım ayarlanması gerekiyorsa bunu kullanın."}},"uk":{"stringUnit":{"state":"translated","value":"Скористайтеся цим, якщо запити macOS було пропущено або потрібно повторно пройти налаштування дозволів."}},"id":{"stringUnit":{"state":"translated","value":"Gunakan ini jika permintaan izin macOS dilewati atau panduan perizinan perlu diulang."}},"pl":{"stringUnit":{"state":"translated","value":"Użyj tej opcji, jeśli pominięto monity macOS lub trzeba ponownie przejść przez konfigurację uprawnień."}},"th":{"stringUnit":{"state":"translated","value":"ใช้ตัวเลือกนี้หากข้ามข้อความแจ้งของ macOS ไป หรือต้องการทำตามขั้นตอนการให้สิทธิ์ใหม่."}},"vi":{"stringUnit":{"state":"translated","value":"Sử dụng tùy chọn này nếu đã bỏ qua các lời nhắc của macOS hoặc cần hướng dẫn lại quy trình cấp quyền."}},"nl":{"stringUnit":{"state":"translated","value":"Gebruik dit als macOS-meldingen zijn overgeslagen of als de machtigingen opnieuw moeten worden doorlopen."}},"fa":{"stringUnit":{"state":"translated","value":"اگر از اعلان‌های macOS رد شده‌اید یا مجوزها به راهنمای گام‌به‌گام تازه‌ای نیاز دارند، از این گزینه استفاده کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Используйте этот вариант, если запросы macOS были пропущены или нужно заново пройти настройку разрешений."}},"sv":{"stringUnit":{"state":"translated","value":"Använd detta om macOS-dialogrutor hoppades över eller om behörigheterna behöver gås igenom på nytt."}}}},
    "Use wss:// for public hosts. ws:// is allowed for localhost, LAN, .local, and Tailnet hosts.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use wss:// for public hosts. ws:// is allowed for localhost, LAN, .local, and Tailnet hosts."}},"zh-CN":{"stringUnit":{"state":"translated","value":"公共主机请使用 wss://。localhost、局域网、.local 和 Tailnet 主机允许使用 ws://。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"公開主機請使用 wss://。localhost、LAN、.local 和 Tailnet 主機可使用 ws://。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Use wss:// para hosts públicos. ws:// é permitido para hosts localhost, LAN, .local e Tailnet."}},"de":{"stringUnit":{"state":"translated","value":"Für öffentliche Hosts wss:// verwenden. ws:// ist für localhost-, LAN-, .local- und Tailnet-Hosts zulässig."}},"es":{"stringUnit":{"state":"translated","value":"Usa wss:// para hosts públicos. ws:// está permitido para hosts de localhost, LAN, .local y Tailnet."}},"ja-JP":{"stringUnit":{"state":"translated","value":"公開ホストにはwss://を使用してください. ws://はlocalhost、LAN、.local、Tailnetのホストで使用できます."}},"ko":{"stringUnit":{"state":"translated","value":"공개 호스트에는 wss://를 사용하세요. localhost, LAN, .local 및 Tailnet 호스트에는 ws://가 허용됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Utilisez wss:// pour les hôtes publics. ws:// est autorisé pour les hôtes localhost, LAN, .local et Tailnet."}},"hi":{"stringUnit":{"state":"translated","value":"सार्वजनिक होस्ट के लिए wss:// का उपयोग करें. localhost, LAN, .local, और Tailnet होस्ट के लिए ws:// की अनुमति है."}},"ar":{"stringUnit":{"state":"translated","value":"استخدم wss:// للمضيفين العموميين. يُسمح باستخدام ws:// مع مضيفي localhost وLAN و.local وTailnet."}},"it":{"stringUnit":{"state":"translated","value":"Usa wss:// per gli host pubblici. ws:// è consentito per localhost e per gli host LAN, .local e Tailnet."}},"tr":{"stringUnit":{"state":"translated","value":"Genel erişime açık ana bilgisayarlar için wss:// kullanın. localhost, LAN, .local ve Tailnet ana bilgisayarları için ws:// kullanımına izin verilir."}},"uk":{"stringUnit":{"state":"translated","value":"Використовуйте wss:// для публічних хостів. ws:// дозволено для localhost, LAN, .local та хостів Tailnet."}},"id":{"stringUnit":{"state":"translated","value":"Gunakan wss:// untuk host publik. ws:// diizinkan untuk localhost, LAN, .local, dan host Tailnet."}},"pl":{"stringUnit":{"state":"translated","value":"Używaj wss:// dla hostów publicznych. ws:// jest dozwolone dla localhost oraz hostów w sieci LAN, domenie .local i sieci Tailnet."}},"th":{"stringUnit":{"state":"translated","value":"ใช้ wss:// สำหรับโฮสต์สาธารณะ อนุญาตให้ใช้ ws:// สำหรับ localhost, LAN, .local และโฮสต์ Tailnet."}},"vi":{"stringUnit":{"state":"translated","value":"Sử dụng wss:// cho máy chủ công khai. ws:// được phép dùng cho localhost, LAN, .local và các máy chủ Tailnet."}},"nl":{"stringUnit":{"state":"translated","value":"Gebruik wss:// voor openbare hosts. ws:// is toegestaan voor localhost, LAN, .local en Tailnet-hosts."}},"fa":{"stringUnit":{"state":"translated","value":"برای میزبان‌های عمومی از wss:// استفاده کنید. استفاده از ws:// برای localhost، شبکهٔ LAN، .local و میزبان‌های Tailnet مجاز است."}},"ru":{"stringUnit":{"state":"translated","value":"Используйте wss:// для публичных хостов. ws:// допускается для localhost, LAN, .local и хостов Tailnet."}},"sv":{"stringUnit":{"state":"translated","value":"Använd wss:// för offentliga värdar. ws:// tillåts för localhost, LAN, .local och Tailnet-värdar."}}}},
    "Use your browser logins": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use your browser logins"}},"zh-CN":{"stringUnit":{"state":"translated","value":"使用你的浏览器登录信息"}},"zh-TW":{"stringUnit":{"state":"translated","value":"使用您的瀏覽器登入資訊"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Usar seus logins do navegador"}},"de":{"stringUnit":{"state":"translated","value":"Ihre Browser-Anmeldungen verwenden"}},"es":{"stringUnit":{"state":"translated","value":"Usar tus sesiones del navegador"}},"ja-JP":{"stringUnit":{"state":"translated","value":"ブラウザのログイン情報を使用"}},"ko":{"stringUnit":{"state":"translated","value":"브라우저 로그인 정보 사용"}},"fr":{"stringUnit":{"state":"translated","value":"Utiliser vos connexions de navigateur"}},"hi":{"stringUnit":{"state":"translated","value":"अपने ब्राउज़र लॉगिन का उपयोग करें"}},"ar":{"stringUnit":{"state":"translated","value":"استخدم جلسات تسجيل الدخول في متصفحك"}},"it":{"stringUnit":{"state":"translated","value":"Usa gli accessi del browser"}},"tr":{"stringUnit":{"state":"translated","value":"Tarayıcınızdaki oturumları kullanın"}},"uk":{"stringUnit":{"state":"translated","value":"Використовувати ваші входи в браузері"}},"id":{"stringUnit":{"state":"translated","value":"Gunakan login browser Anda"}},"pl":{"stringUnit":{"state":"translated","value":"Korzystaj z logowań w przeglądarce"}},"th":{"stringUnit":{"state":"translated","value":"ใช้ข้อมูลการเข้าสู่ระบบในเบราว์เซอร์ของคุณ"}},"vi":{"stringUnit":{"state":"translated","value":"Sử dụng thông tin đăng nhập trên trình duyệt của bạn"}},"nl":{"stringUnit":{"state":"translated","value":"Gebruik je browseraanmeldingen"}},"fa":{"stringUnit":{"state":"translated","value":"از ورودهای مرورگر خود استفاده کنید"}},"ru":{"stringUnit":{"state":"translated","value":"Использовать ваши авторизации в браузере"}},"sv":{"stringUnit":{"state":"translated","value":"Använd dina webbläsarinloggningar"}}}},
    "Used by the CLI session loader; stored in ~/.openclaw/openclaw.json.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Used by the CLI session loader; stored in ~/.openclaw/openclaw.json."}},"zh-CN":{"stringUnit":{"state":"translated","value":"由 CLI 会话加载器使用；存储在 ~/.openclaw/openclaw.json 中。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"供 CLI 工作階段載入器使用；儲存於 ~/.openclaw/openclaw.json。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Usado pelo carregador de sessões da CLI; armazenado em ~/.openclaw/openclaw.json."}},"de":{"stringUnit":{"state":"translated","value":"Wird vom CLI-Sitzungslader verwendet; gespeichert in ~/.openclaw/openclaw.json."}},"es":{"stringUnit":{"state":"translated","value":"Lo utiliza el cargador de sesiones de la CLI; se guarda en ~/.openclaw/openclaw.json."}},"ja-JP":{"stringUnit":{"state":"translated","value":"CLIセッションローダーで使用されます; ~/.openclaw/openclaw.jsonに保存されます."}},"ko":{"stringUnit":{"state":"translated","value":"CLI 세션 로더에서 사용하며, ~/.openclaw/openclaw.json에 저장됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Utilisé par le chargeur de sessions CLI ; stocké dans ~/.openclaw/openclaw.json."}},"hi":{"stringUnit":{"state":"translated","value":"CLI सत्र लोडर द्वारा उपयोग किया जाता है; ~/.openclaw/openclaw.json में संग्रहीत है."}},"ar":{"stringUnit":{"state":"translated","value":"يستخدمه مُحمّل جلسات CLI؛ ويُخزَّن في ~/.openclaw/openclaw.json."}},"it":{"stringUnit":{"state":"translated","value":"Usato dal caricatore di sessioni CLI; memorizzato in ~/.openclaw/openclaw.json."}},"tr":{"stringUnit":{"state":"translated","value":"CLI oturum yükleyicisi tarafından kullanılır; ~/.openclaw/openclaw.json içinde saklanır."}},"uk":{"stringUnit":{"state":"translated","value":"Використовується завантажувачем сеансів CLI; зберігається в ~/.openclaw/openclaw.json."}},"id":{"stringUnit":{"state":"translated","value":"Digunakan oleh pemuat sesi CLI; disimpan di ~/.openclaw/openclaw.json."}},"pl":{"stringUnit":{"state":"translated","value":"Używane przez moduł wczytywania sesji CLI; przechowywane w ~/.openclaw/openclaw.json."}},"th":{"stringUnit":{"state":"translated","value":"ใช้โดยตัวโหลดเซสชัน CLI; จัดเก็บไว้ใน ~/.openclaw/openclaw.json."}},"vi":{"stringUnit":{"state":"translated","value":"Được trình tải phiên CLI sử dụng; được lưu trong ~/.openclaw/openclaw.json."}},"nl":{"stringUnit":{"state":"translated","value":"Wordt gebruikt door de CLI-sessielader; opgeslagen in ~/.openclaw/openclaw.json."}},"fa":{"stringUnit":{"state":"translated","value":"توسط بارگذار نشست CLI استفاده می‌شود؛ در ~/.openclaw/openclaw.json ذخیره می‌شود."}},"ru":{"stringUnit":{"state":"translated","value":"Используется загрузчиком сеансов CLI; хранится в ~/.openclaw/openclaw.json."}},"sv":{"stringUnit":{"state":"translated","value":"Används av CLI-sessionsinläsaren; lagras i ~/.openclaw/openclaw.json."}}}},
    "Used for pnpm/node fallback and PATH population when launching the gateway.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Used for pnpm/node fallback and PATH population when launching the gateway."}},"zh-CN":{"stringUnit":{"state":"translated","value":"启动 Gateway 时，用于 pnpm/node 回退和 PATH 填充。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"用於啟動 gateway 時的 pnpm/node 備援，以及填入 PATH。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Usado como alternativa para pnpm/node e para preencher o PATH ao iniciar o gateway."}},"de":{"stringUnit":{"state":"translated","value":"Wird beim Starten des Gateways als Fallback für pnpm/node und zum Befüllen von PATH verwendet."}},"es":{"stringUnit":{"state":"translated","value":"Se usa como alternativa para pnpm/node y para completar PATH al iniciar el gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayの起動時にpnpm/nodeのフォールバックとPATHの設定に使用されます."}},"ko":{"stringUnit":{"state":"translated","value":"게이트웨이를 시작할 때 pnpm/node 폴백 및 PATH 설정에 사용됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Utilisé pour le recours à pnpm/node et le renseignement de PATH lors du lancement de la passerelle."}},"hi":{"stringUnit":{"state":"translated","value":"गेटवे लॉन्च करते समय pnpm/node फ़ॉलबैक और PATH भरने के लिए उपयोग किया जाता है."}},"ar":{"stringUnit":{"state":"translated","value":"يُستخدم كخيار احتياطي لـ pnpm/node ولتعبئة PATH عند تشغيل البوابة."}},"it":{"stringUnit":{"state":"translated","value":"Usato come fallback per pnpm/node e per popolare PATH all'avvio del gateway."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway başlatılırken pnpm/node yedek mekanizması ve PATH değişkeninin doldurulması için kullanılır."}},"uk":{"stringUnit":{"state":"translated","value":"Використовується для резервного пошуку pnpm/node та заповнення PATH під час запуску шлюзу."}},"id":{"stringUnit":{"state":"translated","value":"Digunakan untuk mekanisme cadangan pnpm/node dan pengisian PATH saat meluncurkan gateway."}},"pl":{"stringUnit":{"state":"translated","value":"Używane jako rozwiązanie rezerwowe dla pnpm/node oraz do uzupełniania PATH podczas uruchamiania bramy."}},"th":{"stringUnit":{"state":"translated","value":"ใช้เป็นตัวสำรองสำหรับ pnpm/node และเติมค่า PATH เมื่อเริ่มต้น gateway."}},"vi":{"stringUnit":{"state":"translated","value":"Được sử dụng làm phương án dự phòng cho pnpm/node và để bổ sung PATH khi khởi chạy gateway."}},"nl":{"stringUnit":{"state":"translated","value":"Wordt gebruikt als terugvaloptie voor pnpm/node en om PATH in te vullen bij het starten van de gateway."}},"fa":{"stringUnit":{"state":"translated","value":"هنگام راه‌اندازی Gateway، برای مسیر جایگزین pnpm/node و مقداردهی PATH استفاده می‌شود."}},"ru":{"stringUnit":{"state":"translated","value":"Используется для резервного поиска pnpm/node и заполнения PATH при запуске шлюза."}},"sv":{"stringUnit":{"state":"translated","value":"Används för reservlösningen för pnpm/node och för att fylla i PATH när gateway startas."}}}},
    "Used when the companion UI cannot display an approval prompt.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Used when the companion UI cannot display an approval prompt."}},"zh-CN":{"stringUnit":{"state":"translated","value":"在配套界面无法显示审批提示时使用。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"在配套 UI 無法顯示核准提示時使用。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Usado quando a interface complementar não consegue exibir uma solicitação de aprovação."}},"de":{"stringUnit":{"state":"translated","value":"Wird verwendet, wenn die Begleitoberfläche keine Genehmigungsabfrage anzeigen kann."}},"es":{"stringUnit":{"state":"translated","value":"Se usa cuando la interfaz complementaria no puede mostrar una solicitud de aprobación."}},"ja-JP":{"stringUnit":{"state":"translated","value":"コンパニオンUIで承認プロンプトを表示できない場合に使用されます。"}},"ko":{"stringUnit":{"state":"translated","value":"컴패니언 UI에서 승인 요청을 표시할 수 없을 때 사용됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Utilisé lorsque l’interface compagnon ne peut pas afficher une demande d’approbation."}},"hi":{"stringUnit":{"state":"translated","value":"जब सहयोगी UI अनुमोदन प्रॉम्प्ट नहीं दिखा सकता, तब उपयोग किया जाता है."}},"ar":{"stringUnit":{"state":"translated","value":"يُستخدم عندما يتعذر على واجهة المستخدم المرافقة عرض مطالبة بالموافقة."}},"it":{"stringUnit":{"state":"translated","value":"Usato quando l'interfaccia complementare non può mostrare una richiesta di approvazione."}},"tr":{"stringUnit":{"state":"translated","value":"Yardımcı arayüz bir onay istemi gösteremediğinde kullanılır."}},"uk":{"stringUnit":{"state":"translated","value":"Використовується, коли інтерфейс супутнього застосунку не може показати запит на схвалення."}},"id":{"stringUnit":{"state":"translated","value":"Digunakan saat UI pendamping tidak dapat menampilkan permintaan persetujuan."}},"pl":{"stringUnit":{"state":"translated","value":"Używane, gdy interfejs aplikacji towarzyszącej nie może wyświetlić monitu o zatwierdzenie."}},"th":{"stringUnit":{"state":"translated","value":"ใช้เมื่อ UI ของแอปคู่หูไม่สามารถแสดงข้อความขออนุมัติได้."}},"vi":{"stringUnit":{"state":"translated","value":"Được sử dụng khi giao diện đồng hành không thể hiển thị lời nhắc phê duyệt."}},"nl":{"stringUnit":{"state":"translated","value":"Wordt gebruikt wanneer de bijbehorende UI geen goedkeuringsverzoek kan weergeven."}},"fa":{"stringUnit":{"state":"translated","value":"زمانی استفاده می‌شود که رابط کاربری همراه نتواند درخواست تأیید را نمایش دهد."}},"ru":{"stringUnit":{"state":"translated","value":"Используется, когда интерфейс приложения-компаньона не может отобразить запрос на подтверждение."}},"sv":{"stringUnit":{"state":"translated","value":"Används när följeappens gränssnitt inte kan visa en begäran om godkännande."}}}},
    "Used when the remote gateway requires token auth.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Used when the remote gateway requires token auth."}},"zh-CN":{"stringUnit":{"state":"translated","value":"当远程 Gateway 需要令牌认证时使用。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"當遠端 Gateway 需要權杖驗證時使用。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Usado quando o gateway remoto exige autenticação por token."}},"de":{"stringUnit":{"state":"translated","value":"Wird verwendet, wenn das Remote-Gateway Token-Authentifizierung erfordert."}},"es":{"stringUnit":{"state":"translated","value":"Se usa cuando el gateway remoto requiere autenticación con token."}},"ja-JP":{"stringUnit":{"state":"translated","value":"リモート Gateway がトークン認証を必要とする場合に使用されます。"}},"ko":{"stringUnit":{"state":"translated","value":"원격 게이트웨이에 토큰 인증이 필요할 때 사용됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Utilisé lorsque la Gateway distante nécessite une authentification par jeton."}},"hi":{"stringUnit":{"state":"translated","value":"जब रिमोट Gateway को टोकन प्रमाणीकरण की आवश्यकता हो, तब उपयोग किया जाता है।"}},"ar":{"stringUnit":{"state":"translated","value":"يُستخدم عندما تتطلب البوابة البعيدة المصادقة باستخدام رمز مميز."}},"it":{"stringUnit":{"state":"translated","value":"Usato quando il gateway remoto richiede l'autenticazione tramite token."}},"tr":{"stringUnit":{"state":"translated","value":"Uzak Gateway token kimlik doğrulaması gerektirdiğinde kullanılır."}},"uk":{"stringUnit":{"state":"translated","value":"Використовується, коли віддалений Gateway вимагає автентифікацію за токеном."}},"id":{"stringUnit":{"state":"translated","value":"Digunakan saat gateway jarak jauh memerlukan autentikasi token."}},"pl":{"stringUnit":{"state":"translated","value":"Używane, gdy zdalny Gateway wymaga uwierzytelniania tokenem."}},"th":{"stringUnit":{"state":"translated","value":"ใช้เมื่อ Gateway ระยะไกลต้องมีการยืนยันตัวตนด้วยโทเค็น"}},"vi":{"stringUnit":{"state":"translated","value":"Được sử dụng khi gateway từ xa yêu cầu xác thực bằng token."}},"nl":{"stringUnit":{"state":"translated","value":"Wordt gebruikt wanneer de externe gateway tokenauthenticatie vereist."}},"fa":{"stringUnit":{"state":"translated","value":"زمانی استفاده می‌شود که Gateway راه دور به احراز هویت با توکن نیاز دارد."}},"ru":{"stringUnit":{"state":"translated","value":"Используется, когда удаленному Gateway требуется аутентификация по токену."}},"sv":{"stringUnit":{"state":"translated","value":"Används när fjärrgateway kräver tokenautentisering."}}}},
    "User": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"User"}},"zh-CN":{"stringUnit":{"state":"translated","value":"用户"}},"zh-TW":{"stringUnit":{"state":"translated","value":"使用者"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Usuário"}},"de":{"stringUnit":{"state":"translated","value":"Benutzer"}},"es":{"stringUnit":{"state":"translated","value":"Usuario"}},"ja-JP":{"stringUnit":{"state":"translated","value":"ユーザー"}},"ko":{"stringUnit":{"state":"translated","value":"사용자"}},"fr":{"stringUnit":{"state":"translated","value":"Utilisateur"}},"hi":{"stringUnit":{"state":"translated","value":"उपयोगकर्ता"}},"ar":{"stringUnit":{"state":"translated","value":"المستخدم"}},"it":{"stringUnit":{"state":"translated","value":"Utente"}},"tr":{"stringUnit":{"state":"translated","value":"Kullanıcı"}},"uk":{"stringUnit":{"state":"translated","value":"Користувач"}},"id":{"stringUnit":{"state":"translated","value":"Pengguna"}},"pl":{"stringUnit":{"state":"translated","value":"Użytkownik"}},"th":{"stringUnit":{"state":"translated","value":"ผู้ใช้"}},"vi":{"stringUnit":{"state":"translated","value":"Người dùng"}},"nl":{"stringUnit":{"state":"translated","value":"Gebruiker"}},"fa":{"stringUnit":{"state":"translated","value":"کاربر"}},"ru":{"stringUnit":{"state":"translated","value":"Пользователь"}},"sv":{"stringUnit":{"state":"translated","value":"Användare"}}}},
    "User and host for the remote Gateway machine.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"User and host for the remote Gateway machine."}},"zh-CN":{"stringUnit":{"state":"translated","value":"远程 Gateway 机器的用户和主机。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"遠端 Gateway 機器的使用者與主機。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Usuário e host da máquina remota do Gateway."}},"de":{"stringUnit":{"state":"translated","value":"Benutzer und Host des entfernten Gateway-Rechners."}},"es":{"stringUnit":{"state":"translated","value":"Usuario y host del equipo remoto del Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"リモートGatewayマシンのユーザーとホスト。"}},"ko":{"stringUnit":{"state":"translated","value":"원격 Gateway 머신의 사용자 및 호스트입니다."}},"fr":{"stringUnit":{"state":"translated","value":"Utilisateur et hôte de la machine du Gateway distant."}},"hi":{"stringUnit":{"state":"translated","value":"रिमोट Gateway मशीन के लिए उपयोगकर्ता और होस्ट."}},"ar":{"stringUnit":{"state":"translated","value":"المستخدم والمضيف لجهاز Gateway البعيد."}},"it":{"stringUnit":{"state":"translated","value":"Utente e host del computer Gateway remoto."}},"tr":{"stringUnit":{"state":"translated","value":"Uzak Gateway makinesi için kullanıcı ve ana bilgisayar."}},"uk":{"stringUnit":{"state":"translated","value":"Користувач і хост віддаленого комп’ютера з Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Pengguna dan host untuk mesin Gateway jarak jauh."}},"pl":{"stringUnit":{"state":"translated","value":"Użytkownik i host zdalnego komputera z Gateway."}},"th":{"stringUnit":{"state":"translated","value":"ผู้ใช้และโฮสต์สำหรับเครื่อง Gateway ระยะไกล."}},"vi":{"stringUnit":{"state":"translated","value":"Người dùng và máy chủ cho máy Gateway từ xa."}},"nl":{"stringUnit":{"state":"translated","value":"Gebruiker en host voor de externe Gateway-machine."}},"fa":{"stringUnit":{"state":"translated","value":"کاربر و میزبان دستگاه Gateway راه دور."}},"ru":{"stringUnit":{"state":"translated","value":"Пользователь и хост удалённого компьютера с Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Användare och värd för fjärrdatorn med Gateway."}}}},
    "Uses the Voice Wake path: forwards over SSH when configured,\notherwise runs locally via rpc.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Uses the Voice Wake path: forwards over SSH when configured,\notherwise runs locally via rpc."}},"zh-CN":{"stringUnit":{"state":"translated","value":"使用语音唤醒路径：如果已配置，则通过 SSH 转发，\n否则通过 rpc 在本地运行。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"使用 Voice Wake 路徑：若已設定，則透過 SSH 轉送，\n否則透過 rpc 在本機執行。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Usa o fluxo do Voice Wake: encaminha por SSH quando configurado,\ncaso contrário, executa localmente via rpc."}},"de":{"stringUnit":{"state":"translated","value":"Nutzt den Voice Wake-Pfad: leitet bei entsprechender Konfiguration über SSH weiter,\nwird andernfalls lokal über rpc ausgeführt."}},"es":{"stringUnit":{"state":"translated","value":"Usa la ruta de Voice Wake: reenvía por SSH cuando está configurado,\nde lo contrario, se ejecuta localmente mediante rpc."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Voice Wakeの経路を使用: 設定されている場合はSSH経由で転送し、\nそれ以外の場合はrpc経由でローカル実行します。"}},"ko":{"stringUnit":{"state":"translated","value":"Voice Wake 경로를 사용합니다: SSH가 구성되어 있으면 SSH를 통해 전달하고,\n그렇지 않으면 rpc를 통해 로컬에서 실행합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Utilise le mécanisme Voice Wake : transmet via SSH si celui-ci est configuré,\nsinon s’exécute localement via rpc."}},"hi":{"stringUnit":{"state":"translated","value":"Voice Wake पथ का उपयोग करता है: कॉन्फ़िगर होने पर SSH के ज़रिए अग्रेषित करता है,\nअन्यथा rpc के ज़रिए स्थानीय रूप से चलता है."}},"ar":{"stringUnit":{"state":"translated","value":"يستخدم مسار التنشيط الصوتي: يُعيد التوجيه عبر SSH عند تهيئته،\nوإلا فيعمل محلياً عبر rpc."}},"it":{"stringUnit":{"state":"translated","value":"Usa il percorso di Voice Wake: inoltra tramite SSH se configurato,\naltrimenti viene eseguito localmente tramite rpc."}},"tr":{"stringUnit":{"state":"translated","value":"Voice Wake yolunu kullanır: yapılandırılmışsa SSH üzerinden iletir,\naksi takdirde rpc aracılığıyla yerel olarak çalışır."}},"uk":{"stringUnit":{"state":"translated","value":"Використовує механізм Voice Wake: пересилає через SSH, якщо його налаштовано,\nінакше виконується локально через rpc."}},"id":{"stringUnit":{"state":"translated","value":"Menggunakan jalur Voice Wake: meneruskan melalui SSH jika dikonfigurasi,\njika tidak, berjalan secara lokal melalui rpc."}},"pl":{"stringUnit":{"state":"translated","value":"Korzysta ze ścieżki Voice Wake: przekazuje przez SSH, jeśli jest skonfigurowane,\nw przeciwnym razie działa lokalnie przez rpc."}},"th":{"stringUnit":{"state":"translated","value":"ใช้เส้นทาง Voice Wake: ส่งต่อผ่าน SSH เมื่อกำหนดค่าไว้,\nมิฉะนั้นจะทำงานในเครื่องผ่าน rpc."}},"vi":{"stringUnit":{"state":"translated","value":"Sử dụng luồng Voice Wake: chuyển tiếp qua SSH khi được cấu hình,\nnếu không thì chạy cục bộ qua rpc."}},"nl":{"stringUnit":{"state":"translated","value":"Gebruikt het Voice Wake-pad: stuurt door via SSH indien geconfigureerd,\nwordt anders lokaal uitgevoerd via rpc."}},"fa":{"stringUnit":{"state":"translated","value":"از مسیر Voice Wake استفاده می‌کند: در صورت پیکربندی، از طریق SSH ارسال می‌کند،\nدر غیر این صورت به‌صورت محلی از طریق rpc اجرا می‌شود."}},"ru":{"stringUnit":{"state":"translated","value":"Использует механизм Voice Wake: пересылает по SSH, если он настроен,\nиначе выполняется локально через rpc."}},"sv":{"stringUnit":{"state":"translated","value":"Använder Voice Wake-vägen: vidarebefordrar via SSH när det är konfigurerat,\nkör annars lokalt via rpc."}}}},
