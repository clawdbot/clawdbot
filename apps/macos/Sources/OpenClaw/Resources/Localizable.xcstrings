    "Try another search or refresh the catalog.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Try another search or refresh the catalog."}},"zh-CN":{"stringUnit":{"state":"translated","value":"请尝试其他搜索词或刷新目录。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"請嘗試其他搜尋條件或重新整理目錄。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Tente outra pesquisa ou atualize o catálogo."}},"de":{"stringUnit":{"state":"translated","value":"Versuchen Sie eine andere Suche oder aktualisieren Sie den Katalog."}},"es":{"stringUnit":{"state":"translated","value":"Prueba con otra búsqueda o actualiza el catálogo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"別のキーワードで検索するか、カタログを更新してください。"}},"ko":{"stringUnit":{"state":"translated","value":"다른 검색어를 사용하거나 카탈로그를 새로 고치세요."}},"fr":{"stringUnit":{"state":"translated","value":"Essayez une autre recherche ou actualisez le catalogue."}},"hi":{"stringUnit":{"state":"translated","value":"कोई अन्य खोज आज़माएँ या कैटलॉग को रीफ़्रेश करें।"}},"ar":{"stringUnit":{"state":"translated","value":"جرّب بحثًا آخر أو حدّث الكتالوج."}},"it":{"stringUnit":{"state":"translated","value":"Prova un'altra ricerca o aggiorna il catalogo."}},"tr":{"stringUnit":{"state":"translated","value":"Başka bir arama yapmayı veya kataloğu yenilemeyi deneyin."}},"uk":{"stringUnit":{"state":"translated","value":"Спробуйте інший пошуковий запит або оновіть каталог."}},"id":{"stringUnit":{"state":"translated","value":"Coba pencarian lain atau segarkan katalog."}},"pl":{"stringUnit":{"state":"translated","value":"Spróbuj wyszukać coś innego lub odśwież katalog."}},"th":{"stringUnit":{"state":"translated","value":"ลองค้นหาอย่างอื่นหรือรีเฟรชแค็ตตาล็อก"}},"vi":{"stringUnit":{"state":"translated","value":"Hãy thử tìm kiếm khác hoặc làm mới danh mục."}},"nl":{"stringUnit":{"state":"translated","value":"Probeer een andere zoekopdracht of vernieuw de catalogus."}},"fa":{"stringUnit":{"state":"translated","value":"جست‌وجوی دیگری را امتحان کنید یا کاتا