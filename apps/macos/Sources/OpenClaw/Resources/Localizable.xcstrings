    "Continue a recent conversation": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Continue a recent conversation"}},"zh-CN":{"stringUnit":{"state":"translated","value":"继续最近的对话"}},"zh-TW":{"stringUnit":{"state":"translated","value":"繼續最近的對話"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Continuar uma conversa recente"}},"de":{"stringUnit":{"state":"translated","value":"Eine kürzlich geführte Unterhaltung fortsetzen"}},"es":{"stringUnit":{"state":"translated","value":"Continuar una conversación reciente"}},"ja-JP":{"stringUnit":{"state":"translated","value":"最近の会話を続ける"}},"ko":{"stringUnit":{"state":"translated","value":"최근 대화 이어가기"}},"fr":{"stringUnit":{"state":"translated","value":"Reprendre une conversation récente"}},"hi":{"stringUnit":{"state":"translated","value":"हाल की बातचीत जारी रखें"}},"ar":{"stringUnit":{"state":"translated","value":"متابعة محادثة حديثة"}},"it":{"stringUnit":{"state":"translated","value":"Continua una conversazione recente"}},"tr":{"stringUnit":{"state":"translated","value":"Son konuşmalardan birine devam et"}},"uk":{"stringUnit":{"state":"translated","value":"Продовжити нещодавню розмову"}},"id":{"stringUnit":{"state":"translated","value":"Lanjutkan percakapan terbaru"}},"pl":{"stringUnit":{"state":"translated","value":"Kontynuuj ostatnią rozmowę"}},"th":{"stringUnit":{"state":"translated","value":"สนทนาล่าสุดต่อ"}},"vi":{"stringUnit":{"state":"translated","value":"Tiếp tục cuộc trò chuyện gần đây"}},"nl":{"stringUnit":{"state":"translated","value":"Een recent gesprek voortzetten"}},"fa":{"stringUnit":{"state":"translated","value":"ادامهٔ یک گفتگوی اخیر"}},"ru":{"stringUnit":{"state":"translated","value":"Продолжить недавний разговор"}},"sv":{"stringUnit":{"state":"translated","value":"Fortsätt en tidigare konversation"}}}},
    "Controls the macOS app log verbosity.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Controls the macOS app log verbosity."}},"zh-CN":{"stringUnit":{"state":"translated","value":"控制 macOS 应用日志的详细程度。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"控制 macOS 應用程式日誌的詳細程度。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Controla o nível de detalhamento dos logs do app para macOS."}},"de":{"stringUnit":{"state":"translated","value":"Legt den Detailgrad der Protokollierung der macOS-App fest."}},"es":{"stringUnit":{"state":"translated","value":"Controla el nivel de detalle de los registros de la aplicación de macOS."}},"ja-JP":{"stringUnit":{"state":"translated","value":"macOSアプリのログの詳細度を設定します。"}},"ko":{"stringUnit":{"state":"translated","value":"macOS 앱 로그의 상세 수준을 설정합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Définit le niveau de détail des journaux de l’application macOS."}},"hi":{"stringUnit":{"state":"translated","value":"macOS ऐप के लॉग में विवरण का स्तर नियंत्रित करता है."}},"ar":{"stringUnit":{"state":"translated","value":"يتحكم في مستوى تفصيل سجل تطبيق macOS."}},"it":{"stringUnit":{"state":"translated","value":"Regola il livello di dettaglio dei log dell'app macOS."}},"tr":{"stringUnit":{"state":"translated","value":"macOS uygulamasının günlük ayrıntı düzeyini denetler."}},"uk":{"stringUnit":{"state":"translated","value":"Визначає рівень деталізації журналу програми для macOS."}},"id":{"stringUnit":{"state":"translated","value":"Mengatur tingkat detail log aplikasi macOS."}},"pl":{"stringUnit":{"state":"translated","value":"Określa poziom szczegółowości dzienników aplikacji macOS."}},"th":{"stringUnit":{"state":"translated","value":"ควบคุมระดับความละเอียดของบันทึกแอป macOS."}},"vi":{"stringUnit":{"state":"translated","value":"Kiểm soát mức độ chi tiết của nhật ký ứng dụng macOS."}},"nl":{"stringUnit":{"state":"translated","value":"Bepaalt het detailniveau van de logboeken van de macOS-app."}},"fa":{"stringUnit":{"state":"translated","value":"سطح جزئیات گزارش‌های برنامهٔ macOS را کنترل می‌کند."}},"ru":{"stringUnit":{"state":"translated","value":"Определяет уровень детализации журналов приложения macOS."}},"sv":{"stringUnit":{"state":"translated","value":"Styr detaljnivån i macOS-appens logg."}}}},
    "Cookie sync is enabled. Browser cookies will be sent to the remote browser profile “%@”. These cookies can grant access to your signed-in accounts.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cookie sync is enabled. Browser cookies will be sent to the remote browser profile “%@”. These cookies can grant access to your signed-in accounts."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Cookie 同步已启用。浏览器 Cookie 将发送到远程浏览器配置文件“%@”。这些 Cookie 可能授予对你已登录账户的访问权限。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已啟用 Cookie 同步。瀏覽器 Cookie 將傳送至遠端瀏覽器設定檔「%@」。這些 Cookie 可讓人存取您已登入的帳號。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A sincronização de cookies está ativada. Os cookies do navegador serão enviados ao perfil de navegador remoto “%@”. Esses cookies podem conceder acesso às contas em que você está conectado."}},"de":{"stringUnit":{"state":"translated","value":"Die Cookie-Synchronisierung ist aktiviert. Browser-Cookies werden an das entfernte Browserprofil „%@“ gesendet. Diese Cookies können Zugriff auf die Konten gewähren, bei denen Sie angemeldet sind."}},"es":{"stringUnit":{"state":"translated","value":"La sincronización de cookies está activada. Las cookies del navegador se enviarán al perfil de navegador remoto «%@». Estas cookies pueden dar acceso a las cuentas en las que has iniciado sesión."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Cookie同期が有効です。ブラウザCookieはリモートブラウザプロファイル「%@」に送信されます。これらのCookieにより、ログイン済みのアカウントにアクセスできるようになる可能性があります。"}},"ko":{"stringUnit":{"state":"translated","value":"쿠키 동기화가 활성화되어 있습니다. 브라우저 쿠키가 원격 브라우저 프로필 “%@”로 전송됩니다. 이 쿠키를 통해 로그인된 계정에 접근할 수 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"La synchronisation des cookies est activée. Les cookies du navigateur seront envoyés au profil de navigateur distant « %@ ». Ces cookies peuvent donner accès aux comptes auxquels vous êtes connecté."}},"hi":{"stringUnit":{"state":"translated","value":"कुकी सिंक चालू है। ब्राउज़र कुकी रिमोट ब्राउज़र प्रोफ़ाइल “%@” को भेजी जाएँगी। ये कुकी उन खातों का ऐक्सेस दे सकती हैं जिनमें आपने साइन इन किया हुआ है।"}},"ar":{"stringUnit":{"state":"translated","value":"مزامنة ملفات تعريف الارتباط مفعّلة. ستُرسل ملفات تعريف ارتباط المتصفح إلى ملف تعريف المتصفح البعيد «%@». يمكن أن تتيح هذه الملفات الوصول إلى الحسابات التي سجلت الدخول إليها."}},"it":{"stringUnit":{"state":"translated","value":"La sincronizzazione dei cookie è abilitata. I cookie del browser verranno inviati al profilo del browser remoto “%@”. Questi cookie possono consentire l’accesso agli account a cui hai effettuato l’accesso."}},"tr":{"stringUnit":{"state":"translated","value":"Çerez eşitlemesi etkin. Tarayıcı çerezleri, “%@” adlı uzak tarayıcı profiline gönderilecektir. Bu çerezler, oturum açtığınız hesaplara erişim sağlayabilir."}},"uk":{"stringUnit":{"state":"translated","value":"Синхронізацію файлів cookie увімкнено. Файли cookie браузера буде надіслано до віддаленого профілю браузера «%@». Ці файли cookie можуть надати доступ до облікових записів, у які ви ввійшли."}},"id":{"stringUnit":{"state":"translated","value":"Sinkronisasi cookie diaktifkan. Cookie browser akan dikirim ke profil browser jarak jauh “%@”. Cookie ini dapat memberikan akses ke akun yang sudah Anda masuki."}},"pl":{"stringUnit":{"state":"translated","value":"Synchronizacja plików cookie jest włączona. Pliki cookie przeglądarki będą wysyłane do zdalnego profilu przeglądarki „%@”. Mogą one zapewnić dostęp do kont, na których jesteś zalogowany."}},"th":{"stringUnit":{"state":"translated","value":"เปิดใช้งานการซิงค์คุกกี้แล้ว คุกกี้เบราว์เซอร์จะถูกส่งไปยังโปรไฟล์เบราว์เซอร์ระยะไกล “%@” คุกกี้เหล่านี้อาจทำให้เข้าถึงบัญชีที่คุณลงชื่อเข้าใช้อยู่ได้"}},"vi":{"stringUnit":{"state":"translated","value":"Đồng bộ cookie đã được bật. Cookie trình duyệt sẽ được gửi đến hồ sơ trình duyệt từ xa “%@”. Những cookie này có thể cấp quyền truy cập vào các tài khoản bạn đã đăng nhập."}},"nl":{"stringUnit":{"state":"translated","value":"Cookiesynchronisatie is ingeschakeld. Browsercookies worden naar het externe browserprofiel ‘%@’ verzonden. Deze cookies kunnen toegang geven tot de accounts waarop je bent ingelogd."}},"fa":{"stringUnit":{"state":"translated","value":"همگام‌سازی کوکی‌ها فعال است. کوکی‌های مرورگر به نمایهٔ مرورگر راه دور «%@» ارسال می‌شوند. این کوکی‌ها می‌توانند امکان دسترسی به حساب‌هایی را فراهم کنند که وارد آن‌ها شده‌اید."}},"ru":{"stringUnit":{"state":"translated","value":"Синхронизация файлов cookie включена. Файлы cookie браузера будут отправлены в удалённый профиль браузера «%@». Эти файлы могут предоставить доступ к вашим учётным записям, в которые выполнен вход."}},"sv":{"stringUnit":{"state":"translated","value":"Synkronisering av kakor är aktiverad. Webbläsarkakor skickas till den fjärranslutna webbläsarprofilen ”%@”. Dessa kakor kan ge åtkomst till konton där du är inloggad."}}}},
    "Cookie sync is not active.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cookie sync is not active."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Cookie 同步未启用。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Cookie 同步目前未啟用。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A sincronização de cookies não está ativa."}},"de":{"stringUnit":{"state":"translated","value":"Die Cookie-Synchronisierung ist nicht aktiv."}},"es":{"stringUnit":{"state":"translated","value":"La sincronización de cookies no está activa."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Cookie同期は動作していません。"}},"ko":{"stringUnit":{"state":"translated","value":"쿠키 동기화가 활성화되어 있지 않습니다."}},"fr":{"stringUnit":{"state":"translated","value":"La synchronisation des cookies n’est pas active."}},"hi":{"stringUnit":{"state":"translated","value":"कुकी सिंक सक्रिय नहीं है।"}},"ar":{"stringUnit":{"state":"translated","value":"مزامنة ملفات تعريف الارتباط غير نشطة."}},"it":{"stringUnit":{"state":"translated","value":"La sincronizzazione dei cookie non è attiva."}},"tr":{"stringUnit":{"state":"translated","value":"Çerez eşitlemesi etkin değil."}},"uk":{"stringUnit":{"state":"translated","value":"Синхронізація файлів cookie неактивна."}},"id":{"stringUnit":{"state":"translated","value":"Sinkronisasi cookie tidak aktif."}},"pl":{"stringUnit":{"state":"translated","value":"Synchronizacja plików cookie nie jest aktywna."}},"th":{"stringUnit":{"state":"translated","value":"การซิงค์คุกกี้ไม่ได้ทำงานอยู่"}},"vi":{"stringUnit":{"state":"translated","value":"Đồng bộ cookie hiện không hoạt động."}},"nl":{"stringUnit":{"state":"translated","value":"Cookiesynchronisatie is niet actief."}},"fa":{"stringUnit":{"state":"translated","value":"همگام‌سازی کوکی‌ها فعال نیست."}},"ru":{"stringUnit":{"state":"translated","value":"Синхронизация файлов cookie не активна."}},"sv":{"stringUnit":{"state":"translated","value":"Synkronisering av kakor är inte aktiv."}}}},
    "Cookies for these additional domains can be sent to your remote Gateway when sync is enabled: %@. These cookies can grant access to your signed-in accounts.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cookies for these additional domains can be sent to your remote Gateway when sync is enabled: %@. These cookies can grant access to your signed-in accounts."}},"zh-CN":{"stringUnit":{"state":"translated","value":"启用同步后，可将以下其他域名的 Cookie 发送到你的远程 Gateway：%@。这些 Cookie 可能授予对你已登录账户的访问权限。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"啟用同步後，下列其他網域的 Cookie 可傳送至您的遠端 Gateway：%@。這些 Cookie 可讓人存取您已登入的帳號。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Os cookies destes domínios adicionais podem ser enviados ao seu Gateway remoto quando a sincronização estiver ativada: %@. Esses cookies podem conceder acesso às contas em que você está conectado."}},"de":{"stringUnit":{"state":"translated","value":"Cookies für diese zusätzlichen Domains können bei aktivierter Synchronisierung an Ihren entfernten Gateway gesendet werden: %@. Diese Cookies können Zugriff auf die Konten gewähren, bei denen Sie angemeldet sind."}},"es":{"stringUnit":{"state":"translated","value":"Las cookies de estos dominios adicionales se pueden enviar a tu Gateway remoto cuando la sincronización esté activada: %@. Estas cookies pueden dar acceso a las cuentas en las que has iniciado sesión."}},"ja-JP":{"stringUnit":{"state":"translated","value":"同期が有効な場合、次の追加ドメインのCookieをリモートGatewayに送信できます：%@。これらのCookieにより、ログイン済みのアカウントにアクセスできるようになる可能性があります。"}},"ko":{"stringUnit":{"state":"translated","value":"동기화가 활성화되면 다음 추가 도메인의 쿠키가 원격 Gateway로 전송될 수 있습니다: %@. 이 쿠키를 통해 로그인된 계정에 접근할 수 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les cookies de ces domaines supplémentaires peuvent être envoyés à votre Gateway distant lorsque la synchronisation est activée : %@. Ces cookies peuvent donner accès aux comptes auxquels vous êtes connecté."}},"hi":{"stringUnit":{"state":"translated","value":"सिंक चालू होने पर इन अतिरिक्त डोमेन की कुकी आपके रिमोट Gateway को भेजी जा सकती हैं: %@। ये कुकी उन खातों का ऐक्सेस दे सकती हैं जिनमें आपने साइन इन किया हुआ है।"}},"ar":{"stringUnit":{"state":"translated","value":"يمكن إرسال ملفات تعريف الارتباط لهذه النطاقات الإضافية إلى Gateway البعيد الخاص بك عند تفعيل المزامنة: %@. يمكن أن تتيح هذه الملفات الوصول إلى الحسابات التي سجلت الدخول إليها."}},"it":{"stringUnit":{"state":"translated","value":"I cookie per questi domini aggiuntivi possono essere inviati al Gateway remoto quando la sincronizzazione è abilitata: %@. Questi cookie possono consentire l’accesso agli account a cui hai effettuato l’accesso."}},"tr":{"stringUnit":{"state":"translated","value":"Eşitleme etkinken şu ek alan adlarına ait çerezler uzak Gateway'inize gönderilebilir: %@. Bu çerezler, oturum açtığınız hesaplara erişim sağlayabilir."}},"uk":{"stringUnit":{"state":"translated","value":"Коли синхронізацію ввімкнено, файли cookie для цих додаткових доменів можуть надсилатися до вашого віддаленого Gateway: %@. Ці файли cookie можуть надати доступ до облікових записів, у які ви ввійшли."}},"id":{"stringUnit":{"state":"translated","value":"Cookie untuk domain tambahan berikut dapat dikirim ke Gateway jarak jauh Anda saat sinkronisasi diaktifkan: %@. Cookie ini dapat memberikan akses ke akun yang sudah Anda masuki."}},"pl":{"stringUnit":{"state":"translated","value":"Po włączeniu synchronizacji pliki cookie dla następujących dodatkowych domen mogą być wysyłane do zdalnego Gateway: %@. Mogą one zapewnić dostęp do kont, na których jesteś zalogowany."}},"th":{"stringUnit":{"state":"translated","value":"เมื่อเปิดใช้งานการซิงค์ คุกกี้สำหรับโดเมนเพิ่มเติมเหล่านี้สามารถส่งไปยัง Gateway ระยะไกลของคุณได้: %@ คุกกี้เหล่านี้อาจทำให้เข้าถึงบัญชีที่คุณลงชื่อเข้าใช้อยู่ได้"}},"vi":{"stringUnit":{"state":"translated","value":"Cookie cho các miền bổ sung này có thể được gửi đến Gateway từ xa của bạn khi bật đồng bộ: %@. Những cookie này có thể cấp quyền truy cập vào các tài khoản bạn đã đăng nhập."}},"nl":{"stringUnit":{"state":"translated","value":"Cookies voor deze extra domeinen kunnen naar je externe Gateway worden verzonden wanneer synchronisatie is ingeschakeld: %@. Deze cookies kunnen toegang geven tot de accounts waarop je bent ingelogd."}},"fa":{"stringUnit":{"state":"translated","value":"وقتی همگام‌سازی فعال باشد، کوکی‌های این دامنه‌های دیگر می‌توانند به Gateway راه دور شما ارسال شوند: %@. این کوکی‌ها می‌توانند امکان دسترسی به حساب‌هایی را فراهم کنند که وارد آن‌ها شده‌اید."}},"ru":{"stringUnit":{"state":"translated","value":"При включённой синхронизации файлы cookie для следующих дополнительных доменов могут отправляться на ваш удалённый Gateway: %@. Эти файлы могут предоставить доступ к вашим учётным записям, в которые выполнен вход."}},"sv":{"stringUnit":{"state":"translated","value":"Kakor för dessa ytterligare domäner kan skickas till din fjärranslutna Gateway när synkronisering är aktiverad: %@. Dessa kakor kan ge åtkomst till konton där du är inloggad."}}}},
    "Cooling down": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cooling down"}},"zh-CN":{"stringUnit":{"state":"translated","value":"冷却中"}},"zh-TW":{"stringUnit":{"state":"translated","value":"冷卻中"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Em pausa"}},"de":{"stringUnit":{"state":"translated","value":"Abkühlphase"}},"es":{"stringUnit":{"state":"translated","value":"En espera"}},"ja-JP":{"stringUnit":{"state":"translated","value":"クールダウン中"}},"ko":{"stringUnit":{"state":"translated","value":"재시도 대기 중"}},"fr":{"stringUnit":{"state":"translated","value":"En pause"}},"hi":{"stringUnit":{"state":"translated","value":"विराम अवधि जारी है"}},"ar":{"stringUnit":{"state":"translated","value":"في فترة انتظار"}},"it":{"stringUnit":{"state":"translated","value":"In pausa"}},"tr":{"stringUnit":{"state":"translated","value":"Bekleme süresinde"}},"uk":{"stringUnit":{"state":"translated","value":"Пауза перед повторною спробою"}},"id":{"stringUnit":{"state":"translated","value":"Dalam masa jeda"}},"pl":{"stringUnit":{"state":"translated","value":"Przerwa przed ponowną próbą"}},"th":{"stringUnit":{"state":"translated","value":"กำลังพักรอ"}},"vi":{"stringUnit":{"state":"translated","value":"Đang chờ"}},"nl":{"stringUnit":{"state":"translated","value":"Afkoelen"}},"fa":{"stringUnit":{"state":"translated","value":"در حال انتظار"}},"ru":{"stringUnit":{"state":"translated","value":"Ожидание перед повторной попыткой"}},"sv":{"stringUnit":{"state":"translated","value":"Väntar"}}}},
    "Copy": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Copy"}},"zh-CN":{"stringUnit":{"state":"translated","value":"复制"}},"zh-TW":{"stringUnit":{"state":"translated","value":"複製"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Copiar"}},"de":{"stringUnit":{"state":"translated","value":"Kopieren"}},"es":{"stringUnit":{"state":"translated","value":"Copiar"}},"ja-JP":{"stringUnit":{"state":"translated","value":"コピー"}},"ko":{"stringUnit":{"state":"translated","value":"복사"}},"fr":{"stringUnit":{"state":"translated","value":"Copier"}},"hi":{"stringUnit":{"state":"translated","value":"कॉपी करें"}},"ar":{"stringUnit":{"state":"translated","value":"نسخ"}},"it":{"stringUnit":{"state":"translated","value":"Copia"}},"tr":{"stringUnit":{"state":"translated","value":"Kopyala"}},"uk":{"stringUnit":{"state":"translated","value":"Копіювати"}},"id":{"stringUnit":{"state":"translated","value":"Salin"}},"pl":{"stringUnit":{"state":"translated","value":"Kopiuj"}},"th":{"stringUnit":{"state":"translated","value":"คัดลอก"}},"vi":{"stringUnit":{"state":"translated","value":"Sao chép"}},"nl":{"stringUnit":{"state":"translated","value":"Kopiëren"}},"fa":{"stringUnit":{"state":"translated","value":"کپی"}},"ru":{"stringUnit":{"state":"translated","value":"Копировать"}},"sv":{"stringUnit":{"state":"translated","value":"Kopiera"}}}},
    "Copy ID": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Copy ID"}},"zh-CN":{"stringUnit":{"state":"translated","value":"复制 ID"}},"zh-TW":{"stringUnit":{"state":"translated","value":"複製 ID"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Copiar ID"}},"de":{"stringUnit":{"state":"translated","value":"ID kopieren"}},"es":{"stringUnit":{"state":"translated","value":"Copiar ID"}},"ja-JP":{"stringUnit":{"state":"translated","value":"IDをコピー"}},"ko":{"stringUnit":{"state":"translated","value":"ID 복사"}},"fr":{"stringUnit":{"state":"translated","value":"Copier l’identifiant"}},"hi":{"stringUnit":{"state":"translated","value":"आईडी कॉपी करें"}},"ar":{"stringUnit":{"state":"translated","value":"نسخ المعرّف"}},"it":{"stringUnit":{"state":"translated","value":"Copia ID"}},"tr":{"stringUnit":{"state":"translated","value":"Kimliği kopyala"}},"uk":{"stringUnit":{"state":"translated","value":"Копіювати ID"}},"id":{"stringUnit":{"state":"translated","value":"Salin ID"}},"pl":{"stringUnit":{"state":"translated","value":"Kopiuj identyfikator"}},"th":{"stringUnit":{"state":"translated","value":"คัดลอก ID"}},"vi":{"stringUnit":{"state":"translated","value":"Sao chép ID"}},"nl":{"stringUnit":{"state":"translated","value":"ID kopiëren"}},"fa":{"stringUnit":{"state":"translated","value":"کپی شناسه"}},"ru":{"stringUnit":{"state":"translated","value":"Копировать ID"}},"sv":{"stringUnit":{"state":"translated","value":"Kopiera ID"}}}},
    "Copy Message": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Copy Message"}},"zh-CN":{"stringUnit":{"state":"translated","value":"复制消息"}},"zh-TW":{"stringUnit":{"state":"translated","value":"複製訊息"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Copiar Mensagem"}},"de":{"stringUnit":{"state":"translated","value":"Nachricht kopieren"}},"es":{"stringUnit":{"state":"translated","value":"Copiar Mensaje"}},"ja-JP":{"stringUnit":{"state":"translated","value":"メッセージをコピー"}},"ko":{"stringUnit":{"state":"translated","value":"메시지 복사"}},"fr":{"stringUnit":{"state":"translated","value":"Copier le message"}},"hi":{"stringUnit":{"state":"translated","value":"संदेश कॉपी करें"}},"ar":{"stringUnit":{"state":"translated","value":"نسخ الرسالة"}},"it":{"stringUnit":{"state":"translated","value":"Copia Messaggio"}},"tr":{"stringUnit":{"state":"translated","value":"Mesajı Kopyala"}},"uk":{"stringUnit":{"state":"translated","value":"Копіювати повідомлення"}},"id":{"stringUnit":{"state":"translated","value":"Salin Pesan"}},"pl":{"stringUnit":{"state":"translated","value":"Kopiuj wiadomość"}},"th":{"stringUnit":{"state":"translated","value":"คัดลอกข้อความ"}},"vi":{"stringUnit":{"state":"translated","value":"Sao chép tin nhắn"}},"nl":{"stringUnit":{"state":"translated","value":"Bericht Kopiëren"}},"fa":{"stringUnit":{"state":"translated","value":"کپی پیام"}},"ru":{"stringUnit":{"state":"translated","value":"Копировать сообщение"}},"sv":{"stringUnit":{"state":"translated","value":"Kopiera meddelande"}}}},
    "Copy Session Key": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Copy Session Key"}},"zh-CN":{"stringUnit":{"state":"translated","value":"复制会话密钥"}},"zh-TW":{"stringUnit":{"state":"translated","value":"複製工作階段金鑰"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Copiar Chave da Sessão"}},"de":{"stringUnit":{"state":"translated","value":"Sitzungsschlüssel kopieren"}},"es":{"stringUnit":{"state":"translated","value":"Copiar Clave de Sesión"}},"ja-JP":{"stringUnit":{"state":"translated","value":"セッションキーをコピー"}},"ko":{"stringUnit":{"state":"translated","value":"세션 키 복사"}},"fr":{"stringUnit":{"state":"translated","value":"Copier la clé de session"}},"hi":{"stringUnit":{"state":"translated","value":"सत्र कुंजी कॉपी करें"}},"ar":{"stringUnit":{"state":"translated","value":"نسخ مفتاح الجلسة"}},"it":{"stringUnit":{"state":"translated","value":"Copia Chiave di Sessione"}},"tr":{"stringUnit":{"state":"translated","value":"Oturum Anahtarını Kopyala"}},"uk":{"stringUnit":{"state":"translated","value":"Копіювати ключ сеансу"}},"id":{"stringUnit":{"state":"translated","value":"Salin Kunci Sesi"}},"pl":{"stringUnit":{"state":"translated","value":"Kopiuj klucz sesji"}},"th":{"stringUnit":{"state":"translated","value":"คัดลอกคีย์เซสชัน"}},"vi":{"stringUnit":{"state":"translated","value":"Sao chép khóa phiên"}},"nl":{"stringUnit":{"state":"translated","value":"Sessiesleutel Kopiëren"}},"fa":{"stringUnit":{"state":"translated","value":"کپی کلید نشست"}},"ru":{"stringUnit":{"state":"translated","value":"Копировать ключ сеанса"}},"sv":{"stringUnit":{"state":"translated","value":"Kopiera sessionsnyckel"}}}},
    "Copy code": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Copy code"}},"zh-CN":{"stringUnit":{"state":"translated","value":"复制代码"}},"zh-TW":{"stringUnit":{"state":"translated","value":"複製程式碼"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Copiar código"}},"de":{"stringUnit":{"state":"translated","value":"Code kopieren"}},"es":{"stringUnit":{"state":"translated","value":"Copiar código"}},"ja-JP":{"stringUnit":{"state":"translated","value":"コードをコピー"}},"ko":{"stringUnit":{"state":"translated","value":"코드 복사"}},"fr":{"stringUnit":{"state":"translated","value":"Copier le code"}},"hi":{"stringUnit":{"state":"translated","value":"कोड कॉपी करें"}},"ar":{"stringUnit":{"state":"translated","value":"نسخ الشيفرة"}},"it":{"stringUnit":{"state":"translated","value":"Copia codice"}},"tr":{"stringUnit":{"state":"translated","value":"Kodu kopyala"}},"uk":{"stringUnit":{"state":"translated","value":"Копіювати код"}},"id":{"stringUnit":{"state":"translated","value":"Salin kode"}},"pl":{"stringUnit":{"state":"translated","value":"Kopiuj kod"}},"th":{"stringUnit":{"state":"translated","value":"คัดลอกโค้ด"}},"vi":{"stringUnit":{"state":"translated","value":"Sao chép mã"}},"nl":{"stringUnit":{"state":"translated","value":"Code kopiëren"}},"fa":{"stringUnit":{"state":"translated","value":"کپی کد"}},"ru":{"stringUnit":{"state":"translated","value":"Копировать код"}},"sv":{"stringUnit":{"state":"translated","value":"Kopiera kod"}}}},
    "Copy cookies from %@ into an isolated agent profile. Passwords are never touched.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Copy cookies from %@ into an isolated agent profile. Passwords are never touched."}},"zh-CN":{"stringUnit":{"state":"translated","value":"将 Cookie 从 %@ 复制到隔离的智能体配置文件中。绝不会访问密码。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"將 Cookie 從 %@ 複製到隔離的代理程式設定檔。 絕不存取密碼。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Copie cookies de %@ para um perfil isolado do agente. As senhas nunca são acessadas."}},"de":{"stringUnit":{"state":"translated","value":"Cookies aus %@ in ein isoliertes Agentenprofil kopieren. Passwörter bleiben stets unberührt."}},"es":{"stringUnit":{"state":"translated","value":"Copiar cookies de %@ a un perfil de agente aislado. Las contraseñas nunca se modifican."}},"ja-JP":{"stringUnit":{"state":"translated","value":"%@ から分離されたエージェントプロファイルに Cookie をコピーします。パスワードには一切アクセスしません。"}},"ko":{"stringUnit":{"state":"translated","value":"%@의 쿠키를 격리된 에이전트 프로필로 복사합니다. 비밀번호는 전혀 건드리지 않습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Copier les cookies de %@ dans un profil d’agent isolé. Les mots de passe ne sont jamais modifiés."}},"hi":{"stringUnit":{"state":"translated","value":"%@ से कुकीज़ को एक अलग एजेंट प्रोफ़ाइल में कॉपी करें. पासवर्ड को कभी भी छुआ नहीं जाता है."}},"ar":{"stringUnit":{"state":"translated","value":"نسخ ملفات تعريف الارتباط من %@ إلى ملف تعريف معزول للوكيل. لا يتم الوصول إلى كلمات المرور مطلقًا."}},"it":{"stringUnit":{"state":"translated","value":"Copia i cookie da %@ in un profilo isolato dell'agente. Le password non vengono mai toccate."}},"tr":{"stringUnit":{"state":"translated","value":"%@ kaynağındaki çerezleri yalıtılmış bir ajan profiline kopyalayın. Parolalara asla dokunulmaz."}},"uk":{"stringUnit":{"state":"translated","value":"Копіювати файли cookie з %@ в ізольований профіль агента. Паролі ніколи не зачіпаються."}},"id":{"stringUnit":{"state":"translated","value":"Salin cookie dari %@ ke profil agen yang terisolasi. Kata sandi tidak pernah disentuh."}},"pl":{"stringUnit":{"state":"translated","value":"Kopiuj pliki cookie z %@ do odizolowanego profilu agenta. Hasła nigdy nie są odczytywane ani modyfikowane."}},"th":{"stringUnit":{"state":"translated","value":"คัดลอกคุกกี้จาก %@ ไปยังโปรไฟล์เอเจนต์ที่แยกไว้. จะไม่มีการเข้าถึงรหัสผ่านใดๆ."}},"vi":{"stringUnit":{"state":"translated","value":"Sao chép cookie từ %@ vào một hồ sơ tác nhân riêng biệt. Mật khẩu không bao giờ bị truy cập hay thay đổi."}},"nl":{"stringUnit":{"state":"translated","value":"Kopieer cookies van %@ naar een geïsoleerd agentprofiel. Wachtwoorden blijven altijd onaangeroerd."}},"fa":{"stringUnit":{"state":"translated","value":"کوکی‌ها را از %@ به یک نمایهٔ ایزولهٔ عامل کپی کنید. گذرواژه‌ها هرگز دست‌کاری نمی‌شوند."}},"ru":{"stringUnit":{"state":"translated","value":"Скопируйте файлы cookie из %@ в изолированный профиль агента. Пароли никогда не затрагиваются."}},"sv":{"stringUnit":{"state":"translated","value":"Kopiera cookies från %@ till en isolerad agentprofil. Lösenord berörs aldrig."}}}},
