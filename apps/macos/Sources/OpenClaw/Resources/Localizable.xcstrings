    "Do not fail the job if announce fails": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Do not fail the job if announce fails"}},"zh-CN":{"stringUnit":{"state":"translated","value":"通知失败时不将任务标记为失败"}},"zh-TW":{"stringUnit":{"state":"translated","value":"即使公告失敗，也不要將工作標記為失敗"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não marcar a tarefa como falha se o anúncio falhar"}},"de":{"stringUnit":{"state":"translated","value":"Den Auftrag nicht fehlschlagen lassen, wenn die Ankündigung fehlschlägt"}},"es":{"stringUnit":{"state":"translated","value":"No marcar la tarea como fallida si falla el anuncio"}},"ja-JP":{"stringUnit":{"state":"translated","value":"通知に失敗してもジョブを失敗にしない"}},"ko":{"stringUnit":{"state":"translated","value":"알림에 실패해도 작업을 실패로 처리하지 않음"}},"fr":{"stringUnit":{"state":"translated","value":"Ne pas faire échouer la tâche si l’annonce échoue"}},"hi":{"stringUnit":{"state":"translated","value":"घोषणा विफल होने पर कार्य को विफल न करें"}},"ar":{"stringUnit":{"state":"translated","value":"عدم اعتبار المهمة فاشلة إذا فشل الإعلان"}},"it":{"stringUnit":{"state":"translated","value":"Non considerare l'attività non riuscita se l'annuncio non riesce"}},"tr":{"stringUnit":{"state":"translated","value":"Duyuru başarısız olursa işi başarısız sayma"}},"uk":{"stringUnit":{"state":"translated","value":"Не позначати завдання як невдале, якщо оголошення не вдасться"}},"id":{"stringUnit":{"state":"translated","value":"Jangan gagalkan tugas jika pengumuman gagal"}},"pl":{"stringUnit":{"state":"translated","value":"Nie oznaczaj zadania jako nieudanego, jeśli ogłoszenie się nie powiedzie"}},"th":{"stringUnit":{"state":"translated","value":"ไม่ให้งานล้มเหลวหากการประกาศล้มเหลว"}},"vi":{"stringUnit":{"state":"translated","value":"Không đánh dấu tác vụ là thất bại nếu thông báo thất bại"}},"nl":{"stringUnit":{"state":"translated","value":"Laat de taak niet mislukken als de aankondiging mislukt"}},"fa":{"stringUnit":{"state":"translated","value":"در صورت نا