    "Check which process owns %lld and suggest fixes.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Check which process owns %lld and suggest fixes."}},"zh-CN":{"stringUnit":{"state":"translated","value":"检查哪个进程占用了 %lld 并提供修复建议。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"檢查哪個程序佔用了 %lld，並建議修正方式。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Verifique qual processo está usando %lld e sugira correções."}},"de":{"stringUnit":{"state":"translated","value":"Prüfen Sie, welcher Prozess %lld belegt, und schlagen Sie Lösungen vor."}},"es":{"stringUnit":{"state":"translated","value":"Comprueba qué proceso utiliza %lld y sugiere soluciones."}},"ja-JP":{"stringUnit":{"state":"translated","value":"%lldを使用しているプロセスを確認し、解決策を提案します。"}},"ko":{"stringUnit":{"state":"translated","value":"%lld을(를) 점유한 프로세스를 확인하고 해결 방법을 제안하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Vérifier quel processus utilise %lld et suggérer des solutions."}},"hi":{"stringUnit":{"state":"translated","value":"जाँचें कि %lld किस प्रक्रिया के नियंत्रण में है और समाधान सुझाएँ."}},"ar":{"stringUnit":{"state":"translated","value":"تحقق من العملية التي تستخدم %lld واقترح حلولًا."}},"it":{"stringUnit":{"state":"translated","value":"Verifica quale processo occupa %lld e suggerisci soluzioni."}},"tr":{"stringUnit":{"state":"translated","value":"%lld bağlantı noktasını hangi işlemin kullandığını kontrol edin ve çözüm önerileri sunun."}},"uk":{"stringUnit":{"state":"translated","value":"Перевірити, який процес використовує %lld, і запропонувати способи виправлення."}},"id":{"stringUnit":{"state":"translated","value":"Periksa proses yang menggunakan %lld dan sarankan perbaikan."}},"pl":{"stringUnit":{"state":"translated","value":"Sprawdź, który proces zajmuje %lld, i zaproponuj rozwiązania."}},"th":{"stringUnit":{"state":"translated","value":"ตรวจสอบว่ากระบวนการใดเป็นเจ้าของ %lld และแนะนำวิธีแก้ไข."}},"vi":{"stringUnit":{"state":"translated","value":"Kiểm tra tiến trình nào đang sử dụng %lld và đề xuất cách khắc phục."}},"nl":{"stringUnit":{"state":"translated","value":"Controleer welk proces %lld gebruikt en stel oplossingen voor."}},"fa":{"stringUnit":{"state":"translated","value":"بررسی کنید کدام فرایند مالک %lld است و راهکارهایی پیشنهاد دهید."}},"ru":{"stringUnit":{"state":"translated","value":"Проверьте, какой процесс использует %lld, и предложите способы исправления."}},"sv":{"stringUnit":{"state":"translated","value":"Kontrollera vilken process som äger %lld och föreslå lösningar."}}}},
    "Checking CLI logins, saved API keys, and local model servers on the Gateway.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Checking CLI logins, saved API keys, and local model servers on the Gateway."}},"zh-CN":{"stringUnit":{"state":"translated","value":"正在检查 Gateway 上的 CLI 登录状态、已保存的 API 密钥和本地模型服务器。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"正在檢查 Gateway 上的 CLI 登入資訊、已儲存的 API 金鑰及本機模型伺服器。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Verificando logins da CLI, chaves de API salvas e servidores de modelos locais no Gateway."}},"de":{"stringUnit":{"state":"translated","value":"CLI-Anmeldungen, gespeicherte API-Schlüssel und lokale Modellserver auf dem Gateway werden geprüft."}},"es":{"stringUnit":{"state":"translated","value":"Comprobando los inicios de sesión de la CLI, las claves de API guardadas y los servidores de modelos locales en el Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gateway上のCLIログイン、保存済みAPIキー、ローカルモデルサーバーを確認中。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway에서 CLI 로그인, 저장된 API 키 및 로컬 모델 서버를 확인하는 중입니다."}},"fr":{"stringUnit":{"state":"translated","value":"Vérification des connexions CLI, des clés API enregistrées et des serveurs de modèles locaux sur le Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway पर CLI लॉगिन, सहेजी गई API कुंजियों और स्थानीय मॉडल सर्वरों की जाँच जारी है."}},"ar":{"stringUnit":{"state":"translated","value":"جارٍ التحقق من تسجيلات الدخول عبر CLI ومفاتيح API المحفوظة وخوادم النماذج المحلية على Gateway."}},"it":{"stringUnit":{"state":"translated","value":"Verifica degli accessi CLI, delle chiavi API salvate e dei server di modelli locali sul Gateway in corso."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway üzerindeki CLI oturumları, kayıtlı API anahtarları ve yerel model sunucuları kontrol ediliyor."}},"uk":{"stringUnit":{"state":"translated","value":"Перевірка авторизацій у CLI, збережених ключів API та локальних серверів моделей на Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Memeriksa login CLI, kunci API yang tersimpan, dan server model lokal di Gateway."}},"pl":{"stringUnit":{"state":"translated","value":"Sprawdzanie logowań CLI, zapisanych kluczy API i lokalnych serwerów modeli na Gateway."}},"th":{"stringUnit":{"state":"translated","value":"กำลังตรวจสอบการเข้าสู่ระบบ CLI, คีย์ API ที่บันทึกไว้ และเซิร์ฟเวอร์โมเดลภายในเครื่องบน Gateway."}},"vi":{"stringUnit":{"state":"translated","value":"Đang kiểm tra thông tin đăng nhập CLI, khóa API đã lưu và máy chủ mô hình cục bộ trên Gateway."}},"nl":{"stringUnit":{"state":"translated","value":"CLI-aanmeldingen, opgeslagen API-sleutels en lokale modelservers op de Gateway worden gecontroleerd."}},"fa":{"stringUnit":{"state":"translated","value":"در حال بررسی ورودهای CLI، کلیدهای API ذخیره‌شده و سرورهای مدل محلی در Gateway."}},"ru":{"stringUnit":{"state":"translated","value":"Проверка авторизации в CLI, сохранённых ключей API и локальных серверов моделей на Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Kontrollerar CLI-inloggningar, sparade API-nycklar och lokala modellservrar på Gateway."}}}},
    "Checking remote gateway…": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Checking remote gateway…"}},"zh-CN":{"stringUnit":{"state":"translated","value":"正在检查远程 Gateway…"}},"zh-TW":{"stringUnit":{"state":"translated","value":"正在檢查遠端 Gateway…"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Verificando o Gateway remoto…"}},"de":{"stringUnit":{"state":"translated","value":"Entferntes Gateway wird geprüft…"}},"es":{"stringUnit":{"state":"translated","value":"Comprobando el Gateway remoto…"}},"ja-JP":{"stringUnit":{"state":"translated","value":"リモートGatewayを確認中…"}},"ko":{"stringUnit":{"state":"translated","value":"원격 Gateway 확인 중…"}},"fr":{"stringUnit":{"state":"translated","value":"Vérification du Gateway distant…"}},"hi":{"stringUnit":{"state":"translated","value":"रिमोट Gateway जाँचा जा रहा है…"}},"ar":{"stringUnit":{"state":"translated","value":"جارٍ التحقق من Gateway البعيد…"}},"it":{"stringUnit":{"state":"translated","value":"Verifica del Gateway remoto…"}},"tr":{"stringUnit":{"state":"translated","value":"Uzak Gateway kontrol ediliyor…"}},"uk":{"stringUnit":{"state":"translated","value":"Перевірка віддаленого Gateway…"}},"id":{"stringUnit":{"state":"translated","value":"Memeriksa Gateway jarak jauh…"}},"pl":{"stringUnit":{"state":"translated","value":"Sprawdzanie zdalnego Gateway…"}},"th":{"stringUnit":{"state":"translated","value":"กำลังตรวจสอบ Gateway ระยะไกล…"}},"vi":{"stringUnit":{"state":"translated","value":"Đang kiểm tra Gateway từ xa…"}},"nl":{"stringUnit":{"state":"translated","value":"Externe Gateway controleren…"}},"fa":{"stringUnit":{"state":"translated","value":"در حال بررسی Gateway راه دور…"}},"ru":{"stringUnit":{"state":"translated","value":"Проверка удалённого Gateway…"}},"sv":{"stringUnit":{"state":"translated","value":"Kontrollerar fjärransluten Gateway…"}}}},
