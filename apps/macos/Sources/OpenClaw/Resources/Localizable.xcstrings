    "Show Dock icon": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Show Dock icon"}},"zh-CN":{"stringUnit":{"state":"translated","value":"显示 Dock 图标"}},"zh-TW":{"stringUnit":{"state":"translated","value":"顯示 Dock 圖像"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Mostrar ícone no Dock"}},"de":{"stringUnit":{"state":"translated","value":"Dock-Symbol anzeigen"}},"es":{"stringUnit":{"state":"translated","value":"Mostrar icono del Dock"}},"ja-JP":{"stringUnit":{"state":"translated","value":"Dockアイコンを表示"}},"ko":{"stringUnit":{"state":"translated","value":"Dock 아이콘 표시"}},"fr":{"stringUnit":{"state":"translated","value":"Afficher l’icône dans le Dock"}},"hi":{"stringUnit":{"state":"translated","value":"Dock आइकन दिखाएँ"}},"ar":{"stringUnit":{"state":"translated","value":"إظهار أيقونة Dock"}},"it":{"stringUnit":{"state":"translated","value":"Mostra icona nel Dock"}},"tr":{"stringUnit":{"state":"translated","value":"Dock simgesini göster"}},"uk":{"stringUnit":{"state":"translated","value":"Показувати іконку в Dock"}},"id":{"stringUnit":{"state":"translated","value":"Tampilkan ikon Dock"}},"pl":{"stringUnit":{"state":"translated","value":"Pokaż ikonę w Docku"}},"th":{"stringUnit":{"state":"translated","value":"แสดงไอคอน Dock"}},"vi":{"stringUnit":{"state":"translated","value":"Hiển thị biểu tượng Dock"}},"nl":{"stringUnit":{"state":"translated","value":"Dock-pictogram tonen"}},"fa":{"stringUnit":{"state":"translated","value":"نمایش نماد Dock"}},"ru":{"stringUnit":{"state":"translated","value":"Показать значок в Dock"}},"sv":{"stringUnit":{"state":"translated","value":"Visa Dock-ikon"}}}},
