    "OpenClaw Sleeping": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenClaw Sleeping"}},"zh-CN":{"stringUnit":{"state":"translated","value":"OpenClaw 休眠中"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw 休眠中"}},"pt-BR":{"stringUnit":{"state":"translated","value":"OpenClaw em Repouso"}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw im Ruhezustand"}},"es":{"stringUnit":{"state":"translated","value":"OpenClaw En Reposo"}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClaw スリープ中"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw 절전 상태"}},"fr":{"stringUnit":{"state":"translated","value":"OpenClaw En Veille"}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw स्लीप मोड में है"}},"ar":{"stringUnit":{"state":"translated","value":"OpenClaw في وضع السكون"}},"it":{"stringUnit":{"state":"translated","value":"OpenClaw In Sospensione"}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw Uykuda"}},"uk":{"stringUnit":{"state":"translated","value":"OpenClaw У Режимі Сну"}},"id":{"stringUnit":{"state":"translated","value":"OpenClaw Tidur"}},"pl":{"stringUnit":{"state":"translated","value":"OpenClaw Uśpiony"}},"th":{"stringUnit":{"state":"translated","value":"OpenClaw อยู่ในโหมดพัก"}},"vi":{"stringUnit":{"state":"translated","value":"OpenClaw Đang Ngủ"}},"nl":{"stringUnit":{"state":"translated","value":"OpenClaw In Slaapstand"}},"fa":{"stringUnit":{"state":"translated","value":"OpenClaw در حالت خواب است"}},"ru":{"stringUnit":{"state":"translated","value":"OpenClaw в Спящем Режиме"}},"sv":{"stringUnit":{"state":"translated","value":"OpenClaw Vilande"}}}},
    "OpenClaw active": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenClaw active"}},"zh-CN":{"stringUnit":{"state":"translated","value":"OpenClaw 活动中"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw 運作中"}},"pt-BR":{"stringUnit":{"state":"translated","value":"OpenClaw ativo"}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw aktiv"}},"es":{"stringUnit":{"state":"translated","value":"OpenClaw activo"}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClaw 動作中"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw 활성화됨"}},"fr":{"stringUnit":{"state":"translated","value":"OpenClaw actif"}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw सक्रिय है"}},"ar":{"stringUnit":{"state":"translated","value":"OpenClaw نشط"}},"it":{"stringUnit":{"state":"translated","value":"OpenClaw attivo"}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw etkin"}},"uk":{"stringUnit":{"state":"translated","value":"OpenClaw активний"}},"id":{"stringUnit":{"state":"translated","value":"OpenClaw aktif"}},"pl":{"stringUnit":{"state":"translated","value":"OpenClaw aktywny"}},"th":{"stringUnit":{"state":"translated","value":"OpenClaw กำลังทำงาน"}},"vi":{"stringUnit":{"state":"translated","value":"OpenClaw đang hoạt động"}},"nl":{"stringUnit":{"state":"translated","value":"OpenClaw actief"}},"fa":{"stringUnit":{"state":"translated","value":"OpenClaw فعال است"}},"ru":{"stringUnit":{"state":"translated","value":"OpenClaw активен"}},"sv":{"stringUnit":{"state":"translated","value":"OpenClaw aktiv"}}}},
    "OpenClaw can take actions using the permissions and services you enable. Review prompts and only connect tools you trust.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenClaw can take actions using the permissions and services you enable. Review prompts and only connect tools you trust."}},"zh-CN":{"stringUnit":{"state":"translated","value":"OpenClaw 可以使用你启用的权限和服务执行操作。 请仔细查看提示, 并仅连接你信任的工具。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw 可使用您啟用的權限和服務執行動作。請仔細查看提示，並僅連接您信任的工具。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O OpenClaw pode realizar ações usando as permissões e os serviços que você ativa. Revise as solicitações e conecte apenas ferramentas em que você confia."}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw kann mit den von Ihnen aktivierten Berechtigungen und Diensten Aktionen ausführen. Prüfen Sie Anfragen und verbinden Sie nur Tools, denen Sie vertrauen."}},"es":{"stringUnit":{"state":"translated","value":"OpenClaw puede realizar acciones con los permisos y servicios que habilites. Revisa las solicitudes y conecta solo herramientas en las que confíes."}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClaw は、有効にした権限とサービスを使用して操作を実行できます。確認画面の内容を確認し、信頼できるツールのみを接続してください。"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw는 사용자가 활성화한 권한과 서비스를 사용하여 작업을 수행할 수 있습니다. 요청 내용을 검토하고 신뢰하는 도구만 연결하세요."}},"fr":{"stringUnit":{"state":"translated","value":"OpenClaw peut effectuer des actions à l’aide des autorisations et des services que vous activez. Examinez les demandes et ne connectez que des outils de confiance."}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw आपके द्वारा सक्षम की गई अनुमतियों और सेवाओं का उपयोग करके कार्रवाइयाँ कर सकता है. अनुरोधों की समीक्षा करें और केवल भरोसेमंद टूल कनेक्ट करें."}},"ar":{"stringUnit":{"state":"translated","value":"يمكن لـ OpenClaw تنفيذ إجراءات باستخدام الأذونات والخدمات التي تفعّلها. راجع الطلبات ولا تربط إلا الأدوات التي تثق بها."}},"it":{"stringUnit":{"state":"translated","value":"OpenClaw può eseguire azioni utilizzando le autorizzazioni e i servizi che abiliti. Esamina le richieste e collega solo strumenti di cui ti fidi."}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw, etkinleştirdiğiniz izinleri ve hizmetleri kullanarak işlem yapabilir. İstemleri inceleyin ve yalnızca güvendiğiniz araçları bağlayın."}},"uk":{"stringUnit":{"state":"translated","value":"OpenClaw може виконувати дії, використовуючи дозволи та служби, які ви вмикаєте. Переглядайте запити та підключайте лише ті інструменти, яким довіряєте."}},"id":{"stringUnit":{"state":"translated","value":"OpenClaw dapat melakukan tindakan menggunakan izin dan layanan yang Anda aktifkan. Tinjau permintaan dan hanya hubungkan alat yang Anda percayai."}},"pl":{"stringUnit":{"state":"translated","value":"OpenClaw może podejmować działania, korzystając z włączonych uprawnień i usług. Sprawdzaj prośby i podłączaj tylko zaufane narzędzia."}},"th":{"stringUnit":{"state":"translated","value":"OpenClaw สามารถดำเนินการต่างๆ โดยใช้สิทธิ์และบริการที่คุณเปิดใช้งาน. ตรวจสอบคำขอและเชื่อมต่อเฉพาะเครื่องมือที่คุณเชื่อถือเท่านั้น."}},"vi":{"stringUnit":{"state":"translated","value":"OpenClaw có thể thực hiện các hành động bằng những quyền và dịch vụ bạn bật. Hãy xem xét các lời nhắc và chỉ kết nối những công cụ bạn tin tưởng."}},"nl":{"stringUnit":{"state":"translated","value":"OpenClaw kan acties uitvoeren met de machtigingen en diensten die je inschakelt. Controleer verzoeken en verbind alleen tools die je vertrouwt."}},"fa":{"stringUnit":{"state":"translated","value":"OpenClaw می‌تواند با استفاده از مجوزها و سرویس‌هایی که فعال می‌کنید اقداماتی انجام دهد. درخواست‌ها را بررسی کنید و فقط ابزارهایی را متصل کنید که به آن‌ها اعتماد دارید."}},"ru":{"stringUnit":{"state":"translated","value":"OpenClaw может выполнять действия, используя предоставленные вами разрешения и включённые службы. Проверяйте запросы и подключайте только те инструменты, которым доверяете."}},"sv":{"stringUnit":{"state":"translated","value":"OpenClaw kan utföra åtgärder med de behörigheter och tjänster du aktiverar. Granska förfrågningar och anslut bara verktyg du litar på."}}}},
    "OpenClaw connecting": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenClaw connecting"}},"zh-CN":{"stringUnit":{"state":"translated","value":"OpenClaw 正在连接"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw 正在連線"}},"pt-BR":{"stringUnit":{"state":"translated","value":"OpenClaw conectando"}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw verbindet sich"}},"es":{"stringUnit":{"state":"translated","value":"OpenClaw conectando"}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClaw接続中"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw 연결 중"}},"fr":{"stringUnit":{"state":"translated","value":"Connexion d’OpenClaw en cours"}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw कनेक्ट हो रहा है"}},"ar":{"stringUnit":{"state":"translated","value":"جارٍ اتصال OpenClaw"}},"it":{"stringUnit":{"state":"translated","value":"OpenClaw in connessione"}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw bağlanıyor"}},"uk":{"stringUnit":{"state":"translated","value":"OpenClaw підключається"}},"id":{"stringUnit":{"state":"translated","value":"OpenClaw sedang terhubung"}},"pl":{"stringUnit":{"state":"translated","value":"OpenClaw łączy się"}},"th":{"stringUnit":{"state":"translated","value":"OpenClaw กำลังเชื่อมต่อ"}},"vi":{"stringUnit":{"state":"translated","value":"OpenClaw đang kết nối"}},"nl":{"stringUnit":{"state":"translated","value":"OpenClaw maakt verbinding"}},"fa":{"stringUnit":{"state":"translated","value":"OpenClaw در حال اتصال"}},"ru":{"stringUnit":{"state":"translated","value":"OpenClaw подключается"}},"sv":{"stringUnit":{"state":"translated","value":"OpenClaw ansluter"}}}},
    "OpenClaw connects to an independently managed Gateway on this Mac.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenClaw connects to an independently managed Gateway on this Mac."}},"zh-CN":{"stringUnit":{"state":"translated","value":"OpenClaw 连接到此 Mac 上独立管理的 Gateway。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw 會連線至這部 Mac 上獨立管理的 Gateway."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O OpenClaw se conecta a um Gateway gerenciado de forma independente neste Mac."}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw verbindet sich mit einem unabhängig verwalteten Gateway auf diesem Mac."}},"es":{"stringUnit":{"state":"translated","value":"OpenClaw se conecta a un Gateway gestionado de forma independiente en este Mac."}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClawは、このMac上で独立して管理されているGatewayに接続します。"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw는 이 Mac에서 독립적으로 관리되는 Gateway에 연결합니다."}},"fr":{"stringUnit":{"state":"translated","value":"OpenClaw se connecte à un Gateway géré indépendamment sur ce Mac."}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw इस Mac पर स्वतंत्र रूप से प्रबंधित Gateway से कनेक्ट होता है."}},"ar":{"stringUnit":{"state":"translated","value":"يتصل OpenClaw بـ Gateway يُدار بشكل مستقل على جهاز Mac هذا."}},"it":{"stringUnit":{"state":"translated","value":"OpenClaw si connette a un Gateway gestito in modo indipendente su questo Mac."}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw, bu Mac'te bağımsız olarak yönetilen bir Gateway'e bağlanır."}},"uk":{"stringUnit":{"state":"translated","value":"OpenClaw підключається до незалежно керованого Gateway на цьому Mac."}},"id":{"stringUnit":{"state":"translated","value":"OpenClaw terhubung ke Gateway yang dikelola secara independen di Mac ini."}},"pl":{"stringUnit":{"state":"translated","value":"OpenClaw łączy się z niezależnie zarządzanym Gateway na tym Macu."}},"th":{"stringUnit":{"state":"translated","value":"OpenClaw เชื่อมต่อกับ Gateway ที่มีการจัดการแยกต่างหากบน Mac เครื่องนี้."}},"vi":{"stringUnit":{"state":"translated","value":"OpenClaw kết nối với một Gateway được quản lý độc lập trên máy Mac này."}},"nl":{"stringUnit":{"state":"translated","value":"OpenClaw maakt verbinding met een onafhankelijk beheerde Gateway op deze Mac."}},"fa":{"stringUnit":{"state":"translated","value":"OpenClaw به یک Gateway در این Mac متصل می‌شود که به‌صورت مستقل مدیریت می‌شود."}},"ru":{"stringUnit":{"state":"translated","value":"OpenClaw подключается к Gateway, который управляется независимо на этом Mac."}},"sv":{"stringUnit":{"state":"translated","value":"OpenClaw ansluter till en separat hanterad Gateway på denna Mac."}}}},
    "OpenClaw could not confirm the agent notification. It will not retry, to avoid a duplicate welcome.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenClaw could not confirm the agent notification. It will not retry, to avoid a duplicate welcome."}},"zh-CN":{"stringUnit":{"state":"translated","value":"OpenClaw 无法确认是否已通知智能体。为避免重复发送欢迎消息，将不会重试。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw 無法確認代理程式通知是否成功。 為避免重複傳送歡迎訊息，將不會重試。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O OpenClaw não conseguiu confirmar a notificação do agente. Não haverá nova tentativa, para evitar uma mensagem de boas-vindas duplicada."}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw konnte die Benachrichtigung des Agenten nicht bestätigen. Um eine doppelte Begrüßung zu vermeiden, wird kein erneuter Versuch unternommen."}},"es":{"stringUnit":{"state":"translated","value":"OpenClaw no pudo confirmar la notificación al agente. No volverá a intentarlo para evitar una bienvenida duplicada."}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClawはエージェントへの通知を確認できませんでした。ウェルカムメッセージの重複を避けるため、再試行しません。"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw에서 에이전트 알림을 확인하지 못했습니다. 환영 메시지가 중복되지 않도록 다시 시도하지 않습니다."}},"fr":{"stringUnit":{"state":"translated","value":"OpenClaw n’a pas pu confirmer la notification de l’agent. Aucune nouvelle tentative ne sera effectuée afin d’éviter un message de bienvenue en double."}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw एजेंट को सूचना भेजे जाने की पुष्टि नहीं कर सका. दोबारा स्वागत संदेश भेजने से बचने के लिए यह फिर से प्रयास नहीं करेगा."}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر على OpenClaw تأكيد إشعار الوكيل. لن يعيد المحاولة، لتجنّب تكرار الترحيب."}},"it":{"stringUnit":{"state":"translated","value":"OpenClaw non ha potuto confermare la notifica all'agente. Non riproverà, per evitare un messaggio di benvenuto duplicato."}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw, ajan bildirimini doğrulayamadı. Karşılama mesajının yinelenmesini önlemek için yeniden denemeyecek."}},"uk":{"stringUnit":{"state":"translated","value":"OpenClaw не вдалося підтвердити сповіщення агента. Повторної спроби не буде, щоб уникнути дублювання привітання."}},"id":{"stringUnit":{"state":"translated","value":"OpenClaw tidak dapat mengonfirmasi notifikasi agen. OpenClaw tidak akan mencoba lagi untuk menghindari sambutan ganda."}},"pl":{"stringUnit":{"state":"translated","value":"OpenClaw nie może potwierdzić powiadomienia agenta. Nie ponowi próby, aby uniknąć powtórnego powitania."}},"th":{"stringUnit":{"state":"translated","value":"OpenClaw ไม่สามารถยืนยันการแจ้งเตือนไปยังเอเจนต์ได้. ระบบจะไม่ลองอีกครั้ง เพื่อหลีกเลี่ยงข้อความต้อนรับซ้ำ."}},"vi":{"stringUnit":{"state":"translated","value":"OpenClaw không thể xác nhận việc thông báo cho tác nhân. Ứng dụng sẽ không thử lại để tránh gửi lời chào mừng trùng lặp."}},"nl":{"stringUnit":{"state":"translated","value":"OpenClaw kon de melding aan de agent niet bevestigen. Om een dubbele begroeting te voorkomen, wordt het niet opnieuw geprobeerd."}},"fa":{"stringUnit":{"state":"translated","value":"OpenClaw نتوانست اطلاع‌رسانی به عامل را تأیید کند. برای جلوگیری از ارسال پیام خوشامدگویی تکراری، دوباره تلاش نخواهد کرد."}},"ru":{"stringUnit":{"state":"translated","value":"OpenClaw не удалось подтвердить уведомление агента. Повторной попытки не будет, чтобы избежать повторного приветствия."}},"sv":{"stringUnit":{"state":"translated","value":"OpenClaw kunde inte bekräfta meddelandet till agenten. Inget nytt försök görs, för att undvika en dubbel välkomsthälsning."}}}},
    "OpenClaw could not load editable settings for this channel.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenClaw could not load editable settings for this channel."}},"zh-CN":{"stringUnit":{"state":"translated","value":"OpenClaw 无法加载此渠道的可编辑设置。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw 無法載入此頻道的可編輯設定。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O OpenClaw não conseguiu carregar as configurações editáveis deste canal."}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw konnte die bearbeitbaren Einstellungen für diesen Kanal nicht laden."}},"es":{"stringUnit":{"state":"translated","value":"OpenClaw no pudo cargar los ajustes editables de este canal."}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClawはこのチャンネルの編集可能な設定を読み込めませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw에서 이 채널의 편집 가능한 설정을 불러오지 못했습니다."}},"fr":{"stringUnit":{"state":"translated","value":"OpenClaw n’a pas pu charger les paramètres modifiables de ce canal."}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw इस चैनल की संपादन योग्य सेटिंग्स लोड नहीं कर सका."}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر على OpenClaw تحميل الإعدادات القابلة للتعديل لهذه القناة."}},"it":{"stringUnit":{"state":"translated","value":"OpenClaw non ha potuto caricare le impostazioni modificabili per questo canale."}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw bu kanalın düzenlenebilir ayarlarını yükleyemedi."}},"uk":{"stringUnit":{"state":"translated","value":"OpenClaw не вдалося завантажити налаштування цього каналу, доступні для редагування."}},"id":{"stringUnit":{"state":"translated","value":"OpenClaw tidak dapat memuat pengaturan yang dapat diedit untuk saluran ini."}},"pl":{"stringUnit":{"state":"translated","value":"OpenClaw nie może wczytać ustawień tego kanału dostępnych do edycji."}},"th":{"stringUnit":{"state":"translated","value":"OpenClaw ไม่สามารถโหลดการตั้งค่าที่แก้ไขได้สำหรับช่องทางนี้."}},"vi":{"stringUnit":{"state":"translated","value":"OpenClaw không thể tải các cài đặt có thể chỉnh sửa cho kênh này."}},"nl":{"stringUnit":{"state":"translated","value":"OpenClaw kon de bewerkbare instellingen voor dit kanaal niet laden."}},"fa":{"stringUnit":{"state":"translated","value":"OpenClaw نتوانست تنظیمات قابل ویرایش این کانال را بارگیری کند."}},"ru":{"stringUnit":{"state":"translated","value":"OpenClaw не удалось загрузить редактируемые настройки этого канала."}},"sv":{"stringUnit":{"state":"translated","value":"OpenClaw kunde inte läsa in redigerbara inställningar för denna kanal."}}}},
    "OpenClaw could not notify your agent automatically. The app and Gateway update are complete.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenClaw could not notify your agent automatically. The app and Gateway update are complete."}},"zh-CN":{"stringUnit":{"state":"translated","value":"OpenClaw 无法自动通知你的智能体。应用和 Gateway 已更新完成。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw 無法自動通知您的代理程式。 應用程式與 Gateway 更新已完成。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O OpenClaw não conseguiu notificar seu agente automaticamente. A atualização do aplicativo e do Gateway foi concluída."}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw konnte Ihren Agenten nicht automatisch benachrichtigen. Die Aktualisierung der App und des Gateway ist abgeschlossen."}},"es":{"stringUnit":{"state":"translated","value":"OpenClaw no pudo notificar a tu agente automáticamente. La actualización de la aplicación y del Gateway se ha completado."}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClawはエージェントに自動で通知できませんでした。アプリとGatewayの更新は完了しています。"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw에서 에이전트에 자동으로 알리지 못했습니다. 앱 및 Gateway 업데이트는 완료되었습니다."}},"fr":{"stringUnit":{"state":"translated","value":"OpenClaw n’a pas pu avertir votre agent automatiquement. La mise à jour de l’application et du Gateway est terminée."}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw आपके एजेंट को अपने आप सूचित नहीं कर सका. ऐप और Gateway का अपडेट पूरा हो गया है."}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر على OpenClaw إشعار وكيلك تلقائيًا. اكتمل تحديث التطبيق وGateway."}},"it":{"stringUnit":{"state":"translated","value":"OpenClaw non ha potuto notificare automaticamente il tuo agente. L'aggiornamento dell'app e del Gateway è completo."}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw ajanınızı otomatik olarak bilgilendiremedi. Uygulama ve Gateway güncellemeleri tamamlandı."}},"uk":{"stringUnit":{"state":"translated","value":"OpenClaw не вдалося автоматично сповістити вашого агента. Оновлення застосунку та Gateway завершено."}},"id":{"stringUnit":{"state":"translated","value":"OpenClaw tidak dapat memberi tahu agen Anda secara otomatis. Pembaruan aplikasi dan Gateway telah selesai."}},"pl":{"stringUnit":{"state":"translated","value":"OpenClaw nie może automatycznie powiadomić Twojego agenta. Aktualizacja aplikacji i Gateway została ukończona."}},"th":{"stringUnit":{"state":"translated","value":"OpenClaw ไม่สามารถแจ้งเอเจนต์ของคุณโดยอัตโนมัติได้. การอัปเดตแอปและ Gateway เสร็จสมบูรณ์แล้ว."}},"vi":{"stringUnit":{"state":"translated","value":"OpenClaw không thể tự động thông báo cho tác nhân của bạn. Quá trình cập nhật ứng dụng và Gateway đã hoàn tất."}},"nl":{"stringUnit":{"state":"translated","value":"OpenClaw kon je agent niet automatisch op de hoogte stellen. De updates van de app en Gateway zijn voltooid."}},"fa":{"stringUnit":{"state":"translated","value":"OpenClaw نتوانست به‌طور خودکار به عامل شما اطلاع دهد. به‌روزرسانی برنامه و Gateway کامل شده است."}},"ru":{"stringUnit":{"state":"translated","value":"OpenClaw не удалось автоматически уведомить вашего агента. Обновление приложения и Gateway завершено."}},"sv":{"stringUnit":{"state":"translated","value":"OpenClaw kunde inte meddela din agent automatiskt. Uppdateringen av appen och Gateway är klar."}}}},
    "OpenClaw could not notify your agent automatically. The app and Mac node update are complete.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenClaw could not notify your agent automatically. The app and Mac node update are complete."}},"zh-CN":{"stringUnit":{"state":"translated","value":"OpenClaw 无法自动通知你的智能体。应用和 Mac 节点已更新完成。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw 無法自動通知您的代理程式。 應用程式與 Mac 節點更新已完成。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O OpenClaw não conseguiu notificar seu agente automaticamente. A atualização do aplicativo e do nó do Mac foi concluída."}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw konnte Ihren Agenten nicht automatisch benachrichtigen. Die Aktualisierung der App und des Mac-Knotens ist abgeschlossen."}},"es":{"stringUnit":{"state":"translated","value":"OpenClaw no pudo notificar a tu agente automáticamente. La actualización de la aplicación y del nodo de Mac se ha completado."}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClawはエージェントに自動で通知できませんでした。アプリとMacノードの更新は完了しています。"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw에서 에이전트에 자동으로 알리지 못했습니다. 앱 및 Mac 노드 업데이트는 완료되었습니다."}},"fr":{"stringUnit":{"state":"translated","value":"OpenClaw n’a pas pu avertir votre agent automatiquement. La mise à jour de l’application et du nœud Mac est terminée."}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw आपके एजेंट को अपने आप सूचित नहीं कर सका. ऐप और Mac नोड का अपडेट पूरा हो गया है."}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر على OpenClaw إشعار وكيلك تلقائيًا. اكتمل تحديث التطبيق وعقدة Mac."}},"it":{"stringUnit":{"state":"translated","value":"OpenClaw non ha potuto notificare automaticamente il tuo agente. L'aggiornamento dell'app e del nodo Mac è completo."}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw ajanınızı otomatik olarak bilgilendiremedi. Uygulama ve Mac düğümü güncellemeleri tamamlandı."}},"uk":{"stringUnit":{"state":"translated","value":"OpenClaw не вдалося автоматично сповістити вашого агента. Оновлення застосунку та вузла Mac завершено."}},"id":{"stringUnit":{"state":"translated","value":"OpenClaw tidak dapat memberi tahu agen Anda secara otomatis. Pembaruan aplikasi dan node Mac telah selesai."}},"pl":{"stringUnit":{"state":"translated","value":"OpenClaw nie może automatycznie powiadomić Twojego agenta. Aktualizacja aplikacji i węzła Mac została ukończona."}},"th":{"stringUnit":{"state":"translated","value":"OpenClaw ไม่สามารถแจ้งเอเจนต์ของคุณโดยอัตโนมัติได้. การอัปเดตแอปและโหนด Mac เสร็จสมบูรณ์แล้ว."}},"vi":{"stringUnit":{"state":"translated","value":"OpenClaw không thể tự động thông báo cho tác nhân của bạn. Quá trình cập nhật ứng dụng và nút Mac đã hoàn tất."}},"nl":{"stringUnit":{"state":"translated","value":"OpenClaw kon je agent niet automatisch op de hoogte stellen. De updates van de app en Mac-node zijn voltooid."}},"fa":{"stringUnit":{"state":"translated","value":"OpenClaw نتوانست به‌طور خودکار به عامل شما اطلاع دهد. به‌روزرسانی برنامه و گره Mac کامل شده است."}},"ru":{"stringUnit":{"state":"translated","value":"OpenClaw не удалось автоматически уведомить вашего агента. Обновление приложения и узла Mac завершено."}},"sv":{"stringUnit":{"state":"translated","value":"OpenClaw kunde inte meddela din agent automatiskt. Uppdateringen av appen och Mac-noden är klar."}}}},
    "OpenClaw could not read the Gateway service ownership record. Retry after checking the Gateway LaunchAgent.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenClaw could not read the Gateway service ownership record. Retry after checking the Gateway LaunchAgent."}},"zh-CN":{"stringUnit":{"state":"translated","value":"OpenClaw 无法读取 Gateway 服务的归属记录。请检查 Gateway LaunchAgent 后重试。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw 無法讀取 Gateway 服務的擁有權記錄。 請檢查 Gateway LaunchAgent 後重試。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O OpenClaw não conseguiu ler o registro de propriedade do serviço Gateway. Tente novamente após verificar o LaunchAgent do Gateway."}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw konnte den Datensatz zur Eigentümerschaft des Gateway-Dienstes nicht lesen. Prüfen Sie den Gateway-LaunchAgent und versuchen Sie es erneut."}},"es":{"stringUnit":{"state":"translated","value":"OpenClaw no pudo leer el registro de propiedad del servicio Gateway. Vuelve a intentarlo después de comprobar el LaunchAgent de Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClawはGatewayサービスの所有権レコードを読み取れませんでした。GatewayのLaunchAgentを確認してから再試行してください。"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw에서 Gateway 서비스 소유권 기록을 읽지 못했습니다. Gateway LaunchAgent를 확인한 후 다시 시도하세요."}},"fr":{"stringUnit":{"state":"translated","value":"OpenClaw n’a pas pu lire l’enregistrement de propriété du service Gateway. Réessayez après avoir vérifié le LaunchAgent du Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway सेवा के स्वामित्व का रिकॉर्ड नहीं पढ़ सका. Gateway LaunchAgent की जाँच करने के बाद फिर से प्रयास करें."}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر على OpenClaw قراءة سجل ملكية خدمة Gateway. أعد المحاولة بعد التحقق من LaunchAgent الخاص بـ Gateway."}},"it":{"stringUnit":{"state":"translated","value":"OpenClaw non ha potuto leggere il registro di proprietà del servizio Gateway. Riprova dopo aver verificato il LaunchAgent del Gateway."}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw, Gateway hizmetinin sahiplik kaydını okuyamadı. Gateway LaunchAgent'ını kontrol ettikten sonra yeniden deneyin."}},"uk":{"stringUnit":{"state":"translated","value":"OpenClaw не вдалося прочитати запис про власника служби Gateway. Повторіть спробу після перевірки LaunchAgent для Gateway."}},"id":{"stringUnit":{"state":"translated","value":"OpenClaw tidak dapat membaca catatan kepemilikan layanan Gateway. Coba lagi setelah memeriksa LaunchAgent Gateway."}},"pl":{"stringUnit":{"state":"translated","value":"OpenClaw nie może odczytać rekordu właściciela usługi Gateway. Sprawdź LaunchAgent usługi Gateway i spróbuj ponownie."}},"th":{"stringUnit":{"state":"translated","value":"OpenClaw ไม่สามารถอ่านบันทึกความเป็นเจ้าของบริการ Gateway ได้. ลองอีกครั้งหลังจากตรวจสอบ LaunchAgent ของ Gateway."}},"vi":{"stringUnit":{"state":"translated","value":"OpenClaw không thể đọc bản ghi quyền sở hữu dịch vụ Gateway. Hãy thử lại sau khi kiểm tra LaunchAgent của Gateway."}},"nl":{"stringUnit":{"state":"translated","value":"OpenClaw kon de eigendomsregistratie van de Gateway-service niet lezen. Probeer het opnieuw nadat je de Gateway LaunchAgent hebt gecontroleerd."}},"fa":{"stringUnit":{"state":"translated","value":"OpenClaw نتوانست رکورد مالکیت سرویس Gateway را بخواند. پس از بررسی LaunchAgent مربوط به Gateway دوباره تلاش کنید."}},"ru":{"stringUnit":{"state":"translated","value":"OpenClaw не удалось прочитать запись о владельце службы Gateway. Проверьте LaunchAgent для Gateway и повторите попытку."}},"sv":{"stringUnit":{"state":"translated","value":"OpenClaw kunde inte läsa ägarinformationen för Gateway-tjänsten. Försök igen efter att ha kontrollerat Gateway-tjänstens LaunchAgent."}}}},
    "OpenClaw could not read the node service ownership record. Retry after checking the node LaunchAgent.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenClaw could not read the node service ownership record. Retry after checking the node LaunchAgent."}},"zh-CN":{"stringUnit":{"state":"translated","value":"OpenClaw 无法读取节点服务的归属记录。请检查节点 LaunchAgent 后重试。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw 無法讀取節點服務的擁有權記錄。 請檢查節點 LaunchAgent 後重試。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O OpenClaw não conseguiu ler o registro de propriedade do serviço do nó. Tente novamente após verificar o LaunchAgent do nó."}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw konnte den Datensatz zur Eigentümerschaft des Knotendienstes nicht lesen. Prüfen Sie den Knoten-LaunchAgent und versuchen Sie es erneut."}},"es":{"stringUnit":{"state":"translated","value":"OpenClaw no pudo leer el registro de propiedad del servicio del nodo. Vuelve a intentarlo después de comprobar el LaunchAgent del nodo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClawはノードサービスの所有権レコードを読み取れませんでした。ノードのLaunchAgentを確認してから再試行してください。"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw에서 노드 서비스 소유권 기록을 읽지 못했습니다. 노드 LaunchAgent를 확인한 후 다시 시도하세요."}},"fr":{"stringUnit":{"state":"translated","value":"OpenClaw n’a pas pu lire l’enregistrement de propriété du service du nœud. Réessayez après avoir vérifié le LaunchAgent du nœud."}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw नोड सेवा के स्वामित्व का रिकॉर्ड नहीं पढ़ सका. नोड LaunchAgent की जाँच करने के बाद फिर से प्रयास करें."}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر على OpenClaw قراءة سجل ملكية خدمة العقدة. أعد المحاولة بعد التحقق من LaunchAgent الخاص بالعقدة."}},"it":{"stringUnit":{"state":"translated","value":"OpenClaw non ha potuto leggere il registro di proprietà del servizio del nodo. Riprova dopo aver verificato il LaunchAgent del nodo."}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw, düğüm hizmetinin sahiplik kaydını okuyamadı. Düğüm LaunchAgent'ını kontrol ettikten sonra yeniden deneyin."}},"uk":{"stringUnit":{"state":"translated","value":"OpenClaw не вдалося прочитати запис про власника служби вузла. Повторіть спробу після перевірки LaunchAgent для вузла."}},"id":{"stringUnit":{"state":"translated","value":"OpenClaw tidak dapat membaca catatan kepemilikan layanan node. Coba lagi setelah memeriksa LaunchAgent node."}},"pl":{"stringUnit":{"state":"translated","value":"OpenClaw nie może odczytać rekordu właściciela usługi węzła. Sprawdź LaunchAgent usługi węzła i spróbuj ponownie."}},"th":{"stringUnit":{"state":"translated","value":"OpenClaw ไม่สามารถอ่านบันทึกความเป็นเจ้าของบริการโหนดได้. ลองอีกครั้งหลังจากตรวจสอบ LaunchAgent ของโหนด."}},"vi":{"stringUnit":{"state":"translated","value":"OpenClaw không thể đọc bản ghi quyền sở hữu dịch vụ nút. Hãy thử lại sau khi kiểm tra LaunchAgent của nút."}},"nl":{"stringUnit":{"state":"translated","value":"OpenClaw kon de eigendomsregistratie van de nodeservice niet lezen. Probeer het opnieuw nadat je de node LaunchAgent hebt gecontroleerd."}},"fa":{"stringUnit":{"state":"translated","value":"OpenClaw نتوانست رکورد مالکیت سرویس گره را بخواند. پس از بررسی LaunchAgent مربوط به گره دوباره تلاش کنید."}},"ru":{"stringUnit":{"state":"translated","value":"OpenClaw не удалось прочитать запись о владельце службы узла. Проверьте LaunchAgent для узла и повторите попытку."}},"sv":{"stringUnit":{"state":"translated","value":"OpenClaw kunde inte läsa ägarinformationen för nodtjänsten. Försök igen efter att ha kontrollerat nodens LaunchAgent."}}}},
    "OpenClaw couldn’t be installed in Applications. Move it there manually, then open that copy.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenClaw couldn’t be installed in Applications. Move it there manually, then open that copy."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法将 OpenClaw 安装到“应用程序”文件夹。请手动将其移到该文件夹，然后打开其中的副本。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw 無法安裝至「應用程式」. 請手動將其移至該處，再開啟該副本。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível instalar o OpenClaw em Aplicativos. Mova-o para lá manualmente e abra essa cópia."}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw konnte nicht im Ordner „Programme“ installiert werden. Verschieben Sie die App manuell dorthin und öffnen Sie dann diese Kopie."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo instalar OpenClaw en Aplicaciones. Muévelo allí manualmente y luego abre esa copia."}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClawをアプリケーションフォルダにインストールできませんでした。手動で移動してから、移動先のアプリを開いてください。"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw를 응용 프로그램 폴더에 설치하지 못했습니다. 수동으로 해당 폴더로 옮긴 다음, 옮긴 앱을 여세요."}},"fr":{"stringUnit":{"state":"translated","value":"OpenClaw n’a pas pu être installé dans Applications. Déplacez-le manuellement dans ce dossier, puis ouvrez cette copie."}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw को Applications में इंस्टॉल नहीं किया जा सका. इसे मैन्युअल रूप से वहाँ ले जाएँ, फिर उस कॉपी को खोलें."}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر تثبيت OpenClaw في مجلد التطبيقات. انقله إلى هناك يدويًا، ثم افتح تلك النسخة."}},"it":{"stringUnit":{"state":"translated","value":"Non è stato possibile installare OpenClaw in Applicazioni. Spostalo manualmente in quella cartella, quindi apri quella copia."}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw, Uygulamalar klasörüne yüklenemedi. Elle bu klasöre taşıyın, ardından oradaki kopyayı açın."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося встановити OpenClaw у папку «Програми». Перемістіть його туди вручну, а потім відкрийте цю копію."}},"id":{"stringUnit":{"state":"translated","value":"OpenClaw tidak dapat diinstal di Aplikasi. Pindahkan secara manual ke sana, lalu buka salinan tersebut."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się zainstalować OpenClaw w folderze Aplikacje. Przenieś aplikację tam ręcznie, a następnie otwórz tę kopię."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถติดตั้ง OpenClaw ใน Applications ได้. ย้ายแอปไปที่นั่นด้วยตนเอง แล้วเปิดสำเนานั้น."}},"vi":{"stringUnit":{"state":"translated","value":"Không thể cài đặt OpenClaw vào thư mục Ứng dụng. Hãy di chuyển ứng dụng vào đó theo cách thủ công, rồi mở bản sao đó."}},"nl":{"stringUnit":{"state":"translated","value":"OpenClaw kon niet in Apps worden geïnstalleerd. Verplaats de app daar handmatig naartoe en open vervolgens die kopie."}},"fa":{"stringUnit":{"state":"translated","value":"OpenClaw در Applications نصب نشد. آن را به‌صورت دستی به آنجا منتقل کنید، سپس همان نسخه را باز کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось установить OpenClaw в папку «Программы». Переместите приложение туда вручную, затем откройте эту копию."}},"sv":{"stringUnit":{"state":"translated","value":"OpenClaw kunde inte installeras i Program. Flytta appen dit manuellt och öppna sedan den kopian."}}}},
    "OpenClaw installation failed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenClaw installation failed"}},"zh-CN":{"stringUnit":{"state":"translated","value":"OpenClaw 安装失败"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw 安裝失敗"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Falha na instalação do OpenClaw"}},"de":{"stringUnit":{"state":"translated","value":"Installation von OpenClaw fehlgeschlagen"}},"es":{"stringUnit":{"state":"translated","value":"La instalación de OpenClaw falló"}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClawのインストールに失敗しました"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw 설치 실패"}},"fr":{"stringUnit":{"state":"translated","value":"Échec de l’installation d’OpenClaw"}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw का इंस्टॉलेशन विफल रहा"}},"ar":{"stringUnit":{"state":"translated","value":"فشل تثبيت OpenClaw"}},"it":{"stringUnit":{"state":"translated","value":"Installazione di OpenClaw non riuscita"}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw kurulumu başarısız oldu"}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося встановити OpenClaw"}},"id":{"stringUnit":{"state":"translated","value":"Instalasi OpenClaw gagal"}},"pl":{"stringUnit":{"state":"translated","value":"Instalacja OpenClaw nie powiodła się"}},"th":{"stringUnit":{"state":"translated","value":"ติดตั้ง OpenClaw ไม่สำเร็จ"}},"vi":{"stringUnit":{"state":"translated","value":"Cài đặt OpenClaw thất bại"}},"nl":{"stringUnit":{"state":"translated","value":"Installatie van OpenClaw mislukt"}},"fa":{"stringUnit":{"state":"translated","value":"نصب OpenClaw ناموفق بود"}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось установить OpenClaw"}},"sv":{"stringUnit":{"state":"translated","value":"Installationen av OpenClaw misslyckades"}}}},
    "OpenClaw installed the update but could not verify the Gateway connection.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenClaw installed the update but could not verify the Gateway connection."}},"zh-CN":{"stringUnit":{"state":"translated","value":"OpenClaw 已安装更新，但无法验证 Gateway 连接。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw 已安裝更新，但無法驗證 Gateway 連線。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O OpenClaw instalou a atualização, mas não conseguiu verificar a conexão com o Gateway."}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw hat das Update installiert, konnte aber die Verbindung zum Gateway nicht überprüfen."}},"es":{"stringUnit":{"state":"translated","value":"OpenClaw instaló la actualización, pero no pudo verificar la conexión con el Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClawはアップデートをインストールしましたが、Gatewayへの接続を確認できませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw가 업데이트를 설치했지만 Gateway 연결을 확인하지 못했습니다."}},"fr":{"stringUnit":{"state":"translated","value":"OpenClaw a installé la mise à jour mais n’a pas pu vérifier la connexion au Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw ने अपडेट इंस्टॉल कर दिया, लेकिन Gateway कनेक्शन की पुष्टि नहीं कर सका।"}},"ar":{"stringUnit":{"state":"translated","value":"ثبّت OpenClaw التحديث لكنه لم يتمكن من التحقق من الاتصال بـ Gateway."}},"it":{"stringUnit":{"state":"translated","value":"OpenClaw ha installato l’aggiornamento ma non è riuscito a verificare la connessione al Gateway."}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw güncellemeyi yükledi ancak Gateway bağlantısını doğrulayamadı."}},"uk":{"stringUnit":{"state":"translated","value":"OpenClaw встановив оновлення, але не зміг перевірити з’єднання з Gateway."}},"id":{"stringUnit":{"state":"translated","value":"OpenClaw telah menginstal pembaruan tetapi tidak dapat memverifikasi koneksi Gateway."}},"pl":{"stringUnit":{"state":"translated","value":"OpenClaw zainstalował aktualizację, ale nie mógł zweryfikować połączenia z Gateway."}},"th":{"stringUnit":{"state":"translated","value":"OpenClaw ติดตั้งอัปเดตแล้ว แต่ไม่สามารถตรวจสอบการเชื่อมต่อ Gateway ได้."}},"vi":{"stringUnit":{"state":"translated","value":"OpenClaw đã cài đặt bản cập nhật nhưng không thể xác minh kết nối Gateway."}},"nl":{"stringUnit":{"state":"translated","value":"OpenClaw heeft de update geïnstalleerd, maar kon de verbinding met de Gateway niet verifiëren."}},"fa":{"stringUnit":{"state":"translated","value":"OpenClaw به‌روزرسانی را نصب کرد اما نتوانست اتصال به Gateway را تأیید کند."}},"ru":{"stringUnit":{"state":"translated","value":"OpenClaw установил обновление, но не смог проверить подключение к Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"OpenClaw installerade uppdateringen men kunde inte verifiera anslutningen till Gateway."}}}},
    "OpenClaw is completing provider sign-in.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenClaw is completing provider sign-in."}},"zh-CN":{"stringUnit":{"state":"translated","value":"OpenClaw 正在完成提供商登录。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw 正在完成供應商登入。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O OpenClaw está concluindo o login no provedor."}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw schließt die Anmeldung beim Anbieter ab."}},"es":{"stringUnit":{"state":"translated","value":"OpenClaw está completando el inicio de sesión con el proveedor."}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClawはプロバイダーへのサインインを完了しています。"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw가 제공업체 로그인을 완료하고 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"OpenClaw finalise la connexion au fournisseur."}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw प्रदाता में साइन-इन पूरा कर रहा है।"}},"ar":{"stringUnit":{"state":"translated","value":"يُكمل OpenClaw تسجيل الدخول إلى المزوّد."}},"it":{"stringUnit":{"state":"translated","value":"OpenClaw sta completando l’accesso al provider."}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw, sağlayıcı oturum açma işlemini tamamlıyor."}},"uk":{"stringUnit":{"state":"translated","value":"OpenClaw завершує вхід до облікового запису постачальника."}},"id":{"stringUnit":{"state":"translated","value":"OpenClaw sedang menyelesaikan proses masuk ke penyedia."}},"pl":{"stringUnit":{"state":"translated","value":"OpenClaw kończy logowanie u dostawcy."}},"th":{"stringUnit":{"state":"translated","value":"OpenClaw กำลังดำเนินการลงชื่อเข้าใช้ผู้ให้บริการให้เสร็จสมบูรณ์."}},"vi":{"stringUnit":{"state":"translated","value":"OpenClaw đang hoàn tất đăng nhập vào nhà cung cấp."}},"nl":{"stringUnit":{"state":"translated","value":"OpenClaw rondt de aanmelding bij de provider af."}},"fa":{"stringUnit":{"state":"translated","value":"OpenClaw در حال تکمیل ورود به حساب ارائه‌دهنده است."}},"ru":{"stringUnit":{"state":"translated","value":"OpenClaw завершает вход в учётную запись провайдера."}},"sv":{"stringUnit":{"state":"translated","value":"OpenClaw slutför inloggningen hos leverantören."}}}},
    "OpenClaw is installed in Applications, but couldn’t reopen automatically. Open it there manually.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenClaw is installed in Applications, but couldn’t reopen automatically. Open it there manually."}},"zh-CN":{"stringUnit":{"state":"translated","value":"OpenClaw 已安装到“应用程序”，但无法自动重新打开。请在那里手动打开它。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw 已安裝於「應用程式」，但無法自動重新開啟。請前往該處手動開啟。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O OpenClaw está instalado em Aplicativos, mas não conseguiu reabrir automaticamente. Abra-o manualmente nessa pasta."}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw ist im Ordner „Programme“ installiert, konnte aber nicht automatisch erneut geöffnet werden. Öffnen Sie es dort manuell."}},"es":{"stringUnit":{"state":"translated","value":"OpenClaw está instalado en Aplicaciones, pero no pudo volver a abrirse automáticamente. Ábrelo allí manualmente."}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClawはアプリケーションフォルダにインストールされていますが、自動で再起動できませんでした。 そこから手動で開いてください。"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw가 응용 프로그램 폴더에 설치되었지만 자동으로 다시 열리지 않았습니다. 해당 폴더에서 직접 열어 주세요."}},"fr":{"stringUnit":{"state":"translated","value":"OpenClaw est installé dans Applications, mais n’a pas pu se rouvrir automatiquement. Ouvrez-le manuellement depuis ce dossier."}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw, Applications में इंस्टॉल है, लेकिन अपने आप दोबारा नहीं खुल सका। उसे वहाँ से मैन्युअल रूप से खोलें।"}},"ar":{"stringUnit":{"state":"translated","value":"تم تثبيت OpenClaw في مجلد التطبيقات، لكن تعذّر فتحه مجددًا تلقائيًا. افتحه من هناك يدويًا."}},"it":{"stringUnit":{"state":"translated","value":"OpenClaw è installato in Applicazioni, ma non è stato possibile riaprirlo automaticamente. Aprilo manualmente da lì."}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw, Uygulamalar klasörüne yüklendi ancak otomatik olarak yeniden açılamadı. Uygulamayı oradan elle açın."}},"uk":{"stringUnit":{"state":"translated","value":"OpenClaw встановлено в папці «Програми», але не вдалося повторно відкрити його автоматично. Відкрийте його звідти вручну."}},"id":{"stringUnit":{"state":"translated","value":"OpenClaw telah diinstal di Applications, tetapi tidak dapat dibuka kembali secara otomatis. Buka secara manual dari sana."}},"pl":{"stringUnit":{"state":"translated","value":"OpenClaw jest zainstalowany w folderze Aplikacje, ale nie udało się go automatycznie ponownie otworzyć. Otwórz go stamtąd ręcznie."}},"th":{"stringUnit":{"state":"translated","value":"ติดตั้ง OpenClaw ในโฟลเดอร์แอปพลิเคชันแล้ว แต่ไม่สามารถเปิดอีกครั้งโดยอัตโนมัติได้. โปรดเปิดด้วยตนเองจากโฟลเดอร์นั้น."}},"vi":{"stringUnit":{"state":"translated","value":"OpenClaw đã được cài đặt trong Applications nhưng không thể tự động mở lại. Hãy mở ứng dụng thủ công tại đó."}},"nl":{"stringUnit":{"state":"translated","value":"OpenClaw is geïnstalleerd in Apps, maar kon niet automatisch opnieuw worden geopend. Open het daar handmatig."}},"fa":{"stringUnit":{"state":"translated","value":"OpenClaw در Applications نصب شده است، اما نتوانست به‌طور خودکار دوباره باز شود. آن را از همان‌جا به‌صورت دستی باز کنید."}},"ru":{"stringUnit":{"state":"translated","value":"OpenClaw установлен в папке «Программы», но не удалось открыть его повторно автоматически. Откройте его оттуда вручную."}},"sv":{"stringUnit":{"state":"translated","value":"OpenClaw är installerat i Program, men kunde inte öppnas igen automatiskt. Öppna det där manuellt."}}}},
    "OpenClaw is paused": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenClaw is paused"}},"zh-CN":{"stringUnit":{"state":"translated","value":"OpenClaw 已暂停"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw 已暫停"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O OpenClaw está pausado"}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw ist pausiert"}},"es":{"stringUnit":{"state":"translated","value":"OpenClaw está en pausa"}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClawは一時停止中です"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw가 일시 정지 상태입니다"}},"fr":{"stringUnit":{"state":"translated","value":"OpenClaw est en pause"}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw रुका हुआ है"}},"ar":{"stringUnit":{"state":"translated","value":"OpenClaw متوقف مؤقتًا"}},"it":{"stringUnit":{"state":"translated","value":"OpenClaw è in pausa"}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw duraklatılmış durumda"}},"uk":{"stringUnit":{"state":"translated","value":"Роботу OpenClaw призупинено"}},"id":{"stringUnit":{"state":"translated","value":"OpenClaw sedang dijeda"}},"pl":{"stringUnit":{"state":"translated","value":"OpenClaw jest wstrzymany"}},"th":{"stringUnit":{"state":"translated","value":"OpenClaw หยุดทำงานชั่วคราวอยู่"}},"vi":{"stringUnit":{"state":"translated","value":"OpenClaw đang tạm dừng"}},"nl":{"stringUnit":{"state":"translated","value":"OpenClaw is gepauzeerd"}},"fa":{"stringUnit":{"state":"translated","value":"OpenClaw موقتاً متوقف است"}},"ru":{"stringUnit":{"state":"translated","value":"Работа OpenClaw приостановлена"}},"sv":{"stringUnit":{"state":"translated","value":"OpenClaw är pausat"}}}},
    "OpenClaw is preparing a local model.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenClaw is preparing a local model."}},"zh-CN":{"stringUnit":{"state":"translated","value":"OpenClaw 正在准备本地模型。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw 正在準備本機模型。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O OpenClaw está preparando um modelo local."}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw bereitet ein lokales Modell vor."}},"es":{"stringUnit":{"state":"translated","value":"OpenClaw está preparando un modelo local."}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClawはローカルモデルを準備しています。"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw가 로컬 모델을 준비하고 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"OpenClaw prépare un modèle local."}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw एक स्थानीय मॉडल तैयार कर रहा है।"}},"ar":{"stringUnit":{"state":"translated","value":"يُعدّ OpenClaw نموذجًا محليًا."}},"it":{"stringUnit":{"state":"translated","value":"OpenClaw sta preparando un modello locale."}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw yerel bir model hazırlıyor."}},"uk":{"stringUnit":{"state":"translated","value":"OpenClaw готує локальну модель."}},"id":{"stringUnit":{"state":"translated","value":"OpenClaw sedang menyiapkan model lokal."}},"pl":{"stringUnit":{"state":"translated","value":"OpenClaw przygotowuje model lokalny."}},"th":{"stringUnit":{"state":"translated","value":"OpenClaw กำลังเตรียมโมเดลในเครื่อง."}},"vi":{"stringUnit":{"state":"translated","value":"OpenClaw đang chuẩn bị một mô hình cục bộ."}},"nl":{"stringUnit":{"state":"translated","value":"OpenClaw bereidt een lokaal model voor."}},"fa":{"stringUnit":{"state":"translated","value":"OpenClaw در حال آماده‌سازی یک مدل محلی است."}},"ru":{"stringUnit":{"state":"translated","value":"OpenClaw подготавливает локальную модель."}},"sv":{"stringUnit":{"state":"translated","value":"OpenClaw förbereder en lokal modell."}}}},
    "OpenClaw is working…": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenClaw is working…"}},"zh-CN":{"stringUnit":{"state":"translated","value":"OpenClaw 正在处理…"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw 正在處理…"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O OpenClaw está trabalhando…"}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw arbeitet…"}},"es":{"stringUnit":{"state":"translated","value":"OpenClaw está trabajando…"}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClawが処理中です…"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw가 작업 중입니다…"}},"fr":{"stringUnit":{"state":"translated","value":"OpenClaw travaille…"}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw काम कर रहा है…"}},"ar":{"stringUnit":{"state":"translated","value":"OpenClaw يعمل…"}},"it":{"stringUnit":{"state":"translated","value":"OpenClaw è in funzione…"}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw çalışıyor…"}},"uk":{"stringUnit":{"state":"translated","value":"OpenClaw працює…"}},"id":{"stringUnit":{"state":"translated","value":"OpenClaw sedang bekerja…"}},"pl":{"stringUnit":{"state":"translated","value":"OpenClaw pracuje…"}},"th":{"stringUnit":{"state":"translated","value":"OpenClaw กำลังทำงาน…"}},"vi":{"stringUnit":{"state":"translated","value":"OpenClaw đang xử lý…"}},"nl":{"stringUnit":{"state":"translated","value":"OpenClaw is bezig…"}},"fa":{"stringUnit":{"state":"translated","value":"OpenClaw در حال کار است…"}},"ru":{"stringUnit":{"state":"translated","value":"OpenClaw работает…"}},"sv":{"stringUnit":{"state":"translated","value":"OpenClaw arbetar…"}}}},
    "OpenClaw needs attention": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenClaw needs attention"}},"zh-CN":{"stringUnit":{"state":"translated","value":"OpenClaw 需要关注"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw 需要您留意"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O OpenClaw precisa de atenção"}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw benötigt Aufmerksamkeit"}},"es":{"stringUnit":{"state":"translated","value":"OpenClaw requiere atención"}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClawで対応が必要です"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw에 주의가 필요합니다"}},"fr":{"stringUnit":{"state":"translated","value":"OpenClaw nécessite votre attention"}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw पर ध्यान देने की ज़रूरत है"}},"ar":{"stringUnit":{"state":"translated","value":"يحتاج OpenClaw إلى انتباهك"}},"it":{"stringUnit":{"state":"translated","value":"OpenClaw richiede attenzione"}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw ilgilenmenizi gerektiriyor"}},"uk":{"stringUnit":{"state":"translated","value":"OpenClaw потребує уваги"}},"id":{"stringUnit":{"state":"translated","value":"OpenClaw memerlukan perhatian"}},"pl":{"stringUnit":{"state":"translated","value":"OpenClaw wymaga uwagi"}},"th":{"stringUnit":{"state":"translated","value":"OpenClaw ต้องการการดูแล"}},"vi":{"stringUnit":{"state":"translated","value":"OpenClaw cần được chú ý"}},"nl":{"stringUnit":{"state":"translated","value":"OpenClaw heeft aandacht nodig"}},"fa":{"stringUnit":{"state":"translated","value":"OpenClaw به توجه نیاز دارد"}},"ru":{"stringUnit":{"state":"translated","value":"OpenClaw требует внимания"}},"sv":{"stringUnit":{"state":"translated","value":"OpenClaw behöver uppmärksamhet"}}}},
    "OpenClaw only asks for macOS capabilities when a feature needs them.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenClaw only asks for macOS capabilities when a feature needs them."}},"zh-CN":{"stringUnit":{"state":"translated","value":"OpenClaw 仅在功能需要时才会请求使用 macOS 功能的权限。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw 只會在功能需要時，才要求使用 macOS 功能的權限。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O OpenClaw só solicita acesso aos recursos do macOS quando uma funcionalidade precisa deles."}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw fordert macOS-Berechtigungen nur an, wenn eine Funktion sie benötigt."}},"es":{"stringUnit":{"state":"translated","value":"OpenClaw solo solicita acceso a las capacidades de macOS cuando una función las necesita."}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClawは、機能に必要な場合にのみmacOSの権限を要求します。"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw는 기능에 필요한 경우에만 macOS 권한을 요청합니다."}},"fr":{"stringUnit":{"state":"translated","value":"OpenClaw ne demande l’accès aux capacités de macOS que lorsqu’une fonctionnalité en a besoin."}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw केवल तभी macOS की क्षमताओं के उपयोग की अनुमति माँगता है, जब किसी सुविधा को उनकी ज़रूरत होती है।"}},"ar":{"stringUnit":{"state":"translated","value":"لا يطلب OpenClaw صلاحيات macOS إلا عندما تحتاج إليها إحدى الميزات."}},"it":{"stringUnit":{"state":"translated","value":"OpenClaw richiede l’accesso alle funzionalità di macOS solo quando una funzione ne ha bisogno."}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw, macOS yeteneklerine erişimi yalnızca bir özellik bunlara ihtiyaç duyduğunda ister."}},"uk":{"stringUnit":{"state":"translated","value":"OpenClaw запитує доступ до можливостей macOS лише тоді, коли вони потрібні певній функції."}},"id":{"stringUnit":{"state":"translated","value":"OpenClaw hanya meminta akses ke kapabilitas macOS saat suatu fitur memerlukannya."}},"pl":{"stringUnit":{"state":"translated","value":"OpenClaw prosi o dostęp do funkcji systemu macOS tylko wtedy, gdy są potrzebne."}},"th":{"stringUnit":{"state":"translated","value":"OpenClaw จะขอใช้ความสามารถของ macOS เฉพาะเมื่อฟีเจอร์จำเป็นต้องใช้เท่านั้น."}},"vi":{"stringUnit":{"state":"translated","value":"OpenClaw chỉ yêu cầu quyền sử dụng các chức năng của macOS khi một tính năng cần đến chúng."}},"nl":{"stringUnit":{"state":"translated","value":"OpenClaw vraagt alleen om toegang tot macOS-functies wanneer een functie deze nodig heeft."}},"fa":{"stringUnit":{"state":"translated","value":"OpenClaw فقط زمانی دسترسی به قابلیت‌های macOS را درخواست می‌کند که یک ویژگی به آن‌ها نیاز داشته باشد."}},"ru":{"stringUnit":{"state":"translated","value":"OpenClaw запрашивает доступ к возможностям macOS только тогда, когда они нужны для работы функции."}},"sv":{"stringUnit":{"state":"translated","value":"OpenClaw ber bara om åtkomst till macOS-funktioner när en funktion behöver dem."}}}},
    "OpenClaw paused": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenClaw paused"}},"zh-CN":{"stringUnit":{"state":"translated","value":"OpenClaw 已暂停"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw 已暫停"}},"pt-BR":{"stringUnit":{"state":"translated","value":"OpenClaw pausado"}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw pausiert"}},"es":{"stringUnit":{"state":"translated","value":"OpenClaw en pausa"}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClaw は一時停止中"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw 일시 정지됨"}},"fr":{"stringUnit":{"state":"translated","value":"OpenClaw en pause"}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw रुका हुआ है"}},"ar":{"stringUnit":{"state":"translated","value":"تم إيقاف OpenClaw مؤقتًا"}},"it":{"stringUnit":{"state":"translated","value":"OpenClaw in pausa"}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw duraklatıldı"}},"uk":{"stringUnit":{"state":"translated","value":"OpenClaw призупинено"}},"id":{"stringUnit":{"state":"translated","value":"OpenClaw dijeda"}},"pl":{"stringUnit":{"state":"translated","value":"OpenClaw wstrzymany"}},"th":{"stringUnit":{"state":"translated","value":"OpenClaw หยุดทำงานชั่วคราวแล้ว"}},"vi":{"stringUnit":{"state":"translated","value":"OpenClaw đã tạm dừng"}},"nl":{"stringUnit":{"state":"translated","value":"OpenClaw gepauzeerd"}},"fa":{"stringUnit":{"state":"translated","value":"OpenClaw متوقف شده است"}},"ru":{"stringUnit":{"state":"translated","value":"OpenClaw приостановлен"}},"sv":{"stringUnit":{"state":"translated","value":"OpenClaw pausat"}}}},
    "OpenClaw project root": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenClaw project root"}},"zh-CN":{"stringUnit":{"state":"translated","value":"OpenClaw 项目根目录"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw 專案根目錄"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Diretório raiz do projeto OpenClaw"}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw-Projektstammverzeichnis"}},"es":{"stringUnit":{"state":"translated","value":"Directorio raíz del proyecto OpenClaw"}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClawプロジェクトルート"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw 프로젝트 루트"}},"fr":{"stringUnit":{"state":"translated","value":"Racine du projet OpenClaw"}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw प्रोजेक्ट की मूल डायरेक्टरी"}},"ar":{"stringUnit":{"state":"translated","value":"المجلد الجذر لمشروع OpenClaw"}},"it":{"stringUnit":{"state":"translated","value":"Directory radice del progetto OpenClaw"}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw proje kök dizini"}},"uk":{"stringUnit":{"state":"translated","value":"Кореневий каталог проєкту OpenClaw"}},"id":{"stringUnit":{"state":"translated","value":"Direktori akar proyek OpenClaw"}},"pl":{"stringUnit":{"state":"translated","value":"Katalog główny projektu OpenClaw"}},"th":{"stringUnit":{"state":"translated","value":"โฟลเดอร์รากของโปรเจกต์ OpenClaw"}},"vi":{"stringUnit":{"state":"translated","value":"Thư mục gốc dự án OpenClaw"}},"nl":{"stringUnit":{"state":"translated","value":"Hoofdmap van het OpenClaw-project"}},"fa":{"stringUnit":{"state":"translated","value":"پوشهٔ ریشهٔ پروژهٔ OpenClaw"}},"ru":{"stringUnit":{"state":"translated","value":"Корневая папка проекта OpenClaw"}},"sv":{"stringUnit":{"state":"translated","value":"Projektrot för OpenClaw"}}}},
    "OpenClaw reacts when any trigger appears in a transcription. Keep phrases short to avoid false positives.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenClaw reacts when any trigger appears in a transcription. Keep phrases short to avoid false positives."}},"zh-CN":{"stringUnit":{"state":"translated","value":"转录文本中出现任何触发词时，OpenClaw 都会响应。请使用简短的短语，以避免误触发。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"只要轉錄文字中出現任何觸發詞，OpenClaw 就會回應。請使用簡短詞句，以避免誤判。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O OpenClaw reage quando qualquer gatilho aparece em uma transcrição. Use frases curtas para evitar falsos positivos."}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw reagiert, sobald ein Auslöser in einer Transkription vorkommt. Halten Sie die Formulierungen kurz, um Fehlauslösungen zu vermeiden."}},"es":{"stringUnit":{"state":"translated","value":"OpenClaw reacciona cuando aparece cualquier activador en una transcripción. Usa frases cortas para evitar falsos positivos."}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClawは、文字起こしにいずれかのトリガーが含まれると反応します。 誤検出を避けるため、フレーズは短くしてください。"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw는 음성 전사에 트리거가 하나라도 나타나면 반응합니다. 잘못 감지되지 않도록 문구를 짧게 유지하세요."}},"fr":{"stringUnit":{"state":"translated","value":"OpenClaw réagit dès qu’un déclencheur apparaît dans une transcription. Utilisez des expressions courtes pour éviter les faux positifs."}},"hi":{"stringUnit":{"state":"translated","value":"ट्रांसक्रिप्शन में कोई भी ट्रिगर आने पर OpenClaw प्रतिक्रिया देता है। गलत सक्रियण से बचने के लिए वाक्यांश छोटे रखें।"}},"ar":{"stringUnit":{"state":"translated","value":"يستجيب OpenClaw عند ظهور أي عبارة تفعيل في النص المُفرّغ. اجعل العبارات قصيرة لتجنّب التفعيل الخاطئ."}},"it":{"stringUnit":{"state":"translated","value":"OpenClaw reagisce quando un qualsiasi trigger compare in una trascrizione. Usa frasi brevi per evitare falsi positivi."}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw, konuşma dökümünde herhangi bir tetikleyici göründüğünde tepki verir. Yanlış algılamaları önlemek için ifadeleri kısa tutun."}},"uk":{"stringUnit":{"state":"translated","value":"OpenClaw реагує, коли в транскрипції з’являється будь-який тригер. Використовуйте короткі фрази, щоб уникнути хибних спрацьовувань."}},"id":{"stringUnit":{"state":"translated","value":"OpenClaw bereaksi saat pemicu apa pun muncul dalam transkripsi. Gunakan frasa singkat untuk menghindari deteksi keliru."}},"pl":{"stringUnit":{"state":"translated","value":"OpenClaw reaguje, gdy w transkrypcji pojawi się dowolna fraza wyzwalająca. Używaj krótkich fraz, aby uniknąć fałszywych wykryć."}},"th":{"stringUnit":{"state":"translated","value":"OpenClaw จะตอบสนองเมื่อมีคำกระตุ้นใดๆ ปรากฏในข้อความที่ถอดเสียง. ใช้วลีสั้นๆ เพื่อหลีกเลี่ยงการตรวจจับผิดพลาด."}},"vi":{"stringUnit":{"state":"translated","value":"OpenClaw phản hồi khi có bất kỳ cụm từ kích hoạt nào xuất hiện trong bản chép lời. Hãy dùng các cụm từ ngắn để tránh kích hoạt nhầm."}},"nl":{"stringUnit":{"state":"translated","value":"OpenClaw reageert wanneer een trigger in een transcriptie voorkomt. Houd zinnen kort om onterechte activering te voorkomen."}},"fa":{"stringUnit":{"state":"translated","value":"OpenClaw هر زمان که محرکی در متن پیاده‌شده ظاهر شود، واکنش نشان می‌دهد. برای جلوگیری از تشخیص‌های نادرست، عبارت‌ها را کوتاه نگه دارید."}},"ru":{"stringUnit":{"state":"translated","value":"OpenClaw реагирует на появление любого триггера в расшифровке. Используйте короткие фразы, чтобы избежать ложных срабатываний."}},"sv":{"stringUnit":{"state":"translated","value":"OpenClaw reagerar när någon utlösande fras förekommer i en transkription. Håll fraserna korta för att undvika falska träffar."}}}},
    "OpenClaw runs": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenClaw runs"}},"zh-CN":{"stringUnit":{"state":"translated","value":"OpenClaw 运行"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw 執行中"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O OpenClaw está em execução"}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw läuft"}},"es":{"stringUnit":{"state":"translated","value":"OpenClaw se ejecuta"}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClawが実行されます"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw 실행 중"}},"fr":{"stringUnit":{"state":"translated","value":"OpenClaw s’exécute"}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw चलता है"}},"ar":{"stringUnit":{"state":"translated","value":"يعمل OpenClaw"}},"it":{"stringUnit":{"state":"translated","value":"OpenClaw è in esecuzione"}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw çalışır"}},"uk":{"stringUnit":{"state":"translated","value":"OpenClaw працює"}},"id":{"stringUnit":{"state":"translated","value":"OpenClaw berjalan"}},"pl":{"stringUnit":{"state":"translated","value":"OpenClaw działa"}},"th":{"stringUnit":{"state":"translated","value":"OpenClaw ทำงาน"}},"vi":{"stringUnit":{"state":"translated","value":"OpenClaw đang chạy"}},"nl":{"stringUnit":{"state":"translated","value":"OpenClaw draait"}},"fa":{"stringUnit":{"state":"translated","value":"OpenClaw اجرا می‌شود"}},"ru":{"stringUnit":{"state":"translated","value":"OpenClaw работает"}},"sv":{"stringUnit":{"state":"translated","value":"OpenClaw körs"}}}},
    "OpenClaw starts and monitors the Gateway on this Mac.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenClaw starts and monitors the Gateway on this Mac."}},"zh-CN":{"stringUnit":{"state":"translated","value":"OpenClaw 在这台 Mac 上启动并监控 Gateway。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw 會在這部 Mac 上啟動並監控 Gateway。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O OpenClaw inicia e monitora o Gateway neste Mac."}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw startet und überwacht das Gateway auf diesem Mac."}},"es":{"stringUnit":{"state":"translated","value":"OpenClaw inicia y supervisa el Gateway en este Mac."}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClawは、このMacでGatewayを起動し、監視します。"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw는 이 Mac에서 Gateway를 시작하고 모니터링합니다."}},"fr":{"stringUnit":{"state":"translated","value":"OpenClaw démarre et surveille le Gateway sur ce Mac."}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw इस Mac पर Gateway शुरू करता है और उसकी निगरानी करता है।"}},"ar":{"stringUnit":{"state":"translated","value":"يشغّل OpenClaw خدمة Gateway ويراقبها على جهاز Mac هذا."}},"it":{"stringUnit":{"state":"translated","value":"OpenClaw avvia e monitora il Gateway su questo Mac."}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw, bu Mac'te Gateway'i başlatır ve izler."}},"uk":{"stringUnit":{"state":"translated","value":"OpenClaw запускає Gateway на цьому Mac і стежить за його роботою."}},"id":{"stringUnit":{"state":"translated","value":"OpenClaw memulai dan memantau Gateway di Mac ini."}},"pl":{"stringUnit":{"state":"translated","value":"OpenClaw uruchamia i monitoruje Gateway na tym Macu."}},"th":{"stringUnit":{"state":"translated","value":"OpenClaw เริ่มต้นและตรวจสอบ Gateway บน Mac เครื่องนี้."}},"vi":{"stringUnit":{"state":"translated","value":"OpenClaw khởi động và giám sát Gateway trên máy Mac này."}},"nl":{"stringUnit":{"state":"translated","value":"OpenClaw start en bewaakt de Gateway op deze Mac."}},"fa":{"stringUnit":{"state":"translated","value":"OpenClaw، Gateway را در این Mac راه‌اندازی و بر آن نظارت می‌کند."}},"ru":{"stringUnit":{"state":"translated","value":"OpenClaw запускает Gateway на этом Mac и следит за его работой."}},"sv":{"stringUnit":{"state":"translated","value":"OpenClaw startar och övervakar Gateway på den här Mac-datorn."}}}},
    "OpenClaw updated": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenClaw updated"}},"zh-CN":{"stringUnit":{"state":"translated","value":"OpenClaw 已更新"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw 已更新"}},"pt-BR":{"stringUnit":{"state":"translated","value":"OpenClaw atualizado"}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw aktualisiert"}},"es":{"stringUnit":{"state":"translated","value":"OpenClaw actualizado"}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClawが更新されました"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw 업데이트 완료"}},"fr":{"stringUnit":{"state":"translated","value":"OpenClaw mis à jour"}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw अपडेट हो गया"}},"ar":{"stringUnit":{"state":"translated","value":"تم تحديث OpenClaw"}},"it":{"stringUnit":{"state":"translated","value":"OpenClaw aggiornato"}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw güncellendi"}},"uk":{"stringUnit":{"state":"translated","value":"OpenClaw оновлено"}},"id":{"stringUnit":{"state":"translated","value":"OpenClaw diperbarui"}},"pl":{"stringUnit":{"state":"translated","value":"OpenClaw zaktualizowany"}},"th":{"stringUnit":{"state":"translated","value":"อัปเดต OpenClaw แล้ว"}},"vi":{"stringUnit":{"state":"translated","value":"OpenClaw đã được cập nhật"}},"nl":{"stringUnit":{"state":"translated","value":"OpenClaw bijgewerkt"}},"fa":{"stringUnit":{"state":"translated","value":"OpenClaw به‌روزرسانی شد"}},"ru":{"stringUnit":{"state":"translated","value":"OpenClaw обновлён"}},"sv":{"stringUnit":{"state":"translated","value":"OpenClaw har uppdaterats"}}}},
    "OpenClaw was interrupted. Restart to try again.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenClaw was interrupted. Restart to try again."}},"zh-CN":{"stringUnit":{"state":"translated","value":"OpenClaw 已中断。请重启后重试。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw 已中斷。請重新啟動以再試一次。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O OpenClaw foi interrompido. Reinicie para tentar novamente."}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw wurde unterbrochen. Starte OpenClaw neu, um es erneut zu versuchen."}},"es":{"stringUnit":{"state":"translated","value":"OpenClaw se interrumpió. Reinícialo para volver a intentarlo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClawが中断されました。再起動してもう一度お試しください。"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw가 중단되었습니다. 다시 시작하여 재시도하세요."}},"fr":{"stringUnit":{"state":"translated","value":"OpenClaw a été interrompu. Redémarrez pour réessayer."}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw बाधित हो गया था। फिर से प्रयास करने के लिए पुनः शुरू करें।"}},"ar":{"stringUnit":{"state":"translated","value":"توقف OpenClaw بشكل غير متوقع. أعد تشغيله للمحاولة مرة أخرى."}},"it":{"stringUnit":{"state":"translated","value":"OpenClaw è stato interrotto. Riavvia per riprovare."}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw kesintiye uğradı. Tekrar denemek için yeniden başlatın."}},"uk":{"stringUnit":{"state":"translated","value":"Роботу OpenClaw перервано. Перезапустіть, щоб спробувати ще раз."}},"id":{"stringUnit":{"state":"translated","value":"OpenClaw terhenti. Mulai ulang untuk mencoba lagi."}},"pl":{"stringUnit":{"state":"translated","value":"Działanie OpenClaw zostało przerwane. Uruchom ponownie, aby spróbować jeszcze raz."}},"th":{"stringUnit":{"state":"translated","value":"OpenClaw ถูกขัดจังหวะ. เริ่มใหม่เพื่อลองอีกครั้ง."}},"vi":{"stringUnit":{"state":"translated","value":"OpenClaw đã bị gián đoạn. Khởi động lại để thử lại."}},"nl":{"stringUnit":{"state":"translated","value":"OpenClaw is onderbroken. Start opnieuw om het nogmaals te proberen."}},"fa":{"stringUnit":{"state":"translated","value":"اجرای OpenClaw متوقف شد. برای تلاش مجدد، آن را دوباره راه‌اندازی کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Работа OpenClaw была прервана. Перезапустите приложение, чтобы повторить попытку."}},"sv":{"stringUnit":{"state":"translated","value":"OpenClaw avbröts. Starta om för att försöka igen."}}}},
    "OpenClaw will check again before changing any inference settings.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenClaw will check again before changing any inference settings."}},"zh-CN":{"stringUnit":{"state":"translated","value":"OpenClaw 会在更改任何推理设置之前再次确认。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw 會在變更任何推論設定前再次確認。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O OpenClaw verificará novamente antes de alterar qualquer configuração de inferência."}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw prüft erneut, bevor Inferenzeinstellungen geändert werden."}},"es":{"stringUnit":{"state":"translated","value":"OpenClaw volverá a comprobarlo antes de cambiar cualquier ajuste de inferencia."}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClawは、推論設定を変更する前に再度確認します。"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw는 추론 설정을 변경하기 전에 다시 확인합니다."}},"fr":{"stringUnit":{"state":"translated","value":"OpenClaw effectuera une nouvelle vérification avant de modifier les paramètres d’inférence."}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw किसी भी इन्फ़रेंस सेटिंग को बदलने से पहले फिर से जाँच करेगा।"}},"ar":{"stringUnit":{"state":"translated","value":"سيتحقق OpenClaw مرة أخرى قبل تغيير أي إعدادات للاستدلال."}},"it":{"stringUnit":{"state":"translated","value":"OpenClaw verificherà di nuovo prima di modificare qualsiasi impostazione di inferenza."}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw, herhangi bir çıkarım ayarını değiştirmeden önce tekrar kontrol edecek."}},"uk":{"stringUnit":{"state":"translated","value":"OpenClaw виконає повторну перевірку перед зміною будь-яких налаштувань інференсу."}},"id":{"stringUnit":{"state":"translated","value":"OpenClaw akan memeriksa lagi sebelum mengubah pengaturan inferensi apa pun."}},"pl":{"stringUnit":{"state":"translated","value":"OpenClaw sprawdzi ponownie przed zmianą jakichkolwiek ustawień wnioskowania."}},"th":{"stringUnit":{"state":"translated","value":"OpenClaw จะตรวจสอบอีกครั้งก่อนเปลี่ยนการตั้งค่าการอนุมานใดๆ."}},"vi":{"stringUnit":{"state":"translated","value":"OpenClaw sẽ kiểm tra lại trước khi thay đổi bất kỳ cài đặt suy luận nào."}},"nl":{"stringUnit":{"state":"translated","value":"OpenClaw controleert opnieuw voordat inferentie-instellingen worden gewijzigd."}},"fa":{"stringUnit":{"state":"translated","value":"OpenClaw پیش از تغییر هرگونه تنظیمات استنتاج، دوباره بررسی خواهد کرد."}},"ru":{"stringUnit":{"state":"translated","value":"OpenClaw выполнит повторную проверку перед изменением любых настроек инференса."}},"sv":{"stringUnit":{"state":"translated","value":"OpenClaw frågar igen innan några inferensinställningar ändras."}}}},
    "OpenClaw will copy itself to Applications and reopen there so updates and launch at login stay reliable.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenClaw will copy itself to Applications and reopen there so updates and launch at login stay reliable."}},"zh-CN":{"stringUnit":{"state":"translated","value":"OpenClaw 会将自身复制到“应用程序”文件夹并在那里重新打开，以确保更新和登录时启动功能正常运行。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw 會將自身複製到「應用程式」並從該處重新開啟，以確保更新及登入時啟動功能正常運作。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O OpenClaw copiará a si mesmo para Aplicativos e será reaberto de lá para manter as atualizações e a inicialização ao iniciar sessão funcionando de forma confiável."}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw kopiert sich selbst in den Ordner Programme und öffnet sich dort erneut, damit Updates und der Start bei der Anmeldung zuverlässig funktionieren."}},"es":{"stringUnit":{"state":"translated","value":"OpenClaw se copiará a Aplicaciones y volverá a abrirse desde allí para garantizar que las actualizaciones y el inicio al iniciar sesión funcionen de forma fiable."}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClawは、アップデートとログイン時の起動が確実に行われるように、自身をアプリケーションフォルダにコピーし、そこから再度開きます。"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw는 업데이트와 로그인 시 실행이 안정적으로 작동하도록 응용 프로그램 폴더에 자신을 복사한 후 해당 위치에서 다시 실행됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"OpenClaw se copiera dans Applications et s’y rouvrira pour garantir la fiabilité des mises à jour et du lancement à l’ouverture de session."}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw स्वयं को Applications में कॉपी करेगा और वहीं फिर से खुलेगा ताकि अपडेट और लॉगिन पर लॉन्च विश्वसनीय बने रहें।"}},"ar":{"stringUnit":{"state":"translated","value":"سينسخ OpenClaw نفسه إلى مجلد التطبيقات ويعيد فتح نفسه من هناك لضمان موثوقية التحديثات والتشغيل عند تسجيل الدخول."}},"it":{"stringUnit":{"state":"translated","value":"OpenClaw si copierà nella cartella Applicazioni e si riaprirà da lì per garantire l'affidabilità degli aggiornamenti e dell'avvio al login."}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw, güncellemelerin ve oturum açıldığında başlatmanın güvenilir şekilde çalışması için kendisini Uygulamalar klasörüne kopyalayıp oradan yeniden açılacak."}},"uk":{"stringUnit":{"state":"translated","value":"OpenClaw скопіює себе до папки «Програми» та знову відкриється звідти, щоб оновлення й запуск під час входу в систему працювали надійно."}},"id":{"stringUnit":{"state":"translated","value":"OpenClaw akan menyalin dirinya ke Applications dan membuka kembali dari sana agar pembaruan dan peluncuran saat login tetap berjalan dengan andal."}},"pl":{"stringUnit":{"state":"translated","value":"OpenClaw skopiuje się do folderu Aplikacje i uruchomi się z niego ponownie, aby zapewnić niezawodne aktualizacje i uruchamianie przy logowaniu."}},"th":{"stringUnit":{"state":"translated","value":"OpenClaw จะคัดลอกตัวเองไปยัง Applications และเปิดใหม่จากที่นั่น เพื่อให้การอัปเดตและการเปิดเมื่อเข้าสู่ระบบทำงานได้อย่างเชื่อถือได้."}},"vi":{"stringUnit":{"state":"translated","value":"OpenClaw sẽ tự sao chép vào Applications và mở lại tại đó để đảm bảo việc cập nhật và khởi chạy khi đăng nhập luôn ổn định."}},"nl":{"stringUnit":{"state":"translated","value":"OpenClaw kopieert zichzelf naar Apps en opent daar opnieuw, zodat updates en starten bij inloggen betrouwbaar blijven werken."}},"fa":{"stringUnit":{"state":"translated","value":"OpenClaw خود را در Applications کپی می‌کند و از آنجا دوباره باز می‌شود تا به‌روزرسانی‌ها و اجرا هنگام ورود به سیستم همچنان قابل‌اعتماد باشند."}},"ru":{"stringUnit":{"state":"translated","value":"OpenClaw скопирует себя в папку «Программы» и запустится оттуда, чтобы обеспечить надёжную работу обновлений и запуска при входе в систему."}},"sv":{"stringUnit":{"state":"translated","value":"OpenClaw kopierar sig till Program och öppnas igen där så att uppdateringar och start vid inloggning fortsätter att fungera tillförlitligt."}}}},
    "Opens image preview": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Opens image preview"}},"zh-CN":{"stringUnit":{"state":"translated","value":"打开图片预览"}},"zh-TW":{"stringUnit":{"state":"translated","value":"開啟圖片預覽"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Abre a pré-visualização da imagem"}},"de":{"stringUnit":{"state":"translated","value":"Öffnet die Bildvorschau"}},"es":{"stringUnit":{"state":"translated","value":"Abre la vista previa de la imagen"}},"ja-JP":{"stringUnit":{"state":"translated","value":"画像プレビューを開きます"}},"ko":{"stringUnit":{"state":"translated","value":"이미지 미리 보기 열기"}},"fr":{"stringUnit":{"state":"translated","value":"Ouvre l’aperçu de l’image"}},"hi":{"stringUnit":{"state":"translated","value":"छवि का पूर्वावलोकन खोलता है"}},"ar":{"stringUnit":{"state":"translated","value":"يفتح معاينة الصورة"}},"it":{"stringUnit":{"state":"translated","value":"Apre l'anteprima dell'immagine"}},"tr":{"stringUnit":{"state":"translated","value":"Görsel önizlemesini açar"}},"uk":{"stringUnit":{"state":"translated","value":"Відкриває попередній перегляд зображення"}},"id":{"stringUnit":{"state":"translated","value":"Membuka pratinjau gambar"}},"pl":{"stringUnit":{"state":"translated","value":"Otwiera podgląd obrazu"}},"th":{"stringUnit":{"state":"translated","value":"เปิดตัวอย่างรูปภาพ"}},"vi":{"stringUnit":{"state":"translated","value":"Mở bản xem trước hình ảnh"}},"nl":{"stringUnit":{"state":"translated","value":"Opent het afbeeldingsvoorbeeld"}},"fa":{"stringUnit":{"state":"translated","value":"پیش‌نمایش تصویر را باز می‌کند"}},"ru":{"stringUnit":{"state":"translated","value":"Открывает предварительный просмотр изображения"}},"sv":{"stringUnit":{"state":"translated","value":"Öppnar förhandsvisning av bilden"}}}},
