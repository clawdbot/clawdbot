    "Gateway auto-starts in local mode via launchd (%@).": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Gateway auto-starts in local mode via launchd (%@)."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Gateway 在本地模式下通过 launchd (%@) 自动启动。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 透過 launchd (%@) 在本機模式下自動啟動。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Gateway inicia automaticamente no modo local via launchd (%@)."}},"de":{"stringUnit":{"state":"translated","value":"Das Gateway startet im lokalen Modus automatisch über launchd (%@)."}},"es":{"stringUnit":{"state":"translated","value":"Gateway se inicia automáticamente en modo local mediante launchd (%@)."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gateway は launchd (%@) 経由でローカルモードで自動起動します。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway는 launchd (%@)를 통해 로컬 모드에서 자동으로 시작됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Gateway démarre automatiquement en mode local via launchd (%@)."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway स्थानीय मोड में launchd (%@) के ज़रिए अपने आप शुरू होता है।"}},"ar":{"stringUnit":{"state":"translated","value":"يبدأ Gateway تلقائيًا في الوضع المحلي عبر launchd (%@)."}},"it":{"stringUnit":{"state":"translated","value":"Gateway si avvia automaticamente in modalità locale tramite launchd (%@)."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway, yerel modda launchd (%@) aracılığıyla otomatik başlar."}},"uk":{"stringUnit":{"state":"translated","value":"Gateway автоматично запускається в локальному режимі через launchd (%@)."}},"id":{"stringUnit":{"state":"translated","value":"Gateway dimulai otomatis dalam mode lokal melalui launchd (%@)."}},"pl":{"stringUnit":{"state":"translated","value":"Gateway uruchamia się automatycznie w trybie lokalnym przez launchd (%@)."}},"th":{"stringUnit":{"state":"translated","value":"Gateway เริ่มทำงานอัตโนมัติในโหมดภายในเครื่องผ่าน launchd (