    "Copy cookies from %@ into an isolated agent profile. Passwords are never touched.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Copy cookies from %@ into an isolated agent profile. Passwords are never touched."}},"zh-CN":{"stringUnit":{"state":"translated","value":"将 Cookie 从 %@ 复制到隔离的智能体配置文件中。绝不会访问密码。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"將 Cookie 從 %@ 複製到隔離的代理程式設定檔。 絕不存取密碼。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Copie cookies de %@ para um perfil isolado do agente. As senhas nunca são acessadas."}},"de":{"stringUnit":{"state":"translated","value":"Cookies aus %@ in ein isoliertes Agentenprofil kopieren. Passwörter bleiben stets unberührt."}},"es":{"stringUnit":{"state":"translated","value":"Copiar cookies de %@ a un perfil de agente aislado. Las contraseñas nunca se modifican."}},"ja-JP":{"stringUnit":{"state":"translated","value":"%@ から分離されたエージェントプロファイルに Cookie をコピーします。パスワードには一切アクセスしません。"}},"ko":{"stringUnit":{"state":"translated","value":"%@의 쿠키를 격리된 에이전트 프로필로 복사합니다. 비밀번호는 전혀 건드리지 않습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Copier les cookies de %@ dans un profil d’agent isolé. Les mots de passe ne sont jamais modifiés."}},"hi":{"stringUnit":{"state":"translated","value":"%@ से कुकीज़ को एक अलग एजेंट प्रोफ़ाइल में कॉपी करें. पासवर्ड को कभी भी छुआ नहीं जाता है."}},"ar":{"stringUnit":{"state":"translated","value":"نسخ ملفات تعريف الارتباط من %@ إلى ملف تعريف معزول للوكيل. لا يتم الوصول إلى كلمات المرور مطلقًا."}},"it":{"stringUnit":{"state":"translated","value":"Copia i cookie da %@ in un profilo isolato dell'agente. Le password non vengono mai toccate."}},"tr":{"stringUnit":{"state":"translated","value":"%@ kaynağındaki çerezleri yalıtılmış bir ajan profiline kopyalayın. Parolalara asla dokunulmaz."}},"uk":{"stringUnit":{"state":"translated","value":"Копіювати файли cookie з %@ в ізольований профіль агента. Паролі ніколи не зачіпаються."}},"id":{"stringUnit":{"state":"translated","value":"Salin cookie dari %@ ke profil agen yang terisolasi. Kata sandi tidak pernah disentuh."}},"pl":{"stringUnit":{"state":"translated","value":"Kopiuj pliki cookie z %@ do odizolowanego profilu agenta. Hasła nigdy nie są odczytywane ani modyfikowane."}},"th":{"stringUnit":{"state":"translated","value":"คัดลอกคุกกี้จาก %@ ไปยังโปรไฟล์เอเจนต์ที่แยกไว้. จะไม่มีการเข้าถึงรหัสผ่านใดๆ."}},"vi":{"stringUnit":{"state":"translated","value":"Sao chép cookie từ %@ vào một hồ sơ tác nhân riêng biệt. Mật khẩu không bao giờ bị truy cập hay thay đổi."}},"nl":{"stringUnit":{"state":"translated","value":"Kopieer cookies van %@ naar een geïsoleerd agentprofiel. Wachtwoorden blijven altijd onaangeroerd."}},"fa":{"stringUnit":{"state":"translated","value":"کوکی‌ها را از %@ به یک نمایهٔ ایزولهٔ عامل کپی کنید. گذرواژه‌ها هرگز دست‌کاری نمی‌شوند."}},"ru":{"stringUnit":{"state":"translated","value":"Скопируйте файлы cookie из %@ в изолированный профиль агента. Пароли никогда не затрагиваются."}},"sv":{"stringUnit":{"state":"translated","value":"Kopiera cookies från %@ till en isolerad agentprofil. Lösenord berörs aldrig."}}}},
    "Copy cookies from a Chrome-family profile into an isolated managed profile.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Copy cookies from a Chrome-family profile into an isolated managed profile."}},"zh-CN":{"stringUnit":{"state":"translated","value":"将 Cookie 从 Chrome 系浏览器配置文件复制到隔离的托管配置文件中。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"將 Cookie 從 Chrome 系列瀏覽器的設定檔複製到隔離的受管理設定檔。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Copie cookies de um perfil de navegador da família Chrome para um perfil gerenciado isolado."}},"de":{"stringUnit":{"state":"translated","value":"Cookies aus einem Profil der Chrome-Familie in ein isoliertes, verwaltetes Profil kopieren."}},"es":{"stringUnit":{"state":"translated","value":"Copiar cookies de un perfil de un navegador de la familia Chrome a un perfil administrado aislado."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Chrome 系ブラウザのプロファイルから分離された管理対象プロファイルに Cookie をコピーします。"}},"ko":{"stringUnit":{"state":"translated","value":"Chrome 계열 프로필의 쿠키를 격리된 관리형 프로필로 복사합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Copier les cookies d’un profil de navigateur de la famille Chrome dans un profil géré isolé."}},"hi":{"stringUnit":{"state":"translated","value":"Chrome-परिवार की प्रोफ़ाइल से कुकीज़ को एक अलग प्रबंधित प्रोफ़ाइल में कॉपी करें."}},"ar":{"stringUnit":{"state":"translated","value":"نسخ ملفات تعريف الارتباط من ملف تعريف لمتصفح من عائلة Chrome إلى ملف تعريف مُدار ومعزول."}},"it":{"stringUnit":{"state":"translated","value":"Copia i cookie da un profilo di un browser della famiglia Chrome in un profilo gestito isolato."}},"tr":{"stringUnit":{"state":"translated","value":"Chrome ailesinden bir profildeki çerezleri yalıtılmış, yönetilen bir profile kopyalayın."}},"uk":{"stringUnit":{"state":"translated","value":"Копіювати файли cookie з профілю браузера сімейства Chrome в ізольований керований профіль."}},"id":{"stringUnit":{"state":"translated","value":"Salin cookie dari profil keluarga Chrome ke profil terkelola yang terisolasi."}},"pl":{"stringUnit":{"state":"translated","value":"Kopiuj pliki cookie z profilu przeglądarki z rodziny Chrome do odizolowanego profilu zarządzanego."}},"th":{"stringUnit":{"state":"translated","value":"คัดลอกคุกกี้จากโปรไฟล์เบราว์เซอร์ในตระกูล Chrome ไปยังโปรไฟล์ที่มีการจัดการซึ่งแยกไว้."}},"vi":{"stringUnit":{"state":"translated","value":"Sao chép cookie từ một hồ sơ trình duyệt thuộc họ Chrome vào một hồ sơ được quản lý riêng biệt."}},"nl":{"stringUnit":{"state":"translated","value":"Kopieer cookies van een profiel uit de Chrome-familie naar een geïsoleerd beheerd profiel."}},"fa":{"stringUnit":{"state":"translated","value":"کوکی‌ها را از یک نمایهٔ مرورگرهای خانوادهٔ Chrome به یک نمایهٔ مدیریت‌شدهٔ ایزوله کپی کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Скопируйте файлы cookie из профиля браузера семейства Chrome в изолированный управляемый профиль."}},"sv":{"stringUnit":{"state":"translated","value":"Kopiera cookies från en profil i Chrome-familjen till en isolerad hanterad profil."}}}},
