    "Reopen OpenClaw to retry the embedded CUA daemon.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reopen OpenClaw to retry the embedded CUA daemon."}},"zh-CN":{"stringUnit":{"state":"translated","value":"重新打开 OpenClaw 以重试内嵌 CUA 守护进程。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"重新開啟 OpenClaw 以重試內嵌 CUA 常駐程式。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Reabra o OpenClaw para tentar novamente o daemon CUA incorporado."}},"de":{"stringUnit":{"state":"translated","value":"Öffne OpenClaw erneut, um den eingebetteten CUA-Daemon erneut zu versuchen."}},"es":{"stringUnit":{"state":"translated","value":"Vuelve a abrir OpenClaw para reintentar el daemon CUA integrado."}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClawを再度開いて、組み込みのCUAデーモンを再試行してください。"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw를 다시 열어 내장된 CUA 데몬을 재시도하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Rouvrez OpenClaw pour réessayer le démon CUA intégré."}},"hi":{"stringUnit":{"state":"translated","value":"एम्बेडेड CUA डेमन को पुनः प्रयास करने के लिए OpenClaw फिर से खोलें।"}},"ar":{"stringUnit":{"state":"translated","value":"أعد فتح OpenClaw لإعادة محاولة خدمة CUA المضمّنة."}},"it":{"stringUnit":{"state":"translated","value":"Riapri OpenClaw per riprovare il daemon CUA integrato."}},"tr":{"stringUnit":{"state":"translated","value":"Gömülü CUA arka plan sürecini yeniden denemek için OpenClaw'ı yeniden açın."}},"uk":{"stringUnit":{"state":"translated","value":"Перезапустіть OpenClaw, щоб повторити спробу з вбудованим демоном CUA."}},"id":{"stringUnit":{"state":"translated","value":"Buka kembali OpenClaw untuk mencoba lagi daemon CUA yang tertanam."}},"pl":{"stringUnit":{"state":"translated","value":"Otwórz ponownie OpenClaw, aby ponowić próbę uruchomienia wbudowanego demona CUA."}},"th":{"stringUnit":{"state":"translated","value":"เปิด OpenClaw ใหม่เพื่อลองใช้ CUA daemon แบบฝังตัวอีกครั้ง"}},"vi":{"stringUnit":{"state":"translated","value":"Mở lại OpenClaw để thử lại daemon CUA nhúng."}},"nl":{"stringUnit":{"state":"translated","value":"Open OpenClaw opnieuw om de ingebedde CUA-daemon opnieuw te proberen."}},"fa":{"stringUnit":{"state":"translated","value":"برای تلاش مجدد دیمن CUA تعبیه‌شده، OpenClaw را دوباره باز کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Откройте OpenClaw заново, чтобы повторить попытку со встроенным демоном CUA."}},"sv":{"stringUnit":{"state":"translated","value":"Öppna OpenClaw igen för att försöka med den inbäddade CUA-daemonen på nytt."}}}},
