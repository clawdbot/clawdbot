    "Peek at the stored conversation buckets the CLI reuses for context and rate limits.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Peek at the stored conversation buckets the CLI reuses for context and rate limits."}},"zh-CN":{"stringUnit":{"state":"translated","value":"查看 CLI 为上下文和速率限制复用的已存储对话桶。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"查看 CLI 針對上下文和速率限制重複使用的已儲存對話儲存桶。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Veja os buckets de conversas armazenados que a CLI reutiliza para contexto e limites de taxa."}},"de":{"stringUnit":{"state":"translated","value":"Einblick in die gespeicherten Konversations-Buckets, die die CLI für Kontext und Ratenbegrenzungen wiederverwendet."}},"es":{"stringUnit":{"state":"translated","value":"Echa un vistazo a los grupos de conversaciones almacenados que la CLI reutiliza para el contexto y los límites de frecuencia."}},"ja-JP":{"stringUnit":{"state":"translated","value":"CLI がコンテキストとレート制限に再利用する保存済みの会話バケットを確認します。"}},"ko":{"stringUnit":{"state":"translated","value":"CLI가 컨텍스트와 속도 제한에 재사용하는 저장된 대화 버킷을 살펴봅니다."}},"fr":{"stringUnit":{"state":"translated","value":"Consultez les compartiments de conversations stockés que la CLI réutilise pour le contexte et les limites de débit."}},"hi":{"stringUnit":{"state":"translated","value":"संदर्भ और रेट सीमाओं के लिए CLI द्वारा फिर से उपयोग की जाने वाली संग्रहीत बातचीत बकेट्स पर एक नज़र डालें।"}},"ar":{"stringUnit":{"state":"translated","value":"ألقِ نظرة على حاويات المحادثات المخزّنة التي تعيد CLI استخدامها للسياق وحدود المعدل."}},"it":{"stringUnit":{"state":"translated","value":"Dai un’occhiata ai bucket di conversazioni salvati che la CLI riutilizza per contesto e limiti di frequenza."}},"tr":{"stringUnit":{"state":"translated","value":"CLI'ın bağlam ve hız sınırları için yeniden kullandığı depolanmış konuşma kümelerine göz atın."}},"uk":{"stringUnit":{"state":"translated","value":"Перегляньте збережені кошики розмов, які CLI повторно використовує для контексту та лімітів частоти."}},"id":{"stringUnit":{"state":"translated","value":"Intip bucket percakapan tersimpan yang digunakan kembali oleh CLI untuk konteks dan batas laju."}},"pl":{"stringUnit":{"state":"translated","value":"Zajrzyj do zapisanych zasobników konwersacji, których CLI ponownie używa na potrzeby kontekstu i limitów szybkości."}},"th":{"stringUnit":{"state":"translated","value":"ดูบัคเก็ตการสนทนาที่จัดเก็บไว้ ซึ่ง CLI นำกลับมาใช้ซ้ำสำหรับบริบทและขีดจำกัดอัตรา"}},"vi":{"stringUnit":{"state":"translated","value":"Xem nhanh các nhóm hội thoại đã lưu mà CLI tái sử dụng cho ngữ cảnh và giới hạn tốc độ."}},"nl":{"stringUnit":{"state":"translated","value":"Bekijk de opgeslagen gespreksbuckets die de CLI opnieuw gebruikt voor context en snelheidslimieten."}},"fa":{"stringUnit":{"state":"translated","value":"نگاهی به سطل‌های مکالمهٔ ذخیره‌شده بیندازید که CLI برای زمینه و محدودیت‌های نرخ دوباره استفاده می‌کند."}},"ru":{"stringUnit":{"state":"translated","value":"Просматривайте сохраненные группы разговоров, которые CLI повторно использует для контекста и ограничений частоты."}},"sv":{"stringUnit":{"state":"translated","value":"Titta på de lagrade konversationsbuckets som CLI återanvänder för kontext och hastighetsbegränsningar."}}}},
    "Pending": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Pending"}},"zh-CN":{"stringUnit":{"state":"translated","value":"待处理"}},"zh-TW":{"stringUnit":{"state":"translated","value":"待處理"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Pendente"}},"de":{"stringUnit":{"state":"translated","value":"Ausstehend"}},"es":{"stringUnit":{"state":"translated","value":"Pendiente"}},"ja-JP":{"stringUnit":{"state":"translated","value":"保留中"}},"ko":{"stringUnit":{"state":"translated","value":"대기 중"}},"fr":{"stringUnit":{"state":"translated","value":"En attente"}},"hi":{"stringUnit":{"state":"translated","value":"लंबित"}},"ar":{"stringUnit":{"state":"translated","value":"قيد الانتظار"}},"it":{"stringUnit":{"state":"translated","value":"In sospeso"}},"tr":{"stringUnit":{"state":"translated","value":"Beklemede"}},"uk":{"stringUnit":{"state":"translated","value":"Очікує"}},"id":{"stringUnit":{"state":"translated","value":"Menunggu"}},"pl":{"stringUnit":{"state":"translated","value":"Oczekujące"}},"th":{"stringUnit":{"state":"translated","value":"รอดำเนินการ"}},"vi":{"stringUnit":{"state":"translated","value":"Đang chờ"}},"nl":{"stringUnit":{"state":"translated","value":"In behandeling"}},"fa":{"stringUnit":{"state":"translated","value":"در انتظار"}},"ru":{"stringUnit":{"state":"translated","value":"Ожидание"}},"sv":{"stringUnit":{"state":"translated","value":"Väntande"}}}},
    "Permissions": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Permissions"}},"zh-CN":{"stringUnit":{"state":"translated","value":"权限"}},"zh-TW":{"stringUnit":{"state":"translated","value":"權限"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Permissões"}},"de":{"stringUnit":{"state":"translated","value":"Berechtigungen"}},"es":{"stringUnit":{"state":"translated","value":"Permisos"}},"ja-JP":{"stringUnit":{"state":"translated","value":"権限"}},"ko":{"stringUnit":{"state":"translated","value":"권한"}},"fr":{"stringUnit":{"state":"translated","value":"Autorisations"}},"hi":{"stringUnit":{"state":"translated","value":"अनुमतियाँ"}},"ar":{"stringUnit":{"state":"translated","value":"الأذونات"}},"it":{"stringUnit":{"state":"translated","value":"Autorizzazioni"}},"tr":{"stringUnit":{"state":"translated","value":"İzinler"}},"uk":{"stringUnit":{"state":"translated","value":"Дозволи"}},"id":{"stringUnit":{"state":"translated","value":"Izin"}},"pl":{"stringUnit":{"state":"translated","value":"Uprawnienia"}},"th":{"stringUnit":{"state":"translated","value":"สิทธิ์การอนุญาต"}},"vi":{"stringUnit":{"state":"translated","value":"Quyền"}},"nl":{"stringUnit":{"state":"translated","value":"Machtigingen"}},"fa":{"stringUnit":{"state":"translated","value":"مجوزها"}},"ru":{"stringUnit":{"state":"translated","value":"Разрешения"}},"sv":{"stringUnit":{"state":"translated","value":"Behörigheter"}}}},
    "Persistent Mac node service unavailable under app profile; runtime node remains available.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Persistent Mac node service unavailable under app profile; runtime node remains available."}},"zh-CN":{"stringUnit":{"state":"translated","value":"应用配置文件下无法使用持久性 Mac 节点服务；运行时节点仍然可用。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"在應用程式設定檔下無法使用持續性 Mac 節點服務；執行階段節點仍然可用。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O serviço de nó persistente do Mac não está disponível no perfil do app; o nó de runtime permanece disponível."}},"de":{"stringUnit":{"state":"translated","value":"Persistenter Mac-Node-Dienst unter App-Profil nicht verfügbar; Laufzeit-Node bleibt verfügbar."}},"es":{"stringUnit":{"state":"translated","value":"El servicio de nodo persistente de Mac no está disponible con un perfil de aplicación; el nodo en tiempo de ejecución sigue disponible."}},"ja-JP":{"stringUnit":{"state":"translated","value":"アプリプロファイル使用中は永続的なMacノードサービスを利用できません。ランタイムノードは引き続き利用可能です。"}},"ko":{"stringUnit":{"state":"translated","value":"앱 프로필에서는 영구 Mac 노드 서비스를 사용할 수 없습니다. 런타임 노드는 계속 사용할 수 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le service de nœud Mac persistant n’est pas disponible sous un profil d’application ; le nœud d’exécution reste disponible."}},"hi":{"stringUnit":{"state":"translated","value":"ऐप प्रोफ़ाइल के अंतर्गत स्थायी Mac नोड सेवा उपलब्ध नहीं है; रनटाइम नोड उपलब्ध रहता है।"}},"ar":{"stringUnit":{"state":"translated","value":"خدمة عقدة Mac الدائمة غير متوفرة ضمن ملف تعريف التطبيق؛ تظل عقدة وقت التشغيل متاحة."}},"it":{"stringUnit":{"state":"translated","value":"Il servizio del nodo Mac persistente non è disponibile con il profilo dell'app; il nodo runtime resta disponibile."}},"tr":{"stringUnit":{"state":"translated","value":"Kalıcı Mac düğüm hizmeti uygulama profili altında kullanılamaz; çalışma zamanı düğümü kullanılabilir kalır."}},"uk":{"stringUnit":{"state":"translated","value":"Постійна служба вузла Mac недоступна під профілем застосунку; вузол середовища виконання залишається доступним."}},"id":{"stringUnit":{"state":"translated","value":"Layanan node Mac persisten tidak tersedia di bawah profil aplikasi; node runtime tetap tersedia."}},"pl":{"stringUnit":{"state":"translated","value":"Trwała usługa węzła Mac jest niedostępna w ramach profilu aplikacji; węzeł środowiska uruchomieniowego pozostaje dostępny."}},"th":{"stringUnit":{"state":"translated","value":"บริการ Mac node แบบถาวรไม่พร้อมใช้งานภายใต้โปรไฟล์แอป; runtime node ยังคงพร้อมใช้งาน"}},"vi":{"stringUnit":{"state":"translated","value":"Dịch vụ node Mac liên tục không khả dụng dưới hồ sơ ứng dụng; node runtime vẫn khả dụng."}},"nl":{"stringUnit":{"state":"translated","value":"Permanente Mac-nodeservice niet beschikbaar onder app-profiel; runtime-node blijft beschikbaar."}},"fa":{"stringUnit":{"state":"translated","value":"سرویس گره پایدار Mac تحت نمایه برنامه در دسترس نیست؛ گره زمان اجرا همچنان در دسترس است."}},"ru":{"stringUnit":{"state":"translated","value":"Постоянная служба узла Mac недоступна при профиле приложения; узел среды выполнения остаётся доступен."}},"sv":{"stringUnit":{"state":"translated","value":"Beständig Mac-nodtjänst är inte tillgänglig under appprofil; körtidsnoden är fortfarande tillgänglig."}}}},
    "Photo Library": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Photo Library"}},"zh-CN":{"stringUnit":{"state":"translated","value":"照片图库"}},"zh-TW":{"stringUnit":{"state":"translated","value":"照片圖庫"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Fototeca"}},"de":{"stringUnit":{"state":"translated","value":"Fotomediathek"}},"es":{"stringUnit":{"state":"translated","value":"Fototeca"}},"ja-JP":{"stringUnit":{"state":"translated","value":"写真ライブラリ"}},"ko":{"stringUnit":{"state":"translated","value":"사진 보관함"}},"fr":{"stringUnit":{"state":"translated","value":"Photothèque"}},"hi":{"stringUnit":{"state":"translated","value":"फ़ोटो लाइब्रेरी"}},"ar":{"stringUnit":{"state":"translated","value":"مكتبة الصور"}},"it":{"stringUnit":{"state":"translated","value":"Libreria foto"}},"tr":{"stringUnit":{"state":"translated","value":"Fotoğraf Arşivi"}},"uk":{"stringUnit":{"state":"translated","value":"Фототека"}},"id":{"stringUnit":{"state":"translated","value":"Perpustakaan Foto"}},"pl":{"stringUnit":{"state":"translated","value":"Biblioteka zdjęć"}},"th":{"stringUnit":{"state":"translated","value":"คลังรูปภาพ"}},"vi":{"stringUnit":{"state":"translated","value":"Thư viện ảnh"}},"nl":{"stringUnit":{"state":"translated","value":"Fotobibliotheek"}},"fa":{"stringUnit":{"state":"translated","value":"کتابخانه عکس"}},"ru":{"stringUnit":{"state":"translated","value":"Медиатека"}},"sv":{"stringUnit":{"state":"translated","value":"Bildbibliotek"}}}},
    "Pick Local or Remote in Settings → General whenever you’re ready.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Pick Local or Remote in Settings → General whenever you’re ready."}},"zh-CN":{"stringUnit":{"state":"translated","value":"准备好后，可随时在“设置 → 通用”中选择本地或远程。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"準備好時，可隨時在「設定」→「一般」中選擇本機或遠端。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolha Local ou Remoto em Ajustes → Geral quando estiver tudo pronto."}},"de":{"stringUnit":{"state":"translated","value":"Wähle in den Einstellungen → Allgemein „Lokal“ oder „Remote“, sobald du bereit bist."}},"es":{"stringUnit":{"state":"translated","value":"Elige Local o Remote en Ajustes → General cuando quieras."}},"ja-JP":{"stringUnit":{"state":"translated","value":"準備ができたら、Settings → General で Local または Remote を選択してください。"}},"ko":{"stringUnit":{"state":"translated","value":"준비되면 Settings → General에서 Local 또는 Remote를 선택하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez Local ou Remote dans Réglages → Général quand vous serez prêt."}},"hi":{"stringUnit":{"state":"translated","value":"जब भी आप तैयार हों, Settings → General में Local या Remote चुनें।"}},"ar":{"stringUnit":{"state":"translated","value":"اختر Local أو Remote في Settings → General عندما تكون جاهزًا."}},"it":{"stringUnit":{"state":"translated","value":"Scegli Local o Remote in Settings → General quando vuoi."}},"tr":{"stringUnit":{"state":"translated","value":"Hazır olduğunuzda Settings → General bölümünden Local veya Remote seçin."}},"uk":{"stringUnit":{"state":"translated","value":"Виберіть Local або Remote у Settings → General, коли будете готові."}},"id":{"stringUnit":{"state":"translated","value":"Pilih Local atau Remote di Settings → General kapan pun Anda siap."}},"pl":{"stringUnit":{"state":"translated","value":"Wybierz Local lub Remote w Ustawienia → General, gdy będziesz gotowe."}},"th":{"stringUnit":{"state":"translated","value":"เลือก Local หรือ Remote ใน Settings → General เมื่อคุณพร้อม"}},"vi":{"stringUnit":{"state":"translated","value":"Chọn Local hoặc Remote trong Settings → General bất cứ khi nào bạn sẵn sàng."}},"nl":{"stringUnit":{"state":"translated","value":"Kies Local of Remote in Settings → General wanneer je er klaar voor bent."}},"fa":{"stringUnit":{"state":"translated","value":"هر زمان آماده بودید، در Settings → General گزینهٔ Local یا Remote را انتخاب کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Выберите Local или Remote в Settings → General, когда будете готовы."}},"sv":{"stringUnit":{"state":"translated","value":"Välj Local eller Remote i Settings → General när du är redo."}}}},
    "Pick whether this app owns a local Gateway or attaches to another host.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Pick whether this app owns a local Gateway or attaches to another host."}},"zh-CN":{"stringUnit":{"state":"translated","value":"选择此应用是拥有本地 Gateway，还是连接到另一台主机。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"選擇此 app 要管理本機 Gateway，或連接至其他主機。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolha se este app possui um Gateway local ou se conecta a outro host."}},"de":{"stringUnit":{"state":"translated","value":"Wählen Sie aus, ob diese App eine lokale Gateway verwaltet oder sich mit einem anderen Host verbindet."}},"es":{"stringUnit":{"state":"translated","value":"Elige si esta app controla un Gateway local o se conecta a otro host."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このアプリがローカル Gateway を管理するか、別のホストに接続するかを選択します。"}},"ko":{"stringUnit":{"state":"translated","value":"이 앱이 로컬 Gateway를 소유할지, 다른 호스트에 연결할지 선택하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez si cette app possède un Gateway local ou se connecte à un autre hôte."}},"hi":{"stringUnit":{"state":"translated","value":"चुनें कि यह ऐप किसी लोकल Gateway का मालिक है या किसी दूसरे होस्ट से जुड़ता है।"}},"ar":{"stringUnit":{"state":"translated","value":"اختر ما إذا كان هذا التطبيق يملك Gateway محليًا أو يتصل بمضيف آخر."}},"it":{"stringUnit":{"state":"translated","value":"Scegli se questa app gestisce un Gateway locale o si collega a un altro host."}},"tr":{"stringUnit":{"state":"translated","value":"Bu uygulamanın yerel bir Gateway’e sahip olup olmayacağını veya başka bir ana makineye bağlanıp bağlanmayacağını seçin."}},"uk":{"stringUnit":{"state":"translated","value":"Виберіть, чи ця програма керує локальним Gateway, чи підключається до іншого хоста."}},"id":{"stringUnit":{"state":"translated","value":"Pilih apakah app ini memiliki Gateway lokal atau terhubung ke host lain."}},"pl":{"stringUnit":{"state":"translated","value":"Wybierz, czy ta aplikacja zarządza lokalnym Gateway, czy łączy się z innym hostem."}},"th":{"stringUnit":{"state":"translated","value":"เลือกว่าจะให้แอปนี้เป็นเจ้าของ Gateway ในเครื่องหรือเชื่อมต่อกับโฮสต์อื่น"}},"vi":{"stringUnit":{"state":"translated","value":"Chọn ứng dụng này sở hữu Gateway cục bộ hay gắn vào một máy chủ khác."}},"nl":{"stringUnit":{"state":"translated","value":"Kies of deze app een lokale Gateway beheert of verbinding maakt met een andere host."}},"fa":{"stringUnit":{"state":"translated","value":"انتخاب کنید این برنامه مالک یک Gateway محلی باشد یا به میزبان دیگری متصل شود."}},"ru":{"stringUnit":{"state":"translated","value":"Выберите, будет ли это приложение управлять локальным Gateway или подключаться к другому хосту."}},"sv":{"stringUnit":{"state":"translated","value":"Välj om den här appen äger en lokal Gateway eller ansluter till en annan värd."}}}},
