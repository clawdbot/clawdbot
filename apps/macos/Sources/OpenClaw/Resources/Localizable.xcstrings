    "Summarize the current OpenClaw status and tell me what needs attention.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Summarize the current OpenClaw status and tell me what needs attention."}},"zh-CN":{"stringUnit":{"state":"translated","value":"总结 OpenClaw 的当前状态，并告诉我哪些方面需要关注。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"摘要說明 OpenClaw 目前的狀態，並告訴我有哪些事項需要注意。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Resuma o status atual do OpenClaw e diga o que precisa de atenção."}},"de":{"stringUnit":{"state":"translated","value":"Fasse den aktuellen OpenClaw-Status zusammen und sage mir, was meine Aufmerksamkeit erfordert."}},"es":{"stringUnit":{"state":"translated","value":"Resume el estado actual de OpenClaw y dime qué requiere atención."}},"ja-JP":{"stringUnit":{"state":"translated","value":"現在のOpenClawのステータスを要約し、注意が必要な点を教えてください。"}},"ko":{"stringUnit":{"state":"translated","value":"현재 OpenClaw 상태를 요약하고 주의가 필요한 사항을 알려 주세요."}},"fr":{"stringUnit":{"state":"translated","value":"Résume l’état actuel d’OpenClaw et indique-moi ce qui nécessite mon attention."}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw की मौजूदा स्थिति का सारांश दें और बताएँ कि किन बातों पर ध्यान देने की आवश्यकता है।"}},"ar":{"stringUnit":{"state":"translated","value":"لخّص حالة OpenClaw الحالية وأخبرني بما يحتاج إلى اهتمام."}},"it":{"stringUnit":{"state":"translated","value":"Riepiloga lo stato attuale di OpenClaw e dimmi cosa richiede attenzione."}},"tr":{"stringUnit":{"state":"translated","value":"Mevcut OpenClaw durumunu özetle ve nelere dikkat edilmesi gerektiğini söyle."}},"uk":{"stringUnit":{"state":"translated","value":"Підсумуй поточний стан OpenClaw і скажи, що потребує уваги."}},"id":{"stringUnit":{"state":"translated","value":"Rangkum status OpenClaw saat ini dan beri tahu saya hal yang perlu diperhatikan."}},"pl":{"stringUnit":{"state":"translated","value":"Podsumuj bieżący stan OpenClaw i powiedz mi, co wymaga uwagi."}},"th":{"stringUnit":{"state":"translated","value":"สรุปสถานะปัจจุบันของ OpenClaw และบอกฉันว่ามีอะไรที่ต้องตรวจสอบ"}},"vi":{"stringUnit":{"state":"translated","value":"Tóm tắt trạng thái hiện tại của OpenClaw và cho tôi biết những vấn đề cần chú ý."}},"nl":{"stringUnit":{"state":"translated","value":"Vat de huidige OpenClaw-status samen en vertel me wat aandacht nodig heeft."}},"fa":{"stringUnit":{"state":"translated","value":"وضعیت فعلی OpenClaw را خلاصه کن و بگو چه مواردی نیاز به توجه دارند."}},"ru":{"stringUnit":{"state":"translated","value":"Кратко опиши текущее состояние OpenClaw и сообщи, что требует внимания."}},"sv":{"stringUnit":{"state":"translated","value":"Sammanfatta aktuell OpenClaw-status och berätta vad som behöver åtgärdas."}}}},
    "Summarize what happened in my threads since yesterday.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Summarize what happened in my threads since yesterday."}},"zh-CN":{"stringUnit":{"state":"translated","value":"总结自昨天以来我的话题串中发生的事情。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"摘要說明自昨天起我的討論串中發生的事情。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Resuma o que aconteceu nas minhas conversas desde ontem."}},"de":{"stringUnit":{"state":"translated","value":"Fasse zusammen, was seit gestern in meinen Threads passiert ist."}},"es":{"stringUnit":{"state":"translated","value":"Resume lo que ocurrió en mis hilos desde ayer."}},"ja-JP":{"stringUnit":{"state":"translated","value":"昨日以降、スレッドで起きたことを要約してください。"}},"ko":{"stringUnit":{"state":"translated","value":"어제 이후 내 스레드에서 있었던 일을 요약해 주세요."}},"fr":{"stringUnit":{"state":"translated","value":"Résumez ce qui s’est passé dans mes fils de discussion depuis hier."}},"hi":{"stringUnit":{"state":"translated","value":"कल से अब तक मेरी थ्रेड में जो हुआ, उसका सारांश दें।"}},"ar":{"stringUnit":{"state":"translated","value":"لخّص ما حدث في محادثاتي منذ الأمس."}},"it":{"stringUnit":{"state":"translated","value":"Riassumi ciò che è successo nei miei thread da ieri."}},"tr":{"stringUnit":{"state":"translated","value":"Dünden beri dizilerimde neler olduğunu özetle."}},"uk":{"stringUnit":{"state":"translated","value":"Підсумуй, що відбулося в моїх гілках від учора."}},"id":{"stringUnit":{"state":"translated","value":"Rangkum apa yang terjadi di utas saya sejak kemarin."}},"pl":{"stringUnit":{"state":"translated","value":"Podsumuj, co wydarzyło się w moich wątkach od wczoraj."}},"th":{"stringUnit":{"state":"translated","value":"สรุปสิ่งที่เกิดขึ้นในเธรดของฉันตั้งแต่เมื่อวาน"}},"vi":{"stringUnit":{"state":"translated","value":"Tóm tắt những gì đã xảy ra trong các chuỗi của tôi kể từ hôm qua."}},"nl":{"stringUnit":{"state":"translated","value":"Vat samen wat er sinds gisteren in mijn gesprekken is gebeurd."}},"fa":{"stringUnit":{"state":"translated","value":"آنچه از دیروز در رشته‌هایم رخ داده است را خلاصه کن."}},"ru":{"stringUnit":{"state":"translated","value":"Подведи итог событий в моих ветках со вчерашнего дня."}},"sv":{"stringUnit":{"state":"translated","value":"Sammanfatta vad som har hänt i mina trådar sedan i går."}}}},
