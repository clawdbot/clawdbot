    "Saved to openclaw.json under skills.entries.%@": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Saved to openclaw.json under skills.entries.%@"}},"zh-CN":{"stringUnit":{"state":"translated","value":"已保存到 openclaw.json 中的 skills.entries.%@"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已儲存至 openclaw.json 的 skills.entries.%@"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Salvo em openclaw.json em skills.entries.%@"}},"de":{"stringUnit":{"state":"translated","value":"In openclaw.json unter skills.entries.%@ gespeichert"}},"es":{"stringUnit":{"state":"translated","value":"Guardado en openclaw.json en skills.entries.%@"}},"ja-JP":{"stringUnit":{"state":"translated","value":"openclaw.json の skills.entries.%@ に保存しました"}},"ko":{"stringUnit":{"state":"translated","value":"openclaw.json의 skills.entries.%@에 저장됨"}},"fr":{"stringUnit":{"state":"translated","value":"Enregistré dans openclaw.json sous skills.entries.%@"}},"hi":{"stringUnit":{"state":"translated","value":"openclaw.json में skills.entries.%@ के अंतर्गत सहेजा गया"}},"ar":{"stringUnit":{"state":"translated","value":"تم الحفظ في openclaw.json ضمن skills.entries.%@"}},"it":{"stringUnit":{"state":"translated","value":"Salvato in openclaw.json sotto skills.entries.%@"}},"tr":{"stringUnit":{"state":"translated","value":"openclaw.json dosyasında skills.entries.%@ altında kaydedildi"}},"uk":{"stringUnit":{"state":"translated","value":"Збережено в openclaw.json у skills.entries.%@"}},"id":{"stringUnit":{"state":"translated","value":"Disimpan ke openclaw.json pada skills.entries.%@"}},"pl":{"stringUnit":{"state":"translated","value":"Zapisano w openclaw.json pod kluczem skills.entries.%@"}},"th":{"stringUnit":{"state":"translated","value":"บันทึกลงใน openclaw.json ภายใต้ skills.entries.%@ แล้ว"}},"vi":{"stringUnit":{"state":"translated","value":"Đã lưu vào openclaw.json tại skills.entries.%@"}},"nl":{"stringUnit":{"state":"translated","value":"Opgeslagen in openclaw.json onder skills.