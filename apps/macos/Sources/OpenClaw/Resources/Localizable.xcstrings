    "Allow this node’s capabilities?": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allow this node’s capabilities?"}},"zh-CN":{"stringUnit":{"state":"translated","value":"允许此节点的功能？"}},"zh-TW":{"stringUnit":{"state":"translated","value":"允許此節點的功能？"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Permitir os recursos deste nó?"}},"de":{"stringUnit":{"state":"translated","value":"Die Funktionen dieses Knotens erlauben?"}},"es":{"stringUnit":{"state":"translated","value":"¿Permitir las capacidades de este nodo?"}},"ja-JP":{"stringUnit":{"state":"translated","value":"このノードの機能を許可しますか？"}},"ko":{"stringUnit":{"state":"translated","value":"이 노드의 기능을 허용할까요?"}},"fr":{"stringUnit":{"state":"translated","value":"Autoriser les fonctionnalités de ce nœud ?"}},"hi":{"stringUnit":{"state":"translated","value":"इस नोड की क्षमताओं की अनुमति दें?"}},"ar":{"stringUnit":{"state":"translated","value":"هل تريد السماح بإمكانات هذه العقدة؟"}},"it":{"stringUnit":{"state":"translated","value":"Consentire le funzionalità di questo nodo?"}},"tr":{"stringUnit":{"state":"translated","value":"Bu düğümün yeteneklerine izin verilsin mi?"}},"uk":{"stringUnit":{"state":"translated","value":"Дозволити можливості цього вузла?"}},"id":{"stringUnit":{"state":"translated","value":"Izinkan kemampuan node ini?"}},"pl":{"stringUnit":{"state":"translated","value":"Zezwolić na korzystanie z funkcji tego węzła?"}},"th":{"stringUnit":{"state":"translated","value":"อนุญาตความสามารถของโหนดนี้หรือไม่?"}},"vi":{"stringUnit":{"state":"translated","value":"Cho phép các khả năng của nút này?"}},"nl":{"stringUnit":{"state":"translated","value":"De mogelijkheden van dit knooppunt toestaan?"}},"fa":{"stringUnit":{"state":"translated","value":"اجازه استفاده از قابلیت‌های این گره داده شود؟"}},"ru":{"stringUnit":{"state":"translated","value":"Разрешить возможности этого узла?"}},"sv":{"stringUnit":{"state":"translated","value":"Tillåt den här nodens funktioner?"}}}},
    "Allow trusted command patterns and handle misses with prompts.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allow trusted command patterns and handle misses with prompts."}},"zh-CN":{"stringUnit":{"state":"translated","value":"允许受信任的命令模式，并在未匹配时提示确认。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"允許受信任的指令模式，並在未符合模式時顯示提示。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Permitir padrões de comando confiáveis e solicitar confirmação quando não houver correspondência."}},"de":{"stringUnit":{"state":"translated","value":"Vertrauenswürdige Befehlsmuster erlauben und bei fehlenden Übereinstimmungen nachfragen."}},"es":{"stringUnit":{"state":"translated","value":"Permitir patrones de comandos de confianza y solicitar confirmación cuando no haya coincidencias."}},"ja-JP":{"stringUnit":{"state":"translated","value":"信頼できるコマンドパターンを許可し、一致しない場合は確認を求めます。"}},"ko":{"stringUnit":{"state":"translated","value":"신뢰할 수 있는 명령 패턴을 허용하고 일치하지 않는 경우 확인을 요청합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Autoriser les modèles de commandes de confiance et demander confirmation pour les autres."}},"hi":{"stringUnit":{"state":"translated","value":"विश्वसनीय कमांड पैटर्न की अनुमति दें और मेल न मिलने पर पुष्टि माँगें."}},"ar":{"stringUnit":{"state":"translated","value":"السماح بأنماط الأوامر الموثوقة وطلب التأكيد عند عدم وجود تطابق."}},"it":{"stringUnit":{"state":"translated","value":"Consenti i modelli di comando attendibili e richiedi conferma in caso di mancata corrispondenza."}},"tr":{"stringUnit":{"state":"translated","value":"Güvenilir komut kalıplarına izin verin ve eşleşmeyenler için onay isteyin."}},"uk":{"stringUnit":{"state":"translated","value":"Дозволяти команди за довіреними шаблонами й запитувати підтвердження, якщо збігів немає."}},"id":{"stringUnit":{"state":"translated","value":"Izinkan pola perintah tepercaya dan minta konfirmasi untuk perintah yang tidak cocok."}},"pl":{"stringUnit":{"state":"translated","value":"Zezwalaj n