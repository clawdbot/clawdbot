    "Checking CLI logins, saved API keys, and local model servers on the Gateway.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Checking CLI logins, saved API keys, and local model servers on the Gateway."}},"zh-CN":{"stringUnit":{"state":"translated","value":"正在检查网关上的 CLI 登录、已保存的 API 密钥和本地模型服务器。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"正在檢查 Gateway 上的 CLI 登入、已儲存的 API 金鑰和本機模型伺服器。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Verificando logins da CLI, chaves de API salvas e servidores de modelos locais no Gateway."}},"de":{"stringUnit":{"state":"translated","value":"CLI-Anmeldungen, gespeicherte API-Schlüssel und lokale Modellserver auf dem Gateway werden überprüft."}},"es":{"stringUnit":{"state":"translated","value":"Comprobando los inicios de sesión de la CLI, las claves de API guardadas y los servidores de modelos locales en el Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gateway 上の CLI ログイン、保存済み API キー、ローカルモデルサーバーを確認しています。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway의 CLI 로그인, 저장된 API 키 및 로컬 모델 서버를 확인하는 중입니다."}},"fr":{"stringUnit":{"state":"translated","value":"Vérification des connexions CLI, des clés API enregistrées et des serveurs de modèles locaux sur le Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway पर CLI लॉगिन, सहेजी गई API कुंजियों और स्थानीय मॉडल सर्वरों की जाँच की जा रही है।"}},"ar":{"stringUnit":{"state":"translated","value":"جارٍ التحقق من عمليات تسجيل الدخول عبر CLI ومفاتيح API المحفوظة وخوادم النماذج المحلية على Gateway."}},"it":{"stringUnit":{"state":"translated","value":"Verifica degli accessi CLI, delle chiavi API salvate e dei server di modelli locali sul Gateway."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway üzerindeki CLI oturumları, kayıtlı API anahtarları ve yerel model sunucuları kontrol ediliyor."}},"uk":{"stringUnit":{"state":"translated","value":"Перевіряються входи через CLI, збережені ключі API та локальні сервери моделей на Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Memeriksa login CLI, kunci API tersimpan, dan server model lokal di Gateway."}},"pl":{"stringUnit":{"state":"translated","value":"Sprawdzanie logowań CLI, zapisanych kluczy API i lokalnych serwerów modeli na Gateway."}},"th":{"stringUnit":{"state":"translated","value":"กำลังตรวจสอบการเข้าสู่ระบบ CLI, คีย์ API ที่บันทึกไว้ และเซิร์ฟเวอร์โมเดลภายในเครื่องบน Gateway"}},"vi":{"stringUnit":{"state":"translated","value":"Đang kiểm tra thông tin đăng nhập CLI, khóa API đã lưu và máy chủ mô hình cục bộ trên Gateway."}},"nl":{"stringUnit":{"state":"translated","value":"CLI-aanmeldingen, opgeslagen API-sleutels en lokale modelservers op de Gateway controleren."}},"fa":{"stringUnit":{"state":"translated","value":"در حال بررسی ورودهای CLI، کلیدهای API ذخیره‌شده و سرورهای مدل محلی در Gateway."}},"ru":{"stringUnit":{"state":"translated","value":"Проверяются входы через CLI, сохранённые ключи API и локальные серверы моделей на Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Kontrollerar CLI-inloggningar, sparade API-nycklar och lokala modellservrar på Gateway."}}}},
