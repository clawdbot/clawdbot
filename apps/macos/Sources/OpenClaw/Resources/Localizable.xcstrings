    "Tap Right Option to interrupt speech and return to listening.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Tap Right Option to interrupt speech and return to listening."}},"zh-CN":{"stringUnit":{"state":"translated","value":"轻点右 Option 键以打断语音并返回聆听。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"點一下右側 Option 以中斷語音並返回聆聽。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Toque em Option Direito para interromper a fala e voltar a escutar."}},"de":{"stringUnit":{"state":"translated","value":"Tippen Sie auf die rechte Wahltaste, um die Sprachausgabe zu unterbrechen und zum Zuhören zurückzukehren."}},"es":{"stringUnit":{"state":"translated","value":"Pulsa Opción derecha para interrumpir la voz y volver a escuchar."}},"ja-JP":{"stringUnit":{"state":"translated","value":"右Optionをタップして読み上げを中断し、リスニングに戻ります。"}},"ko":{"stringUnit":{"state":"translated","value":"오른쪽 Option을 탭하여 음성을 중단하고 듣기로 돌아갑니다."}},"fr":{"stringUnit":{"state":"translated","value":"Appuyez sur la touche Option droite pour interrompre la parole et revenir à l’écoute."}},"hi":{"stringUnit":{"state":"translated","value":"बोलना बाधित करने और फिर से सुनने पर लौटने के लिए Right Option टैप करें।"}},"ar":{"stringUnit":{"state":"translated","value":"اضغط على Right Option لمقاطعة الكلام والعودة إلى الاستماع."}},"it":{"stringUnit":{"state":"translated","value":"Tocca Opzione destro per interrompere il parlato e tornare all'ascolto."}},"tr":{"stringUnit":{"state":"translated","value":"Konuşmayı kesmek ve dinlemeye dönmek için Sağ Option tuşuna dokunun."}},"uk":{"stringUnit":{"state":"translated","value":"Натисніть праву клавішу Option, щоб перервати мовлення й повернутися до прослуховування."}},"id":{"stringUnit":{"state":"translated","value":"Ketuk Option Kanan untuk menyela ucapan dan kembali mendengarkan."}},"pl":{"stringUnit":{"state":"translated","value":"Dotknij prawego klawisza Option, aby przerwać mowę i wrócić do słuchania."}},"th":{"stringUnit":{"state":"translated","val