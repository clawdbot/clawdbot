    "Enable Voice Wake in Settings for hands-free commands with a live transcript overlay.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enable Voice Wake in Settings for hands-free commands with a live transcript overlay."}},"zh-CN":{"stringUnit":{"state":"translated","value":"在“设置”中启用语音唤醒，即可通过实时转写浮层免手动发出命令。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"在「設定」中啟用 Voice Wake，即可透過即時逐字稿覆疊層使用免持指令。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ative o Voice Wake em Ajustes para comandos sem usar as mãos com uma sobreposição de transcrição ao vivo."}},"de":{"stringUnit":{"state":"translated","value":"Aktiviere Voice Wake in den Einstellungen für freihändige Befehle mit Live-Transkript-Overlay."}},"es":{"stringUnit":{"state":"translated","value":"Activa Voice Wake en Ajustes para usar comandos manos libres con una superposición de transcripción en vivo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ライブ文字起こしオーバーレイでハンズフリーコマンドを使用するには、設定で音声起動を有効にしてください。"}},"ko":{"stringUnit":{"state":"translated","value":"실시간 transcript 오버레이가 포함된 핸즈프리 명령을 사용하려면 Settings에서 Voice Wake를 활성화하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Activez Voice Wake dans Réglages pour utiliser des commandes mains libres avec une superposition de transcription en direct."}},"hi":{"stringUnit":{"state":"translated","value":"हैंड्स-फ़्री कमांड के लिए लाइव ट्रांसक्रिप्ट ओवरले के साथ Settings में Voice Wake सक्षम करें।"}},"ar":{"stringUnit":{"state":"translated","value":"فعّل Voice Wake في Settings للأوامر بدون استخدام اليدين مع تراكب نص مباشر."}},"it":{"stringUnit":{"state":"translated","value":"Abilita Voice Wake in Settings per comandi a mani libere con una sovrapposizione della trascrizione in tempo reale."}},"tr":{"stringUnit":{"state":"translated","value":"Canlı transkript katmanıyla eller serbest komutlar için Settings’te Voice Wake’i etkinleştirin."}},"uk":{"stringUnit":{"state":"translated","value":"Увімкніть Voice Wake у Settings для голосових команд без рук із накладкою живої транскрипції."}},"id":{"stringUnit":{"state":"translated","value":"Aktifkan Voice Wake di Settings untuk perintah bebas genggam dengan overlay transkrip langsung."}},"pl":{"stringUnit":{"state":"translated","value":"Włącz Voice Wake w Ustawieniach, aby używać poleceń bez użycia rąk z nakładką transkrypcji na żywo."}},"th":{"stringUnit":{"state":"translated","value":"เปิดใช้งาน Voice Wake ใน Settings สำหรับคำสั่งแบบไม่ต้องใช้มือ พร้อมโอเวอร์เลย์ถอดเสียงแบบสด"}},"vi":{"stringUnit":{"state":"translated","value":"Bật Voice Wake trong Settings để dùng lệnh rảnh tay với lớp phủ bản ghi trực tiếp."}},"nl":{"stringUnit":{"state":"translated","value":"Schakel Voice Wake in Settings in voor handsfree opdrachten met een live transcript-overlay."}},"fa":{"stringUnit":{"state":"translated","value":"برای فرمان‌های بدون استفاده از دست با هم‌پوشانی رونوشت زنده، Voice Wake را در Settings فعال کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Включите Voice Wake в Settings для голосовых команд без рук с наложением живой транскрипции."}},"sv":{"stringUnit":{"state":"translated","value":"Aktivera Voice Wake i Settings för handsfree-kommandon med en live-transkriptionsoverlay."}}}},
    "Enable debug tools": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enable debug tools"}},"zh-CN":{"stringUnit":{"state":"translated","value":"启用调试工具"}},"zh-TW":{"stringUnit":{"state":"translated","value":"啟用除錯工具"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ativar ferramentas de depuração"}},"de":{"stringUnit":{"state":"translated","value":"Debug-Tools aktivieren"}},"es":{"stringUnit":{"state":"translated","value":"Activar herramientas de depuración"}},"ja-JP":{"stringUnit":{"state":"translated","value":"デバッグツールを有効化"}},"ko":{"stringUnit":{"state":"translated","value":"디버그 도구 활성화"}},"fr":{"stringUnit":{"state":"translated","value":"Activer les outils de débogage"}},"hi":{"stringUnit":{"state":"translated","value":"डीबग टूल सक्षम करें"}},"ar":{"stringUnit":{"state":"translated","value":"تمكين أدوات تصحيح الأخطاء"}},"it":{"stringUnit":{"state":"translated","value":"Abilita strumenti di debug"}},"tr":{"stringUnit":{"state":"translated","value":"Hata ayıklama araçlarını etkinleştir"}},"uk":{"stringUnit":{"state":"translated","value":"Увімкнути інструменти налагодження"}},"id":{"stringUnit":{"state":"translated","value":"Aktifkan alat debug"}},"pl":{"stringUnit":{"state":"translated","value":"Włącz narzędzia debugowania"}},"th":{"stringUnit":{"state":"translated","value":"เปิดใช้งานเครื่องมือดีบัก"}},"vi":{"stringUnit":{"state":"translated","value":"Bật công cụ gỡ lỗi"}},"nl":{"stringUnit":{"state":"translated","value":"Debugtools inschakelen"}},"fa":{"stringUnit":{"state":"translated","value":"فعال‌سازی ابزارهای اشکال‌زدایی"}},"ru":{"stringUnit":{"state":"translated","value":"Включить инструменты отладки"}},"sv":{"stringUnit":{"state":"translated","value":"Aktivera felsökningsverktyg"}}}},
    "Enable idle blinks and wiggles on the status icon.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enable idle blinks and wiggles on the status icon."}},"zh-CN":{"stringUnit":{"state":"translated","value":"启用状态图标的空闲眨眼和摆动效果。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"啟用狀態圖示的閒置眨眼與擺動效果。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ativar piscadas e movimentos quando o ícone de status estiver ocioso."}},"de":{"stringUnit":{"state":"translated","value":"Leerlauf-Blinzeln und Wackeln des Statussymbols aktivieren."}},"es":{"stringUnit":{"state":"translated","value":"Activar parpadeos y movimientos en reposo en el icono de estado."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ステータスアイコンのアイドル時のまばたきや揺れを有効にします。"}},"ko":{"stringUnit":{"state":"translated","value":"상태 아이콘의 유휴 상태 깜박임 및 흔들림을 활성화합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Activer les clignements et mouvements d’inactivité sur l’icône d’état."}},"hi":{"stringUnit":{"state":"translated","value":"स्टेटस आइकन पर निष्क्रिय ब्लिंक और विगल सक्षम करें।"}},"ar":{"stringUnit":{"state":"translated","value":"تمكين الومضات والحركات الخفيفة في أيقونة الحالة أثناء الخمول."}},"it":{"stringUnit":{"state":"translated","value":"Abilita lampeggi e oscillazioni in stato di inattività sull'icona di stato."}},"tr":{"stringUnit":{"state":"translated","value":"Durum simgesinde boşta göz kırpmaları ve kıpırdanmaları etkinleştir."}},"uk":{"stringUnit":{"state":"translated","value":"Увімкнути кліпання та похитування іконки стану під час простою."}},"id":{"stringUnit":{"state":"translated","value":"Aktifkan kedipan dan gerakan kecil saat idle pada ikon status."}},"pl":{"stringUnit":{"state":"translated","value":"Włącz mruganie i poruszanie ikoną statusu w trybie bezczynności."}},"th":{"stringUnit":{"state":"translated","value":"เปิดใช้งานการกะพริบและขยับเล็กน้อยเมื่อไม่ได้ใช้งานบนไอคอนสถานะ"}},"vi":{"stringUnit":{"state":"translated","value":"Bật nháy mắt và lắc nhẹ khi không hoạt động trên biểu tượng trạng thái."}},"nl":{"stringUnit":{"state":"translated","value":"Schakel inactieve knipper- en wiebelanimaties in voor het statusicoon."}},"fa":{"stringUnit":{"state":"translated","value":"چشمک‌زدن‌ها و تکان‌خوردن‌های حالت بی‌کاری را روی آیکون وضعیت فعال کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Включить мигания и покачивания значка состояния в режиме ожидания."}},"sv":{"stringUnit":{"state":"translated","value":"Aktivera blinkningar och vickningar vid inaktivitet på statussymbolen."}}}},
    "Enable optional skills (Peekaboo, oracle, camsnap, …) from Settings → Skills.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enable optional skills (Peekaboo, oracle, camsnap, …) from Settings → Skills."}},"zh-CN":{"stringUnit":{"state":"translated","value":"从 Settings → Skills 启用可选技能（Peekaboo、oracle、camsnap、…）。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"從 Settings → Skills 啟用選用技能（Peekaboo、oracle、camsnap、…）。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ative skills opcionais (Peekaboo, oracle, camsnap, …) em Ajustes → Skills."}},"de":{"stringUnit":{"state":"translated","value":"Aktiviere optionale Skills (Peekaboo, oracle, camsnap, …) in Einstellungen → Skills."}},"es":{"stringUnit":{"state":"translated","value":"Activa Skills opcionales (Peekaboo, oracle, camsnap, …) desde Configuración → Skills."}},"ja-JP":{"stringUnit":{"state":"translated","value":"設定 → Skills から任意の Skills（Peekaboo、oracle、camsnap、…）を有効にします。"}},"ko":{"stringUnit":{"state":"translated","value":"Settings → Skills에서 선택적 Skills(Peekaboo, oracle, camsnap, …)를 활성화하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Activez les Skills facultatives (Peekaboo, oracle, camsnap, …) depuis Réglages → Skills."}},"hi":{"stringUnit":{"state":"translated","value":"Settings → Skills से वैकल्पिक Skills (Peekaboo, oracle, camsnap, …) सक्षम करें।"}},"ar":{"stringUnit":{"state":"translated","value":"فعّل Skills الاختيارية (Peekaboo، oracle، camsnap، …) من Settings → Skills."}},"it":{"stringUnit":{"state":"translated","value":"Abilita Skills opzionali (Peekaboo, oracle, camsnap, …) da Impostazioni → Skills."}},"tr":{"stringUnit":{"state":"translated","value":"Ayarlar → Skills bölümünden isteğe bağlı Skills (Peekaboo, oracle, camsnap, …) özelliğini etkinleştirin."}},"uk":{"stringUnit":{"state":"translated","value":"Увімкніть додаткові Skills (Peekaboo, oracle, camsnap, …) у Settings → Skills."}},"id":{"stringUnit":{"state":"translated","value":"Aktifkan skills opsional (Peekaboo, oracle, camsnap, …) dari Settings → Skills."}},"pl":{"stringUnit":{"state":"translated","value":"Włącz opcjonalne Skills (Peekaboo, oracle, camsnap, …) w Ustawienia → Skills."}},"th":{"stringUnit":{"state":"translated","value":"เปิดใช้งาน Skills เสริม (Peekaboo, oracle, camsnap, …) จาก Settings → Skills"}},"vi":{"stringUnit":{"state":"translated","value":"Bật Skills tùy chọn (Peekaboo, oracle, camsnap, …) từ Settings → Skills."}},"nl":{"stringUnit":{"state":"translated","value":"Schakel optionele skills (Peekaboo, oracle, camsnap, …) in via Settings → Skills."}},"fa":{"stringUnit":{"state":"translated","value":"Skills اختیاری (Peekaboo، oracle، camsnap، …) را از Settings → Skills فعال کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Включите дополнительные Skills (Peekaboo, oracle, camsnap, …) в Settings → Skills."}},"sv":{"stringUnit":{"state":"translated","value":"Aktivera valfria Skills (Peekaboo, oracle, camsnap, …) från Inställningar → Skills."}}}},
    "Enable or install a text-inference provider plugin on this Gateway, then check again.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enable or install a text-inference provider plugin on this Gateway, then check again."}},"zh-CN":{"stringUnit":{"state":"translated","value":"在此 Gateway 上启用或安装文本推理提供商插件，然后再次检查。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"在此 Gateway 上啟用或安裝文字推論供應商外掛，然後再次檢查。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ative ou instale um plugin de provedor de inferência de texto neste Gateway e verifique novamente."}},"de":{"stringUnit":{"state":"translated","value":"Aktiviere oder installiere ein Plugin für einen Text-Inferenz-Anbieter auf diesem Gateway und prüfe dann erneut."}},"es":{"stringUnit":{"state":"translated","value":"Activa o instala un plugin de proveedor de inferencia de texto en este Gateway y vuelve a comprobar."}},"ja-JP":{"stringUnit":{"state":"translated","value":"この Gateway でテキスト推論プロバイダーのプラグインを有効化またはインストールしてから、再度確認してください。"}},"ko":{"stringUnit":{"state":"translated","value":"이 Gateway에서 텍스트 추론 공급자 플러그인을 활성화하거나 설치한 후 다시 확인하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Activez ou installez un plugin de fournisseur d’inférence de texte sur ce Gateway, puis vérifiez à nouveau."}},"hi":{"stringUnit":{"state":"translated","value":"इस Gateway पर एक text-inference प्रदाता प्लगइन सक्षम या इंस्टॉल करें, फिर फिर से जाँचें।"}},"ar":{"stringUnit":{"state":"translated","value":"قم بتمكين أو تثبيت مكوّن إضافي لمزوّد استدلال نصي على هذا الـ Gateway، ثم تحقق مرة أخرى."}},"it":{"stringUnit":{"state":"translated","value":"Abilita o installa un plugin provider di inferenza testuale su questo Gateway, quindi controlla di nuovo."}},"tr":{"stringUnit":{"state":"translated","value":"Bu Gateway'de bir metin çıkarım sağlayıcısı eklentisini etkinleştirin veya yükleyin, ardından tekrar kontrol edin."}},"uk":{"stringUnit":{"state":"translated","value":"Увімкніть або встановіть плагін провайдера текстового висновку на цьому Gateway, а потім перевірте ще раз."}},"id":{"stringUnit":{"state":"translated","value":"Aktifkan atau pasang plugin penyedia text-inference pada Gateway ini, lalu periksa lagi."}},"pl":{"stringUnit":{"state":"translated","value":"Włącz lub zainstaluj wtyczkę dostawcy wnioskowania tekstowego na tym Gateway, a następnie sprawdź ponownie."}},"th":{"stringUnit":{"state":"translated","value":"เปิดใช้งานหรือติดตั้งปลั๊กอินผู้ให้บริการ text-inference บน Gateway นี้ แล้วตรวจสอบอีกครั้ง"}},"vi":{"stringUnit":{"state":"translated","value":"Bật hoặc cài đặt một plugin nhà cung cấp suy luận văn bản trên Gateway này, rồi kiểm tra lại."}},"nl":{"stringUnit":{"state":"translated","value":"Schakel een text-inference-providerplug-in in of installeer die op deze Gateway en controleer opnieuw."}},"fa":{"stringUnit":{"state":"translated","value":"یک افزونه ارائه‌دهنده استنتاج متنی را روی این Gateway فعال یا نصب کنید، سپس دوباره بررسی کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Включите или установите плагин провайдера текстового вывода на этом Gateway, затем проверьте снова."}},"sv":{"stringUnit":{"state":"translated","value":"Aktivera eller installera ett plugin för textinferensleverantör på denna Gateway och kontrollera sedan igen."}}}},
    "Enable ready skills, or install missing tools on the Gateway or this Mac.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enable ready skills, or install missing tools on the Gateway or this Mac."}},"zh-CN":{"stringUnit":{"state":"translated","value":"启用已就绪的 Skills，或在 Gateway 或此 Mac 上安装缺失的工具。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"啟用已就緒的 Skills，或在 Gateway 或此 Mac 上安裝缺少的工具。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ative as skills prontas ou instale as ferramentas ausentes no Gateway ou neste Mac."}},"de":{"stringUnit":{"state":"translated","value":"Aktivieren Sie bereite Skills oder installieren Sie fehlende Tools auf dem Gateway oder diesem Mac."}},"es":{"stringUnit":{"state":"translated","value":"Activa las skills listas o instala las herramientas faltantes en el Gateway o en este Mac."}},"ja-JP":{"stringUnit":{"state":"translated","value":"準備済みのSkillsを有効にするか、GatewayまたはこのMacに不足しているツールをインストールしてください。"}},"ko":{"stringUnit":{"state":"translated","value":"준비된 Skills를 활성화하거나 Gateway 또는 이 Mac에 누락된 도구를 설치하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Activez les skills prêtes, ou installez les outils manquants sur la Gateway ou ce Mac."}},"hi":{"stringUnit":{"state":"translated","value":"तैयार Skills सक्षम करें, या Gateway या इस Mac पर अनुपलब्ध टूल इंस्टॉल करें।"}},"ar":{"stringUnit":{"state":"translated","value":"فعّل Skills الجاهزة، أو ثبّت الأدوات المفقودة على Gateway أو على هذا الـ Mac."}},"it":{"stringUnit":{"state":"translated","value":"Abilita le Skills pronte oppure installa gli strumenti mancanti sul Gateway o su questo Mac."}},"tr":{"stringUnit":{"state":"translated","value":"Hazır Skills özelliklerini etkinleştirin veya eksik araçları Gateway’e ya da bu Mac’e yükleyin."}},"uk":{"stringUnit":{"state":"translated","value":"Увімкніть готові Skills або встановіть відсутні інструменти на Gateway чи цьому Mac."}},"id":{"stringUnit":{"state":"translated","value":"Aktifkan skills yang siap, atau instal alat yang belum ada di Gateway atau Mac ini."}},"pl":{"stringUnit":{"state":"translated","value":"Włącz gotowe Skills lub zainstaluj brakujące narzędzia na Gateway albo na tym Macu."}},"th":{"stringUnit":{"state":"translated","value":"เปิดใช้งาน Skills ที่พร้อมใช้ หรือติดตั้งเครื่องมือที่ขาดหายไปบน Gateway หรือ Mac เครื่องนี้"}},"vi":{"stringUnit":{"state":"translated","value":"Bật các Skills đã sẵn sàng, hoặc cài đặt các công cụ còn thiếu trên Gateway hoặc máy Mac này."}},"nl":{"stringUnit":{"state":"translated","value":"Schakel gereede Skills in, of installeer ontbrekende tools op de Gateway of deze Mac."}},"fa":{"stringUnit":{"state":"translated","value":"Skills آماده را فعال کنید، یا ابزارهای مفقود را روی Gateway یا این Mac نصب کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Включите готовые Skills или установите недостающие инструменты на Gateway или на этом Mac."}},"sv":{"stringUnit":{"state":"translated","value":"Aktivera redo skills eller installera saknade verktyg på Gateway eller den här Mac-datorn."}}}},
    "Enable/disable Canvas in General settings.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enable/disable Canvas in General settings."}},"zh-CN":{"stringUnit":{"state":"translated","value":"在通用设置中启用/禁用 Canvas。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"在「一般」設定中啟用/停用 Canvas。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ative/desative o Canvas nas configurações gerais."}},"de":{"stringUnit":{"state":"translated","value":"Canvas in den allgemeinen Einstellungen aktivieren/deaktivieren."}},"es":{"stringUnit":{"state":"translated","value":"Activa/desactiva Canvas en la configuración General."}},"ja-JP":{"stringUnit":{"state":"translated","value":"General 設定で Canvas を有効/無効にします。"}},"ko":{"stringUnit":{"state":"translated","value":"일반 설정에서 Canvas를 활성화/비활성화합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Activer/désactiver Canvas dans les réglages généraux."}},"hi":{"stringUnit":{"state":"translated","value":"General सेटिंग्स में Canvas सक्षम/अक्षम करें।"}},"ar":{"stringUnit":{"state":"translated","value":"تفعيل/تعطيل Canvas في الإعدادات العامة."}},"it":{"stringUnit":{"state":"translated","value":"Abilita/disabilita Canvas nelle impostazioni Generali."}},"tr":{"stringUnit":{"state":"translated","value":"Genel ayarlarda Canvas’ı etkinleştirin/devre dışı bırakın."}},"uk":{"stringUnit":{"state":"translated","value":"Увімкнути/вимкнути Canvas у загальних налаштуваннях."}},"id":{"stringUnit":{"state":"translated","value":"Aktifkan/nonaktifkan Canvas di pengaturan Umum."}},"pl":{"stringUnit":{"state":"translated","value":"Włącz/wyłącz Canvas w ustawieniach ogólnych."}},"th":{"stringUnit":{"state":"translated","value":"เปิด/ปิด Canvas ในการตั้งค่าทั่วไป"}},"vi":{"stringUnit":{"state":"translated","value":"Bật/tắt Canvas trong cài đặt General."}},"nl":{"stringUnit":{"state":"translated","value":"Canvas in- of uitschakelen in Algemene instellingen."}},"fa":{"stringUnit":{"state":"translated","value":"Canvas را در تنظیمات General فعال/غیرفعال کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Включить/выключить Canvas в общих настройках."}},"sv":{"stringUnit":{"state":"translated","value":"Aktivera/inaktivera Canvas i allmänna inställningar."}}}},
