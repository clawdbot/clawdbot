    "Connect a local model service, or prepare a model on this Gateway.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connect a local model service, or prepare a model on this Gateway."}},"zh-CN":{"stringUnit":{"state":"translated","value":"连接本地模型服务，或在此 Gateway 上准备模型。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"連接本地模型服務，或在此 Gateway 上準備模型。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Conecte um serviço de modelo local ou prepare um modelo neste Gateway."}},"de":{"stringUnit":{"state":"translated","value":"Verbinden Sie einen lokalen Modelldienst oder bereiten Sie ein Modell auf diesem Gateway vor."}},"es":{"stringUnit":{"state":"translated","value":"Conecta un servicio de modelo local o prepara un modelo en este Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ローカルモデルサービスを接続するか、この Gateway でモデルを準備します。"}},"ko":{"stringUnit":{"state":"translated","value":"로컬 모델 서비스를 연결하거나 이 Gateway에서 모델을 준비하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Connectez un service de modèle local, ou préparez un modèle sur ce Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"एक स्थानीय मॉडल सेवा कनेक्ट करें, या इस Gateway पर एक मॉडल तैयार करें।"}},"ar":{"stringUnit":{"state":"translated","value":"اتصل بخدمة نموذج محلي، أو جهّز نموذجًا على هذا الـ Gateway."}},"it":{"stringUnit":{"state":"translated","value":"Connetti un servizio di modello locale o prepara un modello su questo Gateway."}},"tr":{"stringUnit":{"state":"translated","value":"Yerel bir model hizmeti bağlayın veya bu Gateway üzerinde bir model hazırlayın."}},"uk":{"stringUnit":{"state":"translated","value":"Підключіть локальну службу моделей або підготуйте модель на цьому Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Sambungkan layanan model lokal, atau siapkan model di Gateway ini."}},"pl":{"stringUnit":{"state":"translated","value":"Połącz lokalną usługę modelu lub przygotuj model na tym Gateway."}},"th":{"stringUnit":{"state":"translated","value":"เชื่อมต่อบริการโมเดลในเครื่อง หรือเตรียมโมเดลบน Gateway นี้"}},"vi":{"stringUnit":{"state":"translated","value":"Kết nối dịch vụ mô hình cục bộ, hoặc chuẩn bị một mô hình trên Gateway này."}},"nl":{"stringUnit":{"state":"translated","value":"Verbind een lokale modelservice of bereid een model voor op deze Gateway."}},"fa":{"stringUnit":{"state":"translated","value":"یک سرویس مدل محلی متصل کنید یا مدلی را روی این Gateway آماده کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Подключите локальный сервис модели или подготовьте модель на этом Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Anslut en lokal modelltjänst eller förbered en modell på den här Gateway."}}}},
    "Connect a provider below with an API key or token, then check again.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connect a provider below with an API key or token, then check again."}},"zh-CN":{"stringUnit":{"state":"translated","value":"使用 API 密钥或令牌连接下方的提供商，然后再次检查。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"使用 API 金鑰或權杖連接下方的供應商，然後再次檢查。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Conecte um provedor abaixo com uma chave de API ou token e verifique novamente."}},"de":{"stringUnit":{"state":"translated","value":"Verbinde unten einen Anbieter mit einem API-Schlüssel oder Token und prüfe dann erneut."}},"es":{"stringUnit":{"state":"translated","value":"Conecta un proveedor a continuación con una clave de API o un token y, luego, vuelve a comprobarlo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"以下のプロバイダーに API キーまたはトークンで接続してから、もう一度確認してください。"}},"ko":{"stringUnit":{"state":"translated","value":"아래 제공업체를 API 키 또는 토큰으로 연결한 다음 다시 확인하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Connectez un fournisseur ci-dessous à l’aide d’une clé API ou d’un jeton, puis vérifiez à nouveau."}},"hi":{"stringUnit":{"state":"translated","value":"नीचे किसी प्रदाता को API key या token से कनेक्ट करें, फिर दोबारा जाँचें।"}},"ar":{"stringUnit":{"state":"translated","value":"اربط أحد المزوّدين أدناه باستخدام مفتاح API أو رمز مميّز، ثم تحقّق مرة أخرى."}},"it":{"stringUnit":{"state":"translated","value":"Connetti uno dei provider qui sotto con una chiave API o un token, quindi verifica di nuovo."}},"tr":{"stringUnit":{"state":"translated","value":"Aşağıdaki sağlayıcılardan birine API anahtarı veya token ile bağlanın, ardından tekrar kontrol edin."}},"uk":{"stringUnit":{"state":"translated","value":"Підключіть постачальника нижче за допомогою ключа API або токена, а потім перевірте ще раз."}},"id":{"stringUnit":{"state":"translated","value":"Hubungkan penyedia di bawah ini dengan kunci API atau token, lalu periksa kembali."}},"pl":{"stringUnit":{"state":"translated","value":"Połącz poniżej dostawcę za pomocą klucza API lub tokenu, a następnie sprawdź ponownie."}},"th":{"stringUnit":{"state":"translated","value":"เชื่อมต่อผู้ให้บริการด้านล่างด้วย API key หรือ token แล้วตรวจสอบอีกครั้ง"}},"vi":{"stringUnit":{"state":"translated","value":"Kết nối với một nhà cung cấp bên dưới bằng khóa API hoặc token, sau đó kiểm tra lại."}},"nl":{"stringUnit":{"state":"translated","value":"Koppel hieronder een provider met een API-sleutel of token en controleer het daarna opnieuw."}},"fa":{"stringUnit":{"state":"translated","value":"یکی از ارائه‌دهندگان زیر را با یک کلید API یا توکن متصل کنید، سپس دوباره بررسی کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Подключите ниже провайдера с помощью API-ключа или токена, затем повторите проверку."}},"sv":{"stringUnit":{"state":"translated","value":"Anslut en leverantör nedan med en API-nyckel eller token och kontrollera sedan igen."}}}},
    "Connect with an API key or token": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connect with an API key or token"}},"zh-CN":{"stringUnit":{"state":"translated","value":"使用 API 密钥或令牌连接"}},"zh-TW":{"stringUnit":{"state":"translated","value":"使用 API 金鑰或權杖連線"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Conecte-se com uma chave de API ou token"}},"de":{"stringUnit":{"state":"translated","value":"Mit API-Schlüssel oder Token verbinden"}},"es":{"stringUnit":{"state":"translated","value":"Conéctate con una clave de API o un token"}},"ja-JP":{"stringUnit":{"state":"translated","value":"API キーまたはトークンで接続"}},"ko":{"stringUnit":{"state":"translated","value":"API 키 또는 토큰으로 연결"}},"fr":{"stringUnit":{"state":"translated","value":"Se connecter avec une clé API ou un jeton"}},"hi":{"stringUnit":{"state":"translated","value":"API कुंजी या टोकन से कनेक्ट करें"}},"ar":{"stringUnit":{"state":"translated","value":"الاتصال باستخدام مفتاح API أو رمز"}},"it":{"stringUnit":{"state":"translated","value":"Connetti con una chiave API o un token"}},"tr":{"stringUnit":{"state":"translated","value":"API anahtarı veya belirteci ile bağlan"}},"uk":{"stringUnit":{"state":"translated","value":"Підключитися за допомогою ключа API або токена"}},"id":{"stringUnit":{"state":"translated","value":"Hubungkan dengan kunci API atau token"}},"pl":{"stringUnit":{"state":"translated","value":"Połącz przy użyciu klucza API lub tokenu"}},"th":{"stringUnit":{"state":"translated","value":"เชื่อมต่อด้วย API key หรือ token"}},"vi":{"stringUnit":{"state":"translated","value":"Kết nối bằng khóa API hoặc token"}},"nl":{"stringUnit":{"state":"translated","value":"Verbinden met een API-sleutel of token"}},"fa":{"stringUnit":{"state":"translated","value":"اتصال با کلید API یا توکن"}},"ru":{"stringUnit":{"state":"translated","value":"Подключиться с помощью API-ключа или токена"}},"sv":{"stringUnit":{"state":"translated","value":"Anslut med en API-nyckel eller token"}}}},
