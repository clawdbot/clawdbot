    "OpenClaw - Voice Wake live meter active": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenClaw - Voice Wake live meter active"}},"zh-CN":{"stringUnit":{"state":"translated","value":"OpenClaw - 语音唤醒实时计量器已启用"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw - 語音喚醒即時計量器已啟用"}},"pt-BR":{"stringUnit":{"state":"translated","value":"OpenClaw - medidor ao vivo de Voice Wake ativo"}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw – Voice Wake-Live-Anzeige aktiv"}},"es":{"stringUnit":{"state":"translated","value":"OpenClaw - medidor en vivo de activación por voz activo"}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClaw - Voice Wake ライブメーターがアクティブ"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw - 음성 깨우기 라이브 미터 활성"}},"fr":{"stringUnit":{"state":"translated","value":"OpenClaw - indicateur en direct de Voice Wake actif"}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw - Voice Wake लाइव मीटर सक्रिय"}},"ar":{"stringUnit":{"state":"translated","value":"OpenClaw - عدّاد التنبيه الصوتي المباشر نشط"}},"it":{"stringUnit":{"state":"translated","value":"OpenClaw - Indicatore live di Voice Wake attivo"}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw - Sesle Uyandırma canlı göstergesi etkin"}},"uk":{"stringUnit":{"state":"translated","value":"OpenClaw — активний індикатор Voice Wake наживо"}},"id":{"stringUnit":{"state":"translated","value":"OpenClaw - meter langsung Voice Wake aktif"}},"pl":{"stringUnit":{"state":"translated","value":"OpenClaw – aktywny miernik na żywo Voice Wake"}},"th":{"stringUnit":{"state":"translated","value":"OpenClaw - มาตรวัดสดสำหรับการปลุกด้วยเสียงเปิดใช้งานอยู่"}},"vi":{"stringUnit":{"state":"translated","value":"OpenClaw - đồng hồ đo trực tiếp Đánh thức bằng giọng nói đang hoạt động"}},"nl":{"stringUnit":{"state":"translated","value":"OpenClaw - livemeter voor Voice Wake actief"}},"fa":{"stringUnit":{"state":"translated","value":"OpenClaw - سنجهٔ زندهٔ بیدا