    "The Gateway did not start.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Gateway did not start."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Gateway 未启动。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 未啟動。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Gateway não foi iniciado."}},"de":{"stringUnit":{"state":"translated","value":"Das Gateway wurde nicht gestartet."}},"es":{"stringUnit":{"state":"translated","value":"El Gateway no se inició."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gateway は起動しませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway가 시작되지 않았습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le Gateway n’a pas démarré."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway शुरू नहीं हुआ।"}},"ar":{"stringUnit":{"state":"translated","value":"لم يبدأ Gateway."}},"it":{"stringUnit":{"state":"translated","value":"Il Gateway non si è avviato."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway başlatılamadı."}},"uk":{"stringUnit":{"state":"translated","value":"Gateway не запустився."}},"id":{"stringUnit":{"state":"translated","value":"Gateway tidak dimulai."}},"pl":{"stringUnit":{"state":"translated","value":"Gateway nie uruchomił się."}},"th":{"stringUnit":{"state":"translated","value":"Gateway ไม่เริ่มทำงาน"}},"vi":{"stringUnit":{"state":"translated","value":"Gateway không khởi động."}},"nl":{"stringUnit":{"state":"translated","value":"De Gateway is niet gestart."}},"fa":{"stringUnit":{"state":"translated","value":"Gateway راه‌اندازی نشد."}},"ru":{"stringUnit":{"state":"translated","value":"Gateway не запустился."}},"sv":{"stringUnit":{"state":"translated","value":"Gateway startade inte."}}}},
    "The Gateway didn’t start": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Gateway didn’t start"}},"zh-CN":{"stringUnit":{"state":"translated","value":"Gateway 未启动"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 未啟動"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Gateway não iniciou"}},"de":{"stringUnit":{"state":"translated","value":"Die Gateway wurde nicht gestartet"}},"es":{"stringUnit":{"state":"translated","value":"El Gateway no se inició"}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gateway が起動しませんでした"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway가 시작되지 않았습니다"}},"fr":{"stringUnit":{"state":"translated","value":"Le Gateway n’a pas démarré"}},"hi":{"stringUnit":{"state":"translated","value":"Gateway शुरू नहीं हुआ"}},"ar":{"stringUnit":{"state":"translated","value":"لم يبدأ Gateway"}},"it":{"stringUnit":{"state":"translated","value":"Il Gateway non si è avviato"}},"tr":{"stringUnit":{"state":"translated","value":"Gateway başlamadı"}},"uk":{"stringUnit":{"state":"translated","value":"Gateway не запустився"}},"id":{"stringUnit":{"state":"translated","value":"Gateway tidak dimulai"}},"pl":{"stringUnit":{"state":"translated","value":"Gateway nie uruchomił się"}},"th":{"stringUnit":{"state":"translated","value":"Gateway ไม่เริ่มทำงาน"}},"vi":{"stringUnit":{"state":"translated","value":"Gateway không khởi động"}},"nl":{"stringUnit":{"state":"translated","value":"De Gateway is niet gestart"}},"fa":{"stringUnit":{"state":"translated","value":"Gateway شروع نشد"}},"ru":{"stringUnit":{"state":"translated","value":"Gateway не запустился"}},"sv":{"stringUnit":{"state":"translated","value":"Gateway startade inte"}}}},
    "The Gateway remains paused, so OpenClaw did not wake your agent.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Gateway remains paused, so OpenClaw did not wake your agent."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Gateway 仍处于暂停状态，因此 OpenClaw 未唤醒您的智能体。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 仍處於暫停狀態，因此 OpenClaw 未喚醒您的代理程式。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Gateway continua pausado, então o OpenClaw não ativou seu agente."}},"de":{"stringUnit":{"state":"translated","value":"Das Gateway ist weiterhin pausiert, daher hat OpenClaw Ihren Agenten nicht aktiviert."}},"es":{"stringUnit":{"state":"translated","value":"El Gateway sigue en pausa, por lo que OpenClaw no activó a tu agente."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gateway は一時停止したままのため、OpenClaw はエージェントを起動しませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway가 계속 일시 중지된 상태이므로 OpenClaw에서 에이전트를 깨우지 않았습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le Gateway est toujours en pause. OpenClaw n’a donc pas réveillé votre agent."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway अभी भी रुका हुआ है, इसलिए OpenClaw ने आपके एजेंट को सक्रिय नहीं किया।"}},"ar":{"stringUnit":{"state":"translated","value":"لا يزال Gateway متوقفًا مؤقتًا، لذا لم يوقظ OpenClaw وكيلك."}},"it":{"stringUnit":{"state":"translated","value":"Il Gateway è ancora in pausa, quindi OpenClaw non ha riattivato il tuo agente."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway duraklatılmış durumda kaldığı için OpenClaw aracınızı uyandırmadı."}},"uk":{"stringUnit":{"state":"translated","value":"Gateway залишається призупиненим, тому OpenClaw не активував вашого агента."}},"id":{"stringUnit":{"state":"translated","value":"Gateway tetap dijeda, sehingga OpenClaw tidak membangunkan agen Anda."}},"pl":{"stringUnit":{"state":"translated","value":"Gateway pozostaje wstrzymany, dlatego OpenClaw nie wybudził Twojego agenta."}},"th":{"stringUnit":{"state":"translated","value":"Gateway ยังคงหยุดชั่วคราว ดังนั้น OpenClaw จึงไม่ได้ปลุกเอเจนต์ของคุณ"}},"vi":{"stringUnit":{"state":"translated","value":"Gateway vẫn đang tạm dừng, nên OpenClaw không đánh thức tác tử của bạn."}},"nl":{"stringUnit":{"state":"translated","value":"De Gateway blijft gepauzeerd, dus OpenClaw heeft uw agent niet geactiveerd."}},"fa":{"stringUnit":{"state":"translated","value":"Gateway همچنان متوقف است، بنابراین OpenClaw عامل شما را فعال نکرد."}},"ru":{"stringUnit":{"state":"translated","value":"Gateway по-прежнему приостановлен, поэтому OpenClaw не активировал вашего агента."}},"sv":{"stringUnit":{"state":"translated","value":"Gateway är fortfarande pausad, så OpenClaw väckte inte din agent."}}}},
    "The Gateway setup request failed.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Gateway setup request failed."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Gateway 设置请求失败。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 設定請求失敗。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A solicitação de configuração do Gateway falhou."}},"de":{"stringUnit":{"state":"translated","value":"Die Gateway-Einrichtungsanfrage ist fehlgeschlagen."}},"es":{"stringUnit":{"state":"translated","value":"La solicitud de configuración del Gateway falló."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayのセットアップリクエストが失敗しました。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway 설정 요청이 실패했습니다."}},"fr":{"stringUnit":{"state":"translated","value":"La requête de configuration du Gateway a échoué."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway सेटअप अनुरोध विफल रहा।"}},"ar":{"stringUnit":{"state":"translated","value":"فشل طلب إعداد Gateway."}},"it":{"stringUnit":{"state":"translated","value":"La richiesta di configurazione del Gateway non è riuscita."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway kurulum isteği başarısız oldu."}},"uk":{"stringUnit":{"state":"translated","value":"Запит на налаштування Gateway не вдався."}},"id":{"stringUnit":{"state":"translated","value":"Permintaan penyiapan Gateway gagal."}},"pl":{"stringUnit":{"state":"translated","value":"Żądanie konfiguracji Gateway nie powiodło się."}},"th":{"stringUnit":{"state":"translated","value":"คำขอตั้งค่า Gateway ล้มเหลว"}},"vi":{"stringUnit":{"state":"translated","value":"Yêu cầu thiết lập Gateway đã thất bại."}},"nl":{"stringUnit":{"state":"translated","value":"Het verzoek voor Gateway-installatie is mislukt."}},"fa":{"stringUnit":{"state":"translated","value":"درخواست راه‌اندازی Gateway ناموفق بود."}},"ru":{"stringUnit":{"state":"translated","value":"Запрос настройки Gateway не выполнен."}},"sv":{"stringUnit":{"state":"translated","value":"Gateway-konfigurationsbegäran misslyckades."}}}},
    "The Gateway setup request failed. Show details to inspect or copy the error.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Gateway setup request failed. Show details to inspect or copy the error."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Gateway 设置请求失败。显示详情以查看或复制错误。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 設定請求失敗。顯示詳細資料以檢查或複製錯誤。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A solicitação de configuração do Gateway falhou. Mostre os detalhes para inspecionar ou copiar o erro."}},"de":{"stringUnit":{"state":"translated","value":"Die Gateway-Einrichtungsanfrage ist fehlgeschlagen. Zeigen Sie die Details an, um den Fehler zu prüfen oder zu kopieren."}},"es":{"stringUnit":{"state":"translated","value":"La solicitud de configuración del Gateway falló. Muestra los detalles para inspeccionar o copiar el error."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayのセットアップリクエストが失敗しました。詳細を表示してエラーを確認またはコピーしてください。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway 설정 요청이 실패했습니다. 세부 정보를 표시하여 오류를 확인하거나 복사하세요."}},"fr":{"stringUnit":{"state":"translated","value":"La requête de configuration du Gateway a échoué. Affichez les détails pour inspecter ou copier l'erreur."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway सेटअप अनुरोध विफल रहा। त्रुटि का निरीक्षण या कॉपी करने के लिए विवरण दिखाएँ।"}},"ar":{"stringUnit":{"state":"translated","value":"فشل طلب إعداد Gateway. اعرض التفاصيل لفحص الخطأ أو نسخه."}},"it":{"stringUnit":{"state":"translated","value":"La richiesta di configurazione del Gateway non è riuscita. Mostra i dettagli per ispezionare o copiare l'errore."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway kurulum isteği başarısız oldu. Hatayı incelemek veya kopyalamak için ayrıntıları gösterin."}},"uk":{"stringUnit":{"state":"translated","value":"Запит на налаштування Gateway не вдався. Покажіть подробиці, щоб переглянути або скопіювати помилку."}},"id":{"stringUnit":{"state":"translated","value":"Permintaan penyiapan Gateway gagal. Tampilkan detail untuk memeriksa atau menyalin kesalahannya."}},"pl":{"stringUnit":{"state":"translated","value":"Żądanie konfiguracji Gateway nie powiodło się. Pokaż szczegóły, aby sprawdzić lub skopiować błąd."}},"th":{"stringUnit":{"state":"translated","value":"คำขอตั้งค่า Gateway ล้มเหลว แสดงรายละเอียดเพื่อตรวจสอบหรือคัดลอกข้อผิดพลาด"}},"vi":{"stringUnit":{"state":"translated","value":"Yêu cầu thiết lập Gateway đã thất bại. Hiển thị chi tiết để kiểm tra hoặc sao chép lỗi."}},"nl":{"stringUnit":{"state":"translated","value":"Het verzoek voor Gateway-installatie is mislukt. Toon details om de fout te bekijken of te kopiëren."}},"fa":{"stringUnit":{"state":"translated","value":"درخواست راه‌اندازی Gateway ناموفق بود. برای بررسی یا کپی خطا جزئیات را نمایش دهید."}},"ru":{"stringUnit":{"state":"translated","value":"Запрос настройки Gateway не выполнен. Покажите подробности, чтобы просмотреть или скопировать ошибку."}},"sv":{"stringUnit":{"state":"translated","value":"Gateway-konfigurationsbegäran misslyckades. Visa detaljer för att granska eller kopiera felet."}}}},
    "The Gateway verifies the exact reviewed release before download.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Gateway verifies the exact reviewed release before download."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Gateway 会在下载前验证经过审核的确切版本。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 會在下載前驗證已檢閱的確切版本。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Gateway verifica a versão exata revisada antes do download."}},"de":{"stringUnit":{"state":"translated","value":"Das Gateway überprüft vor dem Download exakt die geprüfte Version."}},"es":{"stringUnit":{"state":"translated","value":"El Gateway verifica la versión exacta revisada antes de descargarla."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayはダウンロード前に、確認済みのリリースと完全に一致することを検証します。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway는 다운로드 전에 검토된 정확한 릴리스를 확인합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le Gateway vérifie la version exacte examinée avant le téléchargement."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway डाउनलोड से पहले समीक्षा की गई सटीक रिलीज़ को सत्यापित करता है।"}},"ar":{"stringUnit":{"state":"translated","value":"يتحقق Gateway من الإصدار الدقيق الذي تمت مراجعته قبل التنزيل."}},"it":{"stringUnit":{"state":"translated","value":"Il Gateway verifica la versione esatta esaminata prima del download."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway, indirmeden önce incelenen sürümün tam olarak eşleştiğini doğrular."}},"uk":{"stringUnit":{"state":"translated","value":"Gateway перевіряє точний переглянутий випуск перед завантаженням."}},"id":{"stringUnit":{"state":"translated","value":"Gateway memverifikasi rilis yang telah ditinjau secara persis sebelum mengunduh."}},"pl":{"stringUnit":{"state":"translated","value":"Gateway weryfikuje dokładnie sprawdzone wydanie przed pobraniem."}},"th":{"stringUnit":{"state":"translated","value":"Gateway จะตรวจสอบรุ่นที่ผ่านการตรวจสอบโดยตรงก่อนดาวน์โหลด"}},"vi":{"stringUnit":{"state":"translated","value":"Gateway xác minh chính xác bản phát hành đã được xem xét trước khi tải xuống."}},"nl":{"stringUnit":{"state":"translated","value":"De Gateway verifieert vóór het downloaden de exacte beoordeelde release."}},"fa":{"stringUnit":{"state":"translated","value":"Gateway پیش از دانلود، انتشار دقیق بررسی‌شده را تأیید می‌کند."}},"ru":{"stringUnit":{"state":"translated","value":"Перед скачиванием Gateway проверяет точную версию выпуска, которую вы просмотрели."}},"sv":{"stringUnit":{"state":"translated","value":"Gateway verifierar den exakta granskade versionen före nedladdning."}}}},
    "The Gateway will verify this exact release with ClawHub before download.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Gateway will verify this exact release with ClawHub before download."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Gateway 将在下载前通过 ClawHub 验证此确切版本。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 會在下載前透過 ClawHub 驗證此確切版本。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Gateway verificará esta versão exata com o ClawHub antes do download."}},"de":{"stringUnit":{"state":"translated","value":"Das Gateway überprüft vor dem Download genau diese Version mit ClawHub."}},"es":{"stringUnit":{"state":"translated","value":"El Gateway verificará esta versión exacta con ClawHub antes de descargarla."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayはダウンロード前に、ClawHubでこの正確なリリースを検証します。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway가 다운로드 전에 ClawHub를 통해 이 정확한 릴리스를 확인합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le Gateway vérifiera cette version exacte auprès de ClawHub avant le téléchargement."}},"hi":{"stringUnit":{"state":"translated","value":"डाउनलोड से पहले Gateway इस सटीक रिलीज़ को ClawHub से सत्यापित करेगा।"}},"ar":{"stringUnit":{"state":"translated","value":"سيتحقق Gateway من هذا الإصدار تحديدًا عبر ClawHub قبل التنزيل."}},"it":{"stringUnit":{"state":"translated","value":"Il Gateway verificherà questa versione esatta con ClawHub prima del download."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway, indirmeden önce tam olarak bu sürümü ClawHub ile doğrulayacak."}},"uk":{"stringUnit":{"state":"translated","value":"Gateway перевірить саме цей випуск у ClawHub перед завантаженням."}},"id":{"stringUnit":{"state":"translated","value":"Gateway akan memverifikasi rilis ini secara persis dengan ClawHub sebelum mengunduh."}},"pl":{"stringUnit":{"state":"translated","value":"Gateway zweryfikuje dokładnie to wydanie w ClawHub przed pobraniem."}},"th":{"stringUnit":{"state":"translated","value":"Gateway จะตรวจสอบรีลีสนี้กับ ClawHub ก่อนดาวน์โหลด"}},"vi":{"stringUnit":{"state":"translated","value":"Gateway sẽ xác minh chính xác bản phát hành này với ClawHub trước khi tải xuống."}},"nl":{"stringUnit":{"state":"translated","value":"De Gateway verifieert vóór het downloaden deze exacte release bij ClawHub."}},"fa":{"stringUnit":{"state":"translated","value":"Gateway پیش از دانلود، دقیقاً همین نسخه را با ClawHub تأیید خواهد کرد."}},"ru":{"stringUnit":{"state":"translated","value":"Gateway проверит именно этот релиз в ClawHub перед загрузкой."}},"sv":{"stringUnit":{"state":"translated","value":"Gateway kommer att verifiera exakt den här versionen med ClawHub före nedladdning."}}}},
    "The Mac node could not be checked.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Mac node could not be checked."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法检查 Mac 节点。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法檢查 Mac 節點。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível verificar o nó do Mac."}},"de":{"stringUnit":{"state":"translated","value":"Der Mac-Knoten konnte nicht überprüft werden."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo comprobar el nodo Mac."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Macノードを確認できませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"Mac 노드를 확인할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le nœud Mac n’a pas pu être vérifié."}},"hi":{"stringUnit":{"state":"translated","value":"Mac नोड की जाँच नहीं की जा सकी।"}},"ar":{"stringUnit":{"state":"translated","value":"تعذر التحقق من عقدة Mac."}},"it":{"stringUnit":{"state":"translated","value":"Non è stato possibile verificare il nodo Mac."}},"tr":{"stringUnit":{"state":"translated","value":"Mac düğümü kontrol edilemedi."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося перевірити вузол Mac."}},"id":{"stringUnit":{"state":"translated","value":"Node Mac tidak dapat diperiksa."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się sprawdzić węzła Maca."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถตรวจสอบโหนด Mac ได้"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể kiểm tra nút Mac."}},"nl":{"stringUnit":{"state":"translated","value":"De Mac-node kon niet worden gecontroleerd."}},"fa":{"stringUnit":{"state":"translated","value":"بررسی گره Mac ممکن نبود."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось проверить узел Mac."}},"sv":{"stringUnit":{"state":"translated","value":"Mac-noden kunde inte kontrolleras."}}}},
    "The Mac node did not become ready.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Mac node did not become ready."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Mac 节点未就绪。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Mac 節點未進入就緒狀態。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O nó do Mac não ficou pronto."}},"de":{"stringUnit":{"state":"translated","value":"Der Mac-Knoten wurde nicht betriebsbereit."}},"es":{"stringUnit":{"state":"translated","value":"El nodo de Mac no llegó a estar listo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Mac ノードは準備完了になりませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"Mac 노드가 준비 상태가 되지 않았습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le nœud Mac n’est pas devenu opérationnel."}},"hi":{"stringUnit":{"state":"translated","value":"Mac नोड तैयार नहीं हुआ।"}},"ar":{"stringUnit":{"state":"translated","value":"لم تصبح عقدة Mac جاهزة."}},"it":{"stringUnit":{"state":"translated","value":"Il nodo Mac non è diventato disponibile."}},"tr":{"stringUnit":{"state":"translated","value":"Mac düğümü hazır duruma gelmedi."}},"uk":{"stringUnit":{"state":"translated","value":"Вузол Mac не перейшов у стан готовності."}},"id":{"stringUnit":{"state":"translated","value":"Node Mac tidak siap."}},"pl":{"stringUnit":{"state":"translated","value":"Węzeł Maca nie osiągnął stanu gotowości."}},"th":{"stringUnit":{"state":"translated","value":"โหนด Mac ไม่พร้อมใช้งาน"}},"vi":{"stringUnit":{"state":"translated","value":"Nút Mac không chuyển sang trạng thái sẵn sàng."}},"nl":{"stringUnit":{"state":"translated","value":"Het Mac-knooppunt is niet gereed geworden."}},"fa":{"stringUnit":{"state":"translated","value":"گره Mac آماده نشد."}},"ru":{"stringUnit":{"state":"translated","value":"Узел Mac не перешёл в состояние готовности."}},"sv":{"stringUnit":{"state":"translated","value":"Mac-noden blev inte klar."}}}},
    "The Mac node did not restart.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Mac node did not restart."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Mac 节点未重启。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Mac 節點未重新啟動。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O nó do Mac não foi reiniciado."}},"de":{"stringUnit":{"state":"translated","value":"Der Mac-Knoten wurde nicht neu gestartet."}},"es":{"stringUnit":{"state":"translated","value":"El nodo de Mac no se reinició."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Mac ノードは再起動しませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"Mac 노드가 다시 시작되지 않았습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le nœud Mac n’a pas redémarré."}},"hi":{"stringUnit":{"state":"translated","value":"Mac नोड पुनः आरंभ नहीं हुआ।"}},"ar":{"stringUnit":{"state":"translated","value":"لم تُعَد تشغيل عقدة Mac."}},"it":{"stringUnit":{"state":"translated","value":"Il nodo Mac non si è riavviato."}},"tr":{"stringUnit":{"state":"translated","value":"Mac düğümü yeniden başlatılmadı."}},"uk":{"stringUnit":{"state":"translated","value":"Вузол Mac не перезапустився."}},"id":{"stringUnit":{"state":"translated","value":"Node Mac tidak dimulai ulang."}},"pl":{"stringUnit":{"state":"translated","value":"Węzeł Maca nie uruchomił się ponownie."}},"th":{"stringUnit":{"state":"translated","value":"โหนด Mac ไม่ได้รีสตาร์ท"}},"vi":{"stringUnit":{"state":"translated","value":"Nút Mac không khởi động lại."}},"nl":{"stringUnit":{"state":"translated","value":"Het Mac-knooppunt is niet opnieuw gestart."}},"fa":{"stringUnit":{"state":"translated","value":"گره Mac راه‌اندازی مجدد نشد."}},"ru":{"stringUnit":{"state":"translated","value":"Узел Mac не перезапустился."}},"sv":{"stringUnit":{"state":"translated","value":"Mac-noden startades inte om."}}}},
    "The OpenClaw Gateway could not be verified. Setup will repair it.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The OpenClaw Gateway could not be verified. Setup will repair it."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法验证 OpenClaw Gateway。设置将对其进行修复。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法驗證 OpenClaw Gateway。設定將會修復它。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível verificar o OpenClaw Gateway. A configuração irá repará-lo."}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway konnte nicht verifiziert werden. Die Einrichtung wird ihn reparieren."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo verificar OpenClaw Gateway. La configuración lo reparará."}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway を検証できませんでした。セットアップで修復します。"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway를 확인할 수 없습니다. 설정에서 복구합니다."}},"fr":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway n’a pas pu être vérifié. La configuration va le réparer."}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway सत्यापित नहीं किया जा सका। सेटअप इसे सुधार देगा।"}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر التحقق من OpenClaw Gateway. سيقوم الإعداد بإصلاحه."}},"it":{"stringUnit":{"state":"translated","value":"Non è stato possibile verificare OpenClaw Gateway. La configurazione lo riparerà."}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway doğrulanamadı. Kurulum bunu onaracak."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося перевірити OpenClaw Gateway. Налаштування відновить його."}},"id":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway tidak dapat diverifikasi. Penyiapan akan memperbaikinya."}},"pl":{"stringUnit":{"state":"translated","value":"Nie można było zweryfikować OpenClaw Gateway. Konfiguracja go naprawi."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถตรวจสอบ OpenClaw Gateway ได้ การตั้งค่าจะซ่อมแซมให้"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể xác minh OpenClaw Gateway. Quá trình thiết lập sẽ sửa lỗi này."}},"nl":{"stringUnit":{"state":"translated","value":"De OpenClaw Gateway kon niet worden geverifieerd. De configuratie zal dit herstellen."}},"fa":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway تأیید نشد. راه‌اندازی آن را تعمیر خواهد کرد."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось проверить OpenClaw Gateway. Установка исправит это."}},"sv":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway kunde inte verifieras. Installationen reparerar den."}}}},
    "The Voice Wake and push-to-talk controls are hidden on older macOS versions.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Voice Wake and push-to-talk controls are hidden on older macOS versions."}},"zh-CN":{"stringUnit":{"state":"translated","value":"在较旧的 macOS 版本上，Voice Wake 和一键通控件会被隐藏。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Voice Wake 和隨按即說控制項在較舊的 macOS 版本上會隱藏。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Os controles de Voice Wake e push-to-talk ficam ocultos em versões mais antigas do macOS."}},"de":{"stringUnit":{"state":"translated","value":"Die Steuerelemente für Voice Wake und Push-to-Talk sind auf älteren macOS-Versionen ausgeblendet."}},"es":{"stringUnit":{"state":"translated","value":"Los controles de Voice Wake y pulsar para hablar están ocultos en versiones anteriores de macOS."}},"ja-JP":{"stringUnit":{"state":"translated","value":"古いmacOSバージョンでは、Voice Wakeとプッシュトゥトークのコントロールは非表示になります。"}},"ko":{"stringUnit":{"state":"translated","value":"이전 macOS 버전에서는 Voice Wake 및 푸시 투 토크 컨트롤이 숨겨집니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les commandes Voice Wake et push-to-talk sont masquées sur les anciennes versions de macOS."}},"hi":{"stringUnit":{"state":"translated","value":"पुराने macOS संस्करणों पर Voice Wake और push-to-talk नियंत्रण छिपे रहते हैं।"}},"ar":{"stringUnit":{"state":"translated","value":"تكون عناصر التحكم في Voice Wake والضغط للتحدث مخفية على إصدارات macOS الأقدم."}},"it":{"stringUnit":{"state":"translated","value":"I controlli Voice Wake e push-to-talk sono nascosti nelle versioni precedenti di macOS."}},"tr":{"stringUnit":{"state":"translated","value":"Voice Wake ve bas-konuş kontrolleri eski macOS sürümlerinde gizlidir."}},"uk":{"stringUnit":{"state":"translated","value":"Елементи керування Voice Wake і push-to-talk приховані в старіших версіях macOS."}},"id":{"stringUnit":{"state":"translated","value":"Kontrol Voice Wake dan push-to-talk disembunyikan pada versi macOS yang lebih lama."}},"pl":{"stringUnit":{"state":"translated","value":"Elementy sterujące Voice Wake i push-to-talk są ukryte w starszych wersjach macOS."}},"th":{"stringUnit":{"state":"translated","value":"ตัวควบคุม Voice Wake และ push-to-talk จะถูกซ่อนใน macOS เวอร์ชันเก่า"}},"vi":{"stringUnit":{"state":"translated","value":"Các điều khiển Voice Wake và nhấn để nói bị ẩn trên các phiên bản macOS cũ hơn."}},"nl":{"stringUnit":{"state":"translated","value":"De bedieningselementen voor Voice Wake en push-to-talk zijn verborgen op oudere macOS-versies."}},"fa":{"stringUnit":{"state":"translated","value":"کنترل‌های Voice Wake و فشار برای صحبت در نسخه‌های قدیمی‌تر macOS پنهان هستند."}},"ru":{"stringUnit":{"state":"translated","value":"Элементы управления Voice Wake и push-to-talk скрыты в более старых версиях macOS."}},"sv":{"stringUnit":{"state":"translated","value":"Kontrollerna för Voice Wake och push-to-talk är dolda på äldre macOS-versioner."}}}},
    "The WebSocket URL exposed by the remote Gateway.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The WebSocket URL exposed by the remote Gateway."}},"zh-CN":{"stringUnit":{"state":"translated","value":"远程 Gateway 暴露的 WebSocket URL。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"遠端 Gateway 公開的 WebSocket URL。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A URL do WebSocket exposta pelo Gateway remoto."}},"de":{"stringUnit":{"state":"translated","value":"Die WebSocket-URL, die von der Remote-Gateway bereitgestellt wird."}},"es":{"stringUnit":{"state":"translated","value":"La URL de WebSocket expuesta por el Gateway remoto."}},"ja-JP":{"stringUnit":{"state":"translated","value":"リモート Gateway によって公開される WebSocket URL。"}},"ko":{"stringUnit":{"state":"translated","value":"원격 Gateway에서 노출한 WebSocket URL입니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’URL WebSocket exposée par le Gateway distant."}},"hi":{"stringUnit":{"state":"translated","value":"रिमोट Gateway द्वारा एक्सपोज़ किया गया WebSocket URL."}},"ar":{"stringUnit":{"state":"translated","value":"عنوان URL لـ WebSocket الذي يعرّضه Gateway البعيد."}},"it":{"stringUnit":{"state":"translated","value":"L'URL WebSocket esposto dal Gateway remoto."}},"tr":{"stringUnit":{"state":"translated","value":"Uzak Gateway tarafından sunulan WebSocket URL’si."}},"uk":{"stringUnit":{"state":"translated","value":"URL WebSocket, наданий віддаленим Gateway."}},"id":{"stringUnit":{"state":"translated","value":"URL WebSocket yang diekspos oleh Gateway jarak jauh."}},"pl":{"stringUnit":{"state":"translated","value":"Adres URL WebSocket udostępniany przez zdalny Gateway."}},"th":{"stringUnit":{"state":"translated","value":"URL WebSocket ที่เปิดให้ใช้งานโดย Gateway ระยะไกล"}},"vi":{"stringUnit":{"state":"translated","value":"URL WebSocket được Gateway từ xa hiển thị."}},"nl":{"stringUnit":{"state":"translated","value":"De WebSocket-URL die door de externe Gateway wordt aangeboden."}},"fa":{"stringUnit":{"state":"translated","value":"نشانی WebSocket که توسط Gateway راه‌دور در دسترس قرار گرفته است."}},"ru":{"stringUnit":{"state":"translated","value":"URL WebSocket, предоставляемый удаленным Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"WebSocket-URL:en som exponeras av den fjärranslutna Gateway."}}}},
    "The current gateway.remote.token value is not plain text. OpenClaw for macOS cannot use it directly; enter a plaintext token here to replace it.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The current gateway.remote.token value is not plain text. OpenClaw for macOS cannot use it directly; enter a plaintext token here to replace it."}},"zh-CN":{"stringUnit":{"state":"translated","value":"当前 gateway.remote.token 值不是纯文本。OpenClaw for macOS 无法直接使用它；请在此输入纯文本令牌以替换它。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"目前的 gateway.remote.token 值不是純文字。OpenClaw for macOS 無法直接使用；請在此輸入純文字 token 以取代它。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O valor atual de gateway.remote.token não está em texto simples. O OpenClaw para macOS não pode usá-lo diretamente; insira um token em texto simples aqui para substituí-lo."}},"de":{"stringUnit":{"state":"translated","value":"Der aktuelle Wert von gateway.remote.token ist kein Klartext. OpenClaw für macOS kann ihn nicht direkt verwenden; geben Sie hier ein Klartext-Token ein, um ihn zu ersetzen."}},"es":{"stringUnit":{"state":"translated","value":"El valor actual de gateway.remote.token no es texto sin formato. OpenClaw para macOS no puede usarlo directamente; introduce aquí un token en texto sin formato para reemplazarlo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"現在の gateway.remote.token の値はプレーンテキストではありません。OpenClaw for macOS では直接使用できません。置き換えるには、ここにプレーンテキストのトークンを入力してください。"}},"ko":{"stringUnit":{"state":"translated","value":"현재 gateway.remote.token 값은 일반 텍스트가 아닙니다. macOS용 OpenClaw에서 직접 사용할 수 없으므로, 이를 대체할 일반 텍스트 토큰을 여기에 입력하세요."}},"fr":{"stringUnit":{"state":"translated","value":"La valeur actuelle de gateway.remote.token n’est pas en texte brut. OpenClaw pour macOS ne peut pas l’utiliser directement ; saisissez ici un jeton en texte brut pour la remplacer."}},"hi":{"stringUnit":{"state":"translated","value":"मौजूदा gateway.remote.token मान सादा टेक्स्ट नहीं है. macOS के लिए OpenClaw इसे सीधे उपयोग नहीं कर सकता; इसे बदलने के लिए यहाँ एक plaintext टोकन दर्ज करें."}},"ar":{"stringUnit":{"state":"translated","value":"قيمة gateway.remote.token الحالية ليست نصًا عاديًا. لا يمكن لـ OpenClaw for macOS استخدامها مباشرةً؛ أدخل رمزًا بنص عادي هنا لاستبدالها."}},"it":{"stringUnit":{"state":"translated","value":"Il valore attuale di gateway.remote.token non è in testo normale. OpenClaw per macOS non può usarlo direttamente; inserisci qui un token in testo normale per sostituirlo."}},"tr":{"stringUnit":{"state":"translated","value":"Geçerli gateway.remote.token değeri düz metin değil. macOS için OpenClaw bunu doğrudan kullanamaz; değiştirmek için buraya düz metin bir token girin."}},"uk":{"stringUnit":{"state":"translated","value":"Поточне значення gateway.remote.token не є звичайним текстом. OpenClaw для macOS не може використовувати його напряму; введіть тут токен у вигляді звичайного тексту, щоб замінити його."}},"id":{"stringUnit":{"state":"translated","value":"Nilai gateway.remote.token saat ini bukan teks biasa. OpenClaw for macOS tidak dapat menggunakannya secara langsung; masukkan token teks biasa di sini untuk menggantinya."}},"pl":{"stringUnit":{"state":"translated","value":"Bieżąca wartość gateway.remote.token nie jest tekstem jawnym. OpenClaw dla macOS nie może użyć jej bezpośrednio; wprowadź tutaj token w postaci tekstu jawnego, aby ją zastąpić."}},"th":{"stringUnit":{"state":"translated","value":"ค่า gateway.remote.token ปัจจุบันไม่ใช่ข้อความธรรมดา OpenClaw for macOS ไม่สามารถใช้ค่านี้โดยตรงได้ โปรดป้อนโทเค็นแบบ plaintext ที่นี่เพื่อแทนที่"}},"vi":{"stringUnit":{"state":"translated","value":"Giá trị gateway.remote.token hiện tại không phải là văn bản thuần túy. OpenClaw for macOS không thể sử dụng trực tiếp; hãy nhập token dạng văn bản thuần túy tại đây để thay thế."}},"nl":{"stringUnit":{"state":"translated","value":"De huidige waarde van gateway.remote.token is geen platte tekst. OpenClaw voor macOS kan deze niet rechtstreeks gebruiken; voer hier een plaintext-token in om deze te vervangen."}},"fa":{"stringUnit":{"state":"translated","value":"مقدار فعلی gateway.remote.token متن ساده نیست. OpenClaw برای macOS نمی‌تواند مستقیماً از آن استفاده کند؛ برای جایگزینی، یک توکن متن ساده را اینجا وارد کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Текущее значение gateway.remote.token не является обычным текстом. OpenClaw для macOS не может использовать его напрямую; введите здесь токен в виде обычного текста, чтобы заменить его."}},"sv":{"stringUnit":{"state":"translated","value":"Det aktuella värdet för gateway.remote.token är inte klartext. OpenClaw för macOS kan inte använda det direkt; ange en klartexttoken här för att ersätta det."}}}},
    "The details are listed on each option above. You can fix the login and retry, or connect with an API key or token below.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The details are listed on each option above. You can fix the login and retry, or connect with an API key or token below."}},"zh-CN":{"stringUnit":{"state":"translated","value":"详细信息列在上方每个选项中。你可以修正登录信息后重试，或在下方使用 API 密钥或令牌连接。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"詳細資訊列在上方每個選項中。您可以修正登入資訊後重試，或使用下方的 API 金鑰或權杖連接。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Os detalhes estão listados em cada opção acima. Você pode corrigir o login e tentar de novo, ou conectar com uma chave de API ou token abaixo."}},"de":{"stringUnit":{"state":"translated","value":"Die Details sind bei jeder Option oben aufgeführt. Du kannst die Anmeldung korrigieren und es erneut versuchen oder dich unten mit einem API-Schlüssel oder Token verbinden."}},"es":{"stringUnit":{"state":"translated","value":"Los detalles se muestran en cada opción de arriba. Puedes corregir el inicio de sesión y reintentar, o conectarte con una clave de API o token a continuación."}},"ja-JP":{"stringUnit":{"state":"translated","value":"詳細は上記の各オプションに記載されています。ログインを修正して再試行するか、下記の API キーまたはトークンで接続できます。"}},"ko":{"stringUnit":{"state":"translated","value":"자세한 내용은 위 각 옵션에 표시되어 있습니다. 로그인을 수정한 후 다시 시도하거나, 아래에서 API 키 또는 토큰으로 연결할 수 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les détails sont indiqués pour chaque option ci-dessus. Vous pouvez corriger la connexion et réessayer, ou vous connecter avec une clé API ou un jeton ci-dessous."}},"hi":{"stringUnit":{"state":"translated","value":"विवरण ऊपर प्रत्येक विकल्प पर सूचीबद्ध हैं। आप लॉगिन ठीक करके फिर से प्रयास कर सकते हैं, या नीचे API key या token से कनेक्ट कर सकते हैं।"}},"ar":{"stringUnit":{"state":"translated","value":"التفاصيل مدرجة على كل خيار أعلاه. يمكنك إصلاح تسجيل الدخول وإعادة المحاولة، أو الاتصال باستخدام مفتاح API أو رمز مميز أدناه."}},"it":{"stringUnit":{"state":"translated","value":"I dettagli sono elencati per ciascuna opzione qui sopra. Puoi correggere l'accesso e riprovare, oppure connetterti con una chiave API o un token qui sotto."}},"tr":{"stringUnit":{"state":"translated","value":"Ayrıntılar yukarıdaki her seçenekte listeleniyor. Girişi düzeltip yeniden deneyebilir veya aşağıda bir API anahtarı ya da token ile bağlanabilirsiniz."}},"uk":{"stringUnit":{"state":"translated","value":"Деталі наведено для кожного варіанта вище. Ви можете виправити вхід і повторити спробу або підключитися за допомогою ключа API чи токена нижче."}},"id":{"stringUnit":{"state":"translated","value":"Detailnya tercantum pada setiap opsi di atas. Anda dapat memperbaiki login dan mencoba lagi, atau terhubung dengan kunci API atau token di bawah."}},"pl":{"stringUnit":{"state":"translated","value":"Szczegóły są wymienione przy każdej opcji powyżej. Możesz poprawić logowanie i spróbować ponownie lub połączyć się za pomocą klucza API albo tokena poniżej."}},"th":{"stringUnit":{"state":"translated","value":"รายละเอียดแสดงอยู่ในแต่ละตัวเลือกด้านบน คุณสามารถแก้ไขการเข้าสู่ระบบและลองใหม่ หรือเชื่อมต่อด้วย API key หรือโทเค็นด้านล่าง"}},"vi":{"stringUnit":{"state":"translated","value":"Chi tiết được liệt kê ở mỗi tùy chọn phía trên. Bạn có thể sửa đăng nhập rồi thử lại, hoặc kết nối bằng khóa API hoặc token bên dưới."}},"nl":{"stringUnit":{"state":"translated","value":"De details staan bij elke optie hierboven. Je kunt de login herstellen en opnieuw proberen, of hieronder verbinden met een API-sleutel of token."}},"fa":{"stringUnit":{"state":"translated","value":"جزئیات هر گزینه در بالا فهرست شده است. می‌توانید ورود را اصلاح کرده و دوباره تلاش کنید، یا با کلید API یا توکن در پایین متصل شوید."}},"ru":{"stringUnit":{"state":"translated","value":"Подробности указаны для каждого варианта выше. Вы можете исправить вход и повторить попытку или подключиться с помощью API-ключа или токена ниже."}},"sv":{"stringUnit":{"state":"translated","value":"Detaljerna listas för varje alternativ ovan. Du kan åtgärda inloggningen och försöka igen, eller ansluta med en API-nyckel eller token nedan."}}}},
    "The earlier conversation was cleared.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The earlier conversation was cleared."}},"zh-CN":{"stringUnit":{"state":"translated","value":"先前的对话已被清除。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"先前的對話已清除。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A conversa anterior foi apagada."}},"de":{"stringUnit":{"state":"translated","value":"Die vorherige Konversation wurde gelöscht."}},"es":{"stringUnit":{"state":"translated","value":"Se borró la conversación anterior."}},"ja-JP":{"stringUnit":{"state":"translated","value":"以前の会話はクリアされました。"}},"ko":{"stringUnit":{"state":"translated","value":"이전 대화가 지워졌습니다."}},"fr":{"stringUnit":{"state":"translated","value":"La conversation précédente a été effacée."}},"hi":{"stringUnit":{"state":"translated","value":"पिछली बातचीत साफ़ कर दी गई थी।"}},"ar":{"stringUnit":{"state":"translated","value":"تم مسح المحادثة السابقة."}},"it":{"stringUnit":{"state":"translated","value":"La conversazione precedente è stata cancellata."}},"tr":{"stringUnit":{"state":"translated","value":"Önceki konuşma temizlendi."}},"uk":{"stringUnit":{"state":"translated","value":"Попередню розмову очищено."}},"id":{"stringUnit":{"state":"translated","value":"Percakapan sebelumnya telah dihapus."}},"pl":{"stringUnit":{"state":"translated","value":"Wcześniejsza rozmowa została wyczyszczona."}},"th":{"stringUnit":{"state":"translated","value":"บทสนทนาก่อนหน้าถูกล้างแล้ว"}},"vi":{"stringUnit":{"state":"translated","value":"Cuộc trò chuyện trước đó đã được xóa."}},"nl":{"stringUnit":{"state":"translated","value":"Het eerdere gesprek is gewist."}},"fa":{"stringUnit":{"state":"translated","value":"گفتگوی قبلی پاک شد."}},"ru":{"stringUnit":{"state":"translated","value":"Предыдущий разговор был очищен."}},"sv":{"stringUnit":{"state":"translated","value":"Den tidigare konversationen rensades."}}}},
    "The full message could not be loaded.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The full message could not be loaded."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法加载完整消息。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法載入完整訊息。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível carregar a mensagem completa."}},"de":{"stringUnit":{"state":"translated","value":"Die vollständige Nachricht konnte nicht geladen werden."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo cargar el mensaje completo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"メッセージ全文を読み込めませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"전체 메시지를 불러올 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le message complet n’a pas pu être chargé."}},"hi":{"stringUnit":{"state":"translated","value":"पूरा संदेश लोड नहीं किया जा सका।"}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر تحميل الرسالة الكاملة."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile caricare il messaggio completo."}},"tr":{"stringUnit":{"state":"translated","value":"Tam ileti yüklenemedi."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося завантажити повне повідомлення."}},"id":{"stringUnit":{"state":"translated","value":"Pesan lengkap tidak dapat dimuat."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się wczytać pełnej wiadomości."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถโหลดข้อความฉบับเต็มได้"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể tải toàn bộ tin nhắn."}},"nl":{"stringUnit":{"state":"translated","value":"Het volledige bericht kon niet worden geladen."}},"fa":{"stringUnit":{"state":"translated","value":"پیام کامل بارگذاری نشد."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось загрузить полное сообщение."}},"sv":{"stringUnit":{"state":"translated","value":"Det gick inte att läsa in hela meddelandet."}}}},
    "The full message has no readable text.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The full message has no readable text."}},"zh-CN":{"stringUnit":{"state":"translated","value":"完整消息中没有可读文本。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"完整訊息中沒有可讀取的文字。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A mensagem completa não contém texto legível."}},"de":{"stringUnit":{"state":"translated","value":"Die vollständige Nachricht enthält keinen lesbaren Text."}},"es":{"stringUnit":{"state":"translated","value":"El mensaje completo no contiene texto legible."}},"ja-JP":{"stringUnit":{"state":"translated","value":"メッセージ全文に読み取れるテキストがありません。"}},"ko":{"stringUnit":{"state":"translated","value":"전체 메시지에 읽을 수 있는 텍스트가 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le message complet ne contient aucun texte lisible."}},"hi":{"stringUnit":{"state":"translated","value":"पूरे संदेश में पढ़ने योग्य कोई टेक्स्ट नहीं है।"}},"ar":{"stringUnit":{"state":"translated","value":"لا تحتوي الرسالة الكاملة على نص قابل للقراءة."}},"it":{"stringUnit":{"state":"translated","value":"Il messaggio completo non contiene testo leggibile."}},"tr":{"stringUnit":{"state":"translated","value":"Tam iletide okunabilir metin yok."}},"uk":{"stringUnit":{"state":"translated","value":"Повне повідомлення не містить тексту, який можна прочитати."}},"id":{"stringUnit":{"state":"translated","value":"Pesan lengkap tidak memiliki teks yang dapat dibaca."}},"pl":{"stringUnit":{"state":"translated","value":"Pełna wiadomość nie zawiera tekstu możliwego do odczytania."}},"th":{"stringUnit":{"state":"translated","value":"ข้อความฉบับเต็มไม่มีข้อความที่อ่านได้"}},"vi":{"stringUnit":{"state":"translated","value":"Toàn bộ tin nhắn không có văn bản có thể đọc được."}},"nl":{"stringUnit":{"state":"translated","value":"Het volledige bericht bevat geen leesbare tekst."}},"fa":{"stringUnit":{"state":"translated","value":"پیام کامل متن خوانایی ندارد."}},"ru":{"stringUnit":{"state":"translated","value":"В полном сообщении нет читаемого текста."}},"sv":{"stringUnit":{"state":"translated","value":"Hela meddelandet saknar läsbar text."}}}},
    "The full message is no longer available.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The full message is no longer available."}},"zh-CN":{"stringUnit":{"state":"translated","value":"完整消息已不再可用。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"完整訊息已無法取得。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A mensagem completa não está mais disponível."}},"de":{"stringUnit":{"state":"translated","value":"Die vollständige Nachricht ist nicht mehr verfügbar."}},"es":{"stringUnit":{"state":"translated","value":"El mensaje completo ya no está disponible."}},"ja-JP":{"stringUnit":{"state":"translated","value":"メッセージ全文は利用できなくなりました。"}},"ko":{"stringUnit":{"state":"translated","value":"전체 메시지를 더 이상 사용할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le message complet n’est plus disponible."}},"hi":{"stringUnit":{"state":"translated","value":"पूरा संदेश अब उपलब्ध नहीं है।"}},"ar":{"stringUnit":{"state":"translated","value":"لم تعد الرسالة الكاملة متاحة."}},"it":{"stringUnit":{"state":"translated","value":"Il messaggio completo non è più disponibile."}},"tr":{"stringUnit":{"state":"translated","value":"Tam ileti artık kullanılamıyor."}},"uk":{"stringUnit":{"state":"translated","value":"Повне повідомлення більше недоступне."}},"id":{"stringUnit":{"state":"translated","value":"Pesan lengkap sudah tidak tersedia."}},"pl":{"stringUnit":{"state":"translated","value":"Pełna wiadomość nie jest już dostępna."}},"th":{"stringUnit":{"state":"translated","value":"ข้อความฉบับเต็มไม่พร้อมใช้งานแล้ว"}},"vi":{"stringUnit":{"state":"translated","value":"Toàn bộ tin nhắn không còn khả dụng."}},"nl":{"stringUnit":{"state":"translated","value":"Het volledige bericht is niet meer beschikbaar."}},"fa":{"stringUnit":{"state":"translated","value":"پیام کامل دیگر در دسترس نیست."}},"ru":{"stringUnit":{"state":"translated","value":"Полное сообщение больше недоступно."}},"sv":{"stringUnit":{"state":"translated","value":"Hela meddelandet är inte längre tillgängligt."}}}},
    "The legacy native pane can be re-enabled in Settings > Debug.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The legacy native pane can be re-enabled in Settings > Debug."}},"zh-CN":{"stringUnit":{"state":"translated","value":"可在“设置 > 调试”中重新启用旧版原生面板。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"可在「設定」>「Debug」中重新啟用舊版原生面板。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O painel nativo legado pode ser reativado em Configurações > Depuração."}},"de":{"stringUnit":{"state":"translated","value":"Der veraltete native Bereich kann unter Einstellungen > Debug wieder aktiviert werden."}},"es":{"stringUnit":{"state":"translated","value":"El panel nativo heredado se puede volver a activar en Configuración > Depuración."}},"ja-JP":{"stringUnit":{"state":"translated","value":"従来のネイティブペインは Settings > Debug で再度有効にできます。"}},"ko":{"stringUnit":{"state":"translated","value":"레거시 네이티브 창은 Settings > Debug에서 다시 활성화할 수 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"L'ancien panneau natif peut être réactivé dans Réglages > Débogage."}},"hi":{"stringUnit":{"state":"translated","value":"लीगेसी नेटिव पेन को Settings > Debug में फिर से सक्षम किया जा सकता है।"}},"ar":{"stringUnit":{"state":"translated","value":"يمكن إعادة تفعيل الجزء الأصلي القديم من الإعدادات > التصحيح."}},"it":{"stringUnit":{"state":"translated","value":"Il pannello nativo legacy può essere riattivato in Impostazioni > Debug."}},"tr":{"stringUnit":{"state":"translated","value":"Eski yerel bölme Ayarlar > Debug bölümünden yeniden etkinleştirilebilir."}},"uk":{"stringUnit":{"state":"translated","value":"Застарілу нативну панель можна знову ввімкнути в Settings > Debug."}},"id":{"stringUnit":{"state":"translated","value":"Panel native lama dapat diaktifkan kembali di Settings > Debug."}},"pl":{"stringUnit":{"state":"translated","value":"Starszy natywny panel można ponownie włączyć w Ustawienia > Debugowanie."}},"th":{"stringUnit":{"state":"translated","value":"สามารถเปิด