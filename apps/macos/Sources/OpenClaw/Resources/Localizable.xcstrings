    "Serve uses Tailscale identity headers; no password required.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Serve uses Tailscale identity headers; no password required."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Serve 使用 Tailscale 身份标头; 无需密码。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Serve 使用 Tailscale 身分識別標頭; 無需密碼。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Serve usa cabeçalhos de identidade do Tailscale; nenhuma senha é necessária."}},"de":{"stringUnit":{"state":"translated","value":"Serve verwendet Tailscale-Identitätsheader; kein Passwort erforderlich."}},"es":{"stringUnit":{"state":"translated","value":"Serve usa encabezados de identidad de Tailscale; no se requiere contraseña."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ServeはTailscaleのIDヘッダーを使用します; パスワードは不要です。"}},"ko":{"stringUnit":{"state":"translated","value":"Serve는 Tailscale ID 헤더를 사용합니다; 비밀번호가 필요하지 않습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Serve utilise les en-têtes d’identité Tailscale ; aucun mot de passe requis."}},"hi":{"stringUnit":{"state":"translated","value":"Serve, Tailscale पहचान हेडर का उपयोग करता है; पासवर्ड आवश्यक नहीं है."}},"ar":{"stringUnit":{"state":"translated","value":"يستخدم Serve ترويسات هوية Tailscale؛ لا يلزم إدخال كلمة مرور."}},"it":{"stringUnit":{"state":"translated","value":"Serve utilizza le intestazioni di identità di Tailscale; non è richiesta alcuna password."}},"tr":{"stringUnit":{"state":"translated","value":"Serve, Tailscale kimlik üst bilgilerini kullanır; parola gerekmez."}},"uk":{"stringUnit":{"state":"translated","value":"Serve використовує заголовки ідентифікації Tailscale; пароль не потрібен."}},"id":{"stringUnit":{"state":"translated","value":"Serve menggunakan header identitas Tailscale; tidak memerlukan kata sandi."}},"pl":{"stringUnit":{"state":"translated","value":"Serve używa nagłówków tożsamości Tailscale; hasło nie jest wymagane."}},"th":{"stringUnit":{"state":"t