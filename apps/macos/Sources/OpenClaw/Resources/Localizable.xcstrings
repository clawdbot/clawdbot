    "That token did not match the gateway": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"That token did not match the gateway"}},"zh-CN":{"stringUnit":{"state":"translated","value":"该令牌与 Gateway 不匹配"}},"zh-TW":{"stringUnit":{"state":"translated","value":"該權杖與 Gateway 不相符"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Esse token não correspondeu ao gateway"}},"de":{"stringUnit":{"state":"translated","value":"Dieses Token stimmte nicht mit der Gateway überein"}},"es":{"stringUnit":{"state":"translated","value":"Ese token no coincide con el gateway"}},"ja-JP":{"stringUnit":{"state":"translated","value":"そのトークンは Gateway と一致しませんでした"}},"ko":{"stringUnit":{"state":"translated","value":"해당 토큰이 Gateway와 일치하지 않습니다"}},"fr":{"stringUnit":{"state":"translated","value":"Ce jeton ne correspond pas au Gateway"}},"hi":{"stringUnit":{"state":"translated","value":"वह token gateway से मेल नहीं खाया"}},"ar":{"stringUnit":{"state":"translated","value":"لم يطابق ذلك الرمز Gateway"}},"it":{"stringUnit":{"state":"translated","value":"Quel token non corrisponde al gateway"}},"tr":{"stringUnit":{"state":"translated","value":"Bu token gateway ile eşleşmedi"}},"uk":{"stringUnit":{"state":"translated","value":"Цей токен не відповідає gateway"}},"id":{"stringUnit":{"state":"translated","value":"Token tersebut tidak cocok dengan gateway"}},"pl":{"stringUnit":{"state":"translated","value":"Ten token nie pasuje do gateway"}},"th":{"stringUnit":{"state":"translated","value":"โทเค็นนั้นไม่ตรงกับ Gateway"}},"vi":{"stringUnit":{"state":"translated","value":"Mã đó không khớp với Gateway"}},"nl":{"stringUnit":{"state":"translated","value":"Dat token kwam niet overeen met de gateway"}},"fa":{"stringUnit":{"state":"translated","value":"آن توکن با Gateway مطابقت نداشت"}},"ru":{"stringUnit":{"state":"translated","value":"Этот токен не соответствует gateway"}},"sv":{"stringUnit":{"state":"translated","value":"Den token matchade inte Gateway"}}}},
    "The Gateway connection changed. Restart OpenClaw to reconnect.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Gateway connection changed. Restart OpenClaw to reconnect."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Gateway 连接已更改。请重新启动 OpenClaw 以重新连接。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 連線已變更。請重新啟動 OpenClaw 以重新連線。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A conexão com o Gateway mudou. Reinicie o OpenClaw para reconectar."}},"de":{"stringUnit":{"state":"translated","value":"Die Gateway-Verbindung hat sich geändert. Starten Sie OpenClaw neu, um die Verbindung wiederherzustellen."}},"es":{"stringUnit":{"state":"translated","value":"La conexión con el Gateway cambió. Reinicia OpenClaw para volver a conectarlo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gateway接続が変更されました。再接続するにはOpenClawを再起動してください。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway 연결이 변경되었습니다. 다시 연결하려면 OpenClaw를 재시작하세요."}},"fr":{"stringUnit":{"state":"translated","value":"La connexion au Gateway a changé. Redémarrez OpenClaw pour vous reconnecter."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway कनेक्शन बदल गया है। फिर से कनेक्ट करने के लिए OpenClaw को रीस्टार्ट करें।"}},"ar":{"stringUnit":{"state":"translated","value":"تغير اتصال Gateway. أعد تشغيل OpenClaw لإعادة الاتصال."}},"it":{"stringUnit":{"state":"translated","value":"La connessione al Gateway è cambiata. Riavvia OpenClaw per riconnetterti."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway bağlantısı değişti. Yeniden bağlanmak için OpenClaw'ı yeniden başlatın."}},"uk":{"stringUnit":{"state":"translated","value":"З’єднання з Gateway змінилося. Перезапустіть OpenClaw, щоб підключитися знову."}},"id":{"stringUnit":{"state":"translated","value":"Koneksi Gateway berubah. Mulai ulang OpenClaw untuk menghubungkan kembali."}},"pl":{"stringUnit":{"state":"translated","value":"Połączenie z Gateway uległo zmianie. Uruchom ponownie OpenClaw, aby połączyć się ponownie."}},"th":{"stringUnit":{"state":"translated","value":"การเชื่อมต่อ Gateway มีการเปลี่ยนแปลง เริ่ม OpenClaw ใหม่เพื่อเชื่อมต่ออีกครั้ง"}},"vi":{"stringUnit":{"state":"translated","value":"Kết nối Gateway đã thay đổi. Hãy khởi động lại OpenClaw để kết nối lại."}},"nl":{"stringUnit":{"state":"translated","value":"De Gateway-verbinding is gewijzigd. Start OpenClaw opnieuw om opnieuw verbinding te maken."}},"fa":{"stringUnit":{"state":"translated","value":"اتصال Gateway تغییر کرد. برای اتصال مجدد، OpenClaw را راه‌اندازی مجدد کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Подключение к Gateway изменилось. Перезапустите OpenClaw, чтобы подключиться заново."}},"sv":{"stringUnit":{"state":"translated","value":"Anslutningen till Gateway ändrades. Starta om OpenClaw för att återansluta."}}}},
    "The Gateway could not be checked.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Gateway could not be checked."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法检查 Gateway。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法檢查 Gateway。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível verificar o Gateway."}},"de":{"stringUnit":{"state":"translated","value":"Das Gateway konnte nicht überprüft werden."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo comprobar Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayを確認できませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway를 확인할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le Gateway n’a pas pu être vérifié."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway की जाँच नहीं की जा सकी।"}},"ar":{"stringUnit":{"state":"translated","value":"تعذر التحقق من Gateway."}},"it":{"stringUnit":{"state":"translated","value":"Non è stato possibile verificare il Gateway."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway kontrol edilemedi."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося перевірити Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Gateway tidak dapat diperiksa."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się sprawdzić Gateway."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถตรวจสอบ Gateway ได้"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể kiểm tra Gateway."}},"nl":{"stringUnit":{"state":"translated","value":"De Gateway kon niet worden gecontroleerd."}},"fa":{"stringUnit":{"state":"translated","value":"بررسی Gateway ممکن نبود."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось проверить Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Gateway kunde inte kontrolleras."}}}},
    "The Gateway could not reconnect.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Gateway could not reconnect."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Gateway 无法重新连接。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 無法重新連線。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Gateway não conseguiu se reconectar."}},"de":{"stringUnit":{"state":"translated","value":"Das Gateway konnte die Verbindung nicht wiederherstellen."}},"es":{"stringUnit":{"state":"translated","value":"El Gateway no pudo volver a conectarse."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gateway は再接続できませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway에서 다시 연결하지 못했습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le Gateway n’a pas pu se reconnecter."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway दोबारा कनेक्ट नहीं हो सका।"}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر على Gateway إعادة الاتصال."}},"it":{"stringUnit":{"state":"translated","value":"Il Gateway non ha potuto riconnettersi."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway yeniden bağlanamadı."}},"uk":{"stringUnit":{"state":"translated","value":"Gateway не вдалося повторно підключитися."}},"id":{"stringUnit":{"state":"translated","value":"Gateway tidak dapat terhubung kembali."}},"pl":{"stringUnit":{"state":"translated","value":"Gateway nie mógł ponownie nawiązać połączenia."}},"th":{"stringUnit":{"state":"translated","value":"Gateway ไม่สามารถเชื่อมต่อใหม่ได้"}},"vi":{"stringUnit":{"state":"translated","value":"Gateway không thể kết nối lại."}},"nl":{"stringUnit":{"state":"translated","value":"De Gateway kon niet opnieuw verbinding maken."}},"fa":{"stringUnit":{"state":"translated","value":"Gateway نتوانست دوباره متصل شود."}},"ru":{"stringUnit":{"state":"translated","value":"Gateway не удалось переподключиться."}},"sv":{"stringUnit":{"state":"translated","value":"Gateway kunde inte återansluta."}}