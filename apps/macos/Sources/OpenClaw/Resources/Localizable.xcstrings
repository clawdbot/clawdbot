    "The main thread cannot be deleted.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The main thread cannot be deleted."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法删除主话题串。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法刪除主要討論串。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A conversa principal não pode ser excluída."}},"de":{"stringUnit":{"state":"translated","value":"Der Haupt-Thread kann nicht gelöscht werden."}},"es":{"stringUnit":{"state":"translated","value":"El hilo principal no se puede eliminar."}},"ja-JP":{"stringUnit":{"state":"translated","value":"メインスレッドは削除できません。"}},"ko":{"stringUnit":{"state":"translated","value":"메인 스레드는 삭제할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le fil de discussion principal ne peut pas être supprimé."}},"hi":{"stringUnit":{"state":"translated","value":"मुख्य थ्रेड को डिलीट नहीं किया जा सकता।"}},"ar":{"stringUnit":{"state":"translated","value":"لا يمكن حذف المحادثة الرئيسية."}},"it":{"stringUnit":{"state":"translated","value":"Il thread principale non può essere eliminato."}},"tr":{"stringUnit":{"state":"translated","value":"Ana dizi silinemez."}},"uk":{"stringUnit":{"state":"translated","value":"Основну гілку не можна видалити."}},"id":{"stringUnit":{"state":"translated","value":"Utas utama tidak dapat dihapus."}},"pl":{"stringUnit":{"state":"translated","value":"Nie można usunąć głównego wątku."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถลบเธรดหลักได้"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể xóa chuỗi chính."}},"nl":{"stringUnit":{"state":"translated","value":"Het hoofdgesprek kan niet worden verwijderd."}},"fa":{"stringUnit":{"state":"translated","value":"رشته اصلی را نمی‌توان حذف کرد."}},"ru":{"stringUnit":{"state":"translated","value":"Основную ветку нельзя удалить."}},"sv":{"stringUnit":{"state":"translated","value":"Huvudtråden kan inte raderas."}}}},
    "The managed OpenClaw runtime could not be reinstalled.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The managed OpenClaw runtime could not be reinstalled."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法重新安装由 OpenClaw 管理的运行时。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法重新安裝由 OpenClaw 管理的執行環境。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível reinstalar o ambiente de execução gerenciado do OpenClaw."}},"de":{"stringUnit":{"state":"translated","value":"Die verwaltete OpenClaw-Laufzeitumgebung konnte nicht neu installiert werden."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo reinstalar el entorno de ejecución administrado de OpenClaw."}},"ja-JP":{"stringUnit":{"state":"translated","value":"管理対象のOpenClawランタイムを再インストールできませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"관리형 OpenClaw 런타임을 다시 설치할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’environnement d’exécution OpenClaw géré n’a pas pu être réinstallé."}},"hi":{"stringUnit":{"state":"translated","value":"प्रबंधित OpenClaw रनटाइम को फिर से इंस्टॉल नहीं किया जा सका।"}},"ar":{"stringUnit":{"state":"translated","value":"تعذرت إعادة تثبيت بيئة تشغيل OpenClaw المُدارة."}},"it":{"stringUnit":{"state":"translated","value":"Non è stato possibile reinstallare il runtime OpenClaw gestito."}},"tr":{"stringUnit":{"state":"translated","value":"Yönetilen OpenClaw çalışma zamanı yeniden yüklenemedi."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося повторно встановити кероване середовище виконання OpenClaw."}},"id":{"stringUnit":{"state":"translated","value":"Runtime OpenClaw terkelola tidak dapat diinstal ulang."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się ponownie zainstalować zarządzanego środowiska uruchomieniowego OpenClaw."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถติดตั้งรันไทม์ OpenClaw ที่มีการจัดการใหม่ได้"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể cài đặt lại môi trường chạy OpenClaw được quản lý."}},"nl":{"stringUnit":{"state":"translated","value":"De beheerde OpenClaw-runtime kon niet opnieuw worden geïnstalleerd."}},"fa":{"stringUnit":{"state":"translated","value":"نصب مجدد محیط اجرای مدیریت‌شده OpenClaw ممکن نبود."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось переустановить управляемую среду выполнения OpenClaw."}},"sv":{"stringUnit":{"state":"translated","value":"Den hanterade OpenClaw-körmiljön kunde inte installeras om."}}}},
    "The managed runtime does not match the updated Mac app.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The managed runtime does not match the updated Mac app."}},"zh-CN":{"stringUnit":{"state":"translated","value":"托管运行时与更新后的 Mac 应用不匹配。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"受管理的執行階段與更新後的 Mac App 不相符。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O ambiente de execução gerenciado não corresponde ao aplicativo para Mac atualizado."}},"de":{"stringUnit":{"state":"translated","value":"Die verwaltete Laufzeitumgebung stimmt nicht mit der aktualisierten Mac-App überein."}},"es":{"stringUnit":{"state":"translated","value":"El entorno de ejecución administrado no coincide con la app para Mac actualizada."}},"ja-JP":{"stringUnit":{"state":"translated","value":"管理対象ランタイムが更新後の Mac アプリと一致しません。"}},"ko":{"stringUnit":{"state":"translated","value":"관리형 런타임이 업데이트된 Mac 앱과 일치하지 않습니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’environnement d’exécution géré ne correspond pas à l’app Mac mise à jour."}},"hi":{"stringUnit":{"state":"translated","value":"प्रबंधित रनटाइम अपडेट किए गए Mac ऐप से मेल नहीं खाता।"}},"ar":{"stringUnit":{"state":"translated","value":"لا تتطابق بيئة التشغيل المُدارة مع تطبيق Mac المحدّث."}},"it":{"stringUnit":{"state":"translated","value":"Il runtime gestito non corrisponde all'app per Mac aggiornata."}},"tr":{"stringUnit":{"state":"translated","value":"Yönetilen çalışma zamanı, güncellenmiş Mac uygulamasıyla eşleşmiyor."}},"uk":{"stringUnit":{"state":"translated","value":"Кероване середовище виконання не відповідає оновленій програмі для Mac."}},"id":{"stringUnit":{"state":"translated","value":"Runtime terkelola tidak cocok dengan aplikasi Mac yang diperbarui."}},"pl":{"stringUnit":{"state":"translated","value":"Zarządzane środowisko uruchomieniowe nie jest zgodne ze zaktualizowaną aplikacją na Maca."}},"th":{"stringUnit":{"state":"translated","value":"รันไทม์ที่มีการจัดการไม่ตรงกับแอป Mac ที่อัปเดตแล้ว"}},"vi":{"stringUnit":{"state":"translated","value":"Môi trường thực thi được quản lý không khớp với ứng dụng Mac đã cập nhật."}},"nl":{"stringUnit":{"state":"translated","value":"De beheerde runtime komt niet overeen met de bijgewerkte Mac-app."}},"fa":{"stringUnit":{"state":"translated","value":"محیط اجرای مدیریت‌شده با برنامه به‌روزشده Mac مطابقت ندارد."}},"ru":{"stringUnit":{"state":"translated","value":"Управляемая среда выполнения не соответствует обновлённому приложению для Mac."}},"sv":{"stringUnit":{"state":"translated","value":"Den hanterade körningsmiljön matchar inte den uppdaterade Mac-appen."}}}},
    "The node service restarted but did not remain running.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The node service restarted but did not remain running."}},"zh-CN":{"stringUnit":{"state":"translated","value":"节点服务已重启，但未能保持运行。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"節點服務已重新啟動，但未持續執行。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O serviço do nó foi reiniciado, mas não permaneceu em execução."}},"de":{"stringUnit":{"state":"translated","value":"Der Knotendienst wurde neu gestartet, lief aber nicht weiter."}},"es":{"stringUnit":{"state":"translated","value":"El servicio del nodo se reinició, pero no siguió ejecutándose."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ノードサービスは再起動しましたが、実行状態を維持できませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"노드 서비스가 다시 시작되었지만 실행 상태를 유지하지 못했습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le service du nœud a redémarré, mais ne s’est pas maintenu en fonctionnement."}},"hi":{"stringUnit":{"state":"translated","value":"नोड सेवा पुनः आरंभ हुई, लेकिन चलती नहीं रही।"}},"ar":{"stringUnit":{"state":"translated","value":"أُعيد تشغيل خدمة العقدة، لكنها لم تستمر في العمل."}},"it":{"stringUnit":{"state":"translated","value":"Il servizio del nodo è stato riavviato, ma non è rimasto in esecuzione."}},"tr":{"stringUnit":{"state":"translated","value":"Düğüm hizmeti yeniden başlatıldı ancak çalışmaya devam etmedi."}},"uk":{"stringUnit":{"state":"translated","value":"Служба вузла перезапустилася, але не продовжила роботу."}},"id":{"stringUnit":{"state":"translated","value":"Layanan node dimulai ulang tetapi tidak tetap berjalan."}},"pl":{"stringUnit":{"state":"translated","value":"Usługa węzła uruchomiła się ponownie, ale nie pozostała aktywna."}},"th":{"stringUnit":{"state":"translated","value":"บริการโหนดรีสตาร์ทแล้ว แต่ไม่ได้ทำงานต่อเนื่อง"}},"vi":{"stringUnit":{"state":"translated","value":"Dịch vụ nút đã khởi động lại nhưng không tiếp tục chạy."}},"nl":{"stringUnit":{"state":"translated","value":"De knooppuntservice is opnieuw gestart, maar bleef niet actief."}},"fa":{"stringUnit":{"state":"translated","value":"سرویس گره راه‌اندازی مجدد شد، اما در حال اجرا باقی نماند."}},"ru":{"stringUnit":{"state":"translated","value":"Служба узла перезапустилась, но не продолжила работу."}},"sv":{"stringUnit":{"state":"translated","value":"Nodtjänsten startades om men fortsatte inte att köras."}}}},
    "The notification request was queued.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The notification request was queued."}},"zh-CN":{"stringUnit":{"state":"translated","value":"通知请求已加入队列。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"通知請求已排入佇列。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A solicitação de notificação foi enfileirada."}},"de":{"stringUnit":{"state":"translated","value":"Die Benachrichtigungsanfrage wurde in die Warteschlange gestellt."}},"es":{"stringUnit":{"state":"translated","value":"La solicitud de notificación se puso en cola."}},"ja-JP":{"stringUnit":{"state":"translated","value":"通知リクエストをキューに追加しました。"}},"ko":{"stringUnit":{"state":"translated","value":"알림 요청이 대기열에 추가되었습니다."}},"fr":{"stringUnit":{"state":"translated","value":"La demande de notification a été mise en file d'attente."}},"hi":{"stringUnit":{"state":"translated","value":"सूचना अनुरोध कतार में लगा दिया गया।"}},"ar":{"stringUnit":{"state":"translated","value":"تمت إضافة طلب الإشعار إلى قائمة الانتظار."}},"it":{"stringUnit":{"state":"translated","value":"La richiesta di notifica è stata messa in coda."}},"tr":{"stringUnit":{"state":"translated","value":"Bildirim isteği sıraya alındı."}},"uk":{"stringUnit":{"state":"translated","value":"Запит на сповіщення додано в чергу."}},"id":{"stringUnit":{"state":"translated","value":"Permintaan notifikasi telah diantrekan."}},"pl":{"stringUnit":{"state":"translated","value":"Żądanie powiadomienia zostało dodane do kolejki."}},"th":{"stringUnit":{"state":"translated","value":"คำขอการแจ้งเตือนถูกจัดคิวแล้ว"}},"vi":{"stringUnit":{"state":"translated","value":"Yêu cầu thông báo đã được xếp hàng."}},"nl":{"stringUnit":{"state":"translated","value":"Het meldingsverzoek is in de wachtrij geplaatst."}},"fa":{"stringUnit":{"state":"translated","value":"درخواست اعلان در صف قرار گرفت."}},"ru":{"stringUnit":{"state":"translated","value":"Запрос уведомления поставлен в очередь."}},"sv":{"stringUnit":{"state":"translated","value":"Aviseringsbegäran köades."}}}},
    "The remote Gateway is older than this Mac app, so OpenClaw skipped the agent notification.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The remote Gateway is older than this Mac app, so OpenClaw skipped the agent notification."}},"zh-CN":{"stringUnit":{"state":"translated","value":"远程 Gateway 的版本低于此 Mac 应用，因此 OpenClaw 跳过了智能体通知。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"遠端 Gateway 的版本比此 Mac App 舊，因此 OpenClaw 已略過代理程式通知。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Gateway remoto é mais antigo que este aplicativo para Mac, então o OpenClaw ignorou a notificação do agente."}},"de":{"stringUnit":{"state":"translated","value":"Das Remote-Gateway ist älter als diese Mac-App, daher hat OpenClaw die Agentenbenachrichtigung übersprungen."}},"es":{"stringUnit":{"state":"translated","value":"El Gateway remoto es más antiguo que esta app para Mac, por lo que OpenClaw omitió la notificación del agente."}},"ja-JP":{"stringUnit":{"state":"translated","value":"リモートの Gateway がこの Mac アプリより古いため、OpenClaw はエージェントへの通知をスキップしました。"}},"ko":{"stringUnit":{"state":"translated","value":"원격 Gateway가 이 Mac 앱보다 오래된 버전이므로 OpenClaw에서 에이전트 알림을 건너뛰었습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le Gateway distant est plus ancien que cette app Mac. OpenClaw a donc ignoré la notification de l’agent."}},"hi":{"stringUnit":{"state":"translated","value":"रिमोट Gateway इस Mac ऐप से पुराना है, इसलिए OpenClaw ने एजेंट की सूचना छोड़ दी।"}},"ar":{"stringUnit":{"state":"translated","value":"إصدار Gateway البعيد أقدم من تطبيق Mac هذا، لذا تخطّى OpenClaw إشعار الوكيل."}},"it":{"stringUnit":{"state":"translated","value":"Il Gateway remoto è meno recente di questa app per Mac, quindi OpenClaw ha ignorato la notifica dell'agente."}},"tr":{"stringUnit":{"state":"translated","value":"Uzak Gateway bu Mac uygulamasından daha eski olduğu için OpenClaw aracı bildirimini atladı."}},"uk":{"stringUnit":{"state":"translated","value":"Віддалений Gateway старіший за цю програму для Mac, тому OpenClaw пропустив сповіщення агента."}},"id":{"stringUnit":{"state":"translated","value":"Gateway jarak jauh lebih lama daripada aplikasi Mac ini, sehingga OpenClaw melewati notifikasi agen."}},"pl":{"stringUnit":{"state":"translated","value":"Zdalny Gateway jest starszy niż ta aplikacja na Maca, dlatego OpenClaw pominął powiadomienie agenta."}},"th":{"stringUnit":{"state":"translated","value":"Gateway ระยะไกลเก่ากว่าแอป Mac นี้ ดังนั้น OpenClaw จึงข้ามการแจ้งเตือนเอเจนต์"}},"vi":{"stringUnit":{"state":"translated","value":"Gateway từ xa cũ hơn ứng dụng Mac này, nên OpenClaw đã bỏ qua thông báo cho tác tử."}},"nl":{"stringUnit":{"state":"translated","value":"De externe Gateway is ouder dan deze Mac-app, dus OpenClaw heeft de agentmelding overgeslagen."}},"fa":{"stringUnit":{"state":"translated","value":"نسخه Gateway راه‌دور قدیمی‌تر از این برنامه Mac است، بنابراین OpenClaw از اعلان عامل صرف‌نظر کرد."}},"ru":{"stringUnit":{"state":"translated","value":"Удалённый Gateway старше этого приложения для Mac, поэтому OpenClaw пропустил уведомление агента."}},"sv":{"stringUnit":{"state":"translated","value":"Fjärr-Gateway är äldre än den här Mac-appen, så OpenClaw hoppade över agentaviseringen."}}}},
    "The selected Gateway changed.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The selected Gateway changed."}},"zh-CN":{"stringUnit":{"state":"translated","value":"所选的 Gateway 已更改。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"所選的 Gateway 已變更。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Gateway selecionado foi alterado."}},"de":{"stringUnit":{"state":"translated","value":"Das ausgewählte Gateway wurde geändert."}},"es":{"stringUnit":{"state":"translated","value":"El Gateway seleccionado ha cambiado."}},"ja-JP":{"stringUnit":{"state":"translated","value":"選択された Gateway が変更されました。"}},"ko":{"stringUnit":{"state":"translated","value":"선택한 Gateway가 변경되었습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le Gateway sélectionné a changé."}},"hi":{"stringUnit":{"state":"translated","value":"चयनित Gateway बदल गया।"}},"ar":{"stringUnit":{"state":"translated","value":"تغيّر Gateway المحدد."}},"it":{"stringUnit":{"state":"translated","value":"Il Gateway selezionato è cambiato."}},"tr":{"stringUnit":{"state":"translated","value":"Seçili Gateway değişti."}},"uk":{"stringUnit":{"state":"translated","value":"Вибраний Gateway змінився."}},"id":{"stringUnit":{"state":"translated","value":"Gateway yang dipilih berubah."}},"pl":{"stringUnit":{"state":"translated","value":"Wybrany Gateway uległ zmianie."}},"th":{"stringUnit":{"state":"translated","value":"Gateway ที่เลือกมีการเปลี่ยนแปลง"}},"vi":{"stringUnit":{"state":"translated","value":"Gateway đã chọn đã thay đổi."}},"nl":{"stringUnit":{"state":"translated","value":"De geselecteerde Gateway is gewijzigd."}},"fa":{"stringUnit":{"state":"translated","value":"Gateway انتخاب‌شده تغییر کرد."}},"ru":{"stringUnit":{"state":"translated","value":"Выбранный Gateway изменился."}},"sv":{"stringUnit":{"state":"translated","value":"Den valda Gateway ändrades."}}}},
    "The thread and its transcript are removed from the gateway.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The thread and its transcript are removed from the gateway."}},"zh-CN":{"stringUnit":{"state":"translated","value":"该话题及其对话记录将从 Gateway 中移除。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"對話串及其文字記錄將從 Gateway 中移除。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A conversa e sua transcrição são removidas do Gateway."}},"de":{"stringUnit":{"state":"translated","value":"Der Thread und sein Transkript werden aus dem Gateway entfernt."}},"es":{"stringUnit":{"state":"translated","value":"El hilo y su transcripción se eliminan del Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"スレッドとそのトランスクリプトがGatewayから削除されます。"}},"ko":{"stringUnit":{"state":"translated","value":"스레드와 대화 기록이 Gateway에서 삭제됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le fil et sa transcription sont supprimés du Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"थ्रेड और उसकी ट्रांसक्रिप्ट Gateway से हटा दिए जाते हैं।"}},"ar":{"stringUnit":{"state":"translated","value":"تُزال سلسلة المحادثة ونصها من Gateway."}},"it":{"stringUnit":{"state":"translated","value":"La conversazione e la relativa trascrizione vengono rimosse dal Gateway."}},"tr":{"stringUnit":{"state":"translated","value":"İleti dizisi ve dökümü gateway'den kaldırılır."}},"uk":{"stringUnit":{"state":"translated","value":"Гілку та її стенограму буде видалено з Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Utas dan transkripnya dihapus dari gateway."}},"pl":{"stringUnit":{"state":"translated","value":"Wątek i jego transkrypcja zostaną usunięte z Gateway."}},"th":{"stringUnit":{"state":"translated","value":"เธรดและบทถอดเสียงจะถูกนำออกจาก Gateway"}},"vi":{"stringUnit":{"state":"translated","value":"Luồng và bản ghi của luồng sẽ bị xóa khỏi gateway."}},"nl":{"stringUnit":{"state":"translated","value":"De thread en het transcript ervan worden uit de Gateway verwijderd."}},"fa":{"stringUnit":{"state":"translated","value":"رشته و رونوشت آن از Gateway حذف می‌شوند."}},"ru":{"stringUnit":{"state":"translated","value":"Ветка и её расшифровка будут удалены из Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Tråden och dess transkript tas bort från gatewayen."}}}},
    "The thread could not be created.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The thread could not be created."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法创建话题。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法建立對話串。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível criar a conversa."}},"de":{"stringUnit":{"state":"translated","value":"Der Thread konnte nicht erstellt werden."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo crear el hilo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"スレッドを作成できませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"스레드를 생성할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le fil n’a pas pu être créé."}},"hi":{"stringUnit":{"state":"translated","value":"थ्रेड नहीं बनाया जा सका।"}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر إنشاء سلسلة المحادثة."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile creare la conversazione."}},"tr":{"stringUnit":{"state":"translated","value":"İleti dizisi oluşturulamadı."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося створити гілку."}},"id":{"stringUnit":{"state":"translated","value":"Utas tidak dapat dibuat."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się utworzyć wątku."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถสร้างเธรดได้"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể tạo luồng."}},"nl":{"stringUnit":{"state":"translated","value":"De thread kon niet worden aangemaakt."}},"fa":{"stringUnit":{"state":"translated","value":"رشته ایجاد نشد."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось создать ветку."}},"sv":{"stringUnit":{"state":"translated","value":"Det gick inte att skapa tråden."}}}},
    "The update is installed, but Gateway health did not become ready.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The update is installed, but Gateway health did not become ready."}},"zh-CN":{"stringUnit":{"state":"translated","value":"更新已安装，但 Gateway 健康状态未就绪。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"更新已安裝，但 Gateway 健康狀態未進入就緒狀態。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A atualização está instalada, mas o Gateway não ficou pronto."}},"de":{"stringUnit":{"state":"translated","value":"Das Update ist installiert, aber der Gateway-Status wurde nicht betriebsbereit."}},"es":{"stringUnit":{"state":"translated","value":"La actualización está instalada, pero el estado del Gateway no llegó a estar listo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"アップデートはインストールされましたが、Gateway のヘルスチェックは準備完了になりませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"업데이트가 설치되었지만 Gateway 상태가 준비 상태가 되지 않았습니다."}},"fr":{"stringUnit":{"state":"translated","value":"La mise à jour est installée, mais le Gateway n’est pas devenu opérationnel."}},"hi":{"stringUnit":{"state":"translated","value":"अपडेट इंस्टॉल हो गया है, लेकिन Gateway की स्थिति तैयार नहीं हुई।"}},"ar":{"stringUnit":{"state":"translated","value":"تم تثبيت التحديث، لكن حالة Gateway لم تصبح جاهزة."}},"it":{"stringUnit":{"state":"translated","value":"L'aggiornamento è installato, ma lo stato del Gateway non è diventato operativo."}},"tr":{"stringUnit":{"state":"translated","value":"Güncelleme yüklendi ancak Gateway sistem durumu hazır hâle gelmedi."}},"uk":{"stringUnit":{"state":"translated","value":"Оновлення встановлено, але перевірка стану Gateway не показала готовності."}},"id":{"stringUnit":{"state":"translated","value":"Pembaruan telah diinstal, tetapi status kesehatan Gateway tidak menjadi siap."}},"pl":{"stringUnit":{"state":"translated","value":"Aktualizacja została zainstalowana, ale stan kondycji Gateway nie osiągnął gotowości."}},"th":{"stringUnit":{"state":"translated","value":"ติดตั้งการอัปเดตแล้ว แต่สถานะความพร้อมของ Gateway ยังไม่พร้อม"}},"vi":{"stringUnit":{"state":"translated","value":"Bản cập nhật đã được cài đặt, nhưng trạng thái hoạt động của Gateway chưa chuyển sang sẵn sàng."}},"nl":{"stringUnit":{"state":"translated","value":"De update is geïnstalleerd, maar de status van de Gateway is niet gereed geworden."}},"fa":{"stringUnit":{"state":"translated","value":"به‌روزرسانی نصب شده است، اما وضعیت سلامت Gateway آماده نشد."}},"ru":{"stringUnit":{"state":"translated","value":"Обновление установлено, но Gateway не перешёл в состояние готовности."}},"sv":{"stringUnit":{"state":"translated","value":"Uppdateringen är installerad, men Gateway blev inte driftklar."}}}},
    "The widget image could not be captured.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The widget image could not be captured."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法截取小组件图像。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法擷取小工具影像。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível capturar a imagem do widget."}},"de":{"stringUnit":{"state":"translated","value":"Das Widget-Bild konnte nicht erfasst werden."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo capturar la imagen del widget."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ウィジェットの画像をキャプチャできませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"위젯 이미지를 캡처할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’image du widget n’a pas pu être capturée."}},"hi":{"stringUnit":{"state":"translated","value":"विजेट की इमेज कैप्चर नहीं की जा सकी।"}},"ar":{"stringUnit":{"state":"translated","value":"تعذر التقاط صورة الأداة."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile acquisire l'immagine del widget."}},"tr":{"stringUnit":{"state":"translated","value":"Widget görüntüsü yakalanamadı."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося захопити зображення віджета."}},"id":{"stringUnit":{"state":"translated","value":"Gambar widget tidak dapat diambil."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się przechwycić obrazu widżetu."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถจับภาพวิดเจ็ตได้"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể chụp hình ảnh tiện ích."}},"nl":{"stringUnit":{"state":"translated","value":"De widgetafbeelding kon niet worden vastgelegd."}},"fa":{"stringUnit":{"state":"translated","value":"ثبت تصویر ویجت ممکن نبود."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось сделать снимок виджета."}},"sv":{"stringUnit":{"state":"translated","value":"Det gick inte att ta en bild av widgeten."}}}},
    "The widget image could not be copied.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The widget image could not be copied."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法复制小组件图像。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法拷貝小工具影像。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível copiar a imagem do widget."}},"de":{"stringUnit":{"state":"translated","value":"Das Widget-Bild konnte nicht kopiert werden."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo copiar la imagen del widget."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ウィジェットの画像をコピーできませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"위젯 이미지를 복사할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’image du widget n’a pas pu être copiée."}},"hi":{"stringUnit":{"state":"translated","value":"विजेट की इमेज कॉपी नहीं की जा सकी।"}},"ar":{"stringUnit":{"state":"translated","value":"تعذر نسخ صورة الأداة."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile copiare l'immagine del widget."}},"tr":{"stringUnit":{"state":"translated","value":"Widget görüntüsü kopyalanamadı."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося скопіювати зображення віджета."}},"id":{"stringUnit":{"state":"translated","value":"Gambar widget tidak dapat disalin."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się skopiować obrazu widżetu."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถคัดลอกรูปภาพวิดเจ็ตได้"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể sao chép hình ảnh tiện ích."}},"nl":{"stringUnit":{"state":"translated","value":"De widgetafbeelding kon niet worden gekopieerd."}},"fa":{"stringUnit":{"state":"translated","value":"کپی تصویر ویجت ممکن نبود."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось скопировать изображение виджета."}},"sv":{"stringUnit":{"state":"translated","value":"Det gick inte att kopiera widgetbilden."}}}},
    "The widget image could not be encoded as PNG.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The widget image could not be encoded as PNG."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法将小组件图像编码为 PNG。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法將小工具影像編碼為 PNG。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível codificar a imagem do widget como PNG."}},"de":{"stringUnit":{"state":"translated","value":"Das Widget-Bild konnte nicht als PNG codiert werden."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo codificar la imagen del widget como PNG."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ウィジェットの画像をPNGとしてエンコードできませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"위젯 이미지를 PNG로 인코딩할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’image du widget n’a pas pu être encodée au format PNG."}},"hi":{"stringUnit":{"state":"translated","value":"विजेट की इमेज को PNG के रूप में एन्कोड नहीं किया जा सका।"}},"ar":{"stringUnit":{"state":"translated","value":"تعذر ترميز صورة الأداة بتنسيق PNG."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile codificare l'immagine del widget in formato PNG."}},"tr":{"stringUnit":{"state":"translated","value":"Widget görüntüsü PNG olarak kodlanamadı."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося закодувати зображення віджета у форматі PNG."}},"id":{"stringUnit":{"state":"translated","value":"Gambar widget tidak dapat dikodekan sebagai PNG."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się zakodować obrazu widżetu w formacie PNG."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถเข้ารหัสรูปภาพวิดเจ็ตเป็น PNG ได้"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể mã hóa hình ảnh tiện ích thành PNG."}},"nl":{"stringUnit":{"state":"translated","value":"De widgetafbeelding kon niet als PNG worden gecodeerd."}},"fa":{"stringUnit":{"state":"translated","value":"رمزگذاری تصویر ویجت با قالب PNG ممکن نبود."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось закодировать изображение виджета в формате PNG."}},"sv":{"stringUnit":{"state":"translated","value":"Det gick inte att koda widgetbilden som PNG."}}}},
    "The widget image could not be saved.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The widget image could not be saved."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法存储小组件图像。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法儲存小工具影像。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível salvar a imagem do widget."}},"de":{"stringUnit":{"state":"translated","value":"Das Widget-Bild konnte nicht gespeichert werden."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo guardar la imagen del widget."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ウィジェットの画像を保存できませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"위젯 이미지를 저장할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’image du widget n’a pas pu être enregistrée."}},"hi":{"stringUnit":{"state":"translated","value":"विजेट की इमेज सेव नहीं की जा सकी।"}},"ar":{"stringUnit":{"state":"translated","value":"تعذر حفظ صورة الأداة."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile salvare l'immagine del widget."}},"tr":{"stringUnit":{"state":"translated","value":"Widget görüntüsü kaydedilemedi."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося зберегти зображення віджета."}},"id":{"stringUnit":{"state":"translated","value":"Gambar widget tidak dapat disimpan."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się zapisać obrazu widżetu."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถบันทึกรูปภาพวิดเจ็ตได้"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể lưu hình ảnh tiện ích."}},"nl":{"stringUnit":{"state":"translated","value":"De widgetafbeelding kon niet worden bewaard."}},"fa":{"stringUnit":{"state":"translated","value":"ذخیره تصویر ویجت ممکن نبود."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось сохранить изображение виджета."}},"sv":{"stringUnit":{"state":"translated","value":"Det gick inte att spara widgetbilden."}}}},
    "These panes are being retired in favor of the Dashboard.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"These panes are being retired in favor of the Dashboard."}},"zh-CN":{"stringUnit":{"state":"translated","value":"这些面板正在被淘汰，改用 Dashboard。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"這些面板正被淘汰，改用 Dashboard。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Esses painéis estão sendo descontinuados em favor do Dashboard."}},"de":{"stringUnit":{"state":"translated","value":"Diese Bereiche werden zugunsten des Dashboards eingestellt."}},"es":{"stringUnit":{"state":"translated","value":"Estos paneles se están retirando en favor del Dashboard."}},"ja-JP":{"stringUnit":{"state":"translated","value":"これらのペインは Dashboard への移行に伴い廃止されます。"}},"ko":{"stringUnit":{"state":"translated","value":"이 창들은 Dashboard로 대체되어 사용이 중단됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Ces panneaux sont abandonnés au profit du Dashboard."}},"hi":{"stringUnit":{"state":"translated","value":"इन पेन को Dashboard के पक्ष में बंद किया जा रहा है।"}},"ar":{"stringUnit":{"state":"translated","value":"يجري سحب هذه الأجزاء لصالح Dashboard."}},"it":{"stringUnit":{"state":"translated","value":"Questi pannelli vengono dismessi in favore della Dashboard."}},"tr":{"stringUnit":{"state":"translated","value":"Bu bölmeler Dashboard lehine kullanımdan kaldırılıyor."}},"uk":{"stringUnit":{"state":"translated","value":"Ці панелі виводяться з використання на користь Dashboard."}},"id":{"stringUnit":{"state":"translated","value":"Panel ini akan dihentikan untuk digantikan oleh Dashboard."}},"pl":{"stringUnit":{"state":"translated","value":"Te panele są wycofywane na rzecz Dashboardu."}},"th":{"stringUnit":{"state":"translated","value":"แผงเหล่านี้กำลังจะถูกยกเลิกเพื่อใช้ Dashboard แทน"}},"vi":{"stringUnit":{"state":"translated","value":"Các bảng này đang được ngừng sử dụng để chuyển sang Dashboard."}},"nl":{"stringUnit":{"state":"translated","value":"Deze vensters worden uitgefaseerd ten gunste van het Dashboard."}},"fa":{"stringUnit":{"state":"translated","value":"این پنجره‌ها به نفع Dashboard کنار گذاشته می‌شوند."}},"ru":{"stringUnit":{"state":"translated","value":"Эти панели заменяются на Dashboard."}},"sv":{"stringUnit":{"state":"translated","value":"Dessa paneler fasas ut till förmån för Dashboard."}}}},
    "Thinking": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Thinking"}},"zh-CN":{"stringUnit":{"state":"translated","value":"正在思考"}},"zh-TW":{"stringUnit":{"state":"translated","value":"思考中"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Pensando"}},"de":{"stringUnit":{"state":"translated","value":"Denkt nach"}},"es":{"stringUnit":{"state":"translated","value":"Pensando"}},"ja-JP":{"stringUnit":{"state":"translated","value":"思考中"}},"ko":{"stringUnit":{"state":"translated","value":"생각 중"}},"fr":{"stringUnit":{"state":"translated","value":"Réflexion"}},"hi":{"stringUnit":{"state":"translated","value":"सोच रहा है"}},"ar":{"stringUnit":{"state":"translated","value":"جارٍ التفكير"}},"it":{"stringUnit":{"state":"translated","value":"Elaborazione"}},"tr":{"stringUnit":{"state":"translated","value":"Düşünüyor"}},"uk":{"stringUnit":{"state":"translated","value":"Мислення"}},"id":{"stringUnit":{"state":"translated","value":"Berpikir"}},"pl":{"stringUnit":{"state":"translated","value":"Myślenie"}},"th":{"stringUnit":{"state":"translated","value":"กำลังคิด"}},"vi":{"stringUnit":{"state":"translated","value":"Đang suy nghĩ"}},"nl":{"stringUnit":{"state":"translated","value":"Denken"}},"fa":{"stringUnit":{"state":"translated","value":"در حال فکر کردن"}},"ru":{"stringUnit":{"state":"translated","value":"Размышление"}},"sv":{"stringUnit":{"state":"translated","value":"Tänker"}}}},
    "This allowlist entry is inherited. Edit its owning scope and retry.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This allowlist entry is inherited. Edit its owning scope and retry."}},"zh-CN":{"stringUnit":{"state":"translated","value":"此允许列表条目为继承而来。请编辑其所属作用域并重试。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此允許清單項目為繼承而來。請編輯其所屬範圍後再重試。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Esta entrada da lista de permissões é herdada. Edite o escopo proprietário e tente novamente."}},"de":{"stringUnit":{"state":"translated","value":"Dieser Zulassungslisteneintrag wird geerbt. Bearbeiten Sie den zugehörigen Geltungsbereich und versuchen Sie es erneut."}},"es":{"stringUnit":{"state":"translated","value":"Esta entrada de la lista de permitidos es heredada. Edita el ámbito propietario y reinténtalo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"この許可リストエントリは継承されています。所有するスコープを編集して再試行してください。"}},"ko":{"stringUnit":{"state":"translated","value":"이 허용 목록 항목은 상속되었습니다. 소유 범위를 편집한 후 다시 시도하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Cette entrée de liste d'autorisation est héritée. Modifiez la portée à laquelle elle appartient, puis réessayez."}},"hi":{"stringUnit":{"state":"translated","value":"यह allowlist प्रविष्टि इनहेरिट की गई है। इसके स्वामी स्कोप को संपादित करें और पुनः प्रयास करें।"}},"ar":{"stringUnit":{"state":"translated","value":"إدخال قائمة السماح هذا موروث. عدّل النطاق الذي يملكه ثم أعد المحاولة."}},"it":{"stringUnit":{"state":"translated","value":"Questa voce dell'elenco consentiti è ereditata. Modifica il suo scope proprietario e riprova."}},"tr":{"stringUnit":{"state":"translated","value":"Bu izin listesi girişi devralınmıştır. Sahip olduğu kapsamı düzenleyip tekrar deneyin."}},"uk":{"stringUnit":{"state":"translated","value":"Цей запис списку дозволів успадковано. Відредагуйте область, якій він належить, і повторіть спробу."}},"id":{"stringUnit":{"state":"translated","value":"Entri allowlist ini diwarisi. Edit scope pemiliknya lalu coba lagi."}},"pl":{"stringUnit":{"state":"translated","value":"Ten wpis listy dozwolonych jest dziedziczony. Edytuj zakres, do którego należy, i spróbuj ponownie."}},"th":{"stringUnit":{"state":"translated","value":"รายการอนุญาตนี้ได้รับการสืบทอดมา แก้ไขขอบเขตที่เป็นเจ้าของแล้วลองอีกครั้ง"}},"vi":{"stringUnit":{"state":"translated","value":"Mục danh sách cho phép này được kế thừa. Chỉnh sửa phạm vi sở hữu và thử lại."}},"nl":{"stringUnit":{"state":"translated","value":"Dit toegangslijst-item is overgeërfd. Bewerk de bijbehorende scope en probeer het opnieuw."}},"fa":{"stringUnit":{"state":"translated","value":"این ورودی فهرست مجاز به‌ارث رسیده است. دامنه مالک آن را ویرایش کرده و دوباره تلاش کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Эта запись списка разрешений унаследована. Отредактируйте её область-владельца и повторите попытку."}},"sv":{"stringUnit":{"state":"translated","value":"Den här tillåtelselistposten är ärvd. Redigera dess ägande omfång och försök igen."}}}},
    "This app connects without installing or updating its CLI runtime.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This app connects without installing or updating its CLI runtime."}},"zh-CN":{"stringUnit":{"state":"translated","value":"此应用无需安装或更新其 CLI 运行时即可连接。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此應用程式連線時不會安裝或更新其 CLI 執行環境。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Este app conecta sem instalar ou atualizar seu runtime de CLI."}},"de":{"stringUnit":{"state":"translated","value":"Diese App verbindet sich, ohne ihre CLI-Laufzeitumgebung zu installieren oder zu aktualisieren."}},"es":{"stringUnit":{"state":"translated","value":"Esta aplicación se conecta sin instalar ni actualizar su entorno de ejecución de CLI."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このアプリは、CLIランタイムをインストールまたは更新せずに接続します。"}},"ko":{"stringUnit":{"state":"translated","value":"이 앱은 CLI 런타임을 설치하거나 업데이트하지 않고 연결됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Cette application se connecte sans installer ni mettre à jour son environnement d'exécution CLI."}},"hi":{"stringUnit":{"state":"translated","value":"यह ऐप अपने CLI रनटाइम को इंस्टॉल या अपडेट किए बिना कनेक्ट होता है।"}},"ar":{"stringUnit":{"state":"translated","value":"يتصل هذا التطبيق دون تثبيت أو تحديث بيئة تشغيل CLI الخاصة به."}},"it":{"stringUnit":{"state":"translated","value":"Questa app si connette senza installare o aggiornare il suo runtime CLI."}},"tr":{"stringUnit":{"state":"translated","value":"Bu uygulama, CLI çalışma zamanını yüklemeden veya güncellemeden bağlanır."}},"uk":{"stringUnit":{"state":"translated","value":"Цей застосунок підключається без встановлення чи оновлення свого середовища виконання CLI."}},"id":{"stringUnit":{"state":"translated","value":"Aplikasi ini terhubung tanpa menginstal atau memperbarui runtime CLI-nya."}},"pl":{"stringUnit":{"state":"translated","value":"Ta aplikacja łączy się bez instalowania ani aktualizowania środowiska uruchomieniowego CLI."}},"th":{"stringUnit":{"state":"translated","value":"แอปนี้เชื่อมต่อโดยไม่ต้องติดตั้งหรืออัปเดต CLI runtime"}},"vi":{"stringUnit":{"state":"translated","value":"Ứng dụng này kết nối mà không cần cài đặt hoặc cập nhật CLI runtime của nó."}},"nl":{"stringUnit":{"state":"translated","value":"Deze app maakt verbinding zonder de CLI-runtime te installeren of bij te werken."}},"fa":{"stringUnit":{"state":"translated","value":"این برنامه بدون نصب یا به‌روزرسانی زمان اجرای CLI خود متصل می‌شود."}},"ru":{"stringUnit":{"state":"translated","value":"Это приложение подключается без установки или обновления среды выполнения CLI."}},"sv":{"stringUnit":{"state":"translated","value":"Den här appen ansluter utan att installera eller uppdatera sin CLI-runtime."}}}},
    "This app, WhatsApp, Telegram, Discord, Slack — your choice.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This app, WhatsApp, Telegram, Discord, Slack — your choice."}},"zh-CN":{"stringUnit":{"state":"translated","value":"这个 app、WhatsApp、Telegram、Discord、Slack — 由你选择。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"這個 App、WhatsApp、Telegram、Discord、Slack — 由你選擇。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Este app, WhatsApp, Telegram, Discord, Slack — você escolhe."}},"de":{"stringUnit":{"state":"translated","value":"Diese App, WhatsApp, Telegram, Discord, Slack — Sie haben die Wahl."}},"es":{"stringUnit":{"state":"translated","value":"Esta app, WhatsApp, Telegram, Discord, Slack — tú eliges."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このアプリ、WhatsApp、Telegram、Discord、Slack — お好みで選べます。"}},"ko":{"stringUnit":{"state":"translated","value":"이 앱, WhatsApp, Telegram, Discord, Slack — 원하는 대로 선택하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Cette app, WhatsApp, Telegram, Discord, Slack — à vous de choisir."}},"hi":{"stringUnit":{"state":"translated","value":"यह ऐप, WhatsApp, Telegram, Discord, Slack — आपकी पसंद।"}},"ar":{"stringUnit":{"state":"translated","value":"هذا التطبيق، WhatsApp، Telegram، Discord، Slack — الخيار لك."}},"it":{"stringUnit":{"state":"translated","value":"Questa app, WhatsApp, Telegram, Discord, Slack — a tua scelta."}},"tr":{"stringUnit":{"state":"translated","value":"Bu uygulama, WhatsApp, Telegram, Discord, Slack — seçim sizin."}},"uk":{"stringUnit":{"state":"translated","value":"Цей застосунок, WhatsApp, Telegram, Discord, Slack — на ваш вибір."}},"id":{"stringUnit":{"state":"translated","value":"Aplikasi ini, WhatsApp, Telegram, Discord, Slack — pilihan Anda."}},"pl":{"stringUnit":{"state":"translated","value":"Ta aplikacja, WhatsApp, Telegram, Discord, Slack — wybór należy do Ciebie."}},"th":{"stringUnit":{"state":"translated","value":"แอปนี้, WhatsApp, Telegram, Discord, Slack — คุณเลือกได้"}},"vi":{"stringUnit":{"state":"translated","value":"Ứng dụng này, WhatsApp, Telegram, Discord, Slack — tùy bạn chọn."}},"nl":{"stringUnit":{"state":"translated","value":"Deze app, WhatsApp, Telegram, Discord, Slack — aan jou de keuze."}},"fa":{"stringUnit":{"state":"translated","value":"این برنامه، WhatsApp، Telegram، Discord، Slack — انتخاب با شماست."}},"ru":{"stringUnit":{"state":"translated","value":"Это приложение, WhatsApp, Telegram, Discord, Slack — на ваш выбор."}},"sv":{"stringUnit":{"state":"translated","value":"Den här appen, WhatsApp, Telegram, Discord, Slack — du väljer."}}}},
    "This configuration lives on your gateway and is managed in the Dashboard.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This configuration lives on your gateway and is managed in the Dashboard."}},"zh-CN":{"stringUnit":{"state":"translated","value":"此配置存储在你的 Gateway 上，并在 Dashboard 中管理。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此設定位於您的 Gateway 上，並在 Dashboard 中管理。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Esta configuração fica no seu gateway e é gerenciada no Dashboard."}},"de":{"stringUnit":{"state":"translated","value":"Diese Konfiguration befindet sich auf Ihrem Gateway und wird im Dashboard verwaltet."}},"es":{"stringUnit":{"state":"translated","value":"Esta configuración reside en tu gateway y se gestiona en el Dashboard."}},"ja-JP":{"stringUnit":{"state":"translated","value":"この設定は Gateway 上に保存され、Dashboard で管理されます。"}},"ko":{"stringUnit":{"state":"translated","value":"이 구성은 Gateway에 저장되며 Dashboard에서 관리됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Cette configuration se trouve sur votre gateway et est gérée dans le Dashboard."}},"hi":{"stringUnit":{"state":"translated","value":"यह कॉन्फ़िगरेशन आपके gateway पर रहती है और Dashboard में प्रबंधित की जाती है।"}},"ar":{"stringUnit":{"state":"translated","value":"يوجد هذا الإعداد على الـ gateway الخاص بك ويُدار في Dashboard."}},"it":{"stringUnit":{"state":"translated","value":"Questa configurazione risiede sul tuo gateway ed è gestita nella Dashboard."}},"tr":{"stringUnit":{"state":"translated","value":"Bu yapılandırma gateway'inizde bulunur ve Dashboard'da yönetilir."}},"uk":{"stringUnit":{"state":"translated","value":"Ця конфігурація зберігається на вашому gateway і керується в Dashboard."}},"id":{"stringUnit":{"state":"translated","value":"Konfigurasi ini berada di gateway Anda dan dikelola di Dashboard."}},"pl":{"stringUnit":{"state":"translated","value":"Ta konfiguracja znajduje się na Twoim gateway i jest zarządzana w Dashboardzie."}},"th":{"stringUnit":{"state":"translated","value":"การกำหนดค่านี้อยู่บน gateway ของคุณ และจัดการได้ใน Dashboard"}},"vi":{"stringUnit":{"state":"translated","value":"Cấu hình này nằm trên gateway của bạn và được quản lý trong Dashboard."}},"nl":{"stringUnit":{"state":"translated","value":"Deze configuratie staat op je gateway en wordt beheerd in het Dashboard."}},"fa":{"stringUnit":{"state":"translated","value":"این پیکربندی روی gateway شما قرار دارد و در Dashboard مدیریت می‌شود."}},"ru":{"stringUnit":{"state":"translated","value":"Эта конфигурация хранится на вашем gateway и управляется в Dashboard."}},"sv":{"stringUnit":{"state":"translated","value":"Denna konfiguration finns på din gateway och hanteras i Dashboard."}}}},
    "This copy is newer than the installed app. OpenClaw will replace it and reopen from Applications.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This copy is newer than the installed app. OpenClaw will replace it and reopen from Applications."}},"zh-CN":{"stringUnit":{"state":"translated","value":"此副本比已安装的应用更新。OpenClaw 将替换它并从“应用程序”重新打开。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此副本比已安裝的應用程式更新。OpenClaw 會將其取代並從「應用程式」重新開啟。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Esta cópia é mais recente que o aplicativo instalado. O OpenClaw irá substituí-lo e reabrir a partir de Aplicativos."}},"de":{"stringUnit":{"state":"translated","value":"Diese Kopie ist neuer als die installierte App. OpenClaw ersetzt sie und öffnet sich erneut aus dem Ordner „Programme“."}},"es":{"stringUnit":{"state":"translated","value":"Esta copia es más reciente que la app instalada. OpenClaw la reemplazará y se reabrirá desde Aplicaciones."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このコピーはインストール済みのアプリより新しいバージョンです。OpenClaw は置き換えて、Applications から再起動します。"}},"ko":{"stringUnit":{"state":"translated","value":"이 복사본은 설치된 앱보다 최신입니다. OpenClaw가 이를 교체하고 응용 프로그램에서 다시 엽니다."}},"fr":{"stringUnit":{"state":"translated","value":"Cette copie est plus récente que l’application installée. OpenClaw va la remplacer et se rouvrir depuis Applications."}},"hi":{"stringUnit":{"state":"translated","value":"यह कॉपी इंस्टॉल किए गए ऐप से नई है। OpenClaw इसे बदल देगा और Applications से फिर से खुलेगा।"}},"ar":{"stringUnit":{"state":"translated","value":"هذه النسخة أحدث من التطبيق المثبَّت. سيستبدلها OpenClaw ويعيد الفتح من التطبيقات."}},"it":{"stringUnit":{"state":"translated","value":"Questa copia è più recente dell'app installata. OpenClaw la sostituirà e si riaprirà da Applicazioni."}},"tr":{"stringUnit":{"state":"translated","value":"Bu kopya yüklü uygulamadan daha yeni. OpenClaw onu değiştirecek ve Applications klasöründen yeniden açılacak."}},"uk":{"stringUnit":{"state":"translated","value":"Ця копія новіша за встановлений застосунок. OpenClaw замінить його і повторно відкриється з Applications."}},"id":{"stringUnit":{"state":"translated","value":"Salinan ini lebih baru daripada aplikasi yang terinstal. OpenClaw akan menggantinya dan membuka kembali dari Applications."}},"pl":{"stringUnit":{"state":"translated","value":"Ta kopia jest nowsza niż zainstalowana aplikacja. OpenClaw ją zastąpi i otworzy się ponownie z folderu Aplikacje."}},"th":{"stringUnit":{"state":"translated","value":"สำเนานี้ใหม่กว่าแอปที่ติดตั้งไว้ OpenClaw จะแทนที่และเปิดใหม่จาก Applications"}},"vi":{"stringUnit":{"state":"translated","value":"Bản sao này mới hơn ứng dụng đã cài. OpenClaw sẽ thay thế nó và mở lại từ Applications."}},"nl":{"stringUnit":{"state":"translated","value":"Deze kopie is nieuwer dan de geïnstalleerde app. OpenClaw vervangt deze en opent opnieuw vanuit Programma's."}},"fa":{"stringUnit":{"state":"translated","value":"این نسخه جدیدتر از برنامه نصب‌شده است. OpenClaw آن را جایگزین می‌کند و از Applications دوباره باز می‌شود."}},"ru":{"stringUnit":{"state":"translated","value":"Эта копия новее установленного приложения. OpenClaw заменит его и снова откроется из Applications."}},"sv":{"stringUnit":{"state":"translated","value":"Den här kopian är nyare än den installerade appen. OpenClaw ersätter den och öppnas igen från Program."}}}},
    "This device needs pairing approval": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This device needs pairing approval"}},"zh-CN":{"stringUnit":{"state":"translated","value":"此设备需要配对批准"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此裝置需要配對核准"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Este dispositivo precisa de aprovação de pareamento"}},"de":{"stringUnit":{"state":"translated","value":"Dieses Gerät benötigt eine Kopplungsgenehmigung"}},"es":{"stringUnit":{"state":"translated","value":"Este dispositivo necesita aprobación de emparejamiento"}},"ja-JP":{"stringUnit":{"state":"translated","value":"このデバイスにはペアリングの承認が必要です"}},"ko":{"stringUnit":{"state":"translated","value":"이 기기는 페어링 승인이 필요합니다"}},"fr":{"stringUnit":{"state":"translated","value":"Cet appareil nécessite une approbation d’appairage"}},"hi":{"stringUnit":{"state":"translated","value":"इस device को pairing approval की आवश्यकता है"}},"ar":{"stringUnit":{"state":"translated","value":"يحتاج هذا الجهاز إلى موافقة الاقتران"}},"it":{"stringUnit":{"state":"translated","value":"Questo dispositivo richiede l'approvazione dell'abbinamento"}},"tr":{"stringUnit":{"state":"translated","value":"Bu cihazın eşleştirme onayına ihtiyacı var"}},"uk":{"stringUnit":{"state":"translated","value":"Цей пристрій потребує схвалення сполучення"}},"id":{"stringUnit":{"state":"translated","value":"Perangkat ini memerlukan persetujuan pemasangan"}},"pl":{"stringUnit":{"state":"translated","value":"To urządzenie wymaga zatwierdzenia parowania"}},"th":{"stringUnit":{"state":"translated","value":"อุปกรณ์นี้ต้องได้รับการอนุมัติการจับคู่"}},"vi":{"stringUnit":{"state":"translated","value":"Thiết bị này cần được phê duyệt ghép đôi"}},"nl":{"stringUnit":{"state":"translated","value":"Dit apparaat heeft koppelingsgoedkeuring nodig"}},"fa":{"stringUnit":{"state":"translated","value":"این دستگاه به تأیید جفت‌سازی نیاز دارد"}},"ru":{"stringUnit":{"state":"translated","value":"Для этого устройства требуется подтверждение сопряжения"}},"sv":{"stringUnit":{"state":"translated","value":"Den här enheten behöver parkopplingsgodkännande"}}}},
    "This gateway has token auth enabled, but no gateway.auth.token is configured on the host.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This gateway has token auth enabled, but no gateway.auth.token is configured on the host."}},"zh-CN":{"stringUnit":{"state":"translated","value":"此 Gateway 已启用令牌身份验证，但主机上未配置 gateway.auth.token。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此 Gateway 已啟用權杖驗證，但主機上未設定 gateway.auth.token。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Este gateway está com a autenticação por token habilitada, mas nenhum gateway.auth.token está configurado no host."}},"de":{"stringUnit":{"state":"translated","value":"Bei dieser Gateway ist Token-Authentifizierung aktiviert, aber auf dem Host ist kein gateway.auth.token konfiguriert."}},"es":{"stringUnit":{"state":"translated","value":"Este gateway tiene habilitada la autenticación por token, pero no se ha configurado ningún gateway.auth.token en el host."}},"ja-JP":{"stringUnit":{"state":"translated","value":"この Gateway ではトークン認証が有効になっていますが、ホストで gateway.auth.token が設定されていません。"}},"ko":{"stringUnit":{"state":"translated","value":"이 Gateway에는 토큰 인증이 활성화되어 있지만 호스트에 gateway.auth.token이 구성되어 있지 않습니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’authentification par jeton est activée sur ce Gateway, mais aucun gateway.auth.token n’est configuré sur l’hôte."}},"hi":{"stringUnit":{"state":"translated","value":"इस gateway में token auth enabled है, लेकिन host पर कोई gateway.auth.token configured नहीं है।"}},"ar":{"stringUnit":{"state":"translated","value":"تم تمكين مصادقة الرمز على هذا Gateway، لكن لم يتم تكوين gateway.auth.token على المضيف."}},"it":{"stringUnit":{"state":"translated","value":"Questo gateway ha l'autenticazione tramite token abilitata, ma sull'host non è configurato alcun gateway.auth.token."}},"tr":{"stringUnit":{"state":"translated","value":"Bu gateway'de token kimlik doğrulaması etkin, ancak ana makinede gateway.auth.token yapılandırılmamış."}},"uk":{"stringUnit":{"state":"translated","value":"Для цього gateway увімкнено автентифікацію за токеном, але на хості не налаштовано gateway.auth.token."}},"id":{"stringUnit":{"state":"translated","value":"Gateway ini mengaktifkan autentikasi token, tetapi tidak ada gateway.auth.token yang dikonfigurasi di host."}},"pl":{"stringUnit":{"state":"translated","value":"Ten gateway ma włączone uwierzytelnianie tokenem, ale na hoście nie skonfigurowano gateway.auth.token."}},"th":{"stringUnit":{"state":"translated","value":"Gateway นี้เปิดใช้การยืนยันตัวตนด้วยโทเค็น แต่ไม่ได้กำหนดค่า gateway.auth.token บนโฮสต์"}},"vi":{"stringUnit":{"state":"translated","value":"Gateway này đã bật xác thực bằng mã, nhưng chưa có gateway.auth.token nào được cấu hình trên máy chủ."}},"nl":{"stringUnit":{"state":"translated","value":"Voor deze gateway is token-auth ingeschakeld, maar er is geen gateway.auth.token geconfigureerd op de host."}},"fa":{"stringUnit":{"state":"translated","value":"احراز هویت با توکن برای این Gateway فعال است، اما هیچ gateway.auth.token روی میزبان پیکربندی نشده است."}},"ru":{"stringUnit":{"state":"translated","value":"На этом gateway включена аутентификация по токену, но на хосте не настроен gateway.auth.token."}},"sv":{"stringUnit":{"state":"translated","value":"Denna Gateway har tokenautentisering aktiverad, men ingen gateway.auth.token är konfigurerad på värden."}}}},
    "This gateway host needs token setup": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This gateway host needs token setup"}},"zh-CN":{"stringUnit":{"state":"translated","value":"此 Gateway 主机需要设置令牌"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此 Gateway 主機需要設定權杖"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Este host do gateway precisa de configuração de token"}},"de":{"stringUnit":{"state":"translated","value":"Für diesen Gateway-Host muss ein Token eingerichtet werden"}},"es":{"stringUnit":{"state":"translated","value":"Este host del gateway necesita configurar el token"}},"ja-JP":{"stringUnit":{"state":"translated","value":"この Gateway ホストにはトークンのセットアップが必要です"}},"ko":{"stringUnit":{"state":"translated","value":"이 Gateway 호스트에는 토큰 설정이 필요합니다"}},"fr":{"stringUnit":{"state":"translated","value":"Cet hôte Gateway nécessite la configuration d’un jeton"}},"hi":{"stringUnit":{"state":"translated","value":"इस gateway host को token setup की आवश्यकता है"}},"ar":{"stringUnit":{"state":"translated","value":"يحتاج مضيف Gateway هذا إلى إعداد الرمز"}},"it":{"stringUnit":{"state":"translated","value":"Questo host gateway richiede la configurazione del token"}},"tr":{"stringUnit":{"state":"translated","value":"Bu gateway ana makinesinde token kurulumu gerekiyor"}},"uk":{"stringUnit":{"state":"translated","value":"Для цього хоста gateway потрібно налаштувати токен"}},"id":{"stringUnit":{"state":"translated","value":"Host gateway ini memerlukan penyiapan token"}},"pl":{"stringUnit":{"state":"translated","value":"Ten host gateway wymaga skonfigurowania tokena"}},"th":{"stringUnit":{"state":"translated","value":"โฮสต์ Gateway นี้ต้องตั้งค่าโทเค็น"}},"vi":{"stringUnit":{"state":"translated","value":"Máy chủ Gateway này cần thiết lập mã"}},"nl":{"stringUnit":{"state":"translated","value":"Voor deze gatewayhost moet een token worden ingesteld"}},"fa":{"stringUnit":{"state":"translated","value":"این میزبان Gateway به راه‌اندازی توکن نیاز دارد"}},"ru":{"stringUnit":{"state":"translated","value":"Для этого хоста gateway требуется настройка токена"}},"sv":{"stringUnit":{"state":"translated","value":"Denna Gateway-värd behöver tokenkonfiguration"}}}},
    "This gateway is set to token auth, but no `gateway.auth.token` is configured on the gateway host. If the gateway uses an environment variable instead, set `OPENCLAW_GATEWAY_TOKEN` before starting the gateway.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This gateway is set to token auth, but no `gateway.auth.token` is configured on the gateway host. If the gateway uses an environment variable instead, set `OPENCLAW_GATEWAY_TOKEN` before starting the gateway."}},"zh-CN":{"stringUnit":{"state":"new","value":"This gateway is set to token auth, but no `gateway.auth.token` is configured on the gateway host. If the gateway uses an environment variable instead, set `OPENCLAW_GATEWAY_TOKEN` before starting the gateway."}},"zh-TW":{"stringUnit":{"state":"new","value":"This gateway is set to token auth, but no `gateway.auth.token` is configured on the gateway host. If the gateway uses an environment variable instead, set `OPENCLAW_GATEWAY_TOKEN` before starting the gateway."}},"pt-BR":{"stringUnit":{"state":"new","value":"This gateway is set to token auth, but no `gateway.auth.token` is configured on the gateway host. If the gateway uses an environment variable instead, set `OPENCLAW_GATEWAY_TOKEN` before starting the gateway."}},"de":{"stringUnit":{"state":"new","value":"This gateway is set to token auth, but no `gateway.auth.token` is configured on the gateway host. If the gateway uses an environment variable instead, set `OPENCLAW_GATEWAY_TOKEN` before starting the gateway."}},"es":{"stringUnit":{"state":"new","value":"This gateway is set to token auth, but no `gateway.auth.token` is configured on the gateway host. If the gateway uses an environment variable instead, set `OPENCLAW_GATEWAY_TOKEN` before starting the gateway."}},"ja-JP":{"stringUnit":{"state":"new","value":"This gateway is set to token auth, but no `gateway.auth.token` is configured on the gateway host. If the gateway uses an environment variable instead, set `OPENCLAW_GATEWAY_TOKEN` before starting the gateway."}},"ko":{"stringUnit":{"state":"new","value":"This gateway is set to token auth, but no `gateway.auth.token` is configured on the gateway host. If the gateway uses an environment variable instead, set `OPENCLAW_GATEWAY_TOKEN` before starting the gateway."}},"fr":{"stringUnit":{"state":"new","value":"This gateway is set to token auth, but no `gateway.auth.token` is configured on the gateway host. If the gateway uses an environment variable instead, set `OPENCLAW_GATEWAY_TOKEN` before starting the gateway."}},"hi":{"stringUnit":{"state":"new","value":"This gateway is set to token auth, but no `gateway.auth.token` is configured on the gateway host. If the gateway uses an environment variable instead, set `OPENCLAW_GATEWAY_TOKEN` before starting the gateway."}},"ar":{"stringUnit":{"state":"new","value":"This gateway is set to token auth, but no `gateway.auth.token` is configured on the gateway host. If the gateway uses an environment variable instead, set `OPENCLAW_GATEWAY_TOKEN` before starting the gateway."}},"it":{"stringUnit":{"state":"new","value":"This gateway is set to token auth, but no `gateway.auth.token` is configured on the gateway host. If the gateway uses an environment variable instead, set `OPENCLAW_GATEWAY_TOKEN` before starting the gateway."}},"tr":{"stringUnit":{"state":"new","value":"This gateway is set to token auth, but no `gateway.auth.token` is configured on the gateway host. If the gateway uses an environment variable instead, set `OPENCLAW_GATEWAY_TOKEN` before starting the gateway."}},"uk":{"stringUnit":{"state":"new","value":"This gateway is set to token auth, but no `gateway.auth.token` is configured on the gateway host. If the gateway uses an environment variable instead, set `OPENCLAW_GATEWAY_TOKEN` before starting the gateway."}},"id":{"stringUnit":{"state":"new","value":"This gateway is set to token auth, but no `gateway.auth.token` is configured on the gateway host. If the gateway uses an environment variable instead, set `OPENCLAW_GATEWAY_TOKEN` before starting the gateway."}},"pl":{"stringUnit":{"state":"new","value":"This gateway is set to token auth, but no `gateway.auth.token` is configured on the gateway host. If the gateway uses an environment variable instead, set `OPENCLAW_GATEWAY_TOKEN` before starting the gateway."}},"th":{"stringUnit":{"state":"new","value":"This gateway is set to token auth, but no `gateway.auth.token` is configured on the gateway host. If the gateway uses an environment variable instead, set `OPENCLAW_GATEWAY_TOKEN` before starting the gateway."}},"vi":{"stringUnit":{"state":"new","value":"This gateway is set to token auth, but no `gateway.auth.token` is configured on the gateway host. If the gateway uses an environment variable instead, set `OPENCLAW_GATEWAY_TOKEN` before starting the gateway."}},"nl":{"stringUnit":{"state":"new","value":"This gateway is set to token auth, but no `gateway.auth.token` is configured on the gateway host. If the gateway uses an environment variable instead, set `OPENCLAW_GATEWAY_TOKEN` before starting the gateway."}},"fa":{"stringUnit":{"state":"new","value":"This gateway is set to token auth, but no `gateway.auth.token` is configured on the gateway host. If the gateway uses an environment variable instead, set `OPENCLAW_GATEWAY_TOKEN` before starting the gateway."}},"ru":{"stringUnit":{"state":"new","value":"This gateway is set to token auth, but no `gateway.auth.token` is configured on the gateway host. If the gateway uses an environment variable instead, set `OPENCLAW_GATEWAY_TOKEN` before starting the gateway."}},"sv":{"stringUnit":{"state":"new","value":"This gateway is set to token auth, but no `gateway.auth.token` is configured on the gateway host. If the gateway uses an environment variable instead, set `OPENCLAW_GATEWAY_TOKEN` before starting the gateway."}}}},
    "This gateway is using unsupported auth": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This gateway is using unsupported auth"}},"zh-CN":{"stringUnit":{"state":"translated","value":"此 Gateway 正在使用不受支持的身份验证"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此 Gateway 使用不受支援的驗證方式"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Este gateway está usando autenticação não compatível"}},"de":{"stringUnit":{"state":"translated","value":"Diese Gateway verwendet eine nicht unterstützte Authentifizierung"}},"es":{"stringUnit":{"state":"translated","value":"Este gateway usa autenticación no compatible"}},"ja-JP":{"stringUnit":{"state":"translated","value":"この Gateway はサポートされていない認証を使用しています"}},"ko":{"stringUnit":{"state":"translated","value":"이 Gateway는 지원되지 않는 인증을 사용하고 있습니다"}},"fr":{"stringUnit":{"state":"translated","value":"Ce Gateway utilise une authentification non prise en charge"}},"hi":{"stringUnit":{"state":"translated","value":"यह gateway unsupported auth का उपयोग कर रहा है"}},"ar":{"stringUnit":{"state":"translated","value":"يستخدم هذا Gateway مصادقة غير مدعومة"}},"it":{"stringUnit":{"state":"translated","value":"Questo gateway usa un'autenticazione non supportata"}},"tr":{"stringUnit":{"state":"translated","value":"Bu gateway desteklenmeyen kimlik doğrulama kullanıyor"}},"uk":{"stringUnit":{"state":"translated","value":"Цей gateway використовує непідтримувану автентифікацію"}},"id":{"stringUnit":{"state":"translated","value":"Gateway ini menggunakan autentikasi yang tidak didukung"}},"pl":{"stringUnit":{"state":"translated","value":"Ten gateway używa nieobsługiwanego uwierzytelniania"}},"th":{"stringUnit":{"state":"translated","value":"Gateway นี้ใช้การยืนยันตัวตนที่ไม่รองรับ"}},"vi":{"stringUnit":{"state":"translated","value":"Gateway này đang dùng phương thức xác thực không được hỗ trợ"}},"nl":{"stringUnit":{"state":"translated","value":"Deze gateway gebruikt niet-ondersteunde auth"}},"fa":{"stringUnit":{"state":"translated","value":"این Gateway از احراز هویت پشتیبانی‌نشده استفاده می‌کند"}},"ru":{"stringUnit":{"state":"translated","value":"Этот gateway использует неподдерживаемую аутентификацию"}},"sv":{"stringUnit":{"state":"translated","value":"Denna Gateway använder autentisering som inte stöds"}}}},
    "This gateway requires an auth token": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This gateway requires an auth token"}},"zh-CN":{"stringUnit":{"state":"translated","value":"此 Gateway 需要身份验证令牌"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此 Gateway 需要驗證權杖"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Este gateway requer um token de autenticação"}},"de":{"stringUnit":{"state":"translated","value":"Diese Gateway erfordert ein Authentifizierungstoken"}},"es":{"stringUnit":{"state":"translated","value":"Este gateway requiere un token de autenticación"}},"ja-JP":{"stringUnit":{"state":"translated","value":"この Gateway には認証トークンが必要です"}},"ko":{"stringUnit":{"state":"translated","value":"이 Gateway에는 인증 토큰이 필요합니다"}},"fr":{"stringUnit":{"state":"translated","value":"Ce Gateway nécessite un jeton d’authentification"}},"hi":{"stringUnit":{"state":"translated","value":"इस gateway को एक auth token की आवश्यकता है"}},"ar":{"stringUnit":{"state":"translated","value":"يتطلب هذا Gateway رمز مصادقة"}},"it":{"stringUnit":{"state":"translated","value":"Questo gateway richiede un token di autenticazione"}},"tr":{"stringUnit":{"state":"translated","value":"Bu gateway bir kimlik doğrulama token'ı gerektirir"}},"uk":{"stringUnit":{"state":"translated","value":"Цей gateway вимагає токен автентифікації"}},"id":{"stringUnit":{"state":"translated","value":"Gateway ini memerlukan token autentikasi"}},"pl":{"stringUnit":{"state":"translated","value":"Ten gateway wymaga tokena uwierzytelniania"}},"th":{"stringUnit":{"state":"translated","value":"Gateway นี้ต้องใช้โทเค็นการยืนยันตัวตน"}},"vi":{"stringUnit":{"state":"translated","value":"Gateway này yêu cầu mã xác thực"}},"nl":{"stringUnit":{"state":"translated","value":"Deze gateway vereist een auth-token"}},"fa":{"stringUnit":{"state":"translated","value":"این Gateway به یک توکن احراز هویت نیاز دارد"}},"ru":{"stringUnit":{"state":"translated","value":"Для этого gateway требуется токен аутентификации"}},"sv":{"stringUnit":{"state":"translated","value":"Denna Gateway kräver en autentiseringstoken"}}}},
    "This gateway requires an auth token. Run openclaw gateway auth-token --show on the gateway host.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This gateway requires an auth token. Run openclaw gateway auth-token --show on the gateway host."}},"zh-CN":{"stringUnit":{"state":"translated","value":"此 gateway 需要身份验证令牌。请在 gateway 主机上运行 openclaw gateway auth-token --show。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此 gateway 需要驗證權杖。請在 gateway 主機上執行 openclaw gateway auth-token --show。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Este gateway requer um token de autenticação. Execute openclaw gateway auth-token --show no host do gateway."}},"de":{"stringUnit":{"state":"translated","value":"Dieses Gateway erfordert ein Auth-Token. Führen Sie openclaw gateway auth-token --show auf dem Gateway-Host aus."}},"es":{"stringUnit":{"state":"translated","value":"Este Gateway requiere un token de autenticación. Ejecuta openclaw gateway auth-token --show en el host del Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このGatewayには認証トークンが必要です。Gatewayホストで openclaw gateway auth-token --show を実行してください。"}},"ko":{"stringUnit":{"state":"translated","value":"이 gateway에는 인증 토큰이 필요합니다. gateway 호스트에서 openclaw gateway auth-token --show를 실행하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Ce gateway nécessite un jeton d'authentification. Exécutez openclaw gateway auth-token --show sur l'hôte du gateway."}},"hi":{"stringUnit":{"state":"translated","value":"इस gateway को एक auth token की आवश्यकता है। gateway host पर openclaw gateway auth-token --show चलाएँ।"}},"ar":{"stringUnit":{"state":"translated","value":"يتطلب Gateway هذا رمز مصادقة. شغّل openclaw gateway auth-token --show على مضيف Gateway."}},"it":{"stringUnit":{"state":"translated","value":"Questo gateway richiede un token di autenticazione. Esegui openclaw gateway auth-token --show sull'host del gateway."}},"tr":{"stringUnit":{"state":"translated","value":"Bu gateway bir kimlik doğrulama belirteci gerektiriyor. Gateway ana bilgisayarında openclaw gateway auth-token --show komutunu çalıştırın."}},"uk":{"stringUnit":{"state":"translated","value":"Цей Gateway потребує токен автентифікації. Виконайте openclaw gateway auth-token --show на хості Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Gateway ini memerlukan token autentikasi. Jalankan openclaw gateway auth-token --show di host gateway."}},"pl":{"stringUnit":{"state":"translated","value":"Ten gateway wymaga tokenu uwierzytelniania. Uruchom openclaw gateway auth-token --show na hoście gateway."}},"th":{"stringUnit":{"state":"translated","value":"Gateway นี้ต้องใช้โทเคนการยืนยันตัวตน รัน openclaw gateway auth-token --show บนโฮสต์ Gateway"}},"vi":{"stringUnit":{"state":"translated","value":"Gateway này yêu cầu token xác thực. Chạy openclaw gateway auth-token --show trên máy chủ gateway."}},"nl":{"stringUnit":{"state":"translated","value":"Deze gateway vereist een auth-token. Voer openclaw gateway auth-token --show uit op de gateway-host."}},"fa":{"stringUnit":{"state":"translated","value":"این Gateway به یک توکن احراز هویت نیاز دارد. دستور openclaw gateway auth-token --show را روی میزبان Gateway اجرا کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Для этого Gateway требуется токен аутентификации. Выполните openclaw gateway auth-token --show на хосте Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Denna gateway kräver en auth-token. Kör openclaw gateway auth-token --show på gateway-värden."}}}},
    "This gateway uses password auth. Remote onboarding on macOS cannot collect gateway passwords yet.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This gateway uses password auth. Remote onboarding on macOS cannot collect gateway passwords yet."}},"zh-CN":{"stringUnit":{"state":"translated","value":"此 Gateway 使用密码认证。macOS 上的远程引导目前还无法收集 Gateway 密码。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此 Gateway 使用密碼驗證。macOS 上的遠端引導目前尚無法收集 Gateway 密碼。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Este gateway usa autenticação por senha. A integração remota no macOS ainda não consegue coletar senhas do gateway."}},"de":{"stringUnit":{"state":"translated","value":"Diese Gateway verwendet Passwortauthentifizierung. Remote-Onboarding unter macOS kann Gateway-Passwörter noch nicht erfassen."}},"es":{"stringUnit":{"state":"translated","value":"Este gateway usa autenticación con contraseña. La incorporación remota en macOS aún no puede recopilar contraseñas de gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このGatewayはパスワード認証を使用しています。macOSでのリモートオンボーディングでは、まだGatewayのパスワードを収集できません。"}},"ko":{"stringUnit":{"state":"translated","value":"이 Gateway는 비밀번호 인증을 사용합니다. macOS의 원격 온보딩은 아직 Gateway 비밀번호를 수집할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Ce Gateway utilise l’authentification par mot de passe. L’intégration à distance sur macOS ne peut pas encore collecter les mots de passe du Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"यह gateway password auth का उपयोग करता है। macOS पर remote onboarding अभी gateway passwords collect नहीं कर सकता।"}},"ar":{"stringUnit":{"state":"translated","value":"يستخدم هذا Gateway مصادقة كلمة المرور. لا يمكن للإعداد عن بُعد على macOS جمع كلمات مرور Gateway بعد."}},"it":{"stringUnit":{"state":"translated","value":"Questo gateway usa l'autenticazione tramite password. L'onboarding remoto su macOS non può ancora raccogliere le password del gateway."}},"tr":{"stringUnit":{"state":"translated","value":"Bu gateway parola kimlik doğrulaması kullanıyor. macOS'te uzaktan başlangıç henüz gateway parolalarını alamaz."}},"uk":{"stringUnit":{"state":"translated","value":"Цей gateway використовує автентифікацію за паролем. Віддалений онбординг у macOS поки не може отримувати паролі gateway."}},"id":{"stringUnit":{"state":"translated","value":"Gateway ini menggunakan autentikasi kata sandi. Onboarding jarak jauh di macOS belum dapat mengumpulkan kata sandi gateway."}},"pl":{"stringUnit":{"state":"translated","value":"Ten gateway używa uwierzytelniania hasłem. Zdalne wdrażanie na macOS nie może jeszcze zbierać haseł gateway."}},"th":{"stringUnit":{"state":"translated","value":"Gateway นี้ใช้การยืนยันตัวตนด้วยรหัสผ่าน การเริ่มต้นใช้งานระยะไกลบน macOS ยังไม่สามารถรวบรวมรหัสผ่านของ Gateway ได้"}},"vi":{"stringUnit":{"state":"translated","value":"Gateway này dùng xác thực bằng mật khẩu. Quy trình giới thiệu từ xa trên macOS chưa thể thu thập mật khẩu Gateway."}},"nl":{"stringUnit":{"state":"translated","value":"Deze gateway gebruikt wachtwoord-auth. Remote onboarding op macOS kan nog geen gatewaywachtwoorden verzamelen."}},"fa":{"stringUnit":{"state":"translated","value":"این Gateway از احراز هویت با گذرواژه استفاده می‌کند. راه‌اندازی اولیه از راه دور در macOS هنوز نمی‌تواند گذرواژه‌های Gateway را دریافت کند."}},"ru":{"stringUnit":{"state":"translated","value":"Этот gateway использует аутентификацию по паролю. Удаленная первичная настройка в macOS пока не может получать пароли gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Denna Gateway använder lösenordsautentisering. Fjärrintroduktion på macOS kan ännu inte samla in Gateway-lösenord."}}}},
    "This onboarding flow does not support password auth yet. Reconfigure the gateway to use token auth, then retry.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This onboarding flow does not support password auth yet. Reconfigure the gateway to use token auth, then retry."}},"zh-CN":{"stringUnit":{"state":"new","value":"This onboarding flow does not support password auth yet. Reconfigure the gateway to use token auth, then retry."}},"zh-TW":{"stringUnit":{"state":"new","value":"This onboarding flow does not support password auth yet. Reconfigure the gateway to use token auth, then retry."}},"pt-BR":{"stringUnit":{"state":"new","value":"This onboarding flow does not support password auth yet. Reconfigure the gateway to use token auth, then retry."}},"de":{"stringUnit":{"state":"new","value":"This onboarding flow does not support password auth yet. Reconfigure the gateway to use token auth, then retry."}},"es":{"stringUnit":{"state":"new","value":"This onboarding flow does not support password auth yet. Reconfigure the gateway to use token auth, then retry."}},"ja-JP":{"stringUnit":{"state":"new","value":"This onboarding flow does not support password auth yet. Reconfigure the gateway to use token auth, then retry."}},"ko":{"stringUnit":{"state":"new","value":"This onboarding flow does not support password auth yet. Reconfigure the gateway to use token auth, then retry."}},"fr":{"stringUnit":{"state":"new","value":"This onboarding flow does not support password auth yet. Reconfigure the gateway to use token auth, then retry."}},"hi":{"stringUnit":{"state":"new","value":"This onboarding flow does not support password auth yet. Reconfigure the gateway to use token auth, then retry."}},"ar":{"stringUnit":{"state":"new","value":"This onboarding flow does not support password auth yet. Reconfigure the gateway to use token auth, then retry."}},"it":{"stringUnit":{"state":"new","value":"This onboarding flow does not support password auth yet. Reconfigure the gateway to use token auth, then retry."}},"tr":{"stringUnit":{"state":"new","value":"This onboarding flow does not support password auth yet. Reconfigure the gateway to use token auth, then retry."}},"uk":{"stringUnit":{"state":"new","value":"This onboarding flow does not support password auth yet. Reconfigure the gateway to use token auth, then retry."}},"id":{"stringUnit":{"state":"new","value":"This onboarding flow does not support password auth yet. Reconfigure the gateway to use token auth, then retry."}},"pl":{"stringUnit":{"state":"new","value":"This onboarding flow does not support password auth yet. Reconfigure the gateway to use token auth, then retry."}},"th":{"stringUnit":{"state":"new","value":"This onboarding flow does not support password auth yet. Reconfigure the gateway to use token auth, then retry."}},"vi":{"stringUnit":{"state":"new","value":"This onboarding flow does not support password auth yet. Reconfigure the gateway to use token auth, then retry."}},"nl":{"stringUnit":{"state":"new","value":"This onboarding flow does not support password auth yet. Reconfigure the gateway to use token auth, then retry."}},"fa":{"stringUnit":{"state":"new","value":"This onboarding flow does not support password auth yet. Reconfigure the gateway to use token auth, then retry."}},"ru":{"stringUnit":{"state":"new","value":"This onboarding flow does not support password auth yet. Reconfigure the gateway to use token auth, then retry."}},"sv":{"stringUnit":{"state":"new","value":"This onboarding flow does not support password auth yet. Reconfigure the gateway to use token auth, then retry."}}}},
    "This process looks expected for the current mode. Kill anyway?": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This process looks expected for the current mode. Kill anyway?"}},"zh-CN":{"stringUnit":{"state":"translated","value":"此进程看起来符合当前模式的预期。仍要结束吗？"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此程序看起來符合目前模式的預期。仍要終止嗎？"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Este processo parece esperado para o modo atual. Encerrar mesmo assim?"}},"de":{"stringUnit":{"state":"translated","value":"Dieser Prozess scheint für den aktuellen Modus erwartet zu sein. Trotzdem beenden?"}},"es":{"stringUnit":{"state":"translated","value":"Este proceso parece esperado para el modo actual. ¿Finalizar de todos modos?"}},"ja-JP":{"stringUnit":{"state":"translated","value":"このプロセスは現在のモードでは想定内のようです。それでも終了しますか？"}},"ko":{"stringUnit":{"state":"translated","value":"이 프로세스는 현재 모드에서 예상된 것으로 보입니다. 그래도 종료하시겠습니까?"}},"fr":{"stringUnit":{"state":"translated","value":"Ce processus semble attendu pour le mode actuel. L’arrêter quand même ?"}},"hi":{"stringUnit":{"state":"translated","value":"यह प्रक्रिया मौजूदा मोड के लिए अपेक्षित लगती है। फिर भी समाप्त करें?"}},"ar":{"stringUnit":{"state":"translated","value":"تبدو هذه العملية متوقعة للوضع الحالي. هل تريد إنهاءها على أي حال؟"}},"it":{"stringUnit":{"state":"translated","value":"Questo processo sembra previsto per la modalità corrente. Terminarlo comunque?"}},"tr":{"stringUnit":{"state":"translated","value":"Bu işlem mevcut mod için beklenen gibi görünüyor. Yine de sonlandırılsın mı?"}},"uk":{"stringUnit":{"state":"translated","value":"Цей процес виглядає очікуваним для поточного режиму. Усе одно завершити?"}},"id":{"stringUnit":{"state":"translated","value":"Proses ini tampak sesuai untuk mode saat ini. Tetap hentikan?"}},"pl":{"stringUnit":{"state":"translated","value":"Ten proces wygląda na oczekiwany w bieżącym trybie. Zakończyć mimo to?"}},"th":{"stringUnit":{"state":"translated","value":"กระบวนการนี้ดูเหมือนเป็นไปตามที่คาดไว้สำหรับโหมดปัจจุบัน ต้องการหยุดอยู่ดีหรือไม่?"}},"vi":{"stringUnit":{"state":"translated","value":"Quy trình này có vẻ đúng như mong đợi cho chế độ hiện tại. Vẫn dừng?"}},"nl":{"stringUnit":{"state":"translated","value":"Dit proces lijkt verwacht voor de huidige modus. Toch beëindigen?"}},"fa":{"stringUnit":{"state":"translated","value":"این فرایند برای حالت فعلی مورد انتظار به نظر می‌رسد. بااین‌حال خاتمه داده شود؟"}},"ru":{"stringUnit":{"state":"translated","value":"Этот процесс выглядит ожидаемым для текущего режима. Всё равно завершить?"}},"sv":{"stringUnit":{"state":"translated","value":"Den här processen verkar förväntad för det aktuella läget. Avsluta ändå?"}}}},
    "This resets the conversation for %@. The session key stays the same.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This resets the conversation for %@. The session key stays the same."}},"zh-CN":{"stringUnit":{"state":"translated","value":"这将重置与 %@ 的对话。会话密钥保持不变。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"這會重設與 %@ 的對話。工作階段金鑰將維持不變。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Isso redefine a conversa para %@. A chave da sessão permanece a mesma."}},"de":{"stringUnit":{"state":"translated","value":"Dadurch wird die Unterhaltung für %@ zurückgesetzt. Der Sitzungsschlüssel bleibt unverändert."}},"es":{"stringUnit":{"state":"translated","value":"Esto reinicia la conversación para %@. La clave de sesión permanece igual."}},"ja-JP":{"stringUnit":{"state":"translated","value":"%@の会話がリセットされます。セッションキーは変更されません。"}},"ko":{"stringUnit":{"state":"translated","value":"%@의 대화가 초기화됩니다. 세션 키는 그대로 유지됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Cette opération réinitialise la conversation pour %@. La clé de session reste la même."}},"hi":{"stringUnit":{"state":"translated","value":"यह %@ के लिए बातचीत रीसेट करता है। सेशन कुंजी वही रहती है।"}},"ar":{"stringUnit":{"state":"translated","value":"سيؤدي هذا إلى إعادة تعيين المحادثة لـ %@. سيبقى مفتاح الجلسة كما هو."}},"it":{"stringUnit":{"state":"translated","value":"Questa operazione reimposta la conversazione per %@. La chiave di sessione rimane invariata."}},"tr":{"stringUnit":{"state":"translated","value":"Bu işlem, %@ için konuşmayı sıfırlar. Oturum anahtarı aynı kalır."}},"uk":{"stringUnit":{"state":"translated","value":"Це скине розмову для %@. Ключ сеансу залишиться незмінним."}},"id":{"stringUnit":{"state":"translated","value":"Tindakan ini mengatur ulang percakapan untuk %@. Kunci sesi tetap sama."}},"pl":{"stringUnit":{"state":"translated","value":"Spowoduje to zresetowanie rozmowy dla %@. Klucz sesji pozostanie bez zmian."}},"th":{"stringUnit":{"state":"translated","value":"การดำเนินการนี้จะรีเซ็ตการสนทนาสำหรับ %@ โดยคีย์เซสชันจะยังคงเดิม"}},"vi":{"stringUnit":{"state":"translated","value":"Thao tác này sẽ đặt lại cuộc trò chuyện cho %@. Khóa phiên vẫn giữ nguyên."}},"nl":{"stringUnit":{"state":"translated","value":"Hiermee wordt het gesprek voor %@ gereset. De sessiesleutel blijft hetzelfde."}},"fa":{"stringUnit":{"state":"translated","value":"با این کار مکالمه برای %@ بازنشانی می‌شود. کلید نشست بدون تغییر باقی می‌ماند."}},"ru":{"stringUnit":{"state":"translated","value":"Это сбросит разговор для %@. Ключ сеанса останется прежним."}},"sv":{"stringUnit":{"state":"translated","value":"Detta återställer konversationen för %@. Sessionsnyckeln förblir densamma."}}}},
    "This setup code is no longer valid": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This setup code is no longer valid"}},"zh-CN":{"stringUnit":{"state":"translated","value":"此设置代码不再有效"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此設定碼已不再有效"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Este código de configuração não é mais válido"}},"de":{"stringUnit":{"state":"translated","value":"Dieser Einrichtungscode ist nicht mehr gültig"}},"es":{"stringUnit":{"state":"translated","value":"Este código de configuración ya no es válido"}},"ja-JP":{"stringUnit":{"state":"translated","value":"このセットアップコードはすでに無効です"}},"ko":{"stringUnit":{"state":"translated","value":"이 설정 코드는 더 이상 유효하지 않습니다"}},"fr":{"stringUnit":{"state":"translated","value":"Ce code de configuration n’est plus valide"}},"hi":{"stringUnit":{"state":"translated","value":"यह setup code अब मान्य नहीं है"}},"ar":{"stringUnit":{"state":"translated","value":"لم يعد رمز الإعداد هذا صالحًا"}},"it":{"stringUnit":{"state":"translated","value":"Questo codice di configurazione non è più valido"}},"tr":{"stringUnit":{"state":"translated","value":"Bu kurulum kodu artık geçerli değil"}},"uk":{"stringUnit":{"state":"translated","value":"Цей код налаштування більше не дійсний"}},"id":{"stringUnit":{"state":"translated","value":"Kode penyiapan ini sudah tidak valid"}},"pl":{"stringUnit":{"state":"translated","value":"Ten kod konfiguracji nie jest już ważny"}},"th":{"stringUnit":{"state":"translated","value":"รหัสตั้งค่านี้ไม่สามารถใช้ได้อีกต่อไป"}},"vi":{"stringUnit":{"state":"translated","value":"Mã thiết lập này không còn hợp lệ"}},"nl":{"stringUnit":{"state":"translated","value":"Deze instelcode is niet langer geldig"}},"fa":{"stringUnit":{"state":"translated","value":"این کد راه‌اندازی دیگر معتبر نیست"}},"ru":{"stringUnit":{"state":"translated","value":"Этот код настройки больше недействителен"}},"sv":{"stringUnit":{"state":"translated","value":"Denna konfigurationskod är inte längre giltig"}}}},
    "This tab is read-only in Nix mode. Edit config via Nix and rebuild.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This tab is read-only in Nix mode. Edit config via Nix and rebuild."}},"zh-CN":{"stringUnit":{"state":"translated","value":"此标签页在 Nix 模式下为只读。请通过 Nix 编辑配置并重新构建。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此分頁在 Nix 模式中為唯讀。請透過 Nix 編輯 config 並重新建置。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Esta aba é somente leitura no modo Nix. Edite a configuração via Nix e recompile."}},"de":{"stringUnit":{"state":"translated","value":"Dieser Tab ist im Nix-Modus schreibgeschützt. Bearbeiten Sie die Konfiguration über Nix und erstellen Sie sie neu."}},"es":{"stringUnit":{"state":"translated","value":"Esta pestaña es de solo lectura en modo Nix. Edita la configuración mediante Nix y recompila."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このタブは Nix モードでは読み取り専用です。Nix で設定を編集し、再ビルドしてください。"}},"ko":{"stringUnit":{"state":"translated","value":"이 탭은 Nix 모드에서 읽기 전용입니다. Nix를 통해 구성을 편집하고 다시 빌드하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Cet onglet est en lecture seule en mode Nix. Modifiez la configuration via Nix et recompilez."}},"hi":{"stringUnit":{"state":"translated","value":"यह टैब Nix मोड में केवल-पढ़ने योग्य है। Nix के माध्यम से कॉन्फ़िग संपादित करें और फिर से बिल्ड करें।"}},"ar":{"stringUnit":{"state":"translated","value":"علامة التبويب هذه للقراءة فقط في وضع Nix. حرّر التكوين عبر Nix وأعد البناء."}},"it":{"stringUnit":{"state":"translated","value":"Questa scheda è di sola lettura in modalità Nix. Modifica la configurazione tramite Nix e ricompila."}},"tr":{"stringUnit":{"state":"translated","value":"Bu sekme Nix modunda salt okunurdur. Config'i Nix üzerinden düzenleyin ve yeniden derleyin."}},"uk":{"stringUnit":{"state":"translated","value":"Ця вкладка доступна лише для читання в режимі Nix. Редагуйте конфігурацію через Nix і перебудуйте."}},"id":{"stringUnit":{"state":"translated","value":"Tab ini hanya-baca dalam mode Nix. Edit config melalui Nix dan bangun ulang."}},"pl":{"stringUnit":{"state":"translated","value":"Ta karta jest tylko do odczytu w trybie Nix. Edytuj konfigurację przez Nix i przebuduj."}},"th":{"stringUnit":{"state":"translated","value":"แท็บนี้เป็นแบบอ่านอย่างเดียวในโหมด Nix แก้ไขการกำหนดค่าผ่าน Nix แล้วสร้างใหม่"}},"vi":{"stringUnit":{"state":"translated","value":"Tab này ở chế độ chỉ đọc trong chế độ Nix. Chỉnh sửa cấu hình qua Nix và build lại."}},"nl":{"stringUnit":{"state":"translated","value":"Dit tabblad is alleen-lezen in Nix-modus. Bewerk de configuratie via Nix en bouw opnieuw."}},"fa":{"stringUnit":{"state":"translated","value":"این زبانه در حالت Nix فقط‌خواندنی است. پیکربندی را از طریق Nix ویرایش کنید و دوباره بسازید."}},"ru":{"stringUnit":{"state":"translated","value":"Эта вкладка доступна только для чтения в режиме Nix. Измените конфигурацию через Nix и выполните пересборку."}},"sv":{"stringUnit":{"state":"translated","value":"Den här fliken är skrivskyddad i Nix-läge. Redigera konfigurationen via Nix och bygg om."}}}},
    "This thread cannot be archived while it is active or running.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This thread cannot be archived while it is active or running."}},"zh-CN":{"stringUnit":{"state":"translated","value":"此话题串处于活动或运行状态时无法归档。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"此討論串仍在使用或執行中，因此無法封存。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Esta conversa não pode ser arquivada enquanto estiver ativa ou em execução."}},"de":{"stringUnit":{"state":"translated","value":"Dieser Thread kann nicht archiviert werden, solange er aktiv ist oder ausgeführt wird."}},"es":{"stringUnit":{"state":"translated","value":"Este hilo no se puede archivar mientras esté activo o en ejecución."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このスレッドは、アクティブまたは実行中のためアーカイブできません。"}},"ko":{"stringUnit":{"state":"translated","value":"이 스레드가 활성 상태이거나 실행 중인 동안에는 보관할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Ce fil de discussion ne peut pas être archivé tant qu’il est actif ou en cours d’exécution."}},"hi":{"stringUnit":{"state":"translated","value":"सक्रिय या चालू होने के दौरान इस थ्रेड को आर्काइव नहीं किया जा सकता।"}},"ar":{"stringUnit":{"state":"translated","value":"لا يمكن أرشفة هذه المحادثة أثناء نشاطها أو تشغيلها."}},"it":{"stringUnit":{"state":"translated","value":"Questo thread non può essere archiviato mentre è attivo o in esecuzione."}},"tr":{"stringUnit":{"state":"translated","value":"Bu dizi etkinken veya çalışırken arşivlenemez."}},"uk":{"stringUnit":{"state":"translated","value":"Цю гілку не можна архівувати, доки вона активна або виконується."}},"id":{"stringUnit":{"state":"translated","value":"Utas ini tidak dapat diarsipkan saat aktif atau sedang berjalan."}},"pl":{"stringUnit":{"state":"translated","value":"Nie można zarchiwizować tego wątku, gdy jest aktywny lub uruchomiony."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถเก็บเธรดนี้เข้าคลังขณะที่ยังเปิดใช้งานหรือกำลังทำงานอยู่"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể lưu trữ chuỗi này khi chuỗi đang hoạt động hoặc đang chạy."}},"nl":{"stringUnit":{"state":"translated","value":"Dit gesprek kan niet worden gearchiveerd zolang het actief is of wordt uitgevoerd."}},"fa":{"stringUnit":{"state":"translated","value":"تا زمانی که این رشته فعال یا در حال اجرا است، نمی‌توان آن را بایگانی کرد."}},"ru":{"stringUnit":{"state":"translated","value":"Эту ветку нельзя архивировать, пока она активна или выполняется."}},"sv":{"stringUnit":{"state":"translated","value":"Den här tråden kan inte arkiveras medan den är aktiv eller körs."}}}},
