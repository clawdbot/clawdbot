    "Summarize the current OpenClaw status and tell me what needs attention.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Summarize the current OpenClaw status and tell me what needs attention."}},"zh-CN":{"stringUnit":{"state":"translated","value":"总结当前 OpenClaw 的状态，并告诉我有哪些需要关注的事项。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"摘要說明 OpenClaw 目前的狀態，並告訴我有哪些事項需要注意。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Resuma o status atual do OpenClaw e me diga o que precisa de atenção."}},"de":{"stringUnit":{"state":"translated","value":"Fasse den aktuellen OpenClaw-Status zusammen und sage mir, was Aufmerksamkeit erfordert."}},"es":{"stringUnit":{"state":"translated","value":"Resume el estado actual de OpenClaw y dime qué requiere atención."}},"ja-JP":{"stringUnit":{"state":"translated","value":"現在のOpenClawのステータスを要約し、注意が必要な点を教えてください。"}},"ko":{"stringUnit":{"state":"translated","value":"현재 OpenClaw 상태를 요약하고 주의가 필요한 사항을 알려주세요."}},"fr":{"stringUnit":{"state":"translated","value":"Résume l’état actuel d’OpenClaw et indique-moi les points à surveiller."}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw की मौजूदा स्थिति का सारांश दें और मुझे बताएं कि किन बातों पर ध्यान देना ज़रूरी है."}},"ar":{"stringUnit":{"state":"translated","value":"لخّص حالة OpenClaw الحالية وأخبرني بما يحتاج إلى اهتمام."}},"it":{"stringUnit":{"state":"translated","value":"Riepiloga lo stato attuale di OpenClaw e dimmi cosa richiede attenzione."}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw'ın mevcut durumunu özetle ve ilgilenmem gereken konuları söyle."}},"uk":{"stringUnit":{"state":"translated","value":"Підсумуй поточний стан OpenClaw і розкажи, що потребує уваги."}},"id":{"stringUnit":{"state":"translated","value":"Ringkas status OpenClaw saat ini dan beri tahu saya apa yang perlu diperhatikan."}},"pl":{"stringUnit":{"state":"translated","value":"Podsumuj aktualny stan OpenClaw i powiedz, co wymaga uwagi."}},"th":{"stringUnit":{"state":"translated","value":"สรุปสถานะปัจจุบันของ OpenClaw และบอกฉันว่ามีอะไรที่ต้องตรวจสอบ"}},"vi":{"stringUnit":{"state":"translated","value":"Tóm tắt trạng thái hiện tại của OpenClaw và cho tôi biết những vấn đề cần chú ý."}},"nl":{"stringUnit":{"state":"translated","value":"Vat de huidige status van OpenClaw samen en vertel me wat aandacht nodig heeft."}},"fa":{"stringUnit":{"state":"translated","value":"وضعیت فعلی OpenClaw را خلاصه کن و بگو چه مواردی به توجه نیاز دارند."}},"ru":{"stringUnit":{"state":"translated","value":"Кратко опиши текущее состояние OpenClaw и сообщи, что требует внимания."}},"sv":{"stringUnit":{"state":"translated","value":"Sammanfatta aktuell OpenClaw-status och berätta vad som behöver åtgärdas."}}}},
    "Summarize what happened in my threads since yesterday.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Summarize what happened in my threads since yesterday."}},"zh-CN":{"stringUnit":{"state":"translated","value":"总结自昨天以来我的会话中发生的事情。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"摘要說明我的討論串自昨天以來有哪些動態。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Resuma o que aconteceu nas minhas conversas desde ontem."}},"de":{"stringUnit":{"state":"translated","value":"Fasse zusammen, was seit gestern in meinen Threads passiert ist."}},"es":{"stringUnit":{"state":"translated","value":"Resume lo que ha pasado en mis hilos desde ayer."}},"ja-JP":{"stringUnit":{"state":"translated","value":"昨日から私のスレッドで起きたことを要約してください。"}},"ko":{"stringUnit":{"state":"translated","value":"어제부터 내 스레드에서 있었던 일을 요약해 주세요."}},"fr":{"stringUnit":{"state":"translated","value":"Résume ce qui s’est passé dans mes fils de discussion depuis hier."}},"hi":{"stringUnit":{"state":"translated","value":"कल से मेरे थ्रेड में जो हुआ उसका सारांश दें."}},"ar":{"stringUnit":{"state":"translated","value":"لخّص ما حدث في سلاسل محادثاتي منذ أمس."}},"it":{"stringUnit":{"state":"translated","value":"Riassumi cosa è successo nelle mie conversazioni da ieri."}},"tr":{"stringUnit":{"state":"translated","value":"Dünden bu yana sohbetlerimde neler olduğunu özetle."}},"uk":{"stringUnit":{"state":"translated","value":"Підсумуй, що відбулося в моїх гілках обговорення від учора."}},"id":{"stringUnit":{"state":"translated","value":"Ringkas apa yang terjadi di utas saya sejak kemarin."}},"pl":{"stringUnit":{"state":"translated","value":"Podsumuj, co wydarzyło się w moich wątkach od wczoraj."}},"th":{"stringUnit":{"state":"translated","value":"สรุปสิ่งที่เกิดขึ้นในเธรดของฉันตั้งแต่เมื่อวาน."}},"vi":{"stringUnit":{"state":"translated","value":"Tóm tắt những gì đã diễn ra trong các luồng trò chuyện của tôi kể từ hôm qua."}},"nl":{"stringUnit":{"state":"translated","value":"Vat samen wat er sinds gisteren in mijn discussies is gebeurd."}},"fa":{"stringUnit":{"state":"translated","value":"آنچه از دیروز در رشته‌گفتگوهایم رخ داده را خلاصه کن."}},"ru":{"stringUnit":{"state":"translated","value":"Кратко расскажи, что произошло в моих обсуждениях со вчерашнего дня."}},"sv":{"stringUnit":{"state":"translated","value":"Sammanfatta vad som har hänt i mina trådar sedan igår."}}}},
    "Surfacing": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Surfacing"}},"zh-CN":{"stringUnit":{"state":"translated","value":"浮出水面"}},"zh-TW":{"stringUnit":{"state":"translated","value":"浮出水面"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Emergindo"}},"de":{"stringUnit":{"state":"translated","value":"Auftauchen"}},"es":{"stringUnit":{"state":"translated","value":"Saliendo a la superficie"}},"ja-JP":{"stringUnit":{"state":"translated","value":"浮上"}},"ko":{"stringUnit":{"state":"translated","value":"부상"}},"fr":{"stringUnit":{"state":"translated","value":"Remontée à la surface"}},"hi":{"stringUnit":{"state":"translated","value":"सतह पर आना"}},"ar":{"stringUnit":{"state":"translated","value":"الصعود إلى السطح"}},"it":{"stringUnit":{"state":"translated","value":"Emersione"}},"tr":{"stringUnit":{"state":"translated","value":"Yüzeye çıkış"}},"uk":{"stringUnit":{"state":"translated","value":"Спливання"}},"id":{"stringUnit":{"state":"translated","value":"Muncul ke Permukaan"}},"pl":{"stringUnit":{"state":"translated","value":"Wynurzanie"}},"th":{"stringUnit":{"state":"translated","value":"กำลังขึ้นสู่ผิวน้ำ"}},"vi":{"stringUnit":{"state":"translated","value":"Đang nổi lên"}},"nl":{"stringUnit":{"state":"translated","value":"Bovenkomen"}},"fa":{"stringUnit":{"state":"translated","value":"آمدن به سطح"}},"ru":{"stringUnit":{"state":"translated","value":"Всплытие"}},"sv":{"stringUnit":{"state":"translated","value":"På väg upp till ytan"}}}},
    "Swarm": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Swarm"}},"zh-CN":{"stringUnit":{"state":"translated","value":"集群"}},"zh-TW":{"stringUnit":{"state":"translated","value":"群集"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Enxame"}},"de":{"stringUnit":{"state":"translated","value":"Schwarm"}},"es":{"stringUnit":{"state":"translated","value":"Enjambre"}},"ja-JP":{"stringUnit":{"state":"translated","value":"群れ"}},"ko":{"stringUnit":{"state":"translated","value":"군집"}},"fr":{"stringUnit":{"state":"translated","value":"Essaim"}},"hi":{"stringUnit":{"state":"translated","value":"झुंड"}},"ar":{"stringUnit":{"state":"translated","value":"سرب"}},"it":{"stringUnit":{"state":"translated","value":"Sciame"}},"tr":{"stringUnit":{"state":"translated","value":"Sürü"}},"uk":{"stringUnit":{"state":"translated","value":"Рій"}},"id":{"stringUnit":{"state":"translated","value":"Kawanan"}},"pl":{"stringUnit":{"state":"translated","value":"Rój"}},"th":{"stringUnit":{"state":"translated","value":"ฝูง"}},"vi":{"stringUnit":{"state":"translated","value":"Bầy đàn"}},"nl":{"stringUnit":{"state":"translated","value":"Zwerm"}},"fa":{"stringUnit":{"state":"translated","value":"ازدحام"}},"ru":{"stringUnit":{"state":"translated","value":"Рой"}},"sv":{"stringUnit":{"state":"translated","value":"Svärm"}}}},
    "Switch this Mac app to a local Gateway before importing browser cookies.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Switch this Mac app to a local Gateway before importing browser cookies."}},"zh-CN":{"stringUnit":{"state":"translated","value":"导入浏览器 Cookie 前，请将此 Mac 应用切换到本地 Gateway。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"匯入瀏覽器 Cookie 前，請先將此 Mac App 切換至本機 Gateway。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Altere este app para Mac para usar um Gateway local antes de importar cookies do navegador."}},"de":{"stringUnit":{"state":"translated","value":"Stellen Sie diese Mac-App auf ein lokales Gateway um, bevor Sie Browser-Cookies importieren."}},"es":{"stringUnit":{"state":"translated","value":"Cambia esta aplicación para Mac a un Gateway local antes de importar las cookies del navegador."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ブラウザのCookieをインポートする前に、このMacアプリをローカルのGatewayに切り替えてください。"}},"ko":{"stringUnit":{"state":"translated","value":"브라우저 쿠키를 가져오기 전에 이 Mac 앱을 로컬 Gateway로 전환하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Connectez cette application Mac à un Gateway local avant d’importer les cookies du navigateur."}},"hi":{"stringUnit":{"state":"translated","value":"ब्राउज़र कुकीज़ आयात करने से पहले इस Mac ऐप को स्थानीय Gateway पर स्विच करें।"}},"ar":{"stringUnit":{"state":"translated","value":"حوّل تطبيق Mac هذا إلى Gateway محلي قبل استيراد ملفات تعريف ارتباط المتصفح."}},"it":{"stringUnit":{"state":"translated","value":"Passa questa app per Mac a un Gateway locale prima di importare i cookie del browser."}},"tr":{"stringUnit":{"state":"translated","value":"Tarayıcı çerezlerini içe aktarmadan önce bu Mac uygulamasını yerel bir Gateway'e geçirin."}},"uk":{"stringUnit":{"state":"translated","value":"Перемкніть цей застосунок для Mac на локальний Gateway, перш ніж імпортувати файли cookie браузера."}},"id":{"stringUnit":{"state":"translated","value":"Alihkan aplikasi Mac ini ke Gateway lokal sebelum mengimpor cookie browser."}},"pl":{"stringUnit":{"state":"translated","value":"Przełącz tę aplikację na Maca na lokalny Gateway przed zaimportowaniem plików cookie przeglądarki."}},"th":{"stringUnit":{"state":"translated","value":"สลับแอป Mac นี้ไปใช้ Gateway ภายในเครื่องก่อนนำเข้าคุกกี้ของเบราว์เซอร์."}},"vi":{"stringUnit":{"state":"translated","value":"Chuyển ứng dụng Mac này sang Gateway cục bộ trước khi nhập cookie trình duyệt."}},"nl":{"stringUnit":{"state":"translated","value":"Schakel deze Mac-app over naar een lokale Gateway voordat je browsercookies importeert."}},"fa":{"stringUnit":{"state":"translated","value":"پیش از وارد کردن کوکی‌های مرورگر، این برنامهٔ Mac را به یک Gateway محلی متصل کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Переключите это приложение для Mac на локальный Gateway перед импортом файлов cookie браузера."}},"sv":{"stringUnit":{"state":"translated","value":"Byt till en lokal Gateway i den här Mac-appen innan du importerar webbläsarkakor."}}}},
