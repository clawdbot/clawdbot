    "Switches to Local mode to install on this Mac.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Switches to Local mode to install on this Mac."}},"zh-CN":{"stringUnit":{"state":"translated","value":"切换到本地模式以在此 Mac 上安装。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"切換至本機模式，以便安裝到這台 Mac。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Alterna para o modo Local para instalar neste Mac."}},"de":{"stringUnit":{"state":"translated","value":"Wechselt in den lokalen Modus, um auf diesem Mac zu installieren."}},"es":{"stringUnit":{"state":"translated","value":"Cambia al modo local para instalar en esta Mac."}},"ja-JP":{"stringUnit":{"state":"translated","value":"この Mac にインストールするため、ローカルモードに切り替えます。"}},"ko":{"stringUnit":{"state":"translated","value":"이 Mac에 설치하기 위해 로컬 모드로 전환합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Passe en mode local pour l’installer sur ce Mac."}},"hi":{"stringUnit":{"state":"translated","value":"इस Mac पर इंस्टॉल करने के लिए Local मोड में स्विच करता है।"}},"ar":{"stringUnit":{"state":"translated","value":"يبدّل إلى الوضع المحلي للتثبيت على هذا الـ Mac."}},"it":{"stringUnit":{"state":"translated","value":"Passa alla modalità locale per installare su questo Mac."}},"tr":{"stringUnit":{"state":"translated","value":"Bu Mac'e yüklemek için Yerel moda geçer."}},"uk":{"stringUnit":{"state":"translated","value":"Перемикає в локальний режим для встановлення на цей Mac."}},"id":{"stringUnit":{"state":"translated","value":"Beralih ke mode Lokal untuk menginstal di Mac ini."}},"pl":{"stringUnit":{"state":"translated","value":"Przełącza na tryb lokalny, aby zainstalować na tym Macu."}},"th":{"stringUnit":{"state":"translated","value":"สลับเป็นโหมด Local เพื่อติดตั้งบน Mac เครื่องนี้"}},"vi":{"stringUnit":{"state":"translated","value":"Chuyển sang chế độ Local để cài đặt trên máy Mac này."}},"nl":{"stringUnit":{"state":"translated","value":"Schakelt over naar lokale modus om op deze Mac te installeren."}},"fa":{"