    "Tool changes apply to the next run.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Tool changes apply to the next run."}},"zh-CN":{"stringUnit":{"state":"translated","value":"工具更改将在下次运行时生效。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"工具變更將於下次執行時生效。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"As alterações nas ferramentas serão aplicadas na próxima execução."}},"de":{"stringUnit":{"state":"translated","value":"Änderungen an Werkzeugen gelten ab dem nächsten Durchlauf."}},"es":{"stringUnit":{"state":"translated","value":"Los cambios en las herramientas se aplicarán en la próxima ejecución."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ツールの変更は次回の実行から適用されます。"}},"ko":{"stringUnit":{"state":"translated","value":"도구 변경 사항은 다음 실행부터 적용됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les modifications des outils s’appliquent à la prochaine exécution."}},"hi":{"stringUnit":{"state":"translated","value":"टूल में किए गए बदलाव अगले रन पर लागू होंगे."}},"ar":{"stringUnit":{"state":"translated","value":"تُطبَّق تغييرات الأدوات عند التشغيل التالي."}},"it":{"stringUnit":{"state":"translated","value":"Le modifiche agli strumenti si applicano alla prossima esecuzione."}},"tr":{"stringUnit":{"state":"translated","value":"Araç değişiklikleri bir sonraki çalıştırmada uygulanır."}},"uk":{"stringUnit":{"state":"translated","value":"Зміни інструментів застосуються під час наступного запуску."}},"id":{"stringUnit":{"state":"translated","value":"Perubahan alat berlaku pada proses berikutnya."}},"pl":{"stringUnit":{"state":"translated","value":"Zmiany narzędzi zostaną zastosowane przy następnym uruchomieniu."}},"th":{"stringUnit":{"state":"translated","value":"การเปลี่ยนแปลงเครื่องมือจะมีผลในการเรียกใช้ครั้งถัดไป."}},"vi":{"stringUnit":{"state":"translated","value":"Các thay đổi về công cụ sẽ áp dụng cho lần chạy tiếp theo."}},"nl":{"stringUnit":{"state":"translated","value":"Wijzigingen aan hulpmiddelen gelden vanaf de volg