    "Diagram preview unavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Diagram preview unavailable"}},"zh-CN":{"stringUnit":{"state":"translated","value":"图表预览不可用"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法預覽圖表"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Prévia do diagrama indisponível"}},"de":{"stringUnit":{"state":"translated","value":"Diagrammvorschau nicht verfügbar"}},"es":{"stringUnit":{"state":"translated","value":"Vista previa del diagrama no disponible"}},"ja-JP":{"stringUnit":{"state":"translated","value":"図のプレビューを利用できません"}},"ko":{"stringUnit":{"state":"translated","value":"다이어그램 미리보기를 사용할 수 없음"}},"fr":{"stringUnit":{"state":"translated","value":"Aperçu du diagramme indisponible"}},"hi":{"stringUnit":{"state":"translated","value":"आरेख का पूर्वावलोकन उपलब्ध नहीं है"}},"ar":{"stringUnit":{"state":"translated","value":"معاينة المخطط غير متاحة"}},"it":{"stringUnit":{"state":"translated","value":"Anteprima del diagramma non disponibile"}},"tr":{"stringUnit":{"state":"translated","value":"Diyagram önizlemesi kullanılamıyor"}},"uk":{"stringUnit":{"state":"translated","value":"Попередній перегляд діаграми недоступний"}},"id":{"stringUnit":{"state":"translated","value":"Pratinjau diagram tidak tersedia"}},"pl":{"stringUnit":{"state":"translated","value":"Podgląd diagramu niedostępny"}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถแสดงตัวอย่างแผนภาพได้"}},"vi":{"stringUnit":{"state":"translated","value":"Không có bản xem trước sơ đồ"}},"nl":{"stringUnit":{"state":"translated","value":"Diagramvoorbeeld niet beschikbaar"}},"fa":{"stringUnit":{"state":"translated","value":"پیش‌نمایش نمودار در دسترس نیست"}},"ru":{"stringUnit":{"state":"translated","value":"Предпросмотр диаграммы недоступен"}},"sv":{"stringUnit":{"state":"translated","value":"Förhandsvisning av diagram är inte tillgänglig"}}}},
    "Diagram temporarily unavailable. Use the menu to retry, or read and copy its source.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Diagram temporarily unavailable. Use the menu to retry, or read and copy its source."}},"zh-CN":{"stringUnit":{"state":"translated","value":"图表暂时不可用。 请使用菜单重试, 或查看并复制其源代码。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"圖表暫時無法使用。 請使用選單重試, 或閱讀並複製其原始碼。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Diagrama temporariamente indisponível. Use o menu para tentar novamente ou leia e copie seu código-fonte."}},"de":{"stringUnit":{"state":"translated","value":"Diagramm vorübergehend nicht verfügbar. Über das Menü können Sie es erneut versuchen oder den Quelltext lesen und kopieren."}},"es":{"stringUnit":{"state":"translated","value":"Diagrama no disponible temporalmente. Usa el menú para volver a intentarlo, o lee y copia su código fuente."}},"ja-JP":{"stringUnit":{"state":"translated","value":"図を一時的に表示できません。 メニューから再試行するか、ソースを表示してコピーしてください。"}},"ko":{"stringUnit":{"state":"translated","value":"다이어그램을 일시적으로 사용할 수 없습니다. 메뉴에서 다시 시도하거나 소스를 읽고 복사하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Diagramme temporairement indisponible. Utilisez le menu pour réessayer, ou lisez et copiez son code source."}},"hi":{"stringUnit":{"state":"translated","value":"आरेख अस्थायी रूप से उपलब्ध नहीं है. फिर से प्रयास करने के लिए मेनू का उपयोग करें, या इसका स्रोत पढ़ें और कॉपी करें."}},"ar":{"stringUnit":{"state":"translated","value":"المخطط غير متاح مؤقتًا. استخدم القائمة لإعادة المحاولة، أو اقرأ مصدره وانسخه."}},"it":{"stringUnit":{"state":"translated","value":"Diagramma temporaneamente non disponibile. Usa il menu per riprovare, oppure leggi e copia il codice sorgente."}},"tr":{"stringUnit":{"state":"translated","value":"Diyagram geçici olarak kullanılamıyor. Yeniden denemek veya kaynak kodunu okuyup kopyalamak için menüyü kullanın."}},"uk":{"stringUnit":{"state":"translated","value":"Діаграма тимчасово недоступна. Скористайтеся меню, щоб повторити спробу або переглянути й скопіювати її вихідний код."}},"id":{"stringUnit":{"state":"translated","value":"Diagram sementara tidak tersedia. Gunakan menu untuk mencoba lagi, atau baca dan salin sumbernya."}},"pl":{"stringUnit":{"state":"translated","value":"Diagram jest tymczasowo niedostępny. Użyj menu, aby spróbować ponownie lub przeczytać i skopiować jego kod źródłowy."}},"th":{"stringUnit":{"state":"translated","value":"แผนภาพไม่พร้อมใช้งานชั่วคราว. ใช้เมนูเพื่อลองอีกครั้ง หรืออ่านและคัดลอกซอร์สของแผนภาพ."}},"vi":{"stringUnit":{"state":"translated","value":"Sơ đồ tạm thời không khả dụng. Dùng menu để thử lại, hoặc đọc và sao chép mã nguồn của sơ đồ."}},"nl":{"stringUnit":{"state":"translated","value":"Diagram tijdelijk niet beschikbaar. Gebruik het menu om het opnieuw te proberen, of lees en kopieer de broncode."}},"fa":{"stringUnit":{"state":"translated","value":"نمودار موقتاً در دسترس نیست. برای تلاش مجدد از منو استفاده کنید، یا کد منبع آن را بخوانید و کپی کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Диаграмма временно недоступна. Используйте меню, чтобы повторить попытку, просмотреть или скопировать её исходный код."}},"sv":{"stringUnit":{"state":"translated","value":"Diagrammet är tillfälligt otillgängligt. Använd menyn för att försöka igen, eller läs och kopiera dess källkod."}}}},
    "Diagram unavailable. Check the syntax or simplify the diagram. You can still read or copy its source.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Diagram unavailable. Check the syntax or simplify the diagram. You can still read or copy its source."}},"zh-CN":{"stringUnit":{"state":"translated","value":"图表不可用。 请检查语法或简化图表。 您仍可查看或复制其源代码。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"圖表無法使用。 請檢查語法或簡化圖表。 您仍可閱讀或複製其原始碼。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Diagrama indisponível. Verifique a sintaxe ou simplifique o diagrama. Você ainda pode ler ou copiar seu código-fonte."}},"de":{"stringUnit":{"state":"translated","value":"Diagramm nicht verfügbar. Prüfen Sie die Syntax oder vereinfachen Sie das Diagramm. Sie können den Quelltext weiterhin lesen oder kopieren."}},"es":{"stringUnit":{"state":"translated","value":"Diagrama no disponible. Comprueba la sintaxis o simplifica el diagrama. Aún puedes leer o copiar su código fuente."}},"ja-JP":{"stringUnit":{"state":"translated","value":"図を表示できません。 構文を確認するか、図を簡略化してください。 ソースの表示やコピーは引き続き可能です。"}},"ko":{"stringUnit":{"state":"translated","value":"다이어그램을 사용할 수 없습니다. 구문을 확인하거나 다이어그램을 단순화하세요. 소스는 계속 읽거나 복사할 수 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Diagramme indisponible. Vérifiez la syntaxe ou simplifiez le diagramme. Vous pouvez toujours lire ou copier son code source."}},"hi":{"stringUnit":{"state":"translated","value":"आरेख उपलब्ध नहीं है. सिंटैक्स जाँचें या आरेख को सरल बनाएँ. आप अब भी इसका स्रोत पढ़ या कॉपी कर सकते हैं."}},"ar":{"stringUnit":{"state":"translated","value":"المخطط غير متاح. تحقق من بناء الجملة أو بسّط المخطط. لا يزال بإمكانك قراءة مصدره أو نسخه."}},"it":{"stringUnit":{"state":"translated","value":"Diagramma non disponibile. Controlla la sintassi o semplifica il diagramma. Puoi comunque leggere o copiare il codice sorgente."}},"tr":{"stringUnit":{"state":"translated","value":"Diyagram kullanılamıyor. Sözdizimini kontrol edin veya diyagramı basitleştirin. Kaynak kodunu yine de okuyabilir veya kopyalayabilirsiniz."}},"uk":{"stringUnit":{"state":"translated","value":"Діаграма недоступна. Перевірте синтаксис або спростіть діаграму. Ви все ще можете переглянути або скопіювати її вихідний код."}},"id":{"stringUnit":{"state":"translated","value":"Diagram tidak tersedia. Periksa sintaks atau sederhanakan diagram. Anda tetap dapat membaca atau menyalin sumbernya."}},"pl":{"stringUnit":{"state":"translated","value":"Diagram jest niedostępny. Sprawdź składnię lub uprość diagram. Nadal możesz przeczytać lub skopiować jego kod źródłowy."}},"th":{"stringUnit":{"state":"translated","value":"แผนภาพไม่พร้อมใช้งาน. ตรวจสอบไวยากรณ์หรือปรับแผนภาพให้เรียบง่ายขึ้น. คุณยังสามารถอ่านหรือคัดลอกซอร์สของแผนภาพได้."}},"vi":{"stringUnit":{"state":"translated","value":"Sơ đồ không khả dụng. Kiểm tra cú pháp hoặc đơn giản hóa sơ đồ. Bạn vẫn có thể đọc hoặc sao chép mã nguồn của sơ đồ."}},"nl":{"stringUnit":{"state":"translated","value":"Diagram niet beschikbaar. Controleer de syntaxis of vereenvoudig het diagram. Je kunt de broncode nog steeds lezen of kopiëren."}},"fa":{"stringUnit":{"state":"translated","value":"نمودار در دسترس نیست. نحو را بررسی کنید یا نمودار را ساده‌تر کنید. همچنان می‌توانید کد منبع آن را بخوانید یا کپی کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Диаграмма недоступна. Проверьте синтаксис или упростите диаграмму. Вы по-прежнему можете просмотреть или скопировать её исходный код."}},"sv":{"stringUnit":{"state":"translated","value":"Diagrammet är inte tillgängligt. Kontrollera syntaxen eller förenkla diagrammet. Du kan fortfarande läsa eller kopiera dess källkod."}}}},
    "Dictate message": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Dictate message"}},"zh-CN":{"stringUnit":{"state":"translated","value":"口述消息"}},"zh-TW":{"stringUnit":{"state":"translated","value":"口述訊息"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ditar mensagem"}},"de":{"stringUnit":{"state":"translated","value":"Nachricht diktieren"}},"es":{"stringUnit":{"state":"translated","value":"Dictar mensaje"}},"ja-JP":{"stringUnit":{"state":"translated","value":"メッセージを音声入力"}},"ko":{"stringUnit":{"state":"translated","value":"메시지 받아쓰기"}},"fr":{"stringUnit":{"state":"translated","value":"Dicter un message"}},"hi":{"stringUnit":{"state":"translated","value":"बोलकर संदेश लिखें"}},"ar":{"stringUnit":{"state":"translated","value":"إملاء رسالة"}},"it":{"stringUnit":{"state":"translated","value":"Detta messaggio"}},"tr":{"stringUnit":{"state":"translated","value":"Mesajı dikte et"}},"uk":{"stringUnit":{"state":"translated","value":"Продиктувати повідомлення"}},"id":{"stringUnit":{"state":"translated","value":"Diktekan pesan"}},"pl":{"stringUnit":{"state":"translated","value":"Dyktuj wiadomość"}},"th":{"stringUnit":{"state":"translated","value":"ป้อนข้อความด้วยเสียง"}},"vi":{"stringUnit":{"state":"translated","value":"Nhập tin nhắn bằng giọng nói"}},"nl":{"stringUnit":{"state":"translated","value":"Bericht dicteren"}},"fa":{"stringUnit":{"state":"translated","value":"نوشتن پیام با گفتار"}},"ru":{"stringUnit":{"state":"translated","value":"Продиктовать сообщение"}},"sv":{"stringUnit":{"state":"translated","value":"Diktera meddelande"}}}},
    "Dictation stopped because speech recognition failed.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Dictation stopped because speech recognition failed."}},"zh-CN":{"stringUnit":{"state":"translated","value":"由于语音识别失败, 听写已停止。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語音辨識失敗, 口述輸入已停止。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O ditado foi interrompido porque o reconhecimento de fala falhou."}},"de":{"stringUnit":{"state":"translated","value":"Das Diktat wurde beendet, weil die Spracherkennung fehlgeschlagen ist."}},"es":{"stringUnit":{"state":"translated","value":"El dictado se detuvo porque falló el reconocimiento de voz."}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声認識に失敗したため、音声入力を停止しました。"}},"ko":{"stringUnit":{"state":"translated","value":"음성 인식에 실패하여 받아쓰기가 중지되었습니다."}},"fr":{"stringUnit":{"state":"translated","value":"La dictée s’est arrêtée car la reconnaissance vocale a échoué."}},"hi":{"stringUnit":{"state":"translated","value":"वाक् पहचान विफल होने के कारण बोलकर लिखना बंद हो गया."}},"ar":{"stringUnit":{"state":"translated","value":"توقف الإملاء بسبب فشل التعرف على الكلام."}},"it":{"stringUnit":{"state":"translated","value":"Dettatura interrotta a causa di un errore nel riconoscimento vocale."}},"tr":{"stringUnit":{"state":"translated","value":"Konuşma tanıma başarısız olduğu için dikte durduruldu."}},"uk":{"stringUnit":{"state":"translated","value":"Диктування зупинено через помилку розпізнавання мовлення."}},"id":{"stringUnit":{"state":"translated","value":"Dikte dihentikan karena pengenalan ucapan gagal."}},"pl":{"stringUnit":{"state":"translated","value":"Dyktowanie zostało zatrzymane z powodu błędu rozpoznawania mowy."}},"th":{"stringUnit":{"state":"translated","value":"การป้อนข้อความด้วยเสียงหยุดลงเนื่องจากการรู้จำเสียงล้มเหลว."}},"vi":{"stringUnit":{"state":"translated","value":"Đã dừng nhập bằng giọng nói do nhận dạng giọng nói thất bại."}},"nl":{"stringUnit":{"state":"translated","valu