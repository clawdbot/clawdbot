    "Select a channel to view status and settings.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Select a channel to view status and settings."}},"zh-CN":{"stringUnit":{"state":"translated","value":"选择一个频道以查看状态和设置。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"選取頻道以檢視狀態與設定。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Selecione um canal para ver o status e as configurações."}},"de":{"stringUnit":{"state":"translated","value":"Wählen Sie einen Kanal aus, um Status und Einstellungen anzuzeigen."}},"es":{"stringUnit":{"state":"translated","value":"Selecciona un canal para ver el estado y la configuración."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ステータスと設定を表示するチャンネルを選択してください。"}},"ko":{"stringUnit":{"state":"translated","value":"상태와 설정을 보려면 채널을 선택하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Sélectionnez un canal pour afficher l’état et les paramètres."}},"hi":{"stringUnit":{"state":"translated","value":"स्थिति और सेटिंग्स देखने के लिए कोई चैनल चुनें।"}},"ar":{"stringUnit":{"state":"translated","value":"حدد قناة لعرض الحالة والإعدادات."}},"it":{"stringUnit":{"state":"translated","value":"Seleziona un canale per visualizzare stato e impostazioni."}},"tr":{"stringUnit":{"state":"translated","value":"Durumu ve ayarları görüntülemek için bir kanal seçin."}},"uk":{"stringUnit":{"state":"translated","value":"Виберіть канал, щоб переглянути статус і налаштування."}},"id":{"stringUnit":{"state":"translated","value":"Pilih saluran untuk melihat status dan pengaturan."}},"pl":{"stringUnit":{"state":"translated","value":"Wybierz kanał, aby wyświetlić status i ustawienia."}},"th":{"stringUnit":{"state":"translated","value":"เลือกช่องทางเพื่อดูสถานะและการตั้งค่า"}},"vi":{"stringUnit":{"state":"translated","value":"Chọn một kênh để xem trạng thái và cài đặt."}},"nl":{"stringUnit":{"state":"translated","value":"Selecteer een kanaal om de status en instellingen te bekijken."}},"fa":{"stringUnit":{"state":"translated","value":"یک کانال را برای مشاهدهٔ وضعیت و تنظیمات انتخاب کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Выберите канал, чтобы просмотреть статус и настройки."}},"sv":{"stringUnit":{"state":"translated","value":"Välj en kanal för att visa status och inställningar."}}}},
    "Select a config section to view settings.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Select a config section to view settings."}},"zh-CN":{"stringUnit":{"state":"translated","value":"选择一个配置部分以查看设置。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"選取 config 區段以檢視設定。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Selecione uma seção de configuração para ver as opções."}},"de":{"stringUnit":{"state":"translated","value":"Wählen Sie einen Konfigurationsabschnitt aus, um die Einstellungen anzuzeigen."}},"es":{"stringUnit":{"state":"translated","value":"Selecciona una sección de configuración para ver los ajustes."}},"ja-JP":{"stringUnit":{"state":"translated","value":"設定を表示する設定セクションを選択してください。"}},"ko":{"stringUnit":{"state":"translated","value":"설정을 보려면 구성 섹션을 선택하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Sélectionnez une section de configuration pour afficher les paramètres."}},"hi":{"stringUnit":{"state":"translated","value":"सेटिंग्स देखने के लिए कोई कॉन्फ़िग सेक्शन चुनें।"}},"ar":{"stringUnit":{"state":"translated","value":"حدد قسم تكوين لعرض الإعدادات."}},"it":{"stringUnit":{"state":"translated","value":"Seleziona una sezione di configurazione per visualizzare le impostazioni."}},"tr":{"stringUnit":{"state":"translated","value":"Ayarları görüntülemek için bir config bölümü seçin."}},"uk":{"stringUnit":{"state":"translated","value":"Виберіть розділ конфігурації, щоб переглянути налаштування."}},"id":{"stringUnit":{"state":"translated","value":"Pilih bagian config untuk melihat pengaturan."}},"pl":{"stringUnit":{"state":"translated","value":"Wybierz sekcję konfiguracji, aby wyświetlić ustawienia."}},"th":{"stringUnit":{"state":"translated","value":"เลือกส่วนการกำหนดค่าเพื่อดูการตั้งค่า"}},"vi":{"stringUnit":{"state":"translated","value":"Chọn một phần cấu hình để xem cài đặt."}},"nl":{"stringUnit":{"state":"translated","value":"Selecteer een configuratiesectie om de instellingen te bekijken."}},"fa":{"stringUnit":{"state":"translated","value":"یک بخش پیکربندی را برای مشاهدهٔ تنظیمات انتخاب کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Выберите раздел конфигурации, чтобы просмотреть настройки."}},"sv":{"stringUnit":{"state":"translated","value":"Välj ett konfigurationsavsnitt för att visa inställningar."}}}},
    "Select a job to inspect details and run history.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Select a job to inspect details and run history."}},"zh-CN":{"stringUnit":{"state":"translated","value":"选择一个任务以查看详细信息和运行历史记录。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"選取一個 job 以檢視詳細資料與執行歷程。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Selecione um trabalho para inspecionar detalhes e o histórico de execução."}},"de":{"stringUnit":{"state":"translated","value":"Wählen Sie einen Job aus, um Details und Ausführungsverlauf zu prüfen."}},"es":{"stringUnit":{"state":"translated","value":"Selecciona una tarea para inspeccionar sus detalles y el historial de ejecuciones."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ジョブを選択して詳細と実行履歴を確認します。"}},"ko":{"stringUnit":{"state":"translated","value":"작업을 선택하여 세부 정보와 실행 기록을 확인하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Sélectionnez une tâche pour consulter les détails et l’historique d’exécution."}},"hi":{"stringUnit":{"state":"translated","value":"विवरण और run history देखने के लिए कोई job चुनें।"}},"ar":{"stringUnit":{"state":"translated","value":"حدد مهمة لفحص التفاصيل وسجل التشغيل."}},"it":{"stringUnit":{"state":"translated","value":"Seleziona un job per consultare dettagli e cronologia delle esecuzioni."}},"tr":{"stringUnit":{"state":"translated","value":"Ayrıntıları ve çalışma geçmişini incelemek için bir iş seçin."}},"uk":{"stringUnit":{"state":"translated","value":"Виберіть завдання, щоб переглянути деталі та історію запусків."}},"id":{"stringUnit":{"state":"translated","value":"Pilih job untuk memeriksa detail dan riwayat eksekusi."}},"pl":{"stringUnit":{"state":"translated","value":"Wybierz zadanie, aby sprawdzić szczegóły i historię uruchomień."}},"th":{"stringUnit":{"state":"translated","value":"เลือกงานเพื่อตรวจสอบรายละเอียดและประวัติการทำงาน"}},"vi":{"stringUnit":{"state":"translated","value":"Chọn một tác vụ để kiểm tra chi tiết và lịch sử chạy."}},"nl":{"stringUnit":{"state":"translated","value":"Selecteer een taak om details en uitvoeringsgeschiedenis te bekijken."}},"fa":{"stringUnit":{"state":"translated","value":"یک کار را انتخاب کنید تا جزئیات و تاریخچه اجرای آن را بررسی کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Выберите задание, чтобы просмотреть подробности и историю запусков."}},"sv":{"stringUnit":{"state":"translated","value":"Välj ett jobb för att granska detaljer och körningshistorik."}}}},
    "Select an agent scope above to add trusted commands.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Select an agent scope above to add trusted commands."}},"zh-CN":{"stringUnit":{"state":"translated","value":"选择上方的代理范围以添加受信任命令。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"請在上方選擇代理程式範圍以新增受信任的命令。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Selecione um escopo de agente acima para adicionar comandos confiáveis."}},"de":{"stringUnit":{"state":"translated","value":"Wählen Sie oben einen Agentenbereich aus, um vertrauenswürdige Befehle hinzuzufügen."}},"es":{"stringUnit":{"state":"translated","value":"Selecciona un ámbito de agente arriba para agregar comandos de confianza."}},"ja-JP":{"stringUnit":{"state":"translated","value":"信頼済みコマンドを追加するには、上でエージェントスコープを選択してください。"}},"ko":{"stringUnit":{"state":"translated","value":"신뢰할 수 있는 명령을 추가하려면 위에서 agent 범위를 선택하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Sélectionnez ci-dessus une portée d’agent pour ajouter des commandes approuvées."}},"hi":{"stringUnit":{"state":"translated","value":"विश्वसनीय कमांड जोड़ने के लिए ऊपर एक एजेंट स्कोप चुनें।"}},"ar":{"stringUnit":{"state":"translated","value":"حدد نطاق وكيل أعلاه لإضافة أوامر موثوقة."}},"it":{"stringUnit":{"state":"translated","value":"Seleziona sopra un ambito agente per aggiungere comandi attendibili."}},"tr":{"stringUnit":{"state":"translated","value":"Güvenilen komutlar eklemek için yukarıdan bir aracı kapsamı seçin."}},"uk":{"stringUnit":{"state":"translated","value":"Виберіть область дії агента вище, щоб додати довірені команди."}},"id":{"stringUnit":{"state":"translated","value":"Pilih cakupan agen di atas untuk menambahkan perintah tepercaya."}},"pl":{"stringUnit":{"state":"translated","value":"Wybierz powyżej zakres agenta, aby dodać zaufane polecenia."}},"th":{"stringUnit":{"state":"translated","value":"เลือกขอบเขตเอเจนต์ด้านบนเพื่อเพิ่มคำสั่งที่เชื่อถือ"}},"vi":{"stringUnit":{"state":"translated","value":"Chọn phạm vi tác tử ở trên để thêm lệnh đáng tin cậy."}},"nl":{"stringUnit":{"state":"translated","value":"Selecteer hierboven een agentbereik om vertrouwde commando's toe te voegen."}},"fa":{"stringUnit":{"state":"translated","value":"برای افزودن فرمان‌های مورد اعتماد، یک محدوده عامل را در بالا انتخاب کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Выберите область действия агента выше, чтобы добавить доверенные команды."}},"sv":{"stringUnit":{"state":"translated","value":"Välj en agentomfattning ovan för att lägga till betrodda kommandon."}}}},
