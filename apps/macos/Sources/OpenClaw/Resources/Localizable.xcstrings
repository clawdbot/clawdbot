    "Add Group": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Add Group"}},"zh-CN":{"stringUnit":{"state":"translated","value":"添加群组"}},"zh-TW":{"stringUnit":{"state":"translated","value":"加入群組"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Adicionar grupo"}},"de":{"stringUnit":{"state":"translated","value":"Gruppe hinzufügen"}},"es":{"stringUnit":{"state":"translated","value":"Añadir grupo"}},"ja-JP":{"stringUnit":{"state":"translated","value":"グループを追加"}},"ko":{"stringUnit":{"state":"translated","value":"그룹 추가"}},"fr":{"stringUnit":{"state":"translated","value":"Ajouter un groupe"}},"hi":{"stringUnit":{"state":"translated","value":"समूह जोड़ें"}},"ar":{"stringUnit":{"state":"translated","value":"إضافة مجموعة"}},"it":{"stringUnit":{"state":"translated","value":"Aggiungi gruppo"}},"tr":{"stringUnit":{"state":"translated","value":"Grup Ekle"}},"uk":{"stringUnit":{"state":"translated","value":"Додати групу"}},"id":{"stringUnit":{"state":"translated","value":"Tambahkan Grup"}},"pl":{"stringUnit":{"state":"translated","value":"Dodaj grupę"}},"th":{"stringUnit":{"state":"translated","value":"เพิ่มกลุ่ม"}},"vi":{"stringUnit":{"state":"translated","value":"Thêm nhóm"}},"nl":{"stringUnit":{"state":"translated","value":"Groep toevoegen"}},"fa":{"stringUnit":{"state":"translated","value":"افزودن گروه"}},"ru":{"stringUnit":{"state":"translated","value":"Добавить группу"}},"sv":{"stringUnit":{"state":"translated","value":"Lägg till grupp"}}}},
    "Add a Gateway here, then use File → New Gateway Window… (⌘N) whenever you want another window for it.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Add a Gateway here, then use File → New Gateway Window… (⌘N) whenever you want another window for it."}},"zh-CN":{"stringUnit":{"state":"translated","value":"在此添加 Gateway，之后需要为其打开另一个窗口时，可使用“文件”→“新建 Gateway 窗口…”（⌘N）。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"在此新增 Gateway，之後需要為其開啟另一個視窗時，請使用「檔案」→「新增 Gateway 視窗…」(⌘N)。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Adicione um Gateway aqui e use Arquivo → Nova Janela do Gateway… (⌘N) sempre que quiser abrir outra janela para ele."}},"de":{"stringUnit":{"state":"translated","value":"Fügen Sie hier ein Gateway hinzu und verwenden Sie dann Datei → Neues Gateway-Fenster… (⌘N), wenn Sie ein weiteres Fenster dafür öffnen möchten."}},"es":{"stringUnit":{"state":"translated","value":"Añade aquí un Gateway y luego usa Archivo → Nueva ventana de Gateway… (⌘N) cuando quieras abrir otra ventana para él."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ここでGatewayを追加すると、別のウインドウが必要なときに「ファイル」→「新規Gatewayウインドウ…」（⌘N）を使用できます。"}},"ko":{"stringUnit":{"state":"translated","value":"여기에 Gateway를 추가한 다음, 해당 Gateway용 창을 하나 더 열고 싶을 때마다 파일 → 새로운 Gateway 창… (⌘N)을 사용하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Ajoutez un Gateway ici, puis utilisez Fichier → Nouvelle fenêtre Gateway… (⌘N) chaque fois que vous souhaitez ouvrir une autre fenêtre pour celui-ci."}},"hi":{"stringUnit":{"state":"translated","value":"यहाँ एक Gateway जोड़ें, फिर जब भी आप इसके लिए दूसरी विंडो चाहें, File → New Gateway Window… (⌘N) का उपयोग करें।"}},"ar":{"stringUnit":{"state":"translated","value":"أضف Gateway هنا، ثم استخدم ملف → نافذة Gateway جديدة… (⌘N) متى أردت فتح نافذة أخرى له."}},"it":{"stringUnit":{"state":"translated","value":"Aggiungi qui un Gateway, quindi usa File → Nuova finestra Gateway… (⌘N) ogni volta che vuoi aprire un'altra finestra per quel Gateway."}},"tr":{"stringUnit":{"state":"translated","value":"Buraya bir Gateway ekleyin, ardından bunun için başka bir pencere açmak istediğinizde Dosya → Yeni Gateway Penceresi… (⌘N) seçeneğini kullanın."}},"uk":{"stringUnit":{"state":"translated","value":"Додайте Gateway тут, а потім виберіть «Файл» → «Нове вікно Gateway…» (⌘N), коли забажаєте відкрити для нього ще одне вікно."}},"id":{"stringUnit":{"state":"translated","value":"Tambahkan Gateway di sini, lalu gunakan File → Jendela Gateway Baru… (⌘N) kapan pun Anda menginginkan jendela lain untuknya."}},"pl":{"stringUnit":{"state":"translated","value":"Dodaj tutaj Gateway, a następnie użyj opcji Plik → Nowe okno Gateway… (⌘N), gdy zechcesz otworzyć dla niego kolejne okno."}},"th":{"stringUnit":{"state":"translated","value":"เพิ่ม Gateway ที่นี่ จากนั้นใช้ ไฟล์ → หน้าต่าง Gateway ใหม่… (⌘N) เมื่อต้องการเปิดอีกหน้าต่างสำหรับ Gateway นั้น"}},"vi":{"stringUnit":{"state":"translated","value":"Thêm Gateway tại đây, sau đó dùng Tệp → Cửa sổ Gateway mới… (⌘N) bất cứ khi nào bạn muốn mở thêm một cửa sổ cho Gateway đó."}},"nl":{"stringUnit":{"state":"translated","value":"Voeg hier een Gateway toe en gebruik vervolgens Bestand → Nieuw Gateway-venster… (⌘N) wanneer u er een extra venster voor wilt openen."}},"fa":{"stringUnit":{"state":"translated","value":"یک Gateway در اینجا اضافه کنید، سپس هر زمان که پنجره دیگری برای آن خواستید، از File → New Gateway Window… (⌘N) استفاده کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Добавьте здесь Gateway, а затем используйте «Файл» → «Новое окно Gateway…» (⌘N), когда потребуется открыть для него ещё одно окно."}},"sv":{"stringUnit":{"state":"translated","value":"Lägg till en Gateway här och använd sedan Arkiv → Nytt Gateway-fönster… (⌘N) när du vill öppna ett nytt fönster för den."}}}},
