    "Approve Device": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Approve Device"}},"zh-CN":{"stringUnit":{"state":"translated","value":"批准设备"}},"zh-TW":{"stringUnit":{"state":"translated","value":"核准裝置"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Aprovar Dispositivo"}},"de":{"stringUnit":{"state":"translated","value":"Gerät genehmigen"}},"es":{"stringUnit":{"state":"translated","value":"Aprobar dispositivo"}},"ja-JP":{"stringUnit":{"state":"translated","value":"デバイスを承認"}},"ko":{"stringUnit":{"state":"translated","value":"기기 승인"}},"fr":{"stringUnit":{"state":"translated","value":"Approuver l’appareil"}},"hi":{"stringUnit":{"state":"translated","value":"डिवाइस को अनुमोदित करें"}},"ar":{"stringUnit":{"state":"translated","value":"الموافقة على الجهاز"}},"it":{"stringUnit":{"state":"translated","value":"Approva dispositivo"}},"tr":{"stringUnit":{"state":"translated","value":"Cihazı Onayla"}},"uk":{"stringUnit":{"state":"translated","value":"Схвалити пристрій"}},"id":{"stringUnit":{"state":"translated","value":"Setujui Perangkat"}},"pl":{"stringUnit":{"state":"translated","value":"Zatwierdź urządzenie"}},"th":{"stringUnit":{"state":"translated","value":"อนุมัติอุปกรณ์"}},"vi":{"stringUnit":{"state":"translated","value":"Phê duyệt thiết bị"}},"nl":{"stringUnit":{"state":"translated","value":"Apparaat goedkeuren"}},"fa":{"stringUnit":{"state":"translated","value":"تأیید دستگاه"}},"ru":{"stringUnit":{"state":"translated","value":"Одобрить устройство"}},"sv":{"stringUnit":{"state":"translated","value":"Godkänn enhet"}}}},
    "Approve Node": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Approve Node"}},"zh-CN":{"stringUnit":{"state":"translated","value":"批准节点"}},"zh-TW":{"stringUnit":{"state":"translated","value":"核准節點"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Aprovar nó"}},"de":{"stringUnit":{"state":"translated","value":"Knoten genehmigen"}},"es":{"stringUnit":{"state":"translated","value":"Aprobar nodo"}},"ja-JP":{"stringUnit":{"state":"translated","value":"ノードを承認"}},"ko":{"stringUnit":{"state":"translated","value":"노드 승인"}},"fr":{"stringUnit":{"state":"translated","value":"Approuver le nœud"}},"hi":{"stringUnit":{"state":"translated","value":"नोड को मंज़ूरी दें"}},"ar":{"stringUnit":{"state":"translated","value":"الموافقة على العقدة"}},"it":{"stringUnit":{"state":"translated","value":"Approva nodo"}},"tr":{"stringUnit":{"state":"translated","value":"Düğümü Onayla"}},"uk":{"stringUnit":{"state":"translated","value":"Схвалити вузол"}},"id":{"stringUnit":{"state":"translated","value":"Setujui Node"}},"pl":{"stringUnit":{"state":"translated","value":"Zatwierdź węzeł"}},"th":{"stringUnit":{"state":"translated","value":"อนุมัติโหนด"}},"vi":{"stringUnit":{"state":"translated","value":"Phê duyệt nút"}},"nl":{"stringUnit":{"state":"translated","value":"Node goedkeuren"}},"fa":{"stringUnit":{"state":"translated","value":"تأیید گره"}},"ru":{"stringUnit":{"state":"translated","value":"Одобрить узел"}},"sv":{"stringUnit":{"state":"translated","value":"Godkänn nod"}}}},
    "Approve this device from an already-paired OpenClaw client. In your OpenClaw chat, run `/pair approve`, then click **Check connection** again.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Approve this device from an already-paired OpenClaw client. In your OpenClaw chat, run `/pair approve`, then click **Check connection** again."}},"zh-CN":{"stringUnit":{"state":"translated","value":"从已配对的 OpenClaw 客户端批准此设备。在 OpenClaw 聊天中运行 `/pair approve`，然后再次点击**检查连接**。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"從已配對的 OpenClaw 用戶端核准此裝置。在您的 OpenClaw 聊天中執行 `/pair approve`，然後再次點擊**檢查連線**。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Aprove este dispositivo em um cliente OpenClaw já pareado. No seu chat do OpenClaw, execute `/pair approve` e clique em **Verificar conexão** novamente."}},"de":{"stringUnit":{"state":"translated","value":"Genehmigen Sie dieses Gerät über einen bereits gekoppelten OpenClaw-Client. Führen Sie in Ihrem OpenClaw-Chat `/pair approve` aus und klicken Sie dann erneut auf **Verbindung prüfen**."}},"es":{"stringUnit":{"state":"translated","value":"Aprueba este dispositivo desde un cliente de OpenClaw ya vinculado. En tu chat de OpenClaw, ejecuta `/pair approve` y vuelve a hacer clic en **Comprobar conexión**."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ペアリング済みのOpenClawクライアントからこのデバイスを承認してください. OpenClawのチャットで`/pair approve`を実行し、もう一度**接続を確認**をクリックしてください."}},"ko":{"stringUnit":{"state":"translated","value":"이미 페어링된 OpenClaw 클라이언트에서 이 기기를 승인하세요. OpenClaw 채팅에서 `/pair approve`를 실행한 다음 **연결 확인**을 다시 클릭하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Approuvez cet appareil depuis un client OpenClaw déjà appairé. Dans votre conversation OpenClaw, exécutez `/pair approve`, puis cliquez à nouveau sur **Vérifier la connexion**."}},"hi":{"stringUnit":{"state":"translated","value":"पहले से पेयर किए गए OpenClaw क्लाइंट से इस डिवाइस को मंज़ूरी दें। अपनी OpenClaw चैट में `/pair approve` चलाएँ, फिर **कनेक्शन जाँचें** पर दोबारा क्लिक करें।"}},"ar":{"stringUnit":{"state":"translated","value":"وافق على هذا الجهاز من عميل OpenClaw مقترن بالفعل. في محادثتك مع OpenClaw، شغّل `/pair approve`، ثم انقر على **التحقق من الاتصال** مرة أخرى."}},"it":{"stringUnit":{"state":"translated","value":"Approva questo dispositivo da un client OpenClaw già abbinato. Nella tua chat OpenClaw, esegui `/pair approve`, quindi fai di nuovo clic su **Verifica connessione**."}},"tr":{"stringUnit":{"state":"translated","value":"Bu cihazı önceden eşleştirilmiş bir OpenClaw istemcisinden onaylayın. OpenClaw sohbetinizde `/pair approve` komutunu çalıştırın, ardından **Bağlantıyı kontrol et** seçeneğine tekrar tıklayın."}},"uk":{"stringUnit":{"state":"translated","value":"Схваліть цей пристрій із уже спареного клієнта OpenClaw. У чаті OpenClaw виконайте `/pair approve`, а потім знову натисніть **Перевірити з’єднання**."}},"id":{"stringUnit":{"state":"translated","value":"Setujui perangkat ini dari klien OpenClaw yang sudah dipasangkan. Di obrolan OpenClaw Anda, jalankan `/pair approve`, lalu klik **Periksa koneksi** lagi."}},"pl":{"stringUnit":{"state":"translated","value":"Zatwierdź to urządzenie w już sparowanym kliencie OpenClaw. Na czacie OpenClaw uruchom `/pair approve`, a następnie ponownie kliknij **Sprawdź połączenie**."}},"th":{"stringUnit":{"state":"translated","value":"อนุมัติอุปกรณ์นี้จากไคลเอนต์ OpenClaw ที่จับคู่ไว้แล้ว. ในแชท OpenClaw ของคุณ ให้เรียกใช้ `/pair approve` จากนั้นคลิก **ตรวจสอบการเชื่อมต่อ** อีกครั้ง."}},"vi":{"stringUnit":{"state":"translated","value":"Phê duyệt thiết bị này từ một ứng dụng OpenClaw đã được ghép đôi. Trong cuộc trò chuyện OpenClaw, chạy `/pair approve`, rồi nhấp lại vào **Kiểm tra kết nối**."}},"nl":{"stringUnit":{"state":"translated","value":"Keur dit apparaat goed vanuit een al gekoppelde OpenClaw-client. Voer in je OpenClaw-chat `/pair approve` uit en klik daarna opnieuw op **Verbinding controleren**."}},"fa":{"stringUnit":{"state":"translated","value":"این دستگاه را از طریق یک کلاینت OpenClaw که از قبل جفت شده است تأیید کنید. در گفتگوی OpenClaw خود، `/pair approve` را اجرا کنید، سپس دوباره روی **بررسی اتصال** کلیک کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Одобрите это устройство из уже сопряжённого клиента OpenClaw. В чате OpenClaw выполните `/pair approve`, затем снова нажмите **Проверить подключение**."}},"sv":{"stringUnit":{"state":"translated","value":"Godkänn den här enheten från en redan parkopplad OpenClaw-klient. Kör `/pair approve` i din OpenClaw-chatt och klicka sedan på **Kontrollera anslutningen** igen."}}}},
    "Approve this request": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Approve this request"}},"zh-CN":{"stringUnit":{"state":"translated","value":"批准此次请求"}},"zh-TW":{"stringUnit":{"state":"translated","value":"核准此請求"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Aprovar esta solicitação"}},"de":{"stringUnit":{"state":"translated","value":"Diese Anfrage genehmigen"}},"es":{"stringUnit":{"state":"translated","value":"Aprobar esta solicitud"}},"ja-JP":{"stringUnit":{"state":"translated","value":"このリクエストを承認"}},"ko":{"stringUnit":{"state":"translated","value":"이 요청 승인"}},"fr":{"stringUnit":{"state":"translated","value":"Approuver cette requête"}},"hi":{"stringUnit":{"state":"translated","value":"इस अनुरोध को स्वीकृति दें"}},"ar":{"stringUnit":{"state":"translated","value":"الموافقة على هذا الطلب"}},"it":{"stringUnit":{"state":"translated","value":"Approva questa richiesta"}},"tr":{"stringUnit":{"state":"translated","value":"Bu isteği onayla"}},"uk":{"stringUnit":{"state":"translated","value":"Схвалити цей запит"}},"id":{"stringUnit":{"state":"translated","value":"Setujui permintaan ini"}},"pl":{"stringUnit":{"state":"translated","value":"Zatwierdź to żądanie"}},"th":{"stringUnit":{"state":"translated","value":"อนุมัติคำขอนี้"}},"vi":{"stringUnit":{"state":"translated","value":"Phê duyệt yêu cầu này"}},"nl":{"stringUnit":{"state":"translated","value":"Dit verzoek goedkeuren"}},"fa":{"stringUnit":{"state":"translated","value":"تأیید این درخواست"}},"ru":{"stringUnit":{"state":"translated","value":"Одобрить этот запрос"}},"sv":{"stringUnit":{"state":"translated","value":"Godkänn denna begäran"}}}},
    "Approve this request (⌘Return)": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Approve this request (⌘Return)"}},"zh-CN":{"stringUnit":{"state":"translated","value":"批准此次请求（⌘Return）"}},"zh-TW":{"stringUnit":{"state":"translated","value":"核准此請求（⌘Return）"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Aprovar esta solicitação (⌘Return)"}},"de":{"stringUnit":{"state":"translated","value":"Diese Anfrage genehmigen (⌘Return)"}},"es":{"stringUnit":{"state":"translated","value":"Aprobar esta solicitud (⌘Return)"}},"ja-JP":{"stringUnit":{"state":"translated","value":"このリクエストを承認（⌘Return）"}},"ko":{"stringUnit":{"state":"translated","value":"이 요청 승인 (⌘Return)"}},"fr":{"stringUnit":{"state":"translated","value":"Approuver cette requête (⌘Retour)"}},"hi":{"stringUnit":{"state":"translated","value":"इस अनुरोध को स्वीकृति दें (⌘Return)"}},"ar":{"stringUnit":{"state":"translated","value":"الموافقة على هذا الطلب (⌘Return)"}},"it":{"stringUnit":{"state":"translated","value":"Approva questa richiesta (⌘Invio)"}},"tr":{"stringUnit":{"state":"translated","value":"Bu isteği onayla (⌘Return)"}},"uk":{"stringUnit":{"state":"translated","value":"Схвалити цей запит (⌘Return)"}},"id":{"stringUnit":{"state":"translated","value":"Setujui permintaan ini (⌘Return)"}},"pl":{"stringUnit":{"state":"translated","value":"Zatwierdź to żądanie (⌘Return)"}},"th":{"stringUnit":{"state":"translated","value":"อนุมัติคำขอนี้ (⌘Return)"}},"vi":{"stringUnit":{"state":"translated","value":"Phê duyệt yêu cầu này (⌘Return)"}},"nl":{"stringUnit":{"state":"translated","value":"Dit verzoek goedkeuren (⌘Return)"}},"fa":{"stringUnit":{"state":"translated","value":"تأیید این درخواست (⌘Return)"}},"ru":{"stringUnit":{"state":"translated","value":"Одобрить этот запрос (⌘Return)"}},"sv":{"stringUnit":{"state":"translated","value":"Godkänn denna begäran (⌘Return)"}}}},
    "Approving this repair replaces the device’s access token.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Approving this repair replaces the device’s access token."}},"zh-CN":{"stringUnit":{"state":"translated","value":"批准此次修复将替换设备的访问令牌。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"核准此次修復將取代裝置的存取權杖。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Aprovar este reparo substitui o token de acesso do dispositivo."}},"de":{"stringUnit":{"state":"translated","value":"Die Genehmigung dieser Reparatur ersetzt das Zugriffstoken des Geräts."}},"es":{"stringUnit":{"state":"translated","value":"Aprobar esta reparación reemplaza el token de acceso del dispositivo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"この修復を承認すると、デバイスのアクセストークンが置き換えられます。"}},"ko":{"stringUnit":{"state":"translated","value":"이 복구를 승인하면 기기의 액세스 토큰이 교체됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’approbation de cette réparation remplace le jeton d’accès de l’appareil."}},"hi":{"stringUnit":{"state":"translated","value":"इस सुधार को स्वीकृति देने से डिवाइस का एक्सेस टोकन बदल जाएगा।"}},"ar":{"stringUnit":{"state":"translated","value":"تؤدي الموافقة على هذا الإصلاح إلى استبدال رمز الوصول الخاص بالجهاز."}},"it":{"stringUnit":{"state":"translated","value":"L’approvazione di questa riparazione sostituisce il token di accesso del dispositivo."}},"tr":{"stringUnit":{"state":"translated","value":"Bu onarımı onaylamak, cihazın erişim belirtecini değiştirir."}},"uk":{"stringUnit":{"state":"translated","value":"Схвалення цього відновлення замінить токен доступу пристрою."}},"id":{"stringUnit":{"state":"translated","value":"Menyetujui perbaikan ini akan mengganti token akses perangkat."}},"pl":{"stringUnit":{"state":"translated","value":"Zatwierdzenie tej naprawy zastępuje token dostępu urządzenia."}},"th":{"stringUnit":{"state":"translated","value":"การอนุมัติการซ่อมแซมนี้จะเปลี่ยนโทเค็นการเข้าถึงของอุปกรณ์"}},"vi":{"stringUnit":{"state":"translated","v