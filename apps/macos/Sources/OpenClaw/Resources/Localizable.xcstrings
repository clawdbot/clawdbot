    "Connecting… Complete sign-in in your browser if it opens.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connecting… Complete sign-in in your browser if it opens."}},"zh-CN":{"stringUnit":{"state":"translated","value":"正在连接… 如果浏览器打开，请在其中完成登录。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"正在連線… 若瀏覽器開啟，請在其中完成登入。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Conectando… Conclua o login no navegador se ele abrir."}},"de":{"stringUnit":{"state":"translated","value":"Verbindung wird hergestellt… Schließe die Anmeldung in deinem Browser ab, falls er sich öffnet."}},"es":{"stringUnit":{"state":"translated","value":"Conectando… Completa el inicio de sesión en el navegador si se abre."}},"ja-JP":{"stringUnit":{"state":"translated","value":"接続中… ブラウザが開いた場合は、サインインを完了してください。"}},"ko":{"stringUnit":{"state":"translated","value":"연결 중… 브라우저가 열리면 로그인을 완료하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Connexion… Terminez l’authentification dans votre navigateur s’il s’ouvre."}},"hi":{"stringUnit":{"state":"translated","value":"कनेक्ट हो रहा है… अगर आपका ब्राउज़र खुलता है, तो उसमें साइन-इन पूरा करें।"}},"ar":{"stringUnit":{"state":"translated","value":"جارٍ الاتصال… أكمل تسجيل الدخول في المتصفح إذا فُتح."}},"it":{"stringUnit":{"state":"translated","value":"Connessione… Completa l'accesso nel browser se si apre."}},"tr":{"stringUnit":{"state":"translated","value":"Bağlanılıyor… Tarayıcınız açılırsa oturum açma işlemini orada tamamlayın."}},"uk":{"stringUnit":{"state":"translated","value":"Підключення… Завершіть вхід у браузері, якщо він відкриється."}},"id":{"stringUnit":{"state":"translated","value":"Menghubungkan… Selesaikan proses masuk di browser jika terbuka."}},"pl":{"stringUnit":{"state":"translated","value":"Łączenie… Dokończ logowanie w przeglądarce, jeśli się otworzy."}},"th":{"stringUnit":{"state":"translated","value":"กำลังเชื่อมต่อ… หากเบราว์เซอร์เปิดขึ้น ให้ลงชื่อเข้าใช้ให้เสร็จสิ้น"}},"vi":{"stringUnit":{"state":"