    "Manage installed capabilities or discover verified releases on ClawHub.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Manage installed capabilities or discover verified releases on ClawHub."}},"zh-CN":{"stringUnit":{"state":"translated","value":"管理已安装的功能，或在 ClawHub 上发现经过验证的发布版本。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"管理已安裝的功能，或在 ClawHub 上探索已驗證的版本。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Gerencie os recursos instalados ou descubra versões verificadas no ClawHub."}},"de":{"stringUnit":{"state":"translated","value":"Installierte Funktionen verwalten oder verifizierte Versionen auf ClawHub entdecken."}},"es":{"stringUnit":{"state":"translated","value":"Gestiona las capacidades instaladas o descubre versiones verificadas en ClawHub."}},"ja-JP":{"stringUnit":{"state":"translated","value":"インストール済みの機能を管理するか、ClawHubで検証済みのリリースを探します。"}},"ko":{"stringUnit":{"state":"translated","value":"설치된 기능을 관리하거나 ClawHub에서 검증된 릴리스를 찾아보세요."}},"fr":{"stringUnit":{"state":"translated","value":"Gérez les fonctionnalités installées ou découvrez des versions vérifiées sur ClawHub."}},"hi":{"stringUnit":{"state":"translated","value":"इंस्टॉल की गई क्षमताएँ प्रबंधित करें या ClawHub पर सत्यापित रिलीज़ खोजें."}},"ar":{"stringUnit":{"state":"translated","value":"إدارة الإمكانات المثبّتة أو اكتشاف الإصدارات التي تم التحقق منها على ClawHub."}},"it":{"stringUnit":{"state":"translated","value":"Gestisci le funzionalità installate o scopri le versioni verificate su ClawHub."}},"tr":{"stringUnit":{"state":"translated","value":"Yüklü yetenekleri yönetin veya ClawHub'da doğrulanmış sürümleri keşfedin."}},"uk":{"stringUnit":{"state":"translated","value":"Керуйте встановленими можливостями або знаходьте перевірені випуски на ClawHub."}},"id":{"stringUnit":{"state":"translated","value":"Kelola kemampuan yang terinstal atau temukan rilis terverifikasi di ClawHub."}},"pl":{"stringUnit":{"state":"translated","value":"Zarządzaj zainstalowanymi funkcjami 