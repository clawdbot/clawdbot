    "macOS access for notifications, capture, voice, and device context.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"macOS access for notifications, capture, voice, and device context."}},"zh-CN":{"stringUnit":{"state":"translated","value":"用于通知、捕获、语音和设备上下文的 macOS 访问权限。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"用於通知、擷取、語音和裝置情境資訊的 macOS 存取權限。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Acesso ao macOS para notificações, captura, voz e contexto do dispositivo."}},"de":{"stringUnit":{"state":"translated","value":"macOS-Zugriff für Benachrichtigungen, Aufnahmen, Sprache und Gerätekontext."}},"es":{"stringUnit":{"state":"translated","value":"Acceso de macOS a notificaciones, captura, voz y contexto del dispositivo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"通知、キャプチャ、音声、デバイスコンテキストのためのmacOSアクセス権限。"}},"ko":{"stringUnit":{"state":"translated","value":"알림, 캡처, 음성 및 기기 컨텍스트를 위한 macOS 접근 권한."}},"fr":{"stringUnit":{"state":"translated","value":"Accès macOS aux notifications, à la capture, à la voix et au contexte de l’appareil."}},"hi":{"stringUnit":{"state":"translated","value":"सूचनाओं, कैप्चर, आवाज़ और डिवाइस संदर्भ के लिए macOS ऐक्सेस."}},"ar":{"stringUnit":{"state":"translated","value":"صلاحيات الوصول في macOS للإشعارات والالتقاط والصوت وسياق الجهاز."}},"it":{"stringUnit":{"state":"translated","value":"Accesso a macOS per notifiche, acquisizione, voce e contesto del dispositivo."}},"tr":{"stringUnit":{"state":"translated","value":"Bildirimler, yakalama, ses ve cihaz bağlamı için macOS erişimi."}},"uk":{"stringUnit":{"state":"translated","value":"Доступ у macOS до сповіщень, захоплення, голосу та контексту пристрою."}},"id":{"stringUnit":{"state":"translated","value":"Akses macOS untuk notifikasi, perekaman, suara, dan konteks perangkat."}},"pl":{"stringUnit":{"state":"translated","value":"Dostęp w macOS do powiadomień, przechwytywania, głosu i kontekstu urządzenia."}},"th":{"stringUnit":{"state":"translated","