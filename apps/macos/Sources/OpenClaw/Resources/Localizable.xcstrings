    "Recording was interrupted. Try again.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recording was interrupted. Try again."}},"zh-CN":{"stringUnit":{"state":"translated","value":"录音已中断。请重试。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"錄音已中斷。請重試。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A gravação foi interrompida. Tente novamente."}},"de":{"stringUnit":{"state":"translated","value":"Die Aufnahme wurde unterbrochen. Erneut versuchen."}},"es":{"stringUnit":{"state":"translated","value":"La grabación se interrumpió. Inténtalo de nuevo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"録音が中断されました。もう一度お試しください。"}},"ko":{"stringUnit":{"state":"translated","value":"녹음이 중단되었습니다. 다시 시도하세요."}},"fr":{"stringUnit":{"state":"translated","value":"L’enregistrement a été interrompu. Réessayez."}},"hi":{"stringUnit":{"state":"translated","value":"रिकॉर्डिंग बाधित हो गई थी. दोबारा कोशिश करें."}},"ar":{"stringUnit":{"state":"translated","value":"انقطع التسجيل. حاول مرة أخرى."}},"it":{"stringUnit":{"state":"translated","value":"La registrazione è stata interrotta. Riprova."}},"tr":{"stringUnit":{"state":"translated","value":"Kayıt kesintiye uğradı. Tekrar deneyin."}},"uk":{"stringUnit":{"state":"translated","value":"Запис перервано. Спробуйте ще раз."}},"id":{"stringUnit":{"state":"translated","value":"Perekaman terhenti. Coba lagi."}},"pl":{"stringUnit":{"state":"translated","value":"Nagrywanie zostało przerwane. Spróbuj ponownie."}},"th":{"stringUnit":{"state":"translated","value":"การบันทึกถูกขัดจังหวะ. ลองอีกครั้ง."}},"vi":{"stringUnit":{"state":"translated","value":"Quá trình ghi âm bị gián đoạn. Hãy thử lại."}},"nl":{"stringUnit":{"state":"translated","value":"De opname is onderbroken. Probeer het opnieuw."}},"fa":{"stringUnit":{"state":"translated","value":"ضبط قطع شد. دوباره تلاش کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Запись была прервана. Повторите попытку."}},"sv":{"stringUnit":{"state":"translated","value":"Inspelningen avbröts. Försök igen."}}}},
