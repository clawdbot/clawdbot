    "Starting local model setup…": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Starting local model setup…"}},"zh-CN":{"stringUnit":{"state":"translated","value":"正在启动本地模型设置…"}},"zh-TW":{"stringUnit":{"state":"translated","value":"正在開始本機模型設定…"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Iniciando a configuração do modelo local…"}},"de":{"stringUnit":{"state":"translated","value":"Einrichtung des lokalen Modells wird gestartet…"}},"es":{"stringUnit":{"state":"translated","value":"Iniciando la configuración del modelo local…"}},"ja-JP":{"stringUnit":{"state":"translated","value":"ローカルモデルのセットアップを開始しています…"}},"ko":{"stringUnit":{"state":"translated","value":"로컬 모델 설정을 시작하는 중…"}},"fr":{"stringUnit":{"state":"translated","value":"Démarrage de la configuration du modèle local…"}},"hi":{"stringUnit":{"state":"translated","value":"लोकल मॉडल सेटअप शुरू हो रहा है…"}},"ar":{"stringUnit":{"state":"translated","value":"جارٍ بدء إعداد النموذج المحلي…"}},"it":{"stringUnit":{"state":"translated","value":"Avvio della configurazione del modello locale…"}},"tr":{"stringUnit":{"state":"translated","value":"Yerel model kurulumu başlatılıyor…"}},"uk":{"stringUnit":{"state":"translated","value":"Запуск налаштування локальної моделі…"}},"id":{"stringUnit":{"state":"translated","value":"Memulai penyiapan model lokal…"}},"pl":{"stringUnit":{"state":"translated","value":"Rozpoczynanie konfiguracji modelu lokalnego…"}},"th":{"stringUnit":{"state":"translated","value":"กำลังเริ่มการตั้งค่าโมเดลในเครื่อง…"}},"vi":{"stringUnit":{"state":"translated","value":"Đang bắt đầu thiết lập mô hình cục bộ…"}},"nl":{"stringUnit":{"state":"translated","value":"Lokale modelinstelling starten…"}},"fa":{"stringUnit":{"state":"translated","value":"در حال شروع راه‌اندازی مدل محلی…"}},"ru":{"stringUnit":{"state":"translated","value":"Запуск настройки локальной модели…"}},"sv":{"stringUnit":{"state":"translated","value":"Startar konfiguration av lokal modell…"}}}},
    "Starting secure sign-in…": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Starting secure sign-in…"}},"zh-CN":{"stringUnit":{"state":"translated","value":"正在启动安全登录…"}},"zh-TW":{"stringUnit":{"state":"translated","value":"正在啟動安全登入…"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Iniciando login seguro…"}},"de":{"stringUnit":{"state":"translated","value":"Sichere Anmeldung wird gestartet…"}},"es":{"stringUnit":{"state":"translated","value":"Iniciando sesión segura…"}},"ja-JP":{"stringUnit":{"state":"translated","value":"安全なサインインを開始しています…"}},"ko":{"stringUnit":{"state":"translated","value":"보안 로그인 시작 중…"}},"fr":{"stringUnit":{"state":"translated","value":"Démarrage de la connexion sécurisée…"}},"hi":{"stringUnit":{"state":"translated","value":"सुरक्षित साइन-इन शुरू हो रहा है…"}},"ar":{"stringUnit":{"state":"translated","value":"جارٍ بدء تسجيل الدخول الآمن…"}},"it":{"stringUnit":{"state":"translated","value":"Avvio accesso sicuro…"}},"tr":{"stringUnit":{"state":"translated","value":"Güvenli oturum açma başlatılıyor…"}},"uk":{"stringUnit":{"state":"translated","value":"Запуск безпечного входу…"}},"id":{"stringUnit":{"state":"translated","value":"Memulai proses masuk yang aman…"}},"pl":{"stringUnit":{"state":"translated","value":"Rozpoczynanie bezpiecznego logowania…"}},"th":{"stringUnit":{"state":"translated","value":"กำลังเริ่มการลงชื่อเข้าใช้แบบปลอดภัย…"}},"vi":{"stringUnit":{"state":"translated","value":"Đang bắt đầu đăng nhập an toàn…"}},"nl":{"stringUnit":{"state":"translated","value":"Beveiligde aanmelding starten…"}},"fa":{"stringUnit":{"state":"translated","value":"در حال شروع ورود امن…"}},"ru":{"stringUnit":{"state":"translated","value":"Запуск безопасного входа…"}},"sv":{"stringUnit":{"state":"translated","value":"Startar säker inloggning…"}}}},
    "Starting…": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Starting…"}},"zh-CN":{"stringUnit":{"state":"translated","value":"正在启动…"}},"zh-TW":{"stringUnit":{"state":"translated","value":"正在啟動…"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Iniciando…"}},"de":{"stringUnit":{"state":"translated","value":"Wird gestartet…"}},"es":{"stringUnit":{"state":"translated","value":"Iniciando…"}},"ja-JP":{"stringUnit":{"state":"translated","value":"起動中…"}},"ko":{"stringUnit":{"state":"translated","value":"시작 중…"}},"fr":{"stringUnit":{"state":"translated","value":"Démarrage…"}},"hi":{"stringUnit":{"state":"translated","value":"शुरू हो रहा है…"}},"ar":{"stringUnit":{"state":"translated","value":"جارٍ البدء…"}},"it":{"stringUnit":{"state":"translated","value":"Avvio…"}},"tr":{"stringUnit":{"state":"translated","value":"Başlatılıyor…"}},"uk":{"stringUnit":{"state":"translated","value":"Запускається…"}},"id":{"stringUnit":{"state":"translated","value":"Memulai…"}},"pl":{"stringUnit":{"state":"translated","value":"Uruchamianie…"}},"th":{"stringUnit":{"state":"translated","value":"กำลังเริ่ม…"}},"vi":{"stringUnit":{"state":"translated","value":"Đang khởi động…"}},"nl":{"stringUnit":{"state":"translated","value":"Wordt gestart…"}},"fa":{"stringUnit":{"state":"translated","value":"در حال شروع…"}},"ru":{"stringUnit":{"state":"translated","value":"Запуск…"}},"sv":{"stringUnit":{"state":"translated","value":"Startar…"}}}},
    "Starts enabled. After this Mac is paired and macOS access is granted, the paired Gateway can move the pointer, click, and type without per-action confirmation. High risk.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Starts enabled. After this Mac is paired and macOS access is granted, the paired Gateway can move the pointer, click, and type without per-action confirmation. High risk."}},"zh-CN":{"stringUnit":{"state":"translated","value":"默认启用。此 Mac 完成配对并授予 macOS 访问权限后，已配对的 Gateway 无需逐项确认即可移动指针、点击和输入。风险较高。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"預設為啟用。此 Mac 配對且授予 macOS 存取權後，已配對的 Gateway 無需逐次確認即可移動指標、點按及輸入。高風險。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Inicia ativado. Depois que este Mac for emparelhado e o acesso do macOS for concedido, o Gateway emparelhado poderá mover o cursor, clicar e digitar sem confirmação para cada ação. Alto risco."}},"de":{"stringUnit":{"state":"translated","value":"Ist standardmäßig aktiviert. Nachdem dieser Mac gekoppelt und der macOS-Zugriff gewährt wurde, kann das gekoppelte Gateway den Mauszeiger bewegen, klicken und Text eingeben, ohne dass jede Aktion einzeln bestätigt werden muss. Hohes Risiko."}},"es":{"stringUnit":{"state":"translated","value":"Se inicia habilitado. Una vez que este Mac esté emparejado y se conceda el acceso de macOS, el Gateway emparejado podrá mover el puntero, hacer clic y escribir sin confirmación para cada acción. Riesgo alto."}},"ja-JP":{"stringUnit":{"state":"translated","value":"初期状態で有効です。このMacがペアリングされ、macOSでアクセスが許可されると、ペアリング済みのGatewayは操作ごとの確認なしにポインタの移動、クリック、入力を行えます。高リスクです。"}},"ko":{"stringUnit":{"state":"translated","value":"처음부터 활성화됩니다. 이 Mac이 페어링되고 macOS 접근 권한이 허용되면, 페어링된 Gateway가 작업별 확인 없이 포인터를 이동하고 클릭하고 입력할 수 있습니다. 위험도가 높습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Activé par défaut. Une fois ce Mac jumelé et l’accès macOS accordé, le Gateway jumelé peut déplacer le pointeur, cliquer et saisir du texte sans confirmation pour chaque action. Risque élevé."}},"hi":{"stringUnit":{"state":"translated","value":"शुरू में सक्षम रहता है। इस Mac के पेयर हो जाने और macOS एक्सेस की अनुमति मिलने के बाद, पेयर किया गया Gateway हर कार्रवाई की पुष्टि के बिना पॉइंटर को चला सकता है, क्लिक कर सकता है और टाइप कर सकता है। उच्च जोखिम।"}},"ar":{"stringUnit":{"state":"translated","value":"يبدأ مفعّلًا. بعد إقران جهاز Mac هذا ومنح أذونات الوصول في macOS، يمكن لـ Gateway المقترن تحريك المؤشر والنقر والكتابة من دون تأكيد كل إجراء. خطورة عالية."}},"it":{"stringUnit":{"state":"translated","value":"Si avvia abilitato. Dopo aver abbinato questo Mac e concesso l’accesso a macOS, il Gateway abbinato può spostare il puntatore, fare clic e digitare senza conferma per ogni azione. Rischio elevato."}},"tr":{"stringUnit":{"state":"translated","value":"Etkin olarak başlar. Bu Mac eşleştirildikten ve macOS erişimi verildikten sonra eşleştirilmiş Gateway, her işlem için onay gerektirmeden işaretçiyi hareket ettirebilir, tıklayabilir ve yazabilir. Yüksek risk."}},"uk":{"stringUnit":{"state":"translated","value":"Початково ввімкнено. Після створення пари з цим Mac і надання доступу в macOS підключений Gateway зможе переміщувати вказівник, натискати та вводити текст без підтвердження кожної дії. Високий ризик."}},"id":{"stringUnit":{"state":"translated","value":"Diaktifkan secara default. Setelah Mac ini dipasangkan dan akses macOS diberikan, Gateway yang dipasangkan dapat menggerakkan penunjuk, mengeklik, dan mengetik tanpa konfirmasi untuk setiap tindakan. Berisiko tinggi."}},"pl":{"stringUnit":{"state":"translated","value":"Funkcja jest domyślnie włączona. Po sparowaniu tego Maca i przyznaniu dostępu w macOS sparowany Gateway może przesuwać wskaźnik, klikać i pisać bez potwierdzania każdej czynności. Wysokie ryzyko."}},"th":{"stringUnit":{"state":"translated","value":"เปิดใช้งานตั้งแต่เริ่มต้น หลังจากจับคู่ Mac เครื่องนี้และอนุญาตสิทธิ์เข้าถึง macOS แล้ว Gateway ที่จับคู่จะสามารถเลื่อนตัวชี้ คลิก และพิมพ์ได้โดยไม่ต้องยืนยันแต่ละการดำเนินการ มีความเสี่ยงสูง"}},"vi":{"stringUnit":{"state":"translated","value":"Được bật khi khởi động. Sau khi máy Mac này được ghép nối và quyền truy cập macOS được cấp, Gateway đã ghép nối có thể di chuyển con trỏ, nhấp và nhập mà không cần xác nhận cho từng thao tác. Rủi ro cao."}},"nl":{"stringUnit":{"state":"translated","value":"Staat standaard aan. Nadat deze Mac is gekoppeld en macOS-toegang is verleend, kan de gekoppelde Gateway de aanwijzer verplaatsen, klikken en typen zonder bevestiging per actie. Hoog risico."}},"fa":{"stringUnit":{"state":"translated","value":"در ابتدا فعال است. پس از جفت‌شدن این Mac و اعطای دسترسی macOS، Gateway جفت‌شده می‌تواند بدون تأیید جداگانه برای هر عمل، نشانگر را حرکت دهد، کلیک کند و تایپ کند. پرخطر."}},"ru":{"stringUnit":{"state":"translated","value":"Изначально включено. После сопряжения этого Mac и предоставления доступа в macOS сопряжённый Gateway сможет перемещать указатель, нажимать и вводить текст без подтверждения каждого действия. Высокий риск."}},"sv":{"stringUnit":{"state":"translated","value":"Aktiverad från början. När denna Mac har parkopplats och macOS-åtkomst har beviljats kan den parkopplade Gateway flytta pekaren, klicka och skriva utan bekräftelse för varje åtgärd. Hög risk."}}}},
    "Status": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Status"}},"zh-CN":{"stringUnit":{"state":"translated","value":"状态"}},"zh-TW":{"stringUnit":{"state":"translated","value":"狀態"}},"pt-BR":{"stringUnit":{"state":"new","value":"Status"}},"de":{"stringUnit":{"state":"new","value":"Status"}},"es":{"stringUnit":{"state":"translated","value":"Estado"}},"ja-JP":{"stringUnit":{"state":"translated","value":"ステータス"}},"ko":{"stringUnit":{"state":"translated","value":"상태"}},"fr":{"stringUnit":{"state":"translated","value":"État"}},"hi":{"stringUnit":{"state":"translated","value":"स्थिति"}},"ar":{"stringUnit":{"state":"translated","value":"الحالة"}},"it":{"stringUnit":{"state":"translated","value":"Stato"}},"tr":{"stringUnit":{"state":"translated","value":"Durum"}},"uk":{"stringUnit":{"state":"translated","value":"Стан"}},"id":{"stringUnit":{"state":"new","value":"Status"}},"pl":{"stringUnit":{"state":"new","value":"Status"}},"th":{"stringUnit":{"state":"translated","value":"สถานะ"}},"vi":{"stringUnit":{"state":"translated","value":"Trạng thái"}},"nl":{"stringUnit":{"state":"new","value":"Status"}},"fa":{"stringUnit":{"state":"translated","value":"وضعیت"}},"ru":{"stringUnit":{"state":"translated","value":"Статус"}},"sv":{"stringUnit":{"state":"new","value":"Status"}}}},
