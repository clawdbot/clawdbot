    "Give your agent more powers": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Give your agent more powers"}},"zh-CN":{"stringUnit":{"state":"translated","value":"赋予你的智能体更多能力"}},"zh-TW":{"stringUnit":{"state":"translated","value":"讓您的代理具備更多能力"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Dê mais poderes ao seu agente"}},"de":{"stringUnit":{"state":"translated","value":"Geben Sie Ihrem Agenten mehr Fähigkeiten"}},"es":{"stringUnit":{"state":"translated","value":"Dale más capacidades a tu agente"}},"ja-JP":{"stringUnit":{"state":"translated","value":"エージェントの機能を拡張"}},"ko":{"stringUnit":{"state":"translated","value":"에이전트에 더 많은 기능 부여하기"}},"fr":{"stringUnit":{"state":"translated","value":"Donnez plus de capacités à votre agent"}},"hi":{"stringUnit":{"state":"translated","value":"अपने एजेंट को और क्षमताएँ दें"}},"ar":{"stringUnit":{"state":"translated","value":"امنح وكيلك المزيد من القدرات"}},"it":{"stringUnit":{"state":"translated","value":"Dai più capacità al tuo agente"}},"tr":{"stringUnit":{"state":"translated","value":"Ajanınıza daha fazla yetenek kazandırın"}},"uk":{"stringUnit":{"state":"translated","value":"Надайте своєму агенту більше можливостей"}},"id":{"stringUnit":{"state":"translated","value":"Berikan lebih banyak kemampuan kepada agen Anda"}},"pl":{"stringUnit":{"state":"translated","value":"Daj swojemu agentowi więcej możliwości"}},"th":{"stringUnit":{"state":"translated","value":"เพิ่มความสามารถให้เอเจนต์ของคุณ"}},"vi":{"stringUnit":{"state":"translated","value":"Thêm khả năng cho tác nhân của bạn"}},"nl":{"stringUnit":{"state":"translated","value":"Geef je agent meer mogelijkheden"}},"fa":{"stringUnit":{"state":"translated","value":"قابلیت‌های بیشتری به عامل خود بدهید"}},"ru":{"stringUnit":{"state":"translated","value":"Дайте своему агенту больше возможностей"}},"sv":{"stringUnit":{"state":"translated","value":"Ge din agent fler förmågor"}}}},
    "Give your assistant tasks and let it help across your Mac.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Give your assistant tasks and let it help across your Mac."}},"zh-CN":{"stringUnit":{"state":"translated","value":"向你的助手分配任务，让它在 Mac 上为你提供全方位帮助。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"將任務交給您的助理，讓它在您的 Mac 上提供各種協助。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Dê tarefas ao seu assistente e deixe que ele ajude em todo o seu Mac."}},"de":{"stringUnit":{"state":"translated","value":"Geben Sie Ihrem Assistenten Aufgaben und lassen Sie sich auf Ihrem gesamten Mac unterstützen."}},"es":{"stringUnit":{"state":"translated","value":"Asigna tareas a tu asistente y deja que te ayude en todo tu Mac."}},"ja-JP":{"stringUnit":{"state":"translated","value":"アシスタントにタスクを割り当て、Mac全体で作業をサポートしてもらいましょう。"}},"ko":{"stringUnit":{"state":"translated","value":"어시스턴트에게 작업을 맡기고 Mac 전반에서 도움을 받아 보세요."}},"fr":{"stringUnit":{"state":"translated","value":"Confiez des tâches à votre assistant et laissez-le vous aider sur votre Mac."}},"hi":{"stringUnit":{"state":"translated","value":"अपने सहायक को काम सौंपें और उसे अपने Mac पर आपकी मदद करने दें."}},"ar":{"stringUnit":{"state":"translated","value":"كلّف مساعدك بمهام ودعه يساعدك على جهاز Mac الخاص بك."}},"it":{"stringUnit":{"state":"translated","value":"Assegna attività al tuo assistente e lascia che ti aiuti in tutto il Mac."}},"tr":{"stringUnit":{"state":"translated","value":"Asistanınıza görevler verin ve Mac'inizin her yerinde size yardımcı olmasına izin verin."}},"uk":{"stringUnit":{"state":"translated","value":"Давайте своєму помічнику завдання, і він допомагатиме вам у роботі на Mac."}},"id":{"stringUnit":{"state":"translated","value":"Berikan tugas kepada asisten Anda dan biarkan asisten membantu berbagai aktivitas di Mac Anda."}},"pl":{"stringUnit":{"state":"translated","value":"Zlecaj zadania swojemu asystentowi i pozwól mu pomagać na całym Macu."}},"th":{"stringUnit":{"state":"translated","value":"มอบหมายงานให้ผู้ช่วยของคุณและให้ผู้ช่วยทำงานต่าง ๆ บน Mac ของคุณ."}},"vi":{"stringUnit":{"state":"translated","value":"Giao nhiệm vụ cho trợ lý và để trợ lý hỗ trợ bạn trên toàn bộ máy Mac."}},"nl":{"stringUnit":{"state":"translated","value":"Geef je assistent taken en laat die je overal op je Mac helpen."}},"fa":{"stringUnit":{"state":"translated","value":"کارها را به دستیار خود بسپارید و اجازه دهید در سراسر Mac به شما کمک کند."}},"ru":{"stringUnit":{"state":"translated","value":"Поручайте задачи своему помощнику и позвольте ему помогать вам на Mac."}},"sv":{"stringUnit":{"state":"translated","value":"Ge din assistent uppgifter och låt den hjälpa dig på din Mac."}}}},
    "Global": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Global"}},"zh-CN":{"stringUnit":{"state":"translated","value":"全局"}},"zh-TW":{"stringUnit":{"state":"translated","value":"全域"}},"pt-BR":{"stringUnit":{"state":"new","value":"Global"}},"de":{"stringUnit":{"state":"new","value":"Global"}},"es":{"stringUnit":{"state":"new","value":"Global"}},"ja-JP":{"stringUnit":{"state":"translated","value":"グローバル"}},"ko":{"stringUnit":{"state":"translated","value":"전역"}},"fr":{"stringUnit":{"state":"new","value":"Global"}},"hi":{"stringUnit":{"state":"translated","value":"वैश्विक"}},"ar":{"stringUnit":{"state":"translated","value":"عام"}},"it":{"stringUnit":{"state":"translated","value":"Globale"}},"tr":{"stringUnit":{"state":"translated","value":"Genel"}},"uk":{"stringUnit":{"state":"translated","value":"Глобальний"}},"id":{"stringUnit":{"state":"new","value":"Global"}},"pl":{"stringUnit":{"state":"translated","value":"Globalne"}},"th":{"stringUnit":{"state":"translated","value":"ทั่วทั้งระบบ"}},"vi":{"stringUnit":{"state":"translated","value":"Toàn cục"}},"nl":{"stringUnit":{"state":"translated","value":"Globaal"}},"fa":{"stringUnit":{"state":"translated","value":"سراسری"}},"ru":{"stringUnit":{"state":"translated","value":"Глобальный"}},"sv":{"stringUnit":{"state":"new","value":"Global"}}}},
    "Global shortcut that opens a floating chat bar for the main thread.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Global shortcut that opens a floating chat bar for the main thread."}},"zh-CN":{"stringUnit":{"state":"translated","value":"用于打开主会话悬浮聊天栏的全局快捷键。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"開啟主對話串浮動聊天列的全域快捷鍵。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Atalho global que abre uma barra de chat flutuante para a conversa principal."}},"de":{"stringUnit":{"state":"translated","value":"Globaler Kurzbefehl, der eine schwebende Chatleiste für den Hauptthread öffnet."}},"es":{"stringUnit":{"state":"translated","value":"Atajo global que abre una barra de chat flotante para el hilo principal."}},"ja-JP":{"stringUnit":{"state":"translated","value":"メインスレッドのフローティングチャットバーを開くグローバルショートカット。"}},"ko":{"stringUnit":{"state":"translated","value":"메인 스레드의 플로팅 채팅 바를 여는 전역 단축키."}},"fr":{"stringUnit":{"state":"translated","value":"Raccourci global qui ouvre une barre de discussion flottante pour le fil principal."}},"hi":{"stringUnit":{"state":"translated","value":"वैश्विक शॉर्टकट जो मुख्य थ्रेड के लिए एक फ़्लोटिंग चैट बार खोलता है।"}},"ar":{"stringUnit":{"state":"translated","value":"اختصار عام يفتح شريط دردشة عائمًا للمحادثة الرئيسية."}},"it":{"stringUnit":{"state":"translated","value":"Scorciatoia globale che apre una barra di chat mobile per la conversazione principale."}},"tr":{"stringUnit":{"state":"translated","value":"Ana konuşma için yüzen bir sohbet çubuğu açan genel kısayol."}},"uk":{"stringUnit":{"state":"translated","value":"Глобальне сполучення клавіш, що відкриває плаваючу панель чату для основної гілки."}},"id":{"stringUnit":{"state":"translated","value":"Pintasan global yang membuka bilah obrolan mengambang untuk utas utama."}},"pl":{"stringUnit":{"state":"translated","value":"Globalny skrót otwierający pływający pasek czatu dla głównego wątku."}},"th":{"stringUnit":{"state":"translated","value":"ปุ่มลัดที่ใช้ได้ทั่วทั้งระบบเพื่อเปิดแถบแชทแบบลอยสำหรับเธรดหลัก"}},"vi":{"stringUnit":{"state":"translated","value":"Phím tắt toàn cục để mở thanh trò chuyện nổi cho luồng chính."}},"nl":{"stringUnit":{"state":"translated","value":"Globale sneltoets die een zwevende chatbalk voor het hoofdgesprek opent."}},"fa":{"stringUnit":{"state":"translated","value":"میانبر سراسری که نوار گفتگوی شناوری را برای رشتهٔ اصلی باز می‌کند."}},"ru":{"stringUnit":{"state":"translated","value":"Глобальное сочетание клавиш, открывающее плавающую панель чата для основной ветки."}},"sv":{"stringUnit":{"state":"translated","value":"Globalt kortkommando som öppnar ett flytande chattfält för huvudtråden."}}}},
    "Grant": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Grant"}},"zh-CN":{"stringUnit":{"state":"translated","value":"授权"}},"zh-TW":{"stringUnit":{"state":"translated","value":"授予"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Conceder"}},"de":{"stringUnit":{"state":"translated","value":"Erteilen"}},"es":{"stringUnit":{"state":"translated","value":"Conceder"}},"ja-JP":{"stringUnit":{"state":"translated","value":"許可"}},"ko":{"stringUnit":{"state":"translated","value":"허용"}},"fr":{"stringUnit":{"state":"translated","value":"Autoriser"}},"hi":{"stringUnit":{"state":"translated","value":"अनुमति दें"}},"ar":{"stringUnit":{"state":"translated","value":"منح"}},"it":{"stringUnit":{"state":"translated","value":"Concedi"}},"tr":{"stringUnit":{"state":"translated","value":"İzin Ver"}},"uk":{"stringUnit":{"state":"translated","value":"Надати"}},"id":{"stringUnit":{"state":"translated","value":"Izinkan"}},"pl":{"stringUnit":{"state":"translated","value":"Przyznaj"}},"th":{"stringUnit":{"state":"translated","value":"ให้สิทธิ์"}},"vi":{"stringUnit":{"state":"translated","value":"Cấp quyền"}},"nl":{"stringUnit":{"state":"translated","value":"Toestaan"}},"fa":{"stringUnit":{"state":"translated","value":"اعطای مجوز"}},"ru":{"stringUnit":{"state":"translated","value":"Предоставить"}},"sv":{"stringUnit":{"state":"translated","value":"Bevilja"}}}},
    "Grant Access": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Grant Access"}},"zh-CN":{"stringUnit":{"state":"translated","value":"授予访问权限"}},"zh-TW":{"stringUnit":{"state":"translated","value":"授予存取權"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Conceder Acesso"}},"de":{"stringUnit":{"state":"translated","value":"Zugriff gewähren"}},"es":{"stringUnit":{"state":"translated","value":"Conceder Acceso"}},"ja-JP":{"stringUnit":{"state":"translated","value":"アクセスを許可"}},"ko":{"stringUnit":{"state":"translated","value":"접근 허용"}},"fr":{"stringUnit":{"state":"translated","value":"Autoriser l’accès"}},"hi":{"stringUnit":{"state":"translated","value":"पहुँच की अनुमति दें"}},"ar":{"stringUnit":{"state":"translated","value":"منح الوصول"}},"it":{"stringUnit":{"state":"translated","value":"Concedi accesso"}},"tr":{"stringUnit":{"state":"translated","value":"Erişim İzni Ver"}},"uk":{"stringUnit":{"state":"translated","value":"Надати доступ"}},"id":{"stringUnit":{"state":"translated","value":"Berikan Akses"}},"pl":{"stringUnit":{"state":"translated","value":"Przyznaj dostęp"}},"th":{"stringUnit":{"state":"translated","value":"ให้สิทธิ์เข้าถึง"}},"vi":{"stringUnit":{"state":"translated","value":"Cấp quyền truy cập"}},"nl":{"stringUnit":{"state":"translated","value":"Toegang verlenen"}},"fa":{"stringUnit":{"state":"translated","value":"اعطای دسترسی"}},"ru":{"stringUnit":{"state":"translated","value":"Предоставить доступ"}},"sv":{"stringUnit":{"state":"translated","value":"Bevilja åtkomst"}}}},
    "Grant OpenClaw in System Settings → Privacy & Security → Accessibility, then reopen it.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Grant OpenClaw in System Settings → Privacy & Security → Accessibility, then reopen it."}},"zh-CN":{"stringUnit":{"state":"translated","value":"在系统设置 → 隐私与安全性 → 辅助功能中为 OpenClaw 授权，然后重新打开它。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"在系統設定 → 隱私權與安全性 → 輔助使用中授予 OpenClaw 權限，然後重新開啟 OpenClaw。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Conceda permissão ao OpenClaw em Ajustes do Sistema → Privacidade e Segurança → Acessibilidade, depois reabra o aplicativo."}},"de":{"stringUnit":{"state":"translated","value":"Erteile OpenClaw unter Systemeinstellungen → Datenschutz & Sicherheit → Bedienungshilfen die Berechtigung und öffne es anschließend erneut."}},"es":{"stringUnit":{"state":"translated","value":"Concede permiso a OpenClaw en Ajustes del Sistema → Privacidad y Seguridad → Accesibilidad, luego vuelve a abrirlo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"システム設定 → プライバシーとセキュリティ → アクセシビリティでOpenClawを許可してから、再度開いてください。"}},"ko":{"stringUnit":{"state":"translated","value":"시스템 설정 → 개인정보 보호 및 보안 → 손쉬운 사용에서 OpenClaw에 권한을 부여한 후 다시 여세요."}},"fr":{"stringUnit":{"state":"translated","value":"Autorisez OpenClaw dans Réglages Système → Confidentialité et sécurité → Accessibilité, puis rouvrez l’application."}},"hi":{"stringUnit":{"state":"translated","value":"सिस्टम सेटिंग्स → गोपनीयता और सुरक्षा → सुलभता में OpenClaw को अनुमति दें, फिर इसे दोबारा खोलें।"}},"ar":{"stringUnit":{"state":"translated","value":"امنح OpenClaw الإذن في إعدادات النظام → الخصوصية والأمان → تسهيلات الاستخدام، ثم أعد فتحه."}},"it":{"stringUnit":{"state":"translated","value":"Autorizza OpenClaw in Impostazioni di Sistema → Privacy e sicurezza → Accessibilità, poi riaprilo."}},"tr":{"stringUnit":{"state":"translated","value":"Sistem Ayarları → Gizlilik ve Güvenlik → Erişilebilirlik bölümünde OpenClaw için izin verin, ardından uygulamayı yeniden açın."}},"uk":{"stringUnit":{"state":"translated","value":"Надайте OpenClaw дозвіл у меню Системні параметри → Приватність і безпека → Доступність, а потім відкрийте його знову."}},"id":{"stringUnit":{"state":"translated","value":"Berikan izin kepada OpenClaw di Pengaturan Sistem → Privasi & Keamanan → Aksesibilitas, lalu buka kembali aplikasinya."}},"pl":{"stringUnit":{"state":"translated","value":"Przyznaj aplikacji OpenClaw uprawnienia w Ustawieniach systemowych → Prywatność i ochrona → Dostępność, a następnie otwórz ją ponownie."}},"th":{"stringUnit":{"state":"translated","value":"ให้สิทธิ์ OpenClaw ในการตั้งค่าระบบ → ความเป็นส่วนตัวและความปลอดภัย → การช่วยการเข้าถึง แล้วเปิดแอปอีกครั้ง"}},"vi":{"stringUnit":{"state":"translated","value":"Cấp quyền cho OpenClaw trong Cài đặt hệ thống → Quyền riêng tư & Bảo mật → Trợ năng, rồi mở lại ứng dụng."}},"nl":{"stringUnit":{"state":"translated","value":"Geef OpenClaw toegang via Systeeminstellingen → Privacy en beveiliging → Toegankelijkheid en open de app vervolgens opnieuw."}},"fa":{"stringUnit":{"state":"translated","value":"در تنظیمات سیستم → حریم خصوصی و امنیت → دسترس‌پذیری، به OpenClaw مجوز بدهید، سپس آن را دوباره باز کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Предоставьте OpenClaw доступ в разделе «Системные настройки → Конфиденциальность и безопасность → Универсальный доступ», затем откройте приложение заново."}},"sv":{"stringUnit":{"state":"translated","value":"Ge OpenClaw behörighet i Systeminställningar → Integritet och säkerhet → Hjälpmedel, och öppna sedan appen igen."}}}},
    "Grant OpenClaw in System Settings → Privacy & Security → Screen Recording, then reopen it.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Grant OpenClaw in System Settings → Privacy & Security → Screen Recording, then reopen it."}},"zh-CN":{"stringUnit":{"state":"translated","value":"在系统设置 → 隐私与安全性 → 屏幕录制中为 OpenClaw 授权，然后重新打开它。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"在系統設定 → 隱私權與安全性 → 螢幕錄製中授予 OpenClaw 權限，然後重新開啟 OpenClaw。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Conceda permissão ao OpenClaw em Ajustes do Sistema → Privacidade e Segurança → Gravação de Tela, depois reabra o aplicativo."}},"de":{"stringUnit":{"state":"translated","value":"Erteile OpenClaw unter Systemeinstellungen → Datenschutz & Sicherheit → Bildschirmaufnahme die Berechtigung und öffne es anschließend erneut."}},"es":{"stringUnit":{"state":"translated","value":"Concede permiso a OpenClaw en Ajustes del Sistema → Privacidad y Seguridad → Grabación de Pantalla, luego vuelve a abrirlo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"システム設定 → プライバシーとセキュリティ → 画面収録でOpenClawを許可してから、再度開いてください。"}},"ko":{"stringUnit":{"state":"translated","value":"시스템 설정 → 개인정보 보호 및 보안 → 화면 기록에서 OpenClaw에 권한을 부여한 후 다시 여세요."}},"fr":{"stringUnit":{"state":"translated","value":"Autorisez OpenClaw dans Réglages Système → Confidentialité et sécurité → Enregistrement de l’écran, puis rouvrez l’application."}},"hi":{"stringUnit":{"state":"translated","value":"सिस्टम सेटिंग्स → गोपनीयता और सुरक्षा → स्क्रीन रिकॉर्डिंग में OpenClaw को अनुमति दें, फिर इसे दोबारा खोलें।"}},"ar":{"stringUnit":{"state":"translated","value":"امنح OpenClaw الإذن في إعدادات النظام → الخصوصية والأمان → تسجيل الشاشة، ثم أعد فتحه."}},"it":{"stringUnit":{"state":"translated","value":"Autorizza OpenClaw in Impostazioni di Sistema → Privacy e sicurezza → Registrazione schermo, poi riaprilo."}},"tr":{"stringUnit":{"state":"translated","value":"Sistem Ayarları → Gizlilik ve Güvenlik → Ekran Kaydı bölümünde OpenClaw için izin verin, ardından uygulamayı yeniden açın."}},"uk":{"stringUnit":{"state":"translated","value":"Надайте OpenClaw дозвіл у меню Системні параметри → Приватність і безпека → Запис екрана, а потім відкрийте його знову."}},"id":{"stringUnit":{"state":"translated","value":"Berikan izin kepada OpenClaw di Pengaturan Sistem → Privasi & Keamanan → Perekaman Layar, lalu buka kembali aplikasinya."}},"pl":{"stringUnit":{"state":"translated","value":"Przyznaj aplikacji OpenClaw uprawnienia w Ustawieniach systemowych → Prywatność i ochrona → Nagrywanie ekranu, a następnie otwórz ją ponownie."}},"th":{"stringUnit":{"state":"translated","value":"ให้สิทธิ์ OpenClaw ในการตั้งค่าระบบ → ความเป็นส่วนตัวและความปลอดภัย → การบันทึกหน้าจอ แล้วเปิดแอปอีกครั้ง"}},"vi":{"stringUnit":{"state":"translated","value":"Cấp quyền cho OpenClaw trong Cài đặt hệ thống → Quyền riêng tư & Bảo mật → Ghi màn hình, rồi mở lại ứng dụng."}},"nl":{"stringUnit":{"state":"translated","value":"Geef OpenClaw toegang via Systeeminstellingen → Privacy en beveiliging → Schermopname en open de app vervolgens opnieuw."}},"fa":{"stringUnit":{"state":"translated","value":"در تنظیمات سیستم → حریم خصوصی و امنیت → ضبط صفحه، به OpenClaw مجوز بدهید، سپس آن را دوباره باز کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Предоставьте OpenClaw доступ в разделе «Системные настройки → Конфиденциальность и безопасность → Запись экрана», затем откройте приложение заново."}},"sv":{"stringUnit":{"state":"translated","value":"Ge OpenClaw behörighet i Systeminställningar → Integritet och säkerhet → Skärminspelning, och öppna sedan appen igen."}}}},
