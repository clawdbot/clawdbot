    "Manage Gateway cron jobs and inspect run history.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Manage Gateway cron jobs and inspect run history."}},"zh-CN":{"stringUnit":{"state":"translated","value":"管理 Gateway cron 任务并查看运行历史。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"管理 Gateway cron 工作並檢視執行記錄。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Gerencie tarefas cron do Gateway e inspecione o histórico de execuções."}},"de":{"stringUnit":{"state":"translated","value":"Gateway-Cronjobs verwalten und Ausführungsverlauf einsehen."}},"es":{"stringUnit":{"state":"translated","value":"Gestiona las tareas cron de Gateway y consulta el historial de ejecuciones."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayのcronジョブを管理し、実行履歴を確認します。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway cron 작업을 관리하고 실행 기록을 확인하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Gérez les tâches cron du Gateway et consultez l’historique des exécutions."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway के क्रॉन जॉब प्रबंधित करें और उनके चलने का इतिहास देखें."}},"ar":{"stringUnit":{"state":"translated","value":"إدارة مهام cron في Gateway وفحص سجل التشغيل."}},"it":{"stringUnit":{"state":"translated","value":"Gestisci i processi cron del Gateway e consulta la cronologia delle esecuzioni."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway cron görevlerini yönetin ve çalıştırma geçmişini inceleyin."}},"uk":{"stringUnit":{"state":"translated","value":"Керуйте завданнями cron у Gateway і переглядайте історію виконання."}},"id":{"stringUnit":{"state":"translated","value":"Kelola tugas cron Gateway dan periksa riwayat eksekusi."}},"pl":{"stringUnit":{"state":"translated","value":"Zarządzaj zadaniami cron w Gateway i przeglądaj historię uruchomień."}},"th":{"stringUnit":{"state":"translated","value":"จัดการงาน cron ของ Gateway และตรวจสอบประวัติการทำงาน."}},"vi":{"stringUnit":{"state":"translated","value":"Qu