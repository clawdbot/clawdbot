    "Remove attachments or wait for delivery before archiving or deleting this thread.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Remove attachments or wait for delivery before archiving or deleting this thread."}},"zh-CN":{"stringUnit":{"state":"translated","value":"请先移除附件或等待发送完成，再归档或删除此对话。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"封存或刪除此討論串前，請先移除附件或等待傳送完成。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Remova os anexos ou aguarde a entrega antes de arquivar ou excluir esta conversa."}},"de":{"stringUnit":{"state":"translated","value":"Entfernen Sie die Anhänge oder warten Sie auf die Zustellung, bevor Sie diesen Thread archivieren oder löschen."}},"es":{"stringUnit":{"state":"translated","value":"Elimina los archivos adjuntos o espera a que se entreguen antes de archivar o eliminar este hilo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このスレッドをアーカイブまたは削除する前に、添付ファイルを削除するか、送信が完了するまでお待ちください。"}},"ko":{"stringUnit":{"state":"translated","value":"이 스레드를 보관하거나 삭제하기 전에 첨부 파일을 제거하거나 전송이 완료될 때까지 기다리세요."}},"fr":{"stringUnit":{"state":"translated","value":"Supprimez les pièces jointes ou attendez la fin de l’envoi avant d’archiver ou de supprimer ce fil."}},"hi":{"stringUnit":{"state":"translated","value":"इस थ्रेड को संग्रहित करने या हटाने से पहले अटैचमेंट हटाएँ या डिलीवरी की प्रतीक्षा करें."}},"ar":{"stringUnit":{"state":"translated","value":"أزل المرفقات أو انتظر التسليم قبل أرشفة سلسلة المحادثة هذه أو حذفها."}},"it":{"stringUnit":{"state":"translated","value":"Rimuovi gli allegati o attendi la consegna prima di archiviare o eliminare questa conversazione."}},"tr":{"stringUnit":{"state":"translated","value":"Bu konuşmayı arşivlemeden veya silmeden önce ekleri kaldırın ya da iletimin tamamlanmasını bekleyin."}},"uk":{"stringUnit":{"state":"translated","value":"Видаліть вкладення або дочекайтеся доставки, перш ніж архівувати чи видаляти цю гілку."}},"id":{"stringUnit":{"state":"translated","value":"Hapus lampiran atau tunggu hingga pengiriman selesai sebelum mengarsipkan atau menghapus utas ini."}},"pl":{"stringUnit":{"state":"translated","value":"Usuń załączniki lub poczekaj na dostarczenie przed zarchiwizowaniem lub usunięciem tego wątku."}},"th":{"stringUnit":{"state":"translated","value":"ลบไฟล์แนบหรือรอให้ส่งเสร็จก่อนเก็บถาวรหรือลบเธรดนี้"}},"vi":{"stringUnit":{"state":"translated","value":"Xóa các tệp đính kèm hoặc đợi gửi xong trước khi lưu trữ hoặc xóa cuộc trò chuyện này."}},"nl":{"stringUnit":{"state":"translated","value":"Verwijder bijlagen of wacht op de bezorging voordat je deze conversatie archiveert of verwijdert."}},"fa":{"stringUnit":{"state":"translated","value":"پیش از بایگانی یا حذف این رشته، پیوست‌ها را حذف کنید یا منتظر تحویل بمانید."}},"ru":{"stringUnit":{"state":"translated","value":"Удалите вложения или дождитесь доставки, прежде чем архивировать или удалять эту переписку."}},"sv":{"stringUnit":{"state":"translated","value":"Ta bort bilagor eller vänta på leverans innan du arkiverar eller tar bort den här tråden."}}}},
    "Remove attachments or wait for delivery to resolve before starting a new chat.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Remove attachments or wait for delivery to resolve before starting a new chat."}},"zh-CN":{"stringUnit":{"state":"translated","value":"请先移除附件或等待发送结束，再开始新聊天。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"開始新聊天前，請先移除附件或等待傳送狀態確定。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Remova os anexos ou aguarde a resolução da entrega antes de iniciar um novo chat."}},"de":{"stringUnit":{"state":"translated","value":"Entfernen Sie die Anhänge oder warten Sie, bis der Zustellvorgang abgeschlossen ist, bevor Sie einen neuen Chat starten."}},"es":{"stringUnit":{"state":"translated","value":"Elimina los archivos adjuntos o espera a que se resuelva la entrega antes de iniciar un nuevo chat."}},"ja-JP":{"stringUnit":{"state":"translated","value":"新しいチャットを開始する前に、添付ファイルを削除するか、送信処理が完了するまでお待ちください。"}},"ko":{"stringUnit":{"state":"translated","value":"새 채팅을 시작하기 전에 첨부 파일을 제거하거나 전송이 처리될 때까지 기다리세요."}},"fr":{"stringUnit":{"state":"translated","value":"Supprimez les pièces jointes ou attendez la fin de l’envoi avant de démarrer une nouvelle discussion."}},"hi":{"stringUnit":{"state":"translated","value":"नई चैट शुरू करने से पहले अटैचमेंट हटाएँ या डिलीवरी पूरी होने की प्रतीक्षा करें."}},"ar":{"stringUnit":{"state":"translated","value":"أزل المرفقات أو انتظر حسم حالة التسليم قبل بدء دردشة جديدة."}},"it":{"stringUnit":{"state":"translated","value":"Rimuovi gli allegati o attendi l'esito della consegna prima di avviare una nuova chat."}},"tr":{"stringUnit":{"state":"translated","value":"Yeni bir sohbet başlatmadan önce ekleri kaldırın ya da iletim işleminin sonuçlanmasını bekleyin."}},"uk":{"stringUnit":{"state":"translated","value":"Видаліть вкладення або дочекайтеся завершення доставки, перш ніж починати новий чат."}},"id":{"stringUnit":{"state":"translated","value":"Hapus lampiran atau tunggu hingga proses pengiriman selesai sebelum memulai obrolan baru."}},"pl":{"stringUnit":{"state":"translated","value":"Usuń załączniki lub poczekaj na zakończenie dostarczania przed rozpoczęciem nowego czatu."}},"th":{"stringUnit":{"state":"translated","value":"ลบไฟล์แนบหรือรอให้การส่งเสร็จสิ้นก่อนเริ่มแชทใหม่"}},"vi":{"stringUnit":{"state":"translated","value":"Xóa các tệp đính kèm hoặc đợi quá trình gửi hoàn tất trước khi bắt đầu cuộc trò chuyện mới."}},"nl":{"stringUnit":{"state":"translated","value":"Verwijder bijlagen of wacht tot de bezorging is afgehandeld voordat je een nieuwe chat start."}},"fa":{"stringUnit":{"state":"translated","value":"پیش از شروع گفتگوی جدید، پیوست‌ها را حذف کنید یا منتظر تعیین وضعیت تحویل بمانید."}},"ru":{"stringUnit":{"state":"translated","value":"Удалите вложения или дождитесь завершения доставки, прежде чем начать новый чат."}},"sv":{"stringUnit":{"state":"translated","value":"Ta bort bilagor eller vänta tills leveransen är klar innan du startar en ny chatt."}}}},
    "Remove attachments or wait for delivery to resolve before switching chats.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Remove attachments or wait for delivery to resolve before switching chats."}},"zh-CN":{"stringUnit":{"state":"translated","value":"请先移除附件或等待发送结束，再切换聊天。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"切換聊天前，請先移除附件或等待傳送狀態確定。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Remova os anexos ou aguarde a resolução da entrega antes de trocar de chat."}},"de":{"stringUnit":{"state":"translated","value":"Entfernen Sie die Anhänge oder warten Sie, bis der Zustellvorgang abgeschlossen ist, bevor Sie den Chat wechseln."}},"es":{"stringUnit":{"state":"translated","value":"Elimina los archivos adjuntos o espera a que se resuelva la entrega antes de cambiar de chat."}},"ja-JP":{"stringUnit":{"state":"translated","value":"チャットを切り替える前に、添付ファイルを削除するか、送信処理が完了するまでお待ちください。"}},"ko":{"stringUnit":{"state":"translated","value":"채팅을 전환하기 전에 첨부 파일을 제거하거나 전송이 처리될 때까지 기다리세요."}},"fr":{"stringUnit":{"state":"translated","value":"Supprimez les pièces jointes ou attendez la fin de l’envoi avant de changer de discussion."}},"hi":{"stringUnit":{"state":"translated","value":"चैट बदलने से पहले अटैचमेंट हटाएँ या डिलीवरी पूरी होने की प्रतीक्षा करें."}},"ar":{"stringUnit":{"state":"translated","value":"أزل المرفقات أو انتظر حسم حالة التسليم قبل التبديل بين الدردشات."}},"it":{"stringUnit":{"state":"translated","value":"Rimuovi gli allegati o attendi l'esito della consegna prima di passare a un'altra chat."}},"tr":{"stringUnit":{"state":"translated","value":"Sohbetler arasında geçiş yapmadan önce ekleri kaldırın ya da iletim işleminin sonuçlanmasını bekleyin."}},"uk":{"stringUnit":{"state":"translated","value":"Видаліть вкладення або дочекайтеся завершення доставки, перш ніж перемикатися між чатами."}},"id":{"stringUnit":{"state":"translated","value":"Hapus lampiran atau tunggu hingga proses pengiriman selesai sebelum beralih obrolan."}},"pl":{"stringUnit":{"state":"translated","value":"Usuń załączniki lub poczekaj na zakończenie dostarczania przed przełączeniem czatu."}},"th":{"stringUnit":{"state":"translated","value":"ลบไฟล์แนบหรือรอให้การส่งเสร็จสิ้นก่อนสลับแชท"}},"vi":{"stringUnit":{"state":"translated","value":"Xóa các tệp đính kèm hoặc đợi quá trình gửi hoàn tất trước khi chuyển cuộc trò chuyện."}},"nl":{"stringUnit":{"state":"translated","value":"Verwijder bijlagen of wacht tot de bezorging is afgehandeld voordat je van chat wisselt."}},"fa":{"stringUnit":{"state":"translated","value":"پیش از جابه‌جایی بین گفتگوها، پیوست‌ها را حذف کنید یا منتظر تعیین وضعیت تحویل بمانید."}},"ru":{"stringUnit":{"state":"translated","value":"Удалите вложения или дождитесь завершения доставки, прежде чем переключаться между чатами."}},"sv":{"stringUnit":{"state":"translated","value":"Ta bort bilagor eller vänta tills leveransen är klar innan du byter chatt."}}}},
