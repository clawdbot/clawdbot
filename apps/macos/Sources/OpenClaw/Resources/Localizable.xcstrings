    "Start Tailscale to get your tailnet hostname.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Start Tailscale to get your tailnet hostname."}},"zh-CN":{"stringUnit":{"state":"translated","value":"启动 Tailscale 以获取你的 tailnet 主机名。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"啟動 Tailscale 以取得您的 tailnet 主機名稱。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Inicie o Tailscale para obter seu nome de host na tailnet."}},"de":{"stringUnit":{"state":"translated","value":"Starten Sie Tailscale, um Ihren Tailnet-Hostnamen abzurufen."}},"es":{"stringUnit":{"state":"translated","value":"Inicia Tailscale para obtener tu nombre de host de tailnet."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Tailscaleを起動してtailnetのホスト名を取得してください。"}},"ko":{"stringUnit":{"state":"translated","value":"tailnet 호스트 이름을 가져오려면 Tailscale을 시작하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Démarrez Tailscale pour obtenir votre nom d’hôte tailnet."}},"hi":{"stringUnit":{"state":"translated","value":"अपना tailnet होस्टनाम पाने के लिए Tailscale शुरू करें."}},"ar":{"stringUnit":{"state":"translated","value":"شغّل Tailscale للحصول على اسم المضيف الخاص بك على شبكة tailnet."}},"it":{"stringUnit":{"state":"translated","value":"Avvia Tailscale per ottenere il nome host della tua tailnet."}},"tr":{"stringUnit":{"state":"translated","value":"Tailnet ana makine adınızı almak için Tailscale'i başlatın."}},"uk":{"stringUnit":{"state":"translated","value":"Запустіть Tailscale, щоб отримати ім’я хоста у вашій мережі tailnet."}},"id":{"stringUnit":{"state":"translated","value":"Mulai Tailscale untuk mendapatkan nama host tailnet Anda."}},"pl":{"stringUnit":{"state":"translated","value":"Uruchom Tailscale, aby uzyskać nazwę hosta w sieci tailnet."}},"th":{"stringUnit":{"state":"translated","value":"เริ่ม Tailscale เพื่อรับชื่อโฮสต์ tailnet ของคุณ"}},"vi":{"stringUnit":{"state":"translated","value":"Khởi động Tailscale để lấy tên máy chủ tailnet của bạn."}},"nl":{"stringUnit":{"state":"translated","value":"Start Tailscale om je tailnet-hostnaam op te halen."}},"fa":{"stringUnit":{"state":"translated","value":"برای دریافت نام میزبان tailnet خود، Tailscale را راه‌اندازی کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Запустите Tailscale, чтобы получить имя хоста в сети tailnet."}},"sv":{"stringUnit":{"state":"translated","value":"Starta Tailscale för att hämta ditt tailnet-värdnamn."}}}},
    "Start Talk Mode": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Start Talk Mode"}},"zh-CN":{"stringUnit":{"state":"translated","value":"启动语音对话模式"}},"zh-TW":{"stringUnit":{"state":"translated","value":"啟動語音對話模式"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Iniciar Modo de Conversa"}},"de":{"stringUnit":{"state":"translated","value":"Sprachmodus starten"}},"es":{"stringUnit":{"state":"translated","value":"Iniciar modo de conversación"}},"ja-JP":{"stringUnit":{"state":"translated","value":"トークモードを開始"}},"ko":{"stringUnit":{"state":"translated","value":"음성 대화 모드 시작"}},"fr":{"stringUnit":{"state":"translated","value":"Démarrer le mode conversation vocale"}},"hi":{"stringUnit":{"state":"translated","value":"बातचीत मोड शुरू करें"}},"ar":{"stringUnit":{"state":"translated","value":"بدء وضع التحدث"}},"it":{"stringUnit":{"state":"translated","value":"Avvia modalità conversazione vocale"}},"tr":{"stringUnit":{"state":"translated","value":"Konuşma Modunu Başlat"}},"uk":{"stringUnit":{"state":"translated","value":"Увімкнути режим розмови"}},"id":{"stringUnit":{"state":"translated","value":"Mulai Mode Bicara"}},"pl":{"stringUnit":{"state":"translated","value":"Uruchom tryb rozmowy"}},"th":{"stringUnit":{"state":"translated","value":"เริ่มโหมดพูดคุย"}},"vi":{"stringUnit":{"state":"translated","value":"Bắt đầu chế độ đàm thoại"}},"nl":{"stringUnit":{"state":"translated","value":"Spraakmodus starten"}},"fa":{"stringUnit":{"state":"translated","value":"شروع حالت مکالمه"}},"ru":{"stringUnit":{"state":"translated","value":"Включить режим разговора"}},"sv":{"stringUnit":{"state":"translated","value":"Starta röstläge"}}}},
    "Start a full voice conversation when a wake phrase is detected.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Start a full voice conversation when a wake phrase is detected."}},"zh-CN":{"stringUnit":{"state":"translated","value":"检测到唤醒短语时，开始完整的语音对话。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"偵測到喚醒詞時, 開始完整的語音對話。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Inicie uma conversa por voz completa quando uma frase de ativação for detectada."}},"de":{"stringUnit":{"state":"translated","value":"Ein vollständiges Sprachgespräch starten, wenn eine Aktivierungsphrase erkannt wird."}},"es":{"stringUnit":{"state":"translated","value":"Iniciar una conversación de voz completa cuando se detecte una frase de activación."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ウェイクフレーズが検出されたら、本格的な音声会話を開始します。"}},"ko":{"stringUnit":{"state":"translated","value":"호출 문구가 감지되면 전체 음성 대화를 시작합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Démarrer une conversation vocale complète lorsqu’une phrase d’activation est détectée."}},"hi":{"stringUnit":{"state":"translated","value":"जगाने वाला वाक्यांश पहचाने जाने पर पूरी वॉइस बातचीत शुरू करें."}},"ar":{"stringUnit":{"state":"translated","value":"ابدأ محادثة صوتية كاملة عند اكتشاف عبارة التنبيه."}},"it":{"stringUnit":{"state":"translated","value":"Avvia una conversazione vocale completa quando viene rilevata una frase di attivazione."}},"tr":{"stringUnit":{"state":"translated","value":"Bir uyandırma ifadesi algılandığında tam bir sesli sohbet başlatın."}},"uk":{"stringUnit":{"state":"translated","value":"Починати повноцінну голосову розмову, коли виявлено фразу активації."}},"id":{"stringUnit":{"state":"translated","value":"Mulai percakapan suara penuh saat frasa pemicu terdeteksi."}},"pl":{"stringUnit":{"state":"translated","value":"Rozpocznij pełną rozmowę głosową po wykryciu frazy wybudzającej."}},"th":{"stringUnit":{"state":"translated","value":"เริ่มการสนทนาด้วยเสียงแบบเต็มรูปแบบเมื่อตรวจพบวลีปลุก"}},"vi":{"stringUnit":{"state":"translated","value":"Bắt đầu một cuộc trò chuyện hoàn toàn bằng giọng nói khi phát hiện cụm từ đánh thức."}},"nl":{"stringUnit":{"state":"translated","value":"Start een volledig spraakgesprek wanneer een activeringszin wordt gedetecteerd."}},"fa":{"stringUnit":{"state":"translated","value":"با تشخیص عبارت فعال‌سازی، یک مکالمهٔ صوتی کامل را شروع کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Начинать полноценный голосовой разговор при обнаружении фразы активации."}},"sv":{"stringUnit":{"state":"translated","value":"Starta ett fullständigt röstsamtal när en aktiveringsfras upptäcks."}}}},
    "Start dictation": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Start dictation"}},"zh-CN":{"stringUnit":{"state":"translated","value":"开始听写"}},"zh-TW":{"stringUnit":{"state":"translated","value":"開始聽寫"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Iniciar ditado"}},"de":{"stringUnit":{"state":"translated","value":"Diktat starten"}},"es":{"stringUnit":{"state":"translated","value":"Iniciar dictado"}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声入力を開始"}},"ko":{"stringUnit":{"state":"translated","value":"받아쓰기 시작"}},"fr":{"stringUnit":{"state":"translated","value":"Démarrer la dictée"}},"hi":{"stringUnit":{"state":"translated","value":"बोलकर लिखना शुरू करें"}},"ar":{"stringUnit":{"state":"translated","value":"بدء الإملاء"}},"it":{"stringUnit":{"state":"translated","value":"Avvia dettatura"}},"tr":{"stringUnit":{"state":"translated","value":"Dikteyi başlat"}},"uk":{"stringUnit":{"state":"translated","value":"Почати диктування"}},"id":{"stringUnit":{"state":"translated","value":"Mulai dikte"}},"pl":{"stringUnit":{"state":"translated","value":"Rozpocznij dyktowanie"}},"th":{"stringUnit":{"state":"translated","value":"เริ่มการป้อนข้อความด้วยเสียง"}},"vi":{"stringUnit":{"state":"translated","value":"Bắt đầu nhập bằng giọng nói"}},"nl":{"stringUnit":{"state":"translated","value":"Dicteren starten"}},"fa":{"stringUnit":{"state":"translated","value":"شروع گفتار به نوشتار"}},"ru":{"stringUnit":{"state":"translated","value":"Начать диктовку"}},"sv":{"stringUnit":{"state":"translated","value":"Starta diktering"}}}},
    "Start listening while you hold the key and show the preview overlay.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Start listening while you hold the key and show the preview overlay."}},"zh-CN":{"stringUnit":{"state":"translated","value":"按住按键时开始聆听并显示预览浮层。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"按住按鍵時開始聆聽，並顯示預覽浮層。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Iniciar a escuta enquanto você mantém a tecla pressionada e mostrar a sobreposição de prévia."}},"de":{"stringUnit":{"state":"translated","value":"Zuhören starten, während Sie die Taste gedrückt halten, und die Vorschau einblenden."}},"es":{"stringUnit":{"state":"translated","value":"Iniciar la escucha mientras mantienes pulsada la tecla y mostrar la superposición de vista previa."}},"ja-JP":{"stringUnit":{"state":"translated","value":"キーを押している間は聞き取りを開始し、プレビューオーバーレイを表示します。"}},"ko":{"stringUnit":{"state":"translated","value":"키를 누르고 있는 동안 듣기를 시작하고 미리보기 오버레이를 표시합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Démarrer l’écoute tant que vous maintenez la touche enfoncée et afficher l’aperçu en superposition."}},"hi":{"stringUnit":{"state":"translated","value":"कुंजी दबाए रखने के दौरान सुनना शुरू करें और प्रीव्यू ओवरले दिखाएँ।"}},"ar":{"stringUnit":{"state":"translated","value":"بدء الاستماع أثناء الضغط المستمر على المفتاح وإظهار طبقة المعاينة."}},"it":{"stringUnit":{"state":"translated","value":"Avvia l'ascolto mentre tieni premuto il tasto e mostra l'anteprima in sovrimpressione."}},"tr":{"stringUnit":{"state":"translated","value":"Tuşu basılı tuttuğunuzda dinlemeyi başlat ve önizleme katmanını göster."}},"uk":{"stringUnit":{"state":"translated","value":"Почати прослуховування, поки ви утримуєте клавішу, і показати накладену панель попереднього перегляду."}},"id":{"stringUnit":{"state":"translated","value":"Mulai mendengarkan saat Anda menahan tombol dan tampilkan hamparan pratinjau."}},"pl":{"stringUnit":{"state":"translated","value":"Rozpocznij nasłuchiwanie podczas przytrzymywania klawisza i wyświetl nakładkę podglądu."}},"th":{"stringUnit":{"state":"translated","value":"เริ่มฟังขณะที่คุณกดปุ่มค้างไว้และแสดงหน้าต่างซ้อนตัวอย่าง."}},"vi":{"stringUnit":{"state":"translated","value":"Bắt đầu lắng nghe khi bạn giữ phím và hiển thị lớp phủ xem trước."}},"nl":{"stringUnit":{"state":"translated","value":"Begin met luisteren terwijl je de toets ingedrukt houdt en toon de voorbeeldoverlay."}},"fa":{"stringUnit":{"state":"translated","value":"هنگام نگه داشتن کلید، گوش دادن را شروع کنید و لایهٔ پیش‌نمایش را نمایش دهید."}},"ru":{"stringUnit":{"state":"translated","value":"Слушать, пока вы удерживаете клавишу, и показывать панель предварительного просмотра."}},"sv":{"stringUnit":{"state":"translated","value":"Börja lyssna medan du håller ned tangenten och visa förhandsvisningsöverlägget."}}}},
    "Start realtime chat": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Start realtime chat"}},"zh-CN":{"stringUnit":{"state":"translated","value":"开始实时聊天"}},"zh-TW":{"stringUnit":{"state":"translated","value":"開始即時聊天"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Iniciar conversa em tempo real"}},"de":{"stringUnit":{"state":"translated","value":"Echtzeit-Chat starten"}},"es":{"stringUnit":{"state":"translated","value":"Iniciar chat en tiempo real"}},"ja-JP":{"stringUnit":{"state":"translated","value":"リアルタイムチャットを開始"}},"ko":{"stringUnit":{"state":"translated","value":"실시간 채팅 시작"}},"fr":{"stringUnit":{"state":"translated","value":"Démarrer une conversation en temps réel"}},"hi":{"stringUnit":{"state":"translated","value":"रीयलटाइम चैट शुरू करें"}},"ar":{"stringUnit":{"state":"translated","value":"بدء محادثة فورية"}},"it":{"stringUnit":{"state":"translated","value":"Avvia chat in tempo reale"}},"tr":{"stringUnit":{"state":"translated","value":"Gerçek zamanlı sohbeti başlat"}},"uk":{"stringUnit":{"state":"translated","value":"Почати чат у реальному часі"}},"id":{"stringUnit":{"state":"translated","value":"Mulai obrolan waktu nyata"}},"pl":{"stringUnit":{"state":"translated","value":"Rozpocznij czat w czasie rzeczywistym"}},"th":{"stringUnit":{"state":"translated","value":"เริ่มแชทแบบเรียลไทม์"}},"vi":{"stringUnit":{"state":"translated","value":"Bắt đầu trò chuyện theo thời gian thực"}},"nl":{"stringUnit":{"state":"translated","value":"Realtime chat starten"}},"fa":{"stringUnit":{"state":"translated","value":"شروع گفتگوی بلادرنگ"}},"ru":{"stringUnit":{"state":"translated","value":"Начать чат в реальном времени"}},"sv":{"stringUnit":{"state":"translated","value":"Starta realtidschatt"}}}},
    "Start test": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Start test"}},"zh-CN":{"stringUnit":{"state":"translated","value":"开始测试"}},"zh-TW":{"stringUnit":{"state":"translated","value":"開始測試"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Iniciar teste"}},"de":{"stringUnit":{"state":"translated","value":"Test starten"}},"es":{"stringUnit":{"state":"translated","value":"Iniciar prueba"}},"ja-JP":{"stringUnit":{"state":"translated","value":"テストを開始"}},"ko":{"stringUnit":{"state":"translated","value":"테스트 시작"}},"fr":{"stringUnit":{"state":"translated","value":"Démarrer le test"}},"hi":{"stringUnit":{"state":"translated","value":"परीक्षण शुरू करें"}},"ar":{"stringUnit":{"state":"translated","value":"بدء الاختبار"}},"it":{"stringUnit":{"state":"translated","value":"Avvia test"}},"tr":{"stringUnit":{"state":"translated","value":"Testi başlat"}},"uk":{"stringUnit":{"state":"translated","value":"Почати тест"}},"id":{"stringUnit":{"state":"translated","value":"Mulai pengujian"}},"pl":{"stringUnit":{"state":"translated","value":"Rozpocznij test"}},"th":{"stringUnit":{"state":"translated","value":"เริ่มการทดสอบ"}},"vi":{"stringUnit":{"state":"translated","value":"Bắt đầu kiểm tra"}},"nl":{"stringUnit":{"state":"translated","value":"Test starten"}},"fa":{"stringUnit":{"state":"translated","value":"شروع آزمایش"}},"ru":{"stringUnit":{"state":"translated","value":"Начать проверку"}},"sv":{"stringUnit":{"state":"translated","value":"Starta test"}}}},
    "Start the background service": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Start the background service"}},"zh-CN":{"stringUnit":{"state":"translated","value":"启动后台服务"}},"zh-TW":{"stringUnit":{"state":"translated","value":"啟動背景服務"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Iniciar o serviço em segundo plano"}},"de":{"stringUnit":{"state":"translated","value":"Hintergrunddienst starten"}},"es":{"stringUnit":{"state":"translated","value":"Iniciar el servicio en segundo plano"}},"ja-JP":{"stringUnit":{"state":"translated","value":"バックグラウンドサービスを開始"}},"ko":{"stringUnit":{"state":"translated","value":"백그라운드 서비스 시작"}},"fr":{"stringUnit":{"state":"translated","value":"Démarrer le service en arrière-plan"}},"hi":{"stringUnit":{"state":"translated","value":"बैकग्राउंड सेवा शुरू करें"}},"ar":{"stringUnit":{"state":"translated","value":"بدء الخدمة في الخلفية"}},"it":{"stringUnit":{"state":"translated","value":"Avvia il servizio in background"}},"tr":{"stringUnit":{"state":"translated","value":"Arka plan hizmetini başlat"}},"uk":{"stringUnit":{"state":"translated","value":"Запустити фонову службу"}},"id":{"stringUnit":{"state":"translated","value":"Mulai layanan latar belakang"}},"pl":{"stringUnit":{"state":"translated","value":"Uruchom usługę w tle"}},"th":{"stringUnit":{"state":"translated","value":"เริ่มบริการเบื้องหลัง"}},"vi":{"stringUnit":{"state":"translated","value":"Khởi động dịch vụ nền"}},"nl":{"stringUnit":{"state":"translated","value":"De achtergrondservice starten"}},"fa":{"stringUnit":{"state":"translated","value":"راه‌اندازی سرویس پس‌زمینه"}},"ru":{"stringUnit":{"state":"translated","value":"Запустить фоновую службу"}},"sv":{"stringUnit":{"state":"translated","value":"Starta bakgrundstjänsten"}}}},
    "Starting local model setup…": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Starting local model setup…"}},"zh-CN":{"stringUnit":{"state":"translated","value":"正在开始设置本地模型…"}},"zh-TW":{"stringUnit":{"state":"translated","value":"正在開始設定本機模型…"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Iniciando a configuração do modelo local…"}},"de":{"stringUnit":{"state":"translated","value":"Einrichtung des lokalen Modells wird gestartet…"}},"es":{"stringUnit":{"state":"translated","value":"Iniciando la configuración del modelo local…"}},"ja-JP":{"stringUnit":{"state":"translated","value":"ローカルモデルのセットアップを開始中…"}},"ko":{"stringUnit":{"state":"translated","value":"로컬 모델 설정 시작 중…"}},"fr":{"stringUnit":{"state":"translated","value":"Démarrage de la configuration du modèle local…"}},"hi":{"stringUnit":{"state":"translated","value":"स्थानीय मॉडल का सेटअप शुरू हो रहा है…"}},"ar":{"stringUnit":{"state":"translated","value":"جارٍ بدء إعداد النموذج المحلي…"}},"it":{"stringUnit":{"state":"translated","value":"Avvio della configurazione del modello locale…"}},"tr":{"stringUnit":{"state":"translated","value":"Yerel model kurulumu başlatılıyor…"}},"uk":{"stringUnit":{"state":"translated","value":"Початок налаштування локальної моделі…"}},"id":{"stringUnit":{"state":"translated","value":"Memulai penyiapan model lokal…"}},"pl":{"stringUnit":{"state":"translated","value":"Rozpoczynanie konfiguracji modelu lokalnego…"}},"th":{"stringUnit":{"state":"translated","value":"กำลังเริ่มตั้งค่าโมเดลภายในเครื่อง…"}},"vi":{"stringUnit":{"state":"translated","value":"Đang bắt đầu thiết lập mô hình cục bộ…"}},"nl":{"stringUnit":{"state":"translated","value":"Configuratie van lokaal model starten…"}},"fa":{"stringUnit":{"state":"translated","value":"در حال شروع راه‌اندازی مدل محلی…"}},"ru":{"stringUnit":{"state":"translated","value":"Запуск настройки локальной модели…"}},"sv":{"stringUnit":{"state":"translated","value":"Startar konfiguration av lokal modell…"}}}},
    "Starting secure sign-in…": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Starting secure sign-in…"}},"zh-CN":{"stringUnit":{"state":"translated","value":"正在启动安全登录…"}},"zh-TW":{"stringUnit":{"state":"translated","value":"正在啟動安全登入…"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Iniciando login seguro…"}},"de":{"stringUnit":{"state":"translated","value":"Sichere Anmeldung wird gestartet…"}},"es":{"stringUnit":{"state":"translated","value":"Iniciando sesión de forma segura…"}},"ja-JP":{"stringUnit":{"state":"translated","value":"安全なサインインを開始中…"}},"ko":{"stringUnit":{"state":"translated","value":"보안 로그인 시작 중…"}},"fr":{"stringUnit":{"state":"translated","value":"Démarrage de la connexion sécurisée…"}},"hi":{"stringUnit":{"state":"translated","value":"सुरक्षित साइन-इन शुरू हो रहा है…"}},"ar":{"stringUnit":{"state":"translated","value":"جارٍ بدء تسجيل الدخول الآمن…"}},"it":{"stringUnit":{"state":"translated","value":"Avvio dell'accesso sicuro…"}},"tr":{"stringUnit":{"state":"translated","value":"Güvenli oturum açma başlatılıyor…"}},"uk":{"stringUnit":{"state":"translated","value":"Початок безпечного входу…"}},"id":{"stringUnit":{"state":"translated","value":"Memulai proses masuk yang aman…"}},"pl":{"stringUnit":{"state":"translated","value":"Rozpoczynanie bezpiecznego logowania…"}},"th":{"stringUnit":{"state":"translated","value":"กำลังเริ่มการลงชื่อเข้าใช้อย่างปลอดภัย…"}},"vi":{"stringUnit":{"state":"translated","value":"Đang bắt đầu đăng nhập an toàn…"}},"nl":{"stringUnit":{"state":"translated","value":"Beveiligde aanmelding starten…"}},"fa":{"stringUnit":{"state":"translated","value":"در حال شروع ورود امن…"}},"ru":{"stringUnit":{"state":"translated","value":"Начало безопасного входа…"}},"sv":{"stringUnit":{"state":"translated","value":"Startar säker inloggning…"}}}},
    "Starting…": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Starting…"}},"zh-CN":{"stringUnit":{"state":"translated","value":"正在启动…"}},"zh-TW":{"stringUnit":{"state":"translated","value":"正在啟動…"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Iniciando…"}},"de":{"stringUnit":{"state":"translated","value":"Wird gestartet…"}},"es":{"stringUnit":{"state":"translated","value":"Iniciando…"}},"ja-JP":{"stringUnit":{"state":"translated","value":"開始中…"}},"ko":{"stringUnit":{"state":"translated","value":"시작 중…"}},"fr":{"stringUnit":{"state":"translated","value":"Démarrage…"}},"hi":{"stringUnit":{"state":"translated","value":"शुरू हो रहा है…"}},"ar":{"stringUnit":{"state":"translated","value":"جارٍ البدء…"}},"it":{"stringUnit":{"state":"translated","value":"Avvio…"}},"tr":{"stringUnit":{"state":"translated","value":"Başlatılıyor…"}},"uk":{"stringUnit":{"state":"translated","value":"Запуск…"}},"id":{"stringUnit":{"state":"translated","value":"Memulai…"}},"pl":{"stringUnit":{"state":"translated","value":"Uruchamianie…"}},"th":{"stringUnit":{"state":"translated","value":"กำลังเริ่ม…"}},"vi":{"stringUnit":{"state":"translated","value":"Đang khởi động…"}},"nl":{"stringUnit":{"state":"translated","value":"Starten…"}},"fa":{"stringUnit":{"state":"translated","value":"در حال شروع…"}},"ru":{"stringUnit":{"state":"translated","value":"Запуск…"}},"sv":{"stringUnit":{"state":"translated","value":"Startar…"}}}},
    "Starts a new session ID for “%@”.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Starts a new session ID for “%@”."}},"zh-CN":{"stringUnit":{"state":"translated","value":"为“%@”启用新的会话 ID。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"為“%@”啟用新的工作階段 ID。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Inicia um novo ID de sessão para “%@”."}},"de":{"stringUnit":{"state":"translated","value":"Startet eine neue Sitzungs-ID für “%@”."}},"es":{"stringUnit":{"state":"translated","value":"Inicia un nuevo ID de sesión para “%@”."}},"ja-JP":{"stringUnit":{"state":"translated","value":"“%@”の新しいセッションIDを開始します."}},"ko":{"stringUnit":{"state":"translated","value":"“%@”에 대한 새 세션 ID를 시작합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Crée un nouvel identifiant de session pour “%@”."}},"hi":{"stringUnit":{"state":"translated","value":"“%@” के लिए एक नया सत्र ID शुरू करता है।"}},"ar":{"stringUnit":{"state":"translated","value":"يبدأ معرّف جلسة جديدًا لـ “%@”."}},"it":{"stringUnit":{"state":"translated","value":"Avvia un nuovo ID di sessione per “%@”."}},"tr":{"stringUnit":{"state":"translated","value":"“%@” için yeni bir oturum kimliği başlatır."}},"uk":{"stringUnit":{"state":"translated","value":"Створює новий ідентифікатор сеансу для “%@”."}},"id":{"stringUnit":{"state":"translated","value":"Memulai ID sesi baru untuk “%@”."}},"pl":{"stringUnit":{"state":"translated","value":"Tworzy nowy identyfikator sesji dla „%@”."}},"th":{"stringUnit":{"state":"translated","value":"เริ่มเซสชันใหม่พร้อม ID ใหม่สำหรับ “%@”."}},"vi":{"stringUnit":{"state":"translated","value":"Tạo ID phiên mới cho “%@”."}},"nl":{"stringUnit":{"state":"translated","value":"Start een nieuwe sessie-ID voor “%@”."}},"fa":{"stringUnit":{"state":"translated","value":"شناسهٔ نشست جدیدی برای “%@” ایجاد می‌کند."}},"ru":{"stringUnit":{"state":"translated","value":"Создаёт новый идентификатор сеанса для “%@”."}},"sv":{"stringUnit":{"state":"translated","value":"Startar ett nytt sessions-ID för “%@”."}}}},
    "Starts enabled. After this Mac is paired and macOS access is granted, the paired Gateway can move the pointer, click, and type without per-action confirmation. High risk.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Starts enabled. After this Mac is paired and macOS access is granted, the paired Gateway can move the pointer, click, and type without per-action confirmation. High risk."}},"zh-CN":{"stringUnit":{"state":"translated","value":"默认启用。此 Mac 配对并获得 macOS 访问权限后，已配对的 Gateway 即可移动指针、点击和输入，无需逐项确认操作。风险较高。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"預設啟用。此 Mac 完成配對並獲授 macOS 存取權後，已配對的 Gateway 即可移動指標、點按及輸入，無須逐一確認每項操作。風險高。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Começa ativado. Após este Mac ser pareado e o acesso ao macOS ser concedido, o Gateway pareado poderá mover o ponteiro, clicar e digitar sem confirmação a cada ação. Alto risco."}},"de":{"stringUnit":{"state":"translated","value":"Anfangs aktiviert. Nachdem dieser Mac gekoppelt und der macOS-Zugriff gewährt wurde, kann der gekoppelte Gateway den Zeiger bewegen, klicken und tippen, ohne dass jede Aktion einzeln bestätigt werden muss. Hohes Risiko."}},"es":{"stringUnit":{"state":"translated","value":"Activado de forma predeterminada. Una vez que este Mac esté vinculado y se haya concedido acceso a macOS, el Gateway vinculado podrá mover el puntero, hacer clic y escribir sin confirmar cada acción. Riesgo alto."}},"ja-JP":{"stringUnit":{"state":"translated","value":"初期状態で有効です。 このMacをペアリングしてmacOSへのアクセスを許可すると、ペアリング済みのGatewayは操作ごとの確認なしでポインタの移動、クリック、文字入力を行えます。 リスクが高い設定です。"}},"ko":{"stringUnit":{"state":"translated","value":"처음부터 활성화됩니다. 이 Mac이 페어링되고 macOS 접근 권한이 부여되면, 페어링된 Gateway가 동작별 확인 없이 포인터를 움직이고, 클릭하고, 입력할 수 있습니다. 위험도가 높습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Activé par défaut. Une fois ce Mac jumelé et l’accès à macOS autorisé, le Gateway jumelé peut déplacer le pointeur, cliquer et saisir du texte sans confirmation pour chaque action. Risque élevé."}},"hi":{"stringUnit":{"state":"translated","value":"शुरू से सक्षम रहता है। इस Mac के पेयर हो जाने और macOS की ऐक्सेस मिलने के बाद, पेयर किया गया Gateway हर कार्रवाई की पुष्टि लिए बिना पॉइंटर चला सकता है, क्लिक कर सकता है और टाइप कर सकता है। उच्च जोखिम।"}},"ar":{"stringUnit":{"state":"translated","value":"يكون مفعّلًا عند البدء. بعد إقران جهاز Mac هذا ومنح صلاحية الوصول إلى macOS، يمكن لـ Gateway المقترن تحريك المؤشر والنقر والكتابة دون تأكيد لكل إجراء. خطورة عالية."}},"it":{"stringUnit":{"state":"translated","value":"Abilitato inizialmente. Dopo l'abbinamento di questo Mac e la concessione dell'accesso a macOS, il Gateway abbinato può spostare il puntatore, fare clic e digitare senza conferma per ogni azione. Rischio elevato."}},"tr":{"stringUnit":{"state":"translated","value":"Başlangıçta etkindir. Bu Mac eşleştirildikten ve macOS erişimi verildikten sonra, eşleştirilmiş Gateway her işlem için onay almadan işaretçiyi hareket ettirebilir, tıklayabilir ve yazabilir. Yüksek risk."}},"uk":{"stringUnit":{"state":"translated","value":"Увімкнено від початку. Після сполучення цього Mac і надання доступу в macOS сполучений Gateway зможе переміщувати вказівник, натискати й вводити текст без підтвердження кожної дії. Високий ризик."}},"id":{"stringUnit":{"state":"translated","value":"Aktif sejak awal. Setelah Mac ini dipasangkan dan akses macOS diberikan, Gateway yang dipasangkan dapat menggerakkan penunjuk, mengeklik, dan mengetik tanpa konfirmasi untuk setiap tindakan. Berisiko tinggi."}},"pl":{"stringUnit":{"state":"translated","value":"Domyślnie włączone. Po sparowaniu tego Maca i przyznaniu dostępu w macOS sparowany Gateway może przesuwać wskaźnik, klikać i pisać bez potwierdzania każdej czynności. Wysokie ryzyko."}},"th":{"stringUnit":{"state":"translated","value":"เปิดใช้งานตั้งแต่เริ่มต้น. หลังจากจับคู่ Mac เครื่องนี้และอนุญาตการเข้าถึง macOS แล้ว Gateway ที่จับคู่ไว้จะสามารถเลื่อนตัวชี้ คลิก และพิมพ์ได้โดยไม่ต้องยืนยันแต่ละการกระทำ. มีความเสี่ยงสูง."}},"vi":{"stringUnit":{"state":"translated","value":"Được bật sẵn. Sau khi máy Mac này được ghép đôi và quyền truy cập macOS được cấp, Gateway đã ghép đôi có thể di chuyển con trỏ, nhấp và nhập mà không cần xác nhận từng thao tác. Rủi ro cao."}},"nl":{"stringUnit":{"state":"translated","value":"Standaard ingeschakeld. Nadat deze Mac is gekoppeld en macOS-toegang is verleend, kan de gekoppelde Gateway de aanwijzer bewegen, klikken en typen zonder bevestiging per actie. Hoog risico."}},"fa":{"stringUnit":{"state":"translated","value":"در ابتدا فعال است. پس از جفت شدن این Mac و اعطای دسترسی macOS، Gateway جفت‌شده می‌تواند بدون تأیید جداگانه برای هر اقدام، نشانگر را حرکت دهد، کلیک کند و تایپ کند. خطر بالا."}},"ru":{"stringUnit":{"state":"translated","value":"Включено по умолчанию. После сопряжения этого Mac и предоставления доступа в macOS сопряжённый Gateway сможет перемещать указатель, нажимать и вводить текст без подтверждения каждого действия. Высокий риск."}},"sv":{"stringUnit":{"state":"translated","value":"Aktiverat från början. När denna Mac har parkopplats och åtkomst i macOS har beviljats kan den parkopplade Gateway flytta pekaren, klicka och skriva utan bekräftelse för varje åtgärd. Hög risk."}}}},
