    "Listening… say your trigger word.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Listening… say your trigger word."}},"zh-CN":{"stringUnit":{"state":"translated","value":"正在聆听…请说出你的触发词。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"正在聆聽…請說出您的觸發詞。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ouvindo… diga sua palavra de ativação."}},"de":{"stringUnit":{"state":"translated","value":"Hört zu… sagen Sie Ihr Auslösewort."}},"es":{"stringUnit":{"state":"translated","value":"Escuchando… di tu palabra de activación."}},"ja-JP":{"stringUnit":{"state":"translated","value":"リスニング中…トリガーワードを言ってください。"}},"ko":{"stringUnit":{"state":"translated","value":"듣는 중… 트리거 단어를 말하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Écoute… prononcez votre mot déclencheur."}},"hi":{"stringUnit":{"state":"translated","value":"सुन रहा है… अपना ट्रिगर शब्द बोलें।"}},"ar":{"stringUnit":{"state":"translated","value":"جارٍ الاستماع… قل كلمة التشغيل."}},"it":{"stringUnit":{"state":"translated","value":"In ascolto… pronuncia la tua parola di attivazione."}},"tr":{"stringUnit":{"state":"translated","value":"Dinleniyor… tetikleyici kelimenizi söyleyin."}},"uk":{"stringUnit":{"state":"translated","value":"Слухаємо… скажіть своє слово-тригер."}},"id":{"stringUnit":{"state":"translated","value":"Mendengarkan… ucapkan kata pemicu Anda."}},"pl":{"stringUnit":{"state":"translated","value":"Nasłuchiwanie… wypowiedz słowo wyzwalające."}},"th":{"stringUnit":{"state":"translated","value":"กำลังฟัง… พูดคำทริกเกอร์ของคุณ"}},"vi":{"stringUnit":{"state":"translated","value":"Đang nghe… hãy nói từ kích hoạt của bạn."}},"nl":{"stringUnit":{"state":"translated","value":"Luisteren… zeg je triggerwoord."}},"fa":{"stringUnit":{"state":"translated","value":"در حال گوش دادن… واژه فعال‌ساز خود را بگویید."}},"ru":{"stringUnit":{"state":"translated","value":"Слушаем… произнесите слово-триггер."}},"sv":{"stringUnit":{"state":"translated","value":"Lyssnar… säg ditt aktiveringsord."}}}},
