    "OpenClaw Command Approval": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenClaw Command Approval"}},"zh-CN":{"stringUnit":{"state":"translated","value":"OpenClaw 命令审批"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw 指令核准"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Aprovação de comando do OpenClaw"}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw-Befehlsfreigabe"}},"es":{"stringUnit":{"state":"translated","value":"Aprobación de comandos de OpenClaw"}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClaw コマンドの承認"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw 명령 승인"}},"fr":{"stringUnit":{"state":"translated","value":"Approbation de commande OpenClaw"}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw कमांड अनुमोदन"}},"ar":{"stringUnit":{"state":"translated","value":"الموافقة على أمر OpenClaw"}},"it":{"stringUnit":{"state":"translated","value":"Approvazione dei comandi di OpenClaw"}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw Komut Onayı"}},"uk":{"stringUnit":{"state":"translated","value":"Схвалення команди OpenClaw"}},"id":{"stringUnit":{"state":"translated","value":"Persetujuan Perintah OpenClaw"}},"pl":{"stringUnit":{"state":"translated","value":"Zatwierdzanie poleceń OpenClaw"}},"th":{"stringUnit":{"state":"translated","value":"การอนุมัติคำสั่ง OpenClaw"}},"vi":{"stringUnit":{"state":"translated","value":"Phê duyệt lệnh OpenClaw"}},"nl":{"stringUnit":{"state":"translated","value":"OpenClaw-opdrachtgoedkeuring"}},"fa":{"stringUnit":{"state":"translated","value":"تأیید فرمان OpenClaw"}},"ru":{"stringUnit":{"state":"translated","value":"Подтверждение команды OpenClaw"}},"sv":{"stringUnit":{"state":"translated","value":"Kommandogodkännande för OpenClaw"}}}},
    "OpenClaw Gateway %@ is installed.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway %@ is installed."}},"zh-CN":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway %@ 已安装。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway %@ 已安裝。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Gateway do OpenClaw %@ está instalado."}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway %@ ist installiert."}},"es":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway %@ está instalado."}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway %@ はインストール済みです。"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway %@이(가) 설치되어 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway %@ est installé."}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway %@ इंस्टॉल है."}},"ar":{"stringUnit":{"state":"translated","value":"تم تثبيت OpenClaw Gateway %@."}},"it":{"stringUnit":{"state":"translated","value":"Il Gateway OpenClaw %@ è installato."}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway %@ yüklü."}},"uk":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway %@ встановлено."}},"id":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway %@ terinstal."}},"pl":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway %@ jest zainstalowany."}},"th":{"stringUnit":{"state":"translated","value":"ติดตั้ง OpenClaw Gateway %@ แล้ว."}},"vi":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway %@ đã được cài đặt."}},"nl":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway %@ is geïnstalleerd."}},"fa":{"stringUnit":{"state":"translated","value":"Gateway مربوط به OpenClaw با نسخهٔ %@ نصب شده است."}},"ru":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway %@ установлен."}},"sv":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway %@ är installerad."}}}},
    "OpenClaw Gateway is not installed yet.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway is not installed yet."}},"zh-CN":{"stringUnit":{"state":"translated","value":"尚未安装 OpenClaw Gateway."}},"zh-TW":{"stringUnit":{"state":"translated","value":"尚未安裝 OpenClaw Gateway。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Gateway do OpenClaw ainda não está instalado."}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway ist noch nicht installiert."}},"es":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway aún no está instalado."}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway はまだインストールされていません。"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway가 아직 설치되지 않았습니다."}},"fr":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway n’est pas encore installé."}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway अभी इंस्टॉल नहीं है."}},"ar":{"stringUnit":{"state":"translated","value":"لم يتم تثبيت OpenClaw Gateway بعد."}},"it":{"stringUnit":{"state":"translated","value":"Il Gateway OpenClaw non è ancora installato."}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway henüz yüklü değil."}},"uk":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway ще не встановлено."}},"id":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway belum terinstal."}},"pl":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway nie jest jeszcze zainstalowany."}},"th":{"stringUnit":{"state":"translated","value":"ยังไม่ได้ติดตั้ง OpenClaw Gateway."}},"vi":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway chưa được cài đặt."}},"nl":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway is nog niet geïnstalleerd."}},"fa":{"stringUnit":{"state":"translated","value":"Gateway مربوط به OpenClaw هنوز نصب نشده است."}},"ru":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway ещё не установлен."}},"sv":{"strin