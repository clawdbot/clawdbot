    "Persistent Mac node service unavailable under app profile; runtime node remains available.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Persistent Mac node service unavailable under app profile; runtime node remains available."}},"zh-CN":{"stringUnit":{"state":"translated","value":"应用配置下无法使用持久化 Mac 节点服务; 运行时节点仍可用。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"應用程式設定檔下無法使用常駐 Mac 節點服務; 執行階段節點仍可使用。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O serviço persistente de nó do Mac não está disponível no perfil do app; o nó de execução permanece disponível."}},"de":{"stringUnit":{"state":"translated","value":"Der dauerhafte Mac-Knotendienst ist im App-Profil nicht verfügbar; der Laufzeitknoten bleibt verfügbar."}},"es":{"stringUnit":{"state":"translated","value":"El servicio de nodo persistente de Mac no está disponible en el perfil de la aplicación; el nodo en tiempo de ejecución sigue disponible."}},"ja-JP":{"stringUnit":{"state":"translated","value":"アプリプロファイルでは常駐Macノードサービスを利用できません; ランタイムノードは引き続き利用できます。"}},"ko":{"stringUnit":{"state":"translated","value":"앱 프로필에서는 상시 실행 Mac 노드 서비스를 사용할 수 없습니다; 런타임 노드는 계속 사용할 수 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le service de nœud Mac persistant est indisponible avec le profil de l’application ; le nœud d’exécution reste disponible."}},"hi":{"stringUnit":{"state":"translated","value":"ऐप प्रोफ़ाइल के अंतर्गत स्थायी Mac नोड सेवा उपलब्ध नहीं है; रनटाइम नोड उपलब्ध रहता है."}},"ar":{"stringUnit":{"state":"translated","value":"خدمة عقدة Mac الدائمة غير متاحة ضمن ملف تعريف التطبيق؛ تظل عقدة وقت التشغيل متاحة."}},"it":{"stringUnit":{"state":"translated","value":"Il servizio persistente del nodo Mac non è disponibile nel profilo dell’app; il nodo di runtime rimane disponibile."}},"tr":{"stringUnit":{"state":"translated","value":"Kalıcı Mac düğüm hizmeti uygulama profilinde kullanılamıyor; çalışma zamanı düğümü kullanılabilir durumda."}},"uk":{"stringUnit":{"state":"translated","value":"Постійна служба вузла Mac недоступна в профілі застосунку; вузол середовища виконання залишається доступним."}},"id":{"stringUnit":{"state":"translated","value":"Layanan node Mac persisten tidak tersedia dalam profil aplikasi; node runtime tetap tersedia."}},"pl":{"stringUnit":{"state":"translated","value":"Stała usługa węzła na Macu jest niedostępna w profilu aplikacji; węzeł środowiska uruchomieniowego pozostaje dostępny."}},"th":{"stringUnit":{"state":"translated","value":"บริการโหนด Mac แบบถาวรไม่พร้อมใช้งานภายใต้โปรไฟล์แอป; โหนดขณะรันยังคงพร้อมใช้งาน."}},"vi":{"stringUnit":{"state":"translated","value":"Dịch vụ nút Mac thường trực không khả dụng trong cấu hình ứng dụng; nút thời gian chạy vẫn khả dụng."}},"nl":{"stringUnit":{"state":"translated","value":"Permanente Mac-knooppuntservice niet beschikbaar onder het app-profiel; het runtime-knooppunt blijft beschikbaar."}},"fa":{"stringUnit":{"state":"translated","value":"سرویس پایدار گره Mac در نمایهٔ برنامه در دسترس نیست؛ گره زمان اجرا همچنان در دسترس است."}},"ru":{"stringUnit":{"state":"translated","value":"Постоянная служба узла Mac недоступна в профиле приложения; узел, работающий во время выполнения приложения, остаётся доступным."}},"sv":{"stringUnit":{"state":"translated","value":"Den beständiga Mac-nodtjänsten är inte tillgänglig i appens profil; körningsnoden är fortfarande tillgänglig."}}}},
    "Photo Library": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Photo Library"}},"zh-CN":{"stringUnit":{"state":"translated","value":"照片图库"}},"zh-TW":{"stringUnit":{"state":"translated","value":"照片圖庫"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Fototeca"}},"de":{"stringUnit":{"state":"translated","value":"Fotomediathek"}},"es":{"stringUnit":{"state":"translated","value":"Fototeca"}},"ja-JP":{"stringUnit":{"state":"translated","value":"写真ライブラリ"}},"ko":{"stringUnit":{"state":"translated","value":"사진 보관함"}},"fr":{"stringUnit":{"state":"translated","value":"Photothèque"}},"hi":{"stringUnit":{"state":"translated","value":"फ़ोटो लाइब्रेरी"}},"ar":{"stringUnit":{"state":"translated","value":"مكتبة الصور"}},"it":{"stringUnit":{"state":"translated","value":"Libreria foto"}},"tr":{"stringUnit":{"state":"translated","value":"Fotoğraf Arşivi"}},"uk":{"stringUnit":{"state":"translated","value":"Фототека"}},"id":{"stringUnit":{"state":"translated","value":"Perpustakaan Foto"}},"pl":{"stringUnit":{"state":"translated","value":"Biblioteka zdjęć"}},"th":{"stringUnit":{"state":"translated","value":"คลังรูปภาพ"}},"vi":{"stringUnit":{"state":"translated","value":"Thư viện ảnh"}},"nl":{"stringUnit":{"state":"translated","value":"Fotobibliotheek"}},"fa":{"stringUnit":{"state":"translated","value":"کتابخانهٔ عکس"}},"ru":{"stringUnit":{"state":"translated","value":"Медиатека"}},"sv":{"stringUnit":{"state":"translated","value":"Bildbibliotek"}}}},
    "Pick Local or Remote in Settings → General whenever you’re ready.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Pick Local or Remote in Settings → General whenever you’re ready."}},"zh-CN":{"stringUnit":{"state":"translated","value":"准备好后，随时在设置 → 通用中选择本地或远程。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"準備好後，請在設定 → 一般中選擇本機或遠端。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolha Local ou Remoto em Ajustes → Geral quando quiser."}},"de":{"stringUnit":{"state":"translated","value":"Wähle unter Einstellungen → Allgemein die Option Lokal oder Remote, sobald du bereit bist."}},"es":{"stringUnit":{"state":"translated","value":"Elige Local o Remoto en Ajustes → General cuando quieras."}},"ja-JP":{"stringUnit":{"state":"translated","value":"準備ができたら、設定 → 一般でローカルまたはリモートを選択してください。"}},"ko":{"stringUnit":{"state":"translated","value":"준비되면 언제든지 설정 → 일반에서 로컬 또는 원격을 선택하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez Local ou Distant dans Réglages → Général lorsque vous le souhaitez."}},"hi":{"stringUnit":{"state":"translated","value":"जब आप तैयार हों, तब सेटिंग्स → सामान्य में स्थानीय या रिमोट चुनें."}},"ar":{"stringUnit":{"state":"translated","value":"اختر محلي أو بعيد في الإعدادات → عام عندما تكون جاهزًا."}},"it":{"stringUnit":{"state":"translated","value":"Scegli Locale o Remoto in Impostazioni → Generali quando vuoi."}},"tr":{"stringUnit":{"state":"translated","value":"Hazır olduğunuzda Ayarlar → Genel bölümünden Yerel veya Uzak seçeneğini belirleyin."}},"uk":{"stringUnit":{"state":"translated","value":"Коли будете готові, виберіть «Локальний» або «Віддалений» у розділі Налаштування → Загальні."}},"id":{"stringUnit":{"state":"translated","value":"Pilih Lokal atau Jarak Jauh di Pengaturan → Umum kapan pun Anda siap."}},"pl":{"stringUnit":{"state":"translated","value":"Wybierz tryb lokalny lub zdalny w Ustawienia → Ogólne, gdy zechcesz."}},"th":{"stringUnit":{"state":"translated","value":"เลือกในเครื่องหรือระยะไกลใน การตั้งค่า → ทั่วไป เมื่อคุณพร้อม."}},"vi":{"stringUnit":{"state":"translated","value":"Chọn Cục bộ hoặc Từ xa trong Cài đặt → Cài đặt chung khi bạn sẵn sàng."}},"nl":{"stringUnit":{"state":"translated","value":"Kies Lokaal of Extern in Instellingen → Algemeen wanneer je er klaar voor bent."}},"fa":{"stringUnit":{"state":"translated","value":"هر زمان آماده بودید، در تنظیمات → عمومی، محلی یا راه دور را انتخاب کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Когда будете готовы, выберите «Локальный» или «Удалённый» в разделе Настройки → Основные."}},"sv":{"stringUnit":{"state":"translated","value":"Välj Lokal eller Fjärr i Inställningar → Allmänt när du är redo."}}}},
    "Pick whether this app owns a local Gateway or attaches to another host.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Pick whether this app owns a local Gateway or attaches to another host."}},"zh-CN":{"stringUnit":{"state":"translated","value":"选择由此应用管理本地 Gateway，还是连接到另一台主机。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"選擇由此應用程式管理本機 Gateway，或連接至其他主機。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolha se este app gerencia um Gateway local ou se conecta a outro host."}},"de":{"stringUnit":{"state":"translated","value":"Wähle, ob diese App einen lokalen Gateway betreibt oder sich mit einem anderen Host verbindet."}},"es":{"stringUnit":{"state":"translated","value":"Elige si esta aplicación gestiona un Gateway local o se conecta a otro host."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このアプリでローカルのGatewayを管理するか、別のホストに接続するかを選択してください。"}},"ko":{"stringUnit":{"state":"translated","value":"이 앱에서 로컬 Gateway를 직접 관리할지, 다른 호스트에 연결할지 선택하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez si cette application gère un Gateway local ou se connecte à un autre hôte."}},"hi":{"stringUnit":{"state":"translated","value":"चुनें कि यह ऐप स्थानीय Gateway का संचालन करेगा या किसी अन्य होस्ट से जुड़ेगा."}},"ar":{"stringUnit":{"state":"translated","value":"اختر ما إذا كان هذا التطبيق يدير Gateway محليًا أو يتصل بمضيف آخر."}},"it":{"stringUnit":{"state":"translated","value":"Scegli se questa app gestisce un Gateway locale o si collega a un altro host."}},"tr":{"stringUnit":{"state":"translated","value":"Bu uygulamanın yerel bir Gateway'i yönetmesini mi yoksa başka bir ana makineye bağlanmasını mı istediğinizi seçin."}},"uk":{"stringUnit":{"state":"translated","value":"Виберіть, чи цей застосунок керує локальним Gateway, чи підключається до іншого хоста."}},"id":{"stringUnit":{"state":"translated","value":"Pilih apakah aplikasi ini mengelola Gateway lokal atau terhubung ke host lain."}},"pl":{"stringUnit":{"state":"translated","value":"Wybierz, czy ta aplikacja zarządza lokalnym Gateway, czy łączy się z innym hostem."}},"th":{"stringUnit":{"state":"translated","value":"เลือกว่าจะให้แอปนี้จัดการ Gateway ในเครื่องหรือเชื่อมต่อกับโฮสต์อื่น."}},"vi":{"stringUnit":{"state":"translated","value":"Chọn xem ứng dụng này quản lý một Gateway cục bộ hay kết nối với một máy chủ khác."}},"nl":{"stringUnit":{"state":"translated","value":"Kies of deze app een lokale Gateway beheert of verbinding maakt met een andere host."}},"fa":{"stringUnit":{"state":"translated","value":"انتخاب کنید که این برنامه یک Gateway محلی را مدیریت کند یا به میزبان دیگری متصل شود."}},"ru":{"stringUnit":{"state":"translated","value":"Выберите, будет ли это приложение управлять локальным Gateway или подключаться к другому хосту."}},"sv":{"stringUnit":{"state":"translated","value":"Välj om den här appen ska hantera en lokal Gateway eller ansluta till en annan värddator."}}}},
