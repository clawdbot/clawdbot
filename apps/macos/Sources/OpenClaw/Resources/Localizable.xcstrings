    "Save": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Save"}},"zh-CN":{"stringUnit":{"state":"translated","value":"保存"}},"zh-TW":{"stringUnit":{"state":"translated","value":"儲存"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Salvar"}},"de":{"stringUnit":{"state":"translated","value":"Speichern"}},"es":{"stringUnit":{"state":"translated","value":"Guardar"}},"ja-JP":{"stringUnit":{"state":"translated","value":"保存"}},"ko":{"stringUnit":{"state":"translated","value":"저장"}},"fr":{"stringUnit":{"state":"translated","value":"Enregistrer"}},"hi":{"stringUnit":{"state":"translated","value":"सहेजें"}},"ar":{"stringUnit":{"state":"translated","value":"حفظ"}},"it":{"stringUnit":{"state":"translated","value":"Salva"}},"tr":{"stringUnit":{"state":"translated","value":"Kaydet"}},"uk":{"stringUnit":{"state":"translated","value":"Зберегти"}},"id":{"stringUnit":{"state":"translated","value":"Simpan"}},"pl":{"stringUnit":{"state":"translated","value":"Zapisz"}},"th":{"stringUnit":{"state":"translated","value":"บันทึก"}},"vi":{"stringUnit":{"state":"translated","value":"Lưu"}},"nl":{"stringUnit":{"state":"translated","value":"Opslaan"}},"fa":{"stringUnit":{"state":"translated","value":"ذخیره"}},"ru":{"stringUnit":{"state":"translated","value":"Сохранить"}},"sv":{"stringUnit":{"state":"translated","value":"Spara"}}}},
    "Save Gateway connections for chat windows. The primary Gateway under Connection still owns Mac integrations and Talk Mode.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Save Gateway connections for chat windows. The primary Gateway under Connection still owns Mac integrations and Talk Mode."}},"zh-CN":{"stringUnit":{"state":"translated","value":"保存用于聊天窗口的 Gateway 连接。“连接”下的主要 Gateway 仍负责 Mac 集成和对话模式。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"儲存供聊天視窗使用的 Gateway 連線。「連線」下的主要 Gateway 仍負責 Mac 整合與對話模式。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Salve conexões de Gateway para janelas de chat. O Gateway principal em Conexão ainda controla as integrações do Mac e o Modo de Conversa."}},"de":{"stringUnit":{"state":"translated","value":"Speichern Sie Gateway-Verbindungen für Chatfenster. Das primäre Gateway unter „Verbindung“ verwaltet weiterhin die Mac-Integrationen und den Sprechmodus."}},"es":{"stringUnit":{"state":"translated","value":"Guarda conexiones de Gateway para las ventanas de chat. El Gateway principal de Conexión seguirá gestionando las integraciones con el Mac y el modo de conversación."}},"ja-JP":{"stringUnit":{"state":"translated","value":"チャットウインドウ用にGateway接続を保存します。引き続き、「接続」で設定されたプライマリGatewayがMac連携とトークモードを管理します。"}},"ko":{"stringUnit":{"state":"translated","value":"채팅 창용 Gateway 연결을 저장합니다. 연결 아래의 기본 Gateway는 계속해서 Mac 통합 및 대화 모드를 관리합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Enregistrez les connexions Gateway pour les fenêtres de chat. Le Gateway principal sous Connexion continue de gérer les intégrations Mac et le mode Conversation."}},"hi":{"stringUnit":{"state":"translated","value":"चैट विंडो के लिए Gateway कनेक्शन सहेजें। Connection के अंतर्गत प्राथमिक Gateway अभी भी Mac इंटीग्रेशन और Talk Mode को नियंत्रित करता है।"}},"ar":{"stringUnit":{"state":"translated","value":"احفظ اتصالات Gateway لنوافذ الدردشة. يظل Gateway الأساسي ضمن «الاتصال» مسؤولاً عن تكاملات Mac ووضع التحدث."}},"it":{"stringUnit":{"state":"translated","value":"Salva le connessioni Gateway per le finestre di chat. Il Gateway principale in Connessione continua a gestire le integrazioni Mac e la modalità conversazione."}},"tr":{"stringUnit":{"state":"translated","value":"Sohbet pencereleri için Gateway bağlantılarını kaydedin. Bağlantı altındaki birincil Gateway, Mac entegrasyonlarını ve Konuşma Modu'nu yönetmeye devam eder."}},"uk":{"stringUnit":{"state":"translated","value":"Зберігайте підключення до Gateway для вікон чату. Основний Gateway у розділі «Підключення» й надалі керує інтеграціями Mac і режимом розмови."}},"id":{"stringUnit":{"state":"translated","value":"Simpan koneksi Gateway untuk jendela obrolan. Gateway utama di bagian Koneksi tetap mengelola integrasi Mac dan Mode Bicara."}},"pl":{"stringUnit":{"state":"translated","value":"Zapisuj połączenia Gateway dla okien czatu. Główny Gateway w sekcji Połączenie nadal obsługuje integracje z Makiem i Tryb rozmowy."}},"th":{"stringUnit":{"state":"translated","value":"บันทึกการเชื่อมต่อ Gateway สำหรับหน้าต่างแชท Gateway หลักในส่วนการเชื่อมต่อจะยังคงจัดการการผสานการทำงานกับ Mac และโหมดพูดคุย"}},"vi":{"stringUnit":{"state":"translated","value":"Lưu kết nối Gateway cho các cửa sổ trò chuyện. Gateway chính trong phần Kết nối vẫn quản lý các tích hợp với máy Mac và Chế độ trò chuyện."}},"nl":{"stringUnit":{"state":"translated","value":"Sla Gateway-verbindingen op voor chatvensters. De primaire Gateway onder Verbinding blijft verantwoordelijk voor Mac-integraties en de gespreksmodus."}},"fa":{"stringUnit":{"state":"translated","value":"اتصال‌های Gateway را برای پنجره‌های گفتگو ذخیره کنید. Gateway اصلی در بخش اتصال همچنان یکپارچه‌سازی‌های Mac و حالت مکالمه را مدیریت می‌کند."}},"ru":{"stringUnit":{"state":"translated","value":"Сохраняйте подключения к Gateway для окон чата. Основной Gateway в разделе «Подключение» по-прежнему управляет интеграциями Mac и режимом разговора."}},"sv":{"stringUnit":{"state":"translated","value":"Spara Gateway-anslutningar för chattfönster. Den primära Gateway under Anslutning hanterar fortfarande Mac-integrationer och Talk Mode."}}}},
