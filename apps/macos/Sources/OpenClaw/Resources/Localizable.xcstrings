    "SSH keeps the Gateway private; direct is best for HTTPS or Tailscale Serve.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"SSH keeps the Gateway private; direct is best for HTTPS or Tailscale Serve."}},"zh-CN":{"stringUnit":{"state":"translated","value":"SSH 可确保 Gateway 不对外公开；HTTPS 或 Tailscale Serve 最适合使用直连。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"SSH 可讓 Gateway 保持私密；HTTPS 或 Tailscale Serve 最適合使用直接連線。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O SSH mantém o Gateway privado; a conexão direta é ideal para HTTPS ou Tailscale Serve."}},"de":{"stringUnit":{"state":"translated","value":"SSH hält den Gateway privat; eine direkte Verbindung eignet sich am besten für HTTPS oder Tailscale Serve."}},"es":{"stringUnit":{"state":"translated","value":"SSH mantiene el Gateway privado; la conexión directa es mejor para HTTPS o Tailscale Serve."}},"ja-JP":{"stringUnit":{"state":"translated","value":"SSH は Gateway を非公開に保ちます; HTTPS または Tailscale Serve には直接接続が最適です。"}},"ko":{"stringUnit":{"state":"translated","value":"SSH는 Gateway를 비공개로 유지합니다; HTTPS 또는 Tailscale Serve에는 직접 연결이 가장 적합합니다."}},"fr":{"stringUnit":{"state":"translated","value":"SSH préserve le caractère privé du Gateway ; la connexion directe est préférable pour HTTPS ou Tailscale Serve."}},"hi":{"stringUnit":{"state":"translated","value":"SSH, Gateway को निजी रखता है; HTTPS या Tailscale Serve के लिए सीधा कनेक्शन सबसे अच्छा है।"}},"ar":{"stringUnit":{"state":"translated","value":"يحافظ SSH على خصوصية Gateway؛ الاتصال المباشر هو الأنسب لـ HTTPS أو Tailscale Serve."}},"it":{"stringUnit":{"state":"translated","value":"SSH mantiene privato il Gateway; la connessione diretta è ideale per HTTPS o Tailscale Serve."}},"tr":{"stringUnit":{"state":"translated","value":"SSH, Gateway'i özel tutar; HTTPS veya Tailscale Serve için doğrudan bağlantı en iyi seçenektir."}},"uk":{"stringUnit":{"state":"translated","value":"SSH зберігає приватність Gateway; пряме підключення найкраще підходить для HTTPS або Tailscale Serve."}},"id":{"stringUnit":{"state":"translated","value":"SSH menjaga Gateway tetap privat; koneksi langsung paling cocok untuk HTTPS atau Tailscale Serve."}},"pl":{"stringUnit":{"state":"translated","value":"SSH zapewnia prywatność Gateway; połączenie bezpośrednie najlepiej sprawdza się z HTTPS lub Tailscale Serve."}},"th":{"stringUnit":{"state":"translated","value":"SSH ช่วยให้ Gateway เป็นส่วนตัว; การเชื่อมต่อโดยตรงเหมาะที่สุดสำหรับ HTTPS หรือ Tailscale Serve."}},"vi":{"stringUnit":{"state":"translated","value":"SSH giữ Gateway riêng tư; kết nối trực tiếp phù hợp nhất với HTTPS hoặc Tailscale Serve."}},"nl":{"stringUnit":{"state":"translated","value":"SSH houdt de Gateway privé; een directe verbinding is het meest geschikt voor HTTPS of Tailscale Serve."}},"fa":{"stringUnit":{"state":"translated","value":"SSH، Gateway را خصوصی نگه می‌دارد؛ اتصال مستقیم برای HTTPS یا Tailscale Serve بهترین گزینه است."}},"ru":{"stringUnit":{"state":"translated","value":"SSH сохраняет приватность Gateway; прямое подключение лучше подходит для HTTPS или Tailscale Serve."}},"sv":{"stringUnit":{"state":"translated","value":"SSH håller Gateway privat; direktanslutning är bäst för HTTPS eller Tailscale Serve."}}}},
