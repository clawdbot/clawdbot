#!/usr/bin/env bash

# This is an opt-in local review gate. Remote branch protection and CI remain
# the authoritative publication controls; local hooks can be bypassed.

set -euo pipefail

# Package preparation installs the repository's maintained hook path so
# pre-commit remains active. Publication validation stays opt-in per worktree.
PREFLIGHT_OPT_IN="$(git rev-parse --git-path publication-preflight.enabled 2>/dev/null || true)"
if [[ -z "$PREFLIGHT_OPT_IN" || ! -f "$PREFLIGHT_OPT_IN" ]]; then
  exit 0
fi

ROOT_DIR="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$ROOT_DIR" ]]; then
  echo "[publication-preflight] cannot resolve repository root" >&2
  exit 1
fi

PREFLIGHT="$ROOT_DIR/scripts/publication-preflight.mjs"
if [[ ! -f "$PREFLIGHT" ]]; then
  echo "[publication-preflight] missing helper: $PREFLIGHT" >&2
  exit 1
fi

REMOTE_NAME="${1:-}"
REMOTE_URL="${2:-}"
if [[ -z "$REMOTE_NAME" || -z "$REMOTE_URL" ]]; then
  echo "[publication-preflight] pre-push did not provide a remote name and URL" >&2
  exit 1
fi

exec node "$PREFLIGHT" hook --remote-name "$REMOTE_NAME" --remote-url "$REMOTE_URL"
