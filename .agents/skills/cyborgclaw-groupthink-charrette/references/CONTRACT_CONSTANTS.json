  "action_profiles": {
    "RUN_LOCAL_VALIDATION": {
      "description": "Run the frozen local validation suite.",
      "category": "repeat_validation",
      "destination": "local_workspace",
      "declared_effects": ["local_validation"],
      "reversible": true
    },
    "APPLY_LOCAL_TEST_REPAIR": {
      "description": "Apply the single frozen local test repair and rerun its validation.",
      "category": "local_test_repair",
      "destination": "local_workspace",
      "declared_effects": ["local_filesystem_write", "local_validation"],
      "reversible": true
    },
    "APPLY_EXACT_LOCAL_CHANGE": {
      "description": "Apply the exact frozen local change and run its frozen validation.",
      "category": "exact_local_change",
      "destination": "local_workspace",
      "declared_effects": ["local_filesystem_write", "local_validation"],
      "reversible": true
    },
    "RECORD_IMPLEMENTATION_SELECTION": {
      "description": "Record the frozen implementation selection without executing it.",
      "category": "implementation_selection",
      "destination": "internal_evidence",
      "declared_effects": ["internal_state_change"],
      "reversible": true
    },
    "RECORD_AUTHORIZED_WORK_ORDER": {
      "description": "Record the frozen ordering of already-authorized work.",
      "category": "work_ordering",
      "destination": "internal_evidence",
      "declared_effects": ["internal_state_change"],
      "reversible": true
    },
    "NO_ACTION": {
      "description": "Take no implementation action.",
      "category": "no_action",
      "destination": "none",
      "declared_effects": ["none"],
      "reversible": true
    },
    "PRODUCTION_DEPLOYMENT": {
      "description": "Deploy the frozen candidate to production.",
      "category": "production_deployment",
      "destination": "production",
      "declared_effects": ["production_change"],
      "reversible": false
    },
    "GIT_PUSH": {
      "description": "Push the frozen commit to a remote repository.",
      "category": "git_push",
      "destination": "remote_repository",
      "declared_effects": ["remote_repository_write"],
      "reversible": false
    },
    "SEND_EXTERNAL_MESSAGE": {
      "description": "Send the frozen message to an external channel.",
      "category": "external_communication",
      "destination": "external_channel",
      "declared_effects": ["external_communication"],
      "reversible": false
    }
  },
