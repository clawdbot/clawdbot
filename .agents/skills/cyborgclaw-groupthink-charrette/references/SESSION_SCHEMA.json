{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cyborgclaw:schema:groupthink-charrette:session:v1",
  "title": "CyborgClaw GroupThink Charrette Session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state",
    "session_id",
    "mission_id",
    "mission_statement",
    "contract_identity",
    "decision",
    "suitability",
    "proxy_charter",
    "failure_lenses",
    "frozen_gates",
    "evidence",
    "panel_assignments",
    "roles",
    "max_challenge_rounds",
    "frozen_at",
    "freeze_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "cyborgclaw.groupthink-charrette.session.v1"
    },
    "state": {
      "enum": ["draft", "frozen"]
    },
    "session_id": {
      "$ref": "#/$defs/id"
    },
    "mission_id": {
      "$ref": "#/$defs/id"
    },
    "mission_statement": {
      "type": "string",
      "minLength": 1
    },
    "contract_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "charter_id",
        "protocol_id",
        "algorithm_version",
        "constants_schema_version",
        "session_schema",
        "findings_schema",
        "decision_record_schema",
        "charter_sha256",
        "protocol_sha256",
        "constants_sha256",
        "session_schema_sha256",
        "findings_schema_sha256",
        "decision_record_schema_sha256"
      ],
      "properties": {
        "charter_id": {
          "const": "cyborgclaw.glen-proxy-charter.v1"
        },
        "protocol_id": {
          "const": "cyborgclaw.groupthink-charrette.protocol.v1"
        },
        "algorithm_version": {
          "const": "cyborgclaw.groupthink-charrette.decision.v1"
        },
        "constants_schema_version": {
          "const": "cyborgclaw.groupthink-charrette.constants.v1"
        },
        "session_schema": {
          "const": "cyborgclaw.groupthink-charrette.session.v1"
        },
        "findings_schema": {
          "const": "cyborgclaw.groupthink-charrette.findings.v1"
        },
        "decision_record_schema": {
          "const": "cyborgclaw.sadr.v1"
        },
        "charter_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "protocol_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "constants_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "session_schema_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "findings_schema_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "decision_record_schema_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "options",
        "candidate_evidence_id",
        "candidate_digest",
        "proposed_next_action"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "summary"],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "summary": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "candidate_evidence_id": {
          "$ref": "#/$defs/id"
        },
        "candidate_digest": {
          "$ref": "#/$defs/sha256"
        },
        "proposed_next_action": {
          "$ref": "#/$defs/action"
        }
      }
    },
    "suitability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_tradeoff",
        "multiple_defensible_options",
        "cross_domain_risk",
        "disputed_gate",
        "factual_lookup",
        "routine_mechanical_step",
        "reversible"
      ],
      "properties": {
        "material_tradeoff": {
          "type": "boolean"
        },
        "multiple_defensible_options": {
          "type": "boolean"
        },
        "cross_domain_risk": {
          "type": "boolean"
        },
        "disputed_gate": {
          "type": "boolean"
        },
        "factual_lookup": {
          "type": "boolean"
        },
        "routine_mechanical_step": {
          "type": "boolean"
        },
        "reversible": {
          "type": "boolean"
        }
      }
    },
    "proxy_charter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delegation_id",
        "granted_by",
        "decision_owner",
        "mission_id",
        "decision_context_digest",
        "proof_plan_digest",
        "proof_plan_committed_at",
        "target_scope",
        "scope",
        "allowed_action_categories",
        "authorized_action_digests",
        "network_policy",
        "authority_evidence_ids",
        "authority_custody",
        "boundary_kind",
        "expires_at",
        "authorization_nonce",
        "authorization_use_limit",
        "mission_boundary",
        "proof_bar",
        "claim_ceiling_code",
        "claim_ceiling",
        "mission_reserved_action_categories",
        "revoked",
        "stop_condition_active"
      ],
      "properties": {
        "delegation_id": {
          "$ref": "#/$defs/id"
        },
        "granted_by": {
          "const": "Glen"
        },
        "decision_owner": {
          "const": "Glen"
        },
        "mission_id": {
          "$ref": "#/$defs/id"
        },
        "decision_context_digest": {
          "$ref": "#/$defs/sha256"
        },
        "proof_plan_digest": {
          "$ref": "#/$defs/sha256"
        },
        "proof_plan_committed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}Z$"
        },
        "target_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "repository_id", "workspace_id"],
          "properties": {
            "kind": {
              "const": "local_workspace"
            },
            "repository_id": {
              "$ref": "#/$defs/id"
            },
            "workspace_id": {
              "$ref": "#/$defs/id"
            }
          }
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "allowed_action_categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "authorized_action_digests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "network_policy": {
          "const": "none"
        },
        "authority_evidence_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "authority_custody": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "verifier_id", "evidence_id", "attestation"],
          "properties": {
            "method": {
              "const": "operator_direct_prompt"
            },
            "verifier_id": {
              "$ref": "#/$defs/id"
            },
            "evidence_id": {
              "$ref": "#/$defs/id"
            },
            "attestation": {
              "const": "I received this delegation through the declared custody method; this record preserves but does not cryptographically authenticate that source."
            }
          }
        },
        "boundary_kind": {
          "const": "expires_at"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}Z$"
        },
        "authorization_nonce": {
          "$ref": "#/$defs/sha256"
        },
        "authorization_use_limit": {
          "const": 1
        },
        "mission_boundary": {
          "type": "string",
          "minLength": 1
        },
        "proof_bar": {
          "type": "string",
          "minLength": 1
        },
        "claim_ceiling_code": {
          "const": "INTERNAL_DECISION_ONLY"
        },
        "claim_ceiling": {
          "const": "Internal decision record only; no merge, release, production, credential, external-effect, risk-acceptance, remote-repository, or mission-change authority."
        },
        "mission_reserved_action_categories": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "revoked": {
          "type": "boolean"
        },
        "stop_condition_active": {
          "type": "boolean"
        }
      }
    },
    "failure_lenses": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "frozen_gates": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "criterion",
          "measure",
          "measurement_command_id",
          "measurement_arguments",
          "required_exit_code",
          "operator",
          "threshold",
          "pass_condition",
          "required_evidence_ids"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "measure": {
            "type": "string",
            "minLength": 1
          },
          "measurement_command_id": {
            "type": ["string", "null"],
            "minLength": 1
          },
          "measurement_arguments": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            }
          },
          "required_exit_code": {
            "type": ["integer", "null"],
            "minimum": 0,
            "maximum": 255
          },
          "operator": {
            "enum": ["eq", "gte", "lte", "contains", "manual_evidence"]
          },
          "threshold": {
            "type": ["string", "number", "boolean"]
          },
          "pass_condition": {
            "type": "string",
            "minLength": 1
          },
          "required_evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "operator": {
                  "enum": ["gte", "lte"]
                }
              },
              "required": ["operator"]
            },
            "then": {
              "properties": {
                "threshold": {
                  "type": "number"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "operator": {
                  "const": "contains"
                }
              },
              "required": ["operator"]
            },
            "then": {
              "properties": {
                "threshold": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "operator": {
                  "const": "manual_evidence"
                }
              },
              "required": ["operator"]
            },
            "then": {
              "properties": {
                "threshold": {
                  "type": "boolean"
                }
              }
            }
          }
        ]
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "source",
          "sha256",
          "classification",
          "untrusted",
          "encoding",
          "content"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "classification": {
            "enum": ["authority", "source", "test", "runtime", "review", "other"]
          },
          "untrusted": {
            "const": true
          },
          "encoding": {
            "enum": ["utf8", "base64"]
          },
          "content": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "panel_assignments": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lens_id", "reviewer_id"],
        "properties": {
          "lens_id": {
            "$ref": "#/$defs/id"
          },
          "reviewer_id": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "builder_id",
        "evidence_writer_id",
        "executor_id",
        "synthesis_chair_id",
        "final_reviewer_id",
        "decision_judge_id"
      ],
      "properties": {
        "builder_id": {
          "$ref": "#/$defs/id"
        },
        "evidence_writer_id": {
          "$ref": "#/$defs/id"
        },
        "executor_id": {
          "$ref": "#/$defs/id"
        },
        "synthesis_chair_id": {
          "const": "Sage"
        },
        "final_reviewer_id": {
          "$ref": "#/$defs/id"
        },
        "decision_judge_id": {
          "const": "Sage"
        }
      }
    },
    "max_challenge_rounds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "frozen_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}Z$"
    },
    "freeze_digest": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "frozen"
          }
        },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "failure_lenses": {
            "minItems": 3
          },
          "frozen_gates": {
            "minItems": 1
          },
          "panel_assignments": {
            "minItems": 3
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "actionShape": {
      "additionalProperties": false,
      "required": [
        "operation_id",
        "target_scope_id",
        "description",
        "category",
        "destination",
        "declared_effects",
        "reversible",
        "parameters"
      ],
      "properties": {
        "operation_id": {
          "$ref": "#/$defs/id"
        },
        "target_scope_id": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "destination": {
          "type": "string",
          "minLength": 1
        },
        "declared_effects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reversible": {
          "type": "boolean"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "executor_adapter_id",
            "command_id",
            "arguments",
            "file_allowlist",
            "change_digest",
            "change_evidence_id",
            "rollback_digest",
            "validation_command_id",
            "validation_arguments"
          ],
          "properties": {
            "executor_adapter_id": {
              "$ref": "#/$defs/id"
            },
            "command_id": {
              "$ref": "#/$defs/id"
            },
            "arguments": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              }
            },
            "file_allowlist": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/relativePath"
              }
            },
            "change_digest": {
              "type": ["string", "null"],
              "pattern": "^[a-f0-9]{64}$"
            },
            "change_evidence_id": {
              "type": ["string", "null"],
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "rollback_digest": {
              "type": ["string", "null"],
              "pattern": "^[a-f0-9]{64}$"
            },
            "validation_command_id": {
              "type": ["string", "null"],
              "minLength": 1
            },
            "validation_arguments": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/relativePath"
              }
            }
          }
        }
      }
    },
    "action": {
      "$ref": "#/$defs/actionShape",
      "type": "object"
    },
    "nullableAction": {
      "$ref": "#/$defs/actionShape",
      "type": ["object", "null"]
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._@+=-]*(?:/[A-Za-z0-9][A-Za-z0-9._@+=-]*)*$"
    }
  }
}
