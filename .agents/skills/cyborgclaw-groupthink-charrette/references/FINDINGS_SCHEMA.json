{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cyborgclaw:schema:groupthink-charrette:findings:v1",
  "title": "CyborgClaw GroupThink Charrette Findings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "freeze_digest",
    "reviews",
    "cross_review_started_at",
    "gate_results",
    "unresolved_contradictions",
    "challenge_rounds",
    "challenges",
    "proposed_repair_action",
    "final_review",
    "decided_at"
  ],
  "properties": {
    "schema_version": {
      "const": "cyborgclaw.groupthink-charrette.findings.v1"
    },
    "session_id": {
      "$ref": "#/$defs/id"
    },
    "freeze_digest": {
      "$ref": "#/$defs/sha256"
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reviewer_id",
          "lens_id",
          "freeze_digest",
          "submitted_at",
          "independence_attestation",
          "saw_peer_findings_before_submission",
          "analysis_summary",
          "review_checklist",
          "evidence_examined_ids",
          "observations",
          "objections",
          "contradictions",
          "uncertainty",
          "falsifiers",
          "recommendation",
          "dissent"
        ],
        "properties": {
          "reviewer_id": {
            "$ref": "#/$defs/id"
          },
          "lens_id": {
            "type": "string",
            "minLength": 1
          },
          "freeze_digest": {
            "$ref": "#/$defs/sha256"
          },
          "submitted_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}Z$"
          },
          "independence_attestation": {
            "const": "I formed these findings from the frozen evidence before seeing any peer finding or preliminary conclusion."
          },
          "saw_peer_findings_before_submission": {
            "type": "boolean"
          },
          "analysis_summary": {
            "type": "string",
            "minLength": 80
          },
          "review_checklist": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_examined_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "observations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "classification", "statement", "evidence_ids"],
              "properties": {
                "id": {
                  "$ref": "#/$defs/id"
                },
                "classification": {
                  "enum": ["fact", "assumption", "interpretation", "preference"]
                },
                "statement": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_ids": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/id"
                  }
                }
              }
            }
          },
          "objections": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/objection"
            }
          },
          "contradictions": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/contradiction"
            }
          },
          "uncertainty": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "falsifiers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "recommendation": {
            "enum": ["PROCEED", "REWORK_AND_CONTINUE", "ABORT_PATH", "HOLD", "ESCALATE_TO_GLEN"]
          },
          "dissent": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "cross_review_started_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}Z$"
    },
    "gate_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate_id",
          "status",
          "evidence_ids",
          "explanation",
          "correctable",
          "repair_action",
          "observed_value",
          "evaluator_id",
          "evaluator_attestation"
        ],
        "properties": {
          "gate_id": {
            "$ref": "#/$defs/id"
          },
          "status": {
            "enum": ["PASS", "FAIL", "MISSING"]
          },
          "evidence_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "correctable": {
            "type": "boolean"
          },
          "repair_action": {
            "$ref": "#/$defs/nullableAction"
          },
          "observed_value": {
            "type": ["string", "number", "boolean", "null"]
          },
          "evaluator_id": {
            "type": ["string", "null"],
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "evaluator_attestation": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "unresolved_contradictions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contradiction"
      }
    },
    "challenge_rounds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "challenges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["round", "finding_id", "challenge", "disposition", "evidence_ids"],
        "properties": {
          "round": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          },
          "finding_id": {
            "$ref": "#/$defs/id"
          },
          "challenge": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "enum": ["resolved", "retained", "blocking"]
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          }
        }
      }
    },
    "proposed_repair_action": {
      "$ref": "#/$defs/nullableAction"
    },
    "final_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_id",
        "freeze_digest",
        "reviewed_at",
        "status",
        "attestation",
        "analysis_summary",
        "review_checklist",
        "evidence_examined_ids",
        "blocking_objections",
        "accepted_resolution_ids"
      ],
      "properties": {
        "reviewer_id": {
          "$ref": "#/$defs/id"
        },
        "freeze_digest": {
          "$ref": "#/$defs/sha256"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}Z$"
        },
        "status": {
          "enum": ["ACCEPTED", "REQUEST_CHANGES"]
        },
        "attestation": {
          "const": "I independently reviewed the frozen session and completed findings without participating as builder, panel reviewer, or decision judge."
        },
        "analysis_summary": {
          "type": "string",
          "minLength": 80
        },
        "review_checklist": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_examined_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "blocking_objections": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "accepted_resolution_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "decided_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}Z$"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "actionShape": {
      "additionalProperties": false,
      "required": [
        "operation_id",
        "target_scope_id",
        "description",
        "category",
        "destination",
        "declared_effects",
        "reversible",
        "parameters"
      ],
      "properties": {
        "operation_id": {
          "$ref": "#/$defs/id"
        },
        "target_scope_id": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "destination": {
          "type": "string",
          "minLength": 1
        },
        "declared_effects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reversible": {
          "type": "boolean"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "executor_adapter_id",
            "command_id",
            "arguments",
            "file_allowlist",
            "change_digest",
            "change_evidence_id",
            "rollback_digest",
            "validation_command_id",
            "validation_arguments"
          ],
          "properties": {
            "executor_adapter_id": {
              "$ref": "#/$defs/id"
            },
            "command_id": {
              "$ref": "#/$defs/id"
            },
            "arguments": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              }
            },
            "file_allowlist": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/relativePath"
              }
            },
            "change_digest": {
              "type": ["string", "null"],
              "pattern": "^[a-f0-9]{64}$"
            },
            "change_evidence_id": {
              "type": ["string", "null"],
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "rollback_digest": {
              "type": ["string", "null"],
              "pattern": "^[a-f0-9]{64}$"
            },
            "validation_command_id": {
              "type": ["string", "null"],
              "minLength": 1
            },
            "validation_arguments": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/relativePath"
              }
            }
          }
        }
      }
    },
    "action": {
      "$ref": "#/$defs/actionShape",
      "type": "object"
    },
    "nullableAction": {
      "$ref": "#/$defs/actionShape",
      "type": ["object", "null"]
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._@+=-]*(?:/[A-Za-z0-9][A-Za-z0-9._@+=-]*)*$"
    },
    "objection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "code", "severity", "correctable", "statement", "evidence_ids"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
        },
        "severity": {
          "enum": ["blocking", "material", "advisory"]
        },
        "correctable": {
          "type": "boolean"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "contradiction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "statement", "evidence_ids"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "severity": {
          "enum": ["material", "advisory"]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    }
  }
}
