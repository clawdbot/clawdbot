{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Control UI indexed reads must account for missing entries.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "tsBuildInfoFile": ".artifacts/tsgo-cache/ui.tsbuildinfo"
  },
  "include": ["ui/**/*", "packages/mermaid-renderer/**/*", "extensions/*/browser/**/*", "src/plugin-sdk/control-ui*.ts", "src/**/*.d.ts", "packages/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "**/dist/**", "**/*.test.ts", "**/*.test.tsx", "**/*test-helpers.ts", "**/*test-harness.ts", "**/*test-support.ts", "extensions/*/browser/**/test/**", "test/**"]
}
