    "InputModality": {"description":"Canonical user-input modality tags advertised by a model.","oneOf":[{"description":"Plain text turns and tool payloads.","enum":["text"],"type":"string"},{"description":"Image attachments included in user turns.","enum":["image"],"type":"string"},{"description":"Audio attachments included in user turns.","enum":["audio"],"type":"string"}]},
