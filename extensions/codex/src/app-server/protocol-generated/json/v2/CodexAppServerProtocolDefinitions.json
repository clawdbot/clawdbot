    "ModelUpgradeInfo": {"properties":{"migrationMarkdown":{"type":["string","null"]},"model":{"type":"string"},"modelLink":{"type":["string","null"]},"retirementAt":{"description":"Informational Unix timestamp for this upgrade's scheduled retirement, if known.","format":"int64","type":["integer","null"]},"upgradeCopy":{"type":["string","null"]}},"required":["model"],"type":"object"},
    "MultiAgentMode": {"description":"Controls the effective multi-agent delegation instructions for a turn. `custom` means the configured mode hint defines the policy instead of a built-in policy.","oneOf":[{"additionalProperties":false,"properties":{"custom":{"type":"string"}},"required":["custom"],"title":"CustomMultiAgentMode","type":"object"},{"enum":["explicitRequestOnly","proactive"],"type":"string"}]},
