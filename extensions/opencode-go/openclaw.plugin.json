            "input": ["text"],
            "contextWindow": 1000000,
            "maxTokens": 384000,
            "cost": {
              "input": 0.435,
              "output": 0.87,
              "cacheRead": 0.003625,
              "cacheWrite": 0
            },
            "compat": {
              "supportsUsageInStreaming": true,
              "supportsReasoningEffort": true,
              "maxTokensField": "max_tokens",
              "codeMode": "capable"
            }
