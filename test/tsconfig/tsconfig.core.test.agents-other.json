    "../../**/dist/**",
    "../../src/agents/*.test.ts",
    "../../src/agents/*.test.tsx",
    "../../src/agents/cli-runner/**/*.test.ts",
    "../../src/agents/cli-runner/**/*.test.tsx"
  ]
}
