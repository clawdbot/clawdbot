{
  "extends": "./tsconfig.core.test.shard.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../../.artifacts/tsgo-cache/core-test-agents-other.tsbuildinfo"
  },
  "include": [
    "../../src/agents/**/*.test.ts",
    "../../src/agents/**/*.test.tsx"
  ],
  "exclude": [
