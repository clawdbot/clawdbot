{
  "extends": "./tsconfig.core.test.shard.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../../.artifacts/tsgo-cache/core-test-infra.tsbuildinfo"
  },
  "include": [
    "../../src/infra/**/*.test.ts",
    "../../src/infra/**/*.test.tsx",
    "../../src/logging/**/*.test.ts",
    "../../src/logging/**/*.test.tsx"
  ],
  "exclude": [
    "../../node_modules",
    "../../dist",
    "../../**/dist/**",
    "../../src/infra/outbound/**"
  ]
}
